timestamp=2026-09-01T05:43:02.298Z level=INFO run=f180ecb5 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, collections, re\nbase='data/kaggle/'\n\n# FIFA: Brazilian clubs & the big-five presence\nrows = list(csv.DictReader(open(base+'fifa_data.csv', encoding='utf-8-sig')))\nprint('fifa cols sample ok; rows:', len(rows))\nbig = [c for c in ('Flamengo','Palmeiras','Corinthians','São Paulo','Vasco da Gama','Santos','Grêmio','Atlético Mineiro','Cruzeiro','Fluminense','Internacional','Botafogo','Bahia','Athletico Paranaense','Atlético Paranaense','Sport Club do Recife','Ceará Sporting Club','Chapecoense','América FC (Minas Gerais)','Paraná','Vitória') ]\npresent = collections.Counter(r['Club'] for r in rows)\nfor b in big: print(f'  club {b!r}: {present.get(b, 0)} players')\nempty_club = sum(1 for r in rows if not r['Club'].strip())\nprint('players with empty club:', empty_club)\n\n# BR-Foot copa 2021/2022/2023 tail (possible finals by last dates)\ncr = [r for r in csv.DictReader(open(base+'BR-Football-Dataset.csv', encoding='utf-8-sig')) if r['tournament']=='Copa do Brasil']\nfor s in ('2021','2022','2023'):\n    sr = sorted((r for r in cr if r['date'].startswith(s)), key=lambda r: r['date'])\n    print('copa', s, 'matches:', len(sr), 'last 4:')\n    for r in sr[-4:]:\n        print('   ', r['date'], r['home'], r['home_goal'], '-', r['away_goal'], r['away'])\n\n# novo Vencedor values + UF values\nnv = list(csv.DictReader(open(base+'novo_campeonato_brasileiro.csv', encoding='utf-8-sig')))\nprint('novo Vencedor:', collections.Counter(r['Vencedor'] for r in nv))\nprint('novo states:', sorted({r['Mandante_UF'] for r in nv}))\nEOF" action.permission=bash action.action=allow action.pattern=*
