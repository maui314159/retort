timestamp=2026-08-31T19:53:14.106Z level=INFO run=532d90f3 message=evaluated permission=bash pattern="venv/bin/python -c \"\nfrom bsoccer.data_loader import load_all\nmatches, players = load_all()\ncor = [m for m in matches if m.source_file=='Brasileirao_Matches.csv' and m.season==2022 and 'Corinthians' in (m.home, m.away)]\nfrom collections import Counter\nc = Counter((m.date_key(), (m.home, m.away), m.home_goal, m.away_goal) for m in cor)\ndups = {k:v for k,v in c.items() if v>1}\nprint('duplicate keys:', dups)\nfor k in dups: print(k)\n# are they exact duplicate rows?\nimport csv\nwith open('data/kaggle/Brasileirao_Matches.csv', encoding='utf-8') as fh:\n    rows = [r for r in csv.DictReader(fh) if r['season']=='2022' and 'Corinthians' in (r['home_team'], r['away_team'])]\nprint('raw rows 2022 Corinthians:', len(rows))\nrc = Counter(tuple(sorted(r.items())) for r in rows)\nprint('exact duplicate rows:', {k[:3]: v for k,v in rc.items() if v>1}.keys())\n\"" action.permission=bash action.action=allow action.pattern=*
