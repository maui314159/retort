timestamp=2026-09-01T17:14:33.642Z level=INFO run=a6cf503f message=evaluated permission=bash pattern="venv/bin/python -c \"\nfrom brazilian_soccer import load_soccer_data\nfrom brazilian_soccer.loader import BRASILEIRAO_A\nd = load_soccer_data()\n\n# All Flamengo 2019 rows with source\nrows = [(m.source, str(m.date), m.home, m.away, m.home_goals, m.away_goals) for m in d.matches\n        if m.competition == BRASILEIRAO_A and m.season == 2019 and (m.home=='flamengo-rj' or m.away=='flamengo-rj')]\nfrom collections import defaultdict\nbyopp = defaultdict(list)\nfor s, dt, h, a, hg, ag in rows:\n    opp = a if h=='flamengo-rj' else h\n    byopp[(opp, h=='flamengo-rj')].append((dt, hg, ag, s))\nmulti = {k: v for k, v in byopp.items() if len(v) > 1}\nfor k, v in list(multi.items())[:8]: print(k, v)\nprint('opponents with >1 record vs Flamengo:', len(multi))\n\"" action.permission=bash action.action=allow action.pattern=*
