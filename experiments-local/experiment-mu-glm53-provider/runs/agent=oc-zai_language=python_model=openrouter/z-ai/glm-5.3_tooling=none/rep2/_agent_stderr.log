timestamp=2026-09-01T14:40:39.296Z level=INFO run=bd57de6d message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, unicodedata, re\n\nUF = {'SP','RJ','MG','RS','PR','SC','PE','CE','BA','GO','AL','MT','MS','PA','RN','PB','SE','PI','MA','TO','RO','AC','AM','AP','RR','DF','ES'}\ndef slug(s):\n    s = unicodedata.normalize('NFKD', s)\n    s = ''.join(c for c in s if not unicodedata.combining(c)).lower()\n    m = re.findall(r'\\(([^)]*)\\)', s)\n    s = re.sub(r'\\([^)]*\\)', ' ', s)\n    for x in m:\n        x = x.strip()\n        if x and len(x.split()) == 1 and len(x) <= 4: s += ' ' + x\n    s = ''.join(c if c.isalnum() else ' ' for c in s)\n    return ' '.join(s.split())\nBASES = {'palmeiras','flamengo','corinthians','santos','sao paulo','sport','bahia','ceara','fortaleza','vitoria','cruzeiro','coritiba','parana','chapecoense','avai','figueirense','criciuma','goias','gremio','internacional','fluminense','guarani','portuguesa','juventude','caxias','nautico','remo','paysandu','sampaio correa','csa','crb','abc','vasco','vila nova'}\ndef key(t):\n    s = slug(t); toks = s.split()\n    if toks and toks[-1] in UF:\n        base = ' '.join(toks[:-1])\n        if base in BASES: return base\n    return s\n\ndef show(path, hcol, acol, season_col, n=6, year='2015'):\n    with open(path, encoding='utf-8') as f:\n        out = []\n        for row in csv.DictReader(f):\n            if str(row[season_col]) == year:\n                out.append((row[hcol], key(row[hcol]), row[acol], key(row[acol])))\n            if len(out) >= n: break\n        for o in out: print(o)\n\nprint(\"== novo 2015 ==\")\nshow('data/kaggle/novo_campeonato_brasileiro.csv','Equipe_mandante','Equipe_visitante','Ano')\nprint(\"== brfile 2015 ==\")\nshow('data/kaggle/Brasileirao_Matches.csv','home_team','away_team','season')\nEOF" action.permission=bash action.action=allow action.pattern=*
