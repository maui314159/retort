timestamp=2026-09-01T04:32:07.211Z level=INFO run=1a470e0e message=evaluated permission=bash pattern="./venv/bin/python << 'EOF'\n# Smoke test: MCPServer with tool decorator + InMemoryTransport + ClientSession\nimport asyncio\nfrom mcp.server.mcpserver import MCPServer\nfrom mcp.client._memory import InMemoryTransport\nfrom mcp.client.session import ClientSession\n\nasync def main():\n    server = MCPServer(name=\"demo\")\n    @server.tool(description=\"Echo a message\")\n    def echo(message: str) -> str:\n        return f\"echo: {message}\"\n\n    async with InMemoryTransport(server) as transport:\n        async with ClientSession(transport[0], transport[1]) as session:\n            await session.initialize()\n            tools = await session.list_tools()\n            print(\"tools:\", [t.name for t in tools.tools])\n            res = await session.call_tool(\"echo\", {\"message\": \"hi\"})\n            print(\"result:\", res.content)\n\nasyncio.run(main())\nEOF" action.permission=bash action.action=allow action.pattern=*
