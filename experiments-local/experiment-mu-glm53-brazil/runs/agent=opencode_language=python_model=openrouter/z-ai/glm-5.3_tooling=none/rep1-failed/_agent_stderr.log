timestamp=2026-08-31T18:25:14.027Z level=INFO run=dde7c20f message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nfrom soccer_mcp.loaders import load_knowledge_base\nfrom collections import Counter\nkb = load_knowledge_base('data/kaggle')\nr = kb.registry\n\n# find duplicate (home,away) pairs within same season+competition\nfor season in (2009, 2021, 2022, 2023):\n    ms = [m for m in kb.matches if m.competition == 'Brasileirão Série A' and m.season == season]\n    c = Counter((m.home, m.away) for m in ms)\n    dups = {k: v for k, v in c.items() if v > 1}\n    print(f'--- {season}: {len(ms)} matches, dup pairs: {len(dups)}')\n    for k in list(dups)[:5]:\n        print('   dup:', r.display_name(*k[0].split('|')), 'vs', r.display_name(*k[1].split('|')), dups[k])\n        for m in ms:\n            if (m.home, m.away) == k:\n                print('      ', m.date, m.home_goals, '-', m.away_goals, m.round_label, m.sources)\nEOF" action.permission=bash action.action=allow action.pattern=*
