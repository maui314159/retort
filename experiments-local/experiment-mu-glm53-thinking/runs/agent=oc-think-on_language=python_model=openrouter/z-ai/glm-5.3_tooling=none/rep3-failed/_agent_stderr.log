timestamp=2026-09-01T17:04:26.693Z level=INFO run=a6cf503f message=evaluated permission=bash pattern="venv/bin/python -c \"\nimport csv, unicodedata, re\nfrom collections import defaultdict\n\ndef norm(t):\n    t = unicodedata.normalize('NFKD', t).encode('ascii','ignore').decode()\n    t = re.sub(r'\\(.*?\\)', ' ', t)\n    t = re.sub(r'\\b(antigo)\\b', ' ', t)\n    t = t.replace('-', ' ')\n    t = re.sub(r'\\s+', ' ', t).strip().lower()\n    toks = t.split()\n    UFS = {'sp','rj','mg','rs','pr','sc','ba','pe','ce','go','mt','ms','df','pa','am','rn','pb','se','al','ma','pi','to','ro','rr','ap','es','ac'}\n    while len(toks) > 1 and toks[-1] in UFS: toks = toks[:-1]\n    return ' '.join(toks)\n\nfor year in ['2019','2018','2020']:\n    pts = defaultdict(int); table = defaultdict(lambda: [0,0,0,0,0,0])\n    with open('data/kaggle/Brasileirao_Matches.csv', encoding='utf-8-sig') as f:\n        for row in csv.DictReader(f):\n            if row['season'] != year: continue\n            h, a = norm(row['home_team']), norm(row['away_team'])\n            hg, ag = int(row['home_goal']), int(row['away_goal'])\n            table[h][3] += hg; table[h][4] += ag; table[a][3] += ag; table[a][4] += hg\n            if hg > ag: table[h][0]+=1; table[a][2]+=1; pts[h]+=3\n            elif hg < ag: table[a][0]+=1; table[h][2]+=1; pts[a]+=3\n            else: table[h][1]+=1; table[a][1]+=1; pts[h]+=1; pts[a]+=1\n    standing = sorted(pts.items(), key=lambda kv: (-kv[1], -(table[kv[0]][0])))\n    print(f'--- {year} top 3:', [(t, p) for t, p in standing[:3]])\n    print(f'--- {year} bottom 4:', [(t, p) for t, p in standing[-4:]])\n\"" action.permission=bash action.action=allow action.pattern=*
