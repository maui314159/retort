timestamp=2026-09-01T10:16:12.309Z level=INFO run=f27b5900 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nfrom brsoccer.data import load_default\nfrom brsoccer import queries as q\n\nsd = load_default()\nprint(\"resolve Bahia ->\", sd.registry.resolve(\"Bahia\")[:2] and [(r.key, r.display, r.match_count) for r in sd.registry.resolve(\"Bahia\")])\nprint(\"resolve Vitória ->\", [(r.key, r.display, r.match_count) for r in sd.registry.resolve(\"Vitória\")][:4])\nprint(\"key_of 'Vitória' =\", sd.registry.key_of(\"Vitória\"))\nprint(\"key_of 'EC Vitoria' =\", sd.registry.key_of(\"EC Vitoria\"))\nprint(\"key_of 'Vitória - BA' =\", sd.registry.key_of(\"Vitória - BA\"))\nprint(\"key_of 'Vitoria ES' =\", sd.registry.key_of(\"Vitoria ES\"))\n# what keys contain 'vitoria'\nprint(\"registry vitoria keys:\", [(k, e.display, e.match_count) for k, e in sd.registry.entries.items() if 'vitoria' in k])\n# Bahia 2023 matches vs vitoria?\nb = q.resolve_team(sd, \"Bahia\")\nv = q.resolve_team(sd, \"Vitória\")\nbv = [m for m in sd.matches if m.season==2023 and m.is_between(b, v)]\nprint(\"Ba-Vi 2023:\", [(str(m.date), m.home_display, m.score_text, m.away_display, m.competition) for m in bv])\n# all 2023 serie_b matches involving vitoria\nvms = [m for m in sd.matches_for_team(v) if m.season == 2023]\nprint(\"Vitória 2023 matches:\", len(vms))\nprint(\"Bahia key display:\", sd.team_display(b))\nEOF" action.permission=bash action.action=allow action.pattern=*
