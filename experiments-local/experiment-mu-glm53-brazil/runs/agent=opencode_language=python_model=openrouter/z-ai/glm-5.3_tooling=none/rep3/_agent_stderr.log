timestamp=2026-09-01T13:51:17.694Z level=INFO run=d0d26016 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nfrom brazilian_soccer_mcp.dataset import load_matches\nfrom brazilian_soccer_mcp.normalize import normalize_team\nfrom collections import defaultdict\nraw, _ = load_matches()\nnames = defaultdict(lambda: defaultdict(set))\nfor m in raw:\n    for side in ('home', 'away'):\n        raw_name = m.home_name if side=='home' else m.away_name\n        team = m.home_team if side=='home' else m.away_team\n        names[team.base][m.source].add((raw_name, team.state))\nfor base in ['fortaleza','fortalezafc','fortalezaec','bragantino','redbullbragantino','ecjuventude','juventude',\n             'ecvitoria','vitoria','vitoriaec','csa','csalagoano','nautico','nauticocapibaribe','portuguesa',\n             'portuguesadesportos','ecinternacional','internacional','parana','caparana','jiparana','santacruz',\n             'santacruzfc','atleticocearense','fcatleticocearense','ceara','cearasc','cearascar','atleticogoianiense',\n             'atletico','sport','sportrecife','ecbahia','bahia','cuiaba','remo','clubedoremo','inter','gremionovorizontino','novorizontino']:\n    if base in names:\n        print(f\"{base}:\")\n        for src, vals in sorted(names[base].items()):\n            print(f\"   {src}: {sorted(vals)[:4]}\")\nEOF" action.permission=bash action.action=allow action.pattern=*
