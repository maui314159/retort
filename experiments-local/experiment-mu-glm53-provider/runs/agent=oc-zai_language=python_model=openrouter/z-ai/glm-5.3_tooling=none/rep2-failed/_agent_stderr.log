timestamp=2026-09-01T07:15:26.862Z level=INFO run=27f52cea message=evaluated permission=bash pattern="venv/bin/python -c \"\nfrom data_loader import get_data\nfrom normalize import strip_accents\ndata = get_data()\ndef base(k):\n    b = k.rsplit('-',1)[0] if '-' in k else k\n    return ' '.join(strip_accents(b).lower().split())\nseen = set()\nfor m1 in data.matches:\n    if not (m1.date and m1.score): continue\n    for m2 in data.matches:\n        if m2 is m1: continue\n        if m1.competition != m2.competition: continue\n        if not (m2.date and m2.score): continue\n        if abs(m1.date.toordinal() - m2.date.toordinal()) > 1: continue\n        if m1.score != m2.score: continue\n        same_home = m1.home_key != m2.home_key and (base(m1.home_key) in base(m2.home_key) or base(m2.home_key) in base(m1.home_key))\n        same_away = m1.away_key != m2.away_key and (base(m1.away_key) in base(m2.away_key) or base(m2.away_key) in base(m1.away_key))\n        if same_home or same_away:\n            combo = tuple(sorted([m1.home_key, m2.home_key])) + tuple(sorted([m1.away_key, m2.away_key]))\n            if combo in seen: continue\n            seen.add(combo)\n            print(m1.date, m1.competition, '|', m1.home_key, 'vs', m1.away_key, '<>', m2.home_key, 'vs', m2.away_key, '|', m1.source[:10], m2.source[:10])\n\" 2>&1" action.permission=bash action.action=allow action.pattern=*
