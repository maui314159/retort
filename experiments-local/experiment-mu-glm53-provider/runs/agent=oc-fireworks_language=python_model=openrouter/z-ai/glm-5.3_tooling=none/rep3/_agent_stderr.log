timestamp=2026-09-01T10:15:51.264Z level=INFO run=f27b5900 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nfrom brsoccer.data import load_default\nfrom brsoccer import queries as q\n\nsd = load_default()\nt2023 = q.standings(sd, 'serie_a', 2023)\nprint(\"2023 top3:\", [(r.position, r.display, r.points, r.win, r.draw, r.loss, r.goals_for) for r in t2023[:3]])\nprint(\"2023 most goals team:\", max(t2023, key=lambda r: r.goals_for).display, max(r.goals_for for r in t2023))\n\nh = q.head_to_head(sd, \"Flamengo\", \"Fluminense\")\nprint(\"\\nFla-Flu h2h:\", h['wins_a'], h['wins_b'], h['draws'], \"goals\", h['goals_a'], h['goals_b'], \"matches\", len(h['matches']))\n\nts = q.team_stats(sd, \"Corinthians\", season=2022, competition=\"serie_a\")\nprint(\"\\nCorinthians 2022 home:\", ts['home'])\nprint(\"Corinthians 2022 overall W/D/L:\", ts['overall']['wins'], ts['overall']['draws'], ts['overall']['losses'])\n\nd23 = q.derbies(sd, season=2023)\nprint(\"\\nDerbies 2023:\", [(n, len(m)) for n, m in d23])\n\nbw = q.biggest_wins(sd, limit=5)\nprint(\"\\nBiggest wins overall:\")\nfor m in bw:\n    print(\"  \", m.date, m.home_display, m.score_text, m.away_display, m.competition, \"margin\", m.margin)\n\nbh = q.best_records(sd, venue='home', min_matches=100, limit=3)\nprint(\"\\nBest home records:\", [(r['display'], round(r['win_rate'],1), r['matches']) for r in bh])\n\ncf = q.find_matches(sd, competition='copa_do_brasil', stage='final')\nprint(\"\\nCopa finals via stage='final':\", len(cf), \"latest:\", cf[0].date, cf[0].home_display, cf[0].score_text, cf[0].away_display)\n\ngb = q.search_players(sd, name=\"Gabriel Barbosa\", limit=6)\nprint(\"\\n'Gabriel Barbosa' search:\", [(p.name, p.overall, p.position, p.club) for p in gb])\n\nny = q.search_players(sd, name=\"Neymar\")\nprint(\"'Neymar':\", [(p.name, p.overall) for p in ny])\n\nst = q.search_players(sd, position=\"ST\", club=\"Santos\", limit=3)\nprint(\"Santos strikers:\", [(p.name, p.overall) for p in st])\n\nfl = q.search_players(sd, club=\"Fluminense\", limit=3)\nprint(\"Fluminense players:\", [(p.name, p.overall) for p in fl])\n\nlm = q.last_match(sd, \"Flamengo\", \"Corinthians\")\nprint(\"\\nLast Fla-Cor:\", lm.date, lm.home_display, lm.score_text, lm.away_display)\n\ns2019 = q.competition_stats(sd, 'serie_a', 2019)\nprint(\"\\nserie_a 2019 stats:\", {k: round(v,2) if isinstance(v,float) else v for k,v in s2019.items()})\ns2018 = q.competition_stats(sd, 'serie_a', 2018)\nprint(\"serie_a 2018 stats:\", {k: round(v,2) if isinstance(v,float) else v for k,v in s2018.items()})\n\ngr = q.search_players(sd, club=\"Grêmio\", limit=3)\nprint(\"\\nGrêmio top:\", [(p.name, p.overall) for p in gr])\nEOF" action.permission=bash action.action=allow action.pattern=*
