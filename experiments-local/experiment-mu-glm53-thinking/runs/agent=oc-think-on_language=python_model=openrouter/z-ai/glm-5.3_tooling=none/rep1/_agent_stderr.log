timestamp=2026-09-01T15:45:48.301Z level=INFO run=ec76643f message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport time\nfrom brazilian_soccer import SoccerData, get_soccer_data\nfrom brazilian_soccer import queries as q\n\nt0 = time.time()\ndata = SoccerData()\nprint(f\"load: {time.time()-t0:.2f}s\\n\")\n\n# Re-run collision audit\nimport re\nfrom brazilian_soccer.normalize import BRAZILIAN_UFS, COUNTRY_CODES\nsuspects = {}\nfor key, info in data.teams.items():\n    suffixes = set()\n    for raw in info.variants:\n        for m in re.finditer(r'[-\\s]\\(?([A-Z]{2,3})\\)?\\s*$', raw):\n            code = m.group(1)\n            if code in BRAZILIAN_UFS or code in COUNTRY_CODES:\n                suffixes.add(code)\n    if len(suffixes) > 1:\n        suspects[key] = sorted(suffixes)\nprint(\"remaining mixed-suffix keys:\", suspects)\n\n# --- facts for tests ---\nst = q.standings(data, \"Brasileirão Série A\", 2019)\nprint(\"\\n2019 champion:\", st[\"champion\"], \"| top3:\",\n      [(r[\"team\"], r[\"points\"]) for r in st[\"table\"][:3]])\nprint(\"2019 relegated:\", st[\"relegated_bottom_4\"])\n\nst20 = q.standings(data, \"Série A\", 2020)\nprint(\"2020 champion:\", st20[\"champion\"], \"| relegated:\", st20[\"relegated_bottom_4\"])\n\nts = q.team_stats(data, \"Corinthians\", season=2022, venue=\"home\")\nprint(\"\\nCorinthians home 2022:\", ts[\"record\"])\n\nh2h = q.head_to_head(data, \"Flamengo\", \"Fluminense\")\nprint(\"\\nFla-Flu h2h total:\", h2h[\"total_matches\"], h2h[\"record\"], \"| latest:\", h2h[\"latest_match\"][\"date\"])\n\nf = q.find_finals(data, \"Libertadores\", 2018)\nprint(\"\\nLibertadores 2018 finals:\", [(m[\"home\"], m[\"away\"], m[\"score\"]) for m in f[\"finals\"][0][\"matches\"]], f[\"finals\"][0].get(\"winner_on_aggregate\"))\nf20 = q.find_finals(data, \"Copa do Brasil\", 2020)\nprint(\"Copa do Brasil 2020 finals:\", [(m[\"home\"], m[\"away\"], m[\"score\"]) for m in f20[\"finals\"][0][\"matches\"]], f20[\"finals\"][0].get(\"winner_on_aggregate\"))\n\n# players\nfor nm in [\"Neymar\", \"Neymar Jr\", \"Alisson\", \"Casemiro\", \"Gabriel Jesus\", \"Gabriel Barbosa\"]:\n    p = data.player_by_name(nm)\n    print(f\"\\n{nm}: {p.as_dict() if p else None}\")\n\nt1 = time.time()\nres = q.search_matches(data, team=\"Flamengo\", opponent=\"Fluminense\")\nprint(f\"\\nsearch_matches Flamengo x Fluminense: {res['total_matches']} in {time.time()-t1:.3f}s\")\nt2 = time.time()\ncs = q.competition_stats(data, \"Brasileirão Série A\")\nprint(f\"competition_stats Serie A: matches={cs['matches']} avg={cs['avg_goals_per_match']} home%={cs['home_win_rate']} in {time.time()-t2:.3f}s\")\n\nbw = q.biggest_wins(data, competition=\"Copa Libertadores\", limit=3)\nprint(\"biggest Libertadores wins:\", [(m[\"season\"], m[\"home\"], m[\"score\"], m[\"away\"]) for m in bw[\"matches\"]])\n\ndm = q.derby_matches(data, \"Gre-Nal\", season=2019)\nprint(\"Gre-Nal 2019:\", dm[\"derbies\"][0][\"total_matches\"], \"matches\")\nEOF" action.permission=bash action.action=allow action.pattern=*
