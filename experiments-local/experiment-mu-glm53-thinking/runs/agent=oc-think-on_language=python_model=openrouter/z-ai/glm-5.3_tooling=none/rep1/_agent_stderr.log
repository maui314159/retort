stats\"])\n\n# venue filter check\nts2 = q.team_stats(data, \"Palmeiras\", season=2019, competition=\"Série A\")\nprint(\"Palmeiras 2019 Serie A all:\", ts2[\"record\"][\"matches\"], \"W\", ts2[\"record\"][\"wins\"], \"pts-ish\")\nst99 = q.standings(data, \"Série A\", 2019)\npal = [r for r in st99[\"table\"] if r[\"team\"] == \"Palmeiras\"][0]\nprint(\"Palmeiras 2019 row:\", pal)\nEOF" action.permission=bash action.action=allow action.pattern=*
