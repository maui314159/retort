timestamp=2026-09-01T16:36:37.665Z level=INFO run=66fb43df message=evaluated permission=bash pattern="python3 << 'EOF'\nimport csv\nfrom collections import Counter\ndef load(f):\n    with open(f, encoding='utf-8') as fh:\n        return list(csv.DictReader(fh))\nbr = load('data/kaggle/BR-Football-Dataset.csv')\n# 2021 Serie A: count fixture pairs\nc = Counter()\nfor r in br:\n    if r['tournament']=='Serie A' and r['date'][:4]=='2021':\n        c[(r['home'], r['away'])] += 1\ndups = {k: v for k, v in c.items() if v > 1}\nprint('2021 Serie A pairs appearing >1:', len(dups), 'total matches:', sum(c.values()))\nprint(list(dups.items())[:5])\n# check if duplicated pairs have different scores/dates\nrows = [(r['date'], r['home'], r['away'], r['home_goal'], r['away_goal']) for r in br if r['tournament']=='Serie A' and r['date'][:4]=='2021' and (r['home'], r['away']) in list(dups)[:3]]\nfor x in sorted(rows): print(x)\nEOF" action.permission=bash action.action=allow action.pattern=*
