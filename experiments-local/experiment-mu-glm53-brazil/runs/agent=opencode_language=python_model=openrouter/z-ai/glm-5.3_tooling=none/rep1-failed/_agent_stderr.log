timestamp=2026-08-31T18:13:35.099Z level=INFO run=dde7c20f message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport csv\nfrom collections import Counter, defaultdict\n\ndef load(fn):\n    with open('data/kaggle/'+fn, encoding='utf-8') as f:\n        return list(csv.DictReader(f))\n\ncup = load('Brazilian_Cup_Matches.csv')\ns8 = defaultdict(list)\nfor r in cup:\n    if r['round'] == '8': s8[r['season']].append((r['home_team'], r['away_team'], r['home_goal'], r['away_goal'], r['datetime'][:10]))\nfor s in sorted(s8): print(s, s8[s])\n\nlib = load('Libertadores_Matches.csv')\nfin = defaultdict(list)\nfor r in lib:\n    if r['stage'] == 'final': fin[r['season']].append((r['home_team'], r['away_team'], r['home_goal'], r['away_goal'], r['datetime'][:10]))\nprint(); [print(s, fin[s]) for s in sorted(fin)]\n\nbrf = load('BR-Football-Dataset.csv')\nprint()\nts = defaultdict(set)\nfor r in brf: ts[r['tournament']].add(r['date'][:4])\nfor t in ts: print(t, sorted(ts[t]))\n# Vitoria ES / Atletico ES rows\nfor nm in ['Vitoria ES','Atletico - ES','EC Vitoria','Vitoria EC','Vitoria F. C. - ES']:\n    rows = [(r['tournament'], r['date'][:4], r['home'], r['away']) for r in brf if nm in (r['home'], r['away'])]\n    print(nm, len(rows), rows[:3])\nEOF" action.permission=bash action.action=allow action.pattern=*
