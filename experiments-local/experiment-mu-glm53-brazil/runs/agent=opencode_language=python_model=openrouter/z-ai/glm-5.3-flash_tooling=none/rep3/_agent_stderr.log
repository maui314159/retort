timestamp=2026-09-01T03:26:55.982Z level=INFO run=2973fea4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport sys, time\nsys.path.insert(0, '.')\nt0 = time.time()\nfrom brazilian_soccer.store import SoccerStore, NotFound\n\nstore = SoccerStore()\nprint(f\"store ready in {time.time()-t0:.2f}s\")\n\n# smoke all main methods\nprint(\"status:\", store.status()[\"matches\"], \"matches,\", store.status()[\"teams\"], \"teams\")\nt0 = time.time()\nh2h = store.head_to_head(\"Flamengo\", \"Fluminense\")\nprint(f\"h2h ({time.time()-t0:.3f}s):\", h2h[\"team_a_wins\"], h2h[\"draws\"], h2h[\"team_b_wins\"], \"| derby:\", h2h[\"derby\"])\nt0 = time.time()\ns = store.standings(\"Brasileirão Serie A\", 2019)\nprint(f\"standings ({time.time()-t0:.3f}s): champion:\", s[\"champion\"], \"| pts:\", s[\"table\"][0][\"points\"], \"| matches:\", s[\"total_matches_used\"])\nprint(\"  top3:\", [(r[\"position\"], r[\"team\"], r[\"points\"]) for r in s[\"table\"][:3]])\nt0 = time.time()\nts = store.team_stats(\"Corinthians\", season=2022, venue=\"home\")\nprint(f\"team_stats ({time.time()-t0:.3f}s):\", ts[\"team\"], ts[\"venue\"], \"->\", ts[\"matches\"], \"matches,\", ts[\"wins\"], \"W\", ts[\"draws\"], \"D\", ts[\"losses\"], \"L\", ts[\"win_rate\"], \"%\")\nt0 = time.time()\npl = store.search_players(nationality=\"brazil\", min_overall=85)\nprint(f\"players ({time.time()-t0:.3f}s):\", [(p[\"name\"], p[\"overall\"]) for p in pl[\"players\"][:5]])\nt0 = time.time()\np = store.get_player(\"Neymar Jr\")\nprint(f\"get_player ({time.time()-t0:.3f}s):\", p[\"name\"], p[\"overall\"], p[\"club\"])\nt0 = time.time()\npc = store.players_at_club(\"Fluminense\")\nprint(f\"players_at_club ({time.time()-t0:.3f}s):\", pc[\"total_players\"], \"avg\", pc[\"average_overall\"])\nt0 = time.time()\nst = store.statistics(competition=\"Brasileirão Serie A\")\nprint(f\"stats ({time.time()-t0:.3f}s): avg goals\", st[\"avg_goals_per_match\"], \"| home win rate\", st[\"home_win_rate\"], \"%\")\nprint(\"  biggest:\", st[\"biggest_wins\"][0])\nd = store.derbies(season=2023)\nprint(\"derbies 2023:\", len(d[\"derbies\"]), \"rivalries |\", d[\"derbies\"][0][\"derby\"], d[\"derbies\"][0][\"recent\"][0][\"score\"] if d[\"derbies\"][0][\"recent\"] else None)\nth = store.team_history(\"Palmeiras\")\nprint(\"Palmeiras competitions:\", list(th[\"competitions\"].keys()), \"| total:\", th[\"total_matches\"])\n# finals\nf = store.search_matches(stage=\"final\", competition=\"copa libertadores\", season=2018)\nprint(\"2018 Lib final:\", f[\"matches\"])\n# not found handling\ntry:\n    store.resolve_team(\"Atlético\")\nexcept NotFound as e:\n    print(\"NotFound demo:\", str(e)[:80])\nEOF" action.permission=bash action.action=allow action.pattern=*
