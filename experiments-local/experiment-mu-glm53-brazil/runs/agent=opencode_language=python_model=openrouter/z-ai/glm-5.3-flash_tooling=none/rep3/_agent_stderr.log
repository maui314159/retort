timestamp=2026-09-01T03:19:17.729Z level=INFO run=2973fea4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport sys, time\nsys.path.insert(0, '.')\nt0 = time.time()\nfrom brazilian_soccer.loader import load_all\nfrom collections import Counter\n\nreg, matches, players = load_all()\nprint(f\"loaded in {time.time()-t0:.2f}s: {len(matches)} matches, {len(players)} players\")\n\nfor season in (2018, 2019, 2020, 2022):\n    sa = [m for m in matches if m.competition == \"Brasileirão Serie A\" and m.season == season]\n    cnt = Counter()\n    for m in sa:\n        cnt[m.home_key] += 1; cnt[m.away_key] += 1\n    bad = {reg.display(k): v for k, v in cnt.items() if v != 38}\n    print(f\"Serie A {season}: {len(sa)} matches; wrong counts: {bad if bad else 'none'}\")\n\nfla = reg.key_for(\"Flamengo-RJ\"); flu = reg.key_for(\"Fluminense-RJ\")\nff = [m for m in matches if {m.home_key, m.away_key} == {fla, flu}]\nprint(\"Fla-Flu:\", len(ff))\n\nneymar = [p for p in players if p.name == \"Neymar Jr\"][0]\nprint(\"Neymar club:\", neymar.club_display, \"/\", neymar.club_key)\natm = reg.key_for(\"Atlético Mineiro\")\nprint(\"Atletico-MG players:\", sum(1 for p in players if p.club_key == atm))\nEOF" action.permission=bash action.action=allow action.pattern=*
