            kept[prev_idx] = match\n                        seen[key] = (match_date, rank, prev_idx)\n                    continue\n            seen[key] = (match_date, rank, len(kept))\n            kept.append(match)\n        self.matches = kept","oldString":"    def _deduplicate(self) -> None:\n        \"\"\"Drop matches repeated across sources (same comp/season/date/pair).\"\"\"\n        seen: set[tuple] = set()\n        kept: list[Match] = []\n        for match in self.matches:\n            if match.date:\n                key = (\n                    match.competition,\n                    match.season,\n                    match.date,\n                    identity_key(match.home_team),\n                    identity_key(match.away_team),\n                )\n                if key in seen:\n                    continue\n                seen.add(key)\n            kept.append(match)\n        self.matches = kept"},"output":"Edit applied successfully.","metadata":{"diagnostics":{},"diff":"Index: /Users/maui/.retort/work/retort-local-75154ofp/retort-242ce4667ad2/brazilian_soccer_mcp/data_loader.py\n===================================================================\n--- /Users/maui/.retort/work/retort-local-75154ofp/retort-242ce4667ad2/brazilian_soccer_mcp/data_loader.py\n+++ /Users/maui/.retort/work/retort-local-75154ofp/retort-242ce4667ad2/brazilian_soccer_mcp/data_loader.py\n@@ -273,24 +273,46 @@\n \n def _display_for(self, name: str) -> str:\n     return self._identity_to_display.get(identity_key(name), name)\n \n+# Overlapping sources may record the same fixture up to a few days apart\n+# (e.g. Flamengo x Cruzeiro on 2019-04-27 in one file, 2019-04-28 in\n+# another). Same competition + season + ordered pairing within this many\n+# days is treated as one fixture; the higher-priority source wins.\n+DEDUP_WINDOW_DAYS = 3\n+\n def _deduplicate(self) -> None:\n-    \"\"\"Drop matches repeated across sources (same comp/season/date/pair).\"\"\"\n-    seen: set[tuple] =