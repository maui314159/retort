{"type":"tool_use","timestamp":1788255159301,"sessionID":"ses_fa3ba9cb2ffeFGH9rzdcVMfYFE","part":{"type":"tool","tool":"bash","callID":"chatcmpl-tool-a3bd77d34d6fee21","state":{"status":"completed","input":{"command":"source venv/bin/activate && python - <<'EOF'\nimport asyncio\nfrom mcp.server.mcpserver import MCPServer\n\nserver = MCPServer(name=\"smoke\", version=\"0.1.0\")\n\n@server.tool()\ndef greet(name: str, excited: bool = False) -> str:\n    \"\"\"Greet someone.\"\"\"\n    msg = f\"hello {name}\"\n    return msg + \"!\" if excited else msg\n\n@server.tool()\ndef failing(x: int) -> str:\n    \"\"\"A tool that errors.\"\"\"\n    raise ValueError(\"boom\")\n\nasync def main():\n    tools = await server.list_tools()\n    for t in tools:\n        print(\"tool:\", t.name, \"|\", t.description, \"| schema:\", t.input_schema)\n    res = await server.call_tool(\"greet\", {\"name\": \"world\", \"excited\": True})\n    print(\"call_tool ->\", type(res).__name__)\n    print(\"content:\", res.content)\n    try:\n        await server.call_tool(\"failing\", {\"x\": 1})\n    except Exception as e:\n        print(\"error:\", type(e).__name__, \"->\", e)\n\nasyncio.run(main())\nEOF","workdir":"/Users/maui/.retort/work/retort-local-7ooj92cj/retort-9b01b8399d96"},"output":"tool: greet | Greet someone. | schema: {'properties': {'name': {'title': 'Name', 'type': 'string'}, 'excited': {'default': False, 'title': 'Excited', 'type': 'boolean'}}, 'required': ['name'], 'title': 'greetArguments', 'type': 'object'}\ntool: failing | A tool that errors. | schema: {'properties': {'x': {'title': 'X', 'type': 'integer'}}, 'required': ['x'], 'title': 'failingArguments', 'type': 'object'}\ncall_tool -> CallToolResult\ncontent: [TextContent(type='text', text='hello world!', annotations=None, meta=None)]\nerror: UnexpectedToolError -> Error executing tool failing\n","metadata":{"output":"tool: greet | Greet someone. | schema: {'properties': {'name': {'title': 'Name', 'type': 'string'}, 'excited': {'default': False, 'title': 'Excited', 'type': 'boolean'}}, 'required': ['name'], 'title': 'greetArguments', 'type': 'object'}\ntool: failing | A tool that errors. | schema: {'properties': {'x': {'title': 'X', 'type': 'integer'}}, 'required': ['x'], 'title': 'failingArguments', 'type': 'object'}\ncall_tool -> CallToolResult\ncontent: [TextContent(type='text', text='hello world!', annotations=None, meta=None)]\nerror: UnexpectedToolError -> Error executing tool failing\n","exit":0,"truncated":false},"title":"source venv/bin/activate && python - <<'EOF'\nimport asyncio\nfrom mcp.server.mcpserver import MCPServer\n\nserver = MCPServer(name=\"smoke\", version=\"0.1.0\")\n\n@server.tool()\ndef greet(name: str, excited: bool = False) -> str:\n    \"\"\"Greet someone.\"\"\"\n    msg = f\"hello {name}\"\n    return msg + \"!\" if excited else msg\n\n@server.tool()\ndef failing(x: int) -> str:\n    \"\"\"A tool that errors.\"\"\"\n    raise ValueError(\"boom\")\n\nasync def main():\n    tools = await server.list_tools()\n    for t in tools:\n        print(\"tool:\", t.name, \"|\", t.description, \"| schema:\", t.input_schema)\n    res = await server.call_tool(\"greet\", {\"name\": \"world\", \"excited\": True})\n    print(\"call_tool ->\", type(res).__name__)\n    print(\"content:\", res.content)\n    try:\n        await server.call_tool(\"failing\", {\"x\": 1})\n    except Exception as e:\n        print(\"error:\", type(e).__name__, \"->\", e)\n\nasyncio.run(main())\nEOF","time":{"start":1788255159268,"end":1788255159300}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05c50391b001E3fJvuOoLyplLS","sessionID":"ses_fa3ba9cb2ffeFGH9rzdcVMfYFE","messageID":"msg_05c503205001qVLo9RSgZBpGXu"}}
