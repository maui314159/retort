timestamp=2026-09-01T06:08:54.462Z level=INFO run=f180ecb5 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, re, unicodedata\nfrom collections import defaultdict\ndef fold(s):\n    s = unicodedata.normalize('NFKD', s)\n    s = ''.join(ch for ch in s if not unicodedata.combining(ch))\n    return re.sub(r'[^a-z0-9]', '', s.lower()).replace('athletico','atletico')\ndef parse(n):\n    n = re.sub(r'\\s*\\(antigo[^)]*\\)', '', n).strip()\n    for pat in (r'\\s*-\\s*([A-Z]{2})$', r'-([A-Z]{2})$', r'\\s+([A-Z]{2})$'):\n        m = re.search(pat, n)\n        if m: return fold(n[:m.start()]), m.group(1)\n    return fold(n), None\n\n# collect all (base, state) from cup file with multi-word bases\ncup_bases = set()\nfor r in csv.DictReader(open('data/kaggle/Brazilian_Cup_Matches.csv', encoding='utf-8-sig')):\n    for t in (r['home_team'], r['away_team']):\n        b, s = parse(t)\n        if ' ' in re.sub(r'\\s*-\\s*[A-Z]{2}$', '', t).strip() and len(b) > 6:\n            cup_bases.add((b, s, t.strip()[:40]))\n# which of those bases end with a known single-word club base? print all multiword for eyeballing\nshort = {}\nfor r in csv.DictReader(open('data/kaggle/Brasileirao_Matches.csv', encoding='utf-8-sig')):\n    for t in (r['home_team'], r['away_team']):\n        b, s = parse(t)\n        if ' ' not in t.replace('-'+ (s or ''), ''):\n            short[b] = t\nhits = []\nfor b, s, t in sorted(cup_bases):\n    for sb in short:\n        if b.endswith(sb) and b != sb:\n            hits.append((b, s, t, 'short form: ' + short[sb]))\nfor h in hits: print(h)\nprint('--- all multiword cup bases containing known words:')\nfor b, s, t in sorted(cup_bases):\n    if any(w in b for w in ('atletico','sport','ceara','america','vasco','bragantino','paranaense','mineiro','corinthians','saopaulo','santos','gremio','internacional','bahia','vitoria','botafogo')):\n        print(' ', b, s, t)\nEOF" action.permission=bash action.action=allow action.pattern=*
