timestamp=2026-09-01T14:47:25.182Z level=INFO run=bd57de6d message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, unicodedata, re\ndef slug(s):\n    s = unicodedata.normalize('NFKD', s)\n    s = ''.join(c for c in s if not unicodedata.combining(c)).lower()\n    s = ''.join(c if c.isalnum() else ' ' for c in s)\n    return ' '.join(s.split())\nrows = []\nwith open('data/kaggle/BR-Football-Dataset.csv', encoding='utf-8') as f:\n    for row in csv.DictReader(f):\n        if row['tournament'] == 'Serie A' and row['date'][:4] == '2022' and slug(row['home']) == 'corinthians':\n            rows.append((row['date'], int(float(row['home_goal'])), int(float(row['away_goal']))))\nw = sum(1 for r in rows if r[1]>r[2]); d = sum(1 for r in rows if r[1]==r[2]); l = sum(1 for r in rows if r[1]<r[2])\ngf = sum(r[1] for r in rows); ga = sum(r[2] for r in rows)\nprint(f\"Corinthians home 2022 (BRFB): {len(rows)} matches, {w}W {d}D {l}L, GF {gf} GA {ga}, win rate {w/len(rows)*100:.1f}%\")\n# avg goals Serie A all seasons (canonical ~ brfile 2012-2022)\nimport statistics\nvals = []\nwith open('data/kaggle/Brasileirao_Matches.csv', encoding='utf-8') as f:\n    for row in csv.DictReader(f):\n        try: vals.append(int(row['home_goal']) + int(row['away_goal']))\n        except (ValueError, TypeError): pass\nprint(\"Serie A avg goals (brfile):\", round(sum(vals)/len(vals), 3), \"matches:\", len(vals))\nhome_w = sum(1 for row in csv.DictReader(open('data/kaggle/Brasileirao_Matches.csv', encoding='utf-8')) if row['home_goal'].isdigit() and row['away_goal'].isdigit() and int(row['home_goal'])>int(row['away_goal']))\nprint(\"home win rate:\", round(home_w/len(vals)*100,1), \"%\")\nEOF" action.permission=bash action.action=allow action.pattern=*
