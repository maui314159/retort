timestamp=2026-09-01T15:28:33.874Z level=INFO run=ec76643f message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv\nfrom collections import Counter, defaultdict\n\ndef load(path):\n    with open(path, encoding='utf-8-sig') as f:\n        return list(csv.DictReader(f))\n\nbr = load('data/kaggle/BR-Football-Dataset.csv')\nbm = load('data/kaggle/Brasileirao_Matches.csv')\ncup = load('data/kaggle/Brazilian_Cup_Matches.csv')\nhist = load('data/kaggle/novo_campeonato_brasileiro.csv')\n\ns = defaultdict(Counter)\nfor r in br:\n    s[('BR-Football', r['tournament'])][r['date'][:4]] += 1\nfor r in bm:\n    s[('Brasileirao', 'Serie A')][r['season']] += 1\nfor r in cup:\n    s[('CupFile', 'Copa do Brasil')][r['season']] += 1\nfor r in hist:\n    s[('Historico', 'Serie A')][r['Ano']] += 1\n\nfor k in sorted(s):\n    print(k, dict(sorted(s[k].items())))\n\n# Copa do Brasil: cup vs BR-Football overlap by season\ncd = defaultdict(lambda: defaultdict(set))\nfor r in cup:\n    cd[r['season']]['cup'].add((r['datetime'][:10], r['home_team'], r['away_team']))\nfor r in br:\n    if r['tournament'] == 'Copa do Brasil':\n        cd[r['date'][:4]]['brf'].add((r['date'], r['home'], r['away']))\nfor season in sorted(cd):\n    c, b = cd[season].get('cup', set()), cd[season].get('brf', set())\n    print(f\"Copa {season}: cup={len(c)} brf={len(b)} overlap={len(c & b)}\")\nEOF" action.permission=bash action.action=allow action.pattern=*
