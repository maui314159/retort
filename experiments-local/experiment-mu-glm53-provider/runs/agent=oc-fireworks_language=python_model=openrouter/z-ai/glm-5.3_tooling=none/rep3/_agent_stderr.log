timestamp=2026-09-01T10:09:26.615Z level=INFO run=f27b5900 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nfrom collections import defaultdict\nfrom datetime import date\nfrom brsoccer.data import _raw_rows, find_data_dir\nfrom brsoccer.normalize import TeamRegistry\n\nraw = _raw_rows(find_data_dir())\nreg = TeamRegistry()\nfor r in raw:\n    reg.ingest(r['home_raw']); reg.ingest(r['away_raw'])\nreg.finalize()\n\n# Fix BRF season for leagues: Jan/Feb -> previous year\ndef fixed_season(r):\n    if r['source']=='BR-Football-Dataset.csv' and r['competition'] in ('serie_a','serie_b','serie_c'):\n        d = r['date']\n        if d and d.month <= 2:\n            return d.year - 1\n    return r['season']\n\n# After fix: per league season, bucket by (home, away); check score agreement\nfor comp in ('serie_a','serie_b','serie_c'):\n    buckets = defaultdict(list)\n    for r in raw:\n        if r['competition']!=comp: continue\n        s = fixed_season(r)\n        if s is None: continue\n        buckets[(s, reg.key_of(r['home_raw']), reg.key_of(r['away_raw']))].append(r)\n    multi = {k:v for k,v in buckets.items() if len(v)>1}\n    conflict = 0; agree = 0; partial = 0\n    for k, v in multi.items():\n        scores = {(r['home_goal'], r['away_goal']) for r in v}\n        real = {s for s in scores if s[0] is not None and s[1] is not None}\n        if len(real) > 1: conflict += 1\n        elif len(real) == 1: agree += 1\n        else: partial += 1\n    per_season = defaultdict(set)\n    for (s,h,a) in buckets: per_season[s].add((h,a))\n    print(f\"{comp}: buckets={len(buckets)} multi={len(multi)} agree={agree} conflict={conflict} scoreless={partial}\")\n    sizes = {s: len(pairs) for s, pairs in sorted(per_season.items())}\n    print(\"   unique ordered pairs per season:\", sizes)\n\n# Copa: BRF vs COPA file overlap after season fix (cups keep date-year season)\nfor comp in ('copa_do_brasil',):\n    per = defaultdict(int)\n    copa_keys = {}\n    for r in raw:\n        if r['competition']!=comp: continue\n        per[(r['source'], r['season'])] += 1\n    print(f\"\\n{comp} rows by source/season:\", dict(sorted(per.items())))\n    # exact + fuzzy match analysis\n    brf = [(r['date'], reg.key_of(r['home_raw']), reg.key_of(r['away_raw']), r['home_goal'], r['away_goal'], r['season']) for r in raw if r['competition']==comp and r['source']=='BR-Football-Dataset.csv']\n    cup = [(r['date'], reg.key_of(r['home_raw']), reg.key_of(r['away_raw']), r['home_goal'], r['away_goal'], r['season']) for r in raw if r['competition']==comp and r['source']=='Brazilian_Cup_Matches.csv']\n    cupset = {(d,h,a) for d,h,a,*_ in cup}\n    exact = sum(1 for d,h,a,*_ in brf if (d,h,a) in cupset)\n    fuzzy = 0\n    for d,h,a,hg,ag,s in brf:\n        if (d,h,a) in cupset: continue\n        for d2,h2,a2,*_ in cup:\n            if h==h2 and a==a2 and d2 and d and abs((d2-d).days) <= 1:\n                fuzzy += 1; break\n    print(f\"  BRF copa rows: {len(brf)}, exact-match w/ COPA file: {exact}, fuzzy(±1d same teams): {fuzzy}, unmatched: {len(brf)-exact-fuzzy}\")\nEOF" action.permission=bash action.action=allow action.pattern=*
