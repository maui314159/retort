timestamp=2026-09-01T13:40:04.199Z level=INFO run=d0d26016 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv\nfrom collections import defaultdict\ndef standings(rows, season):\n    st = {}\n    for r in rows:\n        if r['season'] != season: continue\n        h, a, hg, ag = r['home_team'], r['away_team'], int(r['home_goal']), int(r['away_goal'])\n        for t in (h, a): st.setdefault(t, [0]*8)  # P W D L GF GA GD Pts\n        st[h][0]+=1; st[a][0]+=1\n        st[h][5]+=ag; st[a][5]+=hg; st[h][4]+=hg; st[a][4]+=ag\n        if hg>ag: st[h][1]+=1; st[a][3]+=1; st[h][7]+=3\n        elif hg<ag: st[a][1]+=1; st[h][3]+=1; st[a][7]+=3\n        else: st[h][2]+=1; st[a][2]+=1; st[h][7]+=1; st[a][7]+=1\n    for t,v in st.items(): v[6]=v[4]-v[5]\n    return sorted(st.items(), key=lambda kv:(-kv[1][7],-kv[1][6],-kv[1][4]))\n\nwith open('data/kaggle/Brasileirao_Matches.csv', encoding='utf-8') as f:\n    rows = list(csv.DictReader(f))\nfor season in ('2019','2020','2021'):\n    tab = standings(rows, season)\n    print(f\"== {season} ==\")\n    for i,(t,v) in enumerate(tab[:3],1): print(f\"  {i}. {t} {v[7]}pts P{v[0]} W{v[1]} D{v[2]} L{v[3]} GF{v[4]} GA{v[5]}\")\n    print(\"  relegated:\", [t for t,v in tab[-4:]])\nEOF" action.permission=bash action.action=allow action.pattern=*
