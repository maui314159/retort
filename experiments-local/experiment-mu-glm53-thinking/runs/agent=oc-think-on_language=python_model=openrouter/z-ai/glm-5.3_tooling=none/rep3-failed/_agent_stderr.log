timestamp=2026-09-01T17:03:44.329Z level=INFO run=a6cf503f message=evaluated permission=bash pattern="venv/bin/python -c \"\nimport csv\nfrom collections import Counter\n\ndef seasons(path, col='season'):\n    s = Counter()\n    with open(path, encoding='utf-8-sig') as f:\n        for row in csv.DictReader(f): s[row[col]] += 1\n    return s\n\nprint('Brasileirao:', sorted(seasons('data/kaggle/Brasileirao_Matches.csv').items()))\nprint()\nprint('Copa do Brasil:', sorted(seasons('data/kaggle/Brazilian_Cup_Matches.csv').items()))\nprint()\nprint('Libertadores:', sorted(seasons('data/kaggle/Libertadores_Matches.csv').items()))\nprint()\nprint('novo (Ano):', sorted(seasons('data/kaggle/novo_campeonato_brasileiro.csv', 'Ano').items()))\nprint()\n# BR-Football by tournament and year\nc = Counter()\nwith open('data/kaggle/BR-Football-Dataset.csv', encoding='utf-8-sig') as f:\n    for row in csv.DictReader(f): c[(row['tournament'], row['date'][:4])] += 1\nfor k in sorted(c): print(k, c[k])\n\"" action.permission=bash action.action=allow action.pattern=*
