timestamp=2026-09-01T17:16:29.012Z level=INFO run=a6cf503f message=evaluated permission=bash pattern="venv/bin/python -c \"\nfrom brazilian_soccer import load_soccer_data\nfrom brazilian_soccer.loader import BRASILEIRAO_A\nfrom collections import defaultdict\nd = load_soccer_data()\n\nfor season in [2013, 2020, 2021, 2023]:\n    fx = defaultdict(list)\n    for m in d.matches:\n        if m.competition == BRASILEIRAO_A and m.season == season:\n            fx[(m.home, m.away)].append((str(m.date), m.home_goals, m.away_goals, m.source))\n    dups = {k: v for k, v in fx.items() if len(v) > 1}\n    print(f'--- {season}: {len(dups)} duplicated pairings, {sum(len(v)-1 for v in dups.values())} extra matches')\n    for k, v in list(dups.items())[:4]:\n        print('   ', d.display_team(k[0]), 'vs', d.display_team(k[1]))\n        for x in v: print('      ', x)\n\"" action.permission=bash action.action=allow action.pattern=*
