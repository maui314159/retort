timestamp=2026-08-31T18:38:46.304Z level=INFO run=9abcf33e message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv, re, unicodedata\n\ndef strip_accents(s):\n    return ''.join(c for c in unicodedata.normalize('NFD', s) if unicodedata.category(c) != 'Mn')\n\ndef norm(name):\n    n = strip_accents(name).lower().strip()\n    n = re.sub(r'\\s*-\\s*[a-z]{2}\\s*$', '', n)  # trailing -SP\n    n = re.sub(r'\\s*\\((antigo[^)]*)\\)\\s*', ' ', n)\n    return n.strip()\n\ndef load(path):\n    with open(path, encoding='utf-8') as f:\n        return list(csv.DictReader(f))\n\nnames = set()\nfor r in load('data/kaggle/Brasileirao_Matches.csv'):\n    names.add(r['home_team'])\nfor r in load('data/kaggle/novo_campeonato_brasileiro.csv'):\n    names.add(r['Equipe_mandante'])\nfor r in load('data/kaggle/Brazilian_Cup_Matches.csv'):\n    names.add(r['home_team'])\nfor r in load('data/kaggle/BR-Football-Dataset.csv'):\n    names.add(r['home'])\n# group by normalized name to find collisions\nfrom collections import defaultdict\ng = defaultdict(set)\nfor n in names:\n    g[norm(n)].add(n)\ncoll = {k: v for k, v in g.items() if len(v) > 1}\nprint(\"Normalized collisions:\")\nfor k, v in sorted(coll.items()):\n    print(f\"  {k}: {sorted(v)}\")\nEOF" action.permission=bash action.action=allow action.pattern=*
