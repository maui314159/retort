ternacional','goias']:\n    forms = [k for k in by_canon if k.startswith(base)]\n    print(f'  {base!r:20} -> {sorted(forms)}')\nEOF","workdir":"/Users/maui/.retort/work/retort-local-tfe1ts5p/retort-a725f4ae3f5d"},"output":"BR-Football names whose canon base is ambiguous (no state):\n  vitoria -> ['Vitoria']\n  america -> NONE\n  botafogo -> NONE\n  atletico -> NONE\n  athletico -> NONE\n  flamengo -> ['Flamengo']\n  santos -> ['Santos']\n  bahia -> NONE\n  sport -> NONE\n  internacional -> ['Internacional']\n  gremio -> ['Gremio']\n  parana -> ['Parana']\n  goias -> ['Goias']\n  ceara -> ['Ceara']\n  nautico -> NONE\n  csa -> ['CSA']\n  criciuma -> ['Criciuma']\n  avai -> ['Avai']\n  coritiba -> ['Coritiba']\n\n  'vitoria'            -> ['vitoria', 'vitoria da conquista', 'vitoria ec', 'vitoria-es']\n  'america'            -> ['america fc natal', 'america-mg', 'america-rn', 'americano-rj']\n  'botafogo'           -> ['botafogo-pb', 'botafogo-rj', 'botafogo-sp']\n  'atletico'           -> ['atletico acreano', 'atletico alagoinhas', 'atletico goianiense', 'atletico mineiro', 'atletico paranaense']\n  'sport'              -> ['sport recife']\n  'bahia'              -> ['bahia de feira']\n  'ceara'              -> ['ceara']\n  'csa'                -> ['csa']\n  'santos'             -> ['santos', 'santos-ap']\n  'gremio'             -> ['gremio', 'gremio anapolis', 'gremio novorizontino', 'gremio-rs']\n  'flamengo'           -> ['flamengo']\n  'palmeiras'          -> ['palmeiras']\n  'corinthians'        -> ['corinthians']\n  'sao paulo'          -> ['sao paulo']\n  'vasco'              -> ['vasco da gama-rj']\n  'cuiaba'             -> ['cuiaba', 'cuiaba-mt']\n  'athletico'          -> ['athletico paranaense']\n  'parana'             -> ['parana']\n  'internacional'      -> ['internacional', 'internacional-rs']\n  'goias'              -> ['goias']\n","metadata":{"output":"BR-Football names whose canon base is ambiguous (no state):\n  vitoria -> ['Vitoria']\n  america -