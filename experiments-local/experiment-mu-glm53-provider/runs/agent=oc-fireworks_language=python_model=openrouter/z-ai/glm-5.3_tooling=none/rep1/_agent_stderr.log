timestamp=2026-09-01T05:33:04.915Z level=INFO run=2c158548 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, re, datetime as dt, unicodedata, collections\ndef deacc(s): return ''.join(c for c in unicodedata.normalize('NFKD', s) if not unicodedata.combining(c)).lower()\nSTATES={'AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'}\nALIAS={('atletico mineiro','MG'):('atletico','MG'),('athletico paranaense','PR'):('atletico','PR'),('atletico paranaense','PR'):('atletico','PR'),('athletico',None):('atletico','PR'),('vasco da gama',None):('vasco','RJ'),('vasco da gama','RJ'):('vasco','RJ'),('sport recife',None):('sport','PE')}\ndef key(name, state=None):\n    s = re.sub(r'\\(.*?\\)',' ', deacc(name.strip())).replace(\"'\",'')\n    toks=[t for t in re.split(r'[\\s\\-]+',s) if t]\n    st=state\n    if toks and toks[-1].upper() in STATES and len(toks)>1: st=toks[-1].upper(); toks=toks[:-1]\n    toks=[t.replace('.','') for t in toks]\n    FORM={'ec','sc','fc','ce','ge','ca','ad','se','aa','club','clube','futebol','ltda','esporte'}\n    while len(toks)>1 and toks[0] in FORM: toks=toks[1:]\n    while len(toks)>1 and toks[-1] in FORM: toks=toks[:-1]\n    while len(toks)>1 and len(toks[-1])==1: toks=toks[:-1]\n    core=' '.join(toks)\n    a=ALIAS.get((core,st))\n    if a: core,st=a\n    return f\"{core}|{st or ''}\"\ndef load(fn):\n    with open(fn, encoding='utf-8') as f: return list(csv.DictReader(f))\ndef pd_(s):\n    s=s.strip()\n    for f in ('%Y-%m-%d %H:%M:%S','%Y-%m-%d','%d/%m/%Y'):\n        try: return dt.datetime.strptime(s,f).date()\n        except ValueError: pass\n    return None\ndef g(s):\n    try: return int(float(s))\n    except (ValueError,TypeError): return None\ngrp=collections.defaultdict(list)\nfor r in load('data/kaggle/Brasileirao_Matches.csv'):\n    if r['season']=='2012':\n        grp[(key(r['home_team']),key(r['away_team']))].append(('bras',pd_(r['datetime']),g(r['home_goal']),g(r['away_goal']),r['home_team'],r['away_team']))\nfor r in load('data/kaggle/novo_campeonato_brasileiro.csv'):\n    if r['Ano']=='2012':\n        grp[(key(r['Equipe_mandante'],r['Mandante_UF']),key(r['Equipe_visitante'],r['Visitante_UF']))].append(('novo',pd_(r['Data']),g(r['Gols_mandante']),g(r['Gols_visitante']),r['Equipe_mandante'],r['Equipe_visitante']))\nn=0\nfor k,v in sorted(grp.items()):\n    if len(v)>1:\n        for a in v:\n            for b in v:\n                if a[0]=='bras' and b[0]=='novo' and (a[2],a[3])!=(b[2],b[3]):\n                    n+=1\n                    if n<=10: print(k, a, b)\nprint(\"score-disagree pairs 2012:\", n)\n# how many groups have >1 and all same score?\nsame=0; diff=0\nfor k,v in grp.items():\n    if len(v)>1:\n        sc={(x[2],x[3]) for x in v}\n        if len(sc)==1: same+=1\n        else: diff+=1\nprint(\"groups>1 same-score:\", same, \"diff-score:\", diff, \"total groups:\", len(grp))\n# total rows 2012\nprint(\"bras2012:\", sum(1 for r in load('data/kaggle/Brasileirao_Matches.csv') if r['season']=='2012'),\n      \"novo2012:\", sum(1 for r in load('data/kaggle/novo_campeonato_brasileiro.csv') if r['Ano']=='2012'))\nEOF" action.permission=bash action.action=allow action.pattern=*
