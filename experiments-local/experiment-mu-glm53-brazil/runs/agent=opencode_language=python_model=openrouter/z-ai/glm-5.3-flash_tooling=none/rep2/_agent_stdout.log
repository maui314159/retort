{"type":"tool_use","timestamp":1788206810152,"sessionID":"ses_fa6ae4622ffeRIXSVkVPYYmujp","part":{"type":"tool","tool":"write","callID":"call_fe6c1c2586a44e8abe3e7947","state":{"status":"completed","input":{"content":"\"\"\"Shared pytest fixtures for the Brazilian Soccer MCP test suite.\n\nThe real Kaggle datasets are loaded once per test session (about three\nseconds) and shared by every BDD scenario and unit test.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport time\nfrom pathlib import Path\n\nimport pytest\n\nfrom brazilian_soccer_mcp.data_loader import SoccerData\nfrom brazilian_soccer_mcp.knowledge_graph import KnowledgeGraph\nfrom brazilian_soccer_mcp.queries import QueryEngine\n\nDATA_DIR = Path(__file__).resolve().parent.parent / \"data\" / \"kaggle\"\n\n\n@pytest.fixture(scope=\"session\")\ndef data() -> SoccerData:\n    return SoccerData(DATA_DIR)\n\n\n@pytest.fixture(scope=\"session\")\ndef engine(data: SoccerData) -> QueryEngine:\n    return QueryEngine(data=data)\n\n\n@pytest.fixture(scope=\"session\")\ndef graph(data: SoccerData) -> KnowledgeGraph:\n    return KnowledgeGraph(data, build=False).build(data) or KnowledgeGraph(data, build=False)\n","filePath":"/Users/maui/.retort/work/retort-local-e6k_mc30/retort-7439bfc38313/tests/conftest.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/maui/.retort/work/retort-local-e6k_mc30/retort-7439bfc38313/tests/conftest.py","exists":false,"truncated":false},"title":"tests/conftest.py","time":{"start":1788206810136,"end":1788206810148}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_0596e84100019H9FZaiia2KITy","sessionID":"ses_fa6ae4622ffeRIXSVkVPYYmujp","messageID":"msg_0596e5101001hKzfQm4nQsbzsD"}}
