            isbn TEXT\n+        )\n+        \"\"\"\n+    )\n+    conn.commit()\n+    if app.config[\"DB_IS_MEMORY\"]:\n+        app.config[\"_PIN_CONN\"] = conn\n+    else:\n+        conn.close()\n \n+\n def book_from_row(row):\n     \"\"\"Serialize a sqlite3.Row into a JSON-friendly dict.\"\"\"\n     return {\n         \"id\": row[\"id\"],\n","filediff":{"file":"/Users/maui/.retort/work/retort-local-yc51is89/retort-ba55a43a432c/app.py","patch":"Index: /Users/maui/.retort/work/retort-local-yc51is89/retort-ba55a43a432c/app.py\n===================================================================\n--- /Users/maui/.retort/work/retort-local-yc51is89/retort-ba55a43a432c/app.py\n+++ /Users/maui/.retort/work/retort-local-yc51is89/retort-ba55a43a432c/app.py\n@@ -7,20 +7,38 @@\n \n DB_PATH = os.environ.get(\"BOOKS_DB_PATH\", \"books.db\")\n \n \n+def _connect(db_uri, uri):\n+    \"\"\"Open a SQLite connection that obeys the shared-cache convention for\n+    in-memory databases (``:memory:``) so multiple connections see the same DB.\"\"\"\n+    conn = sqlite3.connect(db_uri, uri=uri, check_same_thread=False)\n+    conn.row_factory = sqlite3.Row\n+    return conn\n+\n+\n+def _resolve_db_uri(db_path):\n+    \"\"\"Return ``(uri, is_memory)``. ``:memory:`` is converted to a shared-cache\n+    URI so separate connections in the same process see the same schema/data.\"\"\"\n+    if db_path == \":memory:\":\n+        return \"file:books_db?mode=memory&cache=shared\", True\n+    return db_path, False\n+\n+\n def create_app(db_path=None):\n     \"\"\"Application factory.\n \n     Args:\n         db_path: Path to the SQLite file. When ``None`` (default), falls back to\n-            the ``BOOKS_DB_PATH`` env var, then to ``books.db``. Passing an\n-            in-memory ``:memory:`` path makes the app suitable for tests.\n+            the ``BOOKS_DB_PATH`` env var, then to ``books.db``. Passing\n+            ``:memory:`` makes the app suitable for tests.\n     \"\"\"\n     app = Flask(__name__)\n     if db_path is None:\n         db_path = os.environ.get(\"BOOKS_DB_PATH\", \"books.db\")\n-    app.config[\"DB_PATH\"] = db_path\n+    uri, is_memory = _resolve_db_uri(db_path)\n+    app.config[\"DB_URI\"] = uri\n+    app.config[\"DB_IS_MEMORY\"] = is_memory\n \n     @app.teardown_appcontext\n     def close_db(exc):\n         conn = getattr(g, \"_db_conn\", None)\n@@ -34,34 +52,38 @@\n \n def get_db():\n     \"\"\"Return a per-request SQLite connection, opening one if necessary.\"\"\"\n     if \"_db_conn\" not in g.__dict__:\n-        g._db_conn = sqlite3.connect(current_app.config[\"DB_PATH\"])\n-        g._db_conn.row_factory = sqlite3.Row\n+        g._db_conn = _connect(current_app.config[\"DB_URI\"], uri=True)\n     return g._db_conn\n \n \n def init_db(app):\n-    \"\"\"Create the schema if it does not already exist.\"\"\"\n-    with app.app_context():\n-        conn = sqlite3.connect(app.config[\"DB_PATH\"])\n-        try:\n-            conn.execute(\n-                \"\"\"\n-                CREATE TABLE IF NOT EXISTS books (\n-                    id INTEGER PRIMARY KEY AUTOINCREMENT,\n-                    title TEXT NOT NULL,\n-                    author TEXT NOT NULL,\n-                    year INTEGER,\n-                    isbn TEXT\n-                )\n-                \"\"\"\n-            )\n-            conn.commit()\n-        finally:\n-            conn.close()\n+    \"\"\"Create the schema if it does not already exist.\n \n+    For in-memory databases the connection opened here is kept alive for the\n+    lifetime of the app (stored on ``app.config``); otherwise the in-memory DB\n+    would be destroyed as soon as this connection closes.\n+    \"\"\"\n+    conn = _connect(app.config[\"DB_URI\"], uri=True)\n+    conn.execute(\n+        \"\"\"\n+        CREATE TABLE IF NOT EXISTS books (\n+            id INTEGER PRIMARY KEY AUTOINCREMENT,\n+            title TEXT NOT NULL,\n+            author TEXT NOT NULL,\n+            year INTEGER,\n+            isbn TEXT\n+        )\n+        \"\"\"\n+    )\n+    conn.commit()\n+    if app.config[\"DB_IS_MEMORY\"]:\n+        app.config[\"_PIN_CONN\"] = conn\n+    else:\n+        conn.close()\n \n+\n def book_from_row(row):\n     \"\"\"Serialize a sqlite3.Row into a JSON-friendly dict.\"\"\"\n     return {\n         \"id\": row[\"id\"],\n","additions":45,"deletions":23},"truncated":false},"title":"app.py","time":{"start":1788196907791,"end":1788196907793}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"The problem: with `:memory:` SQLite, each connection gets its own database. The `init_db` opens one connection and creates the table, but `get_db` opens a different connection per request, so the table doesn't exist there. I need a single shared connection for `:memory:` mode.\n\nThe classic fix: for in-memory databases, use a shared connection via a URI like `file::memory:?cache=shared`. Or better, use the `check_same_thread=False` and a single connection. \n\nThe cleanest approach: in `init_db` and `get_db`, use the same connection for `:memory:`. Actually the standard fix is to use `sqlite3.connect(db_path, uri=True)` with `file::memory:?cache=shared` when db_path == \":memory:\".\n\nLet me modify so `:memory:` uses the shared-cache URI form. Also need to keep one persistent connection alive for the lifetime of the app, otherwise the in-memory DB is dropped when last connection closes.\n\nSimplest robust fix: maintain a module-level persistent connection for the in-memory case. Let me use `uri=True` with `file::memory:?cache=shared` and keep the init connection alive by storing it on the app.\n\nActually the cleanest: use a single persistent connection stored on the app config, opened in init_db and reused by get_db. Let me restructure.\n\nFor the file-based case, per-request connections are fine. For `:memory:`, we need one persistent connection. Let me just always keep a persistent connection on the app and use it for all requests, with `check_same_thread=False`. That's simpler and works for both modes (Flask test client is single-threaded anyway). For production with the dev server (`app.run`) it's single-threaded by default too; though threaded mode would need a lock. Let me use a connection per request for file mode but a shared persistent connection for memory mode.\n\nActually the simplest robust solution: detect `:memory:` and convert to URI shared-cache, and keep one connection alive permanently to pin the DB. Let me do:\n\n```python\ndef _normalize_db_path(db_path):\n    if db_path == \":memory:\":\n        return \"file::memory:?cache=shared\", True\n    return db_path, False\n```\n\nIn init_db, open the connection (with uri if needed) and for memory, keep it stored on app to prevent GC. In get_db, open per-request with same uri.\n\nLet me implement this.","format":"unknown","index":0}]}},"id":"prt_058d76aff001qcmcFrwiouedVM","sessionID":"ses_fa72b1d29ffe24CcENoHmfOP3D","messageID":"msg_058d71418001QY4cAMoAyvyVTy"}}
