timestamp=2026-09-01T09:58:21.053Z level=INFO run=f27b5900 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv, re, unicodedata\nfrom collections import defaultdict\nfrom datetime import datetime\n\ndef rows(p):\n    with open(p, encoding='utf-8-sig') as f:\n        return list(csv.DictReader(f))\n\nUF = {'AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'}\nALIAS = {'athletico pr':'atletico pr', 'vasco da gama':'vasco'}\n\ndef deacc(s):\n    return ''.join(c for c in unicodedata.normalize('NFD', s) if not unicodedata.combining(c))\n\ndef norm(name):\n    s = deacc(name).lower().replace('.', ' ')\n    s = re.sub(r'\\s+', ' ', s).strip()\n    for _ in range(2):\n        m = re.search(r'(?:^|\\s)[-–]\\s*([a-z]{2})$', s)\n        if m and m.group(1).upper() in UF:\n            s = s[:m.start()].strip()\n        s = re.sub(r'\\s*[-–]\\s*([a-z]{2})$', '', s) if re.search(r'[-–]\\s*([a-z]{2})$', s) and re.search(r'[-–]\\s*([a-z]{2})$', s).group(1).upper() in UF else s\n    return ALIAS.get(s, s)\n\nbra = rows('data/kaggle/Brasileirao_Matches.csv')\nhist = rows('data/kaggle/novo_campeonato_brasileiro.csv')\nbf = rows('data/kaggle/BR-Football-Dataset.csv')\n\ndef to_int(v):\n    v = v.strip()\n    return int(float(v)) if v and v not in ('NA','-','') else None\n\nseen = {}\nmatches = []\ndef add(date, home, away, hg, ag, season, src):\n    k = (date, norm(home), norm(away))\n    if k in seen: return\n    seen[k] = src\n    matches.append((date, norm(home), norm(away), hg, ag, int(season), src))\n\nfor r in bra:\n    add(r['datetime'][:10], r['home_team'], r['away_team'], to_int(r['home_goal']), to_int(r['away_goal']), r['season'], 'bra')\nfor r in hist:\n    d = datetime.strptime(r['Data'], '%d/%m/%Y').strftime('%Y-%m-%d')\n    add(d, r['Equipe_mandante'], r['Equipe_visitante'], to_int(r['Gols_mandante']), to_int(r['Gols_visitante']), r['Ano'], 'hist')\nfor r in bf:\n    if r['tournament'] == 'Serie A':\n        add(r['date'], r['home'], r['away'], to_int(r['home_goal']), to_int(r['away_goal']), r['date'][:4], 'brf')\n\n# per-season counts after dedupe\nsc = defaultdict(int)\nfor m in matches: sc[m[5]] += 1\nprint(\"serie_a dedup per season:\", dict(sorted(sc.items())))\n\n# 2019 standings\ndef standings(season):\n    tbl = defaultdict(lambda: [0,0,0,0,0])  # pts,w,d,l,gf,ga\n    for date, h, a, hg, ag, s, src in matches:\n        if s != season or hg is None or ag is None: continue\n        for team, gf, ga_ in ((h,hg,ag),(a,ag,hg)):\n            t = tbl[team]; t[3]+=1; t[4]+=gf; t[5]+=ga_\n            if gf > ga_: t[0]+=3; t[1]+=1\n            elif gf == ga_: t[0]+=1; t[2]+=1\n            else: t[3]+=1\n    return sorted(tbl.items(), key=lambda x: (-x[1][0], -(x[1][4]-x[1][5])))\n\nprint(\"\\n2019 Serie A top 5:\")\nfor team, (pts,w,d,l,gf,ga) in standings(2019)[:5]:\n    print(f\"  {team}: {pts} pts ({w}W {d}D {l}L) GF{gf} GA{ga}\")\nprint(\"2019 bottom 4:\", [t for t,_ in standings(2019)[-4:]])\nprint(\"\\n2020 bottom 4:\", [t for t,_ in standings(2020)[-4:]])\nprint(\"\\n2021 count check (BRF alone 491):\", sum(1 for m in matches if m[5]==2021))\n# Fla-Flu 2023-09-03 in BRF?\nflaflu = [m for m in matches if m[5]==2023 and {m[1],m[2]}=={'flamengo','fluminense'}]\nprint(\"\\nFla-Flu 2023 matches:\", flaflu[:4], \"total:\", len(flaflu))\n# BRF internal dupes 2021\nk = defaultdict(int)\nfor r in bf:\n    if r['tournament']=='Serie A' and r['date'][:4]=='2021':\n        k[(r['date'], norm(r['home']), norm(r['away']))] += 1\ndups = {kk:v for kk,v in k.items() if v>1}\nprint(\"BRF 2021 Serie A internal duplicate keys:\", len(dups), list(dups.items())[:3])\nEOF" action.permission=bash action.action=allow action.pattern=*
