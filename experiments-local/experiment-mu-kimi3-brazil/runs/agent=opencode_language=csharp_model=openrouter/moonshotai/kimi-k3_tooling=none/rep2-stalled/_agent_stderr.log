timestamp=2026-08-02T13:25:54.424Z level=INFO run=44407034 message=evaluated permission=bash pattern="python3 -c \"\nimport csv, re, unicodedata\ndef norm(s):\n    s = re.sub(r'\\s*\\([^)]*\\)', '', s).strip()\n    s = ''.join(c for c in unicodedata.normalize('NFD', s) if unicodedata.category(c) != 'Mn')\n    return s.lower()\nrows = list(csv.DictReader(open('/Users/maui/.retort/work/retort-local-syu3u3ut/retort-02000dd611c2/data/kaggle/Brasileirao_Matches.csv', encoding='utf-8')))\n# Corinthians home 2022\nh = [r for r in rows if r['season']=='2022' and norm(r['home_team']).startswith('corinthians')]\nw = sum(1 for r in h if int(r['home_goal'])>int(r['away_goal']))\nd = sum(1 for r in h if r['home_goal']==r['away_goal'])\nl = len(h)-w-d\ngf = sum(int(r['home_goal']) for r in h); ga = sum(int(r['away_goal']) for r in h)\nprint('Corinthians home 2022:', len(h), w, d, l, gf, ga)\n# Fla-Flu\nff = [r for r in rows if {norm(r['home_team']), norm(r['away_team'])} == {'flamengo-rj','fluminense-rj'}]\nprint('Fla-Flu in Brasileirao_Matches:', len(ff), ff[-1]['datetime'] if ff else None)\n# 2019 standings check\nfrom collections import defaultdict\npts = defaultdict(lambda: [0,0,0,0,0,0])\nfor r in rows:\n    if r['season']!='2019': continue\n    ht, at = r['home_team'], r['away_team']; hg, ag = int(r['home_goal']), int(r['away_goal'])\n    pts[ht][0]+= hg>ag and 3 or hg==ag and 1 or 0; pts[at][0]+= ag>hg and 3 or hg==ag and 1 or 0\ntop = sorted(pts.items(), key=lambda kv:-kv[1][0])[:3]\nprint('2019 top3:', top)\n\"" action.permission=bash action.action=allow action.pattern=*
timestamp=2026-08-02T13:25:58.755Z level=INFO run=44407034 message=evaluated permission=bash pattern="python3 -c \"\nimport csv\nrows = list(csv.DictReader(open('/Users/maui/.retort/work/retort-local-syu3u3ut/retort-02000dd611c2/data/kaggle/BR-Football-Dataset.csv', encoding='utf-8')))\np23 = [r for r in rows if r['tournament']=='Serie A' and r['date'].startswith('2023') and (r['home']=='Palmeiras' or r['away']=='Palmeiras')]\nprint('Palmeiras 2023 Serie A (BR-Football):', len(p23))\nteams23 = set()\nfor r in rows:\n    if r['tournament']=='Serie A' and r['date'].startswith('2023'):\n        teams23.add(r['home']); teams23.add(r['away'])\nprint(sorted(teams23))\n\"" action.permission=bash action.action=allow action.pattern=*
