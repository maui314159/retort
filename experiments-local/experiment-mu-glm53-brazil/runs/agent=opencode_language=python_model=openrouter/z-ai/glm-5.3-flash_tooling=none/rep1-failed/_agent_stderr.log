timestamp=2026-09-01T01:55:00.829Z level=INFO run=f4eee4fd message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, sys\nsys.path.insert(0, '.')\nfrom brazilian_soccer_mcp.normalize import normalize_team, text_key\nfrom collections import defaultdict\n\nfiles = ['Brasileirao_Matches.csv','Brazilian_Cup_Matches.csv','Libertadores_Matches.csv','BR-Football-Dataset.csv','novo_campeonato_brasileiro.csv']\nname_cols = {'Brasileirao_Matches.csv':['home_team','away_team'],\n             'Brazilian_Cup_Matches.csv':['home_team','away_team'],\n             'Libertadores_Matches.csv':['home_team','away_team'],\n             'BR-Football-Dataset.csv':['home','away'],\n             'novo_campeonato_brasileiro.csv':['Equipe_mandante','Equipe_visitante']}\nallnames=set()\nfor f in files:\n    with open(f'data/kaggle/{f}', newline='', encoding='utf-8') as fh:\n        for r in csv.DictReader(fh):\n            for c in name_cols[f]:\n                if r.get(c): allnames.add(r[c].strip())\n\n# canonical display -> set of identity keys under strip rule\nSTRIP = {'fc','ec','sc','cf','clube','esporte clube','futebol clube','sport club','esporte','futebol','club'}\ndef ident(display):\n    k = text_key(display)\n    toks = k.split()\n    # strip up to 2 trailing generic tokens\n    while len(toks)>1 and ' '.join(toks[-2:]) in STRIP:\n        toks = toks[:-2] if ' '.join(toks[-2:]) in STRIP else toks\n    while toks and toks[-1] in {'fc','ec','sc','cf','club','clube','esporte','futebol'}:\n        toks.pop()\n    return ' '.join(toks)\n\ngroups=defaultdict(set)\nfor n in allnames:\n    disp = normalize_team(n)\n    groups[ident(disp)].add(disp)\ncollisions = {k:v for k,v in groups.items() if len(v)>1}\nprint(f\"{len(allnames)} raw names -> {len(groups)} identities, {len(collisions)} collisions:\")\nfor k,v in sorted(collisions.items()):\n    print(\" \", k, \"=>\", sorted(v))\nEOF" action.permission=bash action.action=allow action.pattern=*
