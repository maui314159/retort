timestamp=2026-09-01T07:29:09.674Z level=INFO run=27f52cea message=evaluated permission=bash pattern="venv/bin/python -c \"\nimport time\nt0 = time.time()\nfrom data_loader import get_data, SERIE_A\nfrom stats import standings\ndata = get_data()\nprint(f'load: {time.time()-t0:.2f}s | matches: {len(data.matches)} | teams: {len(data.teams)}')\nfor season in [2019, 2020, 2021, 2022]:\n    t = standings(data.matches_by_competition(SERIE_A, season))\n    print(season, t[0]['team'], t[0]['points'], '|', t[1]['team'], t[1]['points'])\n\"" action.permission=bash action.action=allow action.pattern=*
timestamp=2026-09-01T07:29:13.193Z level=INFO run=27f52cea message=evaluated permission=bash pattern="venv/bin/python -c \"\nfrom data_loader import get_data\nfrom collections import defaultdict\ndata = get_data()\nbuckets = defaultdict(list)\nfor m in data.matches:\n    if m.score and m.date and m.season:\n        for d in (-1,0,1):\n            buckets[(m.competition, m.season, m.date.toordinal()+d, m.score, m.away_key)].append(m)\nseen = set(); res = []\nfor b in buckets.values():\n    if len(b) < 2: continue\n    for i, m1 in enumerate(b):\n        for m2 in b[i+1:]:\n            if m1.home_key != m2.home_key:\n                sig = tuple(sorted([m1.home_key, m2.home_key]))\n                if sig not in seen:\n                    seen.add(sig); res.append((sig, str(m1.date), m1.competition))\nfor r in res: print(r)\nprint('residual:', len(res))\n\"" action.permission=bash action.action=allow action.pattern=*
