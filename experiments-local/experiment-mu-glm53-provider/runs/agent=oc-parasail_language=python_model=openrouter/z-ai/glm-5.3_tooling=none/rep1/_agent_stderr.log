timestamp=2026-09-01T04:25:30.164Z level=INFO run=22cd9675 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv, collections\n\ndef quick(path, **kw):\n    with open(path, encoding='utf-8') as f:\n        return list(csv.DictReader(f, **kw))\n\n# Brasileirao\nrows = quick('data/kaggle/Brasileirao_Matches.csv')\nprint(\"Brasileirao rows:\", len(rows))\nteams = collections.Counter()\nfor r in rows:\n    teams[r['home_team']] += 1\nprint(\"sample home teams:\", sorted(teams)[:15])\nprint(\"seasons:\", sorted({r['season'] for r in rows}, key=int)[:3], \"...\", sorted({r['season'] for r in rows}, key=int)[-3:])\nmissing = sum(1 for r in rows if r['home_goal']=='' or r['away_goal']=='')\nprint(\"missing goals:\", missing)\n\n# Brazilian Cup\nrows = quick('data/kaggle/Brazilian_Cup_Matches.csv')\nprint(\"\\nCup rows:\", len(rows))\nprint(\"cup rounds sample:\", sorted({r['round'] for r in rows})[:20])\nprint(\"cup seasons:\", sorted({r['season'] for r in rows}, key=int)[:3], \"...\", sorted({r['season'] for r in rows}, key=int)[-3:])\n\n# Libertadores\nrows = quick('data/kaggle/Libertadores_Matches.csv')\nprint(\"\\nLibert rows:\", len(rows))\nprint(\"stages:\", collections.Counter(r['stage'] for r in rows))\nprint(\"lib seasons:\", sorted({r['season'] for r in rows}, key=int)[:3], \"...\", sorted({r['season'] for r in rows}, key=int)[-3:])\n\n# BR-Football\nrows = quick('data/kaggle/BR-Football-Dataset.csv')\nprint(\"\\nBR-Football rows:\", len(rows))\nprint(\"tournaments:\", collections.Counter(r['tournament'] for r in rows).most_common(20))\nprint(\"date sample:\", rows[0]['date'], \"| time:\", rows[0]['time'])\nmissing = sum(1 for r in rows if r['home_goal'] in ('', None) or r['away_goal'] in ('', None))\nprint(\"missing goals:\", missing)\n\n# novo\nrows = quick('data/kaggle/novo_campeonato_brasileiro.csv')\nprint(\"\\nnovo rows:\", len(rows))\nprint(\"anos:\", sorted({r['Ano'] for r in rows}, key=int)[:3], \"...\", sorted({r['Ano'] for r in rows}, key=int)[-3:])\nprint(\"vencedor:\", collections.Counter(r['Vencedor'] for r in rows))\nteams = collections.Counter(r['Equipe_mandante'] for r in rows)\nprint(\"sample teams:\", sorted(teams)[:20])\n\n# fifa\nrows = quick('data/kaggle/fifa_data.csv')\nprint(\"\\nfifa rows:\", len(rows))\nnats = collections.Counter(r['Nationality'] for r in rows)\nprint(\"Brazil count:\", nats.get('Brazil'))\nclubs = collections.Counter(r['Club'] for r in rows)\nbrz = [c for c in clubs if any(k in c for k in ['Flamengo','Palmeiras','Corinthians','Santos','São Paulo','Sao Paulo','Grêmio','Gremio','Fluminense','Botafogo','Internacional','Cruzeiro','Vasco','Athletico','Atlético','Atletico','Bahia','Fortaleza','Ceará','Ceara','Sport','Goiás','Goiás'])]\nprint(\"Brazilian-looking clubs in FIFA:\", brz[:30])\nprint(\"sample clubs:\", clubs.most_common(10))\nEOF" action.permission=bash action.action=allow action.pattern=*
