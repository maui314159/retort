timestamp=2026-08-31T19:44:09.424Z level=INFO run=532d90f3 message=evaluated permission=bash pattern="venv/bin/python -c \"\nfrom bsoccer.queries import KnowledgeBase\nimport time\nt0=time.time(); kb = KnowledgeBase(); print(f'load {time.time()-t0:.2f}s')\n\n# Fla-Flu with h2h\nr = kb.search_matches(team='Flamengo-RJ', opponent='Fluminense')\nprint('Fla-Flu:', r['count'], 'of', r['total_matches'], r['head_to_head'])\n\n# date range + competition filter\nr = kb.search_matches(team='Palmeiras', competition='Copa do Brasil', season=2015, stage='final')\nprint('Palmeiras 2015 cup final legs:', [(m['home_team'], m['home_goal'], m['away_goal'], m['away_team']) for m in r['matches']])\n\n# head to head\nr = kb.head_to_head('Palmeiras-SP', 'Santos-SP', competition='Brasileirão')\nprint('Pale-San:', r['summary'])\n\n# unknown team error path\nr = kb.team_statistics('Xyz FC')\nprint('error path:', r['error'], r.get('candidates'))\nr = kb.team_statistics('Palmeir')\nprint('fuzzy:', r['team'], r['overall']['played'])\n\n# players\nr = kb.search_players(nationality='Brazil', min_overall=85)\nprint('BRA >=85:', [(p['name'], p['overall']) for p in r['players']])\nr = kb.search_players(club='Ceará', limit=30)\nprint('Ceará players:', r['count'], 'avg:', r['club_summary']['average_overall'])\nr = kb.search_players(club='Ceara Sporting Club', limit=30)\nprint('Ceará Sporting Club:', r['count'])\nr = kb.player_profile('Gabriel Barbosa')\np = r['player']; print('Gabigol:', p['name'], p['club'], p['overall'], p['position'])\nr = kb.player_profile('neymar')\nprint('Neymar:', r['player']['name'], r['player']['overall'])\n\n# season comparison\nr = kb.compare_seasons('Brasileirão', 2018, 2019)\nprint('2018 vs 2019:', r['comparison']['average_goals_per_match'])\n\n# standings relegation\ns = kb.standings('Serie A', 2020)\nprint('2020 relegated:', [(e['position'], e['team']) for e in s['standings'][-4:]])\ns = kb.standings('Serie A', 2005)\nprint('2005 champ:', s['standings'][0]['team'], s['standings'][0]['points'], '| source:', s['source_file'], '| teams:', len(s['standings']))\n\"" action.permission=bash action.action=allow action.pattern=*
