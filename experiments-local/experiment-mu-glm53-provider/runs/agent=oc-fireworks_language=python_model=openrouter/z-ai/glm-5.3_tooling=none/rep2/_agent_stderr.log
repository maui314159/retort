timestamp=2026-09-01T05:39:53.958Z level=INFO run=f180ecb5 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, re, unicodedata, collections\nbase='data/kaggle/'\ndef fold(s):\n    s = unicodedata.normalize('NFKD', s)\n    s = ''.join(ch for ch in s if not unicodedata.combining(ch))\n    s = re.sub(r'[^a-z0-9]', '', s.lower()).replace('athletico','atletico')\ndef g(v):\n    try: return int(float(v))\n    except: return None\ndef clean(n):\n    n = re.sub(r'\\s*\\([^)]*\\)', '', n)\n    n = re.sub(r'\\s*-\\s*([A-Za-z]{2,3})$', r'-\\1', n)\n    return n.strip()\n\n# cup rounds\nrds = collections.Counter(r['round'] for r in csv.DictReader(open(base+'Brazilian_Cup_Matches.csv', encoding='utf-8-sig')))\nprint('cup rounds:', rds.most_common(20))\nstages = collections.Counter(r['stage'] for r in csv.DictReader(open(base+'Libertadores_Matches.csv', encoding='utf-8-sig')))\nprint('lib stages:', stages.most_common(20))\n\n# NA rows in Brasileirao\nna = [r for r in csv.DictReader(open(base+'Brasileirao_Matches.csv', encoding='utf-8-sig')) if r['home_goal']=='NA']\nprint('brasileirao NA rows by season:', collections.Counter(r['season'] for r in na))\nprint('sample NA:', na[0])\n\n# cup overlap check: cup file vs br_foot copa\ncup = {}\nfor r in csv.DictReader(open(base+'Brazilian_Cup_Matches.csv', encoding='utf-8-sig')):\n    if r['home_goal']=='NA': continue\n    cup[(fold(clean(r['home_team'])), fold(clean(r['away_team'])), r['season'], r['datetime'][:10])] = (g(r['home_goal']), g(r['away_goal']))\nbf = {}\nfor r in csv.DictReader(open(base+'BR-Football-Dataset.csv', encoding='utf-8-sig')):\n    if r['tournament'] != 'Copa do Brasil': continue\n    bf[(fold(clean(r['home'])), fold(clean(r['away'])), r['date'][:4], r['date'])] = (g(r['home_goal']), g(r['away_goal']))\ncommon = set(cup) & set(bf)\nprint('cup overlap exact(date):', len(common), 'agree:', sum(1 for k in common if cup[k]==bf[k]))\n# without date\ncup2 = {}; bf2 = {}\nfor (h,a,s,d),v in cup.items(): cup2.setdefault((h,a,s), []).append(v)\nfor (h,a,s,d),v in bf.items(): bf2.setdefault((h,a,s), []).append(v)\nc2 = set(cup2) & set(bf2)\nprint('cup overlap (pair,season):', len(c2), 'of seasons', sorted({k[2] for k in c2}))\n\n# FIFA: all clubs that are Brazilian (match to our registry bases)\nclubs = collections.Counter()\nfor r in csv.DictReader(open(base+'fifa_data.csv', encoding='utf-8-sig')):\n    if r['Nationality'] == 'Brazil': clubs[r['Club']] += 1\nprint('all FIFA clubs w/ Brazilians:', len(clubs))\nnat = collections.Counter(r['Nationality'] for r in csv.DictReader(open(base+'fifa_data.csv', encoding='utf-8-sig')))\nprint('total players:', sum(nat.values()), 'brazilians:', nat['Brazil'])\npos = collections.Counter(r['Position'] for r in csv.DictReader(open(base+'fifa_data.csv', encoding='utf-8-sig')) if r['Nationality']=='Brazil')\nprint('brazilian positions:', pos.most_common())\nEOF" action.permission=bash action.action=allow action.pattern=*
