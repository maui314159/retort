timestamp=2026-06-25T03:40:57.104Z level=INFO run=9c04db1c message=evaluated permission=bash pattern="python3 - <<'PY'\nfrom brazilian_soccer_mcp.data_loader import load_all\nfrom collections import Counter\ndata=load_all()\nkeys={'corinthians'}\nmatches=[m for m in data['matches'] if m['season']==2022 and m['competition']=='Brasileirão' and (m['home_canonical'] in keys or m['away_canonical'] in keys)]\nprint('total', len(matches))\nprint('by source', Counter(m['source'] for m in matches))\n# check dedup key duplicates\ndedup={}\nfor m in matches:\n    k=(m['competition'],m['season'],m['home_canonical'],m['away_canonical'],m['date'])\n    dedup.setdefault(k,[]).append(m['source'])\ndups=[(k,v) for k,v in dedup.items() if len(v)>1]\nprint('duplicate keys', len(dups))\nprint(dups[:3])\nPY" action.permission=bash action.action=allow action.pattern=*
