timestamp=2026-09-01T05:20:24.384Z level=INFO run=7ae6fc3c message=evaluated permission=bash pattern="python - <<'EOF'\nimport csv\np='data/kaggle/'\nwith open(p+'Brasileirao_Matches.csv', encoding='utf-8') as f:\n    bra=[r for r in csv.DictReader(f) if r['season']=='2021']\nhits = [r for r in bra if 'America' in r['home_team'] and 'Sao Paulo' in r['away_team'] or 'Sao Paulo' in r['home_team'] and 'America' in r['away_team']]\nfor r in hits: print(r['datetime'], r['home_team'], r['home_goal'],'-',r['away_goal'], r['away_team'], 'round', r['round'])\n# what rounds does Brasileirao 2021 have and how do dates distribute?\nfrom collections import Counter\nprint(Counter(r['round'] for r in bra).most_common(3))\n# find date range per round for last rounds\nfor rnd in ['36','37','38']:\n    ds = sorted(r['datetime'][:10] for r in bra if r['round']==rnd)\n    print('round', rnd, ds[0], '→', ds[-1])\nEOF" action.permission=bash action.action=allow action.pattern=*
