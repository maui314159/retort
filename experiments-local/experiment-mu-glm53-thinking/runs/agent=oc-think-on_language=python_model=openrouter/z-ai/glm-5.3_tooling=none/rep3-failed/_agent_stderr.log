m['home_goals'], m['away_goals'], m['away_team'], m['competition']) for m in bw['biggest_wins']])\nbr = q.best_records(d, 'Serie A', 2019, venue='away', min_matches=15, limit=3)\nprint('Best away 2019:', [(x['team'], x['win_rate']) for x in br['best_records']])\np = q.search_players(d, nationality='Brazil', min_overall=88)\nprint('Top BR players:', [(x['name'], x['overall']) for x in p['players']])\npp = q.player_profile(d, 'Neymar Jr')\nprint('Neymar:', pp['overall'], pp['position'], pp['club'])\ntp = q.team_profile(d, 'Grêmio')\nprint('Grêmio profile: matches', tp['total_matches'], 'fifa players', tp['players_in_fifa_dataset']['count'])\ndd = q.derbies(d, season=2019)\nprint('2019 derbies:', [(x['derby'], x['total_matches']) for x in dd['derbies']])\n\"" action.permission=bash action.action=allow action.pattern=*
