timestamp=2026-09-01T13:31:57.212Z level=INFO run=d0d26016 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv\n# Cup: max round per season\nwith open('data/kaggle/Brazilian_Cup_Matches.csv', encoding='utf-8') as f:\n    rows = list(csv.DictReader(f))\nfrom collections import defaultdict\nmx = defaultdict(int); cnt = defaultdict(int)\nfor r in rows:\n    s, rd = r['season'], int(r['round'])\n    mx[s] = max(mx[s], rd); cnt[s] += 1\nfor s in sorted(mx):\n    print(s, \"max round:\", mx[s], \"matches:\", cnt[s])\n# 2019 season round 8 (final?) matches\nfin = [r for r in rows if r['season']=='2019' and int(r['round'])==8]\nfor r in fin: print(\"  2019 R8:\", r['datetime'][:10], r['home_team'], r['home_goal'],'-',r['away_goal'], r['away_team'])\nEOF" action.permission=bash action.action=allow action.pattern=*
timestamp=2026-09-01T13:32:01.759Z level=INFO run=d0d26016 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv\n# BR-Football: Serie A per-season counts, missing values, ht_result values\nwith open('data/kaggle/BR-Football-Dataset.csv', encoding='utf-8') as f:\n    rows = list(csv.DictReader(f))\nfrom collections import defaultdict\nsa = defaultdict(int); sb = defaultdict(int)\nbad = 0\nfor r in rows:\n    if r['tournament']=='Serie A': sa[r['date'][:4]] += 1\n    if r['tournament']=='Serie B': sb[r['date'][:4]] += 1\n    if not r['date'] or r['date']=='': bad += 1\nprint(\"Serie A seasons:\", dict(sorted(sa.items())))\nprint(\"Serie B seasons:\", dict(sorted(sb.items())))\nprint(\"rows with no date:\", bad)\n# check goal formats\nweird = [r for r in rows if r['home_goal'] not in ('0','1','2','3','4','5','6','7','8') ][:5]\nprint(\"weird goals sample:\", [(r['home_goal'], r['away_goal']) for r in weird])\nht = set(r['ht_result'] for r in rows)\nprint(\"ht_result values:\", ht)\n# empty date rows\nnodate = [r for r in rows if not r['date'].strip()]\nprint(\"empty date:\", len(nodate), nodate[:2])\nEOF" action.permission=bash action.action=allow action.pattern=*
