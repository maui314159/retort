ngo-RJ\", \"Palmeiras-SP\", \"Atletico Mineiro\", \"Atlético-PR\",\n          \"Athletico\", \"Corinthians\", \"Botafogo RJ\", \"Sport Club do Recife\", \"Vasco da Gama\",\n          \"Ceará Sporting Club\", \"São Paulo\", \"Goiás\", \"América - MG\", \"Botafogo SP\"]:\n    try:\n        r = reg.resolve(q)\n        print(f\"  {q!r:28} -> {r.team_id:22} ({r.display})\" + (f\" alts={r.alternatives[:3]}\" if r.alternatives else \"\"))\n    except Exception as e:\n        print(f\"  {q!r:28} -> ERROR {e}\")\n\nfrom brazilian_soccer_mcp.models import BRASILEIRAO_A\nrec = {}\nfor m in data.matches:\n    if m.competition == BRASILEIRAO_A and m.season == 2019 and m.played():\n        for tid, disp, gf, ga in [(m.home_id, m.home_display, m.home_goals, m.away_goals),\n                                   (m.away_id, m.away_display, m.away_goals, m.home_goals)]:\n            r = rec.setdefault(tid, [disp,0,0,0,0,0,0,0])\n            r[2]+=gf; r[3]+=ga; r[1]+=1\n            if gf>ga: r[4]+=1; r[7]+=3\n            elif gf==ga: r[5]+=1; r[7]+=1\n            else: r[6]+=1\ntop = sorted(rec.items(), key=lambda kv: (-kv[1][7], -(kv[1][4]-kv[1][6]), -kv[1][2]))[:5]\nfor tid, r in top:\n    print(f\"  {r[0]:20} {r[7]}pts {r[4]}W {r[5]}D {r[6]}L GF{r[2]} GA{r[3]} ({r[1]} matches)\")\nprint(\"teams in 2019 Serie A:\", len(rec))\nEOF","time":{"start":1788237687584,"end":1788237687606}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05b45a7dc0014shRMIO7VhbDPt","sessionID":"ses_fa4ccfc0bffexSFu2vIRQjobrF","messageID":"msg_05b4578d3001RVDmnSd86M4ChD"}}
