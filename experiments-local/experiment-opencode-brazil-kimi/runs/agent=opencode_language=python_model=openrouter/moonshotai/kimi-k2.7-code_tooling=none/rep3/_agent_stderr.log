timestamp=2026-06-25T03:26:46.418Z level=INFO run=9c04db1c message=evaluated permission=bash pattern="python3 - <<'PY'\nimport csv, os, re, collections\nbase = '/private/var/folders/t6/p1v727892_qc9xqqdzq2rpym0000gn/T/retort-local-tjpsd7_l/retort-8ea0ffcc10d3/data/kaggle'\n\ndef canon(n):\n    n=n.strip(); n=re.sub(r'\\s*-\\s*[A-Z]{2}$','',n); n=re.sub(r'\\s*\\([^)]*\\)','',n).strip()\n    return re.sub(r'[^A-Za-z0-9]+','',n).lower()\n\n# palmeiras 2023 in Brasileirao? \nprint('Palmeiras 2023 Brasileirao matches')\nwith open(os.path.join(base,'Brasileirao_Matches.csv'),encoding='utf-8') as f:\n    rows=list(csv.DictReader(f))\n    pal2023=[r for r in rows if canon(r['home_team'])=='palmeiras' or canon(r['away_team'])=='palmeiras' and int(float(r['season']))==2023]\nprint(len(pal2023), pal2023[0])\n\n# Corinthians 2022 home record\nprint('\\nCorinthians 2022 home record')\nhome=[r for r in rows if int(float(r['season']))==2022 and canon(r['home_team'])=='corinthians']\nw=sum(1 for r in home if int(float(r['home_goal']))>int(float(r['away_goal'])))\nd=sum(1 for r in home if int(float(r['home_goal']))==int(float(r['away_goal'])))\nl=sum(1 for r in home if int(float(r['home_goal']))<int(float(r['away_goal'])))\ngf=sum(int(float(r['home_goal'])) for r in home); ga=sum(int(float(r['away_goal'])) for r in home)\nprint(len(home), w,d,l,gf,ga)\n\n# 2019 standings simple from Brasileirao Matches (does it include 2019? range 2012-?)\nprint('\\nSeasons in Brasileirao_Matches', sorted(set(int(float(r['season'])) for r in rows)))\n\n# 2019 champion from novo_campeonato_brasileiro\nprint('\\nNovo seasons', sorted(set(int(r['Ano']) for r in csv.DictReader(open(os.path.join(base,'novo_campeonato_brasileiro.csv'),encoding='utf-8')))))\nPY" action.permission=bash action.action=allow action.pattern=*
