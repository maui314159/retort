timestamp=2026-09-01T03:47:43.019Z level=INFO run=2973fea4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport sys\nsys.path.insert(0, '.')\nfrom brazilian_soccer.loader import load_all\nfrom collections import Counter\nreg, matches, players = load_all()\nfor y in (2019, 2020, 2021, 2022, 2023):\n    ms = [m for m in matches if m.competition == \"Brasileirão Serie A\" and m.season == y]\n    per = Counter()\n    for m in ms:\n        per[m.home_key] += 1; per[m.away_key] += 1\n    bad = {k: v for k, v in per.items() if v != 38}\n    srcs = Counter(m.source for m in ms)\n    print(y, len(ms), \"| wrong:\", bad if bad else \"-\", \"| srcs:\", dict(srcs))\n# check BR-Football 2020 rows with dates in 2021\nbrf = [m for m in matches if m.source == \"BR-Football-Dataset.csv\" and m.competition == \"Brasileirão Serie A\" and m.season == 2021 and m.date.year == 2021 and m.date.month <= 2]\nprint(\"BR-Football 2021 Jan-Feb rows:\", len(brf), [str(m.date) for m in brf[:5]])\nEOF" action.permission=bash action.action=allow action.pattern=*
