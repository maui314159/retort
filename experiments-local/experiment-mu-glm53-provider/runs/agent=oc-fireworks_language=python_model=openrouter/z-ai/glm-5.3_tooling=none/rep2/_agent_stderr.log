timestamp=2026-09-01T06:27:01.589Z level=INFO run=f180ecb5 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport time\nfrom brazilian_soccer import SoccerData, SoccerService\n\nt0 = time.time()\ndata = SoccerData()\nload_t = time.time() - t0\nsvc = SoccerService(data)\n\nqueries = [\n    (\"simple: h2h\", lambda: svc.head_to_head(\"Flamengo\", \"Fluminense\")),\n    (\"simple: last match\", lambda: svc.search_matches(team=\"Flamengo\", opponent=\"Corinthians\", limit=1)),\n    (\"simple: player lookup\", lambda: svc.search_players(name=\"Neymar\")),\n    (\"simple: team stats\", lambda: svc.team_stats(\"Corinthians\", season=2022, venue=\"home\")),\n    (\"aggregate: standings 2019\", lambda: svc.league_standings(season=2019)),\n    (\"aggregate: standings 2023\", lambda: svc.league_standings(season=2023)),\n    (\"aggregate: biggest wins\", lambda: svc.biggest_wins()),\n    (\"aggregate: players by club\", lambda: svc.players_by_club()),\n    (\"aggregate: copa finals\", lambda: svc.finals(\"Copa do Brasil\")),\n    (\"aggregate: lib finals\", lambda: svc.finals(\"Libertadores\")),\n    (\"aggregate: full search no filter\", lambda: svc.search_matches(limit=15)),\n]\nprint(f'load time: {load_t:.2f}s')\nok = True\nfor name, fn in queries:\n    t = time.time(); out = fn(); dt = time.time() - t\n    status = 'OK' if dt < 2.0 else 'SLOW'\n    if dt >= 2.0 and 'aggregate' not in name: ok = False\n    if dt >= 5.0: ok = False\n    print(f'{status:4} {name:32} {dt*1000:8.1f} ms  ({len(out)} chars)')\nprint('performance criteria met:', ok)\nEOF" action.permission=bash action.action=allow action.pattern=*
