timestamp=2026-09-01T10:08:28.813Z level=INFO run=f27b5900 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv\nfrom collections import defaultdict\nfrom brsoccer.data import _raw_rows, find_data_dir\nfrom brsoccer.normalize import TeamRegistry\n\nraw = _raw_rows(find_data_dir())\nreg = TeamRegistry()\nfor r in raw:\n    reg.ingest(r['home_raw']); reg.ingest(r['away_raw'])\nreg.finalize()\n\ndef keys(src, comp, season):\n    out = {}\n    for r in raw:\n        if r['source']==src and r['competition']==comp and r['season']==season:\n            out[(r['date'], reg.key_of(r['home_raw']), reg.key_of(r['away_raw']))] = r\n    return out\n\nfor season in (2013, 2019, 2021):\n    bras = keys('Brasileirao_Matches.csv','serie_a',season)\n    hist = keys('novo_campeonato_brasileiro.csv','serie_a',season)\n    brf  = keys('BR-Football-Dataset.csv','serie_a',season)\n    bh = set(bras)|set(hist)\n    print(f\"\\n{season}: bras={len(bras)} hist={len(hist)} brf={len(brf)} brasUhist={len(bh)} union_all={len(bh|set(brf))}\")\n    print(f\"  brf not in brasUhist: {len(set(brf)-bh)}; brasUhist not in brf: {len(bh-set(brf))}\")\n    # BRAS vs HIST matching\n    print(f\"  bras∩hist={len(set(bras)&set(hist))}, bras-hist={len(set(bras)-set(hist))}, hist-bras={len(set(hist)-set(bras))}\")\n    # inspect a few brf-only rows\n    only_brf = list(set(brf)-bh)[:5]\n    for k in only_brf:\n        r = brf[k]\n        print(\"   BRF-only:\", k, \"goals\", r['home_goal'], r['away_goal'])\n        # find same teams in brasUhist with any date\n        same_teams = [kk for kk in bh if kk[1]==k[1] and kk[2]==k[2]]\n        print(\"     same teams in brasUhist at dates:\", same_teams[:4])\n    # inspect bras-hist mismatch\n    for k in list(set(bras)-set(hist))[:4]:\n        r = bras[k]\n        same_teams = [kk for kk in set(hist) if kk[1]==k[1] and kk[2]==k[2]]\n        print(\"   BRAS-only:\", k, \" hist same teams:\", same_teams[:3])\nEOF" action.permission=bash 