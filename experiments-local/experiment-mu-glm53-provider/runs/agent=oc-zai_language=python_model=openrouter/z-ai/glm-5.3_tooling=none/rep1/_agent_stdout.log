canonical\n\n        raise ValueError(\n            f\"Unknown competition '{name}'. Known: Brasileirão Série A/B/C, \"\n            \"Copa do Brasil, Copa Libertadores.\"\n        )","oldString":"    def resolve_competition(self, name: Optional[str]) -> Optional[str]:\n        \"\"\"Map user input (\"brasileirao\", \"Serie A\", ...) to canonical name.\"\"\"\n        if not name:\n            return None\n        key = name.strip().lower()\n        if key in COMPETITION_ALIASES:\n            return COMPETITION_ALIASES[key]\n        for alias, canonical in COMPETITION_ALIASES.items():\n            if key in alias or alias in key:\n                return canonical\n        for canonical in set(COMPETITION_ALIASES.values()):\n            if key in canonical.lower():\n                return canonical\n        raise ValueError(\n            f\"Unknown competition '{name}'. Known: Brasileirão Série A/B/C, \"\n            \"Copa do Brasil, Copa Libertadores.\"\n        )"},"output":"Edit applied successfully.","metadata":{"diagnostics":{},"diff":"Index: /Users/maui/.retort/work/retort-local-7ooj92cj/retort-7f4a851aa2e1/brazilian_soccer_mcp/service.py\n===================================================================\n--- /Users/maui/.retort/work/retort-local-7ooj92cj/retort-7f4a851aa2e1/brazilian_soccer_mcp/service.py\n+++ /Users/maui/.retort/work/retort-local-7ooj92cj/retort-7f4a851aa2e1/brazilian_soccer_mcp/service.py\n@@ -178,20 +178,49 @@\n \n # -- helpers -------------------------------------------------------------\n \n def resolve_competition(self, name: Optional[str]) -> Optional[str]:\n-    \"\"\"Map user input (\"brasileirao\", \"Serie A\", ...) to canonical name.\"\"\"\n+    \"\"\"Map user input (\"brasileirao\", \"Serie A\", ...) to canonical name.\n+\n+    Idempotent: a canonical name round-trips to itself (a naive\n+    substring match would turn \"Brasileirão Série B\" into Série A via\n+    the \"brasileirão\" alias).\n+    \"\"\"\n     if not name:\n    