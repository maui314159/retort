timestamp=2026-09-01T04:49:49.020Z level=INFO run=1a470e0e message=evaluated permission=bash pattern="./venv/bin/python << 'EOF'\nimport csv, collections\n# Raw per-team home counts, Brasileirao_Matches 2022\nhome = collections.Counter()\nrows = 0\nwith open('data/kaggle/Brasileirao_Matches.csv', encoding='utf-8') as f:\n    for row in csv.DictReader(f):\n        if row['season'] == '2022':\n            home[row['home_team']] += 1\n            rows += 1\nprint(\"total 2022 rows:\", rows, \"| teams:\", len(home))\nprint(\"Corinthians home:\", home.get('Corinthians-SP'))\nodd = {t: c for t, c in home.items() if c != 19}\nprint(\"teams with != 19 home games:\", odd)\n\n# rounds in 2022\nrounds = collections.Counter()\nwith open('data/kaggle/Brasileirao_Matches.csv', encoding='utf-8') as f:\n    for row in csv.DictReader(f):\n        if row['season'] == '2022': rounds[row['round']] += 1\nprint(\"rounds:\", dict(sorted(rounds.items(), key=lambda kv: int(kv[0]))))\nEOF" action.permission=bash action.action=allow action.pattern=*
