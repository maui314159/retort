timestamp=2026-09-01T03:02:30.041Z level=INFO run=2973fea4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv, sys\nsys.path.insert(0, '.')\nfrom brazilian_soccer.normalize import TeamRegistry\n\ndef rows(p):\n    with open(p, newline='', encoding='utf-8-sig') as f:\n        return list(csv.DictReader(f))\n\nraws = set()\nfor r in rows('data/kaggle/Brasileirao_Matches.csv'):\n    raws.add(r['home_team']); raws.add(r['away_team'])\nfor r in rows('data/kaggle/Brazilian_Cup_Matches.csv'):\n    raws.add(r['home_team']); raws.add(r['away_team'])\nfor r in rows('data/kaggle/Libertadores_Matches.csv'):\n    raws.add(r['home_team']); raws.add(r['away_team'])\nfor r in rows('data/kaggle/novo_campeonato_brasileiro.csv'):\n    raws.add(r['Equipe_mandante']); raws.add(r['Equipe_visitante'])\nfor r in rows('data/kaggle/BR-Football-Dataset.csv'):\n    raws.add(r['home']); raws.add(r['away'])\n\nreg = TeamRegistry()\nfor raw in sorted(raws):\n    reg.register(raw)\nreg.finalize()\n\nbig = [\"Palmeiras-SP\", \"Palmeiras\", \"Sao Paulo-SP\", \"São Paulo\", \"Sao Paulo\",\n       \"Flamengo-RJ\", \"Flamengo\", \"Athletico Paranaense\", \"Athletico-PR\", \"Atletico - PR\",\n       \"Atletico Mineiro\", \"Atlético - MG\", \"Atletico-MG\", \"Atletico Goianiense\", \"Atlético-GO\",\n       \"Botafogo-RJ\", \"Botafogo\", \"Botafogo - PB\", \"Botafogo SP\",\n       \"America - MG\", \"América-MG\", \"América - RN\", \"America FC Natal\",\n       \"Santos\", \"Santos-SP\", \"Santos - AP\", \"Vasco\", \"Vasco Da Gama RJ\",\n       \"Internacional\", \"Internacional - SC\", \"Vitoria\", \"Vitoria ES\",\n       \"Gremio\", \"Grêmio - RS\", \"Corinthians-SP\", \"Corinthians\", \"Ceara\", \"Ceará - CE\",\n       \"Sport\", \"Sport-PE\", \"Sport Recife\", \"Fortaleza EC\", \"Fortaleza-CE\", \"Fortaleza\",\n       \"Nacional (URU)\", \"Nacional-URU\", \"Nacional - AM\", \"Guaraní (PAR)\", \"Guaraní-PAR\",\n       \"Guarani-SP\", \"Guarani - CE\", \"Barcelona-EQU\", \"River Plate\", \"River Plate-URU\",\n       \"Red Bull Bragantino - SP\", \"Bragantino - PA\", \"Bragantino\", \"Red Bull Brasil\",\n       \"A.b.c. - RN\", \"ABC\", \"Abc - RN\", \"Juventude\", \"Juventude - MA\", \"Juventude-RS\",\n       \"Operario - PR\", \"Operário - MS\", \"Operario Ferroviario Esporte C - PR\",\n       \"Sao Jose - POA\", \"São José - RS\", \"Sao Jose RS\", \"Ser Caxias - RS\", \"Caxias - RS\",\n       \"Cuiaba\", \"Cuiaba MT\", \"Cuiabá - MT\", \"Avaí - SC\", \"Avai-SC\", \"Avai\",\n       \"Criciuma - SC\", \"Criciúma\", \"Chapecoense\", \"Chapecoense - SC\",\n       \"America FC Natal\", \"América de Natal - RN\", \"América de Cali\",\n       \"Santa Cruz\", \"Santa Cruz - RN\", \"Santa Cruz-PE\", \"Bahia-BA\", \"EC Bahia\", \"Bahia\",\n       \"CRB\", \"C.r.b. - AL\", \"CSA\", \"Csa-AL\", \"CS Alagoano\", \"River AC\", \"Ríver - PI\", \"River (PI)\",\n       \"Nautico-PE\", \"Náutico\", \"Nautico Capibaribe\", \"EC Internacional SC\",\n       \"Boavista Sport Club (antigo Esporte Clube Barreira) - RJ\", \"Boavista\", \"Boavista RJ\"]\ngroups = {}\nfor raw in big:\n    k = reg.key_for(raw)\n    groups.setdefault(k, []).append(raw)\nfor k in sorted(groups):\n    print(f\"{reg.display(k)!r:26} key={k!r:24} <- {groups[k]}\")\nEOF" action.permission=bash action.action=allow action.pattern=*
