timestamp=2026-09-01T17:09:57.208Z level=INFO run=a6cf503f message=evaluated permission=bash pattern="venv/bin/python -c \"\nimport csv\n# Copa do Brasil 2019: rounds and the final\nrows = [r for r in csv.DictReader(open('data/kaggle/Brazilian_Cup_Matches.csv', encoding='utf-8-sig')) if r['season']=='2019']\nmx = max(int(r['round']) for r in rows)\nprint('max round 2019:', mx)\nfor r in rows:\n    if int(r['round']) == mx: print(r['round'], r['datetime'][:10], r['home_team'], r['home_goal'], '-', r['away_goal'], r['away_team'])\nprint()\n# biggest wins across the 3 competition files\nbest = []\nfor fn, hc, ac, gc in [\n  ('Brasileirao_Matches.csv','home_team','away_team','home_goal','away_goal'),\n  ('Brazilian_Cup_Matches.csv','home_team','away_team','home_goal','away_goal'),\n  ('Libertadores_Matches.csv','home_team','away_team','home_goal','away_goal')]:\n    for r in csv.DictReader(open('data/kaggle/'+fn, encoding='utf-8-sig')):\n        try: hg, ag = int(r['home_goal']), int(r['away_goal'])\n        except: continue\n        if abs(hg-ag) >= 6: best.append((abs(hg-ag), fn, r['season'], r['datetime'][:10], r['home_team'], hg, ag, r['away_team']))\nbest.sort(reverse=True)\nfor b in best[:8]: print(b)\n\"" action.permission=bash action.action=allow action.pattern=*
