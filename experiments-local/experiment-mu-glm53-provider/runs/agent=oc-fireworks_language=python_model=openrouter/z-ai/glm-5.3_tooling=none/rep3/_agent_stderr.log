timestamp=2026-09-01T10:09:55.911Z level=INFO run=f27b5900 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nfrom collections import defaultdict\nfrom brsoccer.data import _raw_rows, find_data_dir\nfrom brsoccer.normalize import TeamRegistry\n\nraw = _raw_rows(find_data_dir())\nreg = TeamRegistry()\nfor r in raw:\n    reg.ingest(r['home_raw']); reg.ingest(r['away_raw'])\nreg.finalize()\n\ndef fixed_season(r):\n    if r['source']=='BR-Football-Dataset.csv' and r['competition'] in ('serie_a','serie_b','serie_c'):\n        d = r['date']\n        if d and d.month <= 2:\n            return d.year - 1\n    return r['season']\n\nfor season in (2015, 2020, 2021, 2022):\n    buckets = defaultdict(list)\n    for r in raw:\n        if r['competition']!='serie_a': continue\n        s = fixed_season(r)\n        if s != season: continue\n        buckets[(reg.key_of(r['home_raw']), reg.key_of(r['away_raw']))].append(r)\n    # reversed-pair detection: (A,B) and (B,A) same date/score\n    keys = set(buckets)\n    reversed_hits = []\n    for (h, a) in keys:\n        if (a, h) in keys and h < a:\n            for r1 in buckets[(h, a)]:\n                for r2 in buckets[(a, h)]:\n                    if r1['date'] == r2['date'] and (r1['home_goal'], r1['away_goal']) == (r2['away_goal'], r2['home_goal']) and r1['home_goal'] is not None:\n                        reversed_hits.append(((h,a), r1['date'], r1['home_goal'], r1['away_goal'], r1['source'], r2['source']))\n    print(f\"\\n{season}: pairs={len(keys)} reversed-dupes={len(reversed_hits)}\")\n    for x in reversed_hits[:5]: print(\"   REVERSED:\", x)\n    # what sources contribute per pair for extras in 2020\n    if season in (2020,):\n        # which pairs are NOT in BRAS?\n        bras_pairs = {(reg.key_of(r['home_raw']), reg.key_of(r['away_raw'])) for r in raw if r['competition']=='serie_a' and r['source']=='Brasileirao_Matches.csv' and r['season']==season}\n        extra = keys - bras_pairs\n        print(f\"  extra pairs not in BRAS: {len(extra)}\")\n        for (h,a) in list(extra)[:10]:\n            rows = buckets[(h,a)]\n            print(\"   EXTRA:\", h, a, [(r['source'], str(r['date']), r['home_goal'], r['away_goal']) for r in rows])\n            # is the reverse in bras?\n            rev = (a, h)\n            print(\"      reverse pair rows:\", [(r['source'], str(r['date']), r['home_goal'], r['away_goal']) for r in buckets.get(rev, [])][:3])\nEOF" action.permission=bash action.action=allow action.pattern=*
