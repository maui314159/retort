timestamp=2026-09-01T03:16:33.662Z level=INFO run=2973fea4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport sys, csv\nsys.path.insert(0, '.')\nfrom brazilian_soccer.loader import load_all, DATA_DIR\nfrom collections import Counter, defaultdict\n\nreg, matches, players = load_all()\nsa2019 = [m for m in matches if m.competition == \"Brasileirão Serie A\" and m.season == 2019]\nby_src = Counter(m.source for m in sa2019)\nprint(\"2019 kept per source:\", by_src)\n\n# raw counts before dedupe (reload without dedupe)\nfrom brazilian_soccer.loader import load_match_rows, load_players\nreg2 = type(reg)()\nrows = load_match_rows(reg2)\nfor m in rows:\n    m.home_key = reg2.key_for(m.home_raw)\n    m.away_key = reg2.key_for(m.away_raw)\nreg2.finalize()\nfor m in rows:\n    m.home_key = reg2.key_for(m.home_raw); m.away_key = reg2.key_for(m.away_raw)\nsa = [m for m in rows if m.competition == \"Brasileirão Serie A\" and m.season == 2019]\nprint(\"raw 2019 per source:\", Counter(m.source for m in sa))\npairs = defaultdict(set)\nfor m in sa:\n    pairs[(m.home_key, m.away_key)].add(m.source)\nextra = {k: v for k, v in pairs.items() if v == {\"BR-Football-Dataset.csv\"}}\nprint(\"pairs ONLY in BR-Football:\", len(extra))\nfor (h, a), v in list(extra.items())[:6]:\n    print(\"   \", h, \"vs\", a, \"| displays:\", reg2.display(h), reg2.display(a))\n    for m in sa:\n        if (m.home_key, m.away_key) == (h, a):\n            print(\"      \", m.source, m.date, repr(m.home_raw), m.home_goal, \"-\", m.away_goal, repr(m.away_raw))\nEOF" action.permission=bash action.action=allow action.pattern=*
