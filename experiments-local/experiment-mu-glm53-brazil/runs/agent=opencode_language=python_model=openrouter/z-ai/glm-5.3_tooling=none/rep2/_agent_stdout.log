maui/.retort/work/retort-local-e6k_mc30/retort-9f7589d26ec0/brazilian_soccer_mcp/normalize.py\n@@ -58,10 +58,10 @@\n     \"santa catarina\": \"SC\", \"sao paulo\": \"SP\", \"sergipe\": \"SE\", \"tocantins\": \"TO\",\n }\n \n NOISE_TOKENS = {\n-    \"aa\", \"ac\", \"ad\", \"ae\", \"ca\", \"ce\", \"clube\", \"club\", \"cs\", \"ec\", \"fc\",\n-    \"ge\", \"sc\",\n+    \"aa\", \"ac\", \"ad\", \"ae\", \"ca\", \"ce\", \"clube\", \"club\", \"cs\", \"ec\",\n+    \"esporte\", \"fc\", \"ge\", \"sc\",\n }\n \n ALIASES = {\n     \"america mineiro\": \"america-mg\",\n","additions":2,"deletions":2},"truncated":false},"title":"brazilian_soccer_mcp/normalize.py","time":{"start":1788204608218,"end":1788204608221}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Wait — \"esporte\" was also in NOISE before, and I removed it. \"Esporte Clube Bahia\"? brf uses \"EC Bahia\". If any name has \"Esporte\" like \"Esporte Clube Bahia\" (cup file full names?) → \"esporte clube bahia\" → remove \"clube\" → \"esporte bahia\" ≠ \"bahia\". Cup names are like \"Boavista Sport Club (antigo Esporte Clube Barreira) - RJ\" — parenthetical removed anyway. I removed \"esporte\" — safer to keep it? \"Boa Esporte\" club! brf has \"Boa\" only. Hmm \"Rattlesnake Esporte\"? Keeping \"esporte\" in noise: \"4 de Julho EC\" fine... What club has meaningful \"esporte\"? \"Criciuma\" full name \"Criciúma Esporte Clube\" → \"criciuma esporte clube\" → remove esporte+clube → \"criciuma\" ✓ GOOD to remove. \"Boa Esporte\" → \"boa\" — brf has \"Boa\" ✓ consistent! OK add \"esporte\" back. Actually wait, earlier smoke tests passed with \"esporte\" in noise. Add it back.","format":"unknown","index":0}]}},"id":"prt_0594cead30015cl36tBxvBxoLk","sessionID":"ses_fa6cfe050ffe51wxe0DFh4LAA3","messageID":"msg_0594cbfe0001Nx8nFiuzHe7Vl3"}}
