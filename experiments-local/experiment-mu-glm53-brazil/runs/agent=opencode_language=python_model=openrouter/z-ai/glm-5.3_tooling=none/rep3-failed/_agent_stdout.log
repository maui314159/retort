rver\n\nasync def main():\n    s = build_server(data_dir=\"data/kaggle\")\n    tools = await s.list_tools()\n    print(\"Tools:\", [t.name for t in tools])\n    for name, args in [\n        (\"search_matches\", {\"team\": \"Flamengo\", \"opponent\": \"Fluminense\", \"limit\": 3}),\n        (\"standings\", {\"season\": 2019}),\n        (\"search_players\", {\"nationality\": \"Brazilian\", \"limit\": 3}),\n        (\"find_team\", {\"name\": \"Timão\"}),\n        (\"statistics\", {\"competition\": \"Brasileirão\", \"season\": 2019}),\n        (\"derbies\", {\"derby\": \"Gre-Nal\", \"limit\": 2}),\n        (\"club_players\", {\"club\": \"Fluminense\"}),\n        (\"head_to_head\", {\"team_a\": \"Palmeiras\", \"team_b\": \"Santos\", \"limit\": 2}),\n        (\"biggest_wins\", {\"competition\": \"Libertadores\", \"limit\": 3}),\n        (\"list_competitions\", {}),\n        (\"search_players\", {\"name\": \"Gabriel Barbosa\"}),\n    ]:\n        res = await s.call_tool(name, args)\n        text = res.content[0].text if res.content else str(res)\n        print(f\"\\n=== {name} {args} ===\")\n        print(text[:700])\n\nasyncio.run(main())\nEOF","time":{"start":1788203147499,"end":1788203147572}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_059369a7a001XeKx9qcmOPGGcc","sessionID":"ses_fa6e4b534ffex1G5nGEhqeGwzS","messageID":"msg_0593683fd001SaDYk45zXR0j5b"}}
