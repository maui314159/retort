timestamp=2026-09-01T14:41:06.910Z level=INFO run=bd57de6d message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, unicodedata, re\n\nUF = {'SP','RJ','MG','RS','PR','SC','PE','CE','BA','GO','AL','MT','MS','PA','RN','PB','SE','PI','MA','TO','RO','AC','AM','AP','RR','DF','ES'}\ndef slug(s):\n    s = unicodedata.normalize('NFKD', s)\n    s = ''.join(c for c in s if not unicodedata.combining(c)).lower()\n    m = re.findall(r'\\(([^)]*)\\)', s)\n    s = re.sub(r'\\([^)]*\\)', ' ', s)\n    for x in m:\n        x = x.strip()\n        if x and len(x.split()) == 1 and len(x) <= 4: s += ' ' + x\n    s = ''.join(c if c.isalnum() else ' ' for c in s)\n    return ' '.join(s.split())\n\nALIASES = {\n    'atletico mineiro': 'atletico mg', 'atletico goianiense': 'atletico go',\n    'atletico paranaense': 'atletico pr', 'athletico paranaense': 'atletico pr', 'athletico': 'atletico pr',\n    'sport recife': 'sport', 'sport club do recife': 'sport',\n    'ceara sporting club': 'ceara', 'clube do remo': 'remo', 'nautico capibaribe': 'nautico',\n    'vasco da gama': 'vasco', 'cs alagoano': 'csa', 'cs sergipe': 'sergipe',\n    'boavista sport club': 'boavista', 'boavista sc saquarema': 'boavista',\n    'gremio rs': 'gremio', 'internacional rs': 'internacional',\n    'fluminense de feira': 'fluminense de feira',\n    'athletic club': 'athletic mg', 'vitoria ec': 'vitoria ba', 'ec vitoria': 'vitoria ba', 'ec bahia': 'bahia',\n    'sao jose poa': 'sao jose rs', 'operario fc ms': 'operario ms', 'operario': 'operario pr',\n    'sampaio correa': 'sampaio correa', 'gremio novorizontino': 'novorizontino',\n    'spfc': 'sao paulo',\n}\nBASES = {'palmeiras','flamengo','corinthians','santos','sao paulo','sport','bahia','ceara','fortaleza','vitoria ba','cruzeiro','coritiba','parana','chapecoense','avai','figueirense','criciuma','goias','gremio','internacional','fluminense','guarani','portuguesa','juventude','caxias','nautico','remo','paysandu','sampaio correa','csa','crb','abc','vasco','vila nova','ponte preta','santa cruz','joinville','america rn'}\ndef key(t):\n    s = slug(t)\n    if s in ALIASES: return ALIASES[s]\n    toks = s.split()\n    if toks and toks[-1].upper() in UF:\n        base = ' '.join(toks[:-1])\n        if base in BASES: return base\n    return s\n\ndef load(path, hcol, acol, hg, ag, dcol, dparse, season_from_date=True, tcol=None, tval=None):\n    rows = []\n    with open(path, encoding='utf-8') as f:\n        for row in csv.DictReader(f):\n            if tcol and row[tcol] != tval: continue\n            try:\n                hgi, agi = int(float(row[hg])), int(float(row[ag]))\n            except (ValueError, TypeError): continue\n            d = dparse(row[dcol])\n            rows.append((d, key(row[hcol]), key(row[acol]), hgi, agi, int(d[:4])))\n    return rows\n\ndef iso(d): return d[:10]\ndef brd(d):\n    dd, mm, yy = d.split('/'); return f\"{yy}-{mm}-{dd}\"\n\na = load('data/kaggle/Brasileirao_Matches.csv','home_team','away_team','home_goal','away_goal','datetime', iso)\nb = load('data/kaggle/novo_campeonato_brasileiro.csv','Equipe_mandante','Equipe_visitante','Gols_mandante','Gols_visitante','Data', brd)\nfA = load('data/kaggle/BR-Football-Dataset.csv','home','away','home_goal','away_goal','date', iso, tcol='tournament', tval='Serie A')\n\nma = {(s,h,aw):(hg,ag) for (d,h,aw,hg,ag,s) in a}\nmb = {(s,h,aw):(hg,ag) for (d,h,aw,hg,ag,s) in b}\ncommon = set(ma) & set(mb)\nagree = sum(1 for k in common if ma[k]==mb[k])\nprint(f\"novo vs brfile: common {len(common)}, agree {agree}\")\nmf = {(s,h,aw):(hg,ag) for (d,h,aw,hg,ag,s) in fA}\ncf = set(ma) & set(mf); agreef = sum(1 for k in cf if ma[k]==mf[k])\nprint(f\"brfb SerieA vs brfile: common {len(cf)}, agree {agreef}\")\n\ndef table(rows, year):\n    pts = {}\n    for (d,h,aw,hg,ag,s) in rows:\n        if s != year: continue\n        for t in (h,aw): pts.setdefault(t, [0,0,0,0,0,0])\n        if hg>ag: pts[h][0]+=3; pts[h][1]+=1; pts[aw][3]+=1\n        elif hg<ag: pts[aw][0]+=3; pts[aw][1]+=1; pts[h][3]+=1\n        else: pts[h][0]+=1; pts[aw][0]+=1; pts[h][2]+=1; pts[aw][2]+=1\n        pts[h][4]+=hg; pts[h][5]+=ag; pts[aw][4]+=ag; pts[aw][5]+=hg\n    return sorted(pts.items(), key=lambda kv:(-kv[1][0], -(kv[1][4]-kv[1][5]), -kv[1][4]))\n\ns23 = [r for r in fA if r[5]==2023]\nprint(\"2023 Serie A matches:\", len(s23))\nfor t,v in table(s23, 2023)[:4]: print(\"  2023 top:\", t, v)\nfor t,v in table(a, 2020)[-4:]: print(\"  2020 bottom:\", t, v)\n# 2015 top from each source to compare\nfor t,v in table([r for r in a if r[5]==2015], 2015)[:2]: print(\"  2015 brfile:\", t, v)\nfor t,v in table([r for r in b if r[5]==2015], 2015)[:2]: print(\"  2015 novo:\", t, v)\nEOF" action.permission=bash action.action=allow action.pattern=*
