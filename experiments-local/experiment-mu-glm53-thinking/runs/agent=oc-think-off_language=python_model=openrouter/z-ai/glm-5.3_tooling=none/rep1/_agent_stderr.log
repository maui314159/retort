timestamp=2026-09-01T15:30:10.146Z level=INFO run=5e16c2b4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport pathlib\np = pathlib.Path(\"brazilian_soccer/analysis.py\")\ns = p.read_text()\ns = s.replace(\"from .loader import Match, Player, SoccerData, normalize_team\",\n              \"from .loader import Match, Player, SoccerData, group_key\")\nold_find = '''    team_key = normalize_team(team) if team else None\n    opp_key = normalize_team(opponent) if opponent else None\n    comp = _comp_key(competition) if competition else None\n    results = []\n    for m in data.matches:\n        if team_key:\n            if venue == \"home\" and normalize_team(m.home) != team_key:\n                continue\n            if venue == \"away\" and normalize_team(m.away) != team_key:\n                continue\n            if venue not in (\"home\", \"away\") and team_key not in (\n                normalize_team(m.home),\n                normalize_team(m.away),\n            ):\n                continue\n        if opp_key and opp_key not in (normalize_team(m.home), normalize_team(m.away)):\n            continue\n        if team_key and opp_key and normalize_team(m.home) == normalize_team(m.away):\n            continue\n        if comp and _comp_key(m.competition) != comp:\n            continue'''\nnew_find = '''    tkeys = data.keys_for(team) if team else None\n    okeys = data.keys_for(opponent) if opponent else None\n    comp = _comp_key(competition) if competition else None\n    results = []\n    for m in data.matches:\n        if tkeys:\n            home_hit = bool(data.keys_for(m.home) & tkeys)\n            away_hit = bool(data.keys_for(m.away) & tkeys)\n            if venue == \"home\" and not home_hit:\n                continue\n            if venue == \"away\" and not away_hit:\n                continue\n            if venue not in (\"home\", \"away\") and not (home_hit or away_hit):\n                continue\n        if okeys and not (\n            data.keys_for(m.home) & okeys or data.keys_for(m.away) & okeys\n        ):\n            continue\n        if comp and _comp_key(m.competition) != comp:\n            continue'''\nassert old_find in s\ns = s.replace(old_find, new_find)\n\nold_rec = '''def _record(matches: list[Match], team_key: str) -> dict[str, Any]:\n    wins = draws = losses = gf = ga = 0\n    home_matches = away_matches = 0\n    for m in matches:\n        if normalize_team(m.home) == team_key:\n            home_matches += 1\n            gf += m.home_goal\n            ga += m.away_goal\n            if m.home_goal > m.away_goal:\n                wins += 1\n            elif m.home_goal == m.away_goal:\n                draws += 1\n            else:\n                losses += 1\n        else:\n            away_matches += 1\n            gf += m.away_goal\n            ga += m.home_goal\n            if m.away_goal > m.home_goal:\n                wins += 1\n            elif m.home_goal == m.away_goal:\n                draws += 1\n            else:\n                losses += 1'''\nnew_rec = '''def _record(data: SoccerData, matches: list[Match], tkeys: frozenset[str]) -> dict[str, Any]:\n    wins = draws = losses = gf = ga = 0\n    home_matches = away_matches = 0\n    for m in matches:\n        if data.keys_for(m.home) & tkeys:\n            home_matches += 1\n            gf += m.home_goal\n            ga += m.away_goal\n            if m.home_goal > m.away_goal:\n                wins += 1\n            elif m.home_goal == m.away_goal:\n                draws += 1\n            else:\n                losses += 1\n        else:\n            away_matches += 1\n            gf += m.away_goal\n            ga += m.home_goal\n            if m.away_goal > m.home_goal:\n                wins += 1\n            elif m.home_goal == m.away_goal:\n                draws += 1\n            else:\n                losses += 1'''\nassert old_rec in s\ns = s.replace(old_rec, new_rec)\n\nold_ts = '''    team_key = normalize_team(team)\n    comp = _comp_key(competition) if competition else None\n    matches = []\n    for m in data.matches_for_team(team):\n        if season is not None and m.season != season:\n            continue\n        if comp and _comp_key(m.competition) != comp:\n            continue\n        if venue == \"home\" and normalize_team(m.home) != team_key:\n            continue\n        if venue == \"away\" and normalize_team(m.away) != team_key:\n            continue\n        matches.append(m)\n    display = data.resolve_team(team) or team\n    overall = _record(matches, team_key)\n    home_only = [m for m in matches if normalize_team(m.home) == team_key]\n    away_only = [m for m in matches if normalize_team(m.away) == team_key]'''\nnew_ts = '''    tkeys = data.keys_for(team)\n    comp = _comp_key(competition) if competition else None\n    matches = []\n    for m in data.matches_for_team(team):\n        if season is not None and m.season != season:\n            continue\n        if comp and _comp_key(m.competition) != comp:\n            continue\n        home_hit = bool(data.keys_for(m.home) & tkeys)\n        away_hit = bool(data.keys_for(m.away) & tkeys)\n        if venue == \"home\" and not home_hit:\n            continue\n        if venue == \"away\" and not away_hit:\n            continue\n        matches.append(m)\n    display = data.resolve_team(team) or team\n    overall = _record(data, matches, tkeys)\n    home_only = [m for m in matches if data.keys_for(m.home) & tkeys]\n    away_only = [m for m in matches if data.keys_for(m.away) & tkeys]'''\nassert old_ts in s\ns = s.replace(old_ts, new_ts)\ns = s.replace('\"home\": _record(home_only, team_key),\\n        \"away\": _record(away_only, team_key),',\n              '\"home\": _record(data, home_only, tkeys),\\n        \"away\": _record(data, away_only, tkeys),')\n\nold_h2h = '''    team_key = normalize_team(team)\n    opp_key = normalize_team(opponent)\n    comp = _comp_key(competition) if competition else None\n    matches = [\n        m\n        for m in data.matches\n        if {normalize_team(m.home), normalize_team(m.away)} == {team_key, opp_key}\n        and (comp is None or _comp_key(m.competition) == comp)\n    ]\n    matches.sort(key=lambda m: (m.date is None, m.date))\n    team_wins = opp_wins = draws = 0\n    for m in matches:\n        winner = m.winner\n        if winner == \"draw\":\n            draws += 1\n        elif winner == \"home\":\n            team_wins += 1 if normalize_team(m.home) == team_key else 0\n            opp_wins += 1 if normalize_team(m.home) == opp_key else 0\n        else:\n            team_wins += 1 if normalize_team(m.away) == team_key else 0\n            opp_wins += 1 if normalize_team(m.away) == opp_key else 0'''\nnew_h2h = '''    tkeys = data.keys_for(team)\n    okeys = data.keys_for(opponent)\n    comp = _comp_key(competition) if competition else None\n    matches = [\n        m\n        for m in data.matches\n        if (\n            bool(data.keys_for(m.home) & tkeys) != bool(data.keys_for(m.home) & okeys)\n            or bool(data.keys_for(m.away) & tkeys) != bool(data.keys_for(m.away) & okeys)\n        )\n        and (\n            (bool(data.keys_for(m.home) & tkeys) or bool(data.keys_for(m.away) & tkeys))\n            and (bool(data.keys_for(m.home) & okeys) or bool(data.keys_for(m.away) & okeys))\n        )\n        and (comp is None or _comp_key(m.competition) == comp)\n    ]\n    matches.sort(key=lambda m: (m.date is None, m.date))\n    team_wins = opp_wins = draws = 0\n    for m in matches:\n        winner = m.winner\n        if winner == \"draw\":\n            draws += 1\n        else:\n            home_is_team = bool(data.keys_for(m.home) & tkeys)\n            scorer = \"home\" if home_is_team else \"away\"\n            loser = \"away\" if home_is_team else \"home\"\n            if winner == scorer:\n                team_wins += 1\n            else:\n                opp_wins += 1'''\nassert old_h2h in s\ns = s.replace(old_h2h, new_h2h)\n\nold_st = '''    table: dict[str, dict[str, Any]] = {}\n    for m in data.matches:\n        if m.season != season or _comp_key(m.competition) != comp:\n            continue\n        for name in (m.home, m.away):\n            key = normalize_team(name)\n            if key not in table:\n                table[key] = {\n                    \"team\": name,\n                    \"points\": 0,\n                    \"wins\": 0,\n                    \"draws\": 0,\n                    \"losses\": 0,\n                    \"goals_for\": 0,\n                    \"goals_against\": 0,\n                }\n        h = table[normalize_team(m.home)]\n        a = table[normalize_team(m.away)]'''\nnew_st = '''    table: dict[str, dict[str, Any]] = {}\n    for m in data.matches:\n        if m.season != season or _comp_key(m.competition) != comp:\n            continue\n        for name in (m.home, m.away):\n            key = group_key(name)\n            if key not in table:\n                table[key] = {\n                    \"team\": name,\n                    \"points\": 0,\n                    \"wins\": 0,\n                    \"draws\": 0,\n                    \"losses\": 0,\n                    \"goals_for\": 0,\n                    \"goals_against\": 0,\n                }\n        h = table[group_key(m.home)]\n        a = table[group_key(m.away)]'''\nassert old_st in s\ns = s.replace(old_st, new_st)\n\nold_sp = '''    results: list[Player] = []\n    name_q = normalize_team(name or \"\") if name else None\n    nationality_q = (nationality or \"\").strip().lower()\n    club_q = normalize_team(club) if club else None\n    position_q = (position or \"\").strip().upper()\n    for p in data.players:\n        if name_q and name_q not in normalize_team(p.name):\n            continue\n        if nationality_q and p.nationality.strip().lower() != nationality_q:\n            continue\n        if club_q and club_q not in normalize_team(p.club):\n            continue'''\nnew_sp = '''    results: list[Player] = []\n    name_q = group_key(name or \"\") if name else None\n    nationality_q = (nationality or \"\").strip().lower()\n    club_q = data.keys_for(club) if club else None\n    position_q = (position or \"\").strip().upper()\n    for p in data.players:\n        if name_q and name_q not in group_key(p.name):\n            continue\n        if nationality_q and p.nationality.strip().lower() != nationality_q:\n            continue\n        if club_q and not (data.keys_for(p.club) & club_q):\n            continue'''\nassert old_sp in s\ns = s.replace(old_sp, new_sp)\np.write_text(s)\nprint(\"done\")\nEOF" action.permission=bash action.action=allow action.pattern=*
