ip():\n     return None\n key = normalize_text(name)\n-key = key.replace(\"ã\", \"a\")  # normalize_text already strips accents\n if key in _COMPETITION_ALIASES:\n     return _COMPETITION_ALIASES[key]\n if known:\n     for comp in known:\n","additions":0,"deletions":1},"truncated":false},"title":"brazilian_soccer_mcp/queries.py","time":{"start":1785548863110,"end":1785548863112}},"id":"prt_fbb0172240018n10fMga35s0iA","sessionID":"ses_04501cd40ffewOC0br6SKhywMQ","messageID":"msg_fbb016ccc001Hz4TMdKBjJG4ed"}}
