timestamp=2026-09-01T06:04:07.382Z level=INFO run=f180ecb5 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nfrom collections import Counter, defaultdict\nfrom brazilian_soccer import SoccerData\nfrom brazilian_soccer.normalize import fold\ndata = SoccerData()\n\n# Serie A 2019: which two keys represent Vasco?\nt2019 = defaultdict(lambda: defaultdict(int))\nfor m in data.matches:\n    if m.competition=='brasileirao' and m.season==2019:\n        t2019[m.home.key]['home'] += 1\n        t2019[m.away.key]['away'] += 1\nfor k, d in sorted(t2019.items()):\n    if 'vasco' in k:\n        print('vasco-ish key:', k, dict(d), 'display:', data.registry.display(k))\n# any key with weird counts (e.g. 19 home AND appears twice)? list keys whose fold base collides\nbases = defaultdict(list)\nfor k in t2019:\n    bases[fold(data.registry.display(k))].append(k)\nprint('duplicate display bases in 2019:', {b: ks for b, ks in bases.items() if len(ks) > 1})\n\n# who are the two 49pts Vasco keys? print table keys\nfrom brazilian_soccer.models import TeamRecord\ntable = defaultdict(TeamRecord)\nfor m in data.matches:\n    if m.competition=='brasileirao' and m.season==2019 and m.played:\n        hr = 'W' if m.home_goals>m.away_goals else 'D' if m.home_goals==m.away_goals else 'L'\n        ar = 'L' if hr=='W' else 'D' if hr=='D' else 'W'\n        table[m.home.key].add(hr, m.home_goals, m.away_goals)\n        table[m.away.key].add(ar, m.away_goals, m.home_goals)\nvasco = [(k, r.matches, r.points) for k, r in table.items() if 'vasco' in k]\nprint('vasco keys in table:', vasco)\n\n# sample matches for the second vasco key\nvk = [k for k,_,_ in vasco if k != 'vascodagamarj']\nif vk:\n    key = vk[0]\n    ms = [m for m in data.matches if m.competition=='brasileirao' and m.season==2019 and key in (m.home.key, m.away.key)]\n    print('sample matches for', key, ':')\n    for m in ms[:4]:\n        print('   ', m.date, m.source, m.home.display, m.home_goals, '-', m.away_goals, m.away.display)\nEOF" action.permission=bash action.action=allow action.pattern=*
