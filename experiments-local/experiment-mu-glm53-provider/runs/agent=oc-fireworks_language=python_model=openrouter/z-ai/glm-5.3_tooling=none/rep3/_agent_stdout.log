[2]==k[2]]\n        print(\"   BRAS-only:\", k, \" hist same teams:\", same_teams[:3])\nEOF"},"output":"\n2013: bras=380 hist=380 brf=0 brasUhist=380 union_all=380\n  brf not in brasUhist: 0; brasUhist not in brf: 380\n  bras∩hist=380, bras-hist=0, hist-bras=0\n\n2019: bras=380 hist=380 brf=380 brasUhist=382 union_all=463\n  brf not in brasUhist: 81; brasUhist not in brf: 83\n  bras∩hist=378, bras-hist=2, hist-bras=2\n   BRF-only: (datetime.date(2019, 6, 11), 'goias', 'chapecoense') goals 3 1\n     same teams in brasUhist at dates: [(datetime.date(2019, 6, 10), 'goias', 'chapecoense')]\n   BRF-only: (datetime.date(2019, 9, 26), 'flamengo rj', 'internacional rs') goals 3 1\n     same teams in brasUhist at dates: [(datetime.date(2019, 9, 25), 'flamengo rj', 'internacional rs')]\n   BRF-only: (datetime.date(2019, 9, 26), 'bahia', 'botafogo rj') goals 2 0\n     same teams in brasUhist at dates: [(datetime.date(2019, 9, 25), 'bahia', 'botafogo rj')]\n   BRF-only: (datetime.date(2019, 10, 10), 'cruzeiro', 'fluminense rj') goals 0 0\n     same teams in brasUhist at dates: [(datetime.date(2019, 10, 9), 'cruzeiro', 'fluminense rj')]\n   BRF-only: (datetime.date(2019, 11, 28), 'corinthians', 'avai') goals 3 0\n     same teams in brasUhist at dates: [(datetime.date(2019, 11, 27), 'corinthians', 'avai')]\n   BRAS-only: (datetime.date(2019, 12, 2), 'vasco', 'cruzeiro')  hist same teams: [(datetime.date(2019, 12, 1), 'vasco', 'cruzeiro')]\n   BRAS-only: (datetime.date(2019, 7, 29), 'csa', 'gremio')  hist same teams: [(datetime.date(2019, 7, 28), 'csa', 'gremio')]\n\n2021: bras=380 hist=0 brf=491 brasUhist=380 union_all=644\n  brf not in brasUhist: 264; brasUhist not in brf: 153\n  bras∩hist=0, bras-hist=380, hist-bras=0\n   BRF-only: (datetime.date(2021, 2, 17), 'coritiba', 'palmeiras') goals 1 0\n     same teams in brasUhist at dates: []\n   BRF-only: (datetime.date(2021, 10, 17), 'ceara', 'bragantino sp') goals 2 2\n     same teams in brasUhist at dates: []\n   BRF-only: (datet