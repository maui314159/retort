n\nsa = set((d,h,aw,hg,ag) for (d,h,aw,hg,ag,s) in a if s=='2015')\nsb = set((d,h,aw,hg,ag) for (d,h,aw,hg,ag,s) in b if s=='2015')\nprint(\"2015: brfile\", len(sa), \"novo\", len(sb), \"exact overlap\", len(sa & sb))\nEOF"},"output":"2019 standings from novo (top 4):\n  flamengo [90, 28, 6, 4, 86, 37]\n  palmeiras [74, 21, 11, 6, 61, 32]\n  santos [74, 22, 8, 8, 60, 33]\n  gremio [65, 19, 8, 11, 64, 39]\n2019 standings from Brasileirao file (top 4):\n  atletico [112, 31, 19, 26, 96, 81]\n  flamengo [90, 28, 6, 4, 86, 37]\n  palmeiras [74, 21, 11, 6, 61, 32]\n  santos [74, 22, 8, 8, 60, 33]\n2022 from Brasileirao file (top 3):\n  atletico [122, 32, 26, 32, 104, 113]\n  palmeiras [66, 19, 9, 2, 52, 20]\n  internacional [54, 14, 12, 4, 44, 26]\n2015: brfile 380 novo 380 exact overlap 0\n","metadata":{"output":"2019 standings from novo (top 4):\n  flamengo [90, 28, 6, 4, 86, 37]\n  palmeiras [74, 21, 11, 6, 61, 32]\n  santos [74, 22, 8, 8, 60, 33]\n  gremio [65, 19, 8, 11, 64, 39]\n2019 standings from Brasileirao file (top 4):\n  atletico [112, 31, 19, 26, 96, 81]\n  flamengo [90, 28, 6, 4, 86, 37]\n  palmeiras [74, 21, 11, 6, 61, 32]\n  santos [74, 22, 8, 8, 60, 33]\n2022 from Brasileirao file (top 3):\n  atletico [122, 32, 26, 32, 104, 113]\n  palmeiras [66, 19, 9, 2, 52, 20]\n  internacional [54, 14, 12, 4, 44, 26]\n2015: brfile 380 novo 380 exact overlap 0\n","exit":0,"truncated":false},"title":"venv/bin/python - <<'EOF'\nimport csv, unicodedata\n\ndef norm(t):\n    t = unicodedata.normalize('NFKD', t)\n    t = ''.join(c for c in t if not unicodedata.combining(c))\n    t = t.split('-')[0] if '-' in t else t\n    return t.strip().lower()\n\ndef load_br(path, hcol, acol, hg, ag, season, date):\n    rows = []\n    with open(path, encoding='utf-8') as f:\n        for row in csv.DictReader(f):\n            try:\n                hgi, agi = int(row[hg]), int(row[ag])\n            except (ValueError, TypeError):\n                continue\n            rows.append((row[date][:10], norm(row[hcol]), norm(row[acol]), hgi, agi, row[season]))\n    return rows\n\na = load_br('data/kaggle/Brasileirao_Matches.csv','home_team','away_team','home_goal','away_goal','season','datetime')\nb = load_br('data/kaggle/novo_campeonato_brasileiro.csv','Equipe_mandante','Equipe_visitante','Gols_mandante','Gols_visitante','Ano','Data')\n\ndef standings(rows, year):\n    pts = {}\n    for (d, h, aw, hg, ag, s) in rows:\n        if s != year: continue\n        for t in (h, aw): pts.setdefault(t, [0,0,0,0,0,0])\n        if hg > ag: pts[h][0]+=3; pts[h][1]+=1; pts[aw][3]+=1\n        elif hg < ag: pts[aw][0]+=3; pts[aw][1]+=1; pts[h][3]+=1\n        else: pts[h][0]+=1; pts[aw][0]+=1; pts[h][2]+=1; pts[aw][2]+=1\n        pts[h][4]+=hg; pts[h][5]+=ag; pts[aw][4]+=ag; pts[aw][5]+=hg\n    return sorted(pts.items(), key=lambda kv: (-kv[1][0], -(kv[1][4]-kv[1][5])))\n\nprint(\"2019 standings from novo (top 4):\")\nfor t, v in standings(b, '2019')[:4]: print(\" \", t, v)\nprint(\"2019 standings from Brasileirao file (top 4):\")\nfor t, v in standings(a, '2019')[:4]: print(\" \", t, v)\nprint(\"2022 from Brasileirao file (top 3):\")\nfor t, v in standings(a, '2022')[:3]: print(\" \", t, v)\n\nsa = set((d,h,aw,hg,ag) for (d,h,aw,hg,ag,s) in a if s=='2015')\nsb = set((d,h,aw,hg,ag) for (d,h,aw,hg,ag,s) in b if s=='2015')\nprint(\"2015: brfile\", len(sa), \"novo\", len(sb), \"exact overlap\", len(sa & sb))\nEOF","time":{"start":1788273165180,"end":1788273165183}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05d6303130016UVcNicdKlNFY7","sessionID":"ses_fa29f8b64ffekf1eHikDs909KG","messageID":"msg_05d62db620013dlgUvvZcqHkoH"}}
