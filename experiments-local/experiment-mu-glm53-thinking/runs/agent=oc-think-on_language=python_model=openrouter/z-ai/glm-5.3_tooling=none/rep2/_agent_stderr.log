timestamp=2026-09-01T16:36:27.673Z level=INFO run=66fb43df message=evaluated permission=bash pattern="python3 << 'EOF'\nimport csv\nfrom collections import Counter\ndef load(f):\n    with open(f, encoding='utf-8') as fh:\n        return list(csv.DictReader(fh))\nb = load('data/kaggle/Brasileirao_Matches.csv')\nbr = load('data/kaggle/BR-Football-Dataset.csv')\n\ndef norm(t):  # strip state suffix\n    return t.split('-')[0].strip() if '-SP' in t or '-RJ' in t or '-MG' in t or '-PR' in t or '-SC' in t or '-RS' in t or '-GO' in t or '-CE' in t or '-BA' in t or '-PE' in t or '-MT' in t or '-AL' in t or '-RN' in t or '-ES' in t or '-PB' in t or '-PI' in t or '-MS' in t or '-DF' in t or '-TO' in t or '-SE' in t or '-PA' in t or '-AM' in t or '-AP' in t or '-RO' in t or '-MA' in t else t\n\nf1 = Counter()\ndates1 = {}\nfor r in b:\n    if r['season']=='2019' and ('Flamengo' in r['home_team'] or 'Flamengo' in r['away_team']):\n        h, a = norm(r['home_team']), norm(r['away_team'])\n        hg, ag = int(r['home_goal']), int(r['away_goal'])\n        f1[(h, a, hg, ag)] += 1\n        dates1[(h,a,hg,ag)] = r['datetime'][:10]\nf2 = Counter()\ndates2 = {}\nfor r in br:\n    if r['tournament']=='Serie A' and r['date'].startswith('2019') and r['home']=='Flamengo' or (r['tournament']=='Serie A' and r['date'].startswith('2019') and r['away']=='Flamengo'):\n        h, a = r['home'], r['away']\n        hg, ag = int(float(r['home_goal'])), int(float(r['away_goal']))\n        f2[(h, a, hg, ag)] += 1\n        dates2[(h,a,hg,ag)] = r['date']\n\nprint('b fixtures:', sum(f1.values()), 'br fixtures:', sum(f2.values()))\ninter = (f1 & f2)\nprint('same fixture+score:', sum(inter.values()))\nprint('date agreement among common:', sum(1 for k in inter if dates1[k]==dates2[k]), '/', len(inter))\nprint('only in b:', list((f1-f2).elements())[:6])\nprint('only in br:', list((f2-f1).elements())[:6])\nEOF" action.permission=bash action.action=allow action.pattern=*
