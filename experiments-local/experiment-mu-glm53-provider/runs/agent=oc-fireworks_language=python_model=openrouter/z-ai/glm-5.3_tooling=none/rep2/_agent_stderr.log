timestamp=2026-09-01T05:44:28.185Z level=INFO run=f180ecb5 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, re, unicodedata, collections\nbase='data/kaggle/'\ndef fold(s):\n    s = unicodedata.normalize('NFKD', s)\n    s = ''.join(ch for ch in s if not unicodedata.combining(ch))\n    return re.sub(r'[^a-z0-9]', '', s.lower()).replace('athletico','atletico')\ndef base_of(n):\n    n = re.sub(r'\\s*\\(antigo[^)]*\\)', '', n)\n    n = re.sub(r'\\s*-\\s*[A-Z]{2}$', '', n)\n    n = re.sub(r'-[A-Z]{2}$', '', n)\n    n = re.sub(r'\\s+[A-Z]{2}$', '', n)\n    return fold(n)\ndef g(v):\n    try: return int(float(v))\n    except: return None\n\ncup = {}\nfor r in csv.DictReader(open(base+'Brazilian_Cup_Matches.csv', encoding='utf-8-sig')):\n    cup[(base_of(r['home_team']), base_of(r['away_team']), r['season'], r['datetime'][:10])] = (g(r['home_goal']), g(r['away_goal']), 'cupfile')\nbfc = {}\nfor r in csv.DictReader(open(base+'BR-Football-Dataset.csv', encoding='utf-8-sig')):\n    if r['tournament'] != 'Copa do Brasil': continue\n    bfc[(base_of(r['home']), base_of(r['away']), r['date'][:4], r['date'])] = (g(r['home_goal']), g(r['away_goal']), 'brfoot')\n# join by pair+season: how many BR-Foot copa fixtures find a cup-file fixture same season (either date or swapped order)?\ncup_ps = collections.defaultdict(list)\nfor (h,a,s,d), v in cup.items(): cup_ps[(h,a,s)].append((d, v))\nbfc_ps = collections.defaultdict(list)\nfor (h,a,s,d), v in bfc.items(): bfc_ps[(h,a,s)].append((d, v))\ncommon_ps = set(cup_ps) & set(bfc_ps)\nprint('cup fixtures (pair,season):', len(cup_ps), 'brfoot copa fixtures:', len(bfc_ps), 'common:', len(common_ps))\nagree = sum(1 for k in common_ps if {v[:2] for _, v in cup_ps[k]} & {v[:2] for _, v in bfc_ps[k]} or True)\nsame_score = 0\nfor k in common_ps:\n    cs = {v[0:2] for _, v in cup_ps[k]}\n    bs = {v[0:2] for _, v in bfc_ps[k]}\n    if cs & bs: same_score += 1\nprint('pair-season with matching score sets:', same_score, '/', len(common_ps))\n# how many brfoot copa fixtures have NO cup counterpart at all (incl. swapped)?\ncup_pairs = {(h,a,s) for (h,a,s,d) in cup} | {(a,h,s) for (h,a,s,d) in cup}\norphans = [k for k in bfc_ps if k not in cup_pairs]\nprint('brfoot copa fixtures w/o cup counterpart:', len(orphans), 'sample:', orphans[:6])\nby_seas = collections.Counter(k[2] for k in orphans)\nprint('orphan seasons:', dict(by_seas))\n\n# 2022 NA rounds\nna22 = collections.Counter()\nfor r in csv.DictReader(open(base+'Brasileirao_Matches.csv', encoding='utf-8-sig')):\n    if r['season']=='2022' and r['home_goal']=='NA': na22[r['round']] += 1\nprint('2022 NA by round:', dict(sorted(na22.items(), key=lambda kv: int(kv[0]))))\n\n# lib 2021 semifinals\nfor r in csv.DictReader(open(base+'Libertadores_Matches.csv', encoding='utf-8-sig')):\n    if r['season']=='2021' and r['stage'] in ('semifinals','final'):\n        print('lib21', r['stage'], r['datetime'][:10], r['home_team'], r['home_goal'], '-', r['away_goal'], r['away_team'])\nEOF" action.permission=bash action.action=allow action.pattern=*
