timestamp=2026-08-31T18:38:07.670Z level=INFO run=9abcf33e message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv, unicodedata\n\ndef strip_accents(s):\n    return ''.join(c for c in unicodedata.normalize('NFD', s) if unicodedata.category(c) != 'Mn')\n\ndef norm(name):\n    n = strip_accents(name).lower()\n    # strip state suffix like -SP, -RJ\n    import re\n    n = re.sub(r'[-\\s]\\s*[a-z]{2}$', '', n) if n.count('-') <= 1 else n\n    return n.strip()\n\ndef load(path):\n    with open(path, encoding='utf-8') as f:\n        return list(csv.DictReader(f))\n\nbm = load('data/kaggle/Brasileirao_Matches.csv')\nnv = load('data/kaggle/novo_campeonato_brasileiro.csv')\nbm_keys = set((r['datetime'][:10], norm(r['home_team']), norm(r['away_team'])) for r in bm if r['season']<='2019')\nnv_keys = set((r['Data'][6:]+'-'+r['Data'][3:5]+'-'+r['Data'][:2], norm(r['Equipe_mandante']), norm(r['Equipe_visitante'])) for r in nv if r['Ano']>='2012')\nprint(\"overlap after norm:\", len(bm_keys & nv_keys), \"of\", len(bm_keys), \"/\", len(nv_keys))\n\n# check score agreement on overlaps\nbm_scores = {}\nfor r in bm:\n    bm_scores[(r['datetime'][:10], norm(r['home_team']), norm(r['away_team']))] = (r['home_goal'], r['away_goal'])\nmism = 0\nfor k in (bm_keys & nv_keys):\n    if k in bm_scores: pass\nprint(\"sample intersection:\", list(bm_keys & nv_keys)[:3])\n\n# BR-Football Serie A overlap with BM after norm\nrows = load('data/kaggle/BR-Football-Dataset.csv')\nbrfa = set((r['date'], norm(r['home']), norm(r['away'])) for r in rows if r['tournament']=='Serie A')\nprint(\"BR-FA Serie A overlap with BM:\", len(brfa & bm_keys))\nEOF" action.permission=bash action.action=allow action.pattern=*
