ome_team, m.away_team):\n        records.setdefault(t, TeamRecord(t)).add_match(m, t)\ntable = sorted(records.items(), key=lambda kv: (-kv[1].points, -kv[1].wins, -kv[1].goal_diff, -kv[1].goals_for))\nfor tid, r in table[:5]:\n    print(' ', tid, r.matches, f\"{r.wins}W {r.draws}D {r.losses}L\", r.goals_for, r.goals_against, r.points)\nEOF","time":{"start":1788252289777,"end":1788252289796}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05c247742001KO8f664rUI38xX","sessionID":"ses_fa40f0460ffeYpKGnJPSwDwXVy","messageID":"msg_05c243e73001R5u5Wq1sGQ6bwk"}}
