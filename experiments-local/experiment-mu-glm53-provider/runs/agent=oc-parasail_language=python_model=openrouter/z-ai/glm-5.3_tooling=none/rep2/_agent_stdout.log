away_shots\": self.away_shots,\n            \"home_attacks\": self.home_attacks,\n            \"away_attacks\": self.away_attacks,\n            \"halftime_diff\": self.halftime_diff,\n        }"},"output":"Edit applied successfully.","metadata":{"diagnostics":{},"diff":"Index: /Users/maui/.retort/work/retort-local-x26yewvv/retort-8c2c162e81b7/soccer_mcp/models.py\n===================================================================\n--- /Users/maui/.retort/work/retort-local-x26yewvv/retort-8c2c162e81b7/soccer_mcp/models.py\n+++ /Users/maui/.retort/work/retort-local-x26yewvv/retort-8c2c162e81b7/soccer_mcp/models.py\n@@ -37,25 +37,25 @@\n     \"\"\"Extended per-match statistics (only available for BR-Football rows).\"\"\"\n \n     home_corners: Optional[int] = None\n     away_corners: Optional[int] = None\n+    total_corners: Optional[int] = None\n     home_shots: Optional[int] = None\n     away_shots: Optional[int] = None\n     home_attacks: Optional[int] = None\n     away_attacks: Optional[int] = None\n-    halftime_home: Optional[int] = None\n-    halftime_away: Optional[int] = None\n+    halftime_diff: Optional[int] = None  # home goals minus away goals at halftime\n \n     def as_dict(self) -> dict:\n         return {\n             \"home_corners\": self.home_corners,\n             \"away_corners\": self.away_corners,\n+            \"total_corners\": self.total_corners,\n             \"home_shots\": self.home_shots,\n             \"away_shots\": self.away_shots,\n             \"home_attacks\": self.home_attacks,\n             \"away_attacks\": self.away_attacks,\n-            \"halftime_home\": self.halftime_home,\n-            \"halftime_away\": self.halftime_away,\n+            \"halftime_diff\": self.halftime_diff,\n         }\n \n \n @dataclass(frozen=True)\n","filediff":{"file":"/Users/maui/.retort/work/retort-local-x26yewvv/retort-8c2c162e81b7/soccer_mcp/models.py","patch":"Index: /Users/maui/.retort/work/retort-local-x26yewvv/retort-8c2c162e81b7/soccer_mcp/