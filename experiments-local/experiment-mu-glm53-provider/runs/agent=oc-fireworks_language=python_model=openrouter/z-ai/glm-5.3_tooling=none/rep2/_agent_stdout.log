'utf-8-sig')):\n    if r['tournament'] != 'Serie A': continue\n    bfs[(base_of(r['home']), base_of(r['away']), r['date'][:4], r['date'])] = (g(r['home_goal']), g(r['away_goal']))\ncommon2 = set(br) & set(bfs)\nprint('serieA join (base,season,date):', len(common2), 'agree:', sum(1 for k in common2 if br[k]==bfs[k]))\n# how many br serie A rows have no BR-Foot counterpart (by pair+season)?\nbrp = {(k[0],k[1],k[2]) for k in br}\nbfsp = {(k[0],k[1],k[2]) for k in bfs}\nprint('br fixtures not in BR-Foot:', len(brp - bfsp), 'of', len(brp))\n\n# (c) ambiguous stateless bases in BR-Foot leagues per season\nstates = collections.defaultdict(set)   # base -> set of (uf)\nname_raw = {}\nfor r in csv.DictReader(open(base+'Brazilian_Cup_Matches.csv', encoding='utf-8-sig')):\n    for t in (r['home_team'], r['away_team']):\n        m = re.search(r'-\\s*([A-Z]{2})\\s*$', t)\n        if m: states[base_of(t)].add(m.group(1)); name_raw[base_of(t)] = t\nfor r in csv.DictReader(open(base+'Brasileirao_Matches.csv', encoding='utf-8-sig')):\n    for t in (r['home_team'], r['away_team']):\n        m = re.search(r'([A-Z]{2})$', t)\n        if m: states[base_of(t)].add(m.group(1)); name_raw[base_of(t)] = t\namb = {b for b, s in states.items() if len(s) > 1}\nprint('ambiguous bases:', sorted(amb))\ncnt = collections.Counter()\nfor r in csv.DictReader(open(base+'BR-Football-Dataset.csv', encoding='utf-8-sig')):\n    if r['tournament'] == 'Copa do Brasil': continue\n    b = base_of(r['home'])\n    if b in amb: cnt[(r['tournament'], r['date'][:4], b)] += 1\nprint('ambiguous in leagues (tournament,season,base):', sorted(cnt.items())[:30])\n\n# (d) cup final rounds per season\nfin = {}\nrows = list(csv.DictReader(open(base+'Brazilian_Cup_Matches.csv', encoding='utf-8-sig')))\nfor s in sorted({r['season'] for r in rows}):\n    sr = [r for r in rows if r['season']==s]\n    mx = max(int(r['round']) for r in sr)\n    fr = [r for r in sr if int(r['round'])==mx]\n    print('cup season', s, 'max round', m