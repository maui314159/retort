{"type":"tool_use","timestamp":1788276293502,"sessionID":"ses_fa26fadadffe2UVfX81vYXdx41","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-a8ff0e71dfcd6312","state":{"status":"completed","input":{"content":"\"\"\"Query and analysis functions backing the MCP tools.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import asdict\nfrom typing import Any\n\nfrom .loader import Match, Player, SoccerData, normalize_team\n\n_COMPETITION_ALIASES = {\n    \"brasileirao\": \"Brasileirão\",\n    \"brasileirão\": \"Brasileirão\",\n    \"serie a\": \"Brasileirão\",\n    \"série a\": \"Brasileirão\",\n    \"serie a (2003-2019)\": \"Brasileirão (2003-2019)\",\n    \"copa do brasil\": \"Copa do Brasil\",\n    \"brazilian cup\": \"Copa do Brasil\",\n    \"libertadores\": \"Copa Libertadores\",\n    \"copa libertadores\": \"Copa Libertadores\",\n}\n\n\ndef _comp_key(comp: str) -> str:\n    comp = (comp or \"\").strip().lower()\n    return _COMPETITION_ALIASES.get(comp, comp)\n\n\ndef _match_dict(m: Match) -> dict[str, Any]:\n    d = asdict(m)\n    d[\"date\"] = m.date.isoformat() if m.date else None\n    d[\"score\"] = f\"{m.home_goal}-{m.away_goal}\"\n    return d\n\n\ndef find_matches(\n    data: SoccerData,\n    team: str | None = None,\n    opponent: str | None = None,\n    competition: str | None = None,\n    season: int | None = None,\n    date_from: str | None = None,\n    date_to: str | None = None,\n    venue: str = \"any\",  # any | home | away\n    limit: int = 50,\n) -> list[dict[str, Any]]:\n    \"\"\"Find matches by team, opponent, competition, season, or date range.\"\"\"\n    team_key = normalize_team(team) if team else None\n    opp_key = normalize_team(opponent) if opponent else None\n    comp = _comp_key(competition) if competition else None\n    results = []\n    for m in data.matches:\n        if team_key:\n            if venue == \"home\" and normalize_team(m.home) != team_key:\n                continue\n            if venue == \"away\" and normalize_team(m.away) != team_key:\n                continue\n            if venue not in (\"home\", \"away\") and team_key not in (\n                normalize_team(m.home),\n                normalize_team(m.away),\n            ):\n                continue\n        if opp_key and opp_key not in (normalize_team(m.home), normalize_team(m.away)):\n            continue\n        if team_key and opp_key and normalize_team(m.home) == normalize_team(m.away):\n            continue\n        if comp and _comp_key(m.competition) != comp:\n            continue\n        if season is not None and m.season != season:\n            continue\n        if date_from and (m.date is None or m.date.isoformat() < date_from):\n            continue\n        if date_to and (m.date is None or m.date.isoformat() > date_to):\n            continue\n        results.append(m)\n    results.sort(key=lambda m: (m.date is None, m.date), reverse=True)\n    return [_match_dict(m) for m in results[:limit]]\n\n\ndef _record(matches: list[Match], team_key: str) -> dict[str, Any]:\n    wins = draws = losses = gf = ga = 0\n    home_matches = away_matches = 0\n    for m in matches:\n        if normalize_team(m.home) == team_key:\n            home_matches += 1\n            gf += m.home_goal\n            ga += m.away_goal\n            if m.home_goal > m.away_goal:\n                wins += 1\n            elif m.home_goal == m.away_goal:\n                draws += 1\n            else:\n                losses += 1\n        else:\n            away_matches += 1\n            gf += m.away_goal\n            ga += m.home_goal\n            if m.away_goal > m.home_goal:\n                wins += 1\n            elif m.home_goal == m.away_goal:\n                draws += 1\n            else:\n                losses += 1\n    total = wins + draws + losses\n    return {\n        \"matches\": total,\n        \"wins\": wins,\n        \"draws\": draws,\n        \"losses\": losses,\n        \"goals_for\": gf,\n        \"goals_against\": ga,\n        \"home_matches\": home_matches,\n        \"away_matches\": away_matches,\n        \"win_rate\": round(wins / total * 100, 1) if total else 0.0,\n    }\n\n\ndef team_stats(\n    data: SoccerData,\n    team: str,\n    season: int | None = None,\n    competition: str | None = None,\n    venue: str = \"any\",\n) -> dict[str, Any]:\n    \"\"\"Win/loss/draw record, goals, and per-venue split for a team.\"\"\"\n    team_key = normalize_team(team)\n    comp = _comp_key(competition) if competition else None\n    matches = []\n    for m in data.matches_for_team(team):\n        if season is not None and m.season != season:\n            continue\n        if comp and _comp_key(m.competition) != comp:\n            continue\n        if venue == \"home\" and normalize_team(m.home) != team_key:\n            continue\n        if venue == \"away\" and normalize_team(m.away) != team_key:\n            continue\n        matches.append(m)\n    display = data.resolve_team(team) or team\n    overall = _record(matches, team_key)\n    home_only = [m for m in matches if normalize_team(m.home) == team_key]\n    away_only = [m for m in matches if normalize_team(m.away) == team_key]\n    return {\n        \"team\": display,\n        \"season\": season,\n        \"competition\": competition,\n        \"venue\": venue,\n        \"overall\": overall,\n        \"home\": _record(home_only, team_key),\n        \"away\": _record(away_only, team_key),\n    }\n\n\ndef head_to_head(\n    data: SoccerData,\n    team: str,\n    opponent: str,\n    competition: str | None = None,\n    limit: int = 200,\n) -> dict[str, Any]:\n    \"\"\"Head-to-head record between two teams across the dataset.\"\"\"\n    team_key = normalize_team(team)\n    opp_key = normalize_team(opponent)\n    comp = _comp_key(competition) if competition else None\n    matches = [\n        m\n        for m in data.matches\n        if {normalize_team(m.home), normalize_team(m.away)} == {team_key, opp_key}\n        and (comp is None or _comp_key(m.competition) == comp)\n    ]\n    matches.sort(key=lambda m: (m.date is None, m.date))\n    team_wins = opp_wins = draws = 0\n    for m in matches:\n        winner = m.winner\n        if winner == \"draw\":\n            draws += 1\n        elif winner == \"home\":\n            team_wins += 1 if normalize_team(m.home) == team_key else 0\n            opp_wins += 1 if normalize_team(m.home) == opp_key else 0\n        else:\n            team_wins += 1 if normalize_team(m.away) == team_key else 0\n            opp_wins += 1 if normalize_team(m.away) == opp_key else 0\n    return {\n        \"team\": data.resolve_team(team) or team,\n        \"opponent\": data.resolve_team(opponent) or opponent,\n        \"competition\": competition,\n        \"total_matches\": len(matches),\n        \"team_wins\": team_wins,\n        \"opponent_wins\": opp_wins,\n        \"draws\": draws,\n        \"matches\": [_match_dict(m) for m in matches[-limit:]],\n    }\n\n\ndef standings(\n    data: SoccerData,\n    season: int,\n    competition: str = \"Brasileirão\",\n) -> list[dict[str, Any]]:\n    \"\"\"League table computed from match results (3 points per win).\"\"\"\n    comp = _comp_key(competition)\n    table: dict[str, dict[str, Any]] = {}\n    for m in data.matches:\n        if m.season != season or _comp_key(m.competition) != comp:\n            continue\n        for name in (m.home, m.away):\n            key = normalize_team(name)\n            if key not in table:\n                table[key] = {\n                    \"team\": name,\n                    \"points\": 0,\n                    \"wins\": 0,\n                    \"draws\": 0,\n                    \"losses\": 0,\n                    \"goals_for\": 0,\n                    \"goals_against\": 0,\n                }\n        h = table[normalize_team(m.home)]\n        a = table[normalize_team(m.away)]\n        h[\"goals_for\"] += m.home_goal\n        h[\"goals_against\"] += m.away_goal\n        a[\"goals_for\"] += m.away_goal\n        a[\"goals_against\"] += m.home_goal\n        if m.home_goal > m.away_goal:\n            h[\"points\"] += 3\n            h[\"wins\"] += 1\n            a[\"losses\"] += 1\n        elif m.home_goal < m.away_goal:\n            a[\"points\"] += 3\n            a[\"wins\"] += 1\n            h[\"losses\"] += 1\n        else:\n            h[\"points\"] += 1\n            a[\"points\"] += 1\n            h[\"draws\"] += 1\n            a[\"draws\"] += 1\n    rows = list(table.values())\n    for row in rows:\n        row[\"goal_diff\"] = row[\"goals_for\"] - row[\"goals_against\"]\n        row[\"matches\"] = row[\"wins\"] + row[\"draws\"] + row[\"losses\"]\n    rows.sort(key=lambda r: (-r[\"points\"], -r[\"goal_diff\"], -r[\"goals_for\"]))\n    return rows\n\n\ndef biggest_wins(\n    data: SoccerData,\n    competition: str | None = None,\n    season: int | None = None,\n    limit: int = 10,\n) -> list[dict[str, Any]]:\n    \"\"\"Largest goal-margin victories in the dataset.\"\"\"\n    comp = _comp_key(competition) if competition else None\n    matches = [\n        m\n        for m in data.matches\n        if (comp is None or _comp_key(m.competition) == comp)\n        and (season is None or m.season == season)\n    ]\n    matches.sort(key=lambda m: abs(m.home_goal - m.away_goal), reverse=True)\n    out = []\n    for m in matches[:limit]:\n        out.append({**_match_dict(m), \"margin\": abs(m.home_goal - m.away_goal)})\n    return out\n\n\ndef average_goals(\n    data: SoccerData,\n    competition: str | None = None,\n    season: int | None = None,\n) -> dict[str, Any]:\n    \"\"\"Average goals per match and home/away win rates.\"\"\"\n    comp = _comp_key(competition) if competition else None\n    matches = [\n        m\n        for m in data.matches\n        if (comp is None or _comp_key(m.competition) == comp)\n        and (season is None or m.season == season)\n    ]\n    if not matches:\n        return {\"matches\": 0}\n    goals = sum(m.home_goal + m.away_goal for m in matches)\n    home_wins = sum(1 for m in matches if m.winner == \"home\")\n    away_wins = sum(1 for m in matches if m.winner == \"away\")\n    draws = sum(1 for m in matches if m.winner == \"draw\")\n    n = len(matches)\n    return {\n        \"matches\": n,\n        \"total_goals\": goals,\n        \"avg_goals_per_match\": round(goals / n, 2),\n        \"home_win_rate\": round(home_wins / n * 100, 1),\n        \"away_win_rate\": round(away_wins / n * 100, 1),\n        \"draw_rate\": round(draws / n * 100, 1),\n    }\n\n\ndef search_players(\n    data: SoccerData,\n    name: str | None = None,\n    nationality: str | None = None,\n    club: str | None = None,\n    position: str | None = None,\n    min_overall: int | None = None,\n    max_overall: int | None = None,\n    sort_by_rating: bool = True,\n    limit: int = 25,\n) -> list[dict[str, Any]]:\n    \"\"\"Search FIFA player data by name, nationality, club, position, rating.\"\"\"\n    results: list[Player] = []\n    name_q = normalize_team(name or \"\") if name else None\n    nationality_q = (nationality or \"\").strip().lower()\n    club_q = normalize_team(club) if club else None\n    position_q = (position or \"\").strip().upper()\n    for p in data.players:\n        if name_q and name_q not in normalize_team(p.name):\n            continue\n        if nationality_q and p.nationality.strip().lower() != nationality_q:\n            continue\n        if club_q and club_q not in normalize_team(p.club):\n            continue\n        if position_q and p.position.strip().upper() != position_q:\n            continue\n        if min_overall is not None and p.overall < min_overall:\n            continue\n        if max_overall is not None and p.overall > max_overall:\n            continue\n        results.append(p)\n    if sort_by_rating:\n        results.sort(key=lambda p: (-p.overall, p.name))\n    return [asdict(p) for p in results[:limit]]\n\n\n# Known Brazilian clubs to map FIFA club names against match data.\nBRAZILIAN_CLUBS = [\n    \"Flamengo\", \"Palmeiras\", \"Corinthians\", \"São Paulo\", \"Santos\",\n    \"Grêmio\", \"Internacional\", \"Fluminense\", \"Atlético Mineiro\",\n    \"Cruzeiro\", \"Vasco da Gama\", \"Botafogo\", \"Bahia\", \"Sport Recife\",\n    \"Fortaleza\", \"Athletico Paranaense\", \"Goiás\", \"Coritiba\", \"Ceará\",\n    \"Chapecoense\", \"Avaí\", \"Bragantino\", \"Cuiabá\", \"Juventude\",\n    \"Atlético Goianiense\", \"América Mineiro\", \"Vitória\", \"Ponte Preta\",\n]\n\n\ndef brazilian_club_summary(data: SoccerData) -> list[dict[str, Any]]:\n    \"\"\"Count and average rating of players per Brazilian club (cross-file query).\"\"\"\n    out = []\n    for club in BRAZILIAN_CLUBS:\n        squad = data.players_at_club(club)\n        if squad:\n            out.append(\n                {\n                    \"club\": club,\n                    \"players\": len(squad),\n                    \"avg_rating\": round(\n                        sum(p.overall for p in squad) / len(squad), 1\n                    ),\n                }\n            )\n    out.sort(key=lambda r: -r[\"players\"])\n    return out\n","filePath":"/Users/maui/.retort/work/retort-local-hsquwan9/retort-2debf171a916/brazilian_soccer/analysis.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/maui/.retort/work/retort-local-hsquwan9/retort-2debf171a916/brazilian_soccer/analysis.py","exists":false,"truncated":false},"title":"brazilian_soccer/analysis.py","time":{"start":1788276293495,"end":1788276293500}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05d920d38001TneZeBZcEMfDIJ","sessionID":"ses_fa26fadadffe2UVfX81vYXdx41","messageID":"msg_05d91f2f1001HC6ki5pmq76luT"}}
