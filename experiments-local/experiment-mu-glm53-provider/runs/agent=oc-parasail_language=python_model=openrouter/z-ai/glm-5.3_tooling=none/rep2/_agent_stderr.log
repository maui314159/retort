timestamp=2026-09-01T05:09:03.083Z level=INFO run=7ae6fc3c message=evaluated permission=bash pattern="python - <<'EOF'\nimport csv, re, unicodedata, collections\n\ndef deacc(s):\n    return ''.join(c for c in unicodedata.normalize('NFKD', s) if not unicodedata.combining(c))\n\ndef norm(s):\n    s = deacc(s).lower()\n    s = re.sub(r'\\(.*?\\)', ' ', s)          # drop parentheticals\n    s = re.sub(r'\\s*-\\s*([a-z]{2})$', '', s) # trailing -UF\n    s = re.sub(r'[^a-z0-9]+', ' ', s)\n    return ' '.join(s.split())\n\np='data/kaggle/'\nallteams = collections.Counter()\nfor fn, cols in [('Brasileirao_Matches.csv',('home_team','away_team')),\n                 ('Brazilian_Cup_Matches.csv',('home_team','away_team')),\n                 ('Libertadores_Matches.csv',('home_team','away_team')),\n                 ('BR-Football-Dataset.csv',('home','away'))]:\n    with open(p+fn, encoding='utf-8') as f:\n        for r in csv.DictReader(f):\n            for c in cols: allteams[norm(r[c])] += 1\nwith open(p+'novo_campeonato_brasileiro.csv', encoding='utf-8') as f:\n    for r in csv.DictReader(f):\n        allteams[norm(r['Equipe_mandante'])] += 1\n        allteams[norm(r['Equipe_visitante'])] += 1\nprint(\"distinct normalized:\", len(allteams))\n# Show groups that might need merging: focus on big Brazilian clubs\nfor k in sorted(allteams):\n    if any(t in k for t in ['palmeiras','flamengo','corinthians','sao paulo','santos','gremio','cruzeiro','atletico','athletico','internacional','vasco','botafogo','fluminense','bahia','sport','vitoria','ceara','fortaleza','goias','parana','chapecoense','avai','ponte preta','america','bragantino','gremio']):\n        print(f\"{allteams[k]:5d}  {k}\")\nEOF" action.permission=bash action.action=allow action.pattern=*
