timestamp=2026-08-01T02:19:46.978Z level=INFO run=645559e9 message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport json, subprocess, sys\n\nproc = subprocess.Popen(\n    [sys.executable, \"server.py\"],\n    stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,\n    text=True, bufsize=1,\n)\n\ndef rpc(msg_id, method, params=None):\n    proc.stdin.write(json.dumps({\"jsonrpc\": \"2.0\", \"id\": msg_id, \"method\": method, \"params\": params or {}}) + \"\\n\")\n    proc.stdin.flush()\n    return json.loads(proc.stdout.readline())\n\n# initialize handshake\nresp = rpc(1, \"initialize\", {\n    \"protocolVersion\": \"2024-11-05\",\n    \"capabilities\": {},\n    \"clientInfo\": {\"name\": \"smoke-test\", \"version\": \"0.1\"},\n})\nassert \"result\" in resp, resp\nprint(\"initialize OK:\", resp[\"result\"][\"serverInfo\"])\nproc.stdin.write(json.dumps({\"jsonrpc\": \"2.0\", \"method\": \"notifications/initialized\"}) + \"\\n\")\nproc.stdin.flush()\n\nresp = rpc(2, \"tools/list\")\ntools = [t[\"name\"] for t in resp[\"result\"][\"tools\"]]\nprint(f\"tools/list OK: {len(tools)} tools\")\n\nresp = rpc(3, \"tools/call\", {\"name\": \"last_match\", \"arguments\": {\"team1\": \"Flamengo\", \"team2\": \"Corinthians\"}})\ntext = resp[\"result\"][\"content\"][0][\"text\"]\nprint(\"last_match:\", text.replace(chr(10), \" | \"))\n\nresp = rpc(4, \"tools/call\", {\"name\": \"standings\", \"arguments\": {\"season\": 2019}})\nfirst_line = resp[\"result\"][\"content\"][0][\"text\"].split(\"\\n\")[1]\nprint(\"standings 2019:\", first_line)\n\nproc.terminate()\nproc.wait(timeout=10)\nprint(\"STDIO SMOKE TEST PASSED\")\nEOF" action.permission=bash action.action=allow action.pattern=*
