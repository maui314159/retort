timestamp=2026-06-22T00:06:36.836Z level=INFO run=ac7dc745 message=evaluated permission=bash pattern="python3 << 'EOF'\nimport pandas as pd\nimport re, unicodedata\nbase='data/kaggle/'\nallteams=set()\ndf=pd.read_csv(base+'Brasileirao_Matches.csv')\nfor c in ['home_team','away_team']: allteams|=set(df[c].dropna().unique())\ndf=pd.read_csv(base+'Brazilian_Cup_Matches.csv')\nfor c in ['home_team','away_team']: allteams|=set(df[c].dropna().unique())\ndf=pd.read_csv(base+'Libertadores_Matches.csv')\nfor c in ['home_team','away_team']: allteams|=set(df[c].dropna().unique())\ndf=pd.read_csv(base+'BR-Football-Dataset.csv')\nfor c in ['home','away']: allteams|=set(df[c].dropna().unique())\ndf=pd.read_csv(base+'novo_campeonato_brasileiro.csv')\nfor c in ['Equipe_mandante','Equipe_visitante']: allteams|=set(df[c].dropna().unique())\nprint('total unique team strings:', len(allteams))\n# group by a crude key: strip accents, remove parens, lower, strip trailing -XX\ndef key(n):\n    n=re.sub(r'\\([^)]*\\)','',n)\n    n=''.join(c for c in unicodedata.normalize('NFKD',n) if not unicodedata.combining(c))\n    n=n.lower()\n    n=n.strip()\n    return n\nfrom collections import defaultdict\ng=defaultdict(list)\nfor t in sorted(allteams):\n    g[key(t)].append(t)\n#print groups with >1 member (the interesting ones)\ncnt=0\nfor k,v in sorted(g.items()):\n    if len(v)>1:\n        print(f'[{k}] -> {v[:6]}')\n        cnt+=1\nprint('groups with >1:',cnt)\n# print all keys compactly\nprint('ALL KEYS:', sorted(g.keys()))\nEOF" action.permission=bash action.action=allow action.pattern=*
