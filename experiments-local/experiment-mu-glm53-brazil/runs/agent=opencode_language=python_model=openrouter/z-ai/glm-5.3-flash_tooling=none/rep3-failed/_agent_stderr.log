timestamp=2026-08-31T19:26:30.445Z level=INFO run=532d90f3 message=evaluated permission=bash pattern="venv/bin/python -c \"\nfrom bsoccer.data_loader import load_all\nfrom collections import defaultdict\nmatches, players = load_all()\n# group raw spellings by canonical to spot bad merges\ngroups = defaultdict(set)\nfor m in matches:\n    groups[m.home].add(m.home_raw)\n    groups[m.away].add(m.away_raw)\nsuspicious = {k: sorted(v) for k,v in groups.items() if len(v)>1}\nprint('canonicals with multiple raw spellings:', len(suspicious))\nfor k,v in sorted(suspicious.items()): print(repr(k), '->', v)\n\" 2>&1" action.permission=bash action.action=allow action.pattern=*
