if hg<ag: t[a]['p']+=3;t[h]['gf']+=hg;t[h]['ga']+=ag;t[a]['ga']+=hg;t[a]['gf']+=ag\n        else: t[h]['p']+=1;t[a]['p']+=1;t[h]['gf']+=hg;t[h]['ga']+=ag;t[a]['gf']+=ag;t[a]['ga']+=hg\n    return sorted(t.items(), key=lambda kv:(-kv[1]['p'],-kv[1]['gf']))\nst22 = table(a22)\nprint(\"2022 BRF top2:\", [(t,e['p']) for t,e in st22[:2]], \"bottom4:\", [(t,e['p']) for t,e in st22[-4:]], \"teams:\", len(st22))\n\nnv = load('data/kaggle/novo_campeonato_brasileiro.csv')\nallm = []\nfor r in bm:\n    if r['season']>='2012':\n        allm.append((r['datetime'][:10], canon(r['home_team'])[0], canon(r['away_team'])[0], r['home_goal'], r['away_goal']))\nfor r in nv:\n    if r['Ano']<'2012':\n        allm.append((r['Data'][6:]+'-'+r['Data'][3:5]+'-'+r['Data'][:2], canon(r['Equipe_mandante'])[0], canon(r['Equipe_visitante'])[0], r['Gols_mandante'], r['Gols_visitante']))\nfor r in [r for r in brf if r['tournament']=='Serie A' and r['date'][:4]=='2023']:\n    allm.append((r['date'], canon(r['home'])[0], canon(r['away'])[0], str(int(float(r['home_goal']))), str(int(float(r['away_goal'])))))\ndef is_ff(h,a): return {h,a}=={'flamengo','fluminense'}\nff=[m for m in allm if is_ff(m[1],m[2]) and m[3] not in ('NA','','-')]\nfw=fld=d=0\nfor m in ff:\n    h,a,hg,ag=m[1],m[2],int(m[3]),int(m[4])\n    if hg>ag: fw += 1 if h=='flamengo' else 0; fld += 1 if a=='flamengo' else 0\n    elif hg<ag: fld += 1 if h=='flamengo' else 0; fw += 1 if a=='flamengo' else 0\n    else: d+=1\nprint(\"Fla-Flu Brasileirao 2003-2023:\", len(ff), \"| Flamengo:\", fw, \"Fluminense:\", fld, \"Draws:\", d)\nEOF" action.permission=bash action.action=allow action.pattern=*
