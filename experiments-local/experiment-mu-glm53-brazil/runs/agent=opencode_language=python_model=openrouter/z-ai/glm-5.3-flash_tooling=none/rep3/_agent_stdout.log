{"type":"tool_use","timestamp":1788233855360,"sessionID":"ses_fa52b88b3ffeUF09L5H3uZ1cg4","part":{"type":"tool","tool":"write","callID":"call_7d1b056d37b34c5b943cc686","state":{"status":"completed","input":{"content":"\"\"\"BDD step definitions for the Data Quality feature.\"\"\"\n\nfrom __future__ import annotations\n\nimport pytest\nfrom pytest_bdd import given, parsers, scenarios, when, then\n\nscenarios(\"../features/data_quality.feature\")\n\n\n@given(\"the team registry is finalized\")\ndef registry_ready(store):\n    return store.registry\n\n\n@given(parsers.parse('a Brazilian formatted date \"{raw}\"'))\ndef brazilian_date(raw):\n    return {\"raw\": raw}\n\n\n@given(parsers.parse('an ISO datetime \"{raw}\"'))\ndef iso_datetime(raw):\n    return {\"raw\": raw}\n\n\n@given(\"the store is loaded\")\ndef loaded_store(store):\n    return store\n\n\n@when(parsers.parse('I resolve \"{name_a}\" and \"{name_b}\"'))\ndef resolve_two(store, name_a, name_b):\n    return {\"a\": store.resolve_team(name_a), \"b\": store.resolve_team(name_b)}\n\n\n@when(\"I check the display names\")\ndef check_displays(store):\n    return {\"displays\": set(store.registry.display_names().values())}\n\n\n@when(parsers.parse('I query the FIFA club \"{club}\"'))\ndef query_fifa_club(store, club):\n    key = store.resolve_team(club)\n    return {\n        \"key\": key,\n        \"match_count\": len(store.matches_by_team.get(key, [])),\n        \"player_count\": len(store.players_by_club.get(key, [])),\n    }\n\n\n@then(\"both names should resolve to the same club\")\ndef assert_same_club(resolved):\n    assert resolved[\"a\"] == resolved[\"b\"]\n\n\n@then(\"the names should resolve to different clubs\")\ndef assert_different_clubs(resolved):\n    assert resolved[\"a\"] != resolved[\"b\"]\n\n\n@when(\"I parse the date\")\ndef parse_the_date(request):\n    return {\"date\": _parse(request)}\n\n\ndef _parse(request):\n    # pull the raw value from the given step fixture by scenario intent\n    raw = request.getfixturevalue(\"brazilian_date\") if \\\n        \"brazilian_date\" in request.fixturenames else \\\n        request.getfixturevalue(\"iso_datetime\")\n    from brazilian_soccer.normalize import parse_date\n    return parse_date(raw[\"raw\"])\n\n\n@then(parsers.parse(\"the parsed date should be {expected}\"))\ndef assert_parsed_date(parsed, expected):\n    assert str(parsed[\"date\"]) == expected\n\n\n@then(parsers.parse('the names \"{n1}\", \"{n2}\" and \"{n3}\" should be present'))\ndef assert_utf8_names(checked, n1, n2, n3):\n    for name in (n1, n2, n3):\n        assert name in checked[\"displays\"], f\"{name} not in display names\"\n\n\n@then(\"the players should link to the same club that appears in match data\")\ndef assert_cross_file_link(queried):\n    assert queried[\"player_count\"] > 0, \"expected FIFA players for the club\"\n    assert queried[\"match_count\"] > 0, \"expected matches for the same club key\"\n","filePath":"/Users/maui/.retort/work/retort-local-0bivsr25/retort-e0c09c17c08e/tests/step_defs/test_data_quality.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/maui/.retort/work/retort-local-0bivsr25/retort-e0c09c17c08e/tests/step_defs/test_data_quality.py","exists":false,"truncated":false},"title":"tests/step_defs/test_data_quality.py","time":{"start":1788233855349,"end":1788233855359}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05b0b316f001GeUbNE6136dzxA","sessionID":"ses_fa52b88b3ffeUF09L5H3uZ1cg4","messageID":"msg_05b0af5e9001tTEB1Vpau40EZa"}}
