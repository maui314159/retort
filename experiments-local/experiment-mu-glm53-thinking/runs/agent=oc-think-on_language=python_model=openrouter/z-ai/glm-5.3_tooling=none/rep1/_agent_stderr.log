timestamp=2026-09-01T15:26:43.971Z level=INFO run=ec76643f message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, re, unicodedata\nfrom collections import Counter\n\ndef load(path):\n    with open(path, encoding='utf-8-sig') as f:\n        return list(csv.DictReader(f))\n\ndef fold(s):\n    s = unicodedata.normalize('NFKD', s)\n    s = ''.join(c for c in s if not unicodedata.combining(c))\n    return re.sub(r'[^a-z0-9]+', ' ', s.lower()).strip()\n\nUF = {'SP','RJ','MG','PR','RS','SC','BA','PE','CE','GO','AL','PB','RN','PA','MA','PI','ES','MT','MS','DF','SE','TO','RO','AC','AM','AP','RR'}\ndef key(name):\n    s = re.sub(r'\\(.*?\\)', ' ', name)          # parentheticals\n    toks = s.replace('-', ' ').split()\n    toks = [t for t in toks if t.upper() not in UF and len(t) <= 3 and t.isupper() is False or t.lower() in ('spfc',)] # rough\n    # simpler: drop trailing uppercase 2-3 letter tokens\n    out = []\n    for t in s.replace('-', ' ').split():\n        out.append(t)\n    while out and out[-1].isupper() and 2 <= len(out[-1]) <= 3:\n        out.pop()\n    return fold(' '.join(out))\n\nbr = load('data/kaggle/BR-Football-Dataset.csv')\nbm = load('data/kaggle/Brasileirao_Matches.csv')\n\n# 2019 Serie A in both files?\ns1 = {(r['date'], key(r['home']), key(r['away'])) for r in br if r['tournament']=='Serie A' and r['date'].startswith('2019')}\ns2 = {(r['datetime'][:10], key(r['home_team']), key(r['away_team'])) for r in bm if r['season']=='2019'}\nprint(\"BR-Football 2019 Serie A:\", len(s1), \" Brasileirao file 2019:\", len(s2), \" overlap:\", len(s1 & s2))\ndiff = list(s2 - s1)[:5]\nprint(\"in Brasileirao not in BR-Football:\", diff)\n\n# Athletico bare in Libertadores\nlib = load('data/kaggle/Libertadores_Matches.csv')\nfor r in lib:\n    if r['home_team'].strip() == 'Athletico' or r['away_team'].strip() == 'Athletico':\n        print(\"Athletico row:\", r['season'], r['home_team'], r['away_team'], r['stage'])\nEOF" action.permission=bash action.action=allow action.pattern=*
