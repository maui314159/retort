{
  "name": "brazilian-soccer-mcp",
  "version": "1.0.0",
  "description": "MCP server exposing a knowledge graph over Brazilian soccer datasets (Brasileirão, Copa do Brasil, Libertadores, historical matches, FIFA players).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "brazilian-soccer-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "csv-parse": "^5.6.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
