timestamp=2026-09-01T13:33:35.612Z level=INFO run=d0d26016 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv\ndef teams(path, cols):\n    with open(path, encoding='utf-8') as f:\n        rows = list(csv.DictReader(f))\n    s = set()\n    for r in rows:\n        for c in cols: s.add(r[c])\n    return s\n\ncup = teams('data/kaggle/Brazilian_Cup_Matches.csv', ['home_team'])\n# only show teams that contain famous names or are in later rounds\nfamous = ['Flamengo','Palmeiras','Corinthians','São Paulo','Sao Paulo','Santos','Grêmio','Gremio','Vasco','Cruzeiro','Atlético','Atletico','Athletico','Fluminense','Botafogo','Bahia','Vitória','Sport','Internacional','Ceará','Ceara']\nprint(\"== Cup famous teams ==\")\nfor t in sorted(cup):\n    if any(f in t for f in famous): print(repr(t))\n\nlib = teams('data/kaggle/Libertadores_Matches.csv', ['home_team'])\nprint(\"\\n== Libertadores famous/Brazilian teams ==\")\nfor t in sorted(lib):\n    if any(f in t for f in famous): print(repr(t))\n\nbrf = teams('data/kaggle/BR-Football-Dataset.csv', ['home'])\nprint(\"\\n== BR-Football famous teams (Serie A only) ==\")\nwith open('data/kaggle/BR-Football-Dataset.csv', encoding='utf-8') as f:\n    rows = list(csv.DictReader(f))\nsa = set(r['home'] for r in rows if r['tournament']=='Serie A')\nfor t in sorted(sa):\n    if any(f in t for f in famous): print(repr(t))\nEOF" action.permission=bash action.action=allow action.pattern=*
