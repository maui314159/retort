timestamp=2026-09-01T14:56:32.922Z level=INFO run=bd57de6d message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nfrom brazilian_soccer.data import load_dataset\nfrom brazilian_soccer import query\n\nds = load_dataset()\n\nr = query.champion(ds, \"Libertadores\", 2019)\nprint(\"lib 2019:\", r[\"champion\"], \"|\", r[\"method\"], \"|\", r[\"goals_a\"], r[\"goals_b\"])\n\nr = query.champion(ds, \"Copa do Brasil\", 2020)\nprint(\"copa 2020:\", r[\"champion\"], r[\"goals_a\"], \"-\", r[\"goals_b\"])\n\nr = query.champion(ds, \"Copa do Brasil\", 2015)\nprint(\"copa 2015:\", r[\"champion\"], \"|\", r[\"method\"])\n\nr = query.champion(ds, \"Copa do Brasil\", 2021)\nprint(\"copa 2021:\", r.get(\"champion\"), \"|\", r.get(\"note\"))\n\nr = query.champion(ds, \"Libertadores\", 2013)\nprint(\"lib 2013:\", r[\"champion\"], \"|\", r[\"method\"])\n\nr = query.average_goals(ds, competition=\"Brasileirão\")\nprint(\"avg goals serie A:\", r[\"matches\"], r[\"avg_goals\"], r[\"home_win_rate\"])\n\nr = query.biggest_wins(ds, limit=3)\nfor w in r[\"wins\"]: print(\"big:\", w[\"date\"], w[\"home\"], w[\"home_goals\"], \"-\", w[\"away_goals\"], w[\"away\"], f\"({w['competition']})\")\n\nr = query.search_players(ds, name=\"Neymar\")\nprint(\"neymar:\", r[\"players\"][0][\"name\"], r[\"players\"][0][\"overall\"], r[\"players\"][0][\"club\"])\n\nr = query.top_players(ds, club=\"Grêmio\", limit=3)\nfor p in r[\"players\"]: print(\"gremio:\", p[\"name\"], p[\"overall\"], p[\"position\"])\n\nr = query.players_by_club(ds)\nprint(\"brazilians at BR clubs:\", [(c[\"club\"], c[\"players\"], c[\"avg_overall\"]) for c in r[\"clubs\"][:5]])\n\nr = query.derbies(ds, season=2023, limit=5)\nprint(\"derbies 2023:\", r[\"total\"])\nfor m in r[\"matches\"][:3]: print(\"  \", m[\"derby\"], m[\"date\"], m[\"home\"], m[\"home_goals\"], \"-\", m[\"away_goals\"], m[\"away\"])\n\nr = query.last_match_between(ds, \"Flamengo\", \"Corinthians\")\nprint(\"last fla-cor:\", r[\"match\"][\"date\"], r[\"match\"][\"home\"], r[\"match\"][\"home_goals\"], \"-\", r[\"match\"][\"away_goals\"], r[\"match\"][\"away\"])\n\nr = query.season_comparison(ds, \"Serie A\", 2018, 2019)\nprint(\"comparison:\", r[\"seasons\"][0][\"champion\"], \"vs\", r[\"seasons\"][1][\"champion\"])\n\nr = query.team_competitions(ds, \"Palmeiras\")\nprint(\"palmeiras comps:\", [(c[\"competition\"], c[\"matches\"], c[\"first_season\"], c[\"last_season\"]) for c in r[\"competitions\"]])\n\nr = query.bracket(ds, \"Libertadores\", 2018)\nfor rd in r[\"rounds\"]: print(\"bracket:\", rd[\"stage\"], [(t[\"team_a\"], t[\"team_b\"], t[\"aggregate\"], t[\"winner\"]) for t in rd[\"ties\"]])\n\nr = query.best_records(ds, competition=\"Serie A\", season=2023, venue=\"away\", limit=3)\nprint(\"best away 2023:\", [(x[\"team\"], x[\"win_rate\"]) for x in r[\"records\"]])\n\nr = query.search_matches(ds, team=\"Palmeiras\", season=2023, limit=5)\nprint(\"palmeiras 2023:\", r[\"total\"])\n\nr = query.team_profile(ds, \"Grêmio\")\nprint(\"gremio profile:\", r[\"record\"], \"players:\", r[\"players_at_club\"], [p[\"name\"] for p in r[\"top_players\"][:3]])\n\nr = query.competition_overview(ds)\nprint(\"overview:\", [(c[\"competition\"], c[\"matches\"], c[\"first_season\"], c[\"last_season\"]) for c in r[\"competitions\"]])\n\n# error handling\ntry:\n    query.resolve_team(ds, \"atletico\")\nexcept query.AmbiguousTeamError as e:\n    print(\"ambiguous ok:\", e.candidates[:4])\ntry:\n    query.resolve_team(ds, \"xyzzy\")\nexcept query.TeamNotFoundError:\n    print(\"not found ok\")\ntry:\n    query.standings(ds, \"Copa do Brasil\", 2019)\nexcept query.QueryError as e:\n    print(\"cup standings error ok:\", str(e)[:60])\nr = query.search_matches(ds, stage=\"final\", competition=\"Copa do Brasil\", limit=5)\nprint(\"copa finals:\", r[\"total\"], [f\"{m['season']} {m['home']} {m['home_goals']}-{m['away_goals']} {m['away']}\" for m in r[\"matches\"][:4]])\nEOF" action.permission=bash action.action=allow action.pattern=*
