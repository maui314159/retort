{"type":"tool_use","timestamp":1785550801418,"sessionID":"ses_045020059ffetDN2TLGi6CMad5","part":{"type":"tool","tool":"bash","callID":"bash_138","state":{"status":"completed","input":{"command":"python3 -c \"\nimport time\nfrom soccer_mcp.data import get_store\nfrom soccer_mcp import queries as q\ns = get_store()  # warm (one-time ~0.6s load)\nt0 = time.time(); s2 = get_store(); print(f'cached get_store: {time.time()-t0*1:.4f}s' if False else '')\n\nbench = [\n    ('simple lookup: search_matches', lambda: q.search_matches(s, team='Flamengo', opponent='Fluminense')),\n    ('simple lookup: last_match', lambda: q.last_match(s, 'Flamengo', 'Corinthians')),\n    ('simple lookup: player_profile', lambda: q.player_profile(s, 'Gabriel Jesus')),\n    ('aggregate: standings 2019', lambda: q.standings(s, 2019)),\n    ('aggregate: competition_stats all', lambda: q.competition_stats(s)),\n    ('aggregate: biggest_wins all', lambda: q.biggest_wins(s)),\n    ('aggregate: top_players Brazil', lambda: q.top_players(s, nationality='Brazil')),\n]\nfor name, fn in bench:\n    t0 = time.perf_counter(); fn(); dt = time.perf_counter()-t0\n    print(f'{dt*1000:8.1f} ms  {name}')\n\""},"output":"\n    12.1 ms  simple lookup: search_matches\n    19.8 ms  simple lookup: last_match\n     1.0 ms  simple lookup: player_profile\n     6.3 ms  aggregate: standings 2019\n     1.6 ms  aggregate: competition_stats all\n     4.6 ms  aggregate: biggest_wins all\n     2.1 ms  aggregate: top_players Brazil\n","metadata":{"output":"\n    12.1 ms  simple lookup: search_matches\n    19.8 ms  simple lookup: last_match\n     1.0 ms  simple lookup: player_profile\n     6.3 ms  aggregate: standings 2019\n     1.6 ms  aggregate: competition_stats all\n     4.6 ms  aggregate: biggest_wins all\n     2.1 ms  aggregate: top_players Brazil\n","exit":0,"truncated":false},"title":"python3 -c \"\nimport time\nfrom soccer_mcp.data import get_store\nfrom soccer_mcp import queries as q\ns = get_store()  # warm (one-time ~0.6s load)\nt0 = time.time(); s2 = get_store(); print(f'cached get_store: {time.time()-t0*1:.4f}s' if False else '')\n\nbench = [\n    ('simple lookup: search_matches', lambda: q.search_matches(s, team='Flamengo', opponent='Fluminense')),\n    ('simple lookup: last_match', lambda: q.last_match(s, 'Flamengo', 'Corinthians')),\n    ('simple lookup: player_profile', lambda: q.player_profile(s, 'Gabriel Jesus')),\n    ('aggregate: standings 2019', lambda: q.standings(s, 2019)),\n    ('aggregate: competition_stats all', lambda: q.competition_stats(s)),\n    ('aggregate: biggest_wins all', lambda: q.biggest_wins(s)),\n    ('aggregate: top_players Brazil', lambda: q.top_players(s, nationality='Brazil')),\n]\nfor name, fn in bench:\n    t0 = time.perf_counter(); fn(); dt = time.perf_counter()-t0\n    print(f'{dt*1000:8.1f} ms  {name}')\n\"","time":{"start":1785550801389,"end":1785550801417}},"id":"prt_fbb1eed62001IPjwFffmVUbpaB","sessionID":"ses_045020059ffetDN2TLGi6CMad5","messageID":"msg_fbb1ed7cc001qEH2RkyvPHY41J"}}
