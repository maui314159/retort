timestamp=2026-09-01T13:32:40.039Z level=INFO run=d0d26016 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv\nwith open('data/kaggle/Brazilian_Cup_Matches.csv', encoding='utf-8') as f:\n    rows = list(csv.DictReader(f))\n# 2021 rounds by date\nfrom collections import defaultdict\nrd_dates = defaultdict(list)\nfor r in rows:\n    if r['season']=='2021':\n        rd_dates[int(r['round'])].append((r['datetime'][:10], r['home_team'], r['home_goal'], r['away_goal'], r['away_team']))\nfor rd in sorted(rd_dates):\n    ds = sorted(set(d for d,*_ in rd_dates[rd]))\n    print(\"2021 round\", rd, \"n=\", len(rd_dates[rd]), \"dates\", ds[0], \"->\", ds[-1])\nprint()\nfor r in sorted(rd_dates[4], key=lambda x: x[0])[:6]:\n    print(\"  R4:\", r)\n# check 2012: max round 6? dates\nrd_dates = defaultdict(list)\nfor r in rows:\n    if r['season']=='2012':\n        rd_dates[int(r['round'])].append(r['datetime'][:10])\nfor rd in sorted(rd_dates):\n    ds = sorted(rd_dates[rd]); print(\"2012 round\", rd, \"n=\", len(ds), ds[0], \"->\", ds[-1])\nEOF" action.permission=bash action.action=allow action.pattern=*
