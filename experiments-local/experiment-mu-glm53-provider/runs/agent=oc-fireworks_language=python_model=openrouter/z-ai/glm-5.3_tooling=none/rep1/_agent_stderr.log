timestamp=2026-09-01T05:59:32.371Z level=INFO run=2c158548 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nfrom brazilian_soccer_mcp import load_dataset\nfrom brazilian_soccer_mcp.queries import resolve_team, search_matches, player_search\nds = load_dataset()\nfor name in ('Sport Club Corinthians Paulista', 'Flamengoo', 'Atletico-PR', 'Athletico',\n             'Vasco da Gama', 'Red Bull Bragantino', 'América de Natal', 'C.r.b.',\n             'Boavista Sport Club (antigo Esporte Clube Barreira)', 'Nacional (URU)',\n             'River (PI)', 'São José - POA', 'S.francisco - PA'):\n    club, alts = resolve_team(ds, name)\n    print(f\"{name!r:55s} -> {club.key if club else None} ({club.display if club else '-'})\")\n# make sure Sport itself still resolves (no over-stripping)\nfor name in ('Sport', 'Sport-PE', 'Sport Recife', 'Sport Boys'):\n    club, alts = resolve_team(ds, name)\n    print(f\"{name!r:10s} -> {club.key if club else None} ({club.display if club else '-'})\")\n# and single-word form-word clubs aren't destroyed\nfor name in ('EC Bahia', 'Bahia', 'Oeste'):\n    club, alts = resolve_team(ds, name)\n    print(f\"{name!r:10s} -> {club.key if club else None}\")\nEOF" action.permission=bash action.action=allow action.pattern=*
