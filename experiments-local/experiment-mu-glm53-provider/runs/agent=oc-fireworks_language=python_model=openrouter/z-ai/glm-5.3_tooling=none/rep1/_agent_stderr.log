timestamp=2026-09-01T05:32:33.428Z level=INFO run=2c158548 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, re, datetime as dt, unicodedata, collections\ndef deacc(s): return ''.join(c for c in unicodedata.normalize('NFKD', s) if not unicodedata.combining(c)).lower()\nSTATES={'AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'}\nCOUN={'uru','par','equ','per','ven'}\nALIAS={('atletico mineiro','MG'):('atletico','MG'),('atletico mineiro',None):('atletico','MG'),\n('athletico paranaense','PR'):('atletico','PR'),('atletico paranaense','PR'):('atletico','PR'),('athletico',None):('atletico','PR'),\n('vasco da gama',None):('vasco','RJ'),('vasco da gama','RJ'):('vasco','RJ'),('vasco',None):('vasco','RJ'),\n('sport recife',None):('sport','PE'),('sport',None):('sport','PE'),\n('red bull bragantino',None):('bragantino','SP'),('red bull bragantino','SP'):('bragantino','SP'),('bragantino',None):('bragantino','SP'),\n('corinthians paulista','SP'):('corinthians','SP'),('corinthians paulista',None):('corinthians','SP')}\ndef key(name, state=None):\n    s = re.sub(r'\\(.*?\\)',' ', deacc(name.strip())).replace(\"'\",'')\n    toks=[t for t in re.split(r'[\\s\\-]+',s) if t]\n    st=state\n    if toks and toks[-1].upper() in STATES and len(toks)>1: st=toks[-1].upper(); toks=toks[:-1]\n    elif toks and toks[-1].upper() in COUN and len(toks)>1: st=toks[-1].upper(); toks=toks[:-1]\n    toks=[t.replace('.','') for t in toks]\n    pre=' '.join(toks)\n    a=ALIAS.get((pre,st))\n    if a: pre,st=a; toks=pre.split()\n    else:\n        FORM={'ec','sc','fc','ce','ge','ca','ad','se','aa','club','clube','futebol','ltda','esporte'}\n        if pre not in ('sport boys',):\n            while len(toks)>1 and toks[0] in FORM: toks=toks[1:]\n            while len(toks)>1 and toks[-1] in FORM: toks=toks[:-1]\n            while len(toks)>1 and len(toks[-1])==1: toks=toks[:-1]\n        core=' '.join(toks)\n        a=ALIAS.get((core,st))\n        if a: core,st=a; pre=core\n    return f\"{pre}|{st or ''}\"\ndef load(fn):\n    with open(fn, encoding='utf-8') as f: return list(csv.DictReader(f))\ndef pd_(s):\n    s=s.strip()\n    for f in ('%Y-%m-%d %H:%M:%S','%Y-%m-%d','%d/%m/%Y'):\n        try: return dt.datetime.strptime(s,f).date()\n        except ValueError: pass\n    return None\ndef g(s):\n    try: return int(float(s))\n    except (ValueError,TypeError): return None\nLEAGUE={'serie_a','serie_b','serie_c'}\ncand=collections.defaultdict(list)\ndef add(src, comp, d, h,a,hg,ag, se, hk=None, ak=None, rnd=None, stage=None, venue=None, stats=None):\n    if hk is None: hk=key(h); ak=key(a)\n    cand[(comp,se,hk,ak)].append(dict(src=src,comp=comp,d=d,h=h,a=a,hk=hk,ak=ak,hg=hg,ag=ag,rnd=rnd,stage=stage,venue=venue,stats=stats))\nPRIO={'bras':0,'cup':1,'lib':1,'novo':2,'brf':3}\nfor r in load('data/kaggle/Brasileirao_Matches.csv'):\n    add('bras','serie_a',pd_(r['datetime']),r['home_team'],r['away_team'],g(r['home_goal']),g(r['away_goal']),int(r['season']),rnd=r['round'])\nfor r in load('data/kaggle/novo_campeonato_brasileiro.csv'):\n    add('novo','serie_a',pd_(r['Data']),r['Equipe_mandante'],r['Equipe_visitante'],g(r['Gols_mandante']),g(r['Gols_visitante']),int(r['Ano']),key(r['Equipe_mandante'],r['Mandante_UF']),key(r['Equipe_visitante'],r['Visitante_UF']),rnd=r['Rodada'],venue=r['Arena'])\nfor r in load('data/kaggle/Brazilian_Cup_Matches.csv'):\n    add('cup','copa_do_brasil',pd_(r['datetime']),r['home_team'],r['away_team'],g(r['home_goal']),g(r['away_goal']),int(r['season']),rnd=r['round'])\nfor r in load('data/kaggle/Libertadores_Matches.csv'):\n    se=int(r['season']) if r['season']!='NA' else None\n    add('lib','libertadores',pd_(r['datetime']),r['home_team'],r['away_team'],g(r['home_goal']),g(r['away_goal']),se,stage=r['stage'])\nfor r in load('data/kaggle/BR-Football-Dataset.csv'):\n    t={'Serie A':'serie_a','Serie B':'serie_b','Serie C':'serie_c','Copa do Brasil':'copa_do_brasil'}[r['tournament']]\n    stats={'corners':(r['home_corner'],r['away_corner']),'shots':(r['home_shots'],r['away_shots']),'attacks':(r['home_attack'],r['away_attack'])}\n    add('brf',t,pd_(r['date']),r['home'],r['away'],g(r['home_goal']),g(r['away_goal']),int(r['date'][:4]),stats=stats)\n\nmatches=[]\nfor k,v in cand.items():\n    comp=k[0]\n    v.sort(key=lambda x:PRIO[x['src']])\n    if comp in LEAGUE:\n        # strong rule: same score (None wildcard) => same fixture\n        kept=[]\n        for m in v:\n            dup=False\n            for i,kp in enumerate(kept):\n                if (kp['hg'],kp['ag'])==(m['hg'],m['ag']) or (m['hg'],m['ag'])==(None,None) or (kp['hg'],kp['ag'])==(None,None):\n                    if (m['hg'],m['ag'])!=(None,None) and (kp['hg'],kp['ag'])==(None,None): kept[i]=m\n                    dup=True; break\n            if not dup: kept.append(m)\n    else:\n        kept=[]\n        for m in v:\n            dup=False\n            for i,kp in enumerate(kept):\n                same_score=(kp['hg'],kp['ag'])==(m['hg'],m['ag']) or (m['hg'],m['ag'])==(None,None) or (kp['hg'],kp['ag'])==(None,None)\n                close_date=(kp['d'] and m['d'] and abs((kp['d']-m['d']).days)<=2) or (kp['d'] is None or m['d'] is None)\n                if same_score and close_date:\n                    if (m['hg'],m['ag'])!=(None,None) and (kp['hg'],kp['ag'])==(None,None): kept[i]=m\n                    dup=True; break\n            if not dup: kept.append(m)\n    matches.extend(kept)\n\nprint(\"total matches:\", len(matches))\npercomp=collections.Counter(m['comp'] for m in matches); print(percomp)\nser=collections.defaultdict(collections.Counter)\nfor m in matches:\n    if m['comp']=='serie_a': ser[m['comp']][m['src'] if False else ''][:0]\ns=collections.Counter((m['season']) for m in matches if m['comp']=='serie_a')\nprint(\"serie_a per season:\", dict(sorted(s.items())))\ns=collections.Counter((m['season']) for m in matches if m['comp']=='copa_do_brasil')\nprint(\"copa per season:\", dict(sorted(s.items())))\n\ndef table(comp,season):\n    t=collections.defaultdict(lambda: [0]*8)  # P W D L GF GA GD Pts\n    for m in matches:\n        if m['comp']==comp and m['season']==season and m['hg'] is not None:\n            hk,ak,hg,ag=m['hk'],m['ak'],m['hg'],m['ag']\n            t[hk][0]+=1; t[ak][0]+=1\n            t[hk][4]+=hg; t[ak][4]+=ag; t[hk][5]+=ag; t[ak][5]+=hg\n            if hg>ag: t[hk][1]+=3; t[ak][3]+=3; t[hk][7]+=3\n            elif hg<ag: t[ak][1]+=3; t[hk][3]+=3; t[ak][7]+=3\n            else: t[hk][2]+=1; t[ak][2]+=1; t[hk][7]+=1; t[ak][7]+=1\n    rows=sorted(t.items(), key=lambda kv:(-kv[1][7],-kv[1][1],-(kv[1][4]-kv[1][5]),-kv[1][4]))\n    return [(k,v) for k,v in rows]\nprint(\"\\n2019 serie_a top3:\", table('serie_a',2019)[:3])\nprint(\"2018 champ:\", table('serie_a',2018)[0])\nprint(\"2023 champ:\", table('serie_a',2023)[0])\nprint(\"2020 bottom4:\", table('serie_a',2020)[-4:])\n# Corinthians 2022 home\nc=0;w=d=l=0;gf=ga=0\nfor m in matches:\n    if m['comp']=='serie_a' and m['season']==2022 and m['hk']=='corinthians|SP' and m['hg'] is not None:\n        c+=1; gf+=m['hg']; ga+=m['ag']\n        if m['hg']>m['ag']: w+=1\n        elif m['hg']<m['ag']: l+=1\n        else: d+=1\nprint(\"Corinthians home 2022:\", c,w,d,l,gf,ga)\n# Fla-Flu h2h\nfw=fl=d=0; n=0\nfor m in matches:\n    if {m['hk'],m['ak']}=={'flamengo|RJ','fluminense|RJ'} and m['hg'] is not None:\n        n+=1\n        h_f = m['hk']=='flamengo|RJ'\n        hg,ag=(m['hg'],m['ag']) if h_f else (m['ag'],m['hg'])\n        if hg>ag: fw+=1\n        elif hg<ag: fl+=1\n        else: d+=1\nprint(\"Fla-Flu h2h:\", n, \"Flamengo\", fw, \"Fluminense\", fl, \"draws\", d)\n# avg goals serie_a\npl=[m for m in matches if m['comp']=='serie_a' and m['hg'] is not None]\nhw=sum(1 for m in pl if m['hg']>m['ag']); dr=sum(1 for m in pl if m['hg']==m['ag']); aw=sum(1 for m in pl if m['hg']<m['ag'])\nprint(\"serie_a played:\",len(pl),\"avg goals:\",round(sum(m['hg']+m['ag'] for m in pl)/len(pl),3),\"home win%:\",round(100*hw/len(pl),1),\"draw%:\",round(100*dr/len(pl),1),\"away%:\",round(100*aw/len(pl),1))\n# biggest wins\nbw=sorted([m for m in matches if m['hg'] is not None], key=lambda m:(-abs(m['hg']-m['ag']),-(m['hg']+m['ag'])))[:5]\nprint(\"biggest:\", [(m['d'],m['h'],m['hg'],m['ag'],m['a'],m['comp'],m['season']) for m in bw])\n# copa finals per season\ncupm=[m for m in matches if m['comp']=='copa_do_brasil']\nfor s in sorted(set(m['season'] for m in cupm)):\n    mx=max(int(m['rnd']) for m in cupm if m['season']==s and m['rnd'])\n    fin=[(m['h'],m['hg'],m['ag'],m['a']) for m in cupm if m['season']==s and m['rnd'] and int(m['rnd'])==mx]\n    print(\"cup final\", s, \"round\", mx, fin)\n# Gabriel Barbosa\nwith open('data/kaggle/fifa_data.csv', encoding='utf-8-sig') as f:\n    pros=list(csv.DictReader(f))\ngb=[(r['Name'],r['Age'],r['Overall'],r['Club'],r['Position']) for r in pros if 'barbosa' in deacc(r['Name'])]\nprint(\"Gabriel Barbosa:\", gb[:6])\n# Palmeiras 2023 matches count\nprint(\"Palmeiras 2023 matches:\", sum(1 for m in matches if m['season']==2023 and 'palmeiras|SP' in (m['hk'],m['ak'])))\n# best away record serie_a all-time\naway=collections.defaultdict(lambda:[0,0])\nfor m in pl:\n    if m['hg'] is not None and m['hg']<m['ag']: away[m['ak']][0]+=3; away[m['ak']][1]+=1\n    elif m['hg']==m['ag']: away[m['ak']][0]+=1; away[m['ak']][1]+=1\n    else: away[m['ak']][1]+=1\nbest=sorted(((k,v[0]/v[1],v[1]) for k,v in away.items() if v[1]>=100), key=lambda x:-x[1])[:5]\nprint(\"best away ppg (>=100):\", best)\nEOF" action.permission=bash action.action=allow action.pattern=*
