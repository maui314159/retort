timestamp=2026-09-01T15:42:43.284Z level=INFO run=ec76643f message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nfrom brazilian_soccer import SoccerData\nfrom brazilian_soccer.normalize import team_key, BRAZILIAN_UFS, COUNTRY_CODES\nimport re\n\ndata = SoccerData()\n# For each canonical key, collect distinct state/country suffixes seen in raw variants\nsuspects = {}\nfor key, info in data.teams.items():\n    suffixes = set()\n    for raw in info.variants:\n        for m in re.finditer(r'[-\\s]\\(?([A-Z]{2,3})\\)?\\s*$', raw):\n            code = m.group(1)\n            if code in BRAZILIAN_UFS or code in COUNTRY_CODES:\n                suffixes.add(code)\n    if len(suffixes) > 1:\n        suspects[key] = (sorted(suffixes), sorted(info.variants))\nfor key in sorted(suspects):\n    print(f\"{key}: suffixes={suspects[key][0]}\")\n    print(f\"   variants: {suspects[key][1]}\")\nEOF" action.permission=bash action.action=allow action.pattern=*
