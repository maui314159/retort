timestamp=2026-09-01T16:36:10.482Z level=INFO run=66fb43df message=evaluated permission=bash pattern="python3 << 'EOF'\nimport csv, re, unicodedata\nfrom collections import Counter\ndef load(f):\n    with open(f, encoding='utf-8') as fh:\n        return list(csv.DictReader(fh))\nb = load('data/kaggle/Brasileirao_Matches.csv')\nbr = load('data/kaggle/BR-Football-Dataset.csv')\n\n# 2019 Serie A Flamengo home matches in both files\nf1 = [(r['datetime'][:10], r['home_team'], r['away_team'], r['home_goal'], r['away_goal']) for r in b if r['season']=='2019' and 'Flamengo' in r['home_team']]\nf2 = [(r['date'], r['home'], r['away'], r['home_goal'], r['away_goal']) for r in br if r['tournament']=='Serie A' and r['date'].startswith('2019') and r['home']=='Flamengo']\nprint('Brasileirao 2019 Flamengo home:', len(f1))\nprint('BR-Football 2019 Flamengo home:', len(f2))\nprint(f1[:3])\nprint(f2[:3])\ncommon_dates = set(x[0] for x in f1) & set(x[0] for x in f2)\nprint('common dates:', len(common_dates), 'of', len(set(x[0] for x in f1)))\n# same score on common date?\nd1 = {x[0]: (x[3],x[4]) for x in f1}\nd2 = {x[0]: (float(x[3]), float(x[4])) for x in f2}\nagree = sum(1 for d in common_dates if d1[d] == tuple(int(v) for v in d2[d]))\nprint('score agreement on common dates:', agree, '/', len(common_dates))\n# check Bragantino & Vasco spellings in Brasileirao\nnames_b = set(r['home_team'] for r in b)\nprint([n for n in sorted(names_b) if 'ragan' in n or 'asco' in n or 'aulista' in n])\nEOF" action.permission=bash action.action=allow action.pattern=*
