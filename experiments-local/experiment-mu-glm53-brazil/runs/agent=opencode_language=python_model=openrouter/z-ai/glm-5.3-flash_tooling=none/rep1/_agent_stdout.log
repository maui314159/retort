{"type":"tool_use","timestamp":1788228073775,"sessionID":"ses_fa54e4cfeffeF35792XylHPXI3","part":{"type":"tool","tool":"read","callID":"call_ebe3b5b5a66a4381ae2c63b8","state":{"status":"completed","input":{"filePath":"/Users/maui/.retort/work/retort-local-75154ofp/retort-242ce4667ad2/brazilian_soccer_mcp/normalize.py"},"output":"<path>/Users/maui/.retort/work/retort-local-75154ofp/retort-242ce4667ad2/brazilian_soccer_mcp/normalize.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Text, team-name, and date normalization for Brazilian soccer datasets.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import re\n6: import unicodedata\n7: from datetime import date, datetime\n8: \n9: # ---------------------------------------------------------------------------\n10: # Generic text helpers\n11: # ---------------------------------------------------------------------------\n12: \n13: \n14: def strip_accents(text: str) -> str:\n15:     \"\"\"Remove diacritics: \"São Paulo\" -> \"sao paulo\" (after lowercasing).\"\"\"\n16:     decomposed = unicodedata.normalize(\"NFKD\", text)\n17:     return \"\".join(ch for ch in decomposed if not unicodedata.combining(ch))\n18: \n19: \n20: def collapse_ws(text: str) -> str:\n21:     return re.sub(r\"\\s+\", \" \", text).strip()\n22: \n23: \n24: def text_key(text: str) -> str:\n25:     \"\"\"Case/diacritic/punctuation-insensitive lookup key.\n26: \n27:     \"Atlético - PR\" -> \"atletico pr\"; \"Nacional (URU)\" -> \"nacional uru\".\n28:     \"\"\"\n29:     lowered = strip_accents(collapse_ws(text)).lower()\n30:     return re.sub(r\"[^a-z0-9]+\", \" \", lowered).strip()\n31: \n32: \n33: # ---------------------------------------------------------------------------\n34: # Team name normalization\n35: # ---------------------------------------------------------------------------\n36: \n37: # Brazilian state abbreviations used as \"-SP\" style suffixes, and the\n38: # country codes used in the Libertadores dataset (\"Nacional (URU)\").\n39: _STATE_CODES = {\n40:     \"AC\", \"AL\", \"AP\", \"AM\", \"BA\", \"CE\", \"DF\", \"ES\", \"GO\", \"MA\", \"MT\", \"MS\",\n41:     \"MG\", \"PA\", \"PB\", \"PR\", \"PE\", \"PI\", \"RJ\", \"RN\", \"RS\", \"RO\", \"RR\", \"SC\",\n42:     \"SP\", \"SE\", \"TO\",\n43: }\n44: _COUNTRY_CODES = {\n45:     \"URU\", \"ARG\", \"PAR\", \"EQU\", \"BOL\", \"CHI\", \"COL\", \"PER\", \"VEN\", \"CRC\",\n46:     \"HON\", \"GUA\", \"PAN\", \"MEX\", \"USA\",\n47: }\n48: _SUFFIX_CODES = _STATE_CODES | _COUNTRY_CODES\n49: \n50: _SUFFIX_RE = re.compile(\n51:     r\"^(?P<base>.+?)\\s*[-–(]+\\s*(?P<code>[A-Za-z]{2,3})\\s*\\)?$\", re.UNICODE\n52: )\n53: \n54: # alias key (accent-stripped, lowercased, punctuation-as-space) -> canonical\n55: # display name. Keys must therefore themselves be suffix-free.\n56: _TEAM_ALIASES = {\n57:     # Big clubs (state-suffix collisions need explicit entries)\n58:     \"america mg\": \"América Mineiro\",\n59:     \"america mineiro\": \"América Mineiro\",\n60:     \"america fc minas gerais\": \"América Mineiro\",\n61:     \"america rn\": \"América de Natal\",\n62:     \"america natal\": \"América de Natal\",\n63:     \"america de natal\": \"América de Natal\",\n64:     \"america football club natal\": \"América de Natal\",\n65:     \"america de cali\": \"América de Cali\",\n66:     \"atletico mg\": \"Atlético Mineiro\",\n67:     \"atletico mineiro\": \"Atlético Mineiro\",\n68:     \"clube atletico mineiro\": \"Atlético Mineiro\",\n69:     \"atletico pr\": \"Athletico Paranaense\",\n70:     \"atletico paranaense\": \"Athletico Paranaense\",\n71:     \"athletico pr\": \"Athletico Paranaense\",\n72:     \"athletico paranaense\": \"Athletico Paranaense\",\n73:     \"athletico\": \"Athletico Paranaense\",\n74:     \"atletico go\": \"Atlético Goianiense\",\n75:     \"atletico goianiense\": \"Atlético Goianiense\",\n76:     \"atletico goianiense go\": \"Atlético Goianiense\",\n77:     \"atletico nacional\": \"Atlético Nacional\",\n78:     \"vasco\": \"Vasco da Gama\",\n79:     \"vasco da gama\": \"Vasco da Gama\",\n80:     \"club de regatas vasco da gama\": \"Vasco da Gama\",\n81:     \"sao paulo\": \"São Paulo\",\n82:     \"sao paulo fc\": \"São Paulo\",\n83:     \"sao paulo futebol clube\": \"São Paulo\",\n84:     \"sport\": \"Sport Recife\",\n85:     \"sport club do recife\": \"Sport Recife\",\n86:     \"sport recife\": \"Sport Recife\",\n87:     \"red bull bragantino\": \"Red Bull Bragantino\",\n88:     \"bragantino\": \"Red Bull Bragantino\",\n89:     \"red bull brasil\": \"Red Bull Bragantino\",\n90:     \"gremio prudente\": \"Grêmio Prudente\",\n91:     \"santo andre\": \"Santo André\",\n92:     \"sao caetano\": \"São Caetano\",\n93:     \"parana\": \"Paraná\",\n94:     \"parana clube\": \"Paraná\",\n95:     \"cuiaba\": \"Cuiabá\",\n96:     \"cuiaba esporte clube\": \"Cuiabá\",\n97:     \"csa\": \"CSA\",\n98:     \"centro sportivo alagoano\": \"CSA\",\n99:     \"asa\": \"ASA\",\n100:     \"asa al\": \"ASA\",\n101:     \"boavista\": \"Boavista\",\n102:     \"boavista rj\": \"Boavista\",\n103:     \"boavista sc saquarema\": \"Boavista\",\n104:     \"chapecoense\": \"Chapecoense\",\n105:     \"atletico de capelense\": \"Atlético Capelense\",\n106:     \"abc\": \"ABC\",\n107:     \"abc rn\": \"ABC\",\n108:     \"a s a\": \"ASA\",\n109:     \"a s a al\": \"ASA\",\n110:     \"asa al\": \"ASA\",\n111:     \"aguia negra\": \"Águia Negra\",\n112:     \"aimore\": \"Aimoré\",\n113:     \"avai\": \"Avaí\",\n114:     \"ceara\": \"Ceará\",\n115:     \"ceara sporting club\": \"Ceará\",\n116:     \"criciuma\": \"Criciúma\",\n117:     \"goias\": \"Goiás\",\n118:     \"nautico\": \"Náutico\",\n119:     \"vitoria\": \"Vitória\",\n120:     \"juventude\": \"Juventude\",\n121:     \"figueirense\": \"Figueirense\",\n122:     \"joinville\": \"Joinville\",\n123:     \"ponte preta\": \"Ponte Preta\",\n124:     \"portuguesa\": \"Portuguesa\",\n125:     \"santa cruz\": \"Santa Cruz\",\n126:     \"paysandu\": \"Paysandu\",\n127:     \"guarani\": \"Guarani\",\n128:     \"ipatinga\": \"Ipatinga\",\n129:     \"brasiliense\": \"Brasiliense\",\n130:     \"barueri\": \"Barueri\",\n131:     \"gremio barueri\": \"Barueri\",\n132:     \"fortaleza\": \"Fortaleza\",\n133:     \"fortaleza esporte clube\": \"Fortaleza\",\n134:     # Space-suffixed variants from BR-Football-Dataset that must not be\n135:     # confused with their more famous namesakes.\n136:     \"botafogo rj\": \"Botafogo\",\n137:     \"botafogo pb\": \"Botafogo-PB\",\n138:     \"botafogo sp\": \"Botafogo-SP\",\n139:     \"fluminense rj\": \"Fluminense\",\n140:     \"fluminense pi\": \"Fluminense-PI\",\n141:     \"santos ap\": \"Santos-AP\",\n142:     \"santa cruz rn\": \"Santa Cruz-RN\",\n143:     \"santa cruz rs\": \"Santa Cruz-RS\",\n144:     \"santa cruz\": \"Santa Cruz\",\n145:     \"vitoria es\": \"Vitória-ES\",\n146:     \"nautico rr\": \"Náutico-RR\",\n147:     \"juventude ma\": \"Juventude-MA\",\n148:     \"americano rj\": \"Americano\",\n149:     \"cuiaba mt\": \"Cuiabá\",\n150:     \"coritiba pr\": \"Coritiba\",\n151:     \"gremio rs\": \"Grêmio\",\n152:     \"internacional rs\": \"Internacional\",\n153:     \"caxias rs\": \"Caxias\",\n154:     \"guarani sp\": \"Guarani\",\n155:     \"audax sp\": \"Audax\",\n156:     \"vasco da gama rj\": \"Vasco da Gama\",\n157:     \"nacional am\": \"Nacional-AM\",\n158:     \"bragantino pa\": \"Bragantino-PA\",\n159:     \"ldu\": \"LDU Quito\",\n160:     \"ldu quito\": \"LDU Quito\",\n161:     \"ind santa fe\": \"Independiente Santa Fe\",\n162:     \"independiente santa fe\": \"Independiente Santa Fe\",\n163:     \"independiente del valle\": \"Independiente Del Valle\",\n164:     \"independiente medellin\": \"Independiente Medellín\",\n165:     \"atletico tucuman\": \"Atlético Tucumán\",\n166:     \"estudiantes de merida\": \"Estudiantes de Mérida\",\n167:     \"deportes tolima\": \"Deportes Tolima\",\n168:     \"junior de barranquilla\": \"Junior\",\n169:     \"junior\": \"Junior\",\n170:     \"cerro porteno\": \"Cerro Porteño\",\n171:     \"guarani par\": \"Guaraní\",\n172:     \"guarani asuncion\": \"Guaraní\",\n173:     \"club guarani\": \"Guaraní\",\n174:     \"defensor sporting\": \"Defensor Sporting\",\n175:     \"jorge wilstermann\": \"Jorge Wilstermann\",\n176:     \"colo colo\": \"Colo-Colo\",\n177:     \"barcelona equ\": \"Barcelona SC\",\n178:     \"barcelona sc\": \"Barcelona SC\",\n179:     \"barcelona ecuador\": \"Barcelona SC\",\n180:     \"delfin\": \"Delfín\",\n181:     \"delfin equ\": \"Delfín\",\n182:     \"nacional uru\": \"Nacional\",\n183:     \"nacional\": \"Nacional\",\n184:     \"nacional montevideo\": \"Nacional\",\n185: }\n186: \n187: # Pairs of canonical team names that are traditional rivalries.\n188: DERBIES = {\n189:     (\"Flamengo\", \"Fluminense\"): \"Fla-Flu\",\n190:     (\"Flamengo\", \"Vasco da Gama\"): \"Clássico dos Milhões\",\n191:     (\"Flamengo\", \"Botafogo\"): \"Clássico da Rivalidade\",\n192:     (\"Botafogo\", \"Fluminense\"): \"Clássico Vovô\",\n193:     (\"Botafogo\", \"Vasco da Gama\"): \"Clássico da Amizade\",\n194:     (\"Palmeiras\", \"São Paulo\"): \"Choque-Rei\",\n195:     (\"Corinthians\", \"São Paulo\"): \"Majestoso\",\n196:     (\"Corinthians\", \"Palmeiras\"): \"Dérbi Paulista\",\n197:     (\"Grêmio\", \"Internacional\"): \"Gre-Nal\",\n198:     (\"Bahia\", \"Vitória\"): \"Ba-Vi\",\n199:     (\"Athletico Paranaense\", \"Coritiba\"): \"Atletiba\",\n200:     (\"Ceará\", \"Fortaleza\"): \"Clássico-Rei\",\n201: }\n202: \n203: \n204: def _display_fallback(base: str) -> str:\n205:     \"\"\"Title-case a suffix-stripped name while preserving accents/spacing.\"\"\"\n206:     out = []\n207:     for word in base.split(\" \"):\n208:         if not word:\n209:             continue\n210:         out.append(word[0].upper() + word[1:])\n211:     return \" \".join(out)\n212: \n213: \n214: def strip_team_suffix(name: str) -> tuple[str, str | None]:\n215:     \"\"\"Split \"Palmeiras-SP\" -> (\"Palmeiras\", \"SP\"); returns (base, code|None).\"\"\"\n216:     cleaned = collapse_ws(name)\n217:     match = _SUFFIX_RE.match(cleaned)\n218:     if match and match.group(\"code\").upper() in _SUFFIX_CODES:\n219:         base = match.group(\"base\").strip(\" -–(\")\n220:         if base:\n221:             return base, match.group(\"code\").upper()\n222:     return cleaned, None\n223: \n224: \n225: def normalize_team(name: str) -> str:\n226:     \"\"\"Canonicalize a team name across dataset conventions.\n227: \n228:     Handles: state suffixes (\"Palmeiras-SP\"), spaced suffixes (\"América - MG\"),\n229:     country codes (\"Nacional (URU)\", \"Guaraní-PAR\"), missing accents\n230:     (\"Sao Paulo\", \"Gremio\"), and known spelling variants (\"Athletico-PR\",\n231:     \"Atletico Goianiense\").\n232:     \"\"\"\n233:     if not name or not collapse_ws(name):\n234:         return \"\"\n235:     cleaned = collapse_ws(name)\n236: \n237:     key = text_key(cleaned)\n238:     if key in _TEAM_ALIASES:\n239:         return _TEAM_ALIASES[key]\n240: \n241:     base, _code = strip_team_suffix(cleaned)\n242:     if base != cleaned:\n243:         base_key = text_key(base)\n244:         if base_key in _TEAM_ALIASES:\n245:             return _TEAM_ALIASES[base_key]\n246:         return _display_fallback(base)\n247:     return cleaned\n248: \n249: \n250: def team_key(name: str) -> str:\n251:     \"\"\"Stable identity key for a team after canonicalization.\"\"\"\n252:     return text_key(normalize_team(name))\n253: \n254: \n255: # Generic club-type tokens ignored when computing a team's identity key, so\n256: # \"Fortaleza\", \"Fortaleza FC\", and \"Fortaleza EC\" share one identity.\n257: _GENERIC_TOKENS = {\"fc\", \"ec\", \"sc\", \"cf\", \"club\", \"clube\", \"esporte\",\n258:                    \"futebol\"}\n259: _GENERIC_PAIRS = {\"esporte clube\", \"futebol clube\", \"sport club\"}\n260: \n261: \n262: def identity_key(name: str) -> str:\n263:     \"\"\"Identity used for cross-file dedup and team matching.\n264: \n265:     Same as team_key but additionally ignores generic club-type tokens:\n266:     \"Fortaleza FC\" and \"Fortaleza\" share the identity \"fortaleza\".\n267:     \"\"\"\n268:     tokens = team_key(name).split()\n269:     while len(tokens) >= 2 and \" \".join(tokens[-2:]) in _GENERIC_PAIRS:\n270:         del tokens[-2:]\n271:     while tokens and tokens[-1] in _GENERIC_TOKENS:\n272:         tokens.pop()\n273:     while tokens and tokens[0] in _GENERIC_TOKENS:\n274:         tokens.pop(0)\n275:     return \" \".join(tokens)\n276: \n277: \n278: def derby_name(team_a: str, team_b: str) -> str | None:\n279:     \"\"\"Return the rivalry name if two teams are a known derby, else None.\"\"\"\n280:     a, b = normalize_team(team_a), normalize_team(team_b)\n281:     pair = (a, b) if a < b else (b, a)\n282:     return DERBIES.get(pair)\n283: \n284: \n285: # ---------------------------------------------------------------------------\n286: # Date parsing\n287: # ---------------------------------------------------------------------------\n288: \n289: _DATE_FORMATS = (\n290:     \"%Y-%m-%d %H:%M:%S\",\n291:     \"%Y-%m-%dT%H:%M:%S\",\n292:     \"%Y-%m-%d\",\n293:     \"%d/%m/%Y %H:%M:%S\",\n294:     \"%d/%m/%Y\",\n295:     \"%d/%m/%y\",\n296: )\n297: \n298: \n299: def parse_date(value: str | None) -> date | None:\n300:     \"\"\"Parse the date formats found across the datasets (or None).\"\"\"\n301:     if value is None:\n302:         return None\n303:     text = collapse_ws(str(value))\n304:     if not text or text.upper() in {\"NA\", \"N/A\", \"NULL\", \"NONE\"}:\n305:         return None\n306:     for fmt in _DATE_FORMATS:\n307:         try:\n308:             return datetime.strptime(text, fmt).date()\n309:         except ValueError:\n310:             continue\n311:     return None\n312: \n313: \n314: def parse_season(value: str | int | None) -> int | None:\n315:     \"\"\"Parse a season/year cell (\"2012\", 2012, \"NA\") or None.\"\"\"\n316:     if value is None:\n317:         return None\n318:     text = collapse_ws(str(value))\n319:     if not text or text.upper() in {\"NA\", \"N/A\", \"NULL\", \"NONE\"}:\n320:         return None\n321:     match = re.match(r\"(\\d{4})\", text)\n322:     return int(match.group(1)) if match else None\n323: \n324: \n325: def parse_int(value: str | float | int | None) -> int | None:\n326:     \"\"\"Parse a goals/score cell; missing or non-numeric becomes None.\"\"\"\n327:     if value is None:\n328:         return None\n329:     if isinstance(value, bool):\n330:         return None\n331:     if isinstance(value, (int, float)):\n332:         return int(value)\n333:     text = collapse_ws(str(value))\n334:     if not text or text.upper() in {\"NA\", \"N/A\", \"NULL\", \"NONE\", \"D\", \"E\", \"V\"}:\n335:         return None\n336:     try:\n337:         return int(float(text))\n338:     except ValueError:\n339:         return None\n340: \n341: \n342: def parse_money(value: str | None) -> float | None:\n343:     \"\"\"Parse FIFA value/wage cells like \"€110.5M\" / \"€565K\" into euros.\"\"\"\n344:     if not value:\n345:         return None\n346:     text = strip_accents(value.strip().lstrip(\"€$R$ \").replace(\",\", \"\"))\n347:     if not text or text.upper() in {\"NA\", \"N/A\"}:\n348:         return None\n349:     multiplier = 1.0\n350:     if text and text[-1].upper() in {\"K\", \"M\", \"B\"}:\n351:         multiplier = {\"K\": 1e3, \"M\": 1e6, \"B\": 1e9}[text[-1].upper()]\n352:         text = text[:-1]\n353:     try:\n354:         return float(text) * multiplier\n355:     except ValueError:\n356:         return None\n\n(End of file - total 356 lines)\n</content>","metadata":{"preview":"\"\"\"Text, team-name, and date normalization for Brazilian soccer datasets.\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nimport unicodedata\nfrom datetime import date, datetime\n\n# ---------------------------------------------------------------------------\n# Generic text helpers\n# ---------------------------------------------------------------------------\n\n\ndef strip_accents(text: str) -> str:\n    \"\"\"Remove diacritics: \"São Paulo\" -> \"sao paulo\" (after lowercasing).\"\"\"\n    decomposed = unicodedata.normalize(\"NFKD\", text)\n    return \"\".join(ch for ch in decomposed if not unicodedata.combining(ch))\n\n\ndef collapse_ws(text: str) -> str:","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/maui/.retort/work/retort-local-75154ofp/retort-242ce4667ad2/brazilian_soccer_mcp/normalize.py","text":"\"\"\"Text, team-name, and date normalization for Brazilian soccer datasets.\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nimport unicodedata\nfrom datetime import date, datetime\n\n# ---------------------------------------------------------------------------\n# Generic text helpers\n# ---------------------------------------------------------------------------\n\n\ndef strip_accents(text: str) -> str:\n    \"\"\"Remove diacritics: \"São Paulo\" -> \"sao paulo\" (after lowercasing).\"\"\"\n    decomposed = unicodedata.normalize(\"NFKD\", text)\n    return \"\".join(ch for ch in decomposed if not unicodedata.combining(ch))\n\n\ndef collapse_ws(text: str) -> str:\n    return re.sub(r\"\\s+\", \" \", text).strip()\n\n\ndef text_key(text: str) -> str:\n    \"\"\"Case/diacritic/punctuation-insensitive lookup key.\n\n    \"Atlético - PR\" -> \"atletico pr\"; \"Nacional (URU)\" -> \"nacional uru\".\n    \"\"\"\n    lowered = strip_accents(collapse_ws(text)).lower()\n    return re.sub(r\"[^a-z0-9]+\", \" \", lowered).strip()\n\n\n# ---------------------------------------------------------------------------\n# Team name normalization\n# ---------------------------------------------------------------------------\n\n# Brazilian state abbreviations used as \"-SP\" style suffixes, and the\n# country codes used in the Libertadores dataset (\"Nacional (URU)\").\n_STATE_CODES = {\n    \"AC\", \"AL\", \"AP\", \"AM\", \"BA\", \"CE\", \"DF\", \"ES\", \"GO\", \"MA\", \"MT\", \"MS\",\n    \"MG\", \"PA\", \"PB\", \"PR\", \"PE\", \"PI\", \"RJ\", \"RN\", \"RS\", \"RO\", \"RR\", \"SC\",\n    \"SP\", \"SE\", \"TO\",\n}\n_COUNTRY_CODES = {\n    \"URU\", \"ARG\", \"PAR\", \"EQU\", \"BOL\", \"CHI\", \"COL\", \"PER\", \"VEN\", \"CRC\",\n    \"HON\", \"GUA\", \"PAN\", \"MEX\", \"USA\",\n}\n_SUFFIX_CODES = _STATE_CODES | _COUNTRY_CODES\n\n_SUFFIX_RE = re.compile(\n    r\"^(?P<base>.+?)\\s*[-–(]+\\s*(?P<code>[A-Za-z]{2,3})\\s*\\)?$\", re.UNICODE\n)\n\n# alias key (accent-stripped, lowercased, punctuation-as-space) -> canonical\n# display name. Keys must therefore themselves be suffix-free.\n_TEAM_ALIASES = {\n    # Big clubs (state-suffix collisions need explicit entries)\n    \"america mg\": \"América Mineiro\",\n    \"america mineiro\": \"América Mineiro\",\n    \"america fc minas gerais\": \"América Mineiro\",\n    \"america rn\": \"América de Natal\",\n    \"america natal\": \"América de Natal\",\n    \"america de natal\": \"América de Natal\",\n    \"america football club natal\": \"América de Natal\",\n    \"america de cali\": \"América de Cali\",\n    \"atletico mg\": \"Atlético Mineiro\",\n    \"atletico mineiro\": \"Atlético Mineiro\",\n    \"clube atletico mineiro\": \"Atlético Mineiro\",\n    \"atletico pr\": \"Athletico Paranaense\",\n    \"atletico paranaense\": \"Athletico Paranaense\",\n    \"athletico pr\": \"Athletico Paranaense\",\n    \"athletico paranaense\": \"Athletico Paranaense\",\n    \"athletico\": \"Athletico Paranaense\",\n    \"atletico go\": \"Atlético Goianiense\",\n    \"atletico goianiense\": \"Atlético Goianiense\",\n    \"atletico goianiense go\": \"Atlético Goianiense\",\n    \"atletico nacional\": \"Atlético Nacional\",\n    \"vasco\": \"Vasco da Gama\",\n    \"vasco da gama\": \"Vasco da Gama\",\n    \"club de regatas vasco da gama\": \"Vasco da Gama\",\n    \"sao paulo\": \"São Paulo\",\n    \"sao paulo fc\": \"São Paulo\",\n    \"sao paulo futebol clube\": \"São Paulo\",\n    \"sport\": \"Sport Recife\",\n    \"sport club do recife\": \"Sport Recife\",\n    \"sport recife\": \"Sport Recife\",\n    \"red bull bragantino\": \"Red Bull Bragantino\",\n    \"bragantino\": \"Red Bull Bragantino\",\n    \"red bull brasil\": \"Red Bull Bragantino\",\n    \"gremio prudente\": \"Grêmio Prudente\",\n    \"santo andre\": \"Santo André\",\n    \"sao caetano\": \"São Caetano\",\n    \"parana\": \"Paraná\",\n    \"parana clube\": \"Paraná\",\n    \"cuiaba\": \"Cuiabá\",\n    \"cuiaba esporte clube\": \"Cuiabá\",\n    \"csa\": \"CSA\",\n    \"centro sportivo alagoano\": \"CSA\",\n    \"asa\": \"ASA\",\n    \"asa al\": \"ASA\",\n    \"boavista\": \"Boavista\",\n    \"boavista rj\": \"Boavista\",\n    \"boavista sc saquarema\": \"Boavista\",\n    \"chapecoense\": \"Chapecoense\",\n    \"atletico de capelense\": \"Atlético Capelense\",\n    \"abc\": \"ABC\",\n    \"abc rn\": \"ABC\",\n    \"a s a\": \"ASA\",\n    \"a s a al\": \"ASA\",\n    \"asa al\": \"ASA\",\n    \"aguia negra\": \"Águia Negra\",\n    \"aimore\": \"Aimoré\",\n    \"avai\": \"Avaí\",\n    \"ceara\": \"Ceará\",\n    \"ceara sporting club\": \"Ceará\",\n    \"criciuma\": \"Criciúma\",\n    \"goias\": \"Goiás\",\n    \"nautico\": \"Náutico\",\n    \"vitoria\": \"Vitória\",\n    \"juventude\": \"Juventude\",\n    \"figueirense\": \"Figueirense\",\n    \"joinville\": \"Joinville\",\n    \"ponte preta\": \"Ponte Preta\",\n    \"portuguesa\": \"Portuguesa\",\n    \"santa cruz\": \"Santa Cruz\",\n    \"paysandu\": \"Paysandu\",\n    \"guarani\": \"Guarani\",\n    \"ipatinga\": \"Ipatinga\",\n    \"brasiliense\": \"Brasiliense\",\n    \"barueri\": \"Barueri\",\n    \"gremio barueri\": \"Barueri\",\n    \"fortaleza\": \"Fortaleza\",\n    \"fortaleza esporte clube\": \"Fortaleza\",\n    # Space-suffixed variants from BR-Football-Dataset that must not be\n    # confused with their more famous namesakes.\n    \"botafogo rj\": \"Botafogo\",\n    \"botafogo pb\": \"Botafogo-PB\",\n    \"botafogo sp\": \"Botafogo-SP\",\n    \"fluminense rj\": \"Fluminense\",\n    \"fluminense pi\": \"Fluminense-PI\",\n    \"santos ap\": \"Santos-AP\",\n    \"santa cruz rn\": \"Santa Cruz-RN\",\n    \"santa cruz rs\": \"Santa Cruz-RS\",\n    \"santa cruz\": \"Santa Cruz\",\n    \"vitoria es\": \"Vitória-ES\",\n    \"nautico rr\": \"Náutico-RR\",\n    \"juventude ma\": \"Juventude-MA\",\n    \"americano rj\": \"Americano\",\n    \"cuiaba mt\": \"Cuiabá\",\n    \"coritiba pr\": \"Coritiba\",\n    \"gremio rs\": \"Grêmio\",\n    \"internacional rs\": \"Internacional\",\n    \"caxias rs\": \"Caxias\",\n    \"guarani sp\": \"Guarani\",\n    \"audax sp\": \"Audax\",\n    \"vasco da gama rj\": \"Vasco da Gama\",\n    \"nacional am\": \"Nacional-AM\",\n    \"bragantino pa\": \"Bragantino-PA\",\n    \"ldu\": \"LDU Quito\",\n    \"ldu quito\": \"LDU Quito\",\n    \"ind santa fe\": \"Independiente Santa Fe\",\n    \"independiente santa fe\": \"Independiente Santa Fe\",\n    \"independiente del valle\": \"Independiente Del Valle\",\n    \"independiente medellin\": \"Independiente Medellín\",\n    \"atletico tucuman\": \"Atlético Tucumán\",\n    \"estudiantes de merida\": \"Estudiantes de Mérida\",\n    \"deportes tolima\": \"Deportes Tolima\",\n    \"junior de barranquilla\": \"Junior\",\n    \"junior\": \"Junior\",\n    \"cerro porteno\": \"Cerro Porteño\",\n    \"guarani par\": \"Guaraní\",\n    \"guarani asuncion\": \"Guaraní\",\n    \"club guarani\": \"Guaraní\",\n    \"defensor sporting\": \"Defensor Sporting\",\n    \"jorge wilstermann\": \"Jorge Wilstermann\",\n    \"colo colo\": \"Colo-Colo\",\n    \"barcelona equ\": \"Barcelona SC\",\n    \"barcelona sc\": \"Barcelona SC\",\n    \"barcelona ecuador\": \"Barcelona SC\",\n    \"delfin\": \"Delfín\",\n    \"delfin equ\": \"Delfín\",\n    \"nacional uru\": \"Nacional\",\n    \"nacional\": \"Nacional\",\n    \"nacional montevideo\": \"Nacional\",\n}\n\n# Pairs of canonical team names that are traditional rivalries.\nDERBIES = {\n    (\"Flamengo\", \"Fluminense\"): \"Fla-Flu\",\n    (\"Flamengo\", \"Vasco da Gama\"): \"Clássico dos Milhões\",\n    (\"Flamengo\", \"Botafogo\"): \"Clássico da Rivalidade\",\n    (\"Botafogo\", \"Fluminense\"): \"Clássico Vovô\",\n    (\"Botafogo\", \"Vasco da Gama\"): \"Clássico da Amizade\",\n    (\"Palmeiras\", \"São Paulo\"): \"Choque-Rei\",\n    (\"Corinthians\", \"São Paulo\"): \"Majestoso\",\n    (\"Corinthians\", \"Palmeiras\"): \"Dérbi Paulista\",\n    (\"Grêmio\", \"Internacional\"): \"Gre-Nal\",\n    (\"Bahia\", \"Vitória\"): \"Ba-Vi\",\n    (\"Athletico Paranaense\", \"Coritiba\"): \"Atletiba\",\n    (\"Ceará\", \"Fortaleza\"): \"Clássico-Rei\",\n}\n\n\ndef _display_fallback(base: str) -> str:\n    \"\"\"Title-case a suffix-stripped name while preserving accents/spacing.\"\"\"\n    out = []\n    for word in base.split(\" \"):\n        if not word:\n            continue\n        out.append(word[0].upper() + word[1:])\n    return \" \".join(out)\n\n\ndef strip_team_suffix(name: str) -> tuple[str, str | None]:\n    \"\"\"Split \"Palmeiras-SP\" -> (\"Palmeiras\", \"SP\"); returns (base, code|None).\"\"\"\n    cleaned = collapse_ws(name)\n    match = _SUFFIX_RE.match(cleaned)\n    if match and match.group(\"code\").upper() in _SUFFIX_CODES:\n        base = match.group(\"base\").strip(\" -–(\")\n        if base:\n            return base, match.group(\"code\").upper()\n    return cleaned, None\n\n\ndef normalize_team(name: str) -> str:\n    \"\"\"Canonicalize a team name across dataset conventions.\n\n    Handles: state suffixes (\"Palmeiras-SP\"), spaced suffixes (\"América - MG\"),\n    country codes (\"Nacional (URU)\", \"Guaraní-PAR\"), missing accents\n    (\"Sao Paulo\", \"Gremio\"), and known spelling variants (\"Athletico-PR\",\n    \"Atletico Goianiense\").\n    \"\"\"\n    if not name or not collapse_ws(name):\n        return \"\"\n    cleaned = collapse_ws(name)\n\n    key = text_key(cleaned)\n    if key in _TEAM_ALIASES:\n        return _TEAM_ALIASES[key]\n\n    base, _code = strip_team_suffix(cleaned)\n    if base != cleaned:\n        base_key = text_key(base)\n        if base_key in _TEAM_ALIASES:\n            return _TEAM_ALIASES[base_key]\n        return _display_fallback(base)\n    return cleaned\n\n\ndef team_key(name: str) -> str:\n    \"\"\"Stable identity key for a team after canonicalization.\"\"\"\n    return text_key(normalize_team(name))\n\n\n# Generic club-type tokens ignored when computing a team's identity key, so\n# \"Fortaleza\", \"Fortaleza FC\", and \"Fortaleza EC\" share one identity.\n_GENERIC_TOKENS = {\"fc\", \"ec\", \"sc\", \"cf\", \"club\", \"clube\", \"esporte\",\n                   \"futebol\"}\n_GENERIC_PAIRS = {\"esporte clube\", \"futebol clube\", \"sport club\"}\n\n\ndef identity_key(name: str) -> str:\n    \"\"\"Identity used for cross-file dedup and team matching.\n\n    Same as team_key but additionally ignores generic club-type tokens:\n    \"Fortaleza FC\" and \"Fortaleza\" share the identity \"fortaleza\".\n    \"\"\"\n    tokens = team_key(name).split()\n    while len(tokens) >= 2 and \" \".join(tokens[-2:]) in _GENERIC_PAIRS:\n        del tokens[-2:]\n    while tokens and tokens[-1] in _GENERIC_TOKENS:\n        tokens.pop()\n    while tokens and tokens[0] in _GENERIC_TOKENS:\n        tokens.pop(0)\n    return \" \".join(tokens)\n\n\ndef derby_name(team_a: str, team_b: str) -> str | None:\n    \"\"\"Return the rivalry name if two teams are a known derby, else None.\"\"\"\n    a, b = normalize_team(team_a), normalize_team(team_b)\n    pair = (a, b) if a < b else (b, a)\n    return DERBIES.get(pair)\n\n\n# ---------------------------------------------------------------------------\n# Date parsing\n# ---------------------------------------------------------------------------\n\n_DATE_FORMATS = (\n    \"%Y-%m-%d %H:%M:%S\",\n    \"%Y-%m-%dT%H:%M:%S\",\n    \"%Y-%m-%d\",\n    \"%d/%m/%Y %H:%M:%S\",\n    \"%d/%m/%Y\",\n    \"%d/%m/%y\",\n)\n\n\ndef parse_date(value: str | None) -> date | None:\n    \"\"\"Parse the date formats found across the datasets (or None).\"\"\"\n    if value is None:\n        return None\n    text = collapse_ws(str(value))\n    if not text or text.upper() in {\"NA\", \"N/A\", \"NULL\", \"NONE\"}:\n        return None\n    for fmt in _DATE_FORMATS:\n        try:\n            return datetime.strptime(text, fmt).date()\n        except ValueError:\n            continue\n    return None\n\n\ndef parse_season(value: str | int | None) -> int | None:\n    \"\"\"Parse a season/year cell (\"2012\", 2012, \"NA\") or None.\"\"\"\n    if value is None:\n        return None\n    text = collapse_ws(str(value))\n    if not text or text.upper() in {\"NA\", \"N/A\", \"NULL\", \"NONE\"}:\n        return None\n    match = re.match(r\"(\\d{4})\", text)\n    return int(match.group(1)) if match else None\n\n\ndef parse_int(value: str | float | int | None) -> int | None:\n    \"\"\"Parse a goals/score cell; missing or non-numeric becomes None.\"\"\"\n    if value is None:\n        return None\n    if isinstance(value, bool):\n        return None\n    if isinstance(value, (int, float)):\n        return int(value)\n    text = collapse_ws(str(value))\n    if not text or text.upper() in {\"NA\", \"N/A\", \"NULL\", \"NONE\", \"D\", \"E\", \"V\"}:\n        return None\n    try:\n        return int(float(text))\n    except ValueError:\n        return None\n\n\ndef parse_money(value: str | None) -> float | None:\n    \"\"\"Parse FIFA value/wage cells like \"€110.5M\" / \"€565K\" into euros.\"\"\"\n    if not value:\n        return None\n    text = strip_accents(value.strip().lstrip(\"€$R$ \").replace(\",\", \"\"))\n    if not text or text.upper() in {\"NA\", \"N/A\"}:\n        return None\n    multiplier = 1.0\n    if text and text[-1].upper() in {\"K\", \"M\", \"B\"}:\n        multiplier = {\"K\": 1e3, \"M\": 1e6, \"B\": 1e9}[text[-1].upper()]\n        text = text[:-1]\n    try:\n        return float(text) * multiplier\n    except ValueError:\n        return None","lineStart":1,"lineEnd":356,"totalLines":356,"truncated":false}},"title":"brazilian_soccer_mcp/normalize.py","time":{"start":1788228073767,"end":1788228073773}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05ab2f925001SsprED7MdqmEk0","sessionID":"ses_fa54e4cfeffeF35792XylHPXI3","messageID":"msg_05ab2da48001NWkGKu0BPgSnxL"}}
