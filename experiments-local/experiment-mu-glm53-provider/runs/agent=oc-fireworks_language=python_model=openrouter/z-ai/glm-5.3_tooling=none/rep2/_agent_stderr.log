timestamp=2026-09-01T05:41:53.341Z level=INFO run=f180ecb5 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, re, unicodedata, collections\nbase='data/kaggle/'\ndef fold(s):\n    s = unicodedata.normalize('NFKD', s)\n    s = ''.join(ch for ch in s if not unicodedata.combining(ch))\n    return re.sub(r'[^a-z0-9]', '', s.lower()).replace('athletico','atletico')\n\n# lib stages 2021/2022\nlib = list(csv.DictReader(open(base+'Libertadores_Matches.csv', encoding='utf-8-sig')))\nfor s in ('2021','2022'):\n    print('lib', s, collections.Counter(r['stage'] for r in lib if r['season']==s))\n\n# BR-Foot botafogo spellings\nbrf_names = collections.Counter()\nfor r in csv.DictReader(open(base+'BR-Football-Dataset.csv', encoding='utf-8-sig')):\n    brf_names[r['home']] += 1; brf_names[r['away']] += 1\nprint('brf names containing \"bota\":', {n:c for n,c in brf_names.items() if 'ota' in n})\nprint('brf names with dash or parens:', {n:c for n,c in brf_names.items() if '-' in n or '(' in n})\n\n# full ambiguous list per league-season\nstates = collections.defaultdict(set)\nfor r in csv.DictReader(open(base+'Brazilian_Cup_Matches.csv', encoding='utf-8-sig')):\n    for t in (r['home_team'], r['away_team']):\n        m = re.search(r'-\\s*([A-Z]{2})\\s*$', t)\n        if m: states[fold(re.sub(r'-\\s*[A-Z]{2}\\s*$', '', t))].add(m.group(1))\nfor r in csv.DictReader(open(base+'Brasileirao_Matches.csv', encoding='utf-8-sig')):\n    for t in (r['home_team'], r['away_team']):\n        m = re.search(r'-([A-Z]{2})$', t)\n        if m: states[fold(re.sub(r'-[A-Z]{2}$', '', t))].add(m.group(1))\namb = {b for b,s in states.items() if len(s)>1}\ncnt = collections.Counter()\nfor r in csv.DictReader(open(base+'BR-Football-Dataset.csv', encoding='utf-8-sig')):\n    if r['tournament'] == 'Copa do Brasil': continue\n    for side in ('home','away'):\n        b = fold(r[side])\n        if b in amb: cnt[(r['tournament'], r['date'][:4], b)] += 1\nprint('ALL ambiguous league rows:', len(cnt))\nfor k, v in sorted(cnt.items()):\n    if not k[0].startswith('Serie A') or k[2] not in ('flamengo','santos','internacional','bragantino'):\n        print('  ', k, v)\n\n# cup file truncated names\ncup_names = collections.Counter()\nfor r in csv.DictReader(open(base+'Brazilian_Cup_Matches.csv', encoding='utf-8-sig')):\n    cup_names[r['home_team']] += 1; cup_names[r['away_team']] += 1\nknown_bases = set()\nfor r in csv.DictReader(open(base+'Brasileirao_Matches.csv', encoding='utf-8-sig')):\n    known_bases.add(fold(re.sub(r'-[A-Z]{2}$', '', r['home_team'])))\ntrunc = [n for n in cup_names if re.search(r'-\\s*[A-Z]$', n) or (len(n) >= 24 and not re.search(r'-\\s*[A-Z]{2}\\s*$', n))]\nprint('possibly truncated cup names:', trunc)\n\n# BR-Foot Serie A fixtures not matching br (pair, season) - examples\nbr_pairs = set()\nfor r in csv.DictReader(open(base+'Brasileirao_Matches.csv', encoding='utf-8-sig')):\n    br_pairs.add((fold(re.sub(r'-[A-Z]{2}$','',r['home_team'])), fold(re.sub(r'-[A-Z]{2}$','',r['away_team'])), r['season']))\nunmatched = collections.Counter()\nfor r in csv.DictReader(open(base+'BR-Football-Dataset.csv', encoding='utf-8-sig')):\n    if r['tournament'] != 'Serie A': continue\n    s = r['date'][:4]\n    if (fold(r['home']), fold(r['away']), s) not in br_pairs:\n        unmatched[(r['home'], r['away'], s)] += 1\nprint('unmatched count:', sum(unmatched.values()))\nprint('sample unmatched:', list(unmatched)[:15])\nEOF" action.permission=bash action.action=allow action.pattern=*
