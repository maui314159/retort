timestamp=2026-09-01T05:20:48.402Z level=INFO run=7ae6fc3c message=evaluated permission=bash pattern="python - <<'EOF'\nimport csv, collections\nfrom soccer_mcp.clubs import resolve_club\nfrom soccer_mcp.normalize import parse_datetime\np='data/kaggle/'\nwith open(p+'BR-Football-Dataset.csv', encoding='utf-8') as f:\n    brf=[r for r in csv.DictReader(f)]\nwith open(p+'Brasileirao_Matches.csv', encoding='utf-8') as f:\n    bra=[r for r in csv.DictReader(f) if r['season']>='2014']\n\n# index brasileirao by (season, home_id, away_id) -> list of dates\nbidx = collections.defaultdict(list)\nfor r in bra:\n    bidx[(r['season'], resolve_club(r['home_team']).club_id, resolve_club(r['away_team']).club_id)].append(parse_datetime(r['datetime'])[0])\n\ndiffs = collections.Counter(); nomatch=0; total=0\nfor r in brf:\n    if r['tournament']!='Serie A': continue\n    d = parse_datetime(r['date'])[0]\n    season = str(d.year)\n    k = (season, resolve_club(r['home']).club_id, resolve_club(r['away']).club_id)\n    total += 1\n    if k not in bidx: nomatch+=1; continue\n    best = min(abs((d-x).days) for x in bidx[k])\n    diffs[best]+=1\nprint(\"Serie A rows:\", total, \"no fixture match (pairing not in file):\", nomatch)\nprint(\"date diff distribution:\", dict(sorted(diffs.items())))\n# same for Copa do Brasil\nwith open(p+'Brazilian_Cup_Matches.csv', encoding='utf-8') as f:\n    cup=[r for r in csv.DictReader(f)]\ncidx = collections.defaultdict(list)\nfor r in cup:\n    cidx[(r['season'], resolve_club(r['home_team']).club_id, resolve_club(r['away_team']).club_id)].append(parse_datetime(r['datetime'])[0])\ncd = collections.Counter(); cn=0; ct=0\nfor r in brf:\n    if r['tournament']!='Copa do Brasil': continue\n    d = parse_datetime(r['date'])[0]; season=str(d.year)\n    k = (season, resolve_club(r['home']).club_id, resolve_club(r['away']).club_id)\n    ct+=1\n    if k not in cidx: cn+=1; continue\n    cd[min(abs((d-x).days) for x in cidx[k])]+=1\nprint(\"Cup rows:\", ct, \"no fixture match:\", cn, dict(sorted(cd.items())))\nEOF" action.permission=bash action.action=allow action.pattern=*
