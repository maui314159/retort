timestamp=2026-08-31T19:38:34.291Z level=INFO run=615f6cc2 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, unicodedata, re\nfrom collections import Counter\n\ndef names(path, cols):\n    c = Counter()\n    with open(path, encoding='utf-8') as f:\n        for row in csv.DictReader(f):\n            for col in cols:\n                v = (row.get(col) or '').strip()\n                if v: c[v] += 1\n    return c\n\n# sample of team name variants per file\nfor path, cols, n in [\n    ('data/kaggle/Brasileirao_Matches.csv', ['home_team'], 60),\n    ('data/kaggle/Brazilian_Cup_Matches.csv', ['home_team'], 40),\n    ('data/kaggle/Libertadores_Matches.csv', ['home_team'], 40),\n    ('data/kaggle/BR-Football-Dataset.csv', ['home'], 40),\n    ('data/kaggle/novo_campeonato_brasileiro.csv', ['Equipe_mandante'], 60),\n]:\n    c = names(path, cols)\n    print(f\"=== {path.split('/')[-1]}: {len(c)} distinct ===\")\n    for name, _ in c.most_common(n): print(\"  \", name)\n    print()\nEOF" action.permission=bash action.action=allow action.pattern=*
