/data/kaggle/Libertadores_Matches.csv',['home_team','away_team']),\n  ('/workspace/data/kaggle/BR-Football-Dataset.csv',['home','away']),\n  ('/workspace/data/kaggle/novo_campeonato_brasileiro.csv',['Equipe_mandante','Equipe_visitante'])]:\n    collect(p, cc)\n\ndef canonical(name):\n    base, region = parse(name)\n    if not region and region_counts[base]: region = region_counts[base].most_common(1)[0][0]\n    return base + region.lower()\n\ndef parse_date(d):\n    d=(d or '').strip()\n    for fmt in ('%Y-%m-%d %H:%M:%S','%Y-%m-%d','%d/%m/%Y'):\n        try: return datetime.strptime(d, fmt).date().isoformat()\n        except ValueError: pass\n    return None\n\ndef to_int(v):\n    try: return int(float(v))\n    except (ValueError,TypeError): return None\n\ndef load(path, comp, h, a, hg, ag, d, s, flt=None):\n    out = []\n    with open(path, encoding='utf-8') as f:\n        for r in csv.DictReader(f):\n            if flt and not flt(r): continue\n            dd = parse_date(r[d]); ss = r[s] if s else (dd[:4] if dd else None)\n            out.append((comp, ss, canonical(r[h]), canonical(r[a]), to_int(r[hg]), to_int(r[ag]), dd))\n    return out\n\nrows = load('/workspace/data/kaggle/Brasileirao_Matches.csv','Serie A','home_team','away_team','home_goal','away_goal','datetime','season')\nrows += load('/workspace/data/kaggle/novo_campeonato_brasileiro.csv','Serie A','Equipe_mandante','Equipe_visitante','Gols_mandante','Gols_visitante','Data','Ano')\nrows += load('/workspace/data/kaggle/BR-Football-Dataset.csv','Serie A','home','away','home_goal','away_goal','date',None,flt=lambda r:r['tournament']=='Serie A')\n\nfor yr in ['2003','2012','2015','2019','2020','2021','2022','2023']:\n    sub=[r for r in rows if r[1]==yr]\n    k=Counter((r[2],r[3],r[6],r[4],r[5]) for r in sub)\n    print(\"Serie A\",yr,\"raw:\",len(sub),\"dedup:\",len(k))\nEOF"},"output":"Serie A 2003 raw: 552 dedup: 552\nSerie A 2012 raw: 760 dedup: 418\nSerie A 2015 raw: 1138 dedup: 505\nSerie A 2019 raw: