timestamp=2026-09-01T16:35:43.001Z level=INFO run=66fb43df message=evaluated permission=bash pattern="python3 << 'EOF'\nimport csv, re, unicodedata\nfrom collections import Counter, defaultdict\n\ndef load(f):\n    with open(f, encoding='utf-8') as fh:\n        return list(csv.DictReader(fh))\n\ndef strip_acc(s):\n    return ''.join(c for c in unicodedata.normalize('NFKD', s) if not unicodedata.combining(c))\n\nUFs = {'AC','AL','AM','AP','BA','CE','DF','ES','GO','MA','MG','MS','MT','PA','PB','PE','PI','PR','RJ','RN','RO','RR','RS','SC','SE','SP','TO'}\n\ndef canon(name):\n    s = strip_acc(name).lower()\n    s = re.sub(r'\\(.*?\\)', ' ', s)          # drop parentheticals for now\n    s = re.sub(r'[^a-z0-9]+', ' ', s).strip()\n    toks = s.split()\n    state = None\n    if len(toks) >= 2 and toks[-1].upper() in UFs and len(toks[-1]) == 2:\n        state = toks[-1]; toks = toks[:-1]\n    return ' '.join(toks) + ('-' + state.lower() if state else '')\n\nbr = load('data/kaggle/BR-Football-Dataset.csv')\n# check ambiguous bare bases in BR-Football\namb = ['vitoria','america','botafogo','atletico','athletico','flamengo','santos','bahia','sport','internacional','gremio','parana','goias','ceara','nautico','csa','criciuma','avai','coritiba']\nnames = set(r['home'] for r in br) | set(r['away'] for r in br)\ncanon_names = {n: canon(n) for n in sorted(names)}\nby_canon = defaultdict(list)\nfor n, c in canon_names.items(): by_canon[c].append(n)\nprint(\"BR-Football names whose canon base is ambiguous (no state):\")\nfor a in amb:\n    print(' ', a, '->', [by_canon.get(a + '-' + s, 'n/a') for s in []] or by_canon.get(a, 'NONE'))\nprint()\n# check suffix forms for these bases\nfor base in ['vitoria','america','botafogo','atletico','sport','bahia','ceara','csa','santos','gremio','flamengo','palmeiras','corinthians','sao paulo','vasco','cuiaba','athletico','parana','internacional','goias']:\n    forms = [k for k in by_canon if k.startswith(base)]\n    print(f'  {base!r:20} -> {sorted(forms)}')\nEOF" action.permission=bash action.action=allow action.pattern=*
