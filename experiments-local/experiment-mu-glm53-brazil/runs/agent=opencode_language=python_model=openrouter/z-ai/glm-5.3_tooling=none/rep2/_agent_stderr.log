timestamp=2026-08-31T19:06:11.826Z level=INFO run=ec94ecf4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv, unicodedata, re\nfrom collections import Counter\n\nUFS = {\"AC\",\"AL\",\"AP\",\"AM\",\"BA\",\"CE\",\"DF\",\"ES\",\"GO\",\"MA\",\"MT\",\"MS\",\"MG\",\"PA\",\"PB\",\"PR\",\"PE\",\"PI\",\"RJ\",\"RN\",\"RS\",\"RO\",\"RR\",\"SC\",\"SP\",\"SE\",\"TO\"}\nNOISE = {\"fc\",\"ec\",\"ac\",\"sc\",\"clube\",\"club\",\"do\",\"da\",\"de\",\"dos\",\"das\",\"e\",\"esporte\"}\n\ndef base_norm(t):\n    t = unicodedata.normalize(\"NFKD\", t).encode(\"ascii\",\"ignore\").decode().lower()\n    t = re.sub(r\"\\(.*?\\)\", \" \", t)\n    return re.sub(r\"[^a-z0-9]+\", \" \", t).strip()\n\ndef parse(t):\n    toks = base_norm(t).split()\n    uf = None\n    if len(toks) > 1 and toks[-1].upper() in UFS:\n        uf = toks[-1].upper(); toks = toks[:-1]\n    toks = [x for x in toks if x not in NOISE]\n    return \" \".join(toks), uf\n\nALIAS = {\"atletico mineiro\":\"atletico-mg\",\"atletico paranaense\":\"atletico-pr\",\"athletico paranaense\":\"atletico-pr\",\n         \"atletico goianiense\":\"atletico-go\",\"sport recife\":\"sport\",\"cs alagoano\":\"csa\",\"america mineiro\":\"america-mg\"}\n\ndef canon(name, uf=None):\n    bare, u = parse(name); u = u or uf\n    if bare in ALIAS: return ALIAS[bare]\n    if u: return f\"{bare}-{u.lower()}\"\n    return bare\n\ndef load(p):\n    with open(p, encoding=\"utf-8\") as f: return list(csv.DictReader(f))\n\nbra = load(\"data/kaggle/Brasileirao_Matches.csv\")\nbrf = load(\"data/kaggle/BR-Football-Dataset.csv\")\n\nfor yr in [\"2017\",\"2018\",\"2019\",\"2020\",\"2021\",\"2022\",\"2023\"]:\n    tb = {canon(r[\"home_team\"]) for r in bra if r[\"season\"]==yr} | {canon(r[\"away_team\"]) for r in bra if r[\"season\"]==yr}\n    tf = {canon(r[\"home\"]) for r in brf if r[\"tournament\"]==\"Serie A\" and r[\"date\"].startswith(yr)}\n    tf |= {canon(r[\"away\"]) for r in brf if r[\"tournament\"]==\"Serie A\" and r[\"date\"].startswith(yr)}\n    nb = sum(1 for r in bra if r[\"season\"]==yr)\n    nf = sum(1 for r in brf if r[\"tournament\"]==\"Serie A\" and r[\"date\"].startswith(yr))\n    print(yr, \"bra:\", nb, len(tb), \"brf:\", nf, len(tf), \"same teams:\", tb==tf, \"brf-bra:\", sorted(tf-tb)[:6], \"bra-brf:\", sorted(tb-tf)[:6])\nEOF" action.permission=bash action.action=allow action.pattern=*
