timestamp=2026-09-01T09:58:46.643Z level=INFO run=f27b5900 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv, re, unicodedata\nfrom collections import defaultdict\nfrom datetime import datetime, timedelta\n\ndef rows(p):\n    with open(p, encoding='utf-8-sig') as f:\n        return list(csv.DictReader(f))\n\nUF = {'AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'}\nALIAS = {'athletico pr':'atletico pr', 'vasco da gama':'vasco'}\n\ndef deacc(s):\n    return ''.join(c for c in unicodedata.normalize('NFD', s) if not unicodedata.combining(c))\n\ndef norm(name):\n    s = deacc(name).lower().replace('.', ' ')\n    s = re.sub(r'\\s+', ' ', s).strip()\n    s = re.sub(r'\\s*[-–]\\s*([a-z]{2})$', lambda m: '' if m.group(1).upper() in UF else m.group(0), s)\n    return ALIAS.get(s, s)\n\nbra = rows('data/kaggle/Brasileirao_Matches.csv')\nhist = rows('data/kaggle/novo_campeonato_brasileiro.csv')\nbf = rows('data/kaggle/BR-Football-Dataset.csv')\n\n# 2013: BRAS vs HIST — which keys don't match?\nbra13 = {(r['datetime'][:10], norm(r['home_team']), norm(r['away_team'])): r for r in bra if r['season']=='2013'}\nhist13 = {(datetime.strptime(r['Data'], '%d/%m/%Y').strftime('%Y-%m-%d'), norm(r['Equipe_mandante']), norm(r['Equipe_visitante'])): r for r in hist if r['Ano']=='2013'}\nprint(\"bras13:\", len(bra13), \"hist13:\", len(hist13), \"common:\", len(set(bra13)&set(hist13)))\nunm_b = set(bra13) - set(hist13)\nunm_h = set(hist13) - set(bra13)\nprint(\"unmatched bras:\", len(unm_b), \"unmatched hist:\", len(unm_h))\n# near-miss: same teams, different date\nh_by_teams = defaultdict(list)\nfor k in hist13: h_by_teams[(k[1],k[2])].append(k[0])\nnear = 0\nfor (d,h,a) in unm_b:\n    if (h,a) in h_by_teams:\n        for d2 in h_by_teams[(h,a)]:\n            dd = (datetime.strptime(d,'%Y-%m-%d') - datetime.strptime(d2,'%Y-%m-%d')).days\n            if abs(dd) <= 3:\n                near += 1\n                if near <= 5: print(\"  NEAR MISS:\", d, h, a, \"vs hist date\", d2, \"delta\", dd)\n                break\nprint(\"near-miss (same teams, |delta date| <= 3):\", near)\nprint(\"sample unmatched bras keys:\", list(unm_b)[:6])\nprint(\"sample unmatched hist keys:\", list(unm_h)[:6])\n# team key sets diff\nbt = {k[1] for k in bra13} | {k[2] for k in bra13}\nht = {k[1] for k in hist13} | {k[2] for k in hist13}\nprint(\"teams only in bras13:\", bt - ht)\nprint(\"teams only in hist13:\", ht - bt)\nEOF" action.permission=bash action.action=allow action.pattern=*
