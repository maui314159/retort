timestamp=2026-08-31T19:05:07.043Z level=INFO run=ec94ecf4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv, unicodedata, re\nfrom collections import Counter, defaultdict\n\nUFS = {\"AC\",\"AL\",\"AP\",\"AM\",\"BA\",\"CE\",\"DF\",\"ES\",\"GO\",\"MA\",\"MT\",\"MS\",\"MG\",\"PA\",\"PB\",\"PR\",\"PE\",\"PI\",\"RJ\",\"RN\",\"RS\",\"RO\",\"RR\",\"SC\",\"SP\",\"SE\",\"TO\"}\nNOISE = {\"fc\",\"ec\",\"ac\",\"sc\",\"clube\",\"club\",\"do\",\"da\",\"de\",\"dos\",\"das\",\"e\",\"esporte\"}\nALIAS = {\n    \"atletico mineiro\": \"atletico-mg\", \"atletico goianiense\": \"atletico-go\",\n    \"atletico paranaense\": \"atletico-pr\", \"athletico paranaense\": \"atletico-pr\",\n    \"sport recife\": \"sport\", \"cs alagoano\": \"csa\", \"ponte pretta\": \"ponte preta\",\n    \" america mineiro\": \"america-mg\", \"america fc minas gerais\": \"america-mg\",\n    \"america fc natal\": \"america-rn\", \"america rn\": \"america-rn\", \"america mg\": \"america-mg\",\n}\n\ndef base_norm(t):\n    t = unicodedata.normalize(\"NFKD\", t).encode(\"ascii\",\"ignore\").decode().lower()\n    t = re.sub(r\"\\(.*?\\)\", \" \", t)\n    t = re.sub(r\"[^a-z0-9]+\", \" \", t).strip()\n    return t\n\ndef parse_tokens(t):\n    toks = base_norm(t).split()\n    uf = None\n    if len(toks) > 1 and toks[-1].upper() in UFS:\n        uf = toks[-1].upper(); toks = toks[:-1]\n    toks = [x for x in toks if x not in NOISE]\n    return \" \".join(toks), uf\n\n# Build registry from authoritative match files (bare, uf) pairs\nregistry = defaultdict(set)  # bare -> {uf}\ndef reg(name, uf=None):\n    bare, u = parse_tokens(name)\n    u = u or uf\n    if not bare: return\n    if u: registry[bare].add(u)\n    else: registry[bare].add(None)\n\nwith open(\"data/kaggle/Brasileirao_Matches.csv\", encoding=\"utf-8\") as f:\n    for r in csv.DictReader(f):\n        reg(r[\"home_team\"], r[\"home_team_state\"]); reg(r[\"away_team\"], r[\"away_team_state\"])\nwith open(\"data/kaggle/novo_campeonato_brasileiro.csv\", encoding=\"utf-8\") as f:\n    for r in csv.DictReader(f):\n        reg(r[\"Equipe_mandante\"], r[\"Mandante_UF\"]); reg(r[\"Equipe_visitante\"], r[\"Visitante_UF\"])\nwith open(\"data/kaggle/Brazilian_Cup_Matches.csv\", encoding=\"utf-8\") as f:\n    for r in csv.DictReader(f):\n        reg(r[\"home_team\"]); reg(r[\"away_team\"])\nwith open(\"data/kaggle/Libertadores_Matches.csv\", encoding=\"utf-8\") as f:\n    for r in csv.DictReader(f):\n        reg(r[\"home_team\"]); reg(r[\"away_team\"])\n\nambiguous = {b: ufs for b, ufs in registry.items() if len(ufs - {None}) > 1}\nprint(\"ambiguous bares:\", sorted(ambiguous.items()))\nprint(\"registry size:\", len(registry))\nEOF" action.permission=bash action.action=allow action.pattern=*
