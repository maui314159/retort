=\"Série A\", venue=\"home\")\nprint(\"Corinthians home 2022:\", ts.matches, ts.wins, ts.draws, ts.losses, ts.goals_for, ts.goals_against)\n\n# players\nbrs = e.search_players(nationality=\"Brazilian\", limit=5)\nprint(\"Top Brazilians:\", [(p.name, p.overall, p.club_display, p.position) for p in brs])\nfluminense = e.search_players(club=\"Fluminense\")\nprint(\"Fluminense players:\", len(fluminense))\nfwd = e.search_players(club=\"Santos\", position=\"forward\")\nprint(\"Santos forwards:\", [(p.name, p.position, p.overall) for p in fwd])\ntry:\n    e.search_players(name=\"Gabriel Barbosa\")\nexcept Exception as ex:\n    print(\"Gabriel Barbosa:\", type(ex).__name__, ex)\n\n# stats\ns = e.statistics(competition=\"Série A\", season=2019)\nprint(f\"2019 Serie A: {s.matches} matches, avg {s.avg_goals:.2f} goals, home win {s.home_win_rate:.1%}, draw {s.draw_rate:.1%}, away {s.away_win_rate:.1%}\")\nprint(\"biggest home win:\", s.biggest_home_win.date, s.biggest_home_win.home_display, s.biggest_home_win.home_goals, \"-\", s.biggest_home_win.away_goals, s.biggest_home_win.away_display)\n\nbw = e.biggest_wins(competition=\"Brasileirão\")\nprint(\"Biggest wins:\", [(m.date, m.home_display, f\"{m.home_goals}-{m.away_goals}\", m.away_display, m.competition) for m in bw[:5]])\n\n# derbies\nd = e.derbies(derby=\"Fla-Flu\")\nprint(\"Fla-Flu derby:\", d[0].total, \"matches\", d[0].team_a_wins, d[0].draws, d[0].team_b_wins)\nall_d = e.derbies()\nprint(\"Derbies found:\", [(x.derby.name, x.total) for x in all_d])\n\n# find team\nti = e.find_team(\"Timão\")\nprint(\"find Timão:\", ti.key, ti.display, ti.match_count, \"matches, players:\", ti.player_count, \"comps:\", list(ti.competitions)[:3])\nEOF","workdir":"/Users/maui/.retort/work/retort-local-bgij0ztn/retort-d0fbbb4f4ea5"},"output":"Fla-Flu Brasileirão: 43 matches; first: 2023-11-11 Flamengo 1 - 1 Fluminense | Brasileirão Série A\nLib 2019 final: [(datetime.date(2019, 11, 23), 'Flamengo', 2, 1, 'River Plate')]\nCup finals: 18 [