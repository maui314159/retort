timestamp=2026-08-31T18:37:53.578Z level=INFO run=9abcf33e message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv\nfrom collections import Counter\n\ndef load(path):\n    with open(path, encoding='utf-8') as f:\n        return list(csv.DictReader(f))\n\n# BR-Football seasons per tournament\nrows = load('data/kaggle/BR-Football-Dataset.csv')\nfor t in ['Serie A','Serie B','Serie C','Copa do Brasil']:\n    seasons = sorted(set(r['date'][:4] for r in rows if r['tournament']==t))\n    print(t, \"seasons:\", seasons)\n\n# check overlap: Brasileirao_Matches 2012-2019 vs novo 2012-2019\nbm = load('data/kaggle/Brasileirao_Matches.csv')\nnv = load('data/kaggle/novo_campeonato_brasileiro.csv')\nbm_keys = set((r['datetime'][:10], r['home_team'], r['away_team']) for r in bm if r['season']<='2019')\nnv_keys = set((r['Data'][6:]+'-'+r['Data'][3:5]+'-'+r['Data'][:2], r['Equipe_mandante'], r['Equipe_visitante']) for r in nv if r['Ano']>='2012')\nprint(\"\\nBrasileirao_Matches 2012-19 keys:\", len(bm_keys), \" novo 2012-19 keys:\", len(nv_keys))\ninter = bm_keys & nv_keys\nprint(\"exact-date overlaps:\", len(inter))\n# sample differences\ndiff_bm = list(bm_keys - nv_keys)[:3]\nprint(\"only in BM:\", diff_bm)\ndiff_nv = list(nv_keys - bm_keys)[:3]\nprint(\"only in novo:\", diff_nv)\n\n# BR-Football Serie A vs Brasileirao_Matches overlap\nbrfa = set((r['date'], r['home'], r['away']) for r in rows if r['tournament']=='Serie A')\nprint(\"\\nBR-Football Serie A sample:\", sorted(brfa)[:3])\nprint(\"BR-Football Serie A years:\", sorted(set(k[0][:4] for k in brfa)))\nEOF" action.permission=bash action.action=allow action.pattern=*
