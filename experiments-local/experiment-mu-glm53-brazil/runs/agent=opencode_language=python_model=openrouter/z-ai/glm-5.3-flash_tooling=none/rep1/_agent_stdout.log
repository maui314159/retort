{"type":"tool_use","timestamp":1788228081814,"sessionID":"ses_fa54e4cfeffeF35792XylHPXI3","part":{"type":"tool","tool":"read","callID":"call_30249b2d0a4d4a549bdcb421","state":{"status":"completed","input":{"filePath":"/Users/maui/.retort/work/retort-local-75154ofp/retort-242ce4667ad2/brazilian_soccer_mcp/queries.py"},"output":"<path>/Users/maui/.retort/work/retort-local-75154ofp/retort-242ce4667ad2/brazilian_soccer_mcp/queries.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Query engine answering match, team, player, competition, and stats questions.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: from collections import defaultdict\n6: \n7: from .data_loader import COMPETITION_ALIASES, Dataset, Match, Player\n8: from .normalize import (\n9:     DERBIES,\n10:     derby_name,\n11:     normalize_team,\n12:     parse_date,\n13:     team_key,\n14:     text_key,\n15: )\n16: \n17: POSITION_CATEGORIES = {\n18:     \"goalkeeper\": {\"GK\"},\n19:     \"defender\": {\"LB\", \"LWB\", \"CB\", \"LCB\", \"RCB\", \"RB\", \"RWB\"},\n20:     \"midfielder\": {\"CDM\", \"LDM\", \"RDM\", \"CM\", \"LCM\", \"RCM\", \"LM\", \"RM\",\n21:                    \"CAM\", \"LAM\", \"RAM\"},\n22:     \"forward\": {\"ST\", \"LS\", \"RS\", \"CF\", \"LF\", \"RF\", \"LW\", \"RW\"},\n23: }\n24: \n25: DEFAULT_MATCH_LIMIT = 20\n26: DEFAULT_PLAYER_LIMIT = 25\n27: \n28: \n29: class QueryEngine:\n30:     \"\"\"Answer structured queries over the loaded dataset.\"\"\"\n31: \n32:     def __init__(self, dataset: Dataset) -> None:\n33:         self.dataset = dataset\n34: \n35:     # ------------------------------------------------------------------\n36:     # Helpers\n37:     # ------------------------------------------------------------------\n38: \n39:     def _resolve_competition(self, competition: str | None) -> str | None:\n40:         \"\"\"Map a user competition label onto the canonical one (or None).\"\"\"\n41:         if not competition:\n42:             return None\n43:         return COMPETITION_ALIASES.get(text_key(competition), competition.strip())\n44: \n45:     def _date_range(\n46:         self, date_from: str | None, date_to: str | None\n47:     ) -> tuple[str | None, str | None]:\n48:         lo = parse_date(date_from)\n49:         hi = parse_date(date_to)\n50:         return (lo.isoformat() if lo else None, hi.isoformat() if hi else None)\n51: \n52:     @staticmethod\n53:     def _match_team(match: Match, team: str) -> str | None:\n54:         if match.home_team == team:\n55:             return \"home\"\n56:         if match.away_team == team:\n57:             return \"away\"\n58:         return None\n59: \n60:     @staticmethod\n61:     def _match_line(match: Match) -> str:\n62:         \"\"\"Human-readable one-line summary of a match.\"\"\"\n63:         home = str(match.home_goals) if match.home_goals is not None else \"?\"\n64:         away = str(match.away_goals) if match.away_goals is not None else \"?\"\n65:         label = match.competition\n66:         if match.stage:\n67:             label += f\" {match.stage.title()}\"\n68:         elif match.round:\n69:             label += f\" Round {match.round}\"\n70:         return (\n71:             f\"{match.date or 'unknown date'}: \"\n72:             f\"{match.home_team} {home}-{away} {match.away_team} ({label})\"\n73:         )\n74: \n75:     @staticmethod\n76:     def _record(matches: list[Match], team: str) -> dict:\n77:         \"\"\"W/D/L, GF/GA record for one team across matches.\"\"\"\n78:         wins = draws = losses = goals_for = goals_against = 0\n79:         played = 0\n80:         for match in matches:\n81:             if match.home_goals is None or match.away_goals is None:\n82:                 continue\n83:             played += 1\n84:             if match.home_team == team:\n85:                 gf, ga = match.home_goals, match.away_goals\n86:             elif match.away_team == team:\n87:                 gf, ga = match.away_goals, match.home_goals\n88:             else:\n89:                 continue\n90:             goals_for += gf\n91:             goals_against += ga\n92:             if gf > ga:\n93:                 wins += 1\n94:             elif gf < ga:\n95:                 losses += 1\n96:             else:\n97:                 draws += 1\n98:         return {\n99:             \"played\": played,\n100:             \"wins\": wins,\n101:             \"draws\": draws,\n102:             \"losses\": losses,\n103:             \"goals_for\": goals_for,\n104:             \"goals_against\": goals_against,\n105:             \"win_rate\": round(wins / played * 100, 1) if played else 0.0,\n106:         }\n107: \n108:     @staticmethod\n109:     def _pair_record(matches: list[Match], team_a: str, team_b: str) -> dict:\n110:         \"\"\"Head-to-head W/D/L for team_a vs team_b from matches.\"\"\"\n111:         record = {\"team_a\": team_a, \"team_b\": team_b, \"team_a_wins\": 0,\n112:                   \"team_b_wins\": 0, \"draws\": 0}\n113:         for match in matches:\n114:             if match.home_goals is None or match.away_goals is None:\n115:                 continue\n116:             pair = {match.home_team, match.away_team}\n117:             if pair != {team_a, team_b}:\n118:                 continue\n119:             home_goals, away_goals = match.home_goals, match.away_goals\n120:             if home_goals == away_goals:\n121:                 record[\"draws\"] += 1\n122:             else:\n123:                 winner = match.home_team if home_goals > away_goals else match.away_team\n124:                 if winner == team_a:\n125:                     record[\"team_a_wins\"] += 1\n126:                 else:\n127:                     record[\"team_b_wins\"] += 1\n128:         return record\n129: \n130:     def _h2h_matches(self, team_a: str, team_b: str) -> list[Match]:\n131:         a = self.dataset.resolve_team(team_a)\n132:         b = self.dataset.resolve_team(team_b)\n133:         return [\n134:             m for m in self.dataset.matches_for_team(a)\n135:             if b in (m.home_team, m.away_team)\n136:         ]\n137: \n138:     @staticmethod\n139:     def _filtered_record_summary(matches: list[Match], team: str) -> dict | None:\n140:         \"\"\"Record of `team` inside an arbitrary filtered match list.\"\"\"\n141:         if not team:\n142:             return None\n143:         record = QueryEngine._record(\n144:             [m for m in matches if team in (m.home_team, m.away_team)], team\n145:         )\n146:         return record if record[\"played\"] else None\n147: \n148:     # ------------------------------------------------------------------\n149:     # 1. Match queries\n150:     # ------------------------------------------------------------------\n151: \n152:     def search_matches(\n153:         self,\n154:         team: str | None = None,\n155:         opponent: str | None = None,\n156:         competition: str | None = None,\n157:         season: int | None = None,\n158:         date_from: str | None = None,\n159:         date_to: str | None = None,\n160:         round_or_stage: str | None = None,\n161:         limit: int = DEFAULT_MATCH_LIMIT,\n162:     ) -> dict:\n163:         \"\"\"Find matches by team/opponent/competition/season/date range.\"\"\"\n164:         canonical_team = self.dataset.resolve_team(team) if team else None\n165:         canonical_opponent = self.dataset.resolve_team(opponent) if opponent else None\n166:         if canonical_opponent and not canonical_team:\n167:             canonical_team, canonical_opponent = canonical_opponent, None\n168: \n169:         if canonical_team and canonical_opponent:\n170:             pool = self._h2h_matches(canonical_team, canonical_opponent)\n171:         elif canonical_team:\n172:             pool = self.dataset.matches_for_team(canonical_team)\n173:         else:\n174:             pool = self.dataset.matches\n175: \n176:         comp = self._resolve_competition(competition)\n177:         lo, hi = self._date_range(date_from, date_to)\n178:         stage_key = text_key(round_or_stage) if round_or_stage else None\n179: \n180:         results: list[Match] = []\n181:         for match in pool:\n182:             if comp and match.competition != comp:\n183:                 continue\n184:             if season is not None and match.season != season:\n185:                 continue\n186:             if lo and (not match.date or match.date < lo):\n187:                 continue\n188:             if hi and (not match.date or match.date > hi):\n189:                 continue\n190:             if stage_key:\n191:                 label = text_key(match.stage or \"\") or text_key(f\"round {match.round or ''}\")\n192:                 if stage_key not in label:\n193:                     continue\n194:             results.append(match)\n195: \n196:         results.sort(key=lambda m: (m.date or \"\"), reverse=True)\n197:         total = len(results)\n198:         shown = results[: max(1, limit)]\n199: \n200:         summary: dict = {}\n201:         if canonical_team and canonical_opponent:\n202:             summary = self._pair_record(results, canonical_team, canonical_opponent)\n203:         elif canonical_team:\n204:             record = self._filtered_record_summary(results, canonical_team)\n205:             if record:\n206:                 summary = {\"team\": canonical_team, **record}\n207: \n208:         return {\n209:             \"query\": {\n210:                 \"team\": canonical_team,\n211:                 \"opponent\": canonical_opponent,\n212:                 \"competition\": comp,\n213:                 \"season\": season,\n214:                 \"date_from\": lo,\n215:                 \"date_to\": hi,\n216:                 \"round_or_stage\": round_or_stage,\n217:             },\n218:             \"total_matches\": total,\n219:             \"returned\": len(shown),\n220:             \"note\": (\n221:                 f\"Showing {len(shown)} of {total} matches. Increase limit to see more.\"\n222:                 if total > len(shown)\n223:                 else None\n224:             ),\n225:             \"matches\": [\n226:                 {**m.to_dict(), \"line\": self._match_line(m)} for m in shown\n227:             ],\n228:             \"summary\": summary or None,\n229:         }\n230: \n231:     # ------------------------------------------------------------------\n232:     # 2. Team queries\n233:     # ------------------------------------------------------------------\n234: \n235:     def get_team_stats(\n236:         self,\n237:         team: str,\n238:         competition: str | None = None,\n239:         season: int | None = None,\n240:         venue: str | None = None,\n241:     ) -> dict:\n242:         \"\"\"W/D/L record, goals, and win rate for one team.\"\"\"\n243:         canonical = self.dataset.resolve_team(team)\n244:         comp = self._resolve_competition(competition)\n245:         matches = self.dataset.matches_for_team(canonical)\n246:         if comp:\n247:             matches = [m for m in matches if m.competition == comp]\n248:         if season is not None:\n249:             matches = [m for m in matches if m.season == season]\n250: \n251:         venue_norm = (venue or \"all\").lower()\n252:         if venue_norm not in {\"all\", \"home\", \"away\"}:\n253:             venue_norm = \"all\"\n254:         selected = [\n255:             m for m in matches\n256:             if venue_norm == \"all\"\n257:             or (venue_norm == \"home\" and m.home_team == canonical)\n258:             or (venue_norm == \"away\" and m.away_team == canonical)\n259:         ]\n260: \n261:         competitions_played = sorted({m.competition for m in matches})\n262:         seasons_played = sorted({m.season for m in matches if m.season})\n263: \n264:         return {\n265:             \"team\": canonical,\n266:             \"competition\": comp or \"all\",\n267:             \"season\": season,\n268:             \"venue\": venue_norm,\n269:             \"record\": self._record(selected, canonical),\n270:             \"competitions_played\": competitions_played,\n271:             \"seasons_played\": seasons_played,\n272:         }\n273: \n274:     def head_to_head(self, team_a: str, team_b: str) -> dict:\n275:         \"\"\"Head-to-head record plus the most recent meetings.\"\"\"\n276:         a = self.dataset.resolve_team(team_a)\n277:         b = self.dataset.resolve_team(team_b)\n278:         matches = self._h2h_matches(a, b)\n279:         matches.sort(key=lambda m: (m.date or \"\"), reverse=True)\n280:         return {\n281:             \"team_a\": a,\n282:             \"team_b\": b,\n283:             \"derby\": derby_name(a, b),\n284:             \"record\": self._pair_record(matches, a, b),\n285:             \"last_meeting\": self._match_line(matches[0]) if matches else None,\n286:             \"recent_matches\": [\n287:                 {**m.to_dict(), \"line\": self._match_line(m)} for m in matches[:5]\n288:             ],\n289:         }\n290: \n291:     def get_team_competitions(self, team: str) -> dict:\n292:         \"\"\"Which competitions (and seasons) a team appears in across all files.\"\"\"\n293:         canonical = self.dataset.resolve_team(team)\n294:         matches = self.dataset.matches_for_team(canonical)\n295:         counts: dict[str, int] = defaultdict(int)\n296:         seasons_by_comp: dict[str, set[int]] = defaultdict(set)\n297:         for match in matches:\n298:             counts[match.competition] += 1\n299:             if match.season:\n300:                 seasons_by_comp[match.competition].add(match.season)\n301:         return {\n302:             \"team\": canonical,\n303:             \"total_matches\": len(matches),\n304:             \"competitions\": {\n305:                 comp: {\n306:                     \"matches\": counts[comp],\n307:                     \"seasons\": sorted(seasons_by_comp[comp]),\n308:                 }\n309:                 for comp in sorted(counts)\n310:             },\n311:         }\n312: \n313:     # ------------------------------------------------------------------\n314:     # 3. Player queries\n315:     # ------------------------------------------------------------------\n316: \n317:     def search_players(\n318:         self,\n319:         name: str | None = None,\n320:         nationality: str | None = None,\n321:         club: str | None = None,\n322:         position: str | None = None,\n323:         position_category: str | None = None,\n324:         min_overall: int | None = None,\n325:         max_overall: int | None = None,\n326:         limit: int = DEFAULT_PLAYER_LIMIT,\n327:     ) -> dict:\n328:         \"\"\"Search FIFA player data by name/nationality/club/position/rating.\"\"\"\n329:         name_key = text_key(name) if name else None\n330:         name_tokens = set(name_key.split()) if name_key else None\n331:         nat_key = text_key(nationality) if nationality else None\n332:         positions: set[str] | None = None\n333:         if position:\n334:             positions = {position.strip().upper()}\n335:         elif position_category:\n336:             category = position_category.strip().lower()\n337:             positions = POSITION_CATEGORIES.get(category)\n338:             if positions is None:\n339:                 return {\n340:                     \"error\": (\n341:                         f\"Unknown position category '{position_category}'. \"\n342:                         f\"Options: {sorted(POSITION_CATEGORIES)}\"\n343:                     )\n344:                 }\n345: \n346:         candidates = self.dataset.players\n347:         if club:\n348:             candidates = self._match_club(candidates, club)\n349: \n350:         results: list[Player] = []\n351:         for player in candidates:\n352:             if name_key:\n353:                 player_key = text_key(player.name)\n354:                 player_tokens = set(player_key.split())\n355:                 if not (name_tokens <= player_tokens or name_key in player_key):\n356:                     continue\n357:             if nat_key:\n358:                 player_nat = text_key(player.nationality)\n359:                 if nat_key not in player_nat and player_nat not in nat_key:\n360:                     continue\n361:             if positions and player.position not in positions:\n362:                 continue\n363:             if min_overall is not None and player.overall < min_overall:\n364:                 continue\n365:             if max_overall is not None and player.overall > max_overall:\n366:                 continue\n367:             results.append(player)\n368: \n369:         results.sort(key=lambda p: (-p.overall, p.name))\n370:         total = len(results)\n371:         shown = results[: max(1, limit)]\n372: \n373:         by_club: dict[str, list[int]] = defaultdict(list)\n374:         if nat_key and not club:\n375:             for player in results:\n376:                 if player.club:\n377:                     by_club[player.club].append(player.overall)\n378:             club_summary = [\n379:                 {\n380:                     \"club\": club_name,\n381:                     \"players\": len(ratings),\n382:                     \"avg_overall\": round(sum(ratings) / len(ratings), 1),\n383:                 }\n384:                 for club_name, ratings in sorted(\n385:                     by_club.items(), key=lambda kv: -len(kv[1])\n386:                 )[:10]\n387:             ]\n388:         else:\n389:             club_summary = None\n390: \n391:         return {\n392:             \"query\": {\n393:                 \"name\": name,\n394:                 \"nationality\": nationality,\n395:                 \"club\": club,\n396:                 \"position\": position,\n397:                 \"position_category\": position_category,\n398:                 \"min_overall\": min_overall,\n399:                 \"max_overall\": max_overall,\n400:             },\n401:             \"matched_clubs\": sorted({p.club for p in candidates})[:10] if club else None,\n402:             \"total_players\": total,\n403:             \"returned\": len(shown),\n404:             \"players\": [self._player_dict(p) for p in shown],\n405:             \"clubs_with_brazilian_players\": club_summary,\n406:         }\n407: \n408:     @staticmethod\n409:     def _match_club(players: list[Player], club: str) -> list[Player]:\n410:         \"\"\"Filter players by club with exact > prefix > contains ranking.\"\"\"\n411:         wanted = text_key(club)\n412:         exact: list[Player] = []\n413:         prefix: list[Player] = []\n414:         contains: list[Player] = []\n415:         for player in players:\n416:             player_club = text_key(player.club)\n417:             if not player_club:\n418:                 continue\n419:             if player_club == wanted:\n420:                 exact.append(player)\n421:             elif player_club.startswith(wanted):\n422:                 prefix.append(player)\n423:             elif wanted in player_club:\n424:                 contains.append(player)\n425:         return exact + prefix + contains\n426: \n427:     @staticmethod\n428:     def _player_dict(player: Player) -> dict:\n429:         data = player.to_dict()\n430:         data.pop(\"skills\")\n431:         return data\n432: \n433:     # ------------------------------------------------------------------\n434:     # 4. Competition queries\n435:     # ------------------------------------------------------------------\n436: \n437:     def get_standings(self, competition: str, season: int) -> dict:\n438:         \"\"\"League table calculated from match results for one season.\"\"\"\n439:         comp = self._resolve_competition(competition)\n440:         if not comp:\n441:             return {\"error\": \"competition is required\"}\n442:         matches = [\n443:             m for m in self.dataset.matches\n444:             if m.competition == comp\n445:             and m.season == season\n446:             and m.home_goals is not None\n447:             and m.away_goals is not None\n448:         ]\n449:         if not matches:\n450:             return {\n451:                 \"error\": (\n452:                     f\"No completed {comp} matches found for season {season}.\"\n453:                 )\n454:             }\n455: \n456:         table: dict[str, dict] = {}\n457:         for match in matches:\n458:             for team, gf, ga in (\n459:                 (match.home_team, match.home_goals, match.away_goals),\n460:                 (match.away_team, match.away_goals, match.home_goals),\n461:             ):\n462:                 row = table.setdefault(\n463:                     team,\n464:                     {\n465:                         \"team\": team, \"played\": 0, \"wins\": 0, \"draws\": 0,\n466:                         \"losses\": 0, \"goals_for\": 0, \"goals_against\": 0,\n467:                     },\n468:                 )\n469:                 row[\"played\"] += 1\n470:                 row[\"goals_for\"] += gf\n471:                 row[\"goals_against\"] += ga\n472:                 if gf > ga:\n473:                     row[\"wins\"] += 1\n474:                 elif gf < ga:\n475:                     row[\"losses\"] += 1\n476:                 else:\n477:                     row[\"draws\"] += 1\n478: \n479:         rows = sorted(\n480:             table.values(),\n481:             key=lambda r: (\n482:                 3 * r[\"wins\"] + r[\"draws\"],\n483:                 r[\"wins\"],\n484:                 r[\"goals_for\"] - r[\"goals_against\"],\n485:                 r[\"goals_for\"],\n486:                 r[\"team\"],\n487:             ),\n488:             reverse=True,\n489:         )\n490:         standings = []\n491:         for position, row in enumerate(rows, start=1):\n492:             points = 3 * row[\"wins\"] + row[\"draws\"]\n493:             note = \"Champion\" if position == 1 else None\n494:             standings.append(\n495:                 {\n496:                     \"position\": position,\n497:                     **row,\n498:                     \"goal_difference\": row[\"goals_for\"] - row[\"goals_against\"],\n499:                     \"points\": points,\n500:                     \"note\": note,\n501:                 }\n502:             )\n503:         if len(rows) == 20:\n504:             for row in standings[-4:]:\n505:                 row[\"note\"] = \"Relegation zone\"\n506: \n507:         matches_per_team = {row[\"played\"] for row in rows}\n508:         complete = len(matches_per_team) == 1\n509:         return {\n510:             \"competition\": comp,\n511:             \"season\": season,\n512:             \"matches_used\": len(matches),\n513:             \"teams\": len(rows),\n514:             \"table_complete\": complete,\n515:             \"note\": None if complete else (\n516:                 \"Season appears incomplete in the dataset (teams played a \"\n517:                 \"varying number of matches); positions are indicative only.\"\n518:             ),\n519:             \"standings\": standings,\n520:         }\n521: \n522:     def get_season_summary(self, season: int) -> dict:\n523:         \"\"\"Aggregate statistics for one season across competitions.\"\"\"\n524:         return self._season_summary(season)\n525: \n526:     def compare_seasons(self, season_a: int, season_b: int) -> dict:\n527:         \"\"\"Side-by-side aggregate statistics for two seasons.\"\"\"\n528:         return {\n529:             \"season_a\": self._season_summary(season_a),\n530:             \"season_b\": self._season_summary(season_b),\n531:         }\n532: \n533:     def _season_summary(self, season: int) -> dict:\n534:         by_comp: dict[str, list[Match]] = defaultdict(list)\n535:         for match in self.dataset.matches:\n536:             if match.season == season:\n537:                 by_comp[match.competition].append(match)\n538: \n539:         champions = {}\n540:         for comp in (\"Brasileirão\", \"Serie B\", \"Serie C\"):\n541:             standings = self.get_standings(comp, season)\n542:             if \"error\" not in standings and standings[\"standings\"]:\n543:                 top = standings[\"standings\"][0]\n544:                 champions[comp] = {\n545:                     \"team\": top[\"team\"],\n546:                     \"points\": top[\"points\"],\n547:                     \"record\": (\n548:                         f\"{top['wins']}W {top['draws']}D {top['losses']}L\"\n549:                     ),\n550:                 }\n551: \n552:         competitions = {}\n553:         for comp, comp_matches in sorted(by_comp.items()):\n554:             with_goals = [\n555:                 m for m in comp_matches\n556:                 if m.home_goals is not None and m.away_goals is not None\n557:             ]\n558:             total_goals = sum(m.home_goals + m.away_goals for m in with_goals)\n559:             home_wins = sum(\n560:                 1 for m in with_goals if m.home_goals > m.away_goals\n561:             )\n562:             draws = sum(1 for m in with_goals if m.home_goals == m.away_goals)\n563:             competitions[comp] = {\n564:                 \"matches\": len(with_goals),\n565:                 \"total_goals\": total_goals,\n566:                 \"avg_goals_per_match\": (\n567:                     round(total_goals / len(with_goals), 2) if with_goals else None\n568:                 ),\n569:                 \"home_win_rate\": (\n570:                     round(home_wins / len(with_goals) * 100, 1)\n571:                     if with_goals else None\n572:                 ),\n573:                 \"draw_rate\": (\n574:                     round(draws / len(with_goals) * 100, 1) if with_goals else None\n575:                 ),\n576:             }\n577:         return {\"season\": season, \"competitions\": competitions,\n578:                 \"champions\": champions or None}\n579: \n580:     # ------------------------------------------------------------------\n581:     # 5. Statistical analysis\n582:     # ------------------------------------------------------------------\n583: \n584:     def get_competition_stats(\n585:         self,\n586:         competition: str | None = None,\n587:         season: int | None = None,\n588:         top: int = 5,\n589:     ) -> dict:\n590:         \"\"\"Aggregate statistics: goals, home advantage, biggest wins.\"\"\"\n591:         comp = self._resolve_competition(competition)\n592:         matches = self.dataset.matches\n593:         if comp:\n594:             matches = [m for m in matches if m.competition == comp]\n595:         if season is not None:\n596:             matches = [m for m in matches if m.season == season]\n597:         with_goals = [\n598:             m for m in matches\n599:             if m.home_goals is not None and m.away_goals is not None\n600:         ]\n601: \n602:         total_goals = sum(m.home_goals + m.away_goals for m in with_goals)\n603:         home_wins = sum(1 for m in with_goals if m.home_goals > m.away_goals)\n604:         away_wins = sum(1 for m in with_goals if m.home_goals < m.away_goals)\n605:         draws = sum(1 for m in with_goals if m.home_goals == m.away_goals)\n606: \n607:         goals_by_team: dict[str, int] = defaultdict(int)\n608:         biggest = sorted(\n609:             with_goals,\n610:             key=lambda m: abs(m.home_goals - m.away_goals),\n611:             reverse=True,\n612:         )[: max(1, top)]\n613: \n614:         return {\n615:             \"competition\": comp or \"all\",\n616:             \"season\": season,\n617:             \"matches\": len(with_goals),\n618:             \"avg_goals_per_match\": (\n619:                 round(total_goals / len(with_goals), 2) if with_goals else None\n620:             ),\n621:             \"home_win_rate\": (\n622:                 round(home_wins / len(with_goals) * 100, 1) if with_goals else None\n623:             ),\n624:             \"away_win_rate\": (\n625:                 round(away_wins / len(with_goals) * 100, 1) if with_goals else None\n626:             ),\n627:             \"draw_rate\": (\n628:                 round(draws / len(with_goals) * 100, 1) if with_goals else None\n629:             ),\n630:             \"top_scoring_teams\": self._top_scoring_teams(with_goals, top),\n631:             \"biggest_wins\": [self._match_line(m) for m in biggest],\n632:         }\n633: \n634:     @staticmethod\n635:     def _top_scoring_teams(matches: list[Match], top: int) -> list[dict]:\n636:         goals: dict[str, int] = defaultdict(int)\n637:         for match in matches:\n638:             goals[match.home_team] += match.home_goals\n639:             goals[match.away_team] += match.away_goals\n640:         ranked = sorted(goals.items(), key=lambda kv: -kv[1])[: max(1, top)]\n641:         return [{\"team\": team, \"goals\": count} for team, count in ranked]\n642: \n643:     def get_best_records(\n644:         self,\n645:         venue: str = \"home\",\n646:         competition: str | None = None,\n647:         season: int | None = None,\n648:         min_matches: int = 5,\n649:         limit: int = 5,\n650:     ) -> dict:\n651:         \"\"\"Rank teams by win rate at a venue for the given filters.\"\"\"\n652:         venue_norm = venue.lower()\n653:         if venue_norm not in {\"home\", \"away\"}:\n654:             return {\"error\": \"venue must be 'home' or 'away'\"}\n655:         comp = self._resolve_competition(competition)\n656:         matches = self.dataset.matches\n657:         if comp:\n658:             matches = [m for m in matches if m.competition == comp]\n659:         if season is not None:\n660:             matches = [m for m in matches if m.season == season]\n661: \n662:         per_team: dict[str, list[Match]] = defaultdict(list)\n663:         for match in matches:\n664:             if venue_norm == \"home\":\n665:                 per_team[match.home_team].append(match)\n666:             else:\n667:                 per_team[match.away_team].append(match)\n668: \n669:         rankings = []\n670:         for team, team_matches in per_team.items():\n671:             record = self._record(team_matches, team)\n672:             if record[\"played\"] < max(1, min_matches):\n673:                 continue\n674:             rankings.append({\"team\": team, **record})\n675:         rankings.sort(\n676:             key=lambda r: (\n677:                 -r[\"win_rate\"],\n678:                 -(r[\"wins\"] - r[\"losses\"]),\n679:                 r[\"team\"],\n680:             )\n681:         )\n682:         return {\n683:             \"venue\": venue_norm,\n684:             \"competition\": comp or \"all\",\n685:             \"season\": season,\n686:             \"min_matches\": min_matches,\n687:             \"rankings\": rankings[: max(1, limit)],\n688:         }\n689: \n690:     def search_derbies(\n691:         self,\n692:         season: int | None = None,\n693:         competition: str | None = None,\n694:         limit: int = DEFAULT_MATCH_LIMIT,\n695:     ) -> dict:\n696:         \"\"\"Find traditional rivalry matches (Fla-Flu, Gre-Nal, ...).\"\"\"\n697:         comp = self._resolve_competition(competition)\n698:         derby_keys = {\n699:             frozenset((team_key(a), team_key(b))) for (a, b) in DERBIES\n700:         }\n701:         results = []\n702:         for match in self.dataset.matches:\n703:             if comp and match.competition != comp:\n704:                 continue\n705:             if season is not None and match.season != season:\n706:                 continue\n707:             pair = frozenset((match.home_team, match.away_team))\n708:             if pair not in derby_keys:\n709:                 continue\n710:             results.append(match)\n711:         results.sort(key=lambda m: (m.date or \"\"), reverse=True)\n712:         total = len(results)\n713:         shown = results[: max(1, limit)]\n714:         return {\n715:             \"query\": {\"season\": season, \"competition\": comp},\n716:             \"total_matches\": total,\n717:             \"returned\": len(shown),\n718:             \"matches\": [\n719:                 {**m.to_dict(), \"line\": self._match_line(m),\n720:                  \"derby\": derby_name(m.home_team, m.away_team)}\n721:                 for m in shown\n722:             ],\n723:         }\n724: \n725:     # ------------------------------------------------------------------\n726:     # Cross-file queries\n727:     # ------------------------------------------------------------------\n728: \n729:     def get_club_overview(self, team: str) -> dict:\n730:         \"\"\"Cross-file view: match record + FIFA squad for one club.\"\"\"\n731:         canonical = self.dataset.resolve_team(team)\n732:         matches = self.dataset.matches_for_team(canonical)\n733:         stats = self.get_team_stats(canonical)\n734: \n735:         club_key = text_key(canonical)\n736:         players = [\n737:             p for p in self.dataset.players if p.club and text_key(p.club) == club_key\n738:         ]\n739:         fuzzy = None\n740:         if not players:\n741:             partial = [\n742:                 p for p in self.dataset.players\n743:                 if p.club and text_key(p.club).startswith(club_key)\n744:             ]\n745:             if partial:\n746:                 fuzzy = sorted({p.club for p in partial})\n747:                 players = partial\n748:             else:\n749:                 partial = [\n750:                     p for p in self.dataset.players\n751:                     if p.club and club_key in text_key(p.club)\n752:                 ]\n753:                 if partial:\n754:                     fuzzy = sorted({p.club for p in partial})\n755:                     players = partial\n756: \n757:         players.sort(key=lambda p: -p.overall)\n758:         recent_seasons = sorted(\n759:             {m.season for m in matches if m.season}, reverse=True\n760:         )\n761:         recent = None\n762:         if recent_seasons:\n763:             season = recent_seasons[0]\n764:             season_matches = [m for m in matches if m.season == season]\n765:             recent = {\"season\": season, \"record\": self._record(\n766:                 season_matches, canonical\n767:             )}\n768: \n769:         return {\n770:             \"team\": canonical,\n771:             \"all_time_record\": stats[\"record\"],\n772:             \"competitions_played\": stats[\"competitions_played\"],\n773:             \"most_recent_season\": recent,\n774:             \"fifa_squad\": {\n775:                 \"matched_clubs\": fuzzy or (\n776:                     sorted({p.club for p in players}) if players else []\n777:                 ),\n778:                 \"player_count\": len(players),\n779:                 \"avg_overall\": (\n780:                     round(sum(p.overall for p in players) / len(players), 1)\n781:                     if players else None\n782:                 ),\n783:                 \"top_players\": [self._player_dict(p) for p in players[:10]],\n784:             },\n785:         }\n786: \n787:     # ------------------------------------------------------------------\n788:     # Discovery helpers\n789:     # ------------------------------------------------------------------\n790: \n791:     def list_teams(self, competition: str | None = None, limit: int | None = None) -> dict:\n792:         \"\"\"Teams present in the match data, with match counts.\"\"\"\n793:         comp = self._resolve_competition(competition)\n794:         teams: dict[str, int] = {}\n795:         for match in self.dataset.matches:\n796:             if comp and match.competition != comp:\n797:                 continue\n798:             teams[match.home_team] = teams.get(match.home_team, 0) + 1\n799:             teams[match.away_team] = teams.get(match.away_team, 0) + 1\n800:         ranked = sorted(teams.items(), key=lambda kv: (-kv[1], kv[0]))\n801:         if limit:\n802:             ranked = ranked[: max(1, limit)]\n803:         return {\n804:             \"competition\": comp or \"all\",\n805:             \"team_count\": len(teams),\n806:             \"teams\": [{\"team\": name, \"matches\": count} for name, count in ranked],\n807:         }\n808: \n809:     def list_competitions(self) -> dict:\n810:         \"\"\"Competitions, match counts, and season coverage.\"\"\"\n811:         comps = self.dataset.competitions()\n812:         return {\n813:             \"competitions\": [\n814:                 {\n815:                     \"competition\": name,\n816:                     \"matches\": info[\"matches\"],\n817:                     \"seasons\": info[\"seasons\"],\n818:                     \"season_range\": (\n819:                         f\"{info['seasons'][0]}-{info['seasons'][-1]}\"\n820:                         if info[\"seasons\"] else None\n821:                     ),\n822:                 }\n823:                 for name, info in sorted(comps.items())\n824:             ]\n825:         }\n\n(End of file - total 825 lines)\n</content>","metadata":{"preview":"\"\"\"Query engine answering match, team, player, competition, and stats questions.\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections import defaultdict\n\nfrom .data_loader import COMPETITION_ALIASES, Dataset, Match, Player\nfrom .normalize import (\n    DERBIES,\n    derby_name,\n    normalize_team,\n    parse_date,\n    team_key,\n    text_key,\n)\n\nPOSITION_CATEGORIES = {\n    \"goalkeeper\": {\"GK\"},\n    \"defender\": {\"LB\", \"LWB\", \"CB\", \"LCB\", \"RCB\", \"RB\", \"RWB\"},\n    \"midfielder\": {\"CDM\", \"LDM\", \"RDM\", \"CM\", \"LCM\", \"RCM\", \"LM\", \"RM\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/maui/.retort/work/retort-local-75154ofp/retort-242ce4667ad2/brazilian_soccer_mcp/queries.py","text":"\"\"\"Query engine answering match, team, player, competition, and stats questions.\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections import defaultdict\n\nfrom .data_loader import COMPETITION_ALIASES, Dataset, Match, Player\nfrom .normalize import (\n    DERBIES,\n    derby_name,\n    normalize_team,\n    parse_date,\n    team_key,\n    text_key,\n)\n\nPOSITION_CATEGORIES = {\n    \"goalkeeper\": {\"GK\"},\n    \"defender\": {\"LB\", \"LWB\", \"CB\", \"LCB\", \"RCB\", \"RB\", \"RWB\"},\n    \"midfielder\": {\"CDM\", \"LDM\", \"RDM\", \"CM\", \"LCM\", \"RCM\", \"LM\", \"RM\",\n                   \"CAM\", \"LAM\", \"RAM\"},\n    \"forward\": {\"ST\", \"LS\", \"RS\", \"CF\", \"LF\", \"RF\", \"LW\", \"RW\"},\n}\n\nDEFAULT_MATCH_LIMIT = 20\nDEFAULT_PLAYER_LIMIT = 25\n\n\nclass QueryEngine:\n    \"\"\"Answer structured queries over the loaded dataset.\"\"\"\n\n    def __init__(self, dataset: Dataset) -> None:\n        self.dataset = dataset\n\n    # ------------------------------------------------------------------\n    # Helpers\n    # ------------------------------------------------------------------\n\n    def _resolve_competition(self, competition: str | None) -> str | None:\n        \"\"\"Map a user competition label onto the canonical one (or None).\"\"\"\n        if not competition:\n            return None\n        return COMPETITION_ALIASES.get(text_key(competition), competition.strip())\n\n    def _date_range(\n        self, date_from: str | None, date_to: str | None\n    ) -> tuple[str | None, str | None]:\n        lo = parse_date(date_from)\n        hi = parse_date(date_to)\n        return (lo.isoformat() if lo else None, hi.isoformat() if hi else None)\n\n    @staticmethod\n    def _match_team(match: Match, team: str) -> str | None:\n        if match.home_team == team:\n            return \"home\"\n        if match.away_team == team:\n            return \"away\"\n        return None\n\n    @staticmethod\n    def _match_line(match: Match) -> str:\n        \"\"\"Human-readable one-line summary of a match.\"\"\"\n        home = str(match.home_goals) if match.home_goals is not None else \"?\"\n        away = str(match.away_goals) if match.away_goals is not None else \"?\"\n        label = match.competition\n        if match.stage:\n            label += f\" {match.stage.title()}\"\n        elif match.round:\n            label += f\" Round {match.round}\"\n        return (\n            f\"{match.date or 'unknown date'}: \"\n            f\"{match.home_team} {home}-{away} {match.away_team} ({label})\"\n        )\n\n    @staticmethod\n    def _record(matches: list[Match], team: str) -> dict:\n        \"\"\"W/D/L, GF/GA record for one team across matches.\"\"\"\n        wins = draws = losses = goals_for = goals_against = 0\n        played = 0\n        for match in matches:\n            if match.home_goals is None or match.away_goals is None:\n                continue\n            played += 1\n            if match.home_team == team:\n                gf, ga = match.home_goals, match.away_goals\n            elif match.away_team == team:\n                gf, ga = match.away_goals, match.home_goals\n            else:\n                continue\n            goals_for += gf\n            goals_against += ga\n            if gf > ga:\n                wins += 1\n            elif gf < ga:\n                losses += 1\n            else:\n                draws += 1\n        return {\n            \"played\": played,\n            \"wins\": wins,\n            \"draws\": draws,\n            \"losses\": losses,\n            \"goals_for\": goals_for,\n            \"goals_against\": goals_against,\n            \"win_rate\": round(wins / played * 100, 1) if played else 0.0,\n        }\n\n    @staticmethod\n    def _pair_record(matches: list[Match], team_a: str, team_b: str) -> dict:\n        \"\"\"Head-to-head W/D/L for team_a vs team_b from matches.\"\"\"\n        record = {\"team_a\": team_a, \"team_b\": team_b, \"team_a_wins\": 0,\n                  \"team_b_wins\": 0, \"draws\": 0}\n        for match in matches:\n            if match.home_goals is None or match.away_goals is None:\n                continue\n            pair = {match.home_team, match.away_team}\n            if pair != {team_a, team_b}:\n                continue\n            home_goals, away_goals = match.home_goals, match.away_goals\n            if home_goals == away_goals:\n                record[\"draws\"] += 1\n            else:\n                winner = match.home_team if home_goals > away_goals else match.away_team\n                if winner == team_a:\n                    record[\"team_a_wins\"] += 1\n                else:\n                    record[\"team_b_wins\"] += 1\n        return record\n\n    def _h2h_matches(self, team_a: str, team_b: str) -> list[Match]:\n        a = self.dataset.resolve_team(team_a)\n        b = self.dataset.resolve_team(team_b)\n        return [\n            m for m in self.dataset.matches_for_team(a)\n            if b in (m.home_team, m.away_team)\n        ]\n\n    @staticmethod\n    def _filtered_record_summary(matches: list[Match], team: str) -> dict | None:\n        \"\"\"Record of `team` inside an arbitrary filtered match list.\"\"\"\n        if not team:\n            return None\n        record = QueryEngine._record(\n            [m for m in matches if team in (m.home_team, m.away_team)], team\n        )\n        return record if record[\"played\"] else None\n\n    # ------------------------------------------------------------------\n    # 1. Match queries\n    # ------------------------------------------------------------------\n\n    def search_matches(\n        self,\n        team: str | None = None,\n        opponent: str | None = None,\n        competition: str | None = None,\n        season: int | None = None,\n        date_from: str | None = None,\n        date_to: str | None = None,\n        round_or_stage: str | None = None,\n        limit: int = DEFAULT_MATCH_LIMIT,\n    ) -> dict:\n        \"\"\"Find matches by team/opponent/competition/season/date range.\"\"\"\n        canonical_team = self.dataset.resolve_team(team) if team else None\n        canonical_opponent = self.dataset.resolve_team(opponent) if opponent else None\n        if canonical_opponent and not canonical_team:\n            canonical_team, canonical_opponent = canonical_opponent, None\n\n        if canonical_team and canonical_opponent:\n            pool = self._h2h_matches(canonical_team, canonical_opponent)\n        elif canonical_team:\n            pool = self.dataset.matches_for_team(canonical_team)\n        else:\n            pool = self.dataset.matches\n\n        comp = self._resolve_competition(competition)\n        lo, hi = self._date_range(date_from, date_to)\n        stage_key = text_key(round_or_stage) if round_or_stage else None\n\n        results: list[Match] = []\n        for match in pool:\n            if comp and match.competition != comp:\n                continue\n            if season is not None and match.season != season:\n                continue\n            if lo and (not match.date or match.date < lo):\n                continue\n            if hi and (not match.date or match.date > hi):\n                continue\n            if stage_key:\n                label = text_key(match.stage or \"\") or text_key(f\"round {match.round or ''}\")\n                if stage_key not in label:\n                    continue\n            results.append(match)\n\n        results.sort(key=lambda m: (m.date or \"\"), reverse=True)\n        total = len(results)\n        shown = results[: max(1, limit)]\n\n        summary: dict = {}\n        if canonical_team and canonical_opponent:\n            summary = self._pair_record(results, canonical_team, canonical_opponent)\n        elif canonical_team:\n            record = self._filtered_record_summary(results, canonical_team)\n            if record:\n                summary = {\"team\": canonical_team, **record}\n\n        return {\n            \"query\": {\n                \"team\": canonical_team,\n                \"opponent\": canonical_opponent,\n                \"competition\": comp,\n                \"season\": season,\n                \"date_from\": lo,\n                \"date_to\": hi,\n                \"round_or_stage\": round_or_stage,\n            },\n            \"total_matches\": total,\n            \"returned\": len(shown),\n            \"note\": (\n                f\"Showing {len(shown)} of {total} matches. Increase limit to see more.\"\n                if total > len(shown)\n                else None\n            ),\n            \"matches\": [\n                {**m.to_dict(), \"line\": self._match_line(m)} for m in shown\n            ],\n            \"summary\": summary or None,\n        }\n\n    # ------------------------------------------------------------------\n    # 2. Team queries\n    # ------------------------------------------------------------------\n\n    def get_team_stats(\n        self,\n        team: str,\n        competition: str | None = None,\n        season: int | None = None,\n        venue: str | None = None,\n    ) -> dict:\n        \"\"\"W/D/L record, goals, and win rate for one team.\"\"\"\n        canonical = self.dataset.resolve_team(team)\n        comp = self._resolve_competition(competition)\n        matches = self.dataset.matches_for_team(canonical)\n        if comp:\n            matches = [m for m in matches if m.competition == comp]\n        if season is not None:\n            matches = [m for m in matches if m.season == season]\n\n        venue_norm = (venue or \"all\").lower()\n        if venue_norm not in {\"all\", \"home\", \"away\"}:\n            venue_norm = \"all\"\n        selected = [\n            m for m in matches\n            if venue_norm == \"all\"\n            or (venue_norm == \"home\" and m.home_team == canonical)\n            or (venue_norm == \"away\" and m.away_team == canonical)\n        ]\n\n        competitions_played = sorted({m.competition for m in matches})\n        seasons_played = sorted({m.season for m in matches if m.season})\n\n        return {\n            \"team\": canonical,\n            \"competition\": comp or \"all\",\n            \"season\": season,\n            \"venue\": venue_norm,\n            \"record\": self._record(selected, canonical),\n            \"competitions_played\": competitions_played,\n            \"seasons_played\": seasons_played,\n        }\n\n    def head_to_head(self, team_a: str, team_b: str) -> dict:\n        \"\"\"Head-to-head record plus the most recent meetings.\"\"\"\n        a = self.dataset.resolve_team(team_a)\n        b = self.dataset.resolve_team(team_b)\n        matches = self._h2h_matches(a, b)\n        matches.sort(key=lambda m: (m.date or \"\"), reverse=True)\n        return {\n            \"team_a\": a,\n            \"team_b\": b,\n            \"derby\": derby_name(a, b),\n            \"record\": self._pair_record(matches, a, b),\n            \"last_meeting\": self._match_line(matches[0]) if matches else None,\n            \"recent_matches\": [\n                {**m.to_dict(), \"line\": self._match_line(m)} for m in matches[:5]\n            ],\n        }\n\n    def get_team_competitions(self, team: str) -> dict:\n        \"\"\"Which competitions (and seasons) a team appears in across all files.\"\"\"\n        canonical = self.dataset.resolve_team(team)\n        matches = self.dataset.matches_for_team(canonical)\n        counts: dict[str, int] = defaultdict(int)\n        seasons_by_comp: dict[str, set[int]] = defaultdict(set)\n        for match in matches:\n            counts[match.competition] += 1\n            if match.season:\n                seasons_by_comp[match.competition].add(match.season)\n        return {\n            \"team\": canonical,\n            \"total_matches\": len(matches),\n            \"competitions\": {\n                comp: {\n                    \"matches\": counts[comp],\n                    \"seasons\": sorted(seasons_by_comp[comp]),\n                }\n                for comp in sorted(counts)\n            },\n        }\n\n    # ------------------------------------------------------------------\n    # 3. Player queries\n    # ------------------------------------------------------------------\n\n    def search_players(\n        self,\n        name: str | None = None,\n        nationality: str | None = None,\n        club: str | None = None,\n        position: str | None = None,\n        position_category: str | None = None,\n        min_overall: int | None = None,\n        max_overall: int | None = None,\n        limit: int = DEFAULT_PLAYER_LIMIT,\n    ) -> dict:\n        \"\"\"Search FIFA player data by name/nationality/club/position/rating.\"\"\"\n        name_key = text_key(name) if name else None\n        name_tokens = set(name_key.split()) if name_key else None\n        nat_key = text_key(nationality) if nationality else None\n        positions: set[str] | None = None\n        if position:\n            positions = {position.strip().upper()}\n        elif position_category:\n            category = position_category.strip().lower()\n            positions = POSITION_CATEGORIES.get(category)\n            if positions is None:\n                return {\n                    \"error\": (\n                        f\"Unknown position category '{position_category}'. \"\n                        f\"Options: {sorted(POSITION_CATEGORIES)}\"\n                    )\n                }\n\n        candidates = self.dataset.players\n        if club:\n            candidates = self._match_club(candidates, club)\n\n        results: list[Player] = []\n        for player in candidates:\n            if name_key:\n                player_key = text_key(player.name)\n                player_tokens = set(player_key.split())\n                if not (name_tokens <= player_tokens or name_key in player_key):\n                    continue\n            if nat_key:\n                player_nat = text_key(player.nationality)\n                if nat_key not in player_nat and player_nat not in nat_key:\n                    continue\n            if positions and player.position not in positions:\n                continue\n            if min_overall is not None and player.overall < min_overall:\n                continue\n            if max_overall is not None and player.overall > max_overall:\n                continue\n            results.append(player)\n\n        results.sort(key=lambda p: (-p.overall, p.name))\n        total = len(results)\n        shown = results[: max(1, limit)]\n\n        by_club: dict[str, list[int]] = defaultdict(list)\n        if nat_key and not club:\n            for player in results:\n                if player.club:\n                    by_club[player.club].append(player.overall)\n            club_summary = [\n                {\n                    \"club\": club_name,\n                    \"players\": len(ratings),\n                    \"avg_overall\": round(sum(ratings) / len(ratings), 1),\n                }\n                for club_name, ratings in sorted(\n                    by_club.items(), key=lambda kv: -len(kv[1])\n                )[:10]\n            ]\n        else:\n            club_summary = None\n\n        return {\n            \"query\": {\n                \"name\": name,\n                \"nationality\": nationality,\n                \"club\": club,\n                \"position\": position,\n                \"position_category\": position_category,\n                \"min_overall\": min_overall,\n                \"max_overall\": max_overall,\n            },\n            \"matched_clubs\": sorted({p.club for p in candidates})[:10] if club else None,\n            \"total_players\": total,\n            \"returned\": len(shown),\n            \"players\": [self._player_dict(p) for p in shown],\n            \"clubs_with_brazilian_players\": club_summary,\n        }\n\n    @staticmethod\n    def _match_club(players: list[Player], club: str) -> list[Player]:\n        \"\"\"Filter players by club with exact > prefix > contains ranking.\"\"\"\n        wanted = text_key(club)\n        exact: list[Player] = []\n        prefix: list[Player] = []\n        contains: list[Player] = []\n        for player in players:\n            player_club = text_key(player.club)\n            if not player_club:\n                continue\n            if player_club == wanted:\n                exact.append(player)\n            elif player_club.startswith(wanted):\n                prefix.append(player)\n            elif wanted in player_club:\n                contains.append(player)\n        return exact + prefix + contains\n\n    @staticmethod\n    def _player_dict(player: Player) -> dict:\n        data = player.to_dict()\n        data.pop(\"skills\")\n        return data\n\n    # ------------------------------------------------------------------\n    # 4. Competition queries\n    # ------------------------------------------------------------------\n\n    def get_standings(self, competition: str, season: int) -> dict:\n        \"\"\"League table calculated from match results for one season.\"\"\"\n        comp = self._resolve_competition(competition)\n        if not comp:\n            return {\"error\": \"competition is required\"}\n        matches = [\n            m for m in self.dataset.matches\n            if m.competition == comp\n            and m.season == season\n            and m.home_goals is not None\n            and m.away_goals is not None\n        ]\n        if not matches:\n            return {\n                \"error\": (\n                    f\"No completed {comp} matches found for season {season}.\"\n                )\n            }\n\n        table: dict[str, dict] = {}\n        for match in matches:\n            for team, gf, ga in (\n                (match.home_team, match.home_goals, match.away_goals),\n                (match.away_team, match.away_goals, match.home_goals),\n            ):\n                row = table.setdefault(\n                    team,\n                    {\n                        \"team\": team, \"played\": 0, \"wins\": 0, \"draws\": 0,\n                        \"losses\": 0, \"goals_for\": 0, \"goals_against\": 0,\n                    },\n                )\n                row[\"played\"] += 1\n                row[\"goals_for\"] += gf\n                row[\"goals_against\"] += ga\n                if gf > ga:\n                    row[\"wins\"] += 1\n                elif gf < ga:\n                    row[\"losses\"] += 1\n                else:\n                    row[\"draws\"] += 1\n\n        rows = sorted(\n            table.values(),\n            key=lambda r: (\n                3 * r[\"wins\"] + r[\"draws\"],\n                r[\"wins\"],\n                r[\"goals_for\"] - r[\"goals_against\"],\n                r[\"goals_for\"],\n                r[\"team\"],\n            ),\n            reverse=True,\n        )\n        standings = []\n        for position, row in enumerate(rows, start=1):\n            points = 3 * row[\"wins\"] + row[\"draws\"]\n            note = \"Champion\" if position == 1 else None\n            standings.append(\n                {\n                    \"position\": position,\n                    **row,\n                    \"goal_difference\": row[\"goals_for\"] - row[\"goals_against\"],\n                    \"points\": points,\n                    \"note\": note,\n                }\n            )\n        if len(rows) == 20:\n            for row in standings[-4:]:\n                row[\"note\"] = \"Relegation zone\"\n\n        matches_per_team = {row[\"played\"] for row in rows}\n        complete = len(matches_per_team) == 1\n        return {\n            \"competition\": comp,\n            \"season\": season,\n            \"matches_used\": len(matches),\n            \"teams\": len(rows),\n            \"table_complete\": complete,\n            \"note\": None if complete else (\n                \"Season appears incomplete in the dataset (teams played a \"\n                \"varying number of matches); positions are indicative only.\"\n            ),\n            \"standings\": standings,\n        }\n\n    def get_season_summary(self, season: int) -> dict:\n        \"\"\"Aggregate statistics for one season across competitions.\"\"\"\n        return self._season_summary(season)\n\n    def compare_seasons(self, season_a: int, season_b: int) -> dict:\n        \"\"\"Side-by-side aggregate statistics for two seasons.\"\"\"\n        return {\n            \"season_a\": self._season_summary(season_a),\n            \"season_b\": self._season_summary(season_b),\n        }\n\n    def _season_summary(self, season: int) -> dict:\n        by_comp: dict[str, list[Match]] = defaultdict(list)\n        for match in self.dataset.matches:\n            if match.season == season:\n                by_comp[match.competition].append(match)\n\n        champions = {}\n        for comp in (\"Brasileirão\", \"Serie B\", \"Serie C\"):\n            standings = self.get_standings(comp, season)\n            if \"error\" not in standings and standings[\"standings\"]:\n                top = standings[\"standings\"][0]\n                champions[comp] = {\n                    \"team\": top[\"team\"],\n                    \"points\": top[\"points\"],\n                    \"record\": (\n                        f\"{top['wins']}W {top['draws']}D {top['losses']}L\"\n                    ),\n                }\n\n        competitions = {}\n        for comp, comp_matches in sorted(by_comp.items()):\n            with_goals = [\n                m for m in comp_matches\n                if m.home_goals is not None and m.away_goals is not None\n            ]\n            total_goals = sum(m.home_goals + m.away_goals for m in with_goals)\n            home_wins = sum(\n                1 for m in with_goals if m.home_goals > m.away_goals\n            )\n            draws = sum(1 for m in with_goals if m.home_goals == m.away_goals)\n            competitions[comp] = {\n                \"matches\": len(with_goals),\n                \"total_goals\": total_goals,\n                \"avg_goals_per_match\": (\n                    round(total_goals / len(with_goals), 2) if with_goals else None\n                ),\n                \"home_win_rate\": (\n                    round(home_wins / len(with_goals) * 100, 1)\n                    if with_goals else None\n                ),\n                \"draw_rate\": (\n                    round(draws / len(with_goals) * 100, 1) if with_goals else None\n                ),\n            }\n        return {\"season\": season, \"competitions\": competitions,\n                \"champions\": champions or None}\n\n    # ------------------------------------------------------------------\n    # 5. Statistical analysis\n    # ------------------------------------------------------------------\n\n    def get_competition_stats(\n        self,\n        competition: str | None = None,\n        season: int | None = None,\n        top: int = 5,\n    ) -> dict:\n        \"\"\"Aggregate statistics: goals, home advantage, biggest wins.\"\"\"\n        comp = self._resolve_competition(competition)\n        matches = self.dataset.matches\n        if comp:\n            matches = [m for m in matches if m.competition == comp]\n        if season is not None:\n            matches = [m for m in matches if m.season == season]\n        with_goals = [\n            m for m in matches\n            if m.home_goals is not None and m.away_goals is not None\n        ]\n\n        total_goals = sum(m.home_goals + m.away_goals for m in with_goals)\n        home_wins = sum(1 for m in with_goals if m.home_goals > m.away_goals)\n        away_wins = sum(1 for m in with_goals if m.home_goals < m.away_goals)\n        draws = sum(1 for m in with_goals if m.home_goals == m.away_goals)\n\n        goals_by_team: dict[str, int] = defaultdict(int)\n        biggest = sorted(\n            with_goals,\n            key=lambda m: abs(m.home_goals - m.away_goals),\n            reverse=True,\n        )[: max(1, top)]\n\n        return {\n            \"competition\": comp or \"all\",\n            \"season\": season,\n            \"matches\": len(with_goals),\n            \"avg_goals_per_match\": (\n                round(total_goals / len(with_goals), 2) if with_goals else None\n            ),\n            \"home_win_rate\": (\n                round(home_wins / len(with_goals) * 100, 1) if with_goals else None\n            ),\n            \"away_win_rate\": (\n                round(away_wins / len(with_goals) * 100, 1) if with_goals else None\n            ),\n            \"draw_rate\": (\n                round(draws / len(with_goals) * 100, 1) if with_goals else None\n            ),\n            \"top_scoring_teams\": self._top_scoring_teams(with_goals, top),\n            \"biggest_wins\": [self._match_line(m) for m in biggest],\n        }\n\n    @staticmethod\n    def _top_scoring_teams(matches: list[Match], top: int) -> list[dict]:\n        goals: dict[str, int] = defaultdict(int)\n        for match in matches:\n            goals[match.home_team] += match.home_goals\n            goals[match.away_team] += match.away_goals\n        ranked = sorted(goals.items(), key=lambda kv: -kv[1])[: max(1, top)]\n        return [{\"team\": team, \"goals\": count} for team, count in ranked]\n\n    def get_best_records(\n        self,\n        venue: str = \"home\",\n        competition: str | None = None,\n        season: int | None = None,\n        min_matches: int = 5,\n        limit: int = 5,\n    ) -> dict:\n        \"\"\"Rank teams by win rate at a venue for the given filters.\"\"\"\n        venue_norm = venue.lower()\n        if venue_norm not in {\"home\", \"away\"}:\n            return {\"error\": \"venue must be 'home' or 'away'\"}\n        comp = self._resolve_competition(competition)\n        matches = self.dataset.matches\n        if comp:\n            matches = [m for m in matches if m.competition == comp]\n        if season is not None:\n            matches = [m for m in matches if m.season == season]\n\n        per_team: dict[str, list[Match]] = defaultdict(list)\n        for match in matches:\n            if venue_norm == \"home\":\n                per_team[match.home_team].append(match)\n            else:\n                per_team[match.away_team].append(match)\n\n        rankings = []\n        for team, team_matches in per_team.items():\n            record = self._record(team_matches, team)\n            if record[\"played\"] < max(1, min_matches):\n                continue\n            rankings.append({\"team\": team, **record})\n        rankings.sort(\n            key=lambda r: (\n                -r[\"win_rate\"],\n                -(r[\"wins\"] - r[\"losses\"]),\n                r[\"team\"],\n            )\n        )\n        return {\n            \"venue\": venue_norm,\n            \"competition\": comp or \"all\",\n            \"season\": season,\n            \"min_matches\": min_matches,\n            \"rankings\": rankings[: max(1, limit)],\n        }\n\n    def search_derbies(\n        self,\n        season: int | None = None,\n        competition: str | None = None,\n        limit: int = DEFAULT_MATCH_LIMIT,\n    ) -> dict:\n        \"\"\"Find traditional rivalry matches (Fla-Flu, Gre-Nal, ...).\"\"\"\n        comp = self._resolve_competition(competition)\n        derby_keys = {\n            frozenset((team_key(a), team_key(b))) for (a, b) in DERBIES\n        }\n        results = []\n        for match in self.dataset.matches:\n            if comp and match.competition != comp:\n                continue\n            if season is not None and match.season != season:\n                continue\n            pair = frozenset((match.home_team, match.away_team))\n            if pair not in derby_keys:\n                continue\n            results.append(match)\n        results.sort(key=lambda m: (m.date or \"\"), reverse=True)\n        total = len(results)\n        shown = results[: max(1, limit)]\n        return {\n            \"query\": {\"season\": season, \"competition\": comp},\n            \"total_matches\": total,\n            \"returned\": len(shown),\n            \"matches\": [\n                {**m.to_dict(), \"line\": self._match_line(m),\n                 \"derby\": derby_name(m.home_team, m.away_team)}\n                for m in shown\n            ],\n        }\n\n    # ------------------------------------------------------------------\n    # Cross-file queries\n    # ------------------------------------------------------------------\n\n    def get_club_overview(self, team: str) -> dict:\n        \"\"\"Cross-file view: match record + FIFA squad for one club.\"\"\"\n        canonical = self.dataset.resolve_team(team)\n        matches = self.dataset.matches_for_team(canonical)\n        stats = self.get_team_stats(canonical)\n\n        club_key = text_key(canonical)\n        players = [\n            p for p in self.dataset.players if p.club and text_key(p.club) == club_key\n        ]\n        fuzzy = None\n        if not players:\n            partial = [\n                p for p in self.dataset.players\n                if p.club and text_key(p.club).startswith(club_key)\n            ]\n            if partial:\n                fuzzy = sorted({p.club for p in partial})\n                players = partial\n            else:\n                partial = [\n                    p for p in self.dataset.players\n                    if p.club and club_key in text_key(p.club)\n                ]\n                if partial:\n                    fuzzy = sorted({p.club for p in partial})\n                    players = partial\n\n        players.sort(key=lambda p: -p.overall)\n        recent_seasons = sorted(\n            {m.season for m in matches if m.season}, reverse=True\n        )\n        recent = None\n        if recent_seasons:\n            season = recent_seasons[0]\n            season_matches = [m for m in matches if m.season == season]\n            recent = {\"season\": season, \"record\": self._record(\n                season_matches, canonical\n            )}\n\n        return {\n            \"team\": canonical,\n            \"all_time_record\": stats[\"record\"],\n            \"competitions_played\": stats[\"competitions_played\"],\n            \"most_recent_season\": recent,\n            \"fifa_squad\": {\n                \"matched_clubs\": fuzzy or (\n                    sorted({p.club for p in players}) if players else []\n                ),\n                \"player_count\": len(players),\n                \"avg_overall\": (\n                    round(sum(p.overall for p in players) / len(players), 1)\n                    if players else None\n                ),\n                \"top_players\": [self._player_dict(p) for p in players[:10]],\n            },\n        }\n\n    # ------------------------------------------------------------------\n    # Discovery helpers\n    # ------------------------------------------------------------------\n\n    def list_teams(self, competition: str | None = None, limit: int | None = None) -> dict:\n        \"\"\"Teams present in the match data, with match counts.\"\"\"\n        comp = self._resolve_competition(competition)\n        teams: dict[str, int] = {}\n        for match in self.dataset.matches:\n            if comp and match.competition != comp:\n                continue\n            teams[match.home_team] = teams.get(match.home_team, 0) + 1\n            teams[match.away_team] = teams.get(match.away_team, 0) + 1\n        ranked = sorted(teams.items(), key=lambda kv: (-kv[1], kv[0]))\n        if limit:\n            ranked = ranked[: max(1, limit)]\n        return {\n            \"competition\": comp or \"all\",\n            \"team_count\": len(teams),\n            \"teams\": [{\"team\": name, \"matches\": count} for name, count in ranked],\n        }\n\n    def list_competitions(self) -> dict:\n        \"\"\"Competitions, match counts, and season coverage.\"\"\"\n        comps = self.dataset.competitions()\n        return {\n            \"competitions\": [\n                {\n                    \"competition\": name,\n                    \"matches\": info[\"matches\"],\n                    \"seasons\": info[\"seasons\"],\n                    \"season_range\": (\n                        f\"{info['seasons'][0]}-{info['seasons'][-1]}\"\n                        if info[\"seasons\"] else None\n                    ),\n                }\n                for name, info in sorted(comps.items())\n            ]\n        }","lineStart":1,"lineEnd":825,"totalLines":825,"truncated":false}},"title":"brazilian_soccer_mcp/queries.py","time":{"start":1788228081804,"end":1788228081811}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05ab31889001WPNlxu2opkLwuS","sessionID":"ses_fa54e4cfeffeF35792XylHPXI3","messageID":"msg_05ab2fa3b0018xNNsPHG2UYRMj"}}
