timestamp=2026-06-25T03:41:12.045Z level=INFO run=9c04db1c message=evaluated permission=bash pattern="python3 - <<'PY'\nfrom brazilian_soccer_mcp.data_loader import load_all\nfrom collections import Counter, defaultdict\ndata=load_all()\nkeys={'corinthians'}\nmatches=[m for m in data['matches'] if m['season']==2022 and m['competition']=='Brasileirão' and (m['home_canonical'] in keys or m['away_canonical'] in keys)]\n# Group by opponent+homeaway\nopp=defaultdict(list)\nfor m in matches:\n    is_home=m['home_canonical']=='corinthians'\n    opp_key=(is_home, m['away_canonical'] if is_home else m['home_canonical'])\n    opp[opp_key].append((m['source'], m['date'], m['home_display'],m['away_display'],m['home_goal'],m['away_goal']))\nfor k,v in sorted(opp.items())[:15]:\n    print(k, v)\nPY" action.permission=bash action.action=allow action.pattern=*
