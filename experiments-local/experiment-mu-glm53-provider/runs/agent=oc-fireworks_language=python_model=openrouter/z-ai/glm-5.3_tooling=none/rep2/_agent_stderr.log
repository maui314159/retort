timestamp=2026-09-01T06:05:08.285Z level=INFO run=f180ecb5 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nfrom collections import Counter, defaultdict\nfrom brazilian_soccer import SoccerData\ndata = SoccerData()\nsa = [m for m in data.matches if m.competition=='brasileirao']\nfor season in (2013, 2014, 2016, 2018, 2020, 2022):\n    ms = [m for m in sa if m.season == season]\n    pairs = Counter((m.home.key, m.away.key) for m in ms)\n    dups = {k: v for k, v in pairs.items() if v > 1}\n    print(season, 'matches:', len(ms), 'dup pairs:', len(dups))\n    for k in list(dups)[:3]:\n        ex = [m for m in ms if (m.home.key, m.away.key) == k]\n        for m in ex:\n            print('    ', m.date, m.source, m.round_label, m.home.display, m.home_goals, '-', m.away_goals, m.away.display)\nEOF" action.permission=bash action.action=allow action.pattern=*
