"ac\", \"cf\", \"ca\"}\n \n _CODE_AT_END = re.compile(\n     r\"^(?P<base>.*?)[\\s\\-–—]+\\(?(?P<code>[A-Z]{2,3})\\)?\\s*$\"\n","additions":0,"deletions":1},"truncated":false},"title":"brazilian_soccer/normalize.py","time":{"start":1788231264441,"end":1788231264443}},"id":"prt_05ae3a8b5001WBMs0SNFTi8734","sessionID":"ses_fa52b88b3ffeUF09L5H3uZ1cg4","messageID":"msg_05ae2d552001pUH73QVUElldj7"}}
