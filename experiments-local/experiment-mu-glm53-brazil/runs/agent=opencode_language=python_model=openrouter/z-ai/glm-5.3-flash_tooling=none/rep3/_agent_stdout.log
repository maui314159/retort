{"type":"tool_use","timestamp":1788231209857,"sessionID":"ses_fa52b88b3ffeUF09L5H3uZ1cg4","part":{"type":"tool","tool":"read","callID":"call_a09816fd70c54faa9953844f","state":{"status":"completed","input":{"filePath":"/Users/maui/.retort/work/retort-local-0bivsr25/retort-e0c09c17c08e/brazilian_soccer/normalize.py"},"output":"<path>/Users/maui/.retort/work/retort-local-0bivsr25/retort-e0c09c17c08e/brazilian_soccer/normalize.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Team-name normalization, alias resolution, and date parsing.\n2: \n3: This module is the data-quality backbone of the server:\n4: \n5: - **Team identity**: raw team names come in many shapes (\"Palmeiras-SP\",\n6:   \"Palmeiras - SP\", \"São Paulo\", \"Sao Paulo\", \"Athletico Paranaense\",\n7:   \"Nacional (URU)\").  ``parse_team_name`` splits a raw name into a\n8:   ``(base, code)`` pair where *code* is an optional Brazilian state\n9:   abbreviation (``SP``) or a country code from Copa Libertadores data\n10:   (``URU``).  ``TeamRegistry`` then assigns each club one stable canonical\n11:   key and one display name so that the same club is always matched across\n12:   all six datasets.\n13: \n14: - **Ambiguity rule**: if a base name maps to more than one Brazilian state\n15:   (e.g. \"Botafogo\" -> RJ/PB/SP, \"América\" -> MG/RN), the state becomes part\n16:   of the club identity; a bare name (\"Botafogo\") resolves through\n17:   ``DEFAULT_STATE`` to the most famous club.  Country codes (URU, PAR, ...)\n18:   are *always* kept as part of the identity because they denote different\n19:   real clubs.\n20: \n21: - **Text keys**: ``canonical_key`` strips accents, punctuation and generic\n22:   club-type tokens (FC/EC/SC/AC/CF) so \"A.b.c. - RN\", \"ABC - RN\" and\n23:   \"Abc - RN\" collapse to one club.\n24: \n25: - **Dates**: ``parse_date`` accepts ISO (\"2023-09-24\"), ISO with time\n26:   (\"2012-05-19 18:30:00\") and Brazilian (\"29/03/2003\") formats.\n27: \n28: All matching is accent/case-insensitive; UTF-8 display names are preserved.\n29: \"\"\"\n30: \n31: from __future__ import annotations\n32: \n33: import re\n34: import unicodedata\n35: from datetime import date, datetime\n36: \n37: BR_STATES = {\n38:     \"AC\", \"AL\", \"AP\", \"AM\", \"BA\", \"CE\", \"DF\", \"ES\", \"GO\", \"MA\", \"MT\", \"MS\",\n39:     \"MG\", \"PA\", \"PB\", \"PR\", \"PE\", \"PI\", \"RJ\", \"RN\", \"RS\", \"RO\", \"RR\", \"SC\",\n40:     \"SP\", \"SE\", \"TO\",\n41: }\n42: \n43: # Country suffixes seen in the Libertadores dataset.\n44: COUNTRY_CODES = {\n45:     \"ARG\", \"BOL\", \"CHI\", \"COL\", \"EQU\", \"MEX\", \"PAR\", \"PER\", \"URU\", \"VEN\",\n46: }\n47: \n48: CODES = BR_STATES | COUNTRY_CODES\n49: \n50: # Curated corrections applied to the parsed base name.\n51: # Key: canonical_key(base); value: (corrected_base, forced_code or None).\n52: ALIASES: dict[str, tuple[str, str | None]] = {\n53:     # América (RN / Natal variants)\n54:     \"america fc natal\": (\"america\", \"RN\"),\n55:     \"america de natal\": (\"america\", \"RN\"),\n56:     \"america de natal rn\": (\"america\", \"RN\"),\n57:     # Atlético family\n58:     \"atletico mineiro\": (\"atletico\", \"MG\"),\n59:     \"atletico goianiense\": (\"atletico\", \"GO\"),\n60:     \"athletico paranaense\": (\"atletico\", \"PR\"),\n61:     \"atletico paranaense\": (\"atletico\", \"PR\"),\n62:     \"athletico\": (\"atletico\", \"PR\"),\n63:     \"ca parana\": (\"parana\", None),\n64:     # Vasco\n65:     \"vasco da gama\": (\"vasco\", \"RJ\"),\n66:     # Sport\n67:     \"sport club do recife\": (\"sport\", \"PE\"),\n68:     \"sport recife\": (\"sport\", \"PE\"),\n69:     # Fortaleza\n70:     \"fortaleza fc\": (\"fortaleza\", None),\n71:     \"fortaleza ec\": (\"fortaleza\", None),\n72:     # Bahia\n73:     \"ec bahia\": (\"bahia\", None),\n74:     # Botafogo-SP (Ribeirão Preto) long form\n75:     \"botafogo sp fc\": (\"botafogo\", \"SP\"),\n76:     # Internacional de Santa Maria / Lages\n77:     \"ec internacional sc\": (\"internacional\", \"SC\"),\n78:     \"internacional sc\": (\"internacional\", \"SC\"),\n79:     # Ceará\n80:     \"ceara sporting club\": (\"ceara\", None),\n81:     # Brasil de Pelotas\n82:     \"brasil de pelotas\": (\"brasil\", \"RS\"),\n83:     # São José (Porto Alegre)\n84:     \"sao jose poa\": (\"sao jose\", \"RS\"),\n85:     # Desportiva Ferroviária\n86:     \"desportiva ferroviaria\": (\"desportiva\", \"ES\"),\n87:     # SER Caxias == Caxias (RS)\n88:     \"ser caxias\": (\"caxias\", None),\n89:     # CSA long form\n90:     \"cs alagoano\": (\"csa\", None),\n91:     # Operário Ferroviário (PR)\n92:     \"operario ferroviario esporte c\": (\"operario\", \"PR\"),\n93:     # Boavista (Saquarema, RJ)\n94:     \"boavista sc saquarema\": (\"boavista\", \"RJ\"),\n95:     \"boavista sport club\": (\"boavista\", \"RJ\"),\n96:     # América FC (Minas Gerais) - FIFA club naming\n97:     \"america fc minas gerais\": (\"america\", \"MG\"),\n98:     # Ríver (Piauí)\n99:     \"river ac\": (\"river\", \"PI\"),\n100:     \"rivr\": (\"river\", \"PI\"),\n101:     # Águia de Marabá\n102:     \"aguia de maraba\": (\"aguia\", \"PA\"),\n103:     # 4 de Julho OCR variant\n104:     \"iv de julho\": (\"4 de julho\", \"PI\"),\n105:     # Remo / Náutico long forms\n106:     \"clube do remo\": (\"remo\", None),\n107:     \"nautico capibaribe\": (\"nautico\", None),\n108:     # Gama (DF)\n109:     \"se gama\": (\"gama\", None),\n110:     # Macaé\n111:     \"macae esporte fc\": (\"macae esporte\", None),\n112:     # Tolima (Colombia)\n113:     \"deportes tolima\": (\"tolima\", None),\n114:     # Red Bull Brasil == Red Bull Bragantino (SP)\n115:     \"red bull brasil\": (\"red bull bragantino\", \"SP\"),\n116:     \"bragantino\": (\"bragantino\", None),\n117:     # Duque de Caxias\n118:     \"duque de caxias fc\": (\"duque de caxias\", None),\n119:     # Junior/Atlético Nacional style long names stay as-is.\n120: }\n121: \n122: # Default state for famous clubs whose bare name appears in data while\n123: # other (lesser) clubs share the base name with a state suffix.\n124: DEFAULT_STATE: dict[str, str] = {\n125:     \"santos\": \"SP\",\n126:     \"vasco\": \"RJ\",\n127:     \"botafogo\": \"RJ\",\n128:     \"flamengo\": \"RJ\",\n129:     \"atletico\": \"MG\",\n130:     \"america\": \"MG\",\n131:     \"internacional\": \"RS\",\n132:     \"vitoria\": \"BA\",\n133:     \"sport\": \"PE\",\n134:     \"santa cruz\": \"PE\",\n135:     \"guarani\": \"SP\",\n136:     \"bragantino\": \"SP\",\n137:     \"sao raimundo\": \"RR\",\n138:     \"nautico\": \"PE\",\n139:     \"rioverdense\": \"RO\",\n140: }\n141: \n142: # Friendly display names for clubs where the most frequent raw form is\n143: # awkward or ambiguous.\n144: DISPLAY_OVERRIDES: dict[str, str] = {\n145:     \"brasil\": \"Brasil de Pelotas\",\n146:     \"atletico|MG\": \"Atlético Mineiro\",\n147:     \"atletico|PR\": \"Athletico-PR\",\n148:     \"4 de julho\": \"4 de Julho\",\n149:     \"riv\": \"Ríver-PI\",\n150:     \"river\": \"Ríver-PI\",\n151:     \"sao raimundo\": \"São Raimundo-RR\",\n152:     \"america|MG\": \"América-MG\",\n153:     \"america|RN\": \"América-RN\",\n154: }\n155: \n156: _ACCENT_TABLE = str.maketrans(\"\", \"\", \"\")\n157: _CLUB_TOKENS = {\"fc\", \"ec\", \"sc\", \"ac\", \"cf\", \"ca\"}\n158: \n159: _CODE_AT_END = re.compile(\n160:     r\"^(?P<base>.*?)[\\s\\-–—]+\\(?(?P<code>[A-Z]{2,3})\\)?\\s*$\"\n161: )\n162: \n163: \n164: def strip_accents(text: str) -> str:\n165:     \"\"\"Remove diacritics: 'São Paulo' -> 'Sao Paulo'.\"\"\"\n166:     return \"\".join(\n167:         ch for ch in unicodedata.normalize(\"NFKD\", text)\n168:         if not unicodedata.combining(ch)\n169:     )\n170: \n171: \n172: def canonical_key(text: str) -> str:\n173:     \"\"\"Accent/punct-insensitive key used for all name matching.\"\"\"\n174:     s = strip_accents(text).lower()\n175:     s = s.replace(\".\", \" \")\n176:     s = re.sub(r\"[^a-z0-9]+\", \" \", s)\n177:     tokens = [t for t in s.split() if t]\n178:     while tokens and tokens[0] in _CLUB_TOKENS:\n179:         tokens = tokens[1:]\n180:     while tokens and tokens[-1] in _CLUB_TOKENS:\n181:         tokens = tokens[:-1]\n182:     return \" \".join(tokens)\n183: \n184: \n185: def parse_team_name(raw: str) -> tuple[str, str | None]:\n186:     \"\"\"Split a raw team name into ``(base, code)``.\n187: \n188:     ``code`` is a Brazilian state (\"SP\"), a country code (\"URU\") or None.\n189:     Handles \"Palmeiras-SP\", \"Atlético - MG\", \"America MG\", \"River (PI)\",\n190:     \"Nacional (URU)\", \"Barcelona-EQU\", \"Boavista Sport Club (...) - RJ\".\n191:     \"\"\"\n192:     s = raw.strip()\n193:     # Drop parenthetical annotations that are not a bare trailing code,\n194:     # e.g. \"(antigo Esporte Clube Barreira)\".\n195:     s = re.sub(r\"\\((?!\\s*[A-Z]{2,3}\\s*\\))[^)]*\\)\", \" \", s).strip()\n196:     m = _CODE_AT_END.match(s)\n197:     if m:\n198:         code = m.group(\"code\")\n199:         base = m.group(\"base\").strip(\" -–—\")\n200:         if code in CODES and canonical_key(base):\n201:             return base, code\n202:     return s, None\n203: \n204: \n205: def parse_date(raw: str | None):\n206:     \"\"\"Parse ISO, ISO+time and Brazilian DD/MM/YYYY dates. Returns ``date``.\"\"\"\n207:     if raw is None:\n208:         return None\n209:     s = raw.strip()\n210:     if not s:\n211:         return None\n212:     for fmt in (\"%Y-%m-%d %H:%M:%S\", \"%Y-%m-%d %H:%M\", \"%Y-%m-%d\",\n213:                 \"%d/%m/%Y %H:%M:%S\", \"%d/%m/%Y\", \"%d/%m/%y\"):\n214:         try:\n215:             return datetime.strptime(s, fmt).date()\n216:         except ValueError:\n217:             continue\n218:     return None\n219: \n220: \n221: def parse_int(raw) -> int | None:\n222:     \"\"\"Parse an int tolerating blanks and float-formatted CSV values.\"\"\"\n223:     if raw is None:\n224:         return None\n225:     s = str(raw).strip()\n226:     if not s:\n227:         return None\n228:     try:\n229:         return int(float(s))\n230:     except ValueError:\n231:         return None\n232: \n233: \n234: def parse_float(raw):\n235:     if raw is None:\n236:         return None\n237:     s = str(raw).strip().rstrip(\"%\")\n238:     if not s:\n239:         return None\n240:     try:\n241:         return float(s)\n242:     except ValueError:\n243:         return None\n244: \n245: \n246: def resolve_alias(base_key: str) -> tuple[str, str | None]:\n247:     \"\"\"Apply curated alias corrections to a canonical base key.\"\"\"\n248:     return ALIASES.get(base_key, (base_key, None))\n249: \n250: \n251: class TeamRegistry:\n252:     \"\"\"Assigns stable canonical keys and display names to team names.\n253: \n254:     Usage: ``register`` every raw name seen in the match datasets first\n255:     (so ambiguity is judged on real match data), then register player-club\n256:     names from FIFA data; finally call ``finalize``.\n257:     \"\"\"\n258: \n259:     def __init__(self) -> None:\n260:         self._raw_cache: dict[str, str] = {}\n261:         # (base_key, code|None) -> {raw display forms}\n262:         self._variants: dict[tuple[str, str | None], list[str]] = {}\n263:         # final canonical key -> display name\n264:         self._display: dict[str, str] = {}\n265:         self.finalized = False\n266: \n267:     def register(self, raw: str) -> str:\n268:         \"\"\"Register a raw team/club name; returns its canonical key once\n269:         finalized (or a provisional key during loading).\"\"\"\n270:         if raw in self._raw_cache:\n271:             return self._raw_cache[raw]\n272:         base, code = parse_team_name(raw)\n273:         base_key, forced = resolve_alias(canonical_key(base))\n274:         code = forced or code\n275:         self._variants.setdefault((base_key, code), []).append(raw)\n276:         # provisional key is refined in finalize()\n277:         key = self._provisional_key(base_key, code)\n278:         self._raw_cache[raw] = key\n279:         return key\n280: \n281:     def _provisional_key(self, base_key: str, code: str | None) -> str:\n282:         return f\"{base_key}|{code}\" if code else base_key\n283: \n284:     def finalize(self) -> None:\n285:         \"\"\"Resolve base-name ambiguity and compute display names.\"\"\"\n286:         by_base: dict[str, set[str]] = {}\n287:         for (base_key, code) in self._variants:\n288:             if code in BR_STATES:\n289:                 by_base.setdefault(base_key, set()).add(code)\n290: \n291:         self._display = {}\n292:         final_cache: dict[str, str] = {}\n293:         for (base_key, code), raws in self._variants.items():\n294:             states = by_base.get(base_key, set())\n295:             if code in COUNTRY_CODES:\n296:                 key = f\"{base_key}|{code}\"          # country is identity\n297:             elif len(states) >= 2:\n298:                 eff = code if code in BR_STATES else DEFAULT_STATE.get(base_key)\n299:                 key = f\"{base_key}|{eff}\" if eff else base_key\n300:             else:\n301:                 key = base_key                       # unambiguous: drop state\n302:             best = self._pick_display(base_key, code, raws)\n303:             disp = DISPLAY_OVERRIDES.get(key) or self._display.get(key)\n304:             self._display[key] = disp or best\n305:             for raw in raws:\n306:                 final_cache[raw] = key\n307:         self._raw_cache = final_cache\n308:         self.finalized = True\n309: \n310:     def _pick_display(self, base_key: str, code: str | None, raws: list[str]) -> str:\n311:         \"\"\"Choose a display name: most frequent accented raw base form.\"\"\"\n312:         counts: dict[str, int] = {}\n313:         for raw in raws:\n314:             base, parsed_code = parse_team_name(raw)\n315:             bkey, forced = resolve_alias(canonical_key(base))\n316:             if bkey == base_key and (forced or parsed_code or None) == code:\n317:                 counts[base] = counts.get(base, 0) + 1\n318:         if not counts:\n319:             return raws[0]\n320:         # Prefer accented variants, then frequency, then longer form.\n321:         def rank(item):\n322:             name, n = item\n323:             return (self._has_accent(name), n, len(name), name)\n324:         base_name = max(counts.items(), key=rank)[0].strip()\n325:         if code in BR_STATES:\n326:             states = {c for (b, c) in self._variants if b == base_key and c in BR_STATES}\n327:             if len(states) >= 2:\n328:                 base_name = f\"{base_name}-{code}\"\n329:         return base_name\n330: \n331:     @staticmethod\n332:     def _has_accent(text: str) -> bool:\n333:         return any(unicodedata.combining(ch) for ch in unicodedata.normalize(\"NFKD\", text))\n334: \n335:     def display(self, key: str) -> str:\n336:         return self._display.get(key, key)\n337: \n338:     def key_for(self, raw: str) -> str:\n339:         \"\"\"Canonical key for a raw name (must be registered or finalized).\"\"\"\n340:         if raw in self._raw_cache:\n341:             return self._raw_cache[raw]\n342:         return self.register(raw)\n343: \n344:     def keys(self) -> list[str]:\n345:         return sorted(self._display)\n\n(End of file - total 345 lines)\n</content>","metadata":{"preview":"\"\"\"Team-name normalization, alias resolution, and date parsing.\n\nThis module is the data-quality backbone of the server:\n\n- **Team identity**: raw team names come in many shapes (\"Palmeiras-SP\",\n  \"Palmeiras - SP\", \"São Paulo\", \"Sao Paulo\", \"Athletico Paranaense\",\n  \"Nacional (URU)\").  ``parse_team_name`` splits a raw name into a\n  ``(base, code)`` pair where *code* is an optional Brazilian state\n  abbreviation (``SP``) or a country code from Copa Libertadores data\n  (``URU``).  ``TeamRegistry`` then assigns each club one stable canonical\n  key and one display name so that the same club is always matched across\n  all six datasets.\n\n- **Ambiguity rule**: if a base name maps to more than one Brazilian state\n  (e.g. \"Botafogo\" -> RJ/PB/SP, \"América\" -> MG/RN), the state becomes part\n  of the club identity; a bare name (\"Botafogo\") resolves through\n  ``DEFAULT_STATE`` to the most famous club.  Country codes (URU, PAR, ...)\n  are *always* kept as part of the identity because they denote different\n  real clubs.\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/maui/.retort/work/retort-local-0bivsr25/retort-e0c09c17c08e/brazilian_soccer/normalize.py","text":"\"\"\"Team-name normalization, alias resolution, and date parsing.\n\nThis module is the data-quality backbone of the server:\n\n- **Team identity**: raw team names come in many shapes (\"Palmeiras-SP\",\n  \"Palmeiras - SP\", \"São Paulo\", \"Sao Paulo\", \"Athletico Paranaense\",\n  \"Nacional (URU)\").  ``parse_team_name`` splits a raw name into a\n  ``(base, code)`` pair where *code* is an optional Brazilian state\n  abbreviation (``SP``) or a country code from Copa Libertadores data\n  (``URU``).  ``TeamRegistry`` then assigns each club one stable canonical\n  key and one display name so that the same club is always matched across\n  all six datasets.\n\n- **Ambiguity rule**: if a base name maps to more than one Brazilian state\n  (e.g. \"Botafogo\" -> RJ/PB/SP, \"América\" -> MG/RN), the state becomes part\n  of the club identity; a bare name (\"Botafogo\") resolves through\n  ``DEFAULT_STATE`` to the most famous club.  Country codes (URU, PAR, ...)\n  are *always* kept as part of the identity because they denote different\n  real clubs.\n\n- **Text keys**: ``canonical_key`` strips accents, punctuation and generic\n  club-type tokens (FC/EC/SC/AC/CF) so \"A.b.c. - RN\", \"ABC - RN\" and\n  \"Abc - RN\" collapse to one club.\n\n- **Dates**: ``parse_date`` accepts ISO (\"2023-09-24\"), ISO with time\n  (\"2012-05-19 18:30:00\") and Brazilian (\"29/03/2003\") formats.\n\nAll matching is accent/case-insensitive; UTF-8 display names are preserved.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nimport unicodedata\nfrom datetime import date, datetime\n\nBR_STATES = {\n    \"AC\", \"AL\", \"AP\", \"AM\", \"BA\", \"CE\", \"DF\", \"ES\", \"GO\", \"MA\", \"MT\", \"MS\",\n    \"MG\", \"PA\", \"PB\", \"PR\", \"PE\", \"PI\", \"RJ\", \"RN\", \"RS\", \"RO\", \"RR\", \"SC\",\n    \"SP\", \"SE\", \"TO\",\n}\n\n# Country suffixes seen in the Libertadores dataset.\nCOUNTRY_CODES = {\n    \"ARG\", \"BOL\", \"CHI\", \"COL\", \"EQU\", \"MEX\", \"PAR\", \"PER\", \"URU\", \"VEN\",\n}\n\nCODES = BR_STATES | COUNTRY_CODES\n\n# Curated corrections applied to the parsed base name.\n# Key: canonical_key(base); value: (corrected_base, forced_code or None).\nALIASES: dict[str, tuple[str, str | None]] = {\n    # América (RN / Natal variants)\n    \"america fc natal\": (\"america\", \"RN\"),\n    \"america de natal\": (\"america\", \"RN\"),\n    \"america de natal rn\": (\"america\", \"RN\"),\n    # Atlético family\n    \"atletico mineiro\": (\"atletico\", \"MG\"),\n    \"atletico goianiense\": (\"atletico\", \"GO\"),\n    \"athletico paranaense\": (\"atletico\", \"PR\"),\n    \"atletico paranaense\": (\"atletico\", \"PR\"),\n    \"athletico\": (\"atletico\", \"PR\"),\n    \"ca parana\": (\"parana\", None),\n    # Vasco\n    \"vasco da gama\": (\"vasco\", \"RJ\"),\n    # Sport\n    \"sport club do recife\": (\"sport\", \"PE\"),\n    \"sport recife\": (\"sport\", \"PE\"),\n    # Fortaleza\n    \"fortaleza fc\": (\"fortaleza\", None),\n    \"fortaleza ec\": (\"fortaleza\", None),\n    # Bahia\n    \"ec bahia\": (\"bahia\", None),\n    # Botafogo-SP (Ribeirão Preto) long form\n    \"botafogo sp fc\": (\"botafogo\", \"SP\"),\n    # Internacional de Santa Maria / Lages\n    \"ec internacional sc\": (\"internacional\", \"SC\"),\n    \"internacional sc\": (\"internacional\", \"SC\"),\n    # Ceará\n    \"ceara sporting club\": (\"ceara\", None),\n    # Brasil de Pelotas\n    \"brasil de pelotas\": (\"brasil\", \"RS\"),\n    # São José (Porto Alegre)\n    \"sao jose poa\": (\"sao jose\", \"RS\"),\n    # Desportiva Ferroviária\n    \"desportiva ferroviaria\": (\"desportiva\", \"ES\"),\n    # SER Caxias == Caxias (RS)\n    \"ser caxias\": (\"caxias\", None),\n    # CSA long form\n    \"cs alagoano\": (\"csa\", None),\n    # Operário Ferroviário (PR)\n    \"operario ferroviario esporte c\": (\"operario\", \"PR\"),\n    # Boavista (Saquarema, RJ)\n    \"boavista sc saquarema\": (\"boavista\", \"RJ\"),\n    \"boavista sport club\": (\"boavista\", \"RJ\"),\n    # América FC (Minas Gerais) - FIFA club naming\n    \"america fc minas gerais\": (\"america\", \"MG\"),\n    # Ríver (Piauí)\n    \"river ac\": (\"river\", \"PI\"),\n    \"rivr\": (\"river\", \"PI\"),\n    # Águia de Marabá\n    \"aguia de maraba\": (\"aguia\", \"PA\"),\n    # 4 de Julho OCR variant\n    \"iv de julho\": (\"4 de julho\", \"PI\"),\n    # Remo / Náutico long forms\n    \"clube do remo\": (\"remo\", None),\n    \"nautico capibaribe\": (\"nautico\", None),\n    # Gama (DF)\n    \"se gama\": (\"gama\", None),\n    # Macaé\n    \"macae esporte fc\": (\"macae esporte\", None),\n    # Tolima (Colombia)\n    \"deportes tolima\": (\"tolima\", None),\n    # Red Bull Brasil == Red Bull Bragantino (SP)\n    \"red bull brasil\": (\"red bull bragantino\", \"SP\"),\n    \"bragantino\": (\"bragantino\", None),\n    # Duque de Caxias\n    \"duque de caxias fc\": (\"duque de caxias\", None),\n    # Junior/Atlético Nacional style long names stay as-is.\n}\n\n# Default state for famous clubs whose bare name appears in data while\n# other (lesser) clubs share the base name with a state suffix.\nDEFAULT_STATE: dict[str, str] = {\n    \"santos\": \"SP\",\n    \"vasco\": \"RJ\",\n    \"botafogo\": \"RJ\",\n    \"flamengo\": \"RJ\",\n    \"atletico\": \"MG\",\n    \"america\": \"MG\",\n    \"internacional\": \"RS\",\n    \"vitoria\": \"BA\",\n    \"sport\": \"PE\",\n    \"santa cruz\": \"PE\",\n    \"guarani\": \"SP\",\n    \"bragantino\": \"SP\",\n    \"sao raimundo\": \"RR\",\n    \"nautico\": \"PE\",\n    \"rioverdense\": \"RO\",\n}\n\n# Friendly display names for clubs where the most frequent raw form is\n# awkward or ambiguous.\nDISPLAY_OVERRIDES: dict[str, str] = {\n    \"brasil\": \"Brasil de Pelotas\",\n    \"atletico|MG\": \"Atlético Mineiro\",\n    \"atletico|PR\": \"Athletico-PR\",\n    \"4 de julho\": \"4 de Julho\",\n    \"riv\": \"Ríver-PI\",\n    \"river\": \"Ríver-PI\",\n    \"sao raimundo\": \"São Raimundo-RR\",\n    \"america|MG\": \"América-MG\",\n    \"america|RN\": \"América-RN\",\n}\n\n_ACCENT_TABLE = str.maketrans(\"\", \"\", \"\")\n_CLUB_TOKENS = {\"fc\", \"ec\", \"sc\", \"ac\", \"cf\", \"ca\"}\n\n_CODE_AT_END = re.compile(\n    r\"^(?P<base>.*?)[\\s\\-–—]+\\(?(?P<code>[A-Z]{2,3})\\)?\\s*$\"\n)\n\n\ndef strip_accents(text: str) -> str:\n    \"\"\"Remove diacritics: 'São Paulo' -> 'Sao Paulo'.\"\"\"\n    return \"\".join(\n        ch for ch in unicodedata.normalize(\"NFKD\", text)\n        if not unicodedata.combining(ch)\n    )\n\n\ndef canonical_key(text: str) -> str:\n    \"\"\"Accent/punct-insensitive key used for all name matching.\"\"\"\n    s = strip_accents(text).lower()\n    s = s.replace(\".\", \" \")\n    s = re.sub(r\"[^a-z0-9]+\", \" \", s)\n    tokens = [t for t in s.split() if t]\n    while tokens and tokens[0] in _CLUB_TOKENS:\n        tokens = tokens[1:]\n    while tokens and tokens[-1] in _CLUB_TOKENS:\n        tokens = tokens[:-1]\n    return \" \".join(tokens)\n\n\ndef parse_team_name(raw: str) -> tuple[str, str | None]:\n    \"\"\"Split a raw team name into ``(base, code)``.\n\n    ``code`` is a Brazilian state (\"SP\"), a country code (\"URU\") or None.\n    Handles \"Palmeiras-SP\", \"Atlético - MG\", \"America MG\", \"River (PI)\",\n    \"Nacional (URU)\", \"Barcelona-EQU\", \"Boavista Sport Club (...) - RJ\".\n    \"\"\"\n    s = raw.strip()\n    # Drop parenthetical annotations that are not a bare trailing code,\n    # e.g. \"(antigo Esporte Clube Barreira)\".\n    s = re.sub(r\"\\((?!\\s*[A-Z]{2,3}\\s*\\))[^)]*\\)\", \" \", s).strip()\n    m = _CODE_AT_END.match(s)\n    if m:\n        code = m.group(\"code\")\n        base = m.group(\"base\").strip(\" -–—\")\n        if code in CODES and canonical_key(base):\n            return base, code\n    return s, None\n\n\ndef parse_date(raw: str | None):\n    \"\"\"Parse ISO, ISO+time and Brazilian DD/MM/YYYY dates. Returns ``date``.\"\"\"\n    if raw is None:\n        return None\n    s = raw.strip()\n    if not s:\n        return None\n    for fmt in (\"%Y-%m-%d %H:%M:%S\", \"%Y-%m-%d %H:%M\", \"%Y-%m-%d\",\n                \"%d/%m/%Y %H:%M:%S\", \"%d/%m/%Y\", \"%d/%m/%y\"):\n        try:\n            return datetime.strptime(s, fmt).date()\n        except ValueError:\n            continue\n    return None\n\n\ndef parse_int(raw) -> int | None:\n    \"\"\"Parse an int tolerating blanks and float-formatted CSV values.\"\"\"\n    if raw is None:\n        return None\n    s = str(raw).strip()\n    if not s:\n        return None\n    try:\n        return int(float(s))\n    except ValueError:\n        return None\n\n\ndef parse_float(raw):\n    if raw is None:\n        return None\n    s = str(raw).strip().rstrip(\"%\")\n    if not s:\n        return None\n    try:\n        return float(s)\n    except ValueError:\n        return None\n\n\ndef resolve_alias(base_key: str) -> tuple[str, str | None]:\n    \"\"\"Apply curated alias corrections to a canonical base key.\"\"\"\n    return ALIASES.get(base_key, (base_key, None))\n\n\nclass TeamRegistry:\n    \"\"\"Assigns stable canonical keys and display names to team names.\n\n    Usage: ``register`` every raw name seen in the match datasets first\n    (so ambiguity is judged on real match data), then register player-club\n    names from FIFA data; finally call ``finalize``.\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._raw_cache: dict[str, str] = {}\n        # (base_key, code|None) -> {raw display forms}\n        self._variants: dict[tuple[str, str | None], list[str]] = {}\n        # final canonical key -> display name\n        self._display: dict[str, str] = {}\n        self.finalized = False\n\n    def register(self, raw: str) -> str:\n        \"\"\"Register a raw team/club name; returns its canonical key once\n        finalized (or a provisional key during loading).\"\"\"\n        if raw in self._raw_cache:\n            return self._raw_cache[raw]\n        base, code = parse_team_name(raw)\n        base_key, forced = resolve_alias(canonical_key(base))\n        code = forced or code\n        self._variants.setdefault((base_key, code), []).append(raw)\n        # provisional key is refined in finalize()\n        key = self._provisional_key(base_key, code)\n        self._raw_cache[raw] = key\n        return key\n\n    def _provisional_key(self, base_key: str, code: str | None) -> str:\n        return f\"{base_key}|{code}\" if code else base_key\n\n    def finalize(self) -> None:\n        \"\"\"Resolve base-name ambiguity and compute display names.\"\"\"\n        by_base: dict[str, set[str]] = {}\n        for (base_key, code) in self._variants:\n            if code in BR_STATES:\n                by_base.setdefault(base_key, set()).add(code)\n\n        self._display = {}\n        final_cache: dict[str, str] = {}\n        for (base_key, code), raws in self._variants.items():\n            states = by_base.get(base_key, set())\n            if code in COUNTRY_CODES:\n                key = f\"{base_key}|{code}\"          # country is identity\n            elif len(states) >= 2:\n                eff = code if code in BR_STATES else DEFAULT_STATE.get(base_key)\n                key = f\"{base_key}|{eff}\" if eff else base_key\n            else:\n                key = base_key                       # unambiguous: drop state\n            best = self._pick_display(base_key, code, raws)\n            disp = DISPLAY_OVERRIDES.get(key) or self._display.get(key)\n            self._display[key] = disp or best\n            for raw in raws:\n                final_cache[raw] = key\n        self._raw_cache = final_cache\n        self.finalized = True\n\n    def _pick_display(self, base_key: str, code: str | None, raws: list[str]) -> str:\n        \"\"\"Choose a display name: most frequent accented raw base form.\"\"\"\n        counts: dict[str, int] = {}\n        for raw in raws:\n            base, parsed_code = parse_team_name(raw)\n            bkey, forced = resolve_alias(canonical_key(base))\n            if bkey == base_key and (forced or parsed_code or None) == code:\n                counts[base] = counts.get(base, 0) + 1\n        if not counts:\n            return raws[0]\n        # Prefer accented variants, then frequency, then longer form.\n        def rank(item):\n            name, n = item\n            return (self._has_accent(name), n, len(name), name)\n        base_name = max(counts.items(), key=rank)[0].strip()\n        if code in BR_STATES:\n            states = {c for (b, c) in self._variants if b == base_key and c in BR_STATES}\n            if len(states) >= 2:\n                base_name = f\"{base_name}-{code}\"\n        return base_name\n\n    @staticmethod\n    def _has_accent(text: str) -> bool:\n        return any(unicodedata.combining(ch) for ch in unicodedata.normalize(\"NFKD\", text))\n\n    def display(self, key: str) -> str:\n        return self._display.get(key, key)\n\n    def key_for(self, raw: str) -> str:\n        \"\"\"Canonical key for a raw name (must be registered or finalized).\"\"\"\n        if raw in self._raw_cache:\n            return self._raw_cache[raw]\n        return self.register(raw)\n\n    def keys(self) -> list[str]:\n        return sorted(self._display)","lineStart":1,"lineEnd":345,"totalLines":345,"truncated":false}},"title":"brazilian_soccer/normalize.py","time":{"start":1788231209849,"end":1788231209855}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05ae2d376001NqIX126WmmH8qu","sessionID":"ses_fa52b88b3ffeUF09L5H3uZ1cg4","messageID":"msg_05ae2b844001dUlaRhwObJyUpn"}}
