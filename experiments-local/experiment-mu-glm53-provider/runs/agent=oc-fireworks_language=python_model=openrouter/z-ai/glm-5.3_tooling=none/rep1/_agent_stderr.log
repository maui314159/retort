timestamp=2026-09-01T05:34:41.864Z level=INFO run=2c158548 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, re, datetime as dt, unicodedata, collections\ndef deacc(s): return ''.join(c for c in unicodedata.normalize('NFKD', s) if not unicodedata.combining(c)).lower()\nSTATES={'AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'}\nCOUN={'uru','par','equ','per','ven'}\nCORE_ALIAS={'athletico':'atletico'}\nALIAS={('atletico mineiro','MG'):('atletico','MG'),('atletico mineiro',None):('atletico','MG'),\n('vasco da gama',None):('vasco','RJ'),('vasco da gama','RJ'):('vasco','RJ'),('vasco',None):('vasco','RJ'),\n('sport recife',None):('sport','PE'),('sport',None):('sport','PE'),\n('red bull bragantino',None):('bragantino','SP'),('red bull bragantino','SP'):('bragantino','SP'),('bragantino',None):('bragantino','SP'),\n('corinthians paulista','SP'):('corinthians','SP'),('corinthians paulista',None):('corinthians','SP'),\n('atletico goianiense',None):('atletico','GO'),('atletico goianiense','GO'):('atletico','GO'),\n('nautico capibaribe',None):('nautico','PE'),\n('portuguesa desportos',None):('portuguesa','SP'),\n('america de natal','RN'):('america','RN'),('america fc natal',None):('america','RN'),('america de natal',None):('america','RN'),\n('clube do remo',None):('remo','PA'),\n('guarani de juazeiro',None):('guarani','CE'),('guarani de juazeiro','CE'):('guarani','CE'),\n('ser caxias','RS'):('caxias','RS'),('ser caxias',None):('caxias','RS'),\n('operario ferroviario','PR'):('operario','PR'),('operario ferroviario',None):('operario','PR'),\n('sfrancisco','PA'):('sao francisco','PA'),\n('sousa','PB'):('souza','PB'),\n('xv piracicaba',None):('xv de piracicaba','SP'),('xv piracicaba','SP'):('xv de piracicaba','SP'),\n('gremio novorizontino',None):('novorizontino','SP'),('gremio novorizontino','SP'):('novorizontino','SP'),\n}\ndef key(name, state=None, state_fix=None):\n    s = re.sub(r'\\(.*?\\)',' ', deacc(name.strip())).replace(\"'\",'')\n    toks=[t for t in re.split(r'[\\s\\-]+',s) if t]\n    st=state\n    if st and state_fix: st=state_fix.get((deacc(name.split(' - ')[0].split('-')[0]).strip(),st), state_fix.get(st,st))\n    if toks and toks[-1].upper() in STATES and len(toks)>1: st=toks[-1].upper(); toks=toks[:-1]\n    elif toks and toks[-1].upper() in COUN and len(toks)>1: st=toks[-1].upper(); toks=toks[:-1]\n    toks=[t.replace('.','') for t in toks]\n    pre=' '.join(toks)\n    a=ALIAS.get((pre,st))\n    if a: pre,st=a; toks=pre.split()\n    else:\n        FORM={'ec','sc','fc','ce','ge','ca','ad','se','aa','club','clube','futebol','ltda','esporte'}\n        if pre not in ('sport boys','sport recife'):\n            while len(toks)>1 and toks[0] in FORM: toks=toks[1:]\n            while len(toks)>1 and toks[-1] in FORM: toks=toks[:-1]\n            while len(toks)>1 and len(toks[-1])==1: toks=toks[:-1]\n        core=' '.join(toks)\n        a=ALIAS.get((core,st))\n        if a: core,st=a\n        core=CORE_ALIAS.get(core,core)\n        pre=core\n    return f\"{pre}|{st or ''}\"\nNOVO_FIX={'BH':'BA'}\ndef load(fn):\n    with open(fn, encoding='utf-8') as f: return list(csv.DictReader(f))\ndef pd_(s):\n    s=s.strip()\n    for f in ('%Y-%m-%d %H:%M:%S','%Y-%m-%d','%d/%m/%Y'):\n        try: return dt.datetime.strptime(s,f).date()\n        except ValueError: pass\n    return None\ndef g(s):\n    try: return int(float(s))\n    except (ValueError,TypeError): return None\ncand=collections.defaultdict(list)\ndef add(src, comp, d, h,a,hg,ag, se, hk, ak, rnd=None, stage=None, venue=None):\n    cand[(comp,se,hk,ak)].append(dict(src=src,comp=comp,d=d,h=h,a=a,hk=hk,ak=ak,hg=hg,ag=ag,rnd=rnd,stage=stage,venue=venue))\nfor r in load('data/kaggle/Brasileirao_Matches.csv'):\n    add('bras','serie_a',pd_(r['datetime']),r['home_team'],r['away_team'],g(r['home_goal']),g(r['away_goal']),int(r['season']),key(r['home_team']),key(r['away_team']),rnd=str(r['round']))\nfor r in load('data/kaggle/novo_campeonato_brasileiro.csv'):\n    def nk(team, uf):\n        uf = NOVO_FIX.get(uf, uf)\n        core = deacc(team)\n        if core=='vitoria' and uf=='ES': uf='BA'\n        return key(team, uf)\n    add('novo','serie_a',pd_(r['Data']),r['Equipe_mandante'],r['Equipe_visitante'],g(r['Gols_mandante']),g(r['Gols_visitante']),int(r['Ano']),nk(r['Equipe_mandante'],r['Mandante_UF']),nk(r['Equipe_visitante'],r['Visitante_UF']),rnd=r['Rodada'],venue=r['Arena'])\nfor r in load('data/kaggle/Brazilian_Cup_Matches.csv'):\n    add('cup','copa_do_brasil',pd_(r['datetime']),r['home_team'],r['away_team'],g(r['home_goal']),g(r['away_goal']),int(r['season']),key(r['home_team']),key(r['away_team']),rnd=str(r['round']))\nfor r in load('data/kaggle/Libertadores_Matches.csv'):\n    se=int(r['season']) if r['season']!='NA' else None\n    add('lib','libertadores',pd_(r['datetime']),r['home_team'],r['away_team'],g(r['home_goal']),g(r['away_goal']),se,key(r['home_team']),key(r['away_team']),stage=r['stage'])\nfor r in load('data/kaggle/BR-Football-Dataset.csv'):\n    t={'Serie A':'serie_a','Serie B':'serie_b','Serie C':'serie_c','Copa do Brasil':'copa_do_brasil'}[r['tournament']]\n    add('brf',t,pd_(r['date']),r['home'],r['away'],g(r['home_goal']),g(r['away_goal']),int(r['date'][:4]),key(r['home']),key(r['away']))\n\nLEAGUE={'serie_a','serie_b','serie_c'}\nPRIO={'bras':0,'cup':1,'lib':1,'novo':2,'brf':3}\nmatches=[]\nfor k,v in cand.items():\n    comp=k[0]\n    v.sort(key=lambda x:PRIO[x['src']])\n    kept=[]\n    for m in v:\n        dup=False\n        for i,kp in enumerate(kept):\n            same_score=(kp['hg'],kp['ag'])==(m['hg'],m['ag']) or (m['hg'],m['ag'])==(None,None) or (kp['hg'],kp['ag'])==(None,None)\n            close = (comp in LEAGUE) or (kp['d'] is None or m['d'] is None or abs((kp['d']-m['d']).days)<=2)\n            if same_score and close:\n                if (m['hg'],m['ag'])!=(None,None) and (kp['hg'],kp['ag'])==(None,None): kept[i]=m\n                dup=True; break\n        if not dup: kept.append(m)\n    matches.extend(kept)\nprint(\"total:\", len(matches), collections.Counter(m['comp'] for m in matches))\ns=collections.Counter(m['season'] for m in matches if m['comp']=='serie_a')\nprint(\"serie_a/season:\", dict(sorted(s.items())))\ns=collections.Counter(m['season'] for m in matches if m['comp']=='copa_do_brasil')\nprint(\"copa/season:\", dict(sorted(s.items())))\ns=collections.Counter(m['season'] for m in matches if m['comp']=='libertadores')\nprint(\"lib/season:\", dict(sorted(s.items())))\n\ndef table(comp,season):\n    t=collections.defaultdict(lambda: [0]*8)\n    for m in matches:\n        if m['comp']==comp and m['season']==season and m['hg'] is not None:\n            hk,ak,hg,ag=m['hk'],m['ak'],m['hg'],m['ag']\n            t[hk][0]+=1; t[ak][0]+=1\n            t[hk][4]+=hg; t[ak][4]+=hg; t[hk][5]+=ag; t[ak][5]+=ag\n            if hg>ag: t[hk][1]+=1; t[ak][3]+=1; t[hk][7]+=3\n            elif hg<ag: t[ak][1]+=1; t[hk][3]+=1; t[ak][7]+=3\n            else: t[hk][2]+=1; t[ak][2]+=1; t[hk][7]+=1; t[ak][7]+=1\n    return sorted(t.items(), key=lambda kv:(-kv[1][7],-kv[1][1],-(kv[1][4]-kv[1][5]),-kv[1][4]))\nprint(\"\\n2019 top3:\", table('serie_a',2019)[:3])\nprint(\"2018 champ:\", table('serie_a',2018)[:2])\nprint(\"2023 top2:\", table('serie_a',2023)[:2])\nprint(\"2020 bottom4:\", table('serie_a',2020)[-4:])\nc=w=d=l=gf=ga=0\nfor m in matches:\n    if m['comp']=='serie_a' and m['season']==2022 and m['hk']=='corinthians|SP' and m['hg'] is not None:\n        c+=1; gf+=m['hg']; ga+=m['ag']\n        w+= m['hg']>m['ag']; l+= m['hg']<m['ag']; d+= m['hg']==m['ag']\nprint(\"Corinthians home 2022:\", c,\"W\",w,\"D\",d,\"L\",l,\"GF\",gf,\"GA\",ga)\nfw=fl=dr=n=0\nfor m in matches:\n    if {m['hk'],m['ak']}=={'flamengo|RJ','fluminense|RJ'} and m['hg'] is not None:\n        n+=1\n        hg,ag=(m['hg'],m['ag']) if m['hk']=='flamengo|RJ' else (m['ag'],m['hg'])\n        fw+= hg>ag; fl+= hg<ag; dr+= hg==ag\nprint(\"Fla-Flu h2h:\", n, \"Fla\", fw, \"Flu\", fl, \"draw\", dr)\npl=[m for m in matches if m['comp']=='serie_a' and m['hg'] is not None]\nhw=sum(m['hg']>m['ag'] for m in pl); aw=sum(m['hg']<m['ag'] for m in pl); drw=sum(m['hg']==m['ag'] for m in pl)\nprint(\"serie_a played:\",len(pl),\"avg:\",round(sum(m['hg']+m['ag'] for m in pl)/len(pl),3),\"hw%:\",round(100*hw/len(pl),1),\"d%:\",round(100*drw/len(pl),1),\"aw%:\",round(100*aw/len(pl),1))\nbw=sorted([m for m in matches if m['hg'] is not None], key=lambda m:(-abs(m['hg']-m['ag']),-(m['hg']+m['ag'])))[:6]\nprint(\"biggest:\", [(str(m['d']),m['h'],m['hg'],m['ag'],m['a'],m['comp'],m['season']) for m in bw])\ncupm=[m for m in matches if m['comp']=='copa_do_brasil']\nfor sn in sorted(set(m['season'] for m in cupm)):\n    mx=max(int(m['rnd']) for m in cupm if m['season']==sn and m['rnd'] and m['rnd'].isdigit())\n    fin=[(m['h'],m['hg'],m['ag'],m['a']) for m in cupm if m['season']==sn and m['rnd'] and m['rnd'].isdigit() and int(m['rnd'])==mx]\n    print(\"cup final\", sn, \"round\", mx, fin)\nlibfin=[(m['season'],m['h'],m['hg'],m['ag'],m['a']) for m in matches if m['comp']=='libertadores' and m['stage']=='final']\nprint(\"lib finals:\", libfin)\nwith open('data/kaggle/fifa_data.csv', encoding='utf-8-sig') as f:\n    pros=list(csv.DictReader(f))\nprint(\"Gabriel Barbosa:\", [(r['Name'],r['Age'],r['Overall'],r['Club'],r['Position']) for r in pros if 'barbosa' in deacc(r['Name'])][:5])\nprint(\"Palmeiras 2023 matches:\", sum(1 for m in matches if m['season']==2023 and 'palmeiras|SP' in (m['hk'],m['ak'])))\naway=collections.defaultdict(lambda:[0.0,0])\nfor m in pl:\n    if m['hg']<m['ag']: away[m['ak']][0]+=3; away[m['ak']][1]+=1\n    elif m['hg']==m['ag']: away[m['ak']][0]+=1; away[m['ak']][1]+=1\n    else: away[m['ak']][1]+=1\nprint(\"best away ppg>=100:\", sorted(((k,round(v[0]/v[1],3),v[1]) for k,v in away.items() if v[1]>=100), key=lambda x:-x[1])[:4])\nhome=collections.defaultdict(lambda:[0.0,0])\nfor m in pl:\n    if m['hg']>m['ag']: home[m['hk']][0]+=3; home[m['hk']][1]+=1\n    elif m['hg']==m['ag']: home[m['hk']][0]+=1; home[m['hk']][1]+=1\n    else: home[m['hk']][1]+=1\nprint(\"best home ppg>=100:\", sorted(((k,round(v[0]/v[1],3),v[1]) for k,v in home.items() if v[1]>=100), key=lambda x:-x[1])[:4])\nEOF" action.permission=bash action.action=allow action.pattern=*
