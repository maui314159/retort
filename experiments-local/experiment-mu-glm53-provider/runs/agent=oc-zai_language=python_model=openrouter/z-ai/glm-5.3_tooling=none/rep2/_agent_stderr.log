timestamp=2026-09-01T14:35:52.959Z level=INFO run=bd57de6d message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport asyncio\nfrom mcp.server.mcpserver import MCPServer\n\nmcp = MCPServer(\"demo\", instructions=\"Demo server\")\n\n@mcp.tool()\ndef add(a: int, b: int) -> str:\n    \"\"\"Add two numbers.\"\"\"\n    return f\"sum={a+b}\"\n\nasync def main():\n    tools = await mcp.list_tools()\n    print(\"tools:\", [(t.name, t.description) for t in tools])\n    res = await mcp.call_tool(\"add\", {\"a\": 2, \"b\": 3})\n    print(\"result:\", res)\n    print(\"content:\", res.content)\n\nasyncio.run(main())\nEOF" action.permission=bash action.action=allow action.pattern=*
