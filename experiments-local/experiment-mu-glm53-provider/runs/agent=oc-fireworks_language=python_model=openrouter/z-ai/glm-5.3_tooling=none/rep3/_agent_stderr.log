timestamp=2026-09-01T10:22:14.152Z level=INFO run=f27b5900 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nfrom collections import defaultdict\nfrom brsoccer.data import load_default\nfrom brsoccer import queries as q\n\nsd = load_default()\n\nfins = [m for m in sd.matches_for_competition('libertadores') if m.stage == 'final']\nprint(\"LIB finals:\", sorted((str(m.season), str(m.date), m.home_display, m.score_text, m.away_display) for m in fins))\nun = [m for m in sd.matches_for_competition('libertadores') if not m.played]\nprint(\"LIB unplayed:\", len(un), [(str(m.date), m.home, m.away) for m in un])\n\ngb = q.search_players(sd, name=\"Gabriel Barbosa\", limit=None)\nprint(\"\\nGabriel Barbosa matches:\", len(gb), [p.name for p in gb])\n\ngroups = q.club_overview(sd)\nprint(\"\\nclub_overview:\", len(groups), [(g['display'], g['count'], round(g['avg_overall'],1)) for g in groups])\n\n# 2015 anomaly: which teams have played != 38\nt2015 = q.standings(sd, 'serie_a', 2015)\nprint(\"\\n2015 teams played:\", [(r.display, r.played) for r in t2015 if r.played != 38])\nodd = [r for r in t2015 if r.played != 38]\nfor r in odd:\n    key = r.team\n    ms = [m for m in sd.matches_for_competition('serie_a') if m.season == 2015 and m.involves(key)]\n    print(f\"  {r.display} ({key}) matches in 2015:\", [(str(m.date), m.home, m.away, m.home_goal, m.away_goal, m.source) for m in ms][:6])\nEOF" action.permission=bash action.action=allow action.pattern=*
