timestamp=2026-09-01T06:00:37.688Z level=INFO run=f180ecb5 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, collections, re, unicodedata\nbase='data/kaggle/'\ndef fold(s):\n    s = unicodedata.normalize('NFKD', s)\n    s = ''.join(ch for ch in s if not unicodedata.combining(ch))\n    return re.sub(r'[^a-z0-9]', '', s.lower()).replace('athletico','atletico')\ndef base_of(n):\n    n = re.sub(r'\\s*\\(antigo[^)]*\\)', '', n)\n    for pat in (r'\\s*-\\s*([A-Z]{2})$', r'-([A-Z]{2})$', r'\\s+([A-Z]{2})$'):\n        m = re.search(pat, n)\n        if m and m.start() > 0: n = n[:m.start()]; break\n    toks = n.split()\n    while toks and toks[-1].lower() in ('fc','ec','sc','ac'): toks.pop()\n    while toks and toks[0].lower() in ('fc','ec','sc','ac'): toks.pop(0)\n    return fold(' '.join(toks) or n)\n\nrows = [r for r in csv.DictReader(open(base+'BR-Football-Dataset.csv', encoding='utf-8-sig')) if r['tournament']=='Serie A']\nfor s in ('2020','2021','2022'):\n    sr = [r for r in rows if r['date'].startswith(s)]\n    pairs = collections.Counter((base_of(r['home']), base_of(r['away'])) for r in sr)\n    dated = collections.Counter((r['date'], base_of(r['home']), base_of(r['away'])) for r in sr)\n    dup = {k:v for k,v in pairs.items() if v>1}\n    dd = {k:v for k,v in dated.items() if v>1}\n    print(s, 'rows:', len(sr), 'unique pairs:', len(pairs), 'pair-dupes:', len(dup), 'dated-dupes:', len(dd))\n    if s=='2021':\n        # what are the 2021 pair-dupes: same pair twice - check dates/scores\n        for k,v in list(dup.items())[:6]:\n            ex = [r for r in sr if (base_of(r['home']), base_of(r['away']))==k]\n            print('   ', k, [(r['date'], r['home_goal'], r['away_goal']) for r in ex])\n        # count per team\n        tc = collections.Counter()\n        for r in sr: tc[base_of(r['home'])] += 1\n        print('   2021 team home-match counts (odd ones):', {t:c for t,c in tc.items() if c not in (19,20)})\nEOF" action.permission=bash action.action=allow action.pattern=*
