variants or cross-source\ninteresting = 0\nfor k, v in sorted(groups.items()):\n    srcs = set()\n    for n in v: srcs |= allnames[n]\n    if len(v) >= 3 or ('bra' in srcs and 'novo' in srcs) or ('copa' in srcs and 'brf' in srcs):\n        print(f\"{k}: {sorted(set(v))}\")\n        interesting += 1\nprint(\"interesting groups:\", interesting)\nEOF","time":{"start":1788254813726,"end":1788254813731}},"id":"prt_05c4aec88001BkD8F7Ye4Cad6Z","sessionID":"ses_fa3ba9cb2ffeFGH9rzdcVMfYFE","messageID":"msg_05c4a832f001PsU5RmOdj2wXmB"}}
