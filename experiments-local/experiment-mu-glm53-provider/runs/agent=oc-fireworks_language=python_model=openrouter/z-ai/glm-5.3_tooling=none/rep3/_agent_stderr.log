timestamp=2026-09-01T10:08:08.896Z level=INFO run=f27b5900 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nfrom collections import defaultdict\nfrom brsoccer.data import SoccerData\n\nsd = SoccerData.load()\nprint(\"total matches:\", len(sd.matches), \" players:\", len(sd.players), \" teams:\", len(sd.registry.entries))\n\nsa = sd.matches_for_competition('serie_a')\nper = defaultdict(int)\nfor m in sa:\n    per[m.season] += 1\nprint(\"serie_a per season:\", dict(sorted(per.items())))\n\ndef standings(season, comp='serie_a'):\n    tbl = defaultdict(lambda: [0]*6)  # pts,w,d,l,gf,ga\n    for m in sd.matches_for_competition(comp):\n        if m.season != season or not m.played: continue\n        for team, gf, ga in ((m.home, m.home_goal, m.away_goal), (m.away, m.away_goal, m.home_goal)):\n            t = tbl[team]; t[3]+=1; t[4]+=gf; t[5]+=ga\n            if gf > ga: t[0]+=3; t[1]+=1\n            elif gf == ga: t[0]+=1; t[2]+=1\n            else: t[3]+=1\n    return sorted(tbl.items(), key=lambda x: (-x[1][0], -(x[1][4]-x[1][5]), -x[1][4]))\n\nt2019 = standings(2019)\nprint(\"\\n2019 Serie A top 4:\")\nfor team, (pts,w,d,l,gf,ga) in t2019[:4]:\n    print(f\"  {sd.team_display(team)}: {pts} pts ({w}W {d}D {l}L) GF{gf} GA{ga}\")\nprint(\"2019 bottom 4:\", [sd.team_display(t) for t,_ in t2019[-4:]])\nt2020 = standings(2020)\nprint(\"2020 bottom 4:\", [sd.team_display(t) for t,_ in t2020[-4:]])\nprint(\"2020 count:\", sum(1 for m in sa if m.season==2020))\n\n# spot checks\nprint(\"\\nFlamengo key:\", sd.registry.key_of(\"Flamengo\"), \"->\", sd.team_display(sd.registry.key_of(\"Flamengo\")))\nprint(\"Atletico-MG variants unify:\", sd.registry.key_of(\"Atletico-MG\"), sd.registry.key_of(\"Atlético-MG\"), sd.registry.key_of(\"Atletico Mineiro\"), sd.registry.key_of(\"Atlético Mineiro - MG\"))\nprint(\"Athletico-PR unify:\", sd.registry.key_of(\"Athletico-PR\"), sd.registry.key_of(\"Atlético-PR\"), sd.registry.key_of(\"Athletico\"), sd.registry.key_of(\"Athletico Paranaense\"))\nprint(\"Vasco unify:\", sd.registry.key_of(\"Vasco da Gama-RJ\"), sd.registry.key_of(\"Vasco\"), sd.registry.key_of(\"Vasco Da Gama RJ\"))\nprint(\"Santos variants:\", sd.registry.key_of(\"Santos\"), sd.registry.key_of(\"Santos-SP\"), sd.registry.key_of(\"Santos - AP\"), sd.registry.key_of(\"Santos AP\"))\nprint(\"America:\", sd.registry.key_of(\"América - MG\"), sd.registry.key_of(\"America MG\"), sd.registry.key_of(\"América FC (Minas Gerais)\"), sd.registry.key_of(\"América - RN\"))\nprint(\"ABC dotted:\", sd.registry.key_of(\"A.b.c. - RN\"), sd.registry.key_of(\"ABC - RN\"), sd.registry.key_of(\"Abc - RN\"))\nprint(\"EC Bahia:\", sd.registry.key_of(\"EC Bahia\"), sd.registry.key_of(\"Bahia\"), sd.registry.key_of(\"Bahia de Feira\"))\nprint(\"Botafogo:\", sd.registry.key_of(\"Botafogo\"), sd.registry.key_of(\"Botafogo-RJ\"), sd.registry.key_of(\"Botafogo - PB\"), sd.registry.key_of(\"Botafogo SP\"))\nprint(\"Internacional:\", sd.registry.key_of(\"Internacional\"), sd.registry.key_of(\"Internacional-RS\"), sd.registry.key_of(\"EC Internacional SC\"), sd.registry.key_of(\"Internacional - SC\"))\nprint(\"Sport:\", sd.registry.key_of(\"Sport-PE\"), sd.registry.key_of(\"Sport Recife\"), sd.registry.key_of(\"Sport Club do Recife\"))\nprint(\"Ceara:\", sd.registry.key_of(\"Ceara-CE\"), sd.registry.key_of(\"Ceará Sporting Club\"), sd.registry.key_of(\"Fortaleza EC\"), sd.registry.key_of(\"Fortaleza FC\"))\n\n# Fla-Flu 2023 (spec example)\nff = [m for m in sd.matches if m.season==2023 and m.is_between(sd.registry.key_of(\"Flamengo\"), sd.registry.key_of(\"Fluminense\"))]\nprint(\"\\nFla-Flu 2023:\", [(m.date_text, m.home_display, m.home_goal, m.away_goal, m.away_display, m.competition, m.stage) for m in ff[:6]])\n\n# Copa finals (round 8)\nfins = [m for m in sd.matches_for_competition('copa_do_brasil') if m.stage == '8']\nprint(\"\\nCopa finals count:\", len(fins), \"seasons:\", sorted({m.season for m in fins}))\n\n# Player joins\nbj = [p for p in sd.players if p.club_key == sd.registry.key_of(\"Atlético Mineiro\")]\nprint(\"\\nFIFA players at Atlético Mineiro:\", len(bj), \"sample:\", [(p.name, p.overall) for p in bj[:4]])\nneymar = [p for p in sd.players if \"Neymar\" in p.name]\nprint(\"Neymar:\", [(p.name, p.overall, p.position, p.club) for p in neymar])\nprint(\"Brazilians:\", sum(1 for p in sd.players if p.nationality == 'Brazil'))\n\n# Libertadores 2019 final\nlf = [m for m in sd.matches_for_competition('libertadores') if m.stage=='final' and m.season==2019]\nprint(\"\\nLib 2019 final:\", [(m.date_text, m.home_display, m.home_goal, m.away_goal, m.away_display) for m in lf])\nEOF" action.permission=bash action.action=allow action.pattern=*
