import queries as q''')\nopen('tests/test_player_queries.py', 'w').write(src)\n\n# test_normalize: avoid constant-vs-constant comparison\nsrc = open('tests/test_normalize.py').read()\nsrc = src.replace('''        assert team_key(\"Atletico-GO\") != \"atletico-mg\"\n        assert team_key(\"América-RN\") == \"america-rn\" != \"america-mg\"''', '''        assert team_key(\"Atletico-GO\") == \"atletico-go\"\n        assert team_key(\"América-RN\") == \"america-rn\"\n        assert team_key(\"América-MG\") == \"america-mg\"''')\nopen('tests/test_normalize.py', 'w').write(src)\n\n# test_mcp_server: justify the BaseException catch\nsrc = open('tests/test_mcp_server.py').read()\nsrc = src.replace('''        except BaseException as exc:  # pragma: no cover - startup failures''',\n'''        except BaseException as exc:  # noqa: BLE001 - record any startup failure''')\nsrc = src.replace('''    def _serve(self) -> None:''', '''    def _serve(self) -> None:  # noqa: BLE001 handled below''')\nopen('tests/test_mcp_server.py', 'w').write(src)\nprint(\"patched\")\nEOF" action.permission=bash action.action=allow action.pattern=*
