timestamp=2026-08-01T01:54:35.117Z level=INFO run=ff7bdf63 message=evaluated permission=bash pattern="python3 -c \"\nfrom brazilian_soccer_mcp.data_loader import load_matches\nm = load_matches()\nprint('total matches:', len(m))\n# residual cross-file duplicates: same fixture within +-3 days, same score\nx = m.copy()\nx['day'] = x.date.dt.date\nx['pair'] = x.apply(lambda r: ' vs '.join(sorted([r.home_key, r.away_key])), axis=1)\nx = x.sort_values('date')\ndups = []\nfor (pair, hg, ag), grp in x.groupby(['pair','home_goals','away_goals']):\n    if len(grp) > 1:\n        days = sorted(set(grp.day))\n        for i in range(1, len(days)):\n            if (days[i] - days[i-1]).days <= 3:\n                dups.append((pair, hg, ag, days)); break\nprint('residual near-duplicate fixtures:', len(dups))\nfor d in dups[:20]: print(' ', d)\n\"" action.permission=bash action.action=allow action.pattern=*
