timestamp=2026-09-01T16:19:41.575Z level=INFO run=ec76643f message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\npath = 'brazilian_soccer/queries.py'\nsrc = open(path).read()\n\n# find_finals entry dict annotation\nsrc = src.replace('''        entry = {\n            \"season\": season_key,\n            \"matches\": [m.as_dict() for m in decisive],\n            \"winner_on_aggregate\": None,\n        }''',\n'''        entry: dict[str, object] = {\n            \"season\": season_key,\n            \"matches\": [m.as_dict() for m in decisive],\n            \"winner_on_aggregate\": None,\n        }''')\n\n# team_stats result annotation\nsrc = src.replace('''    record = _team_record(matches, key, venue)\n    result = {\n        \"team\": data.teams[key].display,\n        \"season\": season,\n        \"competition\": comp,\n        \"venue\": venue,\n        \"record\": record,\n    }''',\n'''    record = _team_record(matches, key, venue)\n    result: dict[str, object] = {\n        \"team\": data.teams[key].display,\n        \"season\": season,\n        \"competition\": comp,\n        \"venue\": venue,\n        \"record\": record,\n    }''')\n\n# club_overview result annotation\nsrc = src.replace('''    result = {\n        \"club\": info.display,\n        \"competitions_played\": competitions_played,\n        \"overall_record\": _team_record(matches, key),\n        \"by_competition\": [''',\n'''    result: dict[str, object] = {\n        \"club\": info.display,\n        \"competitions_played\": competitions_played,\n        \"overall_record\": _team_record(matches, key),\n        \"by_competition\": [''')\n\n# competitions_overview payload typing\nsrc = src.replace('''    payload = []\n    for comp in sorted(per_comp):\n        seasons = per_comp[comp]\n        payload.append(''',\n'''    payload: list[dict[str, object]] = []\n    for comp in sorted(per_comp):\n        seasons = per_comp[comp]\n        payload.append(''')\n\n# competition_stats via goal_pair\nsrc = src.replace('''    total_goals = sum(m.home_goals + m.away_goals for m in pool)\n    home_wins = sum(1 for m in pool if m.result == \"home\")\n    away_wins = sum(1 for m in pool if m.result == \"away\")\n    draws = len(pool) - home_wins - away_wins\n    dates = [m.date for m in pool if m.date]\n    biggest = max(pool, key=lambda m: abs(m.home_goals - m.away_goals))''',\n'''    total_goals = sum(m.goal_pair()[0] + m.goal_pair()[1] for m in pool if m.goal_pair())\n    home_goals_total = sum(m.goal_pair()[0] for m in pool if m.goal_pair())\n    away_goals_total = sum(m.goal_pair()[1] for m in pool if m.goal_pair())\n    home_wins = sum(1 for m in pool if m.result == \"home\")\n    away_wins = sum(1 for m in pool if m.result == \"away\")\n    draws = len(pool) - home_wins - away_wins\n    dates = [m.date for m in pool if m.date]\n    biggest = max(pool, key=lambda m: _goal_diff(m))''')\n\nsrc = src.replace('''        \"avg_home_goals\": _round(sum(m.home_goals for m in pool) / len(pool)),\n        \"avg_away_goals\": _round(sum(m.away_goals for m in pool) / len(pool)),''',\n'''        \"avg_home_goals\": _round(home_goals_total / len(pool)),\n        \"avg_away_goals\": _round(away_goals_total / len(pool)),''')\n\n# biggest_wins via helper\nsrc = src.replace('''    pool = _pick(conditions, data.matches)\n    pool.sort(\n        key=lambda m: (\n            -(abs(m.home_goals - m.away_goals)),\n            -(m.home_goals + m.away_goals),\n            m.date or dt.date.min,\n        )\n    )\n    winners: list[dict] = []\n    for m in pool[:limit]:\n        margin = abs(m.home_goals - m.away_goals)\n        winner = (\n            data.teams[m.home].display if m.home_goals > m.away_goals\n            else data.teams[m.away].display\n        )\n        winners.append({**m.as_dict(), \"margin\": margin, \"winner\": winner})''',\n'''    pool = _pick(conditions, data.matches)\n    pool.sort(\n        key=lambda m: (\n            -_goal_diff(m),\n            -_goal_total(m),\n            m.date or dt.date.min,\n        )\n    )\n    winners: list[dict] = []\n    for m in pool[:limit]:\n        margin = _goal_diff(m)\n        winner = (\n            data.teams[m.home].display if _goal_diff(m) > 0\n            else data.teams[m.away].display\n        )\n        winners.append({**m.as_dict(), \"margin\": margin, \"winner\": winner})''')\n\n# helpers\nsrc = src.replace('''def _round(value: float, digits: int = 2) -> float:\n    return round(value, digits)''',\n'''def _round(value: float, digits: int = 2) -> float:\n    return round(value, digits)\n\n\ndef _goal_diff(match: Match) -> int:\n    \"\"\"Absolute goal difference; unplayed matches count as 0.\"\"\"\n    pair = match.goal_pair()\n    return abs(pair[0] - pair[1]) if pair else 0\n\n\ndef _goal_total(match: Match) -> int:\n    pair = match.goal_pair()\n    return pair[0] + pair[1] if pair else 0''')\n\nopen(path, 'w').write(src)\nprint(\"patched\")\nEOF" action.permission=bash action.action=allow action.pattern=*
