timestamp=2026-09-01T05:06:13.345Z level=INFO run=1a470e0e message=evaluated permission=bash pattern="./venv/bin/python << 'EOF'\nfrom brazilian_soccer_mcp.loaders import load_all\nfrom brazilian_soccer_mcp.models import BRASILEIRAO_A\ndata = load_all('data/kaggle')\n\n# Build fixture keys from primary source for 2019, then find novo survivors\nbras = {}\nfor m in data.matches:\n    if m.competition == BRASILEIRAO_A and m.season == 2019 and m.source == \"Brasileirao_Matches.csv\":\n        bras[(m.home_id, m.away_id)] = (m.home_goals, m.away_goals)\n\nnovo_survivors = [m for m in data.matches\n                  if m.competition == BRASILEIRAO_A and m.season == 2019 and m.source == \"novo_campeonato_brasileiro.csv\"]\nprint(\"novo 2019 survivors:\", len(novo_survivors))\nfor m in novo_survivors[:6]:\n    key = (m.home_id, m.away_id)\n    print(f\"  novo: {m.home_display} {m.score_str()} {m.away_display} | bras key: {bras.get(key)}\")\n\n# BRFB survivors sample 2019\nbrfb = [m for m in data.matches\n        if m.competition == BRASILEIRAO_A and m.season == 2019 and m.source == \"BR-Football-Dataset.csv\"]\nprint(\"\\nBRFB 2019 survivors:\", len(brfb))\nfor m in brfb[:6]:\n    key = (m.home_id, m.away_id)\n    print(f\"  brfb: {m.home_display} {m.score_str()} {m.away_display} | bras: {bras.get(key)}\")\nEOF" action.permission=bash action.action=allow action.pattern=*
