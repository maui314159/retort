timestamp=2026-09-01T05:20:13.650Z level=INFO run=7ae6fc3c message=evaluated permission=bash pattern="python - <<'EOF'\nimport csv, collections\np='data/kaggle/'\nwith open(p+'BR-Football-Dataset.csv', encoding='utf-8') as f:\n    rows=[r for r in csv.DictReader(f) if r['tournament']=='Serie A' and r['date'].startswith('2021')]\n# Compare with Brasileirao 2021 fixtures\nwith open(p+'Brasileirao_Matches.csv', encoding='utf-8') as f:\n    bra=[r for r in csv.DictReader(f) if r['season']=='2021']\nbra_keys = {(r['datetime'][:10], r['home_team'].replace('-',''), r['away_team'].replace('-','')) for r in bra}\ndef key(r):\n    import re, unicodedata\n    d=lambda s: ''.join(c for c in unicodedata.normalize('NFKD', s) if not unicodedata.combining(c))\n    h=d(r['home']).lower().replace(' ',''); a=d(r['away']).lower().replace(' ','')\n    # strip state suffixes on brasileirao names\n    h=h.replace('rj','').replace('sp','').replace('mg','').replace('pr','').replace('rs','').replace('sc','').replace('ce','').replace('go','').replace('pe','').replace('al','').replace('mt','').replace('ba','')\n    a=a.replace('rj','').replace('sp','').replace('mg','').replace('pr','').replace('rs','').replace('sc','').replace('ce','').replace('go','').replace('pe','').replace('al','').replace('mt','').replace('ba','')\n    return (r['date'], h, a)\nextra = [r for r in rows if key(r) not in bra_keys]\nprint(\"BRF rows not matching a Brasileirao 2021 fixture:\", len(extra))\nfor r in extra[:8]: print(\" \", r['date'], r['home'], r['home_goal'],'-',r['away_goal'], r['away'])\nEOF" action.permission=bash action.action=allow action.pattern=*
