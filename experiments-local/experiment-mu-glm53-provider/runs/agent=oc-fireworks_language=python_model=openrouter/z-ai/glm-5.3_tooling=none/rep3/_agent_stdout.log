r['source']=='Brasileirao_Matches.csv' and r['season']==season}\n        extra = keys - bras_pairs\n        print(f\"  extra pairs not in BRAS: {len(extra)}\")\n        for (h,a) in list(extra)[:10]:\n            rows = buckets[(h,a)]\n            print(\"   EXTRA:\", h, a, [(r['source'], str(r['date']), r['home_goal'], r['away_goal']) for r in rows])\n            # is the reverse in bras?\n            rev = (a, h)\n            print(\"      reverse pair rows:\", [(r['source'], str(r['date']), r['home_goal'], r['away_goal']) for r in buckets.get(rev, [])][:3])\nEOF"},"output":"\n2015: pairs=381 reversed-dupes=0\n\n2020: pairs=418 reversed-dupes=0\n  extra pairs not in BRAS: 38\n   EXTRA: bragantino sp sport [('BR-Football-Dataset.csv', '2020-10-19', 2, 0)]\n      reverse pair rows: [('BR-Football-Dataset.csv', '2021-02-15', 0, 0)]\n   EXTRA: internacional rs bragantino sp [('BR-Football-Dataset.csv', '2021-01-31', 2, 1)]\n      reverse pair rows: [('BR-Football-Dataset.csv', '2020-10-09', 0, 2)]\n   EXTRA: bragantino sp internacional rs [('BR-Football-Dataset.csv', '2020-10-09', 0, 2)]\n      reverse pair rows: [('BR-Football-Dataset.csv', '2021-01-31', 2, 1)]\n   EXTRA: bragantino sp atletico pr [('BR-Football-Dataset.csv', '2020-12-20', 0, 1)]\n      reverse pair rows: [('BR-Football-Dataset.csv', '2020-09-03', 1, 1)]\n   EXTRA: bragantino sp bahia [('BR-Football-Dataset.csv', '2020-11-20', 4, 0)]\n      reverse pair rows: [('BR-Football-Dataset.csv', '2020-08-16', 2, 1)]\n   EXTRA: bragantino sp palmeiras [('BR-Football-Dataset.csv', '2020-09-06', 1, 2)]\n      reverse pair rows: [('BR-Football-Dataset.csv', '2020-12-27', 1, 0)]\n   EXTRA: coritiba bragantino sp [('BR-Football-Dataset.csv', '2020-12-06', 0, 0)]\n      reverse pair rows: [('BR-Football-Dataset.csv', '2020-08-23', 1, 2)]\n   EXTRA: sport bragantino sp [('BR-Football-Dataset.csv', '2021-02-15', 0, 0)]\n      reverse pair rows: [('BR-Football-Dataset.csv', '2020-10-19', 2, 0)]\n   EXTRA: bragantino s