timestamp=2026-08-31T19:27:46.993Z level=INFO run=532d90f3 message=evaluated permission=bash pattern="venv/bin/python -c \"\nfrom bsoccer.data_loader import load_all\nfrom collections import defaultdict\nmatches, players = load_all()\n\ndef table(source, season):\n    rows = [m for m in matches if m.source_file==source and m.season==season and m.competition=='Brasileirão Série A']\n    t = defaultdict(lambda: {'P':0,'W':0,'D':0,'L':0,'GF':0,'GA':0})\n    for m in rows:\n        for side, gf, ga in [('home', m.home_goal, m.away_goal), ('away', m.away_goal, m.home_goal)]:\n            team = m.home if side=='home' else m.away\n            t[team]['P'] += 1; t[team]['GF'] += gf; t[team]['GA'] += ga\n            if gf > ga: t[team]['W'] += 1\n            elif gf == ga: t[team]['D'] += 1\n            else: t[team]['L'] += 1\n    for team, s in t.items(): s['Pts'] = s['W']*3 + s['D']\n    return sorted(t.items(), key=lambda kv: (-kv[1]['Pts'], -(kv[1]['GF']-kv[1]['GA']), -kv[1]['GF']))\n\n# 2019 from Brasileirao_Matches\nrows = [m for m in matches if m.source_file=='Brasileirao_Matches.csv' and m.season==2019]\nprint('2019 matches in Brasileirao_Matches:', len(rows))\nfor i,(team,s) in enumerate(table('Brasileirao_Matches.csv', 2019)[:5],1): print(i, team, s)\nprint('...')\nfor i,(team,s) in enumerate(table('Brasileirao_Matches.csv', 2019)[-4:],17): print(i, team, s)\nprint()\nrows2 = [m for m in matches if m.source_file=='novo_campeonato_brasileiro.csv' and m.season==2019]\nprint('2019 matches in novo:', len(rows2))\nprint(table('novo_campeonato_brasileiro.csv', 2019)[0])\n# 2020 relegation check: 2020 in Brasileirao_Matches?\nprint('2020 matches:', len([m for m in matches if m.source_file=='Brasileirao_Matches.csv' and m.season==2020]))\n\"" action.permission=bash action.action=allow action.pattern=*
