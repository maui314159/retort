timestamp=2026-06-25T03:30:04.092Z level=INFO run=9c04db1c message=evaluated permission=bash pattern="python3 - <<'PY'\nimport csv, os, re, collections\nbase = '/private/var/folders/t6/p1v727892_qc9xqqdzq2rpym0000gn/T/retort-local-tjpsd7_l/retort-8ea0ffcc10d3/data/kaggle'\n\ndef canon(n):\n    n=n.strip(); n=re.sub(r'\\s*-\\s*[A-Z]{2}$','',n); n=re.sub(r'\\s*\\([^)]*\\)','',n).strip(); n=re.sub(r' Atlético',' Atletico', n)\n    return re.sub(r'[^A-Za-z0-9]+','',n).lower()\n\ndef score(v):\n    try: return int(float(v))\n    except: return None\n\n# 2019 from novo\nstand=collections.defaultdict(lambda: {'pts':0,'w':0,'d':0,'l':0,'gf':0,'ga':0})\nwith open(os.path.join(base,'novo_campeonato_brasileiro.csv'),encoding='utf-8') as f:\n    for r in csv.DictReader(f):\n        if int(r['Ano'])==2019:\n            h=canon(r['Equipe_mandante']); a=canon(r['Equipe_visitante'])\n            hg=score(r['Gols_mandante']); ag=score(r['Gols_visitante'])\n            if hg is None or ag is None: continue\n            if hg>ag:\n                stand[h]['pts']+=3; stand[h]['w']+=1; stand[a]['l']+=1\n            elif hg==ag:\n                stand[h]['pts']+=1; stand[a]['pts']+=1; stand[h]['d']+=1; stand[a]['d']+=1\n            else:\n                stand[a]['pts']+=3; stand[a]['w']+=1; stand[h]['l']+=1\n            stand[h]['gf']+=hg; stand[h]['ga']+=ag; stand[a]['gf']+=ag; stand[a]['ga']+=hg\nrank=sorted(stand.items(), key=lambda x: (x[1]['pts'], x[1]['gf']-x[1]['ga'], x[1]['gf']), reverse=True)\nprint('2019 novo champion', rank[0])\nprint('2019 novo bottom 4', rank[-4:])\n\n# 2020 from Brasileirao_Matches\nstand2=collections.defaultdict(lambda: {'pts':0,'w':0,'d':0,'l':0,'gf':0,'ga':0})\nwith open(os.path.join(base,'Brasileirao_Matches.csv'),encoding='utf-8') as f:\n    for r in csv.DictReader(f):\n        if int(float(r['season']))==2020:\n            h=canon(r['home_team']); a=canon(r['away_team'])\n            hg=score(r['home_goal']); ag=score(r['away_goal'])\n            if hg is None or ag is None: continue\n            if hg>ag:\n                stand2[h]['pts']+=3; stand2[h]['w']+=1; stand2[a]['l']+=1\n            elif hg==ag:\n                stand2[h]['pts']+=1; stand2[a]['pts']+=1; stand2[h]['d']+=1; stand2[a]['d']+=1\n            else:\n                stand2[a]['pts']+=3; stand2[a]['w']+=1; stand2[h]['l']+=1\n            stand2[h]['gf']+=hg; stand2[h]['ga']+=ag; stand2[a]['gf']+=ag; stand2[a]['ga']+=hg\nrank2=sorted(stand2.items(), key=lambda x: (x[1]['pts'], x[1]['gf']-x[1]['ga'], x[1]['gf']), reverse=True)\nprint('\\n2020 Brasileirao champion', rank2[0])\nprint('2020 Brasileirao bottom 4', rank2[-4:])\nprint('num teams', len(rank2))\nPY" action.permission=bash action.action=allow action.pattern=*
