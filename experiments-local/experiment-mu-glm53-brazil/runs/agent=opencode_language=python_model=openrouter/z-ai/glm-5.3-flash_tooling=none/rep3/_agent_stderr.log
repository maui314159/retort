timestamp=2026-09-01T03:15:37.193Z level=INFO run=2973fea4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport sys, csv\nsys.path.insert(0, '.')\nfrom brazilian_soccer.loader import load_all, DATA_DIR\nfrom collections import Counter\n\nreg, matches, players = load_all()\nsa2019 = [m for m in matches if m.competition == \"Brasileirão Serie A\" and m.season == 2019]\npairs = Counter((m.home_key, m.away_key) for m in sa2019)\ndups = {k: v for k, v in pairs.items() if v > 1}\nprint(\"dup pairs:\", dups)\nfor h, a in dups:\n    for m in sa2019:\n        if (m.home_key, m.away_key) == (h, a):\n            print(\"  \", m.source, m.date, m.home_raw, m.home_goal, \"-\", m.away_goal, m.away_raw)\n\n# find the lib row\nwith open(DATA_DIR / \"Libertadores_Matches.csv\", newline='', encoding='utf-8-sig') as f:\n    for r in csv.DictReader(f):\n        if 'Flamengo' in r['home_team'] and 'Athletico' in r['away_team'] and not r['season'].strip().isdigit():\n            print(\"LIB RAW:\", r)\nEOF" action.permission=bash action.action=allow action.pattern=*
