timestamp=2026-09-01T05:58:44.499Z level=INFO run=f180ecb5 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, re, collections, unicodedata\nbase='data/kaggle/'\ndef fold(s):\n    s = unicodedata.normalize('NFKD', s)\n    s = ''.join(ch for ch in s if not unicodedata.combining(ch))\n    return re.sub(r'[^a-z0-9]', '', s.lower()).replace('athletico','atletico')\ndef base_of(n):\n    n = re.sub(r'\\s*\\(antigo[^)]*\\)', '', n)\n    for pat in (r'\\s*-\\s*([A-Z]{2})$', r'-([A-Z]{2})$', r'\\s+([A-Z]{2})$'):\n        m = re.search(pat, n)\n        if m: n = n[:m.start()]; break\n    n = re.sub(r'\\s*\\(antigo[^)]*\\)', '', n)\n    toks = n.split()\n    while toks and toks[-1].lower() in ('fc','ec','sc','ac'): toks.pop()\n    while toks and toks[0].lower() in ('fc','ec','sc','ac'): toks.pop(0)\n    return fold(' '.join(toks))\n\n# novo per-season counts\nnv = collections.Counter(r['Ano'] for r in csv.DictReader(open(base+'novo_campeonato_brasileiro.csv', encoding='utf-8-sig')))\nprint('novo per-season:', dict(sorted(nv.items())))\nbr = collections.Counter(r['season'] for r in csv.DictReader(open(base+'Brasileirao_Matches.csv', encoding='utf-8-sig')))\nprint('br per-season:', dict(sorted(br.items())))\nbrf = collections.Counter(r['date'][:4] for r in csv.DictReader(open(base+'BR-Football-Dataset.csv', encoding='utf-8-sig')) if r['tournament']=='Serie A')\nprint('brf serieA per-season:', dict(sorted(brf.items())))\n\n# serie B/C: rows vs unique (season, pair)\nfor tour in ('Serie B','Serie C'):\n    pairs = collections.Counter()\n    dated = collections.Counter()\n    for r in csv.DictReader(open(base+'BR-Football-Dataset.csv', encoding='utf-8-sig')):\n        if r['tournament'] != tour: continue\n        pairs[(r['date'][:4], base_of(r['home']), base_of(r['away']))] += 1\n        dated[(r['date'][:4], r['date'], base_of(r['home']), base_of(r['away']))] += 1\n    dup = {k:v for k,v in pairs.items() if v>1}\n    print(tour, 'rows->pairs unique:', len(pairs), 'dated-unique:', len(dated), 'pair-dupes:', len(dup), list(dup.items())[:4])\n\n# expected serie A total from my merge model\nALIAS = {}\n# find split-entity suspects: br keys vs brf base resolution mismatch\nbr_keys = {}\nfor r in csv.DictReader(open(base+'Brasileirao_Matches.csv', encoding='utf-8-sig')):\n    for t,c in ((r['home_team'],'h'),(r['away_team'],'a')):\n        b = base_of(t)\n        m = re.search(r'-([A-Z]{2})$', t)\n        if m: br_keys.setdefault(b, set()).add(m.group(1))\nbrf_res_fail = collections.Counter()\nfor r in csv.DictReader(open(base+'BR-Football-Dataset.csv', encoding='utf-8-sig')):\n    if r['tournament'] != 'Serie A': continue\n    for side in ('home','away'):\n        b = base_of(r[side])\n        # if base maps to a br key with exactly one state it's fine; check multi\n        if len(br_keys.get(b, ())) != 1 and b in br_keys:\n            brf_res_fail[b] += 1\nprint('serieA brf rows w/ ambiguous-or-missing br-state:', dict(brf_res_fail))\nEOF" action.permission=bash action.action=allow action.pattern=*
