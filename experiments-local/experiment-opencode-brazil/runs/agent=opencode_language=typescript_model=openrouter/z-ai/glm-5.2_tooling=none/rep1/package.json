{
  "name": "brazilian-soccer-mcp",
  "version": "2.0.0",
  "description": "MCP server providing a knowledge graph interface for Brazilian soccer data",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "brazilian-soccer-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "test": "node --test --test-reporter=spec dist/tests/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts || true"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "csv-parse": "^5.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
