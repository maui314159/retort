timestamp=2026-09-01T04:57:19.280Z level=INFO run=1a470e0e message=evaluated permission=bash pattern="timeout 30 ./venv/bin/python << 'EOF'\nimport asyncio\nfrom brazilian_soccer_mcp.loaders import load_all\nfrom brazilian_soccer_mcp.service import SoccerService\nfrom brazilian_soccer_mcp.server import build_server\nfrom mcp.client._memory import InMemoryTransport\nfrom mcp.client.session import ClientSession\n\nasync def main():\n    svc = SoccerService(load_all('data/kaggle'))\n    server = build_server(svc)\n    async with InMemoryTransport(server) as transport:\n        async with ClientSession(transport[0], transport[1]) as session:\n            await session.initialize()\n            tools = await session.list_tools()\n            print(f\"{len(tools.tools)} tools:\", [t.name for t in tools.tools])\n            res = await session.call_tool(\"standings\", {\"competition\": \"brasileirao\", \"season\": 2019})\n            print(\"\\nstandings 2019 (first 400 chars):\")\n            print(res.content[0].text[:400])\n            res = await session.call_tool(\"champion\", {\"competition\": \"libertadores\", \"season\": 2019})\n            print(\"\\nchampion lib 2019:\", res.content[0].text)\n            res = await session.call_tool(\"head_to_head\", {\"team_a\": \"Flamengo\", \"team_b\": \"Fluminense\"})\n            text = res.content[0].text\n            print(\"\\nh2h fla-flu tail:\", text.split(\"\\n\")[-1])\n            res = await session.call_tool(\"search_players\", {\"nationality\": \"Brazil\", \"min_overall\": 90})\n            print(\"\\nBR players >=90:\", res.content[0].text[:200])\n            res = await session.call_tool(\"search_matches\", {\"team\": \"Atletico Mineiro\"})  # error case: valid\n            print(\"\\nsearch ok:\", res.content[0].text.split(\"\\n\")[0])\n            res = await session.call_tool(\"team_record\", {\"team\": \"Corinthians\", \"season\": 2022, \"competition\": \"brasileirao\", \"venue\": \"home\"})\n            print(\"\\ncorinthians home 2022:\\n\", res.content[0].text)\n\nasyncio.run(main())\nEOF" action.permission=bash action.action=allow action.pattern=*
