timestamp=2026-06-25T02:02:09.018Z level=INFO run=ed0cdab1 message=evaluated permission=bash pattern="node -e \"\nimport { loadDataset } from './dist/loader.js';\nimport { QueryEngine } from './dist/engine.js';\nimport { resolve } from 'path';\nconst store = await loadDataset(resolve('data', 'kaggle'));\nconst engine = new QueryEngine(store);\nconsole.log('Copa do Brasil rounds:', [...new Set(store.matches.filter(m => m.competition === 'Copa do Brasil').map(m => m.round))].slice(0, 30));\nconsole.log('Flamengo clubs:', [...new Set(store.players.filter(p => p.club && /flamengo/i.test(p.club)).map(p => p.club))].slice(0, 10));\nconsole.log('Sao Paulo clubs:', [...new Set(store.players.filter(p => p.club && /paulo/i.test(p.club)).map(p => p.club))].slice(0, 10));\nconst s2019 = engine.calculateStandings('Brasileirão', 2019);\nconsole.log('2019 top 5:', s2019.slice(0, 5).map(s => s.team + ' ' + s.points));\nconst atMatches = store.matches.filter(m => m.season === 2019 && (m.homeTeam === 'Atletico' || m.awayTeam === 'Atletico'));\nconsole.log('Atletico 2019 sample:', atMatches.slice(0, 5).map(m => m.homeTeam + ' ' + m.homeGoal + ' x ' + m.awayGoal + ' ' + m.awayTeam));\nconstamg = store.matches.filter(m => m.season === 2019 && (m.homeTeam.toLowerCase().includes('atletico') || m.awayTeam.toLowerCase().includes('atletico'))).slice(0, 10);\nconsole.log('Atletico-like 2019:', amg.map(m => m.homeTeam + ' v ' + m.awayTeam));\n\"" action.permission=bash action.action=allow action.pattern=*
