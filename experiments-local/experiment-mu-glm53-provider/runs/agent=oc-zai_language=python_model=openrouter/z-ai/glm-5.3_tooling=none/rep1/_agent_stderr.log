timestamp=2026-09-01T05:10:15.804Z level=INFO run=1a470e0e message=evaluated permission=bash pattern="./venv/bin/python << 'EOF'\nfrom brazilian_soccer_mcp.loaders import load_all\nfrom brazilian_soccer_mcp.service import SoccerService\nfrom brazilian_soccer_mcp import formatting as fmt\nsvc = SoccerService(load_all('data/kaggle'))\n\nst = svc.standings(\"brasileirao\", 2019)\nprint(\"2019 champ:\", st.champion.display, st.champion.points, (st.champion.wins, st.champion.draws, st.champion.losses))\nprint(\"2019 runner:\", st.table[1].display, st.table[1].points, (st.table[1].wins, st.table[1].draws, st.table[1].losses))\nprint(\"2019 3rd:\", st.table[2].display, st.table[2].points, (st.table[2].wins, st.table[2].draws, st.table[2].losses))\n\nr = svc.team_record(\"Corinthians\", season=2022, competition=\"brasileirao\", venue=\"home\")\nprint(\"cor home 2022:\", r.record.matches, (r.record.wins, r.record.draws, r.record.losses), (r.record.goals_for, r.record.goals_against))\n\nprint(\"derbies 2023:\", len(svc.derby_matches(season=2023)))\nprint(\"flaflu:\", svc.head_to_head(\"Flamengo\", \"Fluminense\").a_wins, svc.head_to_head(\"Flamengo\",\"Fluminense\").b_wins, svc.head_to_head(\"Flamengo\",\"Fluminense\").draws)\n\ns = svc.competition_stats(\"brasileirao\")\nprint(\"serieA stats:\", s.matches, s.avg_goals, s.home_win_rate, s.draw_rate, s.away_win_rate)\ns19 = svc.competition_stats(\"brasileirao\", 2019); print(\"serieA 2019:\", s19.matches, s19.avg_goals)\ns18 = svc.competition_stats(\"brasileirao\", 2018); print(\"serieA 2018:\", s18.matches, s18.avg_goals)\nlib = svc.competition_stats(\"libertadores\"); print(\"lib:\", lib.matches, lib.avg_goals)\n\nbw = svc.biggest_wins(limit=3)\nfor m in bw: print(\"biggest:\", m.date_str(), m.home_display, m.score_str(), m.away_display, m.competition)\nbw19 = svc.biggest_wins(competition=\"brasileirao\", season=2019, limit=1)\nprint(\"biggest 2019 league:\", bw19[0].home_display, bw19[0].score_str(), bw19[0].away_display, bw19[0].margin())\nbwlib = svc.biggest_wins(competition=\"libertadores\", limit=1)\nprint(\"biggest lib:\", bwlib[0].score_str())\n\nprint(\"best away:\", [(r.display, round(r.win_rate*100,1), r.matches) for r in svc.best_records(venue=\"away\", min_matches=50, limit=3)])\nprint(\"best home 2019:\", [(r.display, r.matches) for r in svc.best_records(venue=\"home\", competition=\"brasileirao\", season=2019, min_matches=19, limit=2)])\nprint(\"best home all(min100):\", svc.best_records(venue=\"home\", min_matches=100, limit=1)[0].display, round(svc.best_records(venue=\"home\", min_matches=100, limit=1)[0].win_rate*100,1))\n\ninfo = svc.team_overview(\"Palmeiras\")\nprint(\"palmeiras:\", info[\"record\"].matches, info[\"record\"].summary_line(), info[\"squad_size\"], info[\"squad_in_fifa\"])\nprint(\"palmeiras seasons:\", info[\"competitions\"][\"Brasileirão Série A\"][0], info[\"competitions\"][\"Brasileirão Série A\"][-1])\ninfo_g = svc.team_overview(\"Grêmio\"); print(\"grêmio:\", info_g[\"record\"].matches, info_g[\"squad_size\"])\n\nres = svc.search_matches(team=\"Palmeiras\", date_from=\"2023-08-01\", date_to=\"2023-09-30\")\nprint(\"palmeiras aug-sep 2023:\", res.total)\nfor m in res.matches[:2]: print(\"  \", fmt.format_match_line(m))\nr23 = svc.team_record(\"Palmeiras\", season=2023)\nprint(\"palmeiras 2023 matches:\", r23.record.matches)\nts = svc.standings(\"serie a\", 2023)\nprint(\"2023 top scorer:\", max(ts.table, key=lambda r: r.goals_for).display, max(r.goals_for for r in ts.table))\nprint(\"relegated 2020:\", [r.display for r in svc.relegated(\"brasileirao\", 2020)])\nprint(\"relegated 2019:\", [r.display for r in svc.relegated(\"brasileirao\", 2019)])\nh = svc.head_to_head(\"Palmeiras\", \"Santos\")\nprint(\"pal-santos:\", h.a_wins, h.b_wins, h.draws, len(h.matches))\nprint(\"fla-cor total:\", svc.search_matches(team=\"Flamengo\", opponent=\"Corinthians\", limit=1).total)\nlast = svc.search_matches(team=\"Flamengo\", opponent=\"Corinthians\", limit=1).matches[0]\nprint(\"last fla-cor:\", last.date_str(), last.home_display, last.score_str())\nprint(\"lib 2019 semis:\", svc.search_matches(competition=\"libertadores\", season=2019, stage=\"semifinals\").total)\nprint(\"copa 2019 matches:\", svc.search_matches(competition=\"Copa do Brasil\", season=2019, limit=500).total)\nprint(\"sept 2023:\", svc.search_matches(date_from=\"2023-09-01\", date_to=\"2023-09-30\", limit=200).total)\nprint(\"palmeiras 2023 total:\", svc.search_matches(team=\"Palmeiras\", season=2023).total)\nprint(\"fla 2019 league:\", svc.team_record(\"Flamengo\", season=2019, competition=\"brasileirao\").record.matches)\nprint(\"fla 2019 all comps:\", svc.team_record(\"Flamengo\", season=2019).record.matches)\nprint(\"corinthians variants:\", svc.registry.variants(\"corinthians\"))\nprint(\"atletico-mg variants:\", svc.registry.variants(\"atletico-mg\")[:4])\nprint(\"brazilians@clubs top:\", svc.brazilians_at_brazilian_clubs()[:2])\nprint(\"squad santos:\", len(svc.club_squad(\"Santos\").players), svc.club_squad(\"Santos\").fifa_clubs)\nprint(\"search club Santos substring:\", len(svc.search_players(club=\"Santos\", limit=100)))\nprint(\"2018 champion:\", svc.standings(\"brasileirao\", 2018).champion.display, svc.standings(\"brasileirao\", 2018).champion.points)\nprint(\"champion text 2019:\", svc.champion(\"brasileirao\", 2019).replace(\"\\n\", \" | \"))\nprint(\"2022 note:\", fmt.format_standings(svc.standings(\"brasileirao\", 2022)).split(\"\\n\")[-1])\nprint(\"finals cup:\", len(svc.finals(\"Copa do Brasil\")), \"| finals lib:\", len(svc.finals(\"Libertadores\")))\nprint(\"athletico 2018 pts:\", svc.team_record(\"Atletico Mineiro\", season=2018).record.points)\nEOF" action.permission=bash action.action=allow action.pattern=*
