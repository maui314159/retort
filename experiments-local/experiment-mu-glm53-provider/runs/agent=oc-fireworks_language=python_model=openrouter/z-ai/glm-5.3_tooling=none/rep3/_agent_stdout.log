{"type":"tool_use","timestamp":1788257453879,"sessionID":"ses_fa39bca00ffeV1iObla3wLMRAJ","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-86f798749cc6c4e4","state":{"status":"completed","input":{"filePath":"/Users/maui/.retort/work/retort-local-7ooj92cj/retort-ad7c1ce592bf/brsoccer/data.py","limit":185,"offset":374},"output":"<path>/Users/maui/.retort/work/retort-local-7ooj92cj/retort-ad7c1ce592bf/brsoccer/data.py</path>\n<type>file</type>\n<content>\n374:     @classmethod\n375:     def load(cls, data_dir: str | Path | None = None) -> \"SoccerData\":\n376:         \"\"\"Load all six CSV datasets (two registry passes + dedupe).\"\"\"\n377:         directory = find_data_dir(data_dir)\n378:         raw_rows = _raw_rows(directory)\n379: \n380:         # Pass 1: feed every team spelling to the registry.\n381:         registry = TeamRegistry()\n382:         for row in raw_rows:\n383:             registry.ingest(row[\"home_raw\"])\n384:             registry.ingest(row[\"away_raw\"])\n385:         registry.finalize()\n386: \n387:         # Pass 2: build canonical Match rows, deduped per competition.\n388:         matches = _build_matches(raw_rows, registry)\n389:         players = _load_players(directory, registry)\n390:         return cls(matches, players, registry)\n391: \n392:     # -- convenience ------------------------------------------------------\n393: \n394:     def matches_for_team(self, key: str) -> list[Match]:\n395:         return self._by_team.get(key, [])\n396: \n397:     def matches_for_competition(self, code: str) -> list[Match]:\n398:         return self._by_comp.get(code, [])\n399: \n400:     def team_display(self, key: str) -> str:\n401:         return self.registry.display_of(key)\n402: \n403:     def is_brazilian_team(self, key: str) -> bool:\n404:         \"\"\"True when a team plays in one of the Brazilian competitions.\"\"\"\n405:         entry = self.registry.entry_of(key)\n406:         return bool(entry and (entry.competitions & {\"serie_a\", \"serie_b\", \"serie_c\", \"copa_do_brasil\"}))\n407: \n408:     def brazilian_team_keys(self) -> list[str]:\n409:         return [k for k in self.registry.entries if self.is_brazilian_team(k)]\n410: \n411:     def seasons_for(self, code: str) -> list[int]:\n412:         seasons = {m.season for m in self.matches_for_competition(code) if m.season}\n413:         return sorted(seasons)\n414: \n415: \n416: def _build_matches(raw_rows: list[dict], registry: TeamRegistry) -> list[Match]:\n417:     \"\"\"Turn raw rows into deduped, merged :class:`Match` objects.\n418: \n419:     The source files overlap: both Brasileirão files cover 2012-2019 and\n420:     BR-Football covers 2014-2023, with the same fixture sometimes dated a\n421:     day apart (timezone drift between sources).\n422: \n423:     * ``serie_a`` / ``serie_b`` are pure double round-robin leagues, so\n424:       each ordered ``(season, home, away)`` pair occurs exactly once per\n425:       season -- buckets collapse on that key regardless of small date\n426:       drift, with source priority (see ``_SOURCE_PRIORITY``) breaking\n427:       score conflicts.\n428:     * ``serie_c`` (final-phase rematches), the cups and Libertadores can\n429:       legitimately meet the same pair repeatedly, so those dedupe on the\n430:       exact ``(date, home, away)`` first and then fuzzy-merge rows of the\n431:       same season/pair dated within one day when the scores agree.\n432:     \"\"\"\n433:     priority = {\n434:         comp: {name: rank for rank, name in enumerate(names)}\n435:         for comp, names in _SOURCE_PRIORITY.items()\n436:     }\n437:     ordered_rows = sorted(\n438:         raw_rows,\n439:         key=lambda r: priority[r[\"competition\"]].get(r[\"source\"], 99),\n440:     )\n441: \n442:     league_buckets: dict[tuple, list[Match]] = defaultdict(list)\n443:     cup_buckets: dict[tuple, list[Match]] = defaultdict(list)\n444: \n445:     for row in ordered_rows:\n446:         comp = row[\"competition\"]\n447:         home = registry.key_of(row[\"home_raw\"])\n448:         away = registry.key_of(row[\"away_raw\"])\n449:         if not home or not away:\n450:             continue\n451:         match = Match(\n452:             date=row[\"date\"],\n453:             date_text=row[\"date_text\"],\n454:             competition=comp,\n455:             competition_display=COMPETITIONS[comp],\n456:             season=row[\"season\"],\n457:             stage=row[\"stage\"],\n458:             home=home,\n459:             away=away,\n460:             home_display=registry.display_of(home),\n461:             away_display=registry.display_of(away),\n462:             home_goal=row[\"home_goal\"],\n463:             away_goal=row[\"away_goal\"],\n464:             kickoff=row[\"kickoff\"],\n465:             venue=row[\"venue\"],\n466:             source=row[\"source\"],\n467:         )\n468:         if row[\"stats\"]:\n469:             match = replace(match, **row[\"stats\"])\n470:         if comp in (\"serie_a\", \"serie_b\"):\n471:             league_buckets[(row[\"season\"], home, away)].append(match)\n472:         else:\n473:             cup_buckets[(row[\"date\"], home, away)].append(match)\n474: \n475:     matches: list[Match] = []\n476:     # Leagues: one row per ordered pair per season.\n477:     for bucket in league_buckets.values():\n478:         primary = bucket[0]\n479:         for duplicate in bucket[1:]:\n480:             primary = _merge(primary, duplicate)\n481:         matches.append(primary)\n482:     # Cups: exact-date key first, then a +/-1 day fuzzy pass per season pair.\n483:     seen: dict[tuple, list[Match]] = defaultdict(list)\n484:     for (match_date, home, away), bucket in cup_buckets.items():\n485:         primary = bucket[0]\n486:         for duplicate in bucket[1:]:\n487:             primary = _merge(primary, duplicate)\n488:         seen[(primary.season, home, away)].append(primary)\n489:     for group in seen.values():\n490:         merged: list[Match] = []\n491:         for match in group:\n492:             duplicate_of = None\n493:             for kept in merged:\n494:                 if (\n495:                     kept.date\n496:                     and match.date\n497:                     and abs((kept.date - match.date).days) <= 1\n498:                     and _same_score(kept, match)\n499:                 ):\n500:                     duplicate_of = kept\n501:                     break\n502:             if duplicate_of is None:\n503:                 merged.append(match)\n504:             else:\n505:                 merged[merged.index(duplicate_of)] = _merge(duplicate_of, match)\n506:         matches.extend(merged)\n507:     return matches\n508: \n509: \n510: def _same_score(a: Match, b: Match) -> bool:\n511:     \"\"\"True when two rows agree on the score (missing scores tolerated).\"\"\"\n512:     if not a.played and not b.played:\n513:         return True\n514:     if a.played and not b.played:\n515:         return True\n516:     if not a.played and b.played:\n517:         return True\n518:     return a.home_goal == b.home_goal and a.away_goal == b.away_goal\n519: \n520: \n521: def _merge(primary: Match, duplicate: Match) -> Match:\n522:     \"\"\"Keep ``primary`` but graft any richer fields from ``duplicate``.\"\"\"\n523:     updates: dict = {}\n524:     for attr in (\n525:         \"home_goal\",\n526:         \"away_goal\",\n527:         \"kickoff\",\n528:         \"venue\",\n529:         \"home_corners\",\n530:         \"away_corners\",\n531:         \"home_shots\",\n532:         \"away_shots\",\n533:         \"home_attacks\",\n534:         \"away_attacks\",\n535:     ):\n536:         if getattr(primary, attr) is None and getattr(duplicate, attr) is not None:\n537:             updates[attr] = getattr(duplicate, attr)\n538:     if not primary.stage and duplicate.stage:\n539:         updates[\"stage\"] = duplicate.stage\n540:     if updates:\n541:         return replace(primary, **updates)\n542:     return primary\n543: \n544: \n545: __all__ = [\n546:     \"SoccerData\",\n547:     \"COMPETITIONS\",\n548:     \"LEAGUES\",\n549:     \"canonical_competition\",\n550:     \"find_data_dir\",\n551:     \"load_default\",\n552: ]\n553: \n554: \n555: def load_default(data_dir: str | Path | None = None) -> SoccerData:\n556:     \"\"\"Convenience wrapper around :meth:`SoccerData.load`.\"\"\"\n557:     return SoccerData.load(data_dir)\n\n(End of file - total 557 lines)\n</content>","metadata":{"preview":"    @classmethod\n    def load(cls, data_dir: str | Path | None = None) -> \"SoccerData\":\n        \"\"\"Load all six CSV datasets (two registry passes + dedupe).\"\"\"\n        directory = find_data_dir(data_dir)\n        raw_rows = _raw_rows(directory)\n\n        # Pass 1: feed every team spelling to the registry.\n        registry = TeamRegistry()\n        for row in raw_rows:\n            registry.ingest(row[\"home_raw\"])\n            registry.ingest(row[\"away_raw\"])\n        registry.finalize()\n\n        # Pass 2: build canonical Match rows, deduped per competition.\n        matches = _build_matches(raw_rows, registry)\n        players = _load_players(directory, registry)\n        return cls(matches, players, registry)\n\n    # -- convenience ------------------------------------------------------\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/maui/.retort/work/retort-local-7ooj92cj/retort-ad7c1ce592bf/brsoccer/data.py","text":"    @classmethod\n    def load(cls, data_dir: str | Path | None = None) -> \"SoccerData\":\n        \"\"\"Load all six CSV datasets (two registry passes + dedupe).\"\"\"\n        directory = find_data_dir(data_dir)\n        raw_rows = _raw_rows(directory)\n\n        # Pass 1: feed every team spelling to the registry.\n        registry = TeamRegistry()\n        for row in raw_rows:\n            registry.ingest(row[\"home_raw\"])\n            registry.ingest(row[\"away_raw\"])\n        registry.finalize()\n\n        # Pass 2: build canonical Match rows, deduped per competition.\n        matches = _build_matches(raw_rows, registry)\n        players = _load_players(directory, registry)\n        return cls(matches, players, registry)\n\n    # -- convenience ------------------------------------------------------\n\n    def matches_for_team(self, key: str) -> list[Match]:\n        return self._by_team.get(key, [])\n\n    def matches_for_competition(self, code: str) -> list[Match]:\n        return self._by_comp.get(code, [])\n\n    def team_display(self, key: str) -> str:\n        return self.registry.display_of(key)\n\n    def is_brazilian_team(self, key: str) -> bool:\n        \"\"\"True when a team plays in one of the Brazilian competitions.\"\"\"\n        entry = self.registry.entry_of(key)\n        return bool(entry and (entry.competitions & {\"serie_a\", \"serie_b\", \"serie_c\", \"copa_do_brasil\"}))\n\n    def brazilian_team_keys(self) -> list[str]:\n        return [k for k in self.registry.entries if self.is_brazilian_team(k)]\n\n    def seasons_for(self, code: str) -> list[int]:\n        seasons = {m.season for m in self.matches_for_competition(code) if m.season}\n        return sorted(seasons)\n\n\ndef _build_matches(raw_rows: list[dict], registry: TeamRegistry) -> list[Match]:\n    \"\"\"Turn raw rows into deduped, merged :class:`Match` objects.\n\n    The source files overlap: both Brasileirão files cover 2012-2019 and\n    BR-Football covers 2014-2023, with the same fixture sometimes dated a\n    day apart (timezone drift between sources).\n\n    * ``serie_a`` / ``serie_b`` are pure double round-robin leagues, so\n      each ordered ``(season, home, away)`` pair occurs exactly once per\n      season -- buckets collapse on that key regardless of small date\n      drift, with source priority (see ``_SOURCE_PRIORITY``) breaking\n      score conflicts.\n    * ``serie_c`` (final-phase rematches), the cups and Libertadores can\n      legitimately meet the same pair repeatedly, so those dedupe on the\n      exact ``(date, home, away)`` first and then fuzzy-merge rows of the\n      same season/pair dated within one day when the scores agree.\n    \"\"\"\n    priority = {\n        comp: {name: rank for rank, name in enumerate(names)}\n        for comp, names in _SOURCE_PRIORITY.items()\n    }\n    ordered_rows = sorted(\n        raw_rows,\n        key=lambda r: priority[r[\"competition\"]].get(r[\"source\"], 99),\n    )\n\n    league_buckets: dict[tuple, list[Match]] = defaultdict(list)\n    cup_buckets: dict[tuple, list[Match]] = defaultdict(list)\n\n    for row in ordered_rows:\n        comp = row[\"competition\"]\n        home = registry.key_of(row[\"home_raw\"])\n        away = registry.key_of(row[\"away_raw\"])\n        if not home or not away:\n            continue\n        match = Match(\n            date=row[\"date\"],\n            date_text=row[\"date_text\"],\n            competition=comp,\n            competition_display=COMPETITIONS[comp],\n            season=row[\"season\"],\n            stage=row[\"stage\"],\n            home=home,\n            away=away,\n            home_display=registry.display_of(home),\n            away_display=registry.display_of(away),\n            home_goal=row[\"home_goal\"],\n            away_goal=row[\"away_goal\"],\n            kickoff=row[\"kickoff\"],\n            venue=row[\"venue\"],\n            source=row[\"source\"],\n        )\n        if row[\"stats\"]:\n            match = replace(match, **row[\"stats\"])\n        if comp in (\"serie_a\", \"serie_b\"):\n            league_buckets[(row[\"season\"], home, away)].append(match)\n        else:\n            cup_buckets[(row[\"date\"], home, away)].append(match)\n\n    matches: list[Match] = []\n    # Leagues: one row per ordered pair per season.\n    for bucket in league_buckets.values():\n        primary = bucket[0]\n        for duplicate in bucket[1:]:\n            primary = _merge(primary, duplicate)\n        matches.append(primary)\n    # Cups: exact-date key first, then a +/-1 day fuzzy pass per season pair.\n    seen: dict[tuple, list[Match]] = defaultdict(list)\n    for (match_date, home, away), bucket in cup_buckets.items():\n        primary = bucket[0]\n        for duplicate in bucket[1:]:\n            primary = _merge(primary, duplicate)\n        seen[(primary.season, home, away)].append(primary)\n    for group in seen.values():\n        merged: list[Match] = []\n        for match in group:\n            duplicate_of = None\n            for kept in merged:\n                if (\n                    kept.date\n                    and match.date\n                    and abs((kept.date - match.date).days) <= 1\n                    and _same_score(kept, match)\n                ):\n                    duplicate_of = kept\n                    break\n            if duplicate_of is None:\n                merged.append(match)\n            else:\n                merged[merged.index(duplicate_of)] = _merge(duplicate_of, match)\n        matches.extend(merged)\n    return matches\n\n\ndef _same_score(a: Match, b: Match) -> bool:\n    \"\"\"True when two rows agree on the score (missing scores tolerated).\"\"\"\n    if not a.played and not b.played:\n        return True\n    if a.played and not b.played:\n        return True\n    if not a.played and b.played:\n        return True\n    return a.home_goal == b.home_goal and a.away_goal == b.away_goal\n\n\ndef _merge(primary: Match, duplicate: Match) -> Match:\n    \"\"\"Keep ``primary`` but graft any richer fields from ``duplicate``.\"\"\"\n    updates: dict = {}\n    for attr in (\n        \"home_goal\",\n        \"away_goal\",\n        \"kickoff\",\n        \"venue\",\n        \"home_corners\",\n        \"away_corners\",\n        \"home_shots\",\n        \"away_shots\",\n        \"home_attacks\",\n        \"away_attacks\",\n    ):\n        if getattr(primary, attr) is None and getattr(duplicate, attr) is not None:\n            updates[attr] = getattr(duplicate, attr)\n    if not primary.stage and duplicate.stage:\n        updates[\"stage\"] = duplicate.stage\n    if updates:\n        return replace(primary, **updates)\n    return primary\n\n\n__all__ = [\n    \"SoccerData\",\n    \"COMPETITIONS\",\n    \"LEAGUES\",\n    \"canonical_competition\",\n    \"find_data_dir\",\n    \"load_default\",\n]\n\n\ndef load_default(data_dir: str | Path | None = None) -> SoccerData:\n    \"\"\"Convenience wrapper around :meth:`SoccerData.load`.\"\"\"\n    return SoccerData.load(data_dir)","lineStart":374,"lineEnd":557,"totalLines":557,"truncated":false}},"title":"brsoccer/data.py","time":{"start":1788257453866,"end":1788257453877}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05c734539001RM69fCa4eZNFAL","sessionID":"ses_fa39bca00ffeV1iObla3wLMRAJ","messageID":"msg_05c733f4c001RooGbyD6Il3Csy"}}
