timestamp=2026-08-31T18:59:28.300Z level=INFO run=9abcf33e message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nfrom brazilian_soccer_mcp.queries import get_engine\nfrom collections import Counter, defaultdict\ne = get_engine(\"data/kaggle\")\n\nfor season in (2023, 2022, 2021):\n    for comp in (\"Brasileirão Série A\", \"Brasileirão Série B\"):\n        pairs = Counter()\n        for m in e._iter_matches([comp], season):\n            pairs[frozenset((m.home_key, m.away_key))] += 1\n        extra = {tuple(sorted(p, key=str)): c for p, c in pairs.items() if c > 2}\n        total = sum(pairs.values())\n        print(f\"{comp} {season}: {total} matches, {len(pairs)} pairs, pairs with >2 meetings: {len(extra)}\")\n        if extra and season == 2023:\n            for pair, count in list(extra.items())[:12]:\n                print(\"   \", pair, count)\nEOF" action.permission=bash action.action=allow action.pattern=*
