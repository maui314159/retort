timestamp=2026-08-31T19:03:10.798Z level=INFO run=ec94ecf4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv, unicodedata\nfrom collections import Counter, defaultdict\n\ndef norm(t):\n    t = unicodedata.normalize(\"NFKD\", t).encode(\"ascii\",\"ignore\").decode()\n    return t.strip().lower()\n\nwith open(\"data/kaggle/Brasileirao_Matches.csv\", encoding=\"utf-8\") as f:\n    bra = [r for r in csv.DictReader(f) if r[\"season\"]==\"2019\"]\nwith open(\"data/kaggle/novo_campeonato_brasileiro.csv\", encoding=\"utf-8\") as f:\n    novo = [r for r in csv.DictReader(f) if r[\"Ano\"]==\"2019\"]\nwith open(\"data/kaggle/BR-Football-Dataset.csv\", encoding=\"utf-8\") as f:\n    brf = [r for r in csv.DictReader(f) if r[\"tournament\"]==\"Serie A\" and r[\"date\"].startswith(\"2019\")]\n\ndef bra_k(r): return (r[\"datetime\"][:10], norm(r[\"home_team\"]), norm(r[\"away_team\"]))\ndef novo_k(r): return (r[\"Data\"][6:]+\"-\"+r[\"Data\"][3:5]+\"-\"+r[\"Data\"][:2], norm(r[\"Equipe_mandante\"]), norm(r[\"Equipe_visitante\"]))\ndef brf_k(r): return (r[\"date\"], norm(r[\"home\"]), norm(r[\"away\"]))\n\nkb = {bra_k(r) for r in bra}; kn = {novo_k(r) for r in novo}; kf = {brf_k(r) for r in brf}\nprint(\"bra:\", len(bra), len(kb), \" novo:\", len(novo), len(kn), \" brf:\", len(brf), len(kf))\nprint(\"bra∩novo:\", len(kb & kn), \"bra∩brf:\", len(kb & kf), \"novo∩brf:\", len(kn & kf))\n\n# Flamengo 2019 W/D/L from brasileirao matches only\npts = defaultdict(lambda: [0,0,0,0,0])  # W,D,L,GF,GA\nfor r in bra:\n    h, a, hg, ag = norm(r[\"home_team\"]), norm(r[\"away_team\"]), int(r[\"home_goal\"]), int(r[\"away_goal\"])\n    for t, gf, ga in [(h,hg,ag),(a,ag,hg)]:\n        p = pts[t]; p[3]+=gf; p[4]+=ga\n        if gf>ga: p[0]+=1\n        elif gf==ga: p[1]+=1\n        else: p[2]+=1\ntab = sorted(pts.items(), key=lambda kv: (-(kv[1][0]*3+kv[1][1]), -(kv[1][3]-kv[1][4])))\nfor i,(t,p) in enumerate(tab[:5],1):\n    print(i, t, p, \"pts:\", p[0]*3+p[1])\nprint(\"...\")\nfor i,(t,p) in enumerate(tab[-4:], len(tab)-3):\n    print(i, t, p, \"pts:\", p[0]*3+p[1])\nEOF" action.permission=bash action.action=allow action.pattern=*
