timestamp=2026-09-01T04:57:37.545Z level=INFO run=22cd9675 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport sys; sys.path.insert(0, \".\")\nfrom brazilian_soccer.repository import DataRepository\nfrom brazilian_soccer import queries\nrepo = DataRepository()\n\n# Corinthians home 2019 (complete season)\nts = queries.team_stats(repo, \"Corinthians\", season=2019)\nprint(\"Corinthians 2019:\", ts[\"overall\"], \"| home:\", ts[\"home\"])\n\n# Libertadores 2019 final\nf = queries.search_matches(repo, competition=\"Libertadores\", season=2019, stage=\"final\")\nfor m in f[\"matches\"]:\n    print(\"Lib 2019 final:\", m[\"date\"], m[\"home_team\"], m[\"home_goals\"], \"-\", m[\"away_goals\"], m[\"away_team\"])\n\n# Cup 2019 finals\ncf = queries.search_matches(repo, competition=\"Copa do Brasil\", season=2019, stage=\"final\")\nprint(\"Cup 2019 finals:\", [(m['home_team'], m['home_goals'], m['away_goals'], m['away_team']) for m in cf[\"matches\"]])\nprint(\"final_rounds:\", repo.final_rounds)\n\n# team_stats: Palmeiras competitions\nts = queries.team_stats(repo, \"Palmeiras\")\nprint(\"Palmeiras comps:\", [(c[\"competition\"], c[\"matches\"]) for c in ts[\"by_competition\"]])\n\n# find_team cross-file\nft = queries.find_team(repo, \"Atlético Mineiro\")\nprint(\"Atletico Mineiro:\", [(r[\"team\"], r[\"matches_in_dataset\"], r[\"players_in_fifa_dataset\"]) for r in ft[\"results\"]])\n\n# last Flamengo x Corinthians match\nh = queries.head_to_head(repo, \"Flamengo\", \"Corinthians\", limit=1)\nprint(\"Fla x Cor most recent:\", h[\"most_recent\"][\"date\"], h[\"most_recent\"][\"home_team\"], h[\"most_recent\"][\"home_goals\"], \"-\", h[\"most_recent\"][\"away_goals\"], h[\"most_recent\"][\"away_team\"], \"| total:\", h[\"matches_played\"])\n\n# biggest win 2019 serie a\nbw = queries.biggest_wins(repo, competition=\"Brasileirão Serie A\", season=2019, limit=3)\nfor m in bw[\"biggest_wins\"]:\n    print(\"2019 big win:\", m[\"date\"], m[\"home_team\"], m[\"home_goals\"], \"-\", m[\"away_goals\"], m[\"away_team\"])\n\n# search date range\nr = queries.search_matches(repo, date_from=\"2019-05-01\", date_to=\"2019-05-31\", competition=\"Brasileirão Serie A\", limit=1)\nprint(\"May 2019 Serie A matches:\", r[\"total_matches\"])\n\n# player position search\npl = queries.search_players(repo, club=\"Santos\", position=\"forward\", limit=10)\nprint(\"Santos forwards:\", [(p[\"name\"], p[\"overall\"]) for p in pl[\"players\"]])\npl2 = queries.search_players(repo, club=\"Gremio\", min_overall=80, limit=10)\nprint(\"Grêmio >=80:\", [(p[\"name\"], p[\"overall\"]) for p in pl2[\"players\"]])\n\n# stadium sample from 2019\nm = [x for x in repo.matches if x.season == 2019 and x.stadium and x.competition.startswith(\"Brasileirão\")][:2]\nprint(\"stadiums:\", [(x.home_display, x.stadium) for x in m])\n\n# derbies 2019 serie a\nd = queries.derby_matches(repo, season=2019)\nprint(\"derbies 2019:\", d[\"total_matches\"], [x[\"derby\"] for x in d[\"derbies\"][:5]])\n\n# rankings home win rate 2023 serie a\nrk = queries.team_rankings(repo, competition=\"serie a\", season=2023, metric=\"wins\", limit=3)\nprint(\"2023 wins:\", [(r[\"team\"], r[\"wins\"]) for r in rk[\"rankings\"]])\nEOF" action.permission=bash action.action=allow action.pattern=*
