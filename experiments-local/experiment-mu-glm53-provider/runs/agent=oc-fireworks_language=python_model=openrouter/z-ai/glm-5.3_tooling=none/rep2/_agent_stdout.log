)].add(m.group(1))\nfor r in csv.DictReader(open(base+'Brasileirao_Matches.csv', encoding='utf-8-sig')):\n    for t in (r['home_team'], r['away_team']):\n        m = re.search(r'-([A-Z]{2})$', t)\n        if m: states[fold(re.sub(r'-[A-Z]{2}$', '', t))].add(m.group(1))\namb = {b for b,s in states.items() if len(s)>1}\ncnt = collections.Counter()\nfor r in csv.DictReader(open(base+'BR-Football-Dataset.csv', encoding='utf-8-sig')):\n    if r['tournament'] == 'Copa do Brasil': continue\n    for side in ('home','away'):\n        b = fold(r[side])\n        if b in amb: cnt[(r['tournament'], r['date'][:4], b)] += 1\nprint('ALL ambiguous league rows:', len(cnt))\nfor k, v in sorted(cnt.items()):\n    if not k[0].startswith('Serie A') or k[2] not in ('flamengo','santos','internacional','bragantino'):\n        print('  ', k, v)\n\n# cup file truncated names\ncup_names = collections.Counter()\nfor r in csv.DictReader(open(base+'Brazilian_Cup_Matches.csv', encoding='utf-8-sig')):\n    cup_names[r['home_team']] += 1; cup_names[r['away_team']] += 1\nknown_bases = set()\nfor r in csv.DictReader(open(base+'Brasileirao_Matches.csv', encoding='utf-8-sig')):\n    known_bases.add(fold(re.sub(r'-[A-Z]{2}$', '', r['home_team'])))\ntrunc = [n for n in cup_names if re.search(r'-\\s*[A-Z]$', n) or (len(n) >= 24 and not re.search(r'-\\s*[A-Z]{2}\\s*$', n))]\nprint('possibly truncated cup names:', trunc)\n\n# BR-Foot Serie A fixtures not matching br (pair, season) - examples\nbr_pairs = set()\nfor r in csv.DictReader(open(base+'Brasileirao_Matches.csv', encoding='utf-8-sig')):\n    br_pairs.add((fold(re.sub(r'-[A-Z]{2}$','',r['home_team'])), fold(re.sub(r'-[A-Z]{2}$','',r['away_team'])), r['season']))\nunmatched = collections.Counter()\nfor r in csv.DictReader(open(base+'BR-Football-Dataset.csv', encoding='utf-8-sig')):\n    if r['tournament'] != 'Serie A': continue\n    s = r['date'][:4]\n    if (fold(r['home']), fold(r['away']), s) not in br_pairs:\n        unmatched[(r['home'], r['away'],