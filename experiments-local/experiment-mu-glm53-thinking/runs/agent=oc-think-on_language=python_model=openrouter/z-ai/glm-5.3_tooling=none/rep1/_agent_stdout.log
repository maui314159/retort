s\"]])\nfl = q.find_finals(data, \"Libertadores\")\nprint(\"lib finals:\", [(f[\"season\"], f.get(\"winner_on_aggregate\")) for f in fl[\"finals\"]])\n\n# derby sweep 2023\ndm = q.derby_matches(data, season=2023)\nprint(\"2023 derbies:\", [(d[\"derby\"], d[\"total_matches\"]) for d in dm[\"derbies\"] if d[\"total_matches\"] > 0])\n\n# search by date range\nsm2 = q.search_matches(data, team=\"Flamengo\", date_from=\"2023-09-01\", date_to=\"2023-09-30\", limit=50)\nprint(\"Flamengo Sep 2023:\", sm2[\"total_matches\"], [m[\"date\"] for m in sm2[\"matches\"][:5]])\n\n# copa libertadores 2020 stage filter\nsl = q.search_matches(data, competition=\"Libertadores\", season=2019, stage=\"final\", limit=10)\nprint(\"Lib 2019 finals:\", [(m[\"home\"], m[\"score\"], m[\"away\"]) for m in sl[\"matches\"]])\nEOF"},"output":"Corinthians home 2019 Serie A: {'matches': 19, 'wins': 10, 'draws': 7, 'losses': 2, 'goals_for': 25, 'goals_against': 13, 'win_rate': 52.6, 'form_last_10': ['D', 'W', 'W', 'D', 'L', 'D', 'W', 'D', 'W', 'L']}\nFla x Cor latest: 2023-10-08 Corinthians 1-1 Flamengo | total: 47\nPalmeiras 2023 fixtures: 43\n2023 most GF: Grêmio 63 | champion: Grêmio | note: None\n2023 relegated: ['Vasco da Gama', 'Goiás', 'Coritiba', 'América-MG']\nbest away 2019: [('Flamengo', [19, 11]), ('Santos', [19, 8]), ('Palmeiras', [19, 8])]\ncup finals seasons: [(2012, 'Palmeiras'), (2013, 'Flamengo'), (2014, 'Atlético-MG'), (2015, None), (2016, 'Grêmio'), (2017, None), (2018, 'Cruzeiro'), (2019, 'Athletico-PR'), (2020, 'Palmeiras'), (2021, None)]\nlib finals: [(2013, None), (2014, 'San Lorenzo'), (2015, 'River Plate'), (2016, 'Atlético Nacional'), (2017, 'Grêmio'), (2018, 'River Plate'), (2019, 'Flamengo'), (2020, 'Palmeiras'), (None, None)]\n2023 derbies: [('Fla-Flu', 4), ('Clássico dos Milhões', 2), ('Gre-Nal', 2), ('Clássico Mineiro', 2), ('Derby Paulista', 2), ('Majestoso', 4), ('Choque-Rei', 4), ('San-São', 2), ('Atletiba', 2)]\nFlamengo Sep 2023: 6 ['2023-09-30', '2023-09-24', '202