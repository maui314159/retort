timestamp=2026-09-01T05:20:53.155Z level=INFO run=7ae6fc3c message=evaluated permission=bash pattern="python - <<'EOF'\nimport csv, collections\nfrom soccer_mcp.clubs import resolve_club, fallback_club\nfrom soccer_mcp.normalize import parse_datetime\ndef rc(name): return (resolve_club(name) or fallback_club(name)).club_id\np='data/kaggle/'\nwith open(p+'BR-Football-Dataset.csv', encoding='utf-8') as f:\n    brf=[r for r in csv.DictReader(f)]\nwith open(p+'Brasileirao_Matches.csv', encoding='utf-8') as f:\n    bra=[r for r in csv.DictReader(f) if r['season']>='2014']\nbidx = collections.defaultdict(list)\nfor r in bra:\n    bidx[(r['season'], rc(r['home_team']), rc(r['away_team']))].append(parse_datetime(r['datetime'])[0])\ndiffs = collections.Counter(); nomatch=0; total=0; nomatch_teams=collections.Counter()\nfor r in brf:\n    if r['tournament']!='Serie A': continue\n    d = parse_datetime(r['date'])[0]; season=str(d.year)\n    h,w = rc(r['home']), rc(r['away'])\n    k=(season,h,w); total+=1\n    if k not in bidx:\n        nomatch+=1; nomatch_teams[h]+=1; continue\n    diffs[min(abs((d-x).days) for x in bidx[k])]+=1\nprint(\"Serie A rows:\", total, \"pairing not in Brasileirao file:\", nomatch)\nprint(\"top unmatched home teams:\", nomatch_teams.most_common(6))\nprint(\"date diff distribution:\", dict(sorted(diffs.items())))\nwith open(p+'Brazilian_Cup_Matches.csv', encoding='utf-8') as f:\n    cup=[r for r in csv.DictReader(f)]\ncidx = collections.defaultdict(list)\nfor r in cup:\n    cidx[(r['season'], rc(r['home_team']), rc(r['away_team']))].append(parse_datetime(r['datetime'])[0])\ncd = collections.Counter(); cn=0; ct=0; cnteams=collections.Counter()\nfor r in brf:\n    if r['tournament']!='Copa do Brasil': continue\n    d = parse_datetime(r['date'])[0]; season=str(d.year)\n    h,w = rc(r['home']), rc(r['away']); k=(season,h,w); ct+=1\n    if k not in cidx: cn+=1; cnteams[h]+=1; continue\n    cd[min(abs((d-x).days) for x in cidx[k])]+=1\nprint(\"Cup rows:\", ct, \"pairing not in cup file:\", cn, cnteams.most_common(4))\nprint(\"cup date diffs:\", dict(sorted(cd.items())))\nEOF" action.permission=bash action.action=allow action.pattern=*
