{"type":"step_start","timestamp":1788233949447,"sessionID":"ses_fa52b88b3ffeUF09L5H3uZ1cg4","part":{"id":"prt_05b0ca0ef001xbQrgrasoljC7H","messageID":"msg_05b0c4a71001XNhgRPOStEug1s","sessionID":"ses_fa52b88b3ffeUF09L5H3uZ1cg4","snapshot":"30c91a8cf242c4d90727dab6a70b9fb867ca3209","type":"step-start"}}
{"type":"tool_use","timestamp":1788233949457,"sessionID":"ses_fa52b88b3ffeUF09L5H3uZ1cg4","part":{"type":"tool","tool":"write","callID":"call_ad69902233b24a15bac773d9","state":{"status":"completed","input":{"content":"\"\"\"End-to-end test: the real MCP server over stdio, driven by an MCP client.\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport json\nimport os\nimport sys\n\nimport pytest\n\nfrom mcp import ClientSession, StdioServerParameters\nfrom mcp.client.stdio import stdio_client\n\nSERVER = os.path.join(os.path.dirname(os.path.dirname(__file__)), \"server.py\")\n\nEXPECTED_TOOLS = {\n    \"search_matches\", \"get_head_to_head\", \"get_team_stats\", \"get_team_history\",\n    \"list_teams\", \"get_competitions\", \"get_standings\", \"compare_seasons\",\n    \"search_players\", \"get_player\", \"search_players_at_club\",\n    \"get_statistics\", \"get_derbies\", \"answer_question\",\n}\n\n\ndef _call(json_text: str) -> dict:\n    return json.loads(json_text)\n\n\n@pytest.fixture(scope=\"module\")\ndef session():\n    async def _run():\n        params = StdioServerParameters(\n            command=sys.executable, args=[SERVER],\n            cwd=os.path.dirname(SERVER))\n        async with stdio_client(params) as (read, write):\n            async with ClientSession(read, write) as s:\n                await s.initialize()\n                yield s\n    # one server process for the whole module\n    agen = _run()\n    session = None\n    loop = asyncio.new_event_loop()\n    try:\n        session = loop.run_until_complete(agen.__anext__())\n        yield session\n    finally:\n        loop.run_until_complete(agen.aclose())\n        loop.close()\n\n\ndef test_server_lists_all_tools(session):\n    tools = asyncio.get_event_loop_policy().new_event_loop().run_until_complete(\n        session.list_tools())\n    names = {t.name for t in tools.tools}\n    assert EXPECTED_TOOLS <= names\n\n\ndef test_search_matches_tool(session):\n    async def _run():\n        return await session.call_tool(\"search_matches\", {\n            \"team\": \"Flamengo\", \"season\": 2023, \"limit\": 5})\n    res = asyncio.get_event_loop_policy().new_event_loop().run_until_complete(_run())\n    data = _call(res.content[0].text)\n    assert data[\"total\"] > 0\n    assert data[\"matches\"][0][\"season\"] == 2023\n\n\ndef test_head_to_head_tool(session):\n    async def _run():\n        return await session.call_tool(\"get_head_to_head\", {\n            \"team_a\": \"Flamengo\", \"team_b\": \"Fluminense\"})\n    res = asyncio.get_event_loop_policy().new_event_loop().run_until_complete(_run())\n    data = _call(res.content[0].text)\n    assert data[\"derby\"] == \"Fla-Flu\"\n    assert data[\"total_matches\"] > 30\n\n\ndef test_standings_tool(session):\n    async def _run():\n        return await session.call_tool(\"get_standings\", {\n            \"competition\": \"Brasileirão Serie A\", \"season\": 2019, \"top\": 3})\n    res = asyncio.get_event_loop_policy().new_event_loop().run_until_complete(_run())\n    data = _call(res.content[0].text)\n    assert data[\"champion\"] == \"Flamengo-RJ\"\n\n\ndef test_player_tool(session):\n    async def _run():\n        return await session.call_tool(\"get_player\", {\"name\": \"Neymar Jr\"})\n    res = asyncio.get_event_loop_policy().new_event_loop().run_until_complete(_run())\n    data = _call(res.content[0].text)\n    assert data[\"name\"] == \"Neymar Jr\"\n    assert data[\"overall\"] == 92\n\n\ndef test_answer_question_tool(session):\n    async def _run():\n        return await session.call_tool(\"answer_question\", {\n            \"question\": \"Who won the 2019 Brasileirão?\"})\n    res = asyncio.get_event_loop_policy().new_event_loop().run_until_complete(_run())\n    data = _call(res.content[0].text)\n    assert data[\"result\"][\"champion\"] == \"Flamengo-RJ\"\n\n\ndef test_error_is_structured_json(session):\n    async def _run():\n        return await session.call_tool(\"get_team_stats\", {\"team\": \"Narnia United\"})\n    res = asyncio.get_event_loop_policy().new_event_loop().run_until_complete(_run())\n    data = _call(res.content[0].text)\n    assert \"error\" in data\n\n\ndef test_status_resource(session):\n    async def _run():\n        from mcp.types import AnyUrl\n        return await session.read_resource(AnyUrl(\"soccer://status\"))\n    res = asyncio.get_event_loop_policy().new_event_loop().run_until_complete(_run())\n    data = _call(res.contents[0].text)\n    assert data[\"matches\"] > 15000\n    assert data[\"players\"] == 18207\n","filePath":"/Users/maui/.retort/work/retort-local-0bivsr25/retort-e0c09c17c08e/tests/test_mcp_server.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/maui/.retort/work/retort-local-0bivsr25/retort-e0c09c17c08e/tests/test_mcp_server.py","exists":false,"truncated":false},"title":"tests/test_mcp_server.py","time":{"start":1788233949445,"end":1788233949455}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05b0ca1000017gj8vD3zIUj3kn","sessionID":"ses_fa52b88b3ffeUF09L5H3uZ1cg4","messageID":"msg_05b0c4a71001XNhgRPOStEug1s"}}
