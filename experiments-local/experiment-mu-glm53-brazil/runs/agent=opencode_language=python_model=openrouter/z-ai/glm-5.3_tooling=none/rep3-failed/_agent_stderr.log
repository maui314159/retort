timestamp=2026-08-31T18:58:03.085Z level=INFO run=9abcf33e message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport time\nt0 = time.time()\nfrom brazilian_soccer_mcp.queries import get_engine\ne = get_engine(\"data/kaggle\")\nprint(f\"load time: {time.time()-t0:.2f}s\")\nprint(\"matches:\", len(e.matches), \"players:\", len(e.players))\n\nr = e._registry\n# key normalization checks\nchecks = [\n    (\"Palmeiras-SP\", \"palmeiras\"), (\"Palmeiras\", \"palmeiras\"), (\"Palmeiras SP\", \"palmeiras\"),\n    (\"Atletico-MG\", \"atletico-mg\"), (\"Atlético Mineiro - MG\", \"atletico-mg\"),\n    (\"Atlético Mineiro\", \"atletico-mg\"), (\"Athletico\", \"atletico-pr\"),\n    (\"Vasco\", \"vasco da gama\"), (\"Vasco da Gama-RJ\", \"vasco da gama\"),\n    (\"Botafogo\", \"botafogo-rj\"), (\"Botafogo RJ\", \"botafogo-rj\"), (\"Botafogo PB\", \"botafogo-pb\"),\n    (\"Santos\", \"santos-sp\"), (\"Santos - AP\", \"santos-ap\"),\n    (\"América FC (Minas Gerais)\", \"america-mg\"), (\"América - RN\", \"america-rn\"),\n    (\"Ceará Sporting Club\", \"ceara\"), (\"Sport Club do Recife\", \"sport\"),\n    (\"EC Bahia\", \"bahia\"), (\"Grêmio\", \"gremio\"), (\"Gremio RS\", \"gremio\"),\n    (\"Nacional (URU)\", \"nacional-uru\"), (\"Nacional (PAR)\", \"nacional-par\"),\n    (\"Barcelona-EQU\", \"barcelona\"), (\"Flamengo\", \"flamengo-rj\"),\n    (\"Atletico Goianiense\", \"atletico-go\"), (\"Bragantino\", \"red bull bragantino\"),\n    (\"Corinthians-SP\", \"corinthians\"), (\"Sport Club Corinthians Paulista\", \"corinthians\"),\n    (\"Red Bull Bragantino-SP\", \"red bull bragantino\"),\n]\nfails = 0\nfor raw, expected in checks:\n    got = r.canonical_key(raw, context=\"matches\")\n    ok = got == expected\n    fails += 0 if ok else 1\n    if not ok:\n        print(f\"  FAIL {raw!r} -> {got!r} (expected {expected!r})\")\nprint(f\"canonical_key checks: {len(checks)-fails}/{len(checks)} passed\")\n\nfor q in [\"Flamengo\", \"fla\", \"Timão\", \"Atlético-PR\", \"galo\", \"Fluminense\"]:\n    try:\n        print(f\"resolve {q!r} ->\", r.resolve(q))\n    except Exception as ex:\n        print(f\"resolve {q!r} FAILED: {ex}\")\n\n# standings checks\nfor season in (2003, 2019, 2022, 2023):\n    st = e.standings(season)\n    print(f\"\\n{st.competition} {season}: {len(st.rows)} teams, played {st.played}/{st.expected}, complete={st.complete}, champion={st.champion!r}\")\n    for row in st.rows[:3]:\n        print(f\"  {row.position}. {row.team_display} - {row.points} pts ({row.wins}W {row.draws}D {row.losses}L)\")\n    if st.relegated: print(\"  relegated:\", st.relegated)\nEOF" action.permission=bash action.action=allow action.pattern=*
