timestamp=2026-09-01T10:14:27.494Z level=INFO run=f27b5900 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport asyncio\nfrom brsoccer.data import load_default\nfrom brsoccer.mcp_server import build_server\n\nsd = load_default()\nserver = build_server(sd)\n\nasync def main():\n    tools = await server.list_tools()\n    print(\"TOOLS:\", [t.name for t in tools])\n    print()\n    calls = [\n        (\"search_matches\", {\"team\": \"Flamengo\", \"opponent\": \"Fluminense\", \"limit\": 5}),\n        (\"head_to_head\", {\"team_a\": \"Palmeiras\", \"team_b\": \"Santos\"}),\n        (\"team_stats\", {\"team\": \"Corinthians\", \"season\": 2022, \"competition\": \"serie_a\"}),\n        (\"standings\", {\"competition\": \"serie_a\", \"season\": 2019}),\n        (\"relegation\", {\"season\": 2020}),\n        (\"search_players\", {\"nationality\": \"Brazil\", \"min_overall\": 88}),\n        (\"search_players\", {\"club\": \"Atlético Mineiro\"}),\n        (\"club_overview\", {}),\n        (\"competition_stats\", {\"competition\": \"serie_a\"}),\n        (\"biggest_wins\", {\"competition\": \"libertadores\", \"limit\": 3}),\n        (\"best_records\", {\"venue\": \"away\", \"min_matches\": 100}),\n        (\"derbies\", {\"season\": 2019}),\n        (\"last_match\", {\"team\": \"Flamengo\", \"opponent\": \"Corinthians\"}),\n        (\"team_competitions\", {\"team\": \"Palmeiras\"}),\n        (\"find_team\", {\"name\": \"Athletico\"}),\n        (\"competition_info\", {}),\n        (\"data_summary\", {}),\n        (\"search_matches\", {\"competition\": \"copa_do_brasil\", \"stage\": \"8\", \"limit\": 5}),\n        (\"search_matches\", {\"team\": \"Palmeiras\", \"season\": 2023, \"limit\": 4}),\n    ]\n    for name, args in calls:\n        res = await server.call_tool(name, args)\n        text = res.content[0].text if res.content else \"(no content)\"\n        print(f\"=== {name} {args} ===\")\n        print(\"\\n\".join(text.splitlines()[:12]))\n        print()\n        assert res.is_error is False, (name, text)\n\nasyncio.run(main())\nEOF" action.permission=bash action.action=allow action.pattern=*
