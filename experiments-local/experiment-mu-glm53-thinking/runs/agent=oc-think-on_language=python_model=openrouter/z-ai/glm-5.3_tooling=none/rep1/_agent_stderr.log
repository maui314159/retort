timestamp=2026-09-01T15:40:51.848Z level=INFO run=ec76643f message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport time\nt0 = time.time()\nfrom brazilian_soccer import SoccerData\ndata = SoccerData()\nprint(f\"loaded in {time.time()-t0:.2f}s\")\nprint(\"teams:\", len(data.teams), \"primary matches:\", len(data.matches),\n      \"players:\", len(data.players), \"extended:\", len(data.extended_stats_matches))\n\n# sanity: Série A 2019 should have exactly 380 primary matches\nfrom collections import Counter\nper_comp_season = Counter((m.competition, m.season) for m in data.matches)\nfor k in [('Brasileirão Série A', 2019), ('Brasileirão Série A', 2005),\n          ('Brasileirão Série A', 2023), ('Copa do Brasil', 2019), ('Copa do Brasil', 2022),\n          ('Copa Libertadores', 2018), ('Brasileirão Série B', 2019)]:\n    print(k, \"->\", per_comp_season.get(k))\n\n# team-key collision report: keys mapping from many distinct raw names\nby_key = {}\nfor key, info in data.teams.items():\n    by_key[key] = list(info.variants)\n# print keys with more than 6 variants to eyeball problems\nfor key in sorted(by_key):\n    if len(by_key[key]) >= 6:\n        print(f\"\\n{key}: {sorted(by_key[key])}\")\nEOF" action.permission=bash action.action=allow action.pattern=*
