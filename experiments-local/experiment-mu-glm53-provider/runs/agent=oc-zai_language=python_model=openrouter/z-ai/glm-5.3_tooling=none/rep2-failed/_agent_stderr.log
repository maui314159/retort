timestamp=2026-09-01T06:39:59.469Z level=INFO run=27f52cea message=evaluated permission=bash pattern="venv/bin/python -c \"\nimport csv, re\nfrom normalize import canonical_team_key\n\ndef keys_from_pairs(pairs):\n    ks = set()\n    for a, b in pairs: ks.add(canonical_team_key(a)); ks.add(canonical_team_key(b))\n    return {k for k in ks if k}\n\nfiles = {\n 'brasileirao': ('data/kaggle/Brasileirao_Matches.csv', ['home_team','away_team']),\n 'copa': ('data/kaggle/Brazilian_Cup_Matches.csv', ['home_team','away_team']),\n 'libert': ('data/kaggle/Libertadores_Matches.csv', ['home_team','away_team']),\n 'brfoot': ('data/kaggle/BR-Football-Dataset.csv', ['home','away']),\n 'novo': ('data/kaggle/novo_campeonato_brasileiro.csv', ['Equipe_mandante','Equipe_visitante']),\n}\nsets = {}\nfor name, (path, (h,a)) in files.items():\n    with open(path, encoding='utf-8-sig') as f:\n        rows = list(csv.DictReader(f))\n    sets[name] = keys_from_pairs([(r[h], r[a]) for r in rows])\n\ndef base(k): return k.rsplit('-',1)[0]\n# cross-file near matches: same base, different key, or base of one equals/contains base of other\nnames = list(sets)\nfor i, n1 in enumerate(names):\n    for n2 in names[i+1:]:\n        conflicts = []\n        for k1 in sets[n1]:\n            for k2 in sets[n2]:\n                if k1 == k2: continue\n                b1, b2 = base(k1), base(k2)\n                if b1 == b2 or (b1 and b1 in b2) or (b2 and b2 in b1):\n                    conflicts.append((k1, k2))\n        if conflicts:\n            print(f'--- {n1} vs {n2}: {len(conflicts)}')\n            for c in conflicts[:15]: print('   ', c)\n\" 2>&1" action.permission=bash action.action=allow action.pattern=*
