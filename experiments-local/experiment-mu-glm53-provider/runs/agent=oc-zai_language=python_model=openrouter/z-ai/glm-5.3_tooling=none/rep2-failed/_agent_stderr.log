timestamp=2026-09-01T07:25:14.331Z level=INFO run=27f52cea message=evaluated permission=bash pattern="venv/bin/python -c \"\nimport time\nt0 = time.time()\nfrom data_loader import get_data, SERIE_A\nfrom stats import standings, champion_and_relegated\ndata = get_data()\nprint(f'load (2-phase): {time.time()-t0:.2f}s | matches: {data.matches} ' if False else f'load (2-phase): {time.time()-t0:.2f}s | matches: {len(data.matches)} | teams: {len(data.teams)}')\nfor season in [2019, 2020, 2021, 2022]:\n    t = standings(data.matches_by_competition(SERIE_A, season))\n    print(season, t[0]['team'], t[0]['points'], '| runner:', t[1]['team'], t[1]['points'])\n\"" action.permission=bash action.action=allow action.pattern=*
timestamp=2026-09-01T07:25:18.877Z level=INFO run=27f52cea message=evaluated permission=bash pattern="venv/bin/python -c \"\nfrom data_loader import get_data\ndata = get_data()\n# residual fixture dupes: same comp/season/date±1/score, one side equal, other different\nfrom collections import defaultdict\nbuckets = defaultdict(list)\nfor m in data.matches:\n    if m.score and m.date and m.season:\n        for d in (-1,0,1):\n            buckets[(m.competition, m.season, m.date.toordinal()+d, m.score, m.away_key)].append(m)\nseen = set()\nres = 0\nfor b in buckets.values():\n    if len(b) < 2: continue\n    for i, m1 in enumerate(b):\n        for m2 in b[i+1:]:\n            if m1.home_key != m2.home_key:\n                sig = tuple(sorted([m1.home_key, m2.home_key]))\n                if sig in seen: continue\n                seen.add(sig)\n                res += 1\n                if res <= 12: print(sig, m1.date, m1.competition)\nprint('residual home-side dupes:', res)\n\"" action.permission=bash action.action=allow action.pattern=*
