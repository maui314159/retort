{"type":"tool_use","timestamp":1788231202564,"sessionID":"ses_fa52b88b3ffeUF09L5H3uZ1cg4","part":{"type":"tool","tool":"write","callID":"call_b5e015d2a46c415f967c4e15","state":{"status":"completed","input":{"content":"\"\"\"Team-name normalization, alias resolution, and date parsing.\n\nThis module is the data-quality backbone of the server:\n\n- **Team identity**: raw team names come in many shapes (\"Palmeiras-SP\",\n  \"Palmeiras - SP\", \"São Paulo\", \"Sao Paulo\", \"Athletico Paranaense\",\n  \"Nacional (URU)\").  ``parse_team_name`` splits a raw name into a\n  ``(base, code)`` pair where *code* is an optional Brazilian state\n  abbreviation (``SP``) or a country code from Copa Libertadores data\n  (``URU``).  ``TeamRegistry`` then assigns each club one stable canonical\n  key and one display name so that the same club is always matched across\n  all six datasets.\n\n- **Ambiguity rule**: if a base name maps to more than one Brazilian state\n  (e.g. \"Botafogo\" -> RJ/PB/SP, \"América\" -> MG/RN), the state becomes part\n  of the club identity; a bare name (\"Botafogo\") resolves through\n  ``DEFAULT_STATE`` to the most famous club.  Country codes (URU, PAR, ...)\n  are *always* kept as part of the identity because they denote different\n  real clubs.\n\n- **Text keys**: ``canonical_key`` strips accents, punctuation and generic\n  club-type tokens (FC/EC/SC/AC/CF) so \"A.b.c. - RN\", \"ABC - RN\" and\n  \"Abc - RN\" collapse to one club.\n\n- **Dates**: ``parse_date`` accepts ISO (\"2023-09-24\"), ISO with time\n  (\"2012-05-19 18:30:00\") and Brazilian (\"29/03/2003\") formats.\n\nAll matching is accent/case-insensitive; UTF-8 display names are preserved.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nimport unicodedata\nfrom datetime import date, datetime\n\nBR_STATES = {\n    \"AC\", \"AL\", \"AP\", \"AM\", \"BA\", \"CE\", \"DF\", \"ES\", \"GO\", \"MA\", \"MT\", \"MS\",\n    \"MG\", \"PA\", \"PB\", \"PR\", \"PE\", \"PI\", \"RJ\", \"RN\", \"RS\", \"RO\", \"RR\", \"SC\",\n    \"SP\", \"SE\", \"TO\",\n}\n\n# Country suffixes seen in the Libertadores dataset.\nCOUNTRY_CODES = {\n    \"ARG\", \"BOL\", \"CHI\", \"COL\", \"EQU\", \"MEX\", \"PAR\", \"PER\", \"URU\", \"VEN\",\n}\n\nCODES = BR_STATES | COUNTRY_CODES\n\n# Curated corrections applied to the parsed base name.\n# Key: canonical_key(base); value: (corrected_base, forced_code or None).\nALIASES: dict[str, tuple[str, str | None]] = {\n    # América (RN / Natal variants)\n    \"america fc natal\": (\"america\", \"RN\"),\n    \"america de natal\": (\"america\", \"RN\"),\n    \"america de natal rn\": (\"america\", \"RN\"),\n    # Atlético family\n    \"atletico mineiro\": (\"atletico\", \"MG\"),\n    \"atletico goianiense\": (\"atletico\", \"GO\"),\n    \"athletico paranaense\": (\"atletico\", \"PR\"),\n    \"atletico paranaense\": (\"atletico\", \"PR\"),\n    \"athletico\": (\"atletico\", \"PR\"),\n    \"ca parana\": (\"parana\", None),\n    # Vasco\n    \"vasco da gama\": (\"vasco\", \"RJ\"),\n    # Sport\n    \"sport club do recife\": (\"sport\", \"PE\"),\n    \"sport recife\": (\"sport\", \"PE\"),\n    # Fortaleza\n    \"fortaleza fc\": (\"fortaleza\", None),\n    \"fortaleza ec\": (\"fortaleza\", None),\n    # Bahia\n    \"ec bahia\": (\"bahia\", None),\n    # Botafogo-SP (Ribeirão Preto) long form\n    \"botafogo sp fc\": (\"botafogo\", \"SP\"),\n    # Internacional de Santa Maria / Lages\n    \"ec internacional sc\": (\"internacional\", \"SC\"),\n    \"internacional sc\": (\"internacional\", \"SC\"),\n    # Ceará\n    \"ceara sporting club\": (\"ceara\", None),\n    # Brasil de Pelotas\n    \"brasil de pelotas\": (\"brasil\", \"RS\"),\n    # São José (Porto Alegre)\n    \"sao jose poa\": (\"sao jose\", \"RS\"),\n    # Desportiva Ferroviária\n    \"desportiva ferroviaria\": (\"desportiva\", \"ES\"),\n    # SER Caxias == Caxias (RS)\n    \"ser caxias\": (\"caxias\", None),\n    # CSA long form\n    \"cs alagoano\": (\"csa\", None),\n    # Operário Ferroviário (PR)\n    \"operario ferroviario esporte c\": (\"operario\", \"PR\"),\n    # Boavista (Saquarema, RJ)\n    \"boavista sc saquarema\": (\"boavista\", \"RJ\"),\n    \"boavista sport club\": (\"boavista\", \"RJ\"),\n    # América FC (Minas Gerais) - FIFA club naming\n    \"america fc minas gerais\": (\"america\", \"MG\"),\n    # Ríver (Piauí)\n    \"river ac\": (\"river\", \"PI\"),\n    \"rivr\": (\"river\", \"PI\"),\n    # Águia de Marabá\n    \"aguia de maraba\": (\"aguia\", \"PA\"),\n    # 4 de Julho OCR variant\n    \"iv de julho\": (\"4 de julho\", \"PI\"),\n    # Remo / Náutico long forms\n    \"clube do remo\": (\"remo\", None),\n    \"nautico capibaribe\": (\"nautico\", None),\n    # Gama (DF)\n    \"se gama\": (\"gama\", None),\n    # Macaé\n    \"macae esporte fc\": (\"macae esporte\", None),\n    # Tolima (Colombia)\n    \"deportes tolima\": (\"tolima\", None),\n    # Red Bull Brasil == Red Bull Bragantino (SP)\n    \"red bull brasil\": (\"red bull bragantino\", \"SP\"),\n    \"bragantino\": (\"bragantino\", None),\n    # Duque de Caxias\n    \"duque de caxias fc\": (\"duque de caxias\", None),\n    # Junior/Atlético Nacional style long names stay as-is.\n}\n\n# Default state for famous clubs whose bare name appears in data while\n# other (lesser) clubs share the base name with a state suffix.\nDEFAULT_STATE: dict[str, str] = {\n    \"santos\": \"SP\",\n    \"vasco\": \"RJ\",\n    \"botafogo\": \"RJ\",\n    \"flamengo\": \"RJ\",\n    \"atletico\": \"MG\",\n    \"america\": \"MG\",\n    \"internacional\": \"RS\",\n    \"vitoria\": \"BA\",\n    \"sport\": \"PE\",\n    \"santa cruz\": \"PE\",\n    \"guarani\": \"SP\",\n    \"bragantino\": \"SP\",\n    \"sao raimundo\": \"RR\",\n    \"nautico\": \"PE\",\n    \"rioverdense\": \"RO\",\n}\n\n# Friendly display names for clubs where the most frequent raw form is\n# awkward or ambiguous.\nDISPLAY_OVERRIDES: dict[str, str] = {\n    \"brasil\": \"Brasil de Pelotas\",\n    \"atletico|MG\": \"Atlético Mineiro\",\n    \"atletico|PR\": \"Athletico-PR\",\n    \"4 de julho\": \"4 de Julho\",\n    \"riv\": \"Ríver-PI\",\n    \"river\": \"Ríver-PI\",\n    \"sao raimundo\": \"São Raimundo-RR\",\n    \"america|MG\": \"América-MG\",\n    \"america|RN\": \"América-RN\",\n}\n\n_ACCENT_TABLE = str.maketrans(\"\", \"\", \"\")\n_CLUB_TOKENS = {\"fc\", \"ec\", \"sc\", \"ac\", \"cf\", \"ca\"}\n\n_CODE_AT_END = re.compile(\n    r\"^(?P<base>.*?)[\\s\\-–—]+\\(?(?P<code>[A-Z]{2,3})\\)?\\s*$\"\n)\n\n\ndef strip_accents(text: str) -> str:\n    \"\"\"Remove diacritics: 'São Paulo' -> 'Sao Paulo'.\"\"\"\n    return \"\".join(\n        ch for ch in unicodedata.normalize(\"NFKD\", text)\n        if not unicodedata.combining(ch)\n    )\n\n\ndef canonical_key(text: str) -> str:\n    \"\"\"Accent/punct-insensitive key used for all name matching.\"\"\"\n    s = strip_accents(text).lower()\n    s = s.replace(\".\", \" \")\n    s = re.sub(r\"[^a-z0-9]+\", \" \", s)\n    tokens = [t for t in s.split() if t]\n    while tokens and tokens[0] in _CLUB_TOKENS:\n        tokens = tokens[1:]\n    while tokens and tokens[-1] in _CLUB_TOKENS:\n        tokens = tokens[:-1]\n    return \" \".join(tokens)\n\n\ndef parse_team_name(raw: str) -> tuple[str, str | None]:\n    \"\"\"Split a raw team name into ``(base, code)``.\n\n    ``code`` is a Brazilian state (\"SP\"), a country code (\"URU\") or None.\n    Handles \"Palmeiras-SP\", \"Atlético - MG\", \"America MG\", \"River (PI)\",\n    \"Nacional (URU)\", \"Barcelona-EQU\", \"Boavista Sport Club (...) - RJ\".\n    \"\"\"\n    s = raw.strip()\n    # Drop parenthetical annotations that are not a bare trailing code,\n    # e.g. \"(antigo Esporte Clube Barreira)\".\n    s = re.sub(r\"\\((?!\\s*[A-Z]{2,3}\\s*\\))[^)]*\\)\", \" \", s).strip()\n    m = _CODE_AT_END.match(s)\n    if m:\n        code = m.group(\"code\")\n        base = m.group(\"base\").strip(\" -–—\")\n        if code in CODES and canonical_key(base):\n            return base, code\n    return s, None\n\n\ndef parse_date(raw: str | None):\n    \"\"\"Parse ISO, ISO+time and Brazilian DD/MM/YYYY dates. Returns ``date``.\"\"\"\n    if raw is None:\n        return None\n    s = raw.strip()\n    if not s:\n        return None\n    for fmt in (\"%Y-%m-%d %H:%M:%S\", \"%Y-%m-%d %H:%M\", \"%Y-%m-%d\",\n                \"%d/%m/%Y %H:%M:%S\", \"%d/%m/%Y\", \"%d/%m/%y\"):\n        try:\n            return datetime.strptime(s, fmt).date()\n        except ValueError:\n            continue\n    return None\n\n\ndef parse_int(raw) -> int | None:\n    \"\"\"Parse an int tolerating blanks and float-formatted CSV values.\"\"\"\n    if raw is None:\n        return None\n    s = str(raw).strip()\n    if not s:\n        return None\n    try:\n        return int(float(s))\n    except ValueError:\n        return None\n\n\ndef parse_float(raw):\n    if raw is None:\n        return None\n    s = str(raw).strip().rstrip(\"%\")\n    if not s:\n        return None\n    try:\n        return float(s)\n    except ValueError:\n        return None\n\n\ndef resolve_alias(base_key: str) -> tuple[str, str | None]:\n    \"\"\"Apply curated alias corrections to a canonical base key.\"\"\"\n    return ALIASES.get(base_key, (base_key, None))\n\n\nclass TeamRegistry:\n    \"\"\"Assigns stable canonical keys and display names to team names.\n\n    Usage: ``register`` every raw name seen in the match datasets first\n    (so ambiguity is judged on real match data), then register player-club\n    names from FIFA data; finally call ``finalize``.\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._raw_cache: dict[str, str] = {}\n        # (base_key, code|None) -> {raw display forms}\n        self._variants: dict[tuple[str, str | None], list[str]] = {}\n        # final canonical key -> display name\n        self._display: dict[str, str] = {}\n        self.finalized = False\n\n    def register(self, raw: str) -> str:\n        \"\"\"Register a raw team/club name; returns its canonical key once\n        finalized (or a provisional key during loading).\"\"\"\n        if raw in self._raw_cache:\n            return self._raw_cache[raw]\n        base, code = parse_team_name(raw)\n        base_key, forced = resolve_alias(canonical_key(base))\n        code = forced or code\n        self._variants.setdefault((base_key, code), []).append(raw)\n        # provisional key is refined in finalize()\n        key = self._provisional_key(base_key, code)\n        self._raw_cache[raw] = key\n        return key\n\n    def _provisional_key(self, base_key: str, code: str | None) -> str:\n        return f\"{base_key}|{code}\" if code else base_key\n\n    def finalize(self) -> None:\n        \"\"\"Resolve base-name ambiguity and compute display names.\"\"\"\n        by_base: dict[str, set[str]] = {}\n        for (base_key, code) in self._variants:\n            if code in BR_STATES:\n                by_base.setdefault(base_key, set()).add(code)\n\n        self._display = {}\n        final_cache: dict[str, str] = {}\n        for (base_key, code), raws in self._variants.items():\n            states = by_base.get(base_key, set())\n            if code in COUNTRY_CODES:\n                key = f\"{base_key}|{code}\"          # country is identity\n            elif len(states) >= 2:\n                eff = code if code in BR_STATES else DEFAULT_STATE.get(base_key)\n                key = f\"{base_key}|{eff}\" if eff else base_key\n            else:\n                key = base_key                       # unambiguous: drop state\n            best = self._pick_display(base_key, code, raws)\n            disp = DISPLAY_OVERRIDES.get(key) or self._display.get(key)\n            self._display[key] = disp or best\n            for raw in raws:\n                final_cache[raw] = key\n        self._raw_cache = final_cache\n        self.finalized = True\n\n    def _pick_display(self, base_key: str, code: str | None, raws: list[str]) -> str:\n        \"\"\"Choose a display name: most frequent accented raw base form.\"\"\"\n        counts: dict[str, int] = {}\n        for raw in raws:\n            base, parsed_code = parse_team_name(raw)\n            bkey, forced = resolve_alias(canonical_key(base))\n            if bkey == base_key and (forced or parsed_code or None) == code:\n                counts[base] = counts.get(base, 0) + 1\n        if not counts:\n            return raws[0]\n        # Prefer accented variants, then frequency, then longer form.\n        def rank(item):\n            name, n = item\n            return (self._has_accent(name), n, len(name), name)\n        base_name = max(counts.items(), key=rank)[0].strip()\n        if code in BR_STATES:\n            states = {c for (b, c) in self._variants if b == base_key and c in BR_STATES}\n            if len(states) >= 2:\n                base_name = f\"{base_name}-{code}\"\n        return base_name\n\n    @staticmethod\n    def _has_accent(text: str) -> bool:\n        return any(unicodedata.combining(ch) for ch in unicodedata.normalize(\"NFKD\", text))\n\n    def display(self, key: str) -> str:\n        return self._display.get(key, key)\n\n    def key_for(self, raw: str) -> str:\n        \"\"\"Canonical key for a raw name (must be registered or finalized).\"\"\"\n        if raw in self._raw_cache:\n            return self._raw_cache[raw]\n        return self.register(raw)\n\n    def keys(self) -> list[str]:\n        return sorted(self._display)\n","filePath":"/Users/maui/.retort/work/retort-local-0bivsr25/retort-e0c09c17c08e/brazilian_soccer/normalize.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/maui/.retort/work/retort-local-0bivsr25/retort-e0c09c17c08e/brazilian_soccer/normalize.py","exists":false,"truncated":false},"title":"brazilian_soccer/normalize.py","time":{"start":1788231202555,"end":1788231202562}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"All dependencies ready. Now write the code. Starting with normalize.py — the heart of data quality.","format":"unknown","index":0}]}},"id":"prt_05ae2b6f7001Vru8rZ2kPZ4B2K","sessionID":"ses_fa52b88b3ffeUF09L5H3uZ1cg4","messageID":"msg_05ae1734c001YvfO2ZiESqzVmJ"}}
{"type":"step_finish","timestamp":1788231202708,"sessionID":"ses_fa52b88b3ffeUF09L5H3uZ1cg4","part":{"id":"prt_05ae2b792001wGrb6wLDHWz20X","reason":"tool-calls","snapshot":"190c5fda46f9f616ba69e890150e7dcea7e99979","messageID":"msg_05ae1734c001YvfO2ZiESqzVmJ","sessionID":"ses_fa52b88b3ffeUF09L5H3uZ1cg4","type":"step-finish","tokens":{"total":118429,"input":145,"output":3640,"reasoning":20,"cache":{"write":0,"read":114624}},"cost":0.002645235}}
