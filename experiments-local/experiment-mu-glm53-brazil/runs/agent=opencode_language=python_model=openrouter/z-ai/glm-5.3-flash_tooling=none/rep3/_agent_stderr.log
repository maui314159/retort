timestamp=2026-09-01T03:27:32.376Z level=INFO run=2973fea4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport sys, time\nsys.path.insert(0, '.')\nfrom brazilian_soccer.store import SoccerStore\n\nstore = SoccerStore()\n\ns = store.standings(\"Brasileirão Serie A\", 2019)\nprint(\"standings:\", s[\"champion\"], s[\"table\"][0][\"points\"], \"pts | matches:\", s[\"total_matches_used\"])\nprint(\"  top3:\", [(r[\"position\"], r[\"team\"], r[\"points\"]) for r in s[\"table\"][:3]])\nprint(\"  relegation:\", s[\"relegation_zone\"])\n\nt0 = time.time()\nts = store.team_stats(\"Corinthians\", season=2022, venue=\"home\")\nprint(f\"team_stats ({time.time()-t0:.4f}s):\", ts[\"team\"], ts[\"venue\"], \"->\", ts[\"matches\"], \"matches,\", ts[\"wins\"], \"W\", ts[\"draws\"], \"D\", ts[\"losses\"], \"L\", ts[\"win_rate\"], \"%, GF\", ts[\"goals_for\"], \"GA\", ts[\"goals_against\"])\n\nt0 = time.time()\npl = store.search_players(nationality=\"brazil\", min_overall=85)\nprint(f\"players ({time.time()-t0:.4f}s):\", [(p[\"name\"], p[\"overall\"], p[\"club\"]) for p in pl[\"players\"][:4]])\n\np = store.get_player(\"Neymar Jr\")\nprint(\"get_player:\", p[\"name\"], p[\"overall\"], p[\"club\"], \"| skills sample:\", dict(list(p[\"skills\"].items())[:3]))\n\npc = store.players_at_club(\"Fluminense\")\nprint(\"players_at_club Fluminense:\", pc[\"total_players\"], \"avg\", pc[\"average_overall\"])\n\nt0 = time.time()\nst = store.statistics(competition=\"Brasileirão Serie A\")\nprint(f\"stats ({time.time()-t0:.4f}s): avg goals\", st[\"avg_goals_per_match\"], \"| home win rate\", st[\"home_win_rate\"], \"%\")\nprint(\"  biggest:\", st[\"biggest_wins\"][0])\nprint(\"  best home:\", [(x[\"team\"], x[\"win_rate\"]) for x in st[\"best_home_records\"][:3]])\n\nd = store.derbies(season=2023)\nprint(\"derbies 2023:\", len(d[\"derbies\"]), \"rivalries | e.g.\", d[\"derbies\"][0][\"derby\"], \"->\", d[\"derbies\"][0][\"team_a\"], \"vs\", d[\"derbies\"][0][\"team_b\"], \"| total:\", d[\"derbies\"][0][\"total_matches\"])\n\nth = store.team_history(\"Palmeiras\")\nprint(\"Palmeiras history:\", th[\"total_matches\"], \"matches | competitions:\", {k: f\"{min(v)}-{max(v)}\" for k, v in th[\"competitions\"].items()})\n\nf = store.search_matches(stage=\"final\", competition=\"copa libertadores\", season=2018)\nprint(\"2018 Lib final:\", [(m[\"home\"], m[\"score\"], m[\"away\"]) for m in f[\"matches\"]])\n\ncf = store.search_matches(stage=\"final\", competition=\"copa do brasil\", season=2020)\nprint(\"2020 Cup finals:\", [(m[\"home\"], m[\"score\"], m[\"away\"]) for m in cf[\"matches\"]])\n\n# cross-file: match + player\natm = store.resolve_team(\"Atlético Mineiro\")\nprint(\"cross-file: Atletico-MG matches:\", len(store.matches_by_team[atm]), \"| FIFA players:\", len(store.players_by_club.get(atm, [])))\n\n# comparisons\ncmp = store.compare_seasons(\"Brasileirão Serie A\", 2018, 2019)\nprint(\"2018 vs 2019 champions:\", cmp[\"champions\"], \"| avg goals:\", [(x[\"season\"], x[\"avg_goals_per_match\"]) for x in cmp[\"seasons\"]])\nEOF" action.permission=bash action.action=allow action.pattern=*
