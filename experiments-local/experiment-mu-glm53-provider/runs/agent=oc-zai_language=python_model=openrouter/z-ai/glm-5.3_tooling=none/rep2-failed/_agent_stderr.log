timestamp=2026-09-01T06:41:13.784Z level=INFO run=27f52cea message=evaluated permission=bash pattern="venv/bin/python -c \"\nimport csv\nfrom collections import defaultdict\ndef raws(path, cols):\n    out = defaultdict(set)\n    with open(path, encoding='utf-8-sig') as f:\n        for r in csv.DictReader(f):\n            for c in cols: out[r[c].strip()].add(r[c].strip())\n    return out\nbf = raws('data/kaggle/BR-Football-Dataset.csv', ['home','away'])\nfor kw in ['Vitoria','America','Santa Cruz','Nautico','Parana','Sao Jose','Remo','Guarani','CS','Caxias','Ferroviario','Bras']:\n    print(kw, ':', sorted(k for k in bf if kw.lower() in k.lower()))\n\"" action.permission=bash action.action=allow action.pattern=*
