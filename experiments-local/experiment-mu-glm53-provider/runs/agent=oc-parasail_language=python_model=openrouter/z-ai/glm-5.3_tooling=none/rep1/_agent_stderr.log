timestamp=2026-09-01T05:04:47.401Z level=INFO run=22cd9675 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport sys; sys.path.insert(0, \".\")\nfrom brazilian_soccer.repository import DataRepository\nfrom brazilian_soccer import queries\nrepo = DataRepository()\nprint(\"load:\", repo.load_report[\"matches_curated\"], \"curated\")\n\nd23 = queries.derby_matches(repo, season=2023)\nprint(\"derbies 2023:\", d23[\"total_matches\"], sorted({m[\"derby\"] for m in d23[\"derbies\"]}))\nd19 = queries.derby_matches(repo, season=2019)\nprint(\"derbies 2019:\", d19[\"total_matches\"], sorted({m[\"derby\"] for m in d19[\"derbies\"]}))\ng = [m for m in d19[\"derbies\"] if m[\"derby\"] == \"Grenal\"]\nprint(\"Grenal 2019:\", [(m[\"home_team\"], m[\"home_goals\"], \"-\", m[\"away_goals\"], m[\"away_team\"]) for m in g])\n\nh = queries.head_to_head(repo, \"Flamengo\", \"Fluminense\")\nprint(\"Fla-Flu:\", h[\"matches_played\"], h[\"team_a_wins\"], h[\"draws\"], h[\"team_b_wins\"])\n\nr = queries.team_rankings(repo, metric=\"away_points\", limit=5)\nprint(\"away:\", [(x[\"team\"], x[\"away_points\"]) for x in r[\"rankings\"]])\n\nft = queries.find_team(repo, \"Atletico\")\nprint(\"Atletico:\", [(e[\"team\"], e[\"matches_in_dataset\"]) for e in ft[\"results\"]])\n\n# sanity: entity keys for major clubs unchanged behavior\nfor q in [\"Flamengo\", \"São Paulo\", \"Grêmio\", \"Santos\", \"Internacional\", \"Sport\"]:\n    ents = repo.resolve_team(q)\n    print(f\"resolve {q!r}:\", [(e.key, len(repo.matches_for_entity(e.key))) for e in ents])\nEOF" action.permission=bash action.action=allow action.pattern=*
