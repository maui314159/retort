{
  "name": "brazilian-soccer-mcp",
  "version": "1.0.0",
  "description": "MCP server exposing a knowledge graph over Brazilian soccer datasets (matches, teams, players, competitions).",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "brazilian-soccer-mcp": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "tsc -p tsconfig.json && node --test \"dist/tests/*.test.js\"",
    "test:features": "node --test \"dist/tests/bdd.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "csv-parse": "5.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
