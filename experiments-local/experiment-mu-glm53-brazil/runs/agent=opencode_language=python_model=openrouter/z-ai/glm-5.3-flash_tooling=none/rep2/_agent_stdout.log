dings\"][0][\"points\"], \"pts\")\n\nsend({\"jsonrpc\": \"2.0\", \"id\": 5, \"method\": \"tools/call\", \"params\": {\n    \"name\": \"search_players\", \"arguments\": {\"name\": \"Neymar\", \"limit\": 1}}})\nply = recv()\nprint(\"player:\", json.loads(ply[\"result\"][\"content\"][0][\"text\"])[\"players\"][0][\"name\"])\n\nproc.terminate()\nproc.wait(timeout=10)\nprint(\"E2E: PASS\")\nEOF\ntime venv/bin/python /tmp/mcp_stdio_test.py","timeout":120000},"output":"initialize ok: brazilian-soccer | tools capability: True\ntools/list: 12 tools\nhead_to_head: Head-to-head Flamengo vs Vasco da Gama: Flamengo 14 wins, Vasco da Gama 8 wins, 12 draws (34 matches\n2019 champion: Flamengo 90 pts\nplayer: Neymar Jr\nE2E: PASS\nvenv/bin/python /tmp/mcp_stdio_test.py  3.82s user 0.08s system 99% cpu 3.932 total\n","metadata":{"output":"initialize ok: brazilian-soccer | tools capability: True\ntools/list: 12 tools\nhead_to_head: Head-to-head Flamengo vs Vasco da Gama: Flamengo 14 wins, Vasco da Gama 8 wins, 12 draws (34 matches\n2019 champion: Flamengo 90 pts\nplayer: Neymar Jr\nE2E: PASS\nvenv/bin/python /tmp/mcp_stdio_test.py  3.82s user 0.08s system 99% cpu 3.932 total\n","exit":0,"truncated":false},"title":"cat > /tmp/mcp_stdio_test.py <<'EOF'\nimport json, subprocess, sys, time\n\nproc = subprocess.Popen(\n    [sys.executable, \"-m\", \"brazilian_soccer_mcp\"],\n    stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,\n    text=True,\n)\n\ndef send(msg):\n    proc.stdin.write(json.dumps(msg) + \"\\n\")\n    proc.stdin.flush()\n\ndef recv():\n    line = proc.stdout.readline()\n    return json.loads(line) if line else None\n\nsend({\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"initialize\", \"params\": {\n    \"protocolVersion\": \"2025-06-18\",\n    \"capabilities\": {},\n    \"clientInfo\": {\"name\": \"e2e-test\", \"version\": \"1.0\"},\n}})\ninit = recv()\nprint(\"initialize ok:\", init[\"result\"][\"serverInfo\"][\"name\"], \"| tools capability:\", \"too