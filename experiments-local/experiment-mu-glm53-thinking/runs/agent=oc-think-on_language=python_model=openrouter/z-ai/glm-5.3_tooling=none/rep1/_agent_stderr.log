timestamp=2026-09-01T15:50:20.157Z level=INFO run=ec76643f message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nfrom brazilian_soccer import SoccerData\nfrom brazilian_soccer import queries as q\n\ndata = SoccerData()\n\n# Corinthians home 2019 (complete season)\nprint(\"Corinthians home 2019 Serie A:\", q.team_stats(data, \"Corinthians\", season=2019, venue=\"home\", competition=\"Série A\")[\"record\"])\n\n# Flamengo last played Corinthians\nh = q.head_to_head(data, \"Flamengo\", \"Corinthians\")\nprint(\"Fla x Cor latest:\", h[\"latest_match\"][\"date\"], h[\"latest_match\"][\"home\"], h[\"latest_match\"][\"score\"], h[\"latest_match\"][\"away\"], \"| total:\", h[\"total_matches\"])\n\n# Palmeiras 2023 matches\nsm = q.search_matches(data, team=\"Palmeiras\", season=2023, limit=1)\nprint(\"Palmeiras 2023 fixtures:\", sm[\"total_matches\"])\n\n# top scorer team 2023 Serie A\nst = q.standings(data, \"Série A\", 2023)\ntop_gf = max(st[\"table\"], key=lambda r: r[\"goals_for\"])\nprint(\"2023 most GF:\", top_gf[\"team\"], top_gf[\"goals_for\"], \"| champion:\", st[\"champion\"], \"| note:\", st.get(\"data_note\"))\nbottom = [r[\"team\"] for r in st[\"table\"][-4:]]\nprint(\"2023 relegated:\", bottom)\n\n# best away record 2019\naway = []\nfor m in data.matches:\n    if m.competition == \"Brasileirão Série A\" and m.season == 2019 and m.played:\n        away.append(m)\nfrom collections import defaultdict\nrec = defaultdict(lambda: [0,0])\nfor m in away:\n    rec[m.away][0] += 1\n    if m.result == \"away\": rec[m.away][1] += 1\nranked = sorted(rec.items(), key=lambda kv: -(kv[1][1]/kv[1][0]))\nprint(\"best away 2019:\", [(data.teams[k].display, v) for k, v in ranked[:3]])\n\n# all finals counts\nfc = q.find_finals(data, \"Copa do Brasil\")\nprint(\"cup finals seasons:\", [(f[\"season\"], f.get(\"winner_on_aggregate\")) for f in fc[\"finals\"]])\nfl = q.find_finals(data, \"Libertadores\")\nprint(\"lib finals:\", [(f[\"season\"], f.get(\"winner_on_aggregate\")) for f in fl[\"finals\"]])\n\n# derby sweep 2023\ndm = q.derby_matches(data, season=2023)\nprint(\"2023 derbies:\", [(d[\"derby\"], d[\"total_matches\"]) for d in dm[\"derbies\"] if d[\"total_matches\"] > 0])\n\n# search by date range\nsm2 = q.search_matches(data, team=\"Flamengo\", date_from=\"2023-09-01\", date_to=\"2023-09-30\", limit=50)\nprint(\"Flamengo Sep 2023:\", sm2[\"total_matches\"], [m[\"date\"] for m in sm2[\"matches\"][:5]])\n\n# copa libertadores 2020 stage filter\nsl = q.search_matches(data, competition=\"Libertadores\", season=2019, stage=\"final\", limit=10)\nprint(\"Lib 2019 finals:\", [(m[\"home\"], m[\"score\"], m[\"away\"]) for m in sl[\"matches\"]])\nEOF" action.permission=bash action.action=allow action.pattern=*
