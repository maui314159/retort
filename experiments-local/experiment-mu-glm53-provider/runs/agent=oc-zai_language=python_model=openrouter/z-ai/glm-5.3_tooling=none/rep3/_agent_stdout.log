ectory = Path(data_dir) if data_dir else DEFAULT_DATA_DIR\n     if not directory.is_dir():\n","filediff":{"file":"/Users/maui/.retort/work/retort-local-7ooj92cj/retort-e48763b54868/soccer_mcp/data_loader.py","patch":"Index: /Users/maui/.retort/work/retort-local-7ooj92cj/retort-e48763b54868/soccer_mcp/data_loader.py\n===================================================================\n--- /Users/maui/.retort/work/retort-local-7ooj92cj/retort-e48763b54868/soccer_mcp/data_loader.py\n+++ /Users/maui/.retort/work/retort-local-7ooj92cj/retort-e48763b54868/soccer_mcp/data_loader.py\n@@ -659,16 +659,10 @@\n     return (match.match_date or date.min, match.competition, match.match_id)\n \n \n # ---------------------------------------------------------------------------\n-# Top-level loader\n-# ---------------------------------------------------------------------------\n \n \n-def _augment_quality(quality: dict, skipped_by_season: dict) -> None:\n-    quality[\"skipped_by_comp_season\"] = skipped_by_season\n-\n-\n def load_dataset(data_dir: str | Path | None = None) -> SoccerData:\n     \"\"\"Load all six CSV files and assemble the normalized dataset.\"\"\"\n     directory = Path(data_dir) if data_dir else DEFAULT_DATA_DIR\n     if not directory.is_dir():\n","additions":0,"deletions":6},"truncated":false},"title":"soccer_mcp/data_loader.py","time":{"start":1788252192035,"end":1788252192037}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05c22fd1a001Xq0dbnRkLsjGRd","sessionID":"ses_fa40f0460ffeYpKGnJPSwDwXVy","messageID":"msg_05c22e2e6001Ot1NxoS7SSEVIf"}}
