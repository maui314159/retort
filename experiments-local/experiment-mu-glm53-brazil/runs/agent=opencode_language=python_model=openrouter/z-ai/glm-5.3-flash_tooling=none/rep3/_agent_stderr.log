timestamp=2026-09-01T03:13:42.341Z level=INFO run=2973fea4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport sys, time\nsys.path.insert(0, '.')\nt0 = time.time()\nfrom brazilian_soccer.loader import load_all\nfrom collections import Counter\n\nreg, matches, players = load_all()\nprint(f\"loaded in {time.time()-t0:.2f}s: {len(matches)} matches, {len(players)} players\")\nprint(Counter(m.competition for m in matches))\n\nsa2019 = [m for m in matches if m.competition == \"Brasileirão Serie A\" and m.season == 2019]\nprint(\"Serie A 2019 after dedupe:\", len(sa2019))\n\nfla = reg.key_for(\"Flamengo-RJ\"); flu = reg.key_for(\"Fluminense\")\nff = [m for m in matches if {m.home_key, m.away_key} == {fla, flu}]\nprint(\"Fla-Flu matches:\", len(ff))\nprint(\"displays:\", reg.display(fla), \"/\", reg.display(flu), \"/\", reg.display(reg.key_for(\"Sao Paulo\")), \"/\", reg.display(reg.key_for(\"Athletico Paranaense\")))\n\nlib_seasons = sorted({m.season for m in matches if m.competition == \"Copa Libertadores\"})\nprint(\"Libertadores seasons:\", lib_seasons[:3], \"...\", lib_seasons[-2:])\n\nneymar = [p for p in players if p.name == \"Neymar Jr\"][0]\nprint(\"Neymar:\", neymar.nationality, neymar.overall, neymar.club_raw, \"->\", neymar.club_key, \"/\", neymar.club_display)\natm = reg.key_for(\"Atlético Mineiro\")\natm_players = sorted((p for p in players if p.club_key == atm), key=lambda p: -p.overall)\nprint(\"Atletico-MG players:\", len(atm_players), [(p.name, p.overall) for p in atm_players[:3]])\nEOF" action.permission=bash action.action=allow action.pattern=*
