timestamp=2026-09-01T14:42:46.479Z level=INFO run=bd57de6d message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, unicodedata, re\nfrom collections import defaultdict, Counter\n\nUF = {'SP','RJ','MG','RS','PR','SC','PE','CE','BA','GO','AL','MT','MS','PA','RN','PB','SE','PI','MA','TO','RO','AC','AM','AP','RR','DF','ES'}\ndef slug(s):\n    s = unicodedata.normalize('NFKD', s)\n    s = ''.join(c for c in s if not unicodedata.combining(c)).lower()\n    m = re.findall(r'\\(([^)]*)\\)', s)\n    s = re.sub(r'\\([^)]*\\)', ' ', s)\n    for x in m:\n        x = x.strip()\n        if x and len(x.split()) == 1 and len(x) <= 4: s += ' ' + x\n    return ' '.join(c if c.isalnum() else ' ' for c in s)\n\nALIASES = {\n    'atletico mineiro': 'atletico mg', 'atletico goianiense': 'atletico go',\n    'atletico paranaense': 'atletico pr', 'athletico paranaense': 'atletico pr', 'athletico': 'atletico pr',\n    'sport recife': 'sport', 'sport club do recife': 'sport',\n    'ceara sporting club': 'ceara', 'clube do remo': 'remo', 'nautico capibaribe': 'nautico',\n    'vasco da gama': 'vasco', 'cs alagoano': 'csa', 'cs sergipe': 'sergipe',\n    'boavista sport club': 'boavista', 'boavista sc saquarema': 'boavista',\n    'gremio rs': 'gremio', 'internacional rs': 'internacional',\n    'vitoria ec': 'vitoria ba', 'ec vitoria': 'vitoria ba', 'ec bahia': 'bahia',\n    'red bull bragantino': 'bragantino', 'rb bragantino': 'bragantino',\n}\nBASES = {'palmeiras','flamengo','corinthians','santos','sao paulo','sport','bahia','ceara','fortaleza','vitoria ba','cruzeiro','coritiba','parana','chapecoense','avai','figueirense','criciuma','goias','gremio','internacional','fluminense','guarani','portuguesa','juventude','caxias','nautico','remo','paysandu','sampaio correa','csa','crb','abc','vasco','vila nova','ponte preta','santa cruz','joinville','bragantino','america rn'}\ndef key(t):\n    s = slug(t)\n    if s in ALIASES: return ALIASES[s]\n    toks = s.split()\n    if toks and toks[-1].upper() in UF:\n        base = ' '.join(toks[:-1])\n        if base in BASES: return base\n    return s\n\ndef load(path, hcol, acol, hg, ag, dcol, dparse, scol=None, tcol=None, tval=None):\n    rows = []\n    with open(path, encoding='utf-8') as f:\n        for row in csv.DictReader(f):\n            if tcol and row[tcol] != tval: continue\n            try:\n                hgi, agi = int(float(row[hg])), int(float(row[ag]))\n            except (ValueError, TypeError):\n                hgi = agi = None\n            d = dparse(row[dcol]) if row[dcol] else None\n            s = int(row[scol]) if scol and row[scol] not in ('', 'NA') else (int(d[:4]) if d else None)\n            if s is None: continue\n            rows.append((d, key(row[hcol]), key(row[acol]), hgi, agi, s))\n    return rows\n\ndef iso(d): return d[:10]\ndef brd(d):\n    dd, mm, yy = d.split('/'); return f\"{yy}-{mm}-{dd}\"\n\na = load('data/kaggle/Brasileirao_Matches.csv','home_team','away_team','home_goal','away_goal','datetime', iso, scol='season')\nfA = load('data/kaggle/BR-Football-Dataset.csv','home','away','home_goal','away_goal','date', iso, tcol='tournament', tval='Serie A')\n\ndef table(rows, year):\n    pts = {}\n    n = 0\n    for (d,h,aw,hg,ag,s) in rows:\n        if s != year or hg is None: continue\n        n += 1\n        for t in (h,aw): pts.setdefault(t, [0,0,0,0,0,0])\n        if hg>ag: pts[h][0]+=3; pts[h][1]+=1; pts[aw][3]+=1\n        elif hg<ag: pts[aw][0]+=3; pts[aw][1]+=1; pts[h][3]+=1\n        else: pts[h][0]+=1; pts[aw][0]+=1; pts[h][2]+=1; pts[aw][2]+=1\n        pts[h][4]+=hg; pts[h][5]+=ag; pts[aw][4]+=ag; pts[aw][5]+=hg\n    return n, sorted(pts.items(), key=lambda kv:(-kv[1][0], -(kv[1][4]-kv[1][5]), -kv[1][4]))\n\nn, t2020 = table(a, 2020)\nprint(\"2020 brfile scored matches:\", n)\nfor t,v in t2020[-4:]: print(\"  2020 bottom:\", t, v)\nfor t,v in t2020[:2]: print(\"  2020 top:\", t, v)\n\nn2, t2022 = table(a, 2022)\nprint(\"2022 brfile scored:\", n2, \"top:\", t2022[0])\nn3, t2022f = table(fA, 2022)\nprint(\"2022 brfb scored:\", n3, \"top:\", t2022f[0])\nn4, t2021f = table(fA, 2021)\nprint(\"2021 brfb scored:\", n4, \"top:\", t2021f[0])\nn5, t2021 = table(a, 2021)\nprint(\"2021 brfile scored:\", n5, \"top:\", t2021[0])\n# vasco key in 2020 brfile?\nkeys = {r[1] for r in a if r[5]==2020} | {r[2] for r in a if r[5]==2020}\nprint(\"vasco in 2020 keys:\", 'vasco' in keys)\nEOF" action.permission=bash action.action=allow action.pattern=*
