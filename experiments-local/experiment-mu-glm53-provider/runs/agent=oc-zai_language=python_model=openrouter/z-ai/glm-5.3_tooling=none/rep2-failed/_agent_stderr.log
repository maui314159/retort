timestamp=2026-09-01T07:15:06.451Z level=INFO run=27f52cea message=evaluated permission=bash pattern="venv/bin/python -c \"\nfrom collections import defaultdict\nfrom data_loader import get_data\ndata = get_data()\n# index by (comp, date±1, score) and find rows with differing team keys\nbuckets = defaultdict(list)\nfor m in data.matches:\n    if m.date and m.score:\n        for d in (m.date.toordinal()-1, m.date.toordinal(), m.date.toordinal()+1):\n            buckets[(m.competition, d, m.home_goals, m.away_goals)].append(m)\nseen = set()\nfor key, ms in buckets.items():\n    if len(ms) < 2: continue\n    hk = {m.home_key for m in ms}; ak = {m.away_key for m in ms}\n    if len(hk) > 1 or len(ak) > 1:\n        combo = (tuple(sorted(hk)), tuple(sorted(ak)))\n        if combo in seen: continue\n        seen.add(combo)\n        print(combo, '|', [ (m.home_team, m.away_team, m.source[:12]) for m in ms[:2] ])\n\" 2>&1" action.permission=bash action.action=allow action.pattern=*
