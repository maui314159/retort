timestamp=2026-09-01T17:13:52.978Z level=INFO run=a6cf503f message=evaluated permission=bash pattern="venv/bin/python -c \"\nfrom brazilian_soccer import load_soccer_data\nfrom brazilian_soccer.loader import BRASILEIRAO_A\nfrom brazilian_soccer.normalize import team_key, base_name\nd = load_soccer_data()\n\n# raw novo rows for Flamengo 2019\nimport csv\nrows = [r for r in csv.DictReader(open('data/kaggle/novo_campeonato_brasileiro.csv', encoding='utf-8-sig')) if r['Ano']=='2019' and 'Flamengo' in (r['Equipe_mandante']+r['Equipe_visitante'])]\nprint('novo raw Flamengo 2019 rows:', len(rows))\nfor r in rows[:3]:\n    print(' raw:', repr(r['Equipe_mandante']), repr(r['Mandante_UF']), '->', team_key(r['Equipe_mandante'], r['Mandante_UF']))\nprint()\n# what canonical keys exist containing flamengo\nfrom collections import Counter\nc = Counter()\nfor m in d.matches:\n    if 'flamengo' in m.home or 'flamengo' in m.away: c[(m.home if 'flamengo' in m.home else m.away, m.source)] += 1\nfor k, n in sorted(c.items()): print(k, n)\n\"" action.permission=bash action.action=allow action.pattern=*
