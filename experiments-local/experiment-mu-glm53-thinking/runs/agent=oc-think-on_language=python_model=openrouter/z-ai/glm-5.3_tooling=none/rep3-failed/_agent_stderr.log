timestamp=2026-09-01T17:04:44.337Z level=INFO run=a6cf503f message=evaluated permission=bash pattern="venv/bin/python -c \"\nimport csv, unicodedata, re\nfrom collections import Counter\n\ndef norm(t):\n    t = unicodedata.normalize('NFKD', t).encode('ascii','ignore').decode()\n    t = re.sub(r'\\(.*?\\)', ' ', t)\n    t = re.sub(r'\\bantigo\\b', ' ', t)\n    t = t.replace('-', ' ')\n    t = re.sub(r'\\s+', ' ', t).strip().lower()\n    return t\n\nUFS = {'sp','rj','mg','rs','pr','sc','ba','pe','ce','go','mt','ms','df','pa','am','rn','pb','se','al','ma','pi','to','ro','rr','ap','es','ac'}\n\nnames = Counter()\nfiles = {\n 'brasileirao': ('home_team','away_team'),\n 'copa': ('home_team','away_team'),\n 'lib': ('home_team','away_team'),\n 'brfootball': ('home','away'),\n 'novo': ('Equipe_mandante','Equipe_visitante'),\n}\nfnames = {'brasileirao':'Brasileirao_Matches.csv','copa':'Brazilian_Cup_Matches.csv','lib':'Libertadores_Matches.csv','brfootball':'BR-Football-Dataset.csv','novo':'novo_campeonato_brasileiro.csv'}\nper_file = {}\nfor key,(hc,ac) in files.items():\n    c = Counter()\n    with open('data/kaggle/'+fnames[key], encoding='utf-8-sig') as f:\n        for row in csv.DictReader(f):\n            c[row[hc]] += 1; c[row[ac]] += 1\n    per_file[key] = set(c)\n    names.update(c)\n\n# Show names that after UF-stripping collide\nfrom collections import defaultdict\nstripped = defaultdict(set)\nfor raw in names:\n    n = norm(raw)\n    toks = n.split()\n    if len(toks) > 1 and toks[-1] in UFS:\n        base = ' '.join(toks[:-1])\n    else:\n        base = n\n    stripped[base].add(raw)\ncollisions = {b:v for b,v in stripped.items() if len(v)>1}\nprint('COLLIDING BASES (UF-stripped):', len(collisions))\nfor b, v in sorted(collisions.items()):\n    print(f'  {b!r}: {sorted(v)}')\n\"" action.permission=bash action.action=allow action.pattern=*
