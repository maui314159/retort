timestamp=2026-06-25T03:27:38.893Z level=INFO run=9c04db1c message=evaluated permission=bash pattern="python3 - <<'PY'\nimport csv, os, re, collections\nbase = '/private/var/folders/t6/p1v727892_qc9xqqdzq2rpym0000gn/T/retort-local-tjpsd7_l/retort-8ea0ffcc10d3/data/kaggle'\n\ndef canon(n):\n    n=n.strip(); n=re.sub(r'\\s*-\\s*[A-Z]{2}$','',n); n=re.sub(r'\\s*\\([^)]*\\)','',n).strip()\n    return re.sub(r'[^A-Za-z0-9]+','',n).lower()\ndef score(v):\n    try: return int(float(v))\n    except: return None\nwith open(os.path.join(base,'Brasileirao_Matches.csv'),encoding='utf-8') as f:\n    rows=list(csv.DictReader(f))\nprint('Seasons sorted', sorted(set(int(float(r['season'])) for r in rows if r['season'] not in ('','NA'))))\n# Palmeiras 2023\npal2023=[r for r in rows if int(float(r['season']))==2023 and (canon(r['home_team'])=='palmeiras' or canon(r['away_team'])=='palmeiras')]\nprint('Palmeiras 2023 count', len(pal2023))\n# Corinthians 2022 home\nhome=[r for r in rows if int(float(r['season']))==2022 and canon(r['home_team'])=='corinthians']\nw=sum(1 for r in home if score(r['home_goal']) is not None and score(r['away_goal']) is not None and score(r['home_goal'])>score(r['away_goal']))\nd=sum(1 for r in home if score(r['home_goal']) is not None and score(r['away_goal']) is not None and score(r['home_goal'])==score(r['away_goal']))\nl=sum(1 for r in home if score(r['home_goal']) is not None and score(r['away_goal']) is not None and score(r['home_goal'])<score(r['away_goal']))\ngf=sum(score(r['home_goal']) for r in home if score(r['home_goal']) is not None); ga=sum(score(r['away_goal']) for r in home if score(r['away_goal']) is not None)\nprint('Corinthians 2022 home', len(home), w,d,l,gf,ga)\n# 2023 top scorer team\nby_team=collections.defaultdict(lambda: [0,0,0])\nfor r in rows:\n    if int(float(r['season']))==2023:\n        hg=score(r['home_goal']); ag=score(r['away_goal'])\n        if hg is None or ag is None: continue\n        by_team[canon(r['home_team'])][0]+=hg; by_team[canon(r['home_team'])][1]+=ag; by_team[canon(r['home_team'])][2]+=1\n        by_team[canon(r['away_team'])][0]+=ag; by_team[canon(r['away_team'])][1]+=hg; by_team[canon(r['away_team'])][2]+=1\nprint('Top scorers 2023', sorted(by_team.items(), key=lambda x: x[1][0], reverse=True)[:3])\nPY" action.permission=bash action.action=allow action.pattern=*
