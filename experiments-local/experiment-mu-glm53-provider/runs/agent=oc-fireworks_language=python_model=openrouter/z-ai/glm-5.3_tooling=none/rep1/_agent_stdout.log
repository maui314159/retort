(sorted(per_season.items())))\nf19 = [m for m in cf['matches'] if m['season']==2019]\nprint(\"cup final 2019:\", [(m['home'], m['score'], m['away']) for m in f19])\n\nlf = search_matches(ds, competition='libertadores', stage='final', limit=50)\nprint(\"lib finals:\", [(m['season'], m['home'], m['score'], m['away']) for m in lf['matches']])\n\nbw = biggest_wins(ds, limit=5)\nprint(\"biggest:\", [(m['home'], m['score'], m['away'], m['competition'], m['season'], m['margin']) for m in bw['biggest_wins']])\n\npal23 = search_matches(ds, team='Palmeiras', season=2023, limit=200)\nprint(\"Palmeiras 2023:\", pal23['total'])\ncomps = collections.Counter(m['competition'] for m in pal23['matches'])\nprint(\"Palmeiras 2023 by comp:\", dict(comps))\n\np = search_matches(ds, team='Palmeiras', season=2023, date_from='2023-06-01', date_to='2023-06-30', limit=200)\nprint(\"Palmeiras June 2023:\", p['total'])\n\ntp = team_profile(ds, 'Palmeiras')\nprint(\"Palmeiras comps:\", [(c['competition'], c['matches']) for c in tp['by_competition']])\nprint(\"Palmeiras all-time:\", tp['all_time_record'])\nprint(\"Palmeiras fifa players:\", tp['fifa_players_in_dataset'], \"| variants:\", tp['club']['name_variations'][:5])\n\nps = player_search(ds, name='Gabriel Barbosa')\nprint(\"Gabriel Barbosa:\", [(p['name'], p['age'], p['overall'], p['club'], p['position']) for p in ps['players']])\npsx = player_search(ds, nationality='Brazil', limit=5)\nprint(\"top BR:\", [(p['name'], p['overall'], p['position'], p['club']) for p in psx['players']])\npsg = player_search(ds, club='Grêmio', limit=30)\nprint(\"Grêmio players:\", psg['total'], [(p['name'], p['overall']) for p in psg['players'][:3]])\npsf = player_search(ds, club='São Paulo', position='FWD')\nprint(\"São Paulo forwards:\", psf['total'])\npsj = player_search(ds, club='Juventus', limit=5)\nprint(\"Juventus:\", psj['total'], [(p['name'],p['overall']) for p in psj['players'][:2]])\n\ncr = player_club_report(ds, nationality='Brazil')\nrows = [r for r 