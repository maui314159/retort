timestamp=2026-09-01T15:45:24.245Z level=INFO run=ec76643f message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nfrom brazilian_soccer import SoccerData\nfrom brazilian_soccer.normalize import team_key\nimport re\n\ndata = SoccerData()\nprint(\"teams:\", len(data.teams), \"primary matches:\", len(data.matches))\n\n# famous clubs: verify canonical keys and match counts\nfor probe in [\"Flamengo\", \"Fluminense\", \"Santos\", \"Corinthians\", \"Palmeiras\",\n              \"São Paulo\", \"Grêmio\", \"Internacional\", \"Cruzeiro\", \"Atlético-MG\",\n              \"Athletico-PR\", \"Vasco\", \"Botafogo\", \"Sport\", \"Ceará\", \"Vitória\",\n              \"Santa Cruz\", \"Guarani\", \"Portuguesa\", \"Red Bull Bragantino\"]:\n    key = team_key(probe)\n    n = len(data.matches_for_team(key))\n    print(f\"  {probe!r:22} -> {key!r:24} matches={n}\")\n\n# spot checks\nprint()\nprint(\"team_key('Sport Club Corinthians Paulista') =\", team_key(\"Sport Club Corinthians Paulista\"))\nprint(\"team_key('Barcelona-EQU') =\", team_key(\"Barcelona-EQU\"))\nprint(\"team_key('Nacional (URU)') =\", team_key(\"Nacional (URU)\"))\nprint(\"team_key('América FC (Minas Gerais)') =\", team_key(\"América FC (Minas Gerais)\"))\nprint(\"team_key('Fortaleza Esporte Clube') =\", team_key(\"Fortaleza Esporte Clube\"))\nprint(\"team_key('Santa Cruz-RN') =\", team_key(\"Santa Cruz-RN\"))\nprint(\"team_key('Flamengo-PI') =\", team_key(\"Flamengo-PI\"))\nprint(\"team_key('Santos-AP') =\", team_key(\"Santos-AP\"))\nEOF" action.permission=bash action.action=allow action.pattern=*
