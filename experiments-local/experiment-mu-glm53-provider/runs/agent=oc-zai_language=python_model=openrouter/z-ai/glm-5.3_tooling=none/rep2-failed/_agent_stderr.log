timestamp=2026-09-01T07:16:13.680Z level=INFO run=27f52cea message=evaluated permission=bash pattern="venv/bin/python -c \"\nfrom data_loader import get_data\nfrom normalize import strip_accents\ndata = get_data()\ndef base(k):\n    b = k.rsplit('-',1)[0] if '-' in k else k\n    return ' '.join(strip_accents(b).lower().split())\nseen = set()\nout = []\nfor m1 in data.matches:\n    if not (m1.date and m1.score): continue\n    for m2 in data.matches:\n        if m2 is m1: continue\n        if m1.competition != m2.competition or m1.score != m2.score: continue\n        if not (m2.date and m2.score): continue\n        if abs(m1.date.toordinal() - m2.date.toordinal()) > 1: continue\n        if m1.away_key == m2.away_key and m1.home_key != m2.home_key and base(m1.home_key) != base(m2.home_key) and (base(m1.home_key) in base(m2.home_key) or base(m2.home_key) in base(m1.home_key)):\n            combo = tuple(sorted([m1.home_key, m2.home_key, m1.away_key]))\n            if combo not in seen:\n                seen.add(combo)\n                out.append((str(m1.date), m1.competition, m1.home_key, m2.home_key, m1.away_key))\n        if m1.home_key == m2.home_key and m1.away_key != m2.away_key and base(m1.away_key) != base(m2.away_key) and (base(m1.away_key) in base(m2.away_key) or base(m2.away_key) in base(m1.away_key)):\n            combo = tuple(sorted([m1.away_key, m2.away_key, m1.home_key]))\n            if combo not in seen:\n                seen.add(combo)\n                out.append((str(m1.date), m1.competition, m1.home_key, m1.away_key, m2.away_key))\nfor o in out: print(o)\nprint(len(out), 'potential dedup misses')\n\"" action.permission=bash action.action=allow action.pattern=*
