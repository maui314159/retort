eless row.\"\"\"\n+    def test_cancelled_chapecoense_match_removed(self, store):\n+        \"\"\"The 2016 round-38 Chapecoense–Atlético-MG fixture was cancelled\n+        after the LaMia disaster (one source lists a phantom 0-0); it must\n+        not appear in the unified table at all.\"\"\"\n         df = store.matches\n         hit = df[\n             (df[\"home\"] == \"chapecoense\")\n             & (df[\"away\"] == \"atletico mineiro\")\n             & (df[\"season\"] == 2016)\n         ]\n-        assert len(hit) == 1\n-        assert hit.iloc[0][\"home_goals\"] is not None\n-        assert hit[\"home_goals\"].isna().all()\n+        assert len(hit) == 0\n+        season = df[(df[\"competition\"] == \"serie a\") & (df[\"season\"] == 2016)]\n+        assert len(season) == 379  # 380 rounds minus the cancelled fixture\n \n \n class TestPlayers:\n     def test_brazilian_players(self, store):\n","additions":7,"deletions":6},"truncated":false},"title":"tests/test_data.py","time":{"start":1785550234981,"end":1785550234985}},"id":"prt_fbb164abd0015A3qxgUGH1Ap65","sessionID":"ses_045020059ffetDN2TLGi6CMad5","messageID":"msg_fbb164398001JDc22SCiuNE2LQ"}}
