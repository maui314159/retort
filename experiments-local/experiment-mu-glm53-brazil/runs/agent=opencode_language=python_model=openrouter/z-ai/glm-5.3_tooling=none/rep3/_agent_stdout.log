 Barueri\",\n+\"gremiobarueri|SP\": \"Grêmio Barueri\",\n \"internacional|SC\": \"Internacional-SC\",\n \"atletico|AC\": \"Atlético Acreano\",\n \"atletico|ES\": \"Atlético Capixaba\",\n \"atletico|BA\": \"Atlético de Alagoinhas\",\n","additions":1,"deletions":1},"truncated":false},"title":"brazilian_soccer_mcp/normalize.py","time":{"start":1788270115596,"end":1788270115597}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05d347b08001DaH4TKawUS54vf","sessionID":"ses_fa2db0ef4ffeemTLK4uNaaAd5c","messageID":"msg_05d346438001hNfACa47KZXayu"}}
