timestamp=2026-09-01T06:49:54.511Z level=INFO run=27f52cea message=evaluated permission=bash pattern="venv/bin/python -c \"\nfrom collections import Counter\nfrom data_loader import get_data, SERIE_A, SERIE_B, SERIE_C, COPA_DO_BRASIL, LIBERTADORES\ndata = get_data()\n# check same-pairing same-direction duplicates with both scored (cup comps)\nfor comp in (COPA_DO_BRASIL, LIBERTADORES, SERIE_A, SERIE_B, SERIE_C):\n    dups = 0; examples = []\n    for season in data.seasons_for_competition(comp):\n        ms = [m for m in data.matches_by_competition(comp, season) if m.score]\n        pairs = Counter((m.home_key, m.away_key) for m in ms)\n        for p, n in pairs.items():\n            if n > 1:\n                dups += 1\n                if len(examples) < 3: examples.append((comp, season, p, n))\n    print(comp, 'same-direction dup pairings (both scored):', dups, examples)\nprint()\n# Série C small team-seasons\nfor season in data.seasons_for_competition(SERIE_C):\n    ms = data.matches_by_competition(SERIE_C, season)\n    per = Counter()\n    for m in ms: per[m.home_key]+=1; per[m.away_key]+=1\n    small = {t: n for t, n in per.items() if n < 8}\n    if small: print(SERIE_C, season, 'total:', len(ms), 'small:', small)\n\"" action.permission=bash action.action=allow action.pattern=*
