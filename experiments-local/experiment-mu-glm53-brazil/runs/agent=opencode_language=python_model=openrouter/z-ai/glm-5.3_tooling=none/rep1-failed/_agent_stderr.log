timestamp=2026-08-31T18:15:13.238Z level=INFO run=dde7c20f message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport csv\nfrom collections import Counter\ndef load(fn):\n    with open('data/kaggle/'+fn, encoding='utf-8') as f:\n        return list(csv.DictReader(f))\nbra = load('Brasileirao_Matches.csv')\nmiss = Counter(r['season'] for r in bra if 'NA' in (r['home_goal'], r['away_goal']))\nprint('Brasileirao missing scores by season:', dict(miss))\nbrf = load('BR-Football-Dataset.csv')\n# does BR-Football have those 2022 fixtures?\nhave = set()\nfor r in brf:\n    if r['tournament']=='Serie A' and r['date'][:4]=='2022':\n        have.add((r['home'].lower(), r['away'].lower()))\nmissing22 = [r for r in bra if r['season']=='2022' and 'NA' in (r['home_goal'], r['away_goal'])]\ncovered = sum(1 for r in missing22 if (r['home_team'].split('-')[0].lower(), r['away_team'].split('-')[0].lower()) in have)\nprint('2022 missing-score fixtures covered by BR-Football:', covered, '/', len(missing22))\n# also count brf Serie A 2022 matches\nprint('BRF Serie A 2022 matches:', sum(1 for r in brf if r['tournament']=='Serie A' and r['date'][:4]=='2022'))\nEOF" action.permission=bash action.action=allow action.pattern=*
