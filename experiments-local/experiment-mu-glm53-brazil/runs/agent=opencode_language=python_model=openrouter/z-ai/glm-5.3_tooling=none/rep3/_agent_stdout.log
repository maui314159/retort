{"type":"tool_use","timestamp":1788272859987,"sessionID":"ses_fa2db0ef4ffeemTLK4uNaaAd5c","part":{"type":"tool","tool":"edit","callID":"call_041e473511c94707b8dd6b7f","state":{"status":"completed","input":{"filePath":"/Users/maui/.retort/work/retort-local-8zur77lj/retort-2e29d1db74f5/brazilian_soccer_mcp/server.py","newString":"from __future__ import annotations\n\nimport inspect\nfrom functools import wraps\nfrom typing import Any, Callable, Optional, TypeVar\n\ntry:  # mcp v1.x\n    from mcp.server.fastmcp import FastMCP\nexcept ImportError:  # mcp 2.x renamed FastMCP -> MCPServer\n    from mcp.server.mcpserver import MCPServer as FastMCP\n\ntry:  # ToolError keeps its message in tool results; plain exceptions don't.\n    from mcp.server.mcpserver.exceptions import ToolError\nexcept ImportError:  # mcp v1.x location\n    from mcp.server.fastmcp.exceptions import ToolError\n\nfrom . import service\nfrom .dataset import Dataset, load_dataset\n\n_DATASET: Optional[Dataset] = None\n\n\ndef _ds() -> Dataset:\n    \"\"\"Lazily load and cache the dataset for the server process.\"\"\"\n    global _DATASET\n    if _DATASET is None:\n        _DATASET = load_dataset()\n    return _DATASET\n\n\nT = TypeVar(\"T\", bound=Callable[..., Any])\n\n\ndef _friendly_errors(fn: T) -> T:\n    \"\"\"Convert expected ValueErrors into ToolError so their message reaches\n    the LLM client (the MCP SDK hides unexpected-exception details).\"\"\"\n\n    @wraps(fn)\n    def wrapper(*args: Any, **kwargs: Any) -> Any:\n        try:\n            return fn(*args, **kwargs)\n        except ValueError as exc:\n            raise ToolError(str(exc)) from exc\n\n    return wrapper  # type: ignore[return-value]\n\n\ndef list_registered_tools(server: FastMCP) -> list[Any]:\n    \"\"\"Return the registered tools, abstracting sync/async list_tools().\"\"\"\n    result = server.list_tools()\n    if inspect.isawaitable(result):\n        import asyncio\n\n        result = asyncio.run(result)\n    return result","oldString":"from __future__ import annotations\n\nimport inspect\nfrom typing import Any, Optional\n\ntry:  # mcp v1.x\n    from mcp.server.fastmcp import FastMCP\nexcept ImportError:  # mcp 2.x renamed FastMCP -> MCPServer\n    from mcp.server.mcpserver import MCPServer as FastMCP\n\nfrom . import service\nfrom .dataset import Dataset, load_dataset\n\n_DATASET: Optional[Dataset] = None\n\n\ndef _ds() -> Dataset:\n    \"\"\"Lazily load and cache the dataset for the server process.\"\"\"\n    global _DATASET\n    if _DATASET is None:\n        _DATASET = load_dataset()\n    return _DATASET\n\n\ndef list_registered_tools(server: FastMCP) -> list[Any]:\n    \"\"\"Return the registered tools, abstracting sync/async list_tools().\"\"\"\n    result = server.list_tools()\n    if inspect.isawaitable(result):\n        import asyncio\n\n        result = asyncio.run(result)\n    return result"},"output":"Edit applied successfully.","metadata":{"diagnostics":{},"diff":"Index: /Users/maui/.retort/work/retort-local-8zur77lj/retort-2e29d1db74f5/brazilian_soccer_mcp/server.py\n===================================================================\n--- /Users/maui/.retort/work/retort-local-8zur77lj/retort-2e29d1db74f5/brazilian_soccer_mcp/server.py\n+++ /Users/maui/.retort/work/retort-local-8zur77lj/retort-2e29d1db74f5/brazilian_soccer_mcp/server.py\n@@ -34,19 +34,25 @@\n \n from __future__ import annotations\n \n import inspect\n-from typing import Any\n+from functools import wraps\n+from typing import Any, Callable, Optional, TypeVar\n \n try:  # mcp v1.x\n     from mcp.server.fastmcp import FastMCP\n except ImportError:  # mcp 2.x renamed FastMCP -> MCPServer\n     from mcp.server.mcpserver import MCPServer as FastMCP\n \n+try:  # ToolError keeps its message in tool results; plain exceptions don't.\n+    from mcp.server.mcpserver.exceptions import ToolError\n+except ImportError:  # mcp v1.x location\n+    from mcp.server.fastmcp.exceptions import ToolError\n+\n from . import service\n from .dataset import Dataset, load_dataset\n \n-_DATASET: Dataset | None = None\n+_DATASET: Optional[Dataset] = None\n \n \n def _ds() -> Dataset:\n     \"\"\"Lazily load and cache the dataset for the server process.\"\"\"\n@@ -55,8 +61,25 @@\n         _DATASET = load_dataset()\n     return _DATASET\n \n \n+T = TypeVar(\"T\", bound=Callable[..., Any])\n+\n+\n+def _friendly_errors(fn: T) -> T:\n+    \"\"\"Convert expected ValueErrors into ToolError so their message reaches\n+    the LLM client (the MCP SDK hides unexpected-exception details).\"\"\"\n+\n+    @wraps(fn)\n+    def wrapper(*args: Any, **kwargs: Any) -> Any:\n+        try:\n+            return fn(*args, **kwargs)\n+        except ValueError as exc:\n+            raise ToolError(str(exc)) from exc\n+\n+    return wrapper  # type: ignore[return-value]\n+\n+\n def list_registered_tools(server: FastMCP) -> list[Any]:\n     \"\"\"Return the registered tools, abstracting sync/async list_tools().\"\"\"\n     result = server.list_tools()\n     if inspect.isawaitable(result):\n","filediff":{"file":"/Users/maui/.retort/work/retort-local-8zur77lj/retort-2e29d1db74f5/brazilian_soccer_mcp/server.py","patch":"Index: /Users/maui/.retort/work/retort-local-8zur77lj/retort-2e29d1db74f5/brazilian_soccer_mcp/server.py\n===================================================================\n--- /Users/maui/.retort/work/retort-local-8zur77lj/retort-2e29d1db74f5/brazilian_soccer_mcp/server.py\n+++ /Users/maui/.retort/work/retort-local-8zur77lj/retort-2e29d1db74f5/brazilian_soccer_mcp/server.py\n@@ -34,19 +34,25 @@\n \n from __future__ import annotations\n \n import inspect\n-from typing import Any\n+from functools import wraps\n+from typing import Any, Callable, Optional, TypeVar\n \n try:  # mcp v1.x\n     from mcp.server.fastmcp import FastMCP\n except ImportError:  # mcp 2.x renamed FastMCP -> MCPServer\n     from mcp.server.mcpserver import MCPServer as FastMCP\n \n+try:  # ToolError keeps its message in tool results; pl