timestamp=2026-09-01T06:38:00.698Z level=INFO run=27f52cea message=evaluated permission=bash pattern="venv/bin/python -c \"\nimport csv\nfrom normalize import canonical_team_key, parse_date\ndef rows(p):\n    with open(p, encoding='utf-8-sig') as f: return list(csv.DictReader(f))\nbra = rows('data/kaggle/Brasileirao_Matches.csv')\nnovo = rows('data/kaggle/novo_campeonato_brasileiro.csv')\nbr = rows('data/kaggle/BR-Football-Dataset.csv')\nn19 = [r for r in novo if r['Ano']=='2019']\nb19 = [r for r in bra if r['season']=='2019']\nprint('novo 2019:', len(n19), 'bra 2019:', len(b19))\nimport collections\nnk = collections.Counter((canonical_team_key(r['Equipe_mandante']), canonical_team_key(r['Equipe_visitante']), r['Rodada']) for r in n19)\nbk = collections.Counter((canonical_team_key(r['home_team']), canonical_team_key(r['away_team']), r['round']) for r in b19)\nsame = set(nk) & set(bk)\nprint('matching (home,away,round):', len(same), 'of', len(nk))\n# check date agreement on matching keys\nnd = {(canonical_team_key(r['Equipe_mandante']), canonical_team_key(r['Equipe_visitante']), r['Rodada']): parse_date(r['Data']) for r in n19}\nbd = {(canonical_team_key(r['home_team']), canonical_team_key(r['away_team']), r['round']): parse_date(r['datetime']) for r in b19}\ndisagree = [(k, nd[k], bd[k]) for k in same if nd[k]!=bd[k]]\nprint('date disagreements:', len(disagree)); print(disagree[:5])\n\"" action.permission=bash action.action=allow action.pattern=*
