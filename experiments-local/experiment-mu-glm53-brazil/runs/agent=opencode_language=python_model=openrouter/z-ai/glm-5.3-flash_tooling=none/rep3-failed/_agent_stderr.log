timestamp=2026-08-31T19:52:57.156Z level=INFO run=532d90f3 message=evaluated permission=bash pattern="venv/bin/python -c \"\nfrom bsoccer.data_loader import load_all\nmatches, players = load_all()\nbm = [m for m in matches if m.source_file=='Brasileirao_Matches.csv']\n# round 38 2019\nr38 = [m for m in bm if m.season==2019 and (m.round or '').strip()=='38']\nprint('BM 2019 r38:', len(r38))\nnovo38 = [m for m in matches if m.source_file=='novo_campeonato_brasileiro.csv' and m.season==2019 and (m.round or '').strip()=='38']\nprint('novo 2019 r38:', len(novo38))\nimport collections\nprint('rounds present 2019 BM:', sorted(set((m.round or '').strip() for m in bm if m.season==2019), key=lambda x: int(x) if x.isdigit() else -1)[:50])\n# corinthians 2022\ncor = [m for m in bm if m.season==2022 and 'Corinthians' in (m.home, m.away)]\nprint('BM Corinthians 2022:', len(cor), 'rounds:', sorted(set((m.round or '').strip() for m in cor), key=lambda x: int(x) if x.isdigit() else -1))\n\"" action.permission=bash action.action=allow action.pattern=*
