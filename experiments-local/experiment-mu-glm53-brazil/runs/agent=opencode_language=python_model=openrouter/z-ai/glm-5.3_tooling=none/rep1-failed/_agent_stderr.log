timestamp=2026-08-31T18:07:19.773Z level=INFO run=dde7c20f message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport csv\n\ndef load(fn):\n    with open('data/kaggle/'+fn, encoding='utf-8') as f:\n        return list(csv.DictReader(f))\n\nbra = load('Brasileirao_Matches.csv')\nnovo = load('novo_campeonato_brasileiro.csv')\nbrf = load('BR-Football-Dataset.csv')\n\n# overlap: Brasileirao vs novo by (season, home-ish, away-ish)\ndef key_bra(r): return (r['season'], r['home_team'].split('-')[0].lower(), r['away_team'].split('-')[0].lower())\ndef key_novo(r): return (r['Ano'], r['Equipe_mandante'].split('-')[0].lower(), r['Equipe_visitante'].split('-')[0].lower())\n\nkb = set(map(key_bra, bra)); kn = set(map(key_novo, novo))\nprint('bra keys:', len(kb), 'novo keys:', len(kn), 'overlap:', len(kb & kn))\n\n# check score agreement on overlapping matches\nfrom collections import defaultdict\nbra_by = defaultdict(list)\nfor r in bra: bra_by[key_bra(r)].append(r)\nagree = disagree = 0\nfor r in novo:\n    k = key_novo(r)\n    if k in bra_by:\n        for b in bra_by[k]:\n            if b['home_goal'] == r['Gols_mandante'] and b['away_goal'] == r['Gols_visitante']: agree += 1\n            else: disagree += 1\nprint('score agree:', agree, 'disagree:', disagree)\nEOF" action.permission=bash action.action=allow action.pattern=*
timestamp=2026-08-31T18:07:23.938Z level=INFO run=dde7c20f message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport csv\nfrom collections import Counter\n\ndef load(fn):\n    with open('data/kaggle/'+fn, encoding='utf-8') as f:\n        return list(csv.DictReader(f))\n\nbrf = load('BR-Football-Dataset.csv')\nbra = load('Brasileirao_Matches.csv')\n\n# BR-Football Serie A seasons and team name style\nsa = [r for r in brf if r['tournament']=='Serie A']\nprint('BR-Football Serie A seasons:', sorted(set(r['date'][:4] for r in sa)))\nteams = set()\nfor r in sa: teams.add(r['home']); teams.add(r['away'])\nprint('sample teams:', sorted(teams)[:20])\n\n# overlap BR-Football Serie A vs Brasileirao_Matches\ndef kb(r): return (r['season'], r['home_team'].split('-')[0].lower(), r['away_team'].split('-')[0].lower())\ndef kf(r): return (r['date'][:4], r['home'].lower(), r['away'].lower())\nskb = set(map(kb, bra)); skf = set(map(kf, sa))\nprint('overlap BR-Football SerieA vs Brasileirao:', len(skb & skf), 'of', len(skf))\n# date format check\nprint('date sample:', sa[0]['date'], '| ht_result:', sa[0]['ht_result'])\n# check missing goals\nmissing = sum(1 for r in brf if not r['home_goal'] or not r['away_goal'])\nprint('BR-Football missing goals rows:', missing)\nEOF" action.permission=bash action.action=allow action.pattern=*
