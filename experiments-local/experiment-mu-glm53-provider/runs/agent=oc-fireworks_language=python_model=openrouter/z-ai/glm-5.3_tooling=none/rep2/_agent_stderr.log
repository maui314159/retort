timestamp=2026-09-01T05:41:00.985Z level=INFO run=f180ecb5 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, re, unicodedata, collections\nbase='data/kaggle/'\ndef fold(s):\n    s = unicodedata.normalize('NFKD', s)\n    s = ''.join(ch for ch in s if not unicodedata.combining(ch))\n    return re.sub(r'[^a-z0-9]', '', s.lower()).replace('athletico','atletico')\ndef clean(n):\n    n = re.sub(r'\\s*\\([^)]*\\)', '', n)\n    n = re.sub(r'\\s*-\\s*([A-Za-z]{2,3})$', r'-\\1', n)\n    return n.strip()\ndef base_of(n):\n    return fold(re.sub(r'-[A-Za-z]{2,3}$', '', clean(n)))\ndef g(v):\n    try: return int(float(v))\n    except: return None\n\n# (a) cup join: base+season+date\ncup, bf = {}, {}\nfor r in csv.DictReader(open(base+'Brazilian_Cup_Matches.csv', encoding='utf-8-sig')):\n    if r['home_goal']=='NA': continue\n    cup[(base_of(r['home_team']), base_of(r['away_team']), r['season'], r['datetime'][:10])] = (g(r['home_goal']), g(r['away_goal']))\nfor r in csv.DictReader(open(base+'BR-Football-Dataset.csv', encoding='utf-8-sig')):\n    if r['tournament'] != 'Copa do Brasil': continue\n    bf[(base_of(r['home']), base_of(r['away']), r['date'][:4], r['date'])] = (g(r['home_goal']), g(r['away_goal']))\ncommon = set(cup) & set(bf)\nprint('cup join (base,season,date):', len(common), 'agree:', sum(1 for k in common if cup[k]==bf[k]))\ndis = [k for k in common if cup[k]!=bf[k]][:6]\nfor k in dis: print('  DIS', k, cup[k], bf[k])\n\n# (b) serie A: br_matches vs BR-Foot by base+season+date\nbr = {}\nfor r in csv.DictReader(open(base+'Brasileirao_Matches.csv', encoding='utf-8-sig')):\n    if r['home_goal']=='NA': continue\n    br[(base_of(r['home_team']), base_of(r['away_team']), r['season'], r['datetime'][:10])] = (g(r['home_goal']), g(r['away_goal']))\nbfs = {}\nfor r in csv.DictReader(open(base+'BR-Football-Dataset.csv', encoding='utf-8-sig')):\n    if r['tournament'] != 'Serie A': continue\n    bfs[(base_of(r['home']), base_of(r['away']), r['date'][:4], r['date'])] = (g(r['home_goal']), g(r['away_goal']))\ncommon2 = set(br) & set(bfs)\nprint('serieA join (base,season,date):', len(common2), 'agree:', sum(1 for k in common2 if br[k]==bfs[k]))\n# how many br serie A rows have no BR-Foot counterpart (by pair+season)?\nbrp = {(k[0],k[1],k[2]) for k in br}\nbfsp = {(k[0],k[1],k[2]) for k in bfs}\nprint('br fixtures not in BR-Foot:', len(brp - bfsp), 'of', len(brp))\n\n# (c) ambiguous stateless bases in BR-Foot leagues per season\nstates = collections.defaultdict(set)   # base -> set of (uf)\nname_raw = {}\nfor r in csv.DictReader(open(base+'Brazilian_Cup_Matches.csv', encoding='utf-8-sig')):\n    for t in (r['home_team'], r['away_team']):\n        m = re.search(r'-\\s*([A-Z]{2})\\s*$', t)\n        if m: states[base_of(t)].add(m.group(1)); name_raw[base_of(t)] = t\nfor r in csv.DictReader(open(base+'Brasileirao_Matches.csv', encoding='utf-8-sig')):\n    for t in (r['home_team'], r['away_team']):\n        m = re.search(r'([A-Z]{2})$', t)\n        if m: states[base_of(t)].add(m.group(1)); name_raw[base_of(t)] = t\namb = {b for b, s in states.items() if len(s) > 1}\nprint('ambiguous bases:', sorted(amb))\ncnt = collections.Counter()\nfor r in csv.DictReader(open(base+'BR-Football-Dataset.csv', encoding='utf-8-sig')):\n    if r['tournament'] == 'Copa do Brasil': continue\n    b = base_of(r['home'])\n    if b in amb: cnt[(r['tournament'], r['date'][:4], b)] += 1\nprint('ambiguous in leagues (tournament,season,base):', sorted(cnt.items())[:30])\n\n# (d) cup final rounds per season\nfin = {}\nrows = list(csv.DictReader(open(base+'Brazilian_Cup_Matches.csv', encoding='utf-8-sig')))\nfor s in sorted({r['season'] for r in rows}):\n    sr = [r for r in rows if r['season']==s]\n    mx = max(int(r['round']) for r in sr)\n    fr = [r for r in sr if int(r['round'])==mx]\n    print('cup season', s, 'max round', mx, 'final matches:', [(r['home_team'][:20], r['home_goal'], r['away_goal'], r['away_team'][:20]) for r in fr])\n\n# (e) libertadores finals per season\nlib = list(csv.DictReader(open(base+'Libertadores_Matches.csv', encoding='utf-8-sig')))\nfor s in sorted({r['season'] for r in lib}):\n    fr = [r for r in lib if r['season']==s and r['stage']=='final']\n    print('lib final', s, [(r['home_team'], r['home_goal'], r['away_goal'], r['away_team']) for r in fr])\nEOF" action.permission=bash action.action=allow action.pattern=*
