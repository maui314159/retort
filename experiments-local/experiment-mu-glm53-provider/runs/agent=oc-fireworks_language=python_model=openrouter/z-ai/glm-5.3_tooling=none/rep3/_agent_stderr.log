timestamp=2026-09-01T10:11:04.739Z level=INFO run=f27b5900 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nfrom collections import defaultdict\nfrom brsoccer.data import SoccerData\n\nsd = SoccerData.load()\nprint(\"total matches:\", len(sd.matches))\n\nper = defaultdict(int)\nfor m in sd.matches_for_competition('serie_a'):\n    per[m.season] += 1\nprint(\"serie_a per season:\", dict(sorted(per.items())))\nperb = defaultdict(int)\nfor m in sd.matches_for_competition('serie_b'):\n    perb[m.season] += 1\nprint(\"serie_b per season:\", dict(sorted(perb.items())))\n\ndef standings(season, comp='serie_a'):\n    tbl = defaultdict(lambda: dict(played=0, w=0, d=0, l=0, gf=0, ga=0, pts=0))\n    for m in sd.matches_for_competition(comp):\n        if m.season != season or not m.played: continue\n        for team, gf, ga in ((m.home, m.home_goal, m.away_goal), (m.away, m.away_goal, m.home_goal)):\n            t = tbl[team]; t['played']+=1; t['gf']+=gf; t['ga']+=ga\n            if gf > ga: t['pts']+=3; t['w']+=1\n            elif gf == ga: t['pts']+=1; t['d']+=1\n            else: t['l']+=1\n    return sorted(tbl.items(), key=lambda x: (-x[1]['pts'], -(x[1]['gf']-x[1]['ga']), -x[1]['gf']))\n\nfor season in (2019, 2020):\n    t = standings(season)\n    print(f\"\\n{season} Serie A top 3 + bottom 4:\")\n    for team, s in t[:3]:\n        print(f\"  {sd.team_display(team)}: {s['pts']} pts ({s['w']}W {s['d']}D {s['l']}L) GF{s['gf']} GA{s['ga']} P{s['played']}\")\n    print(\"  relegated:\", [(sd.team_display(team), s['pts']) for team, s in t[-4:]])\n\n# Copa finals count\nfins = [m for m in sd.matches_for_competition('copa_do_brasil') if m.stage == '8']\nprint(\"\\nCopa finals:\", len(fins), sorted({m.season for m in fins}))\n# 2023 Fla-Flu\nfk = sd.registry.key_of(\"Flamengo\"); nk = sd.registry.key_of(\"Fluminense\")\nff = [m for m in sd.matches if m.season==2023 and m.is_between(fk, nk)]\nprint(\"Fla-Flu 2023:\", [(str(m.date), m.home_display, m.score_text, m.away_display, m.competition) for m in ff])\n# sanity: total per competition\nc = defaultdict(int)\nfor m in sd.matches: c[m.competition]+=1\nprint(\"per competition:\", dict(c))\nEOF" action.permission=bash action.action=allow action.pattern=*
