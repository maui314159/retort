timestamp=2026-08-31T18:46:31.593Z level=INFO run=9abcf33e message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv, re, unicodedata\n\ndef strip_accents(s):\n    return ''.join(c for c in unicodedata.normalize('NFD', s) if unicodedata.category(c) != 'Mn')\n\ndef canon(n):\n    n = strip_accents(n).lower().strip()\n    n = re.sub(r'\\s*\\(antigo[^)]*\\)', '', n)\n    n = re.sub(r'[\\s\\-]+([a-z]{2})$', '', n) if re.search(r'[\\s\\-]+(sp|rj|mg|pr|rs|sc|pe|ba|ce|go|mt|ms|pa|pb|rn|al|se|pi|ma|to|ro|rr|ac|ap|am|df|es)$', n) else n\n    return n.strip()\n\ndef load(path):\n    with open(path, encoding='utf-8') as f:\n        return list(csv.DictReader(f))\n\n# Palmeiras 2022 Serie A record (from Brasileirao_Matches only - primary source)\nbm = load('data/kaggle/Brasileirao_Matches.csv')\ndef rec(rows, team, season):\n    w=d=l=gf=ga=n=0\n    for r in rows:\n        if r['season']!=season: continue\n        h,a = canon(r['home_team']), canon(r['away_team'])\n        hg,ag = r['home_goal'],r['away_goal']\n        if hg in ('NA',''): continue\n        hg,ag=int(hg),int(ag)\n        if h==team or a==team:\n            n+=1\n            if h==team: gf+=hg; ga+=ag; sc,oc=hg,ag\n            else: gf+=ag; ga+=hg; sc,oc=ag,hg\n            if sc>oc: w+=1\n            elif sc==oc: d+=1\n            else: l+=1\n    return n,w,d,l,gf,ga\nprint(\"Palmeiras 2022 (palmeiras):\", rec(bm,'palmeiras','2022'))\nprint(\"Corinthians home 2022:\", rec([r for r in bm if canon(r['home_team'])=='corinthians'],'corinthians','2022'))\n\n# 2019 standings top3 + relegated (from BM primary)\nrows=[r for r in bm if r['season']=='2019' and r['home_goal'] not in ('NA','')]\ntable={}\nfor r in rows:\n    h,a=canon(r['home_team']),canon(r['away_team'])\n    hg,ag=int(r['home_goal']),int(r['away_goal'])\n    for t in (h,a): table.setdefault(t,[0]*8)\n    def add(t,p,w,dd,ll,gf,ga):\n        e=table[t]; e[0]+=p;e[1]+=w;e[2]+=dd;e[3]+=ll;e[4]+=gf;e[5]+=ga\n    if hg>ag: add(h,3,1,0,0,hg,ag); add(a,0,0,0,1,ag,hg)\n    elif hg<ag: add(a,3,1,0,0,ag,hg); add(h,0,0,0,1,hg,ag)\n    else: add(h,1,0,1,0,hg,ag); add(a,1,0,1,0,ag,hg)\nst=sorted(table.items(), key=lambda kv:(-(kv[1][0]),-(kv[1][1]),-(kv[1][4]-kv[1][5])))\nprint(\"\\n2019 top 3:\", [(t, e[0], e[1], e[2], e[3]) for t,e in st[:3]])\nprint(\"2019 bottom 4:\", [(t, e[0]) for t,e in st[-4:]])\nprint(\"teams:\", len(table), \"matches:\", len(rows))\n\n# Fla-Flu h2h all data (BM + novo + libertadores? just brasileirao BM+novo primary... let's do BM only 2012-2022)\nff=[r for r in bm if {canon(r['home_team']),canon(r['away_team'])}=={'flamengo','fluminense'}]\nfw=fl=fw_=d=0\nfor r in ff:\n    if r['home_goal'] in ('NA',''): continue\n    h,a=canon(r['home_team']),canon(r['away_team']); hg,ag=int(r['home_goal']),int(r['away_goal'])\n    if hg>ag: fw += 1 if h=='flamengo' else 0; fl += 1 if a=='flamengo' else 0\n    elif hg<ag: fl += 1 if h=='flamengo' else 0; fw += 1 if a=='flamengo' else 0\n    else: d+=1\nprint(\"\\nFla-Flu BM 2012-2022:\", len(ff), \"matches, flamengo wins:\", fw, \"fluminense wins:\", fl, \"draws:\", d)\n\n# avg goals 2019 Serie A\ng=sum(int(r['home_goal'])+int(r['away_goal']) for r in rows)\nprint(\"avg goals/match 2019 Serie A:\", g/len(rows))\nhw=sum(1 for r in rows if int(r['home_goal'])>int(r['away_goal']))\nprint(\"home win rate 2019:\", hw/len(rows))\n\n# biggest win in BM Serie A\nbest=sorted(rows, key=lambda r: -abs(int(r['home_goal'])-int(r['away_goal'])))[:3]\nprint(\"biggest BM wins:\", [(r['datetime'][:10], r['home_team'], r['home_goal'], r['away_goal'], r['away_team']) for r in best])\nEOF" action.permission=bash action.action=allow action.pattern=*
