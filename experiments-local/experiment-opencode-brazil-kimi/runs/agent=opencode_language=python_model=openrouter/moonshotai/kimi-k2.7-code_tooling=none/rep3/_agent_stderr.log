timestamp=2026-06-25T03:40:30.076Z level=INFO run=9c04db1c message=evaluated permission=bash pattern="python3 - <<'PY'\nfrom brazilian_soccer_mcp.data_loader import load_all\nfrom brazilian_soccer_mcp.engine import SoccerEngine\ndata=load_all()\nengine=SoccerEngine(data['matches'], data['players'])\nprint('teams', len(engine._team_index))\nprint('flamengo keys in index', [t for t in engine._team_index if 'flamengo' in t])\nprint('atletico keys in index', sorted(t for t in engine._team_index if t.startswith('atletico'))[:20])\nprint('\\n--- Corinthians 2022 ---')\nprint(engine.team_statistics('Corinthians', season=2022, competition='Brasileirão'))\nprint('\\n--- 2019 standings champion ---')\nprint(engine.competition_standings('Brasileirão', 2019).split('\\n')[1])\nprint('\\n--- 2020 standings champion ---')\nprint(engine.competition_standings('Brasileirão', 2020).split('\\n')[1])\nprint('\\n--- Palmeiras 2023 matches count ---')\nprint(len(engine.find_matches('Palmeiras', season=2023).split('\\n'))-1)\nPY" action.permission=bash action.action=allow action.pattern=*
