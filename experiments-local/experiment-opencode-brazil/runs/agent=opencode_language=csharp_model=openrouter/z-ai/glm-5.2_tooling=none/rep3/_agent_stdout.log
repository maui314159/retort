{"type":"tool_use","timestamp":1782087645429,"sessionID":"ses_11352285affesfmj6vH5c5sk25","part":{"type":"tool","tool":"write","callID":"call_ad04a3eba4c24d58ab750806","state":{"status":"completed","input":{"content":"using System.Text.Json.Nodes;\nusing BrazilianSoccerMcp.Data;\nusing BrazilianSoccerMcp.Mcp;\nusing BrazilianSoccerMcp.Services;\nusing Xunit;\n\nnamespace BrazilianSoccerMcp.Tests;\n\n/// <summary>\n/// BDD-style tests for the MCP JSON-RPC protocol layer. The server is driven\n/// through in-memory pipes so we can assert on the exact wire format.\n/// </summary>\n[Collection(\"DataCollection\")]\npublic class McpProtocolBddTests\n{\n    private readonly DataFixture _fixture;\n\n    public McpProtocolBddTests(DataFixture fixture) => _fixture = fixture;\n\n    private static (McpServer server, StringReader input, StringWriter output) BuildServer(DataFixture f)\n    {\n        var repo = f.Repository;\n        var registry = new ToolRegistry(\n            new MatchService(repo), new TeamService(repo),\n            new PlayerService(repo), new CompetitionService(repo));\n        var input = new StringReader(\"\");\n        var output = new StringWriter();\n        return (new McpServer(registry, input, output), input, output);\n    }\n\n    private static JsonObject SendReceive(McpServer server, StringWriter output, JsonObject request)\n    {\n        var newInput = new StringReader(request.ToJsonString() + \"\\n\");\n        var field = typeof(McpServer).GetField(\"_input\",\n            System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic);\n        field!.SetValue(server, newInput);\n        server.Run();\n        var line = output.ToString().Trim();\n        return JsonNode.Parse(line)!.AsObject();\n    }\n\n    [Fact]\n    public void Initialize_returns_server_info_and_protocol_version()\n    {\n        // Given an MCP server backed by the loaded data\n        var (server, _, output) = BuildServer(_fixture);\n\n        // When the client sends an initialize request\n        var resp = SendReceive(server, output, new JsonObject\n        {\n            [\"jsonrpc\"] = \"2.0\",\n            [\"id\"] = 1,\n            [\"method\"] = \"initialize\",\n            [\"params\"] = new JsonObject(),\n        });\n\n        // Then the response contains protocolVersion and serverInfo\n        Assert.Equal(\"2.0\", resp[\"jsonrpc\"]!.ToString());\n        Assert.NotNull(resp[\"result\"]![\"protocolVersion\"]);\n        Assert.Equal(\"brazilian-soccer-mcp\", resp[\"result\"]![\"serverInfo\"]![\"name\"]!.ToString());\n    }\n\n    [Fact]\n    public void Tools_list_returns_the_expected_catalogue()\n    {\n        var (server, _, output) = BuildServer(_fixture);\n        var resp = SendReceive(server, output, new JsonObject\n        {\n            [\"jsonrpc\"] = \"2.0\",\n            [\"id\"] = 2,\n            [\"method\"] = \"tools/list\",\n            [\"params\"] = new JsonObject(),\n        });\n\n        var tools = resp[\"result\"]![\"tools\"]!.AsArray();\n        Assert.True(tools.Count >= 9, \"expected at least nine tools\");\n        var names = tools.Select(t => t![\"name\"]!.ToString()).ToHashSet();\n        Assert.Contains(\"search_matches\", names);\n        Assert.Contains(\"head_to_head\", names);\n        Assert.Contains(\"team_stats\", names);\n        Assert.Contains(\"search_players\", names);\n        Assert.Contains(\"standings\", names);\n    }\n\n    [Fact]\n    public void Tools_call_search_matches_returns_text_content()\n    {\n        var (server, _, output) = BuildServer(_fixture);\n        var resp = SendReceive(server, output, new JsonObject\n        {\n            [\"jsonrpc\"] = \"2.0\",\n            [\"id\"] = 3,\n            [\"method\"] = \"tools/call\",\n            [\"params\"] = new JsonObject\n            {\n                [\"name\"] = \"search_matches\",\n                [\"arguments\"] = new JsonObject\n                {\n                    [\"team\"] = \"Flamengo\",\n                    [\"opponent\"] = \"Fluminense\",\n                },\n            },\n        });\n\n        Assert.Null(resp[\"error\"]);\n        var content = resp[\"result\"]![\"content\"]!.AsArray();\n        Assert.Single(content);\n        Assert.Equal(\"text\", content[0]![\"type\"]!.ToString());\n        var text = content[0]![\"text\"]!.ToString();\n        Assert.Contains(\"Flamengo\", text);\n    }\n\n    [Fact]\n    public void Tools_call_unknown_tool_returns_method_error()\n    {\n        var (server, _, output) = BuildServer(_fixture);\n        var resp = SendReceive(server, output, new JsonObject\n        {\n            [\"jsonrpc\"] = \"2.0\",\n            [\"id\"] = 4,\n            [\"method\"] = \"tools/call\",\n            [\"params\"] = new JsonObject\n            {\n                [\"name\"] = \"does_not_exist\",\n                [\"arguments\"] = new JsonObject(),\n            },\n        });\n\n        Assert.NotNull(resp[\"error\"]);\n    }\n}\n","filePath":"/private/var/folders/t6/p1v727892_qc9xqqdzq2rpym0000gn/T/retort-local-2vdvakbf/retort-a593ab27f6e1/tests/BrazilianSoccerMcp.Tests/McpProtocolBddTests.cs"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/private/var/folders/t6/p1v727892_qc9xqqdzq2rpym0000gn/T/retort-local-2vdvakbf/retort-a593ab27f6e1/tests/BrazilianSoccerMcp.Tests/McpProtocolBddTests.cs","exists":false,"truncated":false},"title":"tests/BrazilianSoccerMcp.Tests/McpProtocolBddTests.cs","time":{"start":1782087645423,"end":1782087645427}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_eecb378ed001bxPf5Mjri43owo","sessionID":"ses_11352285affesfmj6vH5c5sk25","messageID":"msg_eecb33e86001BIX6ykbTmzza2u"}}
