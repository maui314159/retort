(pd.Series([row.get(\"jersey_number\")]),\n+                           errors=\"coerce\").iloc[0]\n+    profile[\"jersey_number\"] = int(jersey) if pd.notna(jersey) else None\n     return profile\n \n \n # ---------------------------------------------------------------------------\n","filediff":{"file":"/Users/maui/.retort/work/retort-local-pzfmkpm0/retort-ef40c24e7cfe/soccer_mcp/queries.py","patch":"Index: /Users/maui/.retort/work/retort-local-pzfmkpm0/retort-ef40c24e7cfe/soccer_mcp/queries.py\n===================================================================\n--- /Users/maui/.retort/work/retort-local-pzfmkpm0/retort-ef40c24e7cfe/soccer_mcp/queries.py\n+++ /Users/maui/.retort/work/retort-local-pzfmkpm0/retort-ef40c24e7cfe/soccer_mcp/queries.py\n@@ -428,15 +428,14 @@\n         )\n         if col in row and pd.notna(row[col])\n     }\n     profile[\"skills\"] = skills\n-    profile[\"preferred_foot\"] = row.get(\"preferred_foot\")\n-    profile[\"jersey_number\"] = (\n-        int(row[\"jersey_number\"])\n-        if pd.notna(row.get(\"jersey_number\"))\n-        and str(row[\"jersey_number\"]).strip().isdigit()\n-        else None\n+    profile[\"preferred_foot\"] = (\n+        row[\"preferred_foot\"] if pd.notna(row.get(\"preferred_foot\")) else None\n     )\n+    jersey = pd.to_numeric(pd.Series([row.get(\"jersey_number\")]),\n+                           errors=\"coerce\").iloc[0]\n+    profile[\"jersey_number\"] = int(jersey) if pd.notna(jersey) else None\n     return profile\n \n \n # ---------------------------------------------------------------------------\n","additions":5,"deletions":6},"truncated":false},"title":"soccer_mcp/queries.py","time":{"start":1785549352365,"end":1785549352366}},"id":"prt_fbb08eccf001OT2dIXUCj2VPEI","sessionID":"ses_045020059ffetDN2TLGi6CMad5","messageID":"msg_fbb08b37e001ZOqkKjrpyChrWa"}}
