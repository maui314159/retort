    h[4]+=hg; h[5]+=ag; a[4]+=ag; a[5]+=hg\n        if hg>ag: h[1]+=1; a[3]+=1; h[8]+=3\n        elif hg<ag: a[1]+=1; h[3]+=1; a[8]+=3\n        else: h[2]+=1; a[2]+=1; h[8]+=1; a[8]+=1\n    return sorted(st.items(), key=lambda kv: (-kv[1][8], -(kv[1][4]-kv[1][5]), -kv[1][4]))\n\nfor season in (2022, 2023):\n    print(f\"== Serie A {season} ==\")\n    for cid, v in standings2('Brasileirão Serie A', season)[:5]:\n        print(f\"   {cid:24} P{v[0]} W{v[1]} D{v[2]} L{v[3]} GF{v[4]} GA{v[5]} Pts{v[8]}\")\n\n# spot-check 2023 Palmeiras vs official (82 pts, champion)\n# and check fortaleza/bragantino unified\nfrom brazilian_soccer_mcp.normalize import normalize_team\nfor name in (\"Fortaleza\", \"Bragantino\", \"Red Bull Bragantino\", \"EC Vitória\"):\n    club = ds.registry.resolve_one(name)\n    print(name, \"->\", club.id if club else None, \"| matches:\", club.match_count if club else 0)\nrp = ds.registry.resolve(\"River Plate\")\nprint(\"River Plate ->\", [(c.id, c.match_count, c.player_count) for c in rp])\nEOF","time":{"start":1788270856806,"end":1788270856854}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05d3fc6c0001F8fJjrByY2NYCR","sessionID":"ses_fa2db0ef4ffeemTLK4uNaaAd5c","messageID":"msg_05d3f92280018fFN1Ov0Fvv0DH"}}
