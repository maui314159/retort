timestamp=2026-09-01T14:44:37.246Z level=INFO run=bd57de6d message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv\nfrom collections import Counter\nc = Counter()\nwith open('data/kaggle/Libertadores_Matches.csv', encoding='utf-8') as f:\n    for row in csv.DictReader(f):\n        c[row['home_team']] += 1; c[row['away_team']] += 1\nprint(\"Libertadores distinct:\", len(c))\nimport unicodedata\ndef sa(s):\n    s = unicodedata.normalize('NFKD', s)\n    return ''.join(ch for ch in s if not unicodedata.combining(ch))\nbraz = ['Flamengo','Palmeiras','Corinthians','Santos','Gremio','Cruzeiro','Atletico','Athletico','Sao Paulo','Fluminense','Internacional','Gremio','Vasco','Bahia','Sport','Botafogo','Portuguesa','Ceara','Fortaleza','Coritiba','Parana','Chapecoense','Ponte Preta','Criciuma','Nautico','Avai','Figueirense','Juventude','Goias','Santa Cruz','Vitoria','Atletico-GO']\nprint([n for n in sorted(c) if any(sa(b).lower() in sa(n).lower() for b in braz)])\nprint()\nc2 = Counter()\nwith open('data/kaggle/Brazilian_Cup_Matches.csv', encoding='utf-8') as f:\n    for row in csv.DictReader(f):\n        c2[row['home_team']] += 1; c2[row['away_team']] += 1\nprint(\"Copa distinct:\", len(c2))\nbig = [n for n in sorted(c2) if c2[n] >= 20]\nprint(big)\nEOF" action.permission=bash action.action=allow action.pattern=*
