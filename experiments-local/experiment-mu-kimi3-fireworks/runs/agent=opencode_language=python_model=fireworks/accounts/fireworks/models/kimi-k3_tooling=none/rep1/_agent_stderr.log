timestamp=2026-08-01T02:20:00.507Z level=INFO run=645559e9 message=evaluated permission=bash pattern="python3 -c \"\nimport time\nfrom soccer_mcp.data import get_store\nfrom soccer_mcp import queries as q\ns = get_store()  # warm (one-time ~0.6s load)\nt0 = time.time(); s2 = get_store(); print(f'cached get_store: {time.time()-t0*1:.4f}s' if False else '')\n\nbench = [\n    ('simple lookup: search_matches', lambda: q.search_matches(s, team='Flamengo', opponent='Fluminense')),\n    ('simple lookup: last_match', lambda: q.last_match(s, 'Flamengo', 'Corinthians')),\n    ('simple lookup: player_profile', lambda: q.player_profile(s, 'Gabriel Jesus')),\n    ('aggregate: standings 2019', lambda: q.standings(s, 2019)),\n    ('aggregate: competition_stats all', lambda: q.competition_stats(s)),\n    ('aggregate: biggest_wins all', lambda: q.biggest_wins(s)),\n    ('aggregate: top_players Brazil', lambda: q.top_players(s, nationality='Brazil')),\n]\nfor name, fn in bench:\n    t0 = time.perf_counter(); fn(); dt = time.perf_counter()-t0\n    print(f'{dt*1000:8.1f} ms  {name}')\n\"" action.permission=bash action.action=allow action.pattern=*
