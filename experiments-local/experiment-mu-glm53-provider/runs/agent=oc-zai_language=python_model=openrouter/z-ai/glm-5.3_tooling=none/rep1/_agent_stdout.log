{"type":"tool_use","timestamp":1788237555109,"sessionID":"ses_fa4ccfc0bffexSFu2vIRQjobrF","part":{"type":"tool","tool":"write","callID":"call_ffa52c2abb974659aace2c76","state":{"status":"completed","input":{"content":"\"\"\"\nCSV ingestion for the six Kaggle datasets.\n\nContext (Why): TASK.md \"Provided Data\" specifies 5 match datasets + 1 FIFA\nplayer dataset that MUST all be loadable and queryable (success criterion\n\"All 6 CSV files are loadable and queryable\"). The files disagree on date\nformats (\"2023-09-24\", \"29/03/2003\", \"2012-05-19 18:30:00\", \"NA\"), on team\nnaming (see normalizer.py), on score formats (int vs float vs quoted string\nvs \"NA\") and on encoding (UTF-8 Portuguese accents must survive).\n\nWhat:\n    * ``parse_date`` / ``to_int`` / ``to_float`` tolerate every format found\n      in the data plus \"NA\"/empty values.\n    * One loader per source file projects rows onto the unified Match /\n      Player models from models.py, tagging each Match with its canonical\n      competition and originating source file.\n    * ``load_all`` orchestrates: register every team name -> finalize the\n      canonical registry -> remap provisional ids -> drop broken rows ->\n      deduplicate matches that two sources both recorded (e.g. Série A\n      2012-2019 appears in BOTH Brasileirao_Matches.csv and\n      novo_campeonato_brasileiro.csv; Copa do Brasil 2014-2021 appears in\n      both Brazilian_Cup_Matches.csv and BR-Football-Dataset.csv), keeping\n      the record from the most authoritative source.\n    * ``SoccerData`` bundles everything the service layer needs, with a\n      team -> matches index so simple lookups stay fast (< 2 s requirement;\n      in practice < 100 ms).\n\nTest: tests/test_loaders.py asserts file coverage, row survival, date-format\nhandling and deduplication against the real CSVs.\nSpec reference: TASK.md \"Provided Data\", \"Data Quality Notes\" -> \"Date\nFormats\" / \"Character Encoding\", \"Success Criteria\" -> \"Data Coverage\".\n\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nfrom dataclasses import dataclass, field\nfrom datetime import date, datetime\nfrom pathlib import Path\nfrom typing import Optional\n\nfrom .models import (\n    BRASILEIRAO_A,\n    BRASILEIRAO_B,\n    BRASILEIRAO_C,\n    COPA_DO_BRASIL,\n    LIBERTADORES,\n    Match,\n    Player,\n)\nfrom .normalizer import TeamRegistry\n\n# Files, in descending authority for cross-source deduplication.\nMATCH_FILES: list[str] = [\n    \"Brasileirao_Matches.csv\",\n    \"Libertadores_Matches.csv\",\n    \"Brazilian_Cup_Matches.csv\",\n    \"novo_campeonato_brasileiro.csv\",\n    \"BR-Football-Dataset.csv\",\n]\nPLAYER_FILES: list[str] = [\"fifa_data.csv\"]\n\n_DATE_FORMATS = (\"%Y-%m-%d %H:%M:%S\", \"%Y-%m-%d\", \"%d/%m/%Y\", \"%d/%m/%y\")\n\n\n# ---------------------------------------------------------------------------\n# Small tolerant parsers\n# ---------------------------------------------------------------------------\n\ndef parse_date(raw: Optional[str]) -> Optional[date]:\n    \"\"\"Parse every date format found in the datasets; NA/blank -> None.\"\"\"\n    if raw is None:\n        return None\n    text = raw.strip().strip('\"')\n    if not text or text.upper() in {\"NA\", \"N/A\", \"NULL\", \"NONE\"}:\n        return None\n    for fmt in _DATE_FORMATS:\n        try:\n            return datetime.strptime(text, fmt).date()\n        except ValueError:\n            continue\n    return None\n\n\ndef to_int(raw: Optional[str]) -> Optional[int]:\n    \"\"\"int() tolerant of floats (\"2.0\"), quotes, blanks and NA.\"\"\"\n    if raw is None:\n        return None\n    text = str(raw).strip().strip('\"')\n    if not text or text.upper() in {\"NA\", \"N/A\", \"NULL\", \"NONE\"}:\n        return None\n    try:\n        return int(float(text))\n    except (TypeError, ValueError):\n        return None\n\n\ndef to_float(raw: Optional[str]) -> Optional[float]:\n    if raw is None:\n        return None\n    text = str(raw).strip().strip('\"')\n    if not text or text.upper() in {\"NA\", \"N/A\", \"NULL\", \"NONE\"}:\n        return None\n    try:\n        return float(text)\n    except (TypeError, ValueError):\n        return None\n\n\ndef parse_height_cm(raw: Optional[str]) -> Optional[int]:\n    \"\"\"FIFA height \"5'9\" (feet'inches\") -> centimeters.\"\"\"\n    if not raw:\n        return None\n    text = str(raw).strip()\n    try:\n        feet, inches = text.split(\"'\")\n        return round(int(feet) * 30.48 + int(inches) * 2.54)\n    except (ValueError, AttributeError):\n        return None\n\n\ndef parse_weight_kg(raw: Optional[str]) -> Optional[int]:\n    \"\"\"FIFA weight \"150lbs\" -> kilograms.\"\"\"\n    if not raw:\n        return None\n    text = str(raw).strip().lower().replace(\"lbs\", \"\").replace(\"lb\", \"\")\n    try:\n        return round(int(text) * 0.45359237)\n    except (ValueError, TypeError):\n        return None\n\n\n# ---------------------------------------------------------------------------\n# Loaded bundle\n# ---------------------------------------------------------------------------\n\n@dataclass\nclass SoccerData:\n    \"\"\"Everything loaded from data/kaggle, ready for the service layer.\"\"\"\n\n    matches: list[Match] = field(default_factory=list)\n    players: list[Player] = field(default_factory=list)\n    registry: TeamRegistry = field(default_factory=TeamRegistry)\n    # canonical team id -> matches involving that team (either side)\n    matches_by_team: dict[str, list[Match]] = field(default_factory=dict)\n    # canonical team id -> raw FIFA club string (cross-file bridge)\n    fifa_clubs_by_team: dict[str, list[str]] = field(default_factory=dict)\n    # raw FIFA club string -> list of players\n    players_by_club: dict[str, list[Player]] = field(default_factory=dict)\n    skipped_rows: int = 0\n    duplicates_removed: int = 0\n    source_row_counts: dict[str, int] = field(default_factory=dict)\n\n\n# ---------------------------------------------------------------------------\n# Per-file row extraction (no normalization yet: teams are provisional ids)\n# ---------------------------------------------------------------------------\n\ndef _read_csv(path: Path) -> list[dict[str, str]]:\n    with path.open(encoding=\"utf-8-sig\", newline=\"\") as handle:\n        return list(csv.DictReader(handle))\n\n\ndef _stage_rows(rows: list[dict], registry: TeamRegistry) -> list[dict]:\n    \"\"\"Register team names, returning rows enriched with provisional ids.\"\"\"\n    staged: list[dict] = []\n    for row in rows:\n        staged.append(row)\n        for team_col in (\"home_team\", \"away_team\", \"home\", \"away\",\n                         \"Equipe_mandante\", \"Equipe_visitante\"):\n            if team_col in row and row[team_col]:\n                registry.register(row[team_col])\n    return staged\n\n\ndef _build_matches(rows: list[dict], source: str, remap: dict[str, str],\n                   registry: TeamRegistry) -> tuple[list[Match], int]:\n    \"\"\"Convert raw rows into unified Matches; returns (matches, skipped).\"\"\"\n    matches: list[Match] = []\n    skipped = 0\n\n    def cid(raw_name: str) -> str:\n        provisional = _PROVISIONAL_CACHE.get(raw_name)\n        if provisional is None:\n            provisional = _rebuild_provisional(raw_name)\n        return remap.get(provisional, provisional)\n\n    for row in rows:\n        if source == \"Brasileirao_Matches.csv\":\n            match = _from_brasileirao(row, cid, source)\n        elif source == \"Brazilian_Cup_Matches.csv\":\n            match = _from_copa(row, cid, source)\n        elif source == \"Libertadores_Matches.csv\":\n            match = _from_libertadores(row, cid, source)\n        elif source == \"novo_campeonato_brasileiro.csv\":\n            match = _from_historic(row, cid, source)\n        elif source == \"BR-Football-Dataset.csv\":\n            match = _from_brfootball(row, cid, source)\n        else:\n            skipped += 1\n            continue\n        if match is None:\n            skipped += 1\n            continue\n        matches.append(match)\n\n    # attach display names now that ids are final\n    final = [\n        Match(\n            **{\n                **vars(match),\n                \"home_display\": registry.display(match.home_id),\n                \"away_display\": registry.display(match.away_id),\n            }\n        )\n        for match in matches\n    ]\n    return final, skipped\n\n\n# Provisional-id cache keyed by raw name (registry.register is idempotent\n# for counting; rebuilding the provisional id from a raw name is pure).\n_PROVISIONAL_CACHE: dict[str, str] = {}\n\n\ndef _rebuild_provisional(raw_name: str) -> str:\n    from .normalizer import parse_name\n\n    parsed = parse_name(raw_name)\n    if parsed.foreign:\n        pid = f\"{parsed.base}-{parsed.foreign}\"\n    elif parsed.state:\n        pid = f\"{parsed.base}-{parsed.state}\"\n    else:\n        pid = parsed.base\n    _PROVISIONAL_CACHE[raw_name] = pid\n    return pid\n\n\n# -- one builder per source file --------------------------------------------\n\ndef _mk(date, home_id, away_id, hg, ag, competition, season, round_no, source,\n        stage=None, venue=None, **stats) -> Optional[Match]:\n    if not home_id or not away_id or home_id == \"?\" or away_id == \"?\":\n        return None\n    if date is None and hg is None and ag is None:\n        return None  # fully broken row (e.g. Libertadores \"NA\" row)\n    return Match(\n        date=date,\n        home_id=home_id,\n        away_id=away_id,\n        home_display=home_id,\n        away_display=away_id,\n        home_goals=hg,\n        away_goals=ag,\n        competition=competition,\n        season=season,\n        round_no=round_no,\n        stage=stage,\n        venue=venue,\n        source=source,\n        **stats,\n    )\n\n\ndef _from_brasileirao(row, cid, source) -> Optional[Match]:\n    return _mk(\n        parse_date(row.get(\"datetime\")),\n        cid(row.get(\"home_team\", \"\")),\n        cid(row.get(\"away_team\", \"\")),\n        to_int(row.get(\"home_goal\")),\n        to_int(row.get(\"away_goal\")),\n        BRASILEIRAO_A,\n        to_int(row.get(\"season\")),\n        str(to_int(row.get(\"round\")) or \"\") or None,\n        source,\n    )\n\n\ndef _from_copa(row, cid, source) -> Optional[Match]:\n    return _mk(\n        parse_date(row.get(\"datetime\")),\n        cid(row.get(\"home_team\", \"\")),\n        cid(row.get(\"away_team\", \"\")),\n        to_int(row.get(\"home_goal\")),\n        to_int(row.get(\"away_goal\")),\n        COPA_DO_BRASIL,\n        to_int(row.get(\"season\")),\n        (row.get(\"round\") or \"\").strip() or None,\n        source,\n    )\n\n\ndef _from_libertadores(row, cid, source) -> Optional[Match]:\n    return _mk(\n        parse_date(row.get(\"datetime\")),\n        cid(row.get(\"home_team\", \"\")),\n        cid(row.get(\"away_team\", \"\")),\n        to_int(row.get(\"home_goal\")),\n        to_int(row.get(\"away_goal\")),\n        LIBERTADORES,\n        to_int(row.get(\"season\")),\n        None,\n        source,\n        stage=(row.get(\"stage\") or \"\").strip() or None,\n    )\n\n\ndef _from_historic(row, cid, source) -> Optional[Match]:\n    return _mk(\n        parse_date(row.get(\"Data\")),\n        cid(row.get(\"Equipe_mandante\", \"\")),\n        cid(row.get(\"Equipe_visitante\", \"\")),\n        to_int(row.get(\"Gols_mandante\")),\n        to_int(row.get(\"Gols_visitante\")),\n        BRASILEIRAO_A,\n        to_int(row.get(\"Ano\")),\n        str(to_int(row.get(\"Rodada\")) or \"\") or None,\n        source,\n        venue=(row.get(\"Arena\") or \"\").strip() or None,\n    )\n\n\n_BRFB_COMPETITIONS = {\n    \"Serie A\": BRASILEIRAO_A,\n    \"Serie B\": BRASILEIRAO_B,\n    \"Serie C\": BRASILEIRAO_C,\n    \"Copa do Brasil\": COPA_DO_BRASIL,\n}\n\n\ndef _from_brfootball(row, cid, source) -> Optional[Match]:\n    competition = _BRFB_COMPETITIONS.get((row.get(\"tournament\") or \"\").strip())\n    if competition is None:\n        return None\n    return _mk(\n        parse_date(row.get(\"date\")),\n        cid(row.get(\"home\", \"\")),\n        cid(row.get(\"away\", \"\")),\n        to_int(row.get(\"home_goal\")),\n        to_int(row.get(\"away_goal\")),\n        competition,\n        parse_date(row.get(\"date\")).year if parse_date(row.get(\"date\")) else None,\n        None,\n        source,\n        home_corners=to_int(row.get(\"home_corner\")),\n        away_corners=to_int(row.get(\"away_corner\")),\n        home_shots=to_int(row.get(\"home_shots\")),\n        away_shots=to_int(row.get(\"away_shots\")),\n        home_attacks=to_int(row.get(\"home_attack\")),\n        away_attacks=to_int(row.get(\"away_attack\")),\n        half_time_diff=to_int(row.get(\"ht_diff\")),\n        half_time_label=(row.get(\"ht_result\") or \"\").strip() or None,\n    )\n\n\n# ---------------------------------------------------------------------------\n# FIFA players\n# ---------------------------------------------------------------------------\n\n_SKILL_COLUMNS = [\n    \"Crossing\", \"Finishing\", \"ShortPassing\", \"Volleys\", \"Dribbling\", \"Curve\",\n    \"FKAccuracy\", \"LongPassing\", \"BallControl\", \"Acceleration\", \"SprintSpeed\",\n    \"Agility\", \"Reactions\", \"Balance\", \"ShotPower\", \"Jumping\", \"Stamina\",\n    \"Strength\", \"LongShots\", \"Aggression\", \"Interceptions\", \"Positioning\",\n    \"Vision\", \"Penalties\", \"Composure\", \"DefensiveAwareness\", \"StandingTackle\",\n    \"SlidingTackle\", \"GKDiving\", \"GKHandling\", \"GKKicking\", \"GKPositioning\",\n    \"GKReflexes\",\n]\n\n\ndef _load_players(path: Path, registry: TeamRegistry, remap: dict[str, str],\n                  data: SoccerData) -> None:\n    rows = _read_csv(path)\n    data.source_row_counts[path.name] = len(rows)\n    for row in rows:\n        club_raw = (row.get(\"Club\") or \"\").strip()\n        if club_raw and club_raw not in (\"NA\", \"N/A\", \"None\"):\n            # register FIFA club names too: they bridge players <-> matches\n            provisional = registry.register(club_raw)\n            canonical = remap.get(provisional, provisional)\n            data.fifa_clubs_by_team.setdefault(canonical, []).append(club_raw)\n        # keep player even without club\n        attrs: dict[str, object] = {}\n        for col in _SKILL_COLUMNS:\n            value = to_int(row.get(col))\n            if value is not None:\n                attrs[col] = value\n        player = Player(\n            player_id=to_int(row.get(\"ID\")) or 0,\n            name=(row.get(\"Name\") or \"\").strip(),\n            age=to_int(row.get(\"Age\")),\n            nationality=(row.get(\"Nationality\") or \"\").strip(),\n            overall=to_int(row.get(\"Overall\")),\n            potential=to_int(row.get(\"Potential\")),\n            club=club_raw if club_raw not in (\"NA\", \"N/A\", \"None\") else \"\",\n            position=(row.get(\"Position\") or \"\").strip() or None,\n            jersey_number=to_int(row.get(\"Jersey Number\")),\n            preferred_foot=(row.get(\"Preferred Foot\") or \"\").strip() or None,\n            height_raw=(row.get(\"Height\") or \"\").strip() or None,\n            weight_raw=(row.get(\"Weight\") or \"\").strip() or None,\n            height_cm=parse_height_cm(row.get(\"Height\")),\n            weight_kg=parse_weight_kg(row.get(\"Weight\")),\n            attrs=attrs,\n        )\n        if not player.name:\n            data.skipped_rows += 1\n            continue\n        data.players.append(player)\n        if player.club:\n            data.players_by_club.setdefault(player.club, []).append(player)\n\n\n# ---------------------------------------------------------------------------\n# Deduplication\n# ---------------------------------------------------------------------------\n\ndef _dedupe(matches: list[Match]) -> tuple[list[Match], int]:\n    \"\"\"Drop matches recorded by several sources, keeping the most authoritative.\n\n    Key: (competition, season, date, home_id, away_id). The input list is\n    pre-sorted by source authority, so the FIRST occurrence wins.\n    \"\"\"\n    seen: set[tuple] = set()\n    unique: list[Match] = []\n    removed = 0\n    for match in matches:\n        key = (\n            match.competition,\n            match.season,\n            match.date,\n            match.home_id,\n            match.away_id,\n        )\n        if key in seen:\n            removed += 1\n            continue\n        seen.add(key)\n        unique.append(match)\n    return unique, removed\n\n\n# ---------------------------------------------------------------------------\n# Orchestration\n# ---------------------------------------------------------------------------\n\ndef load_all(data_dir: str | Path) -> SoccerData:\n    \"\"\"Load every dataset under ``data_dir`` (defaults to ./data/kaggle layout).\"\"\"\n    root = Path(data_dir)\n    registry = TeamRegistry()\n    data = SoccerData(registry=registry)\n\n    # Phase 1: read + register team names (FIFA clubs registered later)\n    staged_by_source: dict[str, list[dict]] = {}\n    for file_name in MATCH_FILES:\n        path = root / file_name\n        rows = _read_csv(path)\n        data.source_row_counts[file_name] = len(rows)\n        staged_by_source[file_name] = _stage_rows(rows, registry)\n\n    # Phase 2: finalize canonical club identities\n    remap = registry.finalize()\n\n    # Phase 3: build unified matches (ordered by source authority)\n    all_matches: list[Match] = []\n    for file_name in MATCH_FILES:\n        matches, skipped = _build_matches(\n            staged_by_source[file_name], file_name, remap, registry\n        )\n        all_matches.extend(matches)\n        data.skipped_rows += skipped\n\n    # Phase 4: cross-source deduplication\n    data.matches, data.duplicates_removed = _dedupe(all_matches)\n\n    # Phase 5: FIFA players (also registers FIFA club names into the registry\n    # so player queries can bridge to match-data teams)\n    for file_name in PLAYER_FILES:\n        _load_players(root / file_name, registry, remap, data)\n\n    # Phase 6: team -> matches index\n    for match in data.matches:\n        for team_id in (match.home_id, match.away_id):\n            data.matches_by_team.setdefault(team_id, []).append(match)\n    for team_id in data.matches_by_team:\n        data.matches_by_team[team_id].sort(\n            key=lambda m: (m.date is None, m.date or date.min)\n        )\n\n    return data\n","filePath":"/Users/maui/.retort/work/retort-local-7ooj92cj/retort-7f4a851aa2e1/brazilian_soccer_mcp/loaders.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/maui/.retort/work/retort-local-7ooj92cj/retort-7f4a851aa2e1/brazilian_soccer_mcp/loaders.py","exists":false,"truncated":false},"title":"brazilian_soccer_mcp/loaders.py","time":{"start":1788237555102,"end":1788237555107}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05b43a59b001Fb8vmfinFJA0Jx","sessionID":"ses_fa4ccfc0bffexSFu2vIRQjobrF","messageID":"msg_05b42ad3f001zQ6bikU9XAHkHU"}}
