timestamp=2026-08-31T18:41:03.307Z level=INFO run=9abcf33e message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv\ndef load(path):\n    with open(path, encoding='utf-8') as f:\n        return list(csv.DictReader(f))\n\nlib = load('data/kaggle/Libertadores_Matches.csv')\nna = [r for r in lib if r['season']=='NA']\nprint(\"Libertadores NA season rows:\", len(na), na[:2])\nempty_goals = [r for r in lib if r['home_goal'] in ('','NA') or r['away_goal'] in ('','NA')]\nprint(\"Lib empty goals:\", len(empty_goals), empty_goals[:2])\n\nfor path, hg, ag in [('data/kaggle/Brasileirao_Matches.csv','home_goal','away_goal'),\n                     ('data/kaggle/Brazilian_Cup_Matches.csv','home_goal','away_goal'),\n                     ('data/kaggle/BR-Football-Dataset.csv','home_goal','away_goal'),\n                     ('data/kaggle/novo_campeonato_brasileiro.csv','Gols_mandante','Gols_visitante')]:\n    rows = load(path)\n    bad = [r for r in rows if r[hg] in ('','NA',None) or r[ag] in ('','NA',None)]\n    print(path.split('/')[-1], \"empty goals:\", len(bad))\n\n# Cup round 8 = final? count matches per round per season\ncup = load('data/kaggle/Brazilian_Cup_Matches.csv')\nfrom collections import Counter\nc = Counter((r['season'], r['round']) for r in cup)\nfor s in ['2012','2013','2019','2021']:\n    print(s, {rnd: c[(s,str(rnd))] for rnd in range(1,9) if c[(s,str(rnd))]})\n# what does round 8 look like\nprint(\"round 8 sample:\", [ (r['season'],r['home_team'],r['away_team'],r['home_goal'],r['away_goal']) for r in cup if r['round']=='8'][:8])\nEOF" action.permission=bash action.action=allow action.pattern=*
