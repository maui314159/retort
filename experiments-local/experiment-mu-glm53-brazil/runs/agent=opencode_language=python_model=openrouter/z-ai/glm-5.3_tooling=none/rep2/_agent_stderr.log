timestamp=2026-08-31T19:04:08.505Z level=INFO run=ec94ecf4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv, unicodedata, re\nfrom collections import Counter\n\nUFS = {\"AC\",\"AL\",\"AP\",\"AM\",\"BA\",\"CE\",\"DF\",\"ES\",\"GO\",\"MA\",\"MT\",\"MS\",\"MG\",\"PA\",\"PB\",\"PR\",\"PE\",\"PI\",\"RJ\",\"RN\",\"RS\",\"RO\",\"RR\",\"SC\",\"SP\",\"SE\",\"TO\"}\n\ndef norm(t):\n    t = unicodedata.normalize(\"NFKD\", t).encode(\"ascii\",\"ignore\").decode().lower()\n    t = re.sub(r\"\\(.*?\\)\", \" \", t)  # remove parentheticals\n    t = re.sub(r\"[^a-z0-9]+\", \" \", t).strip()\n    return t\n\ndef strip_uf(t):\n    m = re.match(r\"^(.*?)\\s*-\\s*(\" + \"|\".join(UFS) + r\")$\", t)\n    if m: return m.group(1).strip(), m.group(2)\n    return t, None\n\nwith open(\"data/kaggle/BR-Football-Dataset.csv\", encoding=\"utf-8\") as f:\n    brf = list(csv.DictReader(f))\nnames = sorted({r[\"home\"] for r in brf} | {r[\"away\"] for r in brf})\nprint(len(names))\nprint(names)\nEOF" action.permission=bash action.action=allow action.pattern=*
