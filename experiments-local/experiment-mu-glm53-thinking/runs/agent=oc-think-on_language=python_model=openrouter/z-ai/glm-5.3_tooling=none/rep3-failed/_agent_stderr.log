timestamp=2026-09-01T17:19:40.867Z level=INFO run=a6cf503f message=evaluated permission=bash pattern="venv/bin/python -c \"\nfrom brazilian_soccer import load_soccer_data\nfrom brazilian_soccer.loader import BRASILEIRAO_A, BRASILEIRAO_B\nfrom collections import Counter, defaultdict\nd = load_soccer_data()\nprint('total matches:', len(d.matches))\nprint(Counter(m.competition for m in d.matches))\nprint()\n\ndef standing(competition, season):\n    pts = defaultdict(int)\n    for m in d.matches:\n        if m.competition == competition and m.season == season and m.has_result:\n            hg, ag = m.home_goals, m.away_goals\n            if hg > ag: pts[m.home] += 3\n            elif hg < ag: pts[m.away] += 3\n            else: pts[m.home] += 1; pts[m.away] += 1\n    return sorted(pts.items(), key=lambda kv: -kv[1])\n\nknown = {2012:'Fluminense',2013:'Cruzeiro',2014:'Cruzeiro',2015:'Corinthians',2016:'Palmeiras',2017:'Corinthians',2018:'Palmeiras',2019:'Flamengo',2020:'Flamengo',2021:'Atlético-MG',2022:'Palmeiras'}\nn = Counter(m.season for m in d.matches if m.competition == BRASILEIRAO_A)\nfor season in sorted(known):\n    table = standing(BRASILEIRAO_A, season)\n    top_id, top_pts = table[0]\n    ok = 'OK' if d.display_team(top_id) == known[season] else '<<< WRONG'\n    print(f'Série A {season}: matches={n[season]:4d}  champ={d.display_team(top_id):18s} {top_pts:3d} pts  {ok}')\nnb = Counter(m.season for m in d.matches if m.competition == BRASILEIRAO_B)\nprint()\nprint('Série B season counts:', dict(sorted(nb.items())))\nknownB = {2015:'Botafogo',2016:'Atlético-GO',2017:'Corinthians',2018:'Fortaleza',2019:'Bragantino',2020:'Chapecoense Loc'}\nfor season in sorted(knownB):\n    if season in nb:\n        table = standing(BRASILEIRAO_B, season)\n        print(f'Série B {season}: champ={d.display_team(table[0][0])} {table[0][1]} pts (expected {knownB[season]})')\n\"" action.permission=bash action.action=allow action.pattern=*
