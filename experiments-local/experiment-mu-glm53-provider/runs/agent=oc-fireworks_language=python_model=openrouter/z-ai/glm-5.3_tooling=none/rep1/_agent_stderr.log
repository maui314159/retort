timestamp=2026-09-01T05:58:07.152Z level=INFO run=2c158548 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport time\nfrom brazilian_soccer_mcp import load_dataset\nfrom brazilian_soccer_mcp.queries import (search_matches, last_match_between, head_to_head,\n    team_stats, team_profile, standings, biggest_wins, competition_stats, best_records,\n    derbies, player_search, player_club_report, list_competitions, list_teams, resolve_team)\nds = load_dataset()\n\nst = standings(ds, 'serie_a', 2019)\nprint(\"2019 top3:\", [(r['position'], r['team'], r['points'], r['wins'], r['draws'], r['losses'], r['goals_for'], r['goals_against']) for r in st['rows'][:3]])\nprint(\"2019 relegated:\", [(r['position'], r['team'], r['points']) for r in st['relegated']])\n\nt0=time.time(); r = search_matches(ds, team='Flamengo', opponent='Fluminense', limit=200); print(\"search Fla-Flu:\", r['total'], \"ms:\", round((time.time()-t0)*1000))\nt0=time.time(); r2 = standings(ds, 'serie_a', 2019); print(\"standings ms:\", round((time.time()-t0)*1000))\nt0=time.time(); r3 = player_search(ds, nationality='Brazil', limit=5); print(\"player_search ms:\", round((time.time()-t0)*1000), [(p['name'],p['overall']) for p in r3['players']])\n\nlm = last_match_between(ds, 'Flamengo', 'Corinthians')\nprint(\"last Fla-Cor:\", lm['last_played']['date'], lm['last_played']['home'], lm['last_played']['score'], lm['last_played']['away'], lm['last_played']['competition'], lm['total_meetings'])\n\nh = head_to_head(ds, 'Palmeiras', 'Santos')\nprint(\"Pal-San h2h:\", h['wins_team_a'], h['draws'], h['wins_team_b'], h['meetings'])\n\ncf = search_matches(ds, competition='copa_do_brasil', stage='final', limit=50)\nprint(\"copa finals total:\", cf['total'])\nimport collections\nper_season = collections.Counter(m['season'] for m in cf['matches'])\nprint(\"cup finals per season:\", dict(sorted(per_season.items())))\nf19 = [m for m in cf['matches'] if m['season']==2019]\nprint(\"cup final 2019:\", [(m['home'], m['score'], m['away']) for m in f19])\n\nlf = search_matches(ds, competition='libertadores', stage='final', limit=50)\nprint(\"lib finals:\", [(m['season'], m['home'], m['score'], m['away']) for m in lf['matches']])\n\nbw = biggest_wins(ds, limit=5)\nprint(\"biggest:\", [(m['home'], m['score'], m['away'], m['competition'], m['season'], m['margin']) for m in bw['biggest_wins']])\n\npal23 = search_matches(ds, team='Palmeiras', season=2023, limit=200)\nprint(\"Palmeiras 2023:\", pal23['total'])\ncomps = collections.Counter(m['competition'] for m in pal23['matches'])\nprint(\"Palmeiras 2023 by comp:\", dict(comps))\n\np = search_matches(ds, team='Palmeiras', season=2023, date_from='2023-06-01', date_to='2023-06-30', limit=200)\nprint(\"Palmeiras June 2023:\", p['total'])\n\ntp = team_profile(ds, 'Palmeiras')\nprint(\"Palmeiras comps:\", [(c['competition'], c['matches']) for c in tp['by_competition']])\nprint(\"Palmeiras all-time:\", tp['all_time_record'])\nprint(\"Palmeiras fifa players:\", tp['fifa_players_in_dataset'], \"| variants:\", tp['club']['name_variations'][:5])\n\nps = player_search(ds, name='Gabriel Barbosa')\nprint(\"Gabriel Barbosa:\", [(p['name'], p['age'], p['overall'], p['club'], p['position']) for p in ps['players']])\npsx = player_search(ds, nationality='Brazil', limit=5)\nprint(\"top BR:\", [(p['name'], p['overall'], p['position'], p['club']) for p in psx['players']])\npsg = player_search(ds, club='Grêmio', limit=30)\nprint(\"Grêmio players:\", psg['total'], [(p['name'], p['overall']) for p in psg['players'][:3]])\npsf = player_search(ds, club='São Paulo', position='FWD')\nprint(\"São Paulo forwards:\", psf['total'])\npsj = player_search(ds, club='Juventus', limit=5)\nprint(\"Juventus:\", psj['total'], [(p['name'],p['overall']) for p in psj['players'][:2]])\n\ncr = player_club_report(ds, nationality='Brazil')\nrows = [r for r in cr['clubs_report'] if r['brazilian_club_in_match_data']][:6]\nprint(\"BR clubs report:\", [(r['club'], r['players'], r['avg_overall']) for r in rows])\n\nbr_ = best_records(ds, venue='away', competition='serie_a', min_matches=100, limit=3)\nprint(\"best away:\", [(r['team'], r['win_rate'], r['matches']) for r in br_['records']])\nbh_ = best_records(ds, venue='home', competition='serie_a', min_matches=100, limit=3)\nprint(\"best home:\", [(r['team'], r['win_rate'], r['matches']) for r in bh_['records']])\nbg_ = best_records(ds, venue='all', competition='serie_a', season=2023, metric='goals_for', limit=3)\nprint(\"2023 GF leaders:\", [(r['team'], r['goals_for']) for r in bg_['records']])\n\nd23 = derbies(ds, season=2023)\nprint(\"derbies 2023 with matches:\", d23['derbies_with_matches'])\nff = [x for x in d23['derbies'] if x['derby']=='Fla-Flu'][0]\nprint(\"Fla-Flu 2023:\", ff['matches_in_scope'], [(m['date'], m['home'], m['score'], m['away']) for m in ff['matches'][:2]])\n\nlc = list_competitions(ds)\nprint(\"comps:\", [(c['id'], c['first_season'], c['last_season'], c['matches']) for c in lc['competitions']])\nlt = list_teams(ds, competition='serie_a', season=2019)\nprint(\"serie_a 2019 teams:\", lt['total'])\ncor, alts = resolve_team(ds, 'Palmeiras-SP'); print(\"resolve Palmeiras-SP:\", cor.key if cor else None)\ncor, alts = resolve_team(ds, 'Sport Club Corinthians Paulista'); print(\"resolve full name:\", cor.key if cor else None, cor.display if cor else None)\ncor, alts = resolve_team(ds, 'Botafogo'); print(\"resolve Botafogo:\", cor.key if cor else None, \"| alts:\", [c.key for c in alts])\ncor, alts = resolve_team(ds, 'Athletico Paranaense'); print(\"resolve Athletico:\", cor.key if cor else None)\ncor, alts = resolve_team(ds, 'Atletico Mineiro'); print(\"resolve Atletico Mineiro:\", cor.key if cor else None)\ncor, alts = resolve_team(ds, 'Flamengoo'); print(\"fuzzy Flamengoo:\", cor, [c.display for c in alts])\ncs = competition_stats(ds, 'libertadores', season=2019)\nprint(\"lib 2019 stats:\", cs['stats']['avg_goals_per_match'], cs['stats']['home_win_rate'])\nts = team_stats(ds, 'Corinthians', season=2022, competition='serie_a', venue='home')\nprint(\"Cor home 2022:\", ts['record'])\ntsa = team_stats(ds, 'Santos', season=None, competition=None, venue='away')\nprint(\"Santos away all-time:\", tsa['record']['matches'], tsa['away_record']['wins'])\nEOF" action.permission=bash action.action=allow action.pattern=*
