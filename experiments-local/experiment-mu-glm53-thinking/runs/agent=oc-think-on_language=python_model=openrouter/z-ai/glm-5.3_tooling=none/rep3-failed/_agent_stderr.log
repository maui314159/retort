timestamp=2026-09-01T17:16:43.633Z level=INFO run=a6cf503f message=evaluated permission=bash pattern="venv/bin/python -c \"\nfrom brazilian_soccer import load_soccer_data\nfrom brazilian_soccer.loader import BRASILEIRAO_A\nfrom collections import Counter, defaultdict\nd = load_soccer_data()\n\n# per-season team match counts — find split identities\nfor season in [2013, 2020, 2023]:\n    cnt = Counter()\n    for m in d.matches:\n        if m.competition == BRASILEIRAO_A and m.season == season:\n            cnt[m.home] += 1; cnt[m.away] += 1\n    n_teams = len(cnt)\n    bad = {t: c for t, c in cnt.items() if c != 38}\n    print(f'--- {season}: teams={n_teams}, matches={sum(cnt.values())//2}')\n    for t, c in sorted(bad.items(), key=lambda kv: kv[1]): print(f'     {d.display_team(t):22s} {c}')\n\"" action.permission=bash action.action=allow action.pattern=*
