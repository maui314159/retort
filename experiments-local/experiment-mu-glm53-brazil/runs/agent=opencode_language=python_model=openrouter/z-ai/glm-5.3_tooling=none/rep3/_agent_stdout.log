\"], lm[\"last_match\"][\"away_team\"])\n\nprint(\"\\n== Averages Serie A 2019 ==\")\nprint(\"  \", svc.season_averages(ds, \"Brasileirão Serie A\", 2019))\n\nprint(\"\\n== Derbies 2023 ==\")\nd = svc.derby_matches(ds, season=2023)\nprint(\"  \", [(x[\"derby\"], x[\"total_matches\"]) for x in d[\"derbies\"]])\nEOF"},"output":"== 2019 Serie A standings (top 3 + relegated) ==\n   1 Flamengo 90 pts 28W 6D 4L\n   2 Santos 74 pts 22W 8D 8L\n   3 Palmeiras 74 pts 21W 11D 6L\n   champion: Flamengo | relegated: ['Cruzeiro', 'CSA', 'Chapecoense', 'Avaí']\n\n== Champion 2023 (incomplete season note) ==\n   {'competition': 'Brasileirão Serie A', 'season': 2023, 'format': 'league', 'champion': 'Grêmio', 'record': {'matches': 38, 'wins': 21, 'draws': 5, 'losses': 12, 'goals_for': 63, 'goals_against': 55, 'points': 68}, 'notes': ['Data incomplete: 377 of 380 expected matches have scores in the source data; the table may shift.']}\n\n== Libertadores 2019 champion ==\n   Flamengo\n== Copa do Brasil 2019 champion ==\n   {'competition': 'Copa do Brasil', 'season': 2019, 'format': 'cup', 'champion': 'Athletico Paranaense', 'final_matches': [{'date': '2019-09-11', 'home_team': 'Athletico Paranaense', 'away_team': 'Internacional', 'score': '1-0', 'home_goals': 1, 'away_goals': 0, 'competition': 'Copa do Brasil', 'season': 2019, 'round': '8', 'stage': None, 'stadium': None, 'source': 'Brazilian_Cup_Matches', 'winner': 'home'}, {'date': '2019-09-18', 'home_team': 'Internacional', 'away_team': 'Athletico Paranaense', 'score': '1-2', 'home_goals': 1, 'away_goals': 2, 'competition': 'Copa do Brasil', 'season': 2019, 'round': '8', 'stage': None, 'stadium': None, 'source': 'Brazilian_Cup_Matches', 'winner': 'away'}], 'aggregate': {'Athletico Paranaense': 3, 'Internacional': 1}, 'note': None}\n\n== Fla-Flu head-to-head ==\n   {'matches': 44, 'scored_matches': 44, 'Flamengo wins': 18, 'Fluminense wins': 14, 'draws': 12, 'Flamengo goals': 60, 'Fluminense goals': 48}\n\n== Corinthians home record 