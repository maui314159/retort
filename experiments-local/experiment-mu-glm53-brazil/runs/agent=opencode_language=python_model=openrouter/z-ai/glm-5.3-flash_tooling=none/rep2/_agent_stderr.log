timestamp=2026-08-31T19:42:22.520Z level=INFO run=615f6cc2 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv\ndef season_range(path, col):\n    vals = set()\n    with open(path, encoding='utf-8') as f:\n        for row in csv.DictReader(f): vals.add(row[col])\n    return min(vals), max(vals)\nprint(\"Cup seasons:\", season_range('data/kaggle/Brazilian_Cup_Matches.csv', 'season'))\nprint(\"Lib seasons:\", season_range('data/kaggle/Libertadores_Matches.csv', 'season'))\ndates = []\nwith open('data/kaggle/BR-Football-Dataset.csv', encoding='utf-8') as f:\n    for row in csv.DictReader(f): dates.append(row['date'])\nprint(\"BR-Foot dates:\", min(dates), max(dates))\n# Check goal col oddities\nwith open('data/kaggle/Libertadores_Matches.csv', encoding='utf-8') as f:\n    bad = [(r['datetime'], r['home_goal'], r['away_goal']) for r in csv.DictReader(f) if not r['home_goal'].isdigit() or not r['away_goal'].isdigit()]\nprint(\"Lib non-int goals:\", bad)\nwith open('data/kaggle/BR-Football-Dataset.csv', encoding='utf-8') as f:\n    bad2 = set()\n    for r in csv.DictReader(f):\n        for c in ('home_goal','away_goal'):\n            v = r[c]\n            if v and not v.isdigit(): bad2.add(v)\nprint(\"BR-Foot non-int goals:\", sorted(bad2)[:10])\nEOF" action.permission=bash action.action=allow action.pattern=*
