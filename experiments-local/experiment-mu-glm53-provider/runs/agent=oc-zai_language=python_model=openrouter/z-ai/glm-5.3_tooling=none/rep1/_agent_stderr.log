timestamp=2026-09-01T05:05:51.011Z level=INFO run=1a470e0e message=evaluated permission=bash pattern="./venv/bin/python << 'EOF'\nfrom brazilian_soccer_mcp.loaders import load_all\nfrom brazilian_soccer_mcp.models import BRASILEIRAO_A\nfrom collections import Counter\ndata = load_all('data/kaggle')\n\n# Deduped Série A per source\nc = Counter(m.source for m in data.matches if m.competition == BRASILEIRAO_A)\nprint(\"Série A deduped per source:\", dict(c))\n\n# fluminense ids present\nfl = Counter()\nfor m in data.matches:\n    for tid in (m.home_id, m.away_id):\n        if 'fluminense' in tid: fl[tid] += 1\nprint(\"fluminense ids in matches:\", dict(fl))\n\n# fifa clubs bridged to santos-sp\nprint(\"fifa clubs santos-sp:\", data.fifa_clubs_by_team.get('santos-sp'))\nprint(\"fifa clubs fluminense*:\", {k: v for k, v in data.fifa_clubs_by_team.items() if 'fluminense' in k})\n\n# registry internals for fluminense\nreg = data.registry\nprint(\"ambiguous?\", 'fluminense' in reg._ambiguous_bases)\nprint(\"by_base fluminense:\", reg._by_base.get('fluminense'))\nprint(\"remap entries for fluminense pids:\", {pid: r for pid, r in reg._remap.items() if 'fluminense' in pid})\nEOF" action.permission=bash action.action=allow action.pattern=*
