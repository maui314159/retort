l_mcp/loaders.py       108     11    90%\nsrc/brasil_mcp/models.py        141      7    95%\nsrc/brasil_mcp/normalize.py     204     14    93%\nsrc/brasil_mcp/queries.py       297     27    91%\nsrc/brasil_mcp/server.py         53      2    96%\nsrc/brasil_mcp/store.py         421     45    89%\n-------------------------------------------------\nTOTAL                          1387    229    83%\n","exit":0,"truncated":false},"title":"source venv/bin/activate && ruff check src/ tests/ --select E,F,W,I --line-length 110 && python -m pytest tests/ -q --cov=brasil_mcp --cov-report=term 2>&1 | tail -18","time":{"start":1788229787436,"end":1788229787438}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05acc0d26001gUifXxZWDQbBM0","sessionID":"ses_fa566b1a7ffetmaN0ZgRQlI0ol","messageID":"msg_05acbfcf2001oRanh309uAXArQ"}}
