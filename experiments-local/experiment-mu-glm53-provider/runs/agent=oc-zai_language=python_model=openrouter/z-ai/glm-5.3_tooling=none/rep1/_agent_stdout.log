        if pid.startswith(base + \"-\"):\n                suffix = pid.rsplit(\"-\", 1)[1]\n                if suffix in BRAZILIAN_STATES:\n                    state_counts[suffix] += entry[\"count\"]\n        if state_counts:\n            return state_counts.most_common(1)[0][0]\n        return list(\n            {s for s in self._by_base.get(base, {}) if s and not s.startswith(\"foreign:\")}\n        )[0]"},"output":"Edit applied successfully.","metadata":{"diagnostics":{},"diff":"Index: /Users/maui/.retort/work/retort-local-7ooj92cj/retort-7f4a851aa2e1/brazilian_soccer_mcp/normalizer.py\n===================================================================\n--- /Users/maui/.retort/work/retort-local-7ooj92cj/retort-7f4a851aa2e1/brazilian_soccer_mcp/normalizer.py\n+++ /Users/maui/.retort/work/retort-local-7ooj92cj/retort-7f4a851aa2e1/brazilian_soccer_mcp/normalizer.py\n@@ -400,22 +400,35 @@\n     self._finalized = True\n     return remap\n \n def _default_state_for(self, base: str) -> str:\n+    \"\"\"Default state for a bare ambiguous base (e.g. bare 'Fluminense').\n+\n+    Curated override first; otherwise the state whose suffixed form\n+    occurs most often in the data (Fluminense-RJ >> Fluminense-PI).\n+    Note: provisional ids are lowercase, so suffixes must be compared\n+    case-insensitively against the uppercase state codes.\n+    \"\"\"\n     if base in DEFAULT_STATES:\n         return DEFAULT_STATES[base]\n-    # Frequency fallback: suffix with most occurrences across the data.\n     state_counts: Counter = Counter()\n     for pid, entry in self._provisional.items():\n         if pid.startswith(base + \"-\"):\n             suffix = pid.rsplit(\"-\", 1)[1]\n-            if suffix in BRAZILIAN_STATES:\n+            if suffix.upper() in BRAZILIAN_STATES:\n                 state_counts[suffix] += entry[\"count\"]\n     if state_counts:\n-        return state_counts.most_common(1)[0][0]\n-    return list(\n-        {s for s in self._by_base.get(base, {}) if s