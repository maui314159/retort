timestamp=2026-09-01T09:59:50.307Z level=INFO run=f27b5900 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv, re, unicodedata\nfrom collections import defaultdict, Counter\n\ndef rows(p):\n    with open(p, encoding='utf-8-sig') as f:\n        return list(csv.DictReader(f))\n\ndef deacc(s):\n    return ''.join(c for c in unicodedata.normalize('NFD', s) if not unicodedata.combining(c))\n\nbra = rows('data/kaggle/Brasileirao_Matches.csv')\ncupa = rows('data/kaggle/Brazilian_Cup_Matches.csv')\nlib = rows('data/kaggle/Libertadores_Matches.csv')\nbf = rows('data/kaggle/BR-Football-Dataset.csv')\nhist = rows('data/kaggle/novo_campeonato_brasileiro.csv')\n\ndef show(label, names, pred):\n    print(f\"{label}: {sorted({n for n in names if pred(deacc(n).lower())})}\")\n\nallnames = set()\nfor r in bra: allnames |= {r['home_team'], r['away_team']}\nshow(\"BRAS atletico/vasco-ish\", allnames, lambda s: 'atlet' in s or 'vasco' in s or 'paranaense' in s or 'mineiro' in s)\n\nallnames_c = set()\nfor r in cupa: allnames_c |= {r['home_team'], r['away_team']}\nshow(\"COPA big club spellings\", allnames_c, lambda s: any(k in s for k in ['corinthians','flamengo','palmeiras','vasco','atlet','mineiro','paranaense','gremio','cruzeiro','santos','paulista']))\n\nallnames_l = set()\nfor r in lib: allnames_l |= {r['home_team'], r['away_team']}\nshow(\"LIB atletico/athletico/braz big\", allnames_l, lambda s: any(k in s for k in ['atlet','athlet','mineiro','paranaense','vasco','gremio','flamengo','palmeiras','santos','paulista','cruzeiro','corinthians','internacional','chapecoense','fortaleza','ceara','avai','bahia','goias','coritiba','fluminense','botafogo','sport']))\n\nallnames_b = set()\nfor r in bf: allnames_b |= {r['home'], r['away']}\nshow(\"BRF atletico variants\", allnames_b, lambda s: 'atlet' in s or 'paranaense' in s or 'mineiro' in s or 'goianiense' in s)\nshow(\"BRF big clubs\", allnames_b, lambda s: any(k in s for k in ['flamengo','palmeiras','corinthians','vasco','gremio fb','cruzeiro','sao paulo','santos fc','fluminense','botafogo','internacional','sport','fortaleza','ceara','bahia de','bahia','vitoria','goias','coritiba','avai','chapecoense','criciuma','ponte preta','atletico go','athletico','parana clube','guarani','figueirense','america mg','america rn','cuiaba','juventude','nautico','santa cruz','bragantino','red bull']))\nprint(\"BRF 'bahia' matches:\", [n for n in allnames_b if 'bahia' in deacc(n).lower()])\nprint(\"BRF 'sport':\", [n for n in allnames_b if deacc(n).lower().startswith('sport')][:6])\nprint(\"BRF 'santos':\", [n for n in allnames_b if deacc(n).lower().startswith('santos')][:6])\n\nallnames_h = set()\nfor r in hist: allnames_h |= {r['Equipe_mandante'], r['Equipe_visitante']}\nshow(\"HIST atletico/vasco\", allnames_h, lambda s: 'atlet' in s or 'vasco' in s)\n\n# Copa do Brasil: which seasons have round 8? (final)\nprint(\"\\nCOPA round 8 by season:\", sorted(Counter(r['season'] for r in cupa if r['round']=='8').items()))\nprint(\"COPA round 7 by season:\", sorted(Counter(r['season'] for r in cupa if r['round']=='7').items()))\n# LIB bare atletico/athletico rows\nfor r in lib:\n    nm = deacc(r['home_team']).lower()\n    if nm in ('atletico','athletico'):\n        print(\"LIB bare:\", r['home_team'], r['season'], r['stage'])\nEOF" action.permission=bash action.action=allow action.pattern=*
