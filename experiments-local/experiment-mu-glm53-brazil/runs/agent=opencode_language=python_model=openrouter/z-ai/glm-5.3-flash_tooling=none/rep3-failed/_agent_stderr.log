timestamp=2026-08-31T19:20:12.288Z level=INFO run=532d90f3 message=evaluated permission=bash pattern="python3 -c \"\nimport csv\n# check goal anomalies and date formats\nfor f in ['Libertadores_Matches.csv','Brazilian_Cup_Matches.csv']:\n    with open('data/kaggle/'+f, encoding='utf-8') as fh:\n        rows = list(csv.DictReader(fh))\n    bad = [r for r in rows if not r['home_goal'] or not r['away_goal']]\n    print(f, 'missing goals:', len(bad), bad[:2])\nwith open('data/kaggle/Brasileirao_Matches.csv', encoding='utf-8') as fh:\n    rows = list(csv.DictReader(fh))\nprint('bras missing goals:', sum(1 for r in rows if not r['home_goal']))\nwith open('data/kaggle/novo_campeonato_brasileiro.csv', encoding='utf-8') as fh:\n    rows = list(csv.DictReader(fh))\nprint('novo missing goals:', sum(1 for r in rows if not r['Gols_mandante']), 'OBS:', sorted(set(r['OBS'] for r in rows if r['OBS']))[:5])\nwith open('data/kaggle/BR-Football-Dataset.csv', encoding='utf-8') as fh:\n    rows = list(csv.DictReader(fh))\nprint('BR missing goals:', sum(1 for r in rows if not r['home_goal']))\n\"" action.permission=bash action.action=allow action.pattern=*
