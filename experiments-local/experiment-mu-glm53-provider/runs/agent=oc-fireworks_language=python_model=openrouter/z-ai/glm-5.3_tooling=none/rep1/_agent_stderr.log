timestamp=2026-09-01T05:33:21.009Z level=INFO run=2c158548 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, re, unicodedata, collections\ndef deacc(s): return ''.join(c for c in unicodedata.normalize('NFKD', s) if not unicodedata.combining(c)).lower()\nSTATES={'AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'}\nALIAS={('atletico mineiro','MG'):('atletico','MG'),('athletico paranaense','PR'):('atletico','PR'),('atletico paranaense','PR'):('atletico','PR'),('athletico',None):('atletico','PR'),('vasco da gama',None):('vasco','RJ'),('vasco da gama','RJ'):('vasco','RJ'),('sport recife',None):('sport','PE')}\ndef key(name, state=None):\n    s = re.sub(r'\\(.*?\\)',' ', deacc(name.strip())).replace(\"'\",'')\n    toks=[t for t in re.split(r'[\\s\\-]+',s) if t]\n    st=state\n    if toks and toks[-1].upper() in STATES and len(toks)>1: st=toks[-1].upper(); toks=toks[:-1]\n    toks=[t.replace('.','') for t in toks]\n    FORM={'ec','sc','fc','ce','ge','ca','ad','se','aa','club','clube','futebol','ltda','esporte'}\n    while len(toks)>1 and toks[0] in FORM: toks=toks[1:]\n    while len(toks)>1 and toks[-1] in FORM: toks=toks[:-1]\n    while len(toks)>1 and len(toks[-1])==1: toks=toks[:-1]\n    core=' '.join(toks)\n    a=ALIAS.get((core,st))\n    if a: core,st=a\n    return f\"{core}|{st or ''}\"\ndef load(fn):\n    with open(fn, encoding='utf-8') as f: return list(csv.DictReader(f))\nbraskeys=collections.Counter()\nbrasnames={}\nfor r in load('data/kaggle/Brasileirao_Matches.csv'):\n    if r['season']=='2012':\n        for side,st_ in (('home_team','home_team_state'),('away_team','away_team_state')):\n            k=key(r[side]); braskeys[k]+=1; brasnames[k]=r[side]\nnovok=collections.Counter(); novoabbr={}\nnovo=load('data/kaggle/novo_campeonato_brasileiro.csv')\nfor r in novo:\n    if r['Ano']=='2012':\n        for team,uf in ((r['Equipe_mandante'],r['Mandante_UF']),(r['Equipe_visitante'],r['Visitante_UF'])):\n            k=key(team,uf); novok[k]+=1; novoabbr[k]=team\nprint(\"bras-only keys 2012:\", {k:(brasnames[k],braskeys[k]) for k in braskeys if k not in novok})\nprint(\"novo-only keys 2012:\", {k:(novoabbr[k],novok[k]) for k in novok if k not in braskeys})\n# check across ALL years: which keys mismatch overall\nbrasall=collections.Counter(); names={}\nfor r in load('data/kaggle/Brasileirao_Matches.csv'):\n    for side in ('home_team','away_team'):\n        k=key(r[side]); brasall[k]+=1; names.setdefault(k,r[side])\nnovoall=collections.Counter(); nnames={}\nfor r in novo:\n    for team,uf in ((r['Equipe_mandante'],r['Mandante_UF']),(r['Equipe_visitante'],r['Visitante_UF'])):\n        k=key(team,uf); novoall[k]+=1; nnames.setdefault(k,team)\nonly_b={k:(names[k],brasall[k]) for k in brasall if k not in novoall}\nonly_n={k:(nnames[k],novoall[k]) for k in novoall if k not in brasall}\nprint(\"\\nbras-only keys (all):\", only_b)\nprint(\"novo-only keys (all):\", only_n)\nEOF" action.permission=bash action.action=allow action.pattern=*
