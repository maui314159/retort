{"type":"tool_use","timestamp":1788229141512,"sessionID":"ses_fa566b1a7ffetmaN0ZgRQlI0ol","part":{"type":"tool","tool":"write","callID":"call_a1c12d1da1354d5f9977d977","state":{"status":"completed","input":{"content":"\"\"\"MCP server integration tests: tool listing and end-to-end tool calls.\n\nUses the in-memory transport from the mcp SDK so the full protocol layer\n(initialize -> list_tools -> call_tool) is exercised without stdio.\n\"\"\"\n\nimport json\n\nimport anyio\nimport pytest\nfrom mcp.client.session import ClientSession\nfrom mcp.shared.memory import create_client_server_memory_streams\n\nfrom brasil_mcp.server import build_server\n\nEXPECTED_TOOLS = {\n    \"find_team\",\n    \"search_matches\",\n    \"head_to_head\",\n    \"team_stats\",\n    \"team_season_history\",\n    \"standings\",\n    \"search_players\",\n    \"team_players\",\n    \"competition_info\",\n    \"derbies\",\n    \"biggest_wins\",\n    \"goals_analysis\",\n    \"best_records\",\n    \"compare_teams\",\n}\n\n\nasync def _run_client(callback):\n    server = build_server()\n    async with create_client_server_memory_streams() as (client_streams, server_streams):\n        await server._lowlevel_server.run(\n            server_streams[0],\n            server_streams[1],\n            server._lowlevel_server.create_initialization_options(),\n        ) if False else None\n\n        async def serve():\n            await server._lowlevel_server.run(\n                server_streams[0],\n                server_streams[1],\n                server._lowlevel_server.create_initialization_options(),\n            )\n\n        async with ClientSession(*client_streams) as session:\n            async with anyio.create_task_group() as tg:\n                tg.start_soon(serve)\n                await session.initialize()\n                await callback(session)\n                tg.cancel_scope.cancel()\n\n\ndef test_all_expected_tools_are_listed():\n    async def callback(session: ClientSession):\n        tools = await session.list_tools()\n        names = {tool.name for tool in tools.tools}\n        assert EXPECTED_TOOLS <= names\n        descriptions = {tool.name: (tool.description or \"\") for tool in tools.tools}\n        assert \"head-to-head\" in descriptions[\"head_to_head\"].lower()\n\n    anyio.run(callback_wrapper(callback))\n\n\ndef callback_wrapper(callback):\n    async def wrapped():\n        await _run_client(callback)\n\n    return wrapped()\n\n\ndef test_search_matches_tool_call():\n    async def callback(session: ClientSession):\n        result = await session.call_tool(\n            \"search_matches\",\n            {\"team\": \"Flamengo\", \"opponent\": \"Fluminense\", \"limit\": 3},\n        )\n        payload = json.loads(result.content[0].text)\n        assert payload[\"total\"] >= 40\n        assert payload[\"matches\"][0][\"date\"]\n        assert \"Head-to-head in dataset\" in payload[\"summary\"]\n\n    anyio.run(callback_wrapper(callback))\n\n\ndef test_standings_tool_call():\n    async def callback(session: ClientSession):\n        result = await session.call_tool(\"standings\", {\"season\": 2019})\n        payload = json.loads(result.content[0].text)\n        assert payload[\"champion\"][\"team\"] == \"Flamengo\"\n        assert \"Champion\" in payload[\"summary\"]\n\n    anyio.run(callback_wrapper(callback))\n\n\ndef test_search_players_tool_call():\n    async def callback(session: ClientSession):\n        result = await session.call_tool(\n            \"search_players\", {\"nationality\": \"Brazil\", \"limit\": 5}\n        )\n        payload = json.loads(result.content[0].text)\n        assert payload[\"total\"] == 827\n        assert payload[\"players\"][0][\"name\"] == \"Neymar Jr\"\n\n    anyio.run(callback_wrapper(callback))\n\n\ndef test_team_players_tool_graceful_for_missing_squad():\n    async def callback(session: ClientSession):\n        result = await session.call_tool(\"team_players\", {\"team\": \"Flamengo\"})\n        payload = json.loads(result.content[0].text)\n        assert payload[\"total\"] == 0\n        assert \"does not include a squad\" in payload[\"summary\"]\n\n    anyio.run(callback_wrapper(callback))\n\n\ndef test_tool_result_is_valid_json_everywhere():\n    \"\"\"Every tool must return JSON-serializable content for LLM clients.\"\"\"\n\n    calls = [\n        (\"find_team\", {\"name\": \"Grêmio\"}),\n        (\"head_to_head\", {\"team_a\": \"Palmeiras\", \"team_b\": \"Santos\"}),\n        (\"team_stats\", {\"team\": \"Flamengo\", \"season\": 2019}),\n        (\"team_season_history\", {\"team\": \"Santos\"}),\n        (\"standings\", {\"season\": 2019}),\n        (\"derbies\", {\"season\": 2023}),\n        (\"biggest_wins\", {\"limit\": 3}),\n        (\"goals_analysis\", {\"competition\": \"Série A\"}),\n        (\"best_records\", {\"venue\": \"away\"}),\n        (\"compare_teams\", {\"team_a\": \"Grêmio\", \"team_b\": \"Internacional\"}),\n        (\"competition_info\", {}),\n    ]\n\n    async def callback(session: ClientSession):\n        for tool, kwargs in calls:\n            result = await session.call_tool(tool, kwargs)\n            payload = json.loads(result.content[0].text)\n            assert isinstance(payload, dict) and \"summary\" in payload, tool\n\n    anyio.run(callback_wrapper(callback))\n","filePath":"/Users/maui/.retort/work/retort-local-0bivsr25/retort-ce22193d1e90/tests/test_server.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/maui/.retort/work/retort-local-0bivsr25/retort-ce22193d1e90/tests/test_server.py","exists":false,"truncated":false},"title":"tests/test_server.py","time":{"start":1788229141501,"end":1788229141510}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05ac343fa001VivJlmhy05PlpE","sessionID":"ses_fa566b1a7ffetmaN0ZgRQlI0ol","messageID":"msg_05ac2f8af001quV1Xu4J9rQJLn"}}
