n\": (\n365:             {s: _record_for(ms, club.id, venue) for s, ms in sorted(by_season.items())}\n366:             if season_n is None\n367:             else None\n368:         ),\n369:         \"notes\": _alternates_for(ds, team, club) or None,\n\n(Showing lines 330-369 of 1091. Use offset=370 to continue.)\n</content>","metadata":{"preview":"    ds: Dataset,\n    team: str,\n    competition: Optional[str] = None,\n    season: Any = None,\n    venue: Optional[str] = None,\n) -> dict:\n    \"\"\"Win/draw/loss record for a team, optionally per competition/season/venue.\"\"\"\n    if venue not in (None, \"home\", \"away\"):\n        raise ValueError(\"venue must be 'home', 'away' or omitted.\")\n    comp = resolve_competition_or_raise(competition) if competition else None\n    season_n = _coerce_season(season)\n    club = resolve_club_or_raise(ds, team)\n\n    pool = [\n        m for m in ds.matches\n        if (m._home_club == club.id or m._away_club == club.id)\n        and (comp is None or m.competition == comp)\n        and (season_n is None or m.season == season_n)\n    ]\n","truncated":true,"loaded":[],"display":{"type":"file","path":"/Users/maui/.retort/work/retort-local-8zur77lj/retort-2e29d1db74f5/brazilian_soccer_mcp/service.py","text":"    ds: Dataset,\n    team: str,\n    competition: Optional[str] = None,\n    season: Any = None,\n    venue: Optional[str] = None,\n) -> dict:\n    \"\"\"Win/draw/loss record for a team, optionally per competition/season/venue.\"\"\"\n    if venue not in (None, \"home\", \"away\"):\n        raise ValueError(\"venue must be 'home', 'away' or omitted.\")\n    comp = resolve_competition_or_raise(competition) if competition else None\n    season_n = _coerce_season(season)\n    club = resolve_club_or_raise(ds, team)\n\n    pool = [\n        m for m in ds.matches\n        if (m._home_club == club.id or m._away_club == club.id)\n        and (comp is None or m.competition == comp)\n        and (season_n is None or m.season == season_n)\n    ]\n\n    by_comp: dict[str, dict] = {}\n    by_season: dict[int, dict] = {}\n    for m in pool:\n        by_comp.setdefault(m.competition, []).append(m)\n        if m.season is not None:\n            by_season.setdefault(m.season, []).append(m)\n\n    return {\n        \"team\": club.display,\n        \"filters\": {\"competition\": comp, \"season\": season_n, \"venue\": venue},\n        \"overall\": _record_for(pool, club.id, venue),\n        \"by_competition\": {\n            c: _record_for(ms, club.id, venue) for c, ms in sorted(by_comp.items())\n        },\n        \"by_season\": (\n            {s: _record_for(ms, club.id, venue) for s, ms in sorted(by_season.items())}\n            if season_n is None\n            else None\n        ),\n        \"notes\": _alternates_for(ds, team, club) or None,","lineStart":330,"lineEnd":369,"totalLines":1091,"truncated":true}},"title":"brazilian_soccer_mcp/service.py","time":{"start":1788271661428,"end":1788271661433}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05d4c1172001ME4GSTIJE7U5kK","sessionID":"ses_fa2db0ef4ffeemTLK4uNaaAd5c","messageID":"msg_05d4bee5a001tTXGvwXrAElUZV"}}
