timestamp=2026-09-01T16:36:18.051Z level=INFO run=66fb43df message=evaluated permission=bash pattern="python3 << 'EOF'\nimport csv\nfrom collections import Counter\ndef load(f):\n    with open(f, encoding='utf-8') as fh:\n        return list(csv.DictReader(fh))\nb = load('data/kaggle/Brasileirao_Matches.csv')\nbr = load('data/kaggle/BR-Football-Dataset.csv')\n\nf1 = Counter()\nfor r in b:\n    if r['season']=='2019' and 'Flamengo' in (r['home_team'], r['away_team']):\n        h, a = r['home_team'].split('-')[0], r['away_team'].split('-')[0]\n        hg, ag = int(r['home_goal']), int(r['away_goal'])\n        f1[(h, a, hg, ag)] += 1\nf2 = Counter()\nfor r in br:\n    if r['tournament']=='Serie A' and r['date'].startswith('2019') and 'Flamengo' in (r['home'], r['away']):\n        h, a = r['home'], r['away']\n        hg, ag = int(float(r['home_goal'])), int(float(r['away_goal']))\n        f2[(h, a, hg, ag)] += 1\n\nprint('same fixture+score count:', sum((f1 & f2).values()))\nprint('in b not br:', list((f1 - f2).elements())[:8])\nprint('in br not b:', list((f2 - f1).elements())[:8])\n# Check BR-Football date sanity: distribution of dates for a known round\nprint()\nprint('BR-Football Flamengo home dates:', sorted(r['date'] for r in br if r['tournament']=='Serie A' and r['date'].startswith('2019') and r['home']=='Flamengo'))\nEOF" action.permission=bash action.action=allow action.pattern=*
