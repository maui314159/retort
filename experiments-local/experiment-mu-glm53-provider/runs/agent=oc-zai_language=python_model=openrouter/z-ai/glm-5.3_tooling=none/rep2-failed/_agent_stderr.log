timestamp=2026-09-01T06:48:55.537Z level=INFO run=27f52cea message=evaluated permission=bash pattern="venv/bin/python -c \"\nimport csv\nfrom collections import Counter\nfrom normalize import parse_int\nwith open('data/kaggle/Brasileirao_Matches.csv', encoding='utf-8-sig') as f:\n    rows = list(csv.DictReader(f))\nunscored = [r for r in rows if parse_int(r['home_goal']) is None or parse_int(r['away_goal']) is None]\nprint('unscored Brasileirao rows:', len(unscored))\nfor r in unscored[:10]: print('  ', r['datetime'], r['home_team'], r['away_team'], r['season'], 'round', r['round'])\n\"" action.permission=bash action.action=allow action.pattern=*
timestamp=2026-09-01T06:48:59.151Z level=INFO run=27f52cea message=evaluated permission=bash pattern="venv/bin/python -c \"\nfrom collections import Counter\nfrom data_loader import get_data, SERIE_A, SERIE_B, SERIE_C\ndata = get_data()\nfor comp in (SERIE_A, SERIE_B, SERIE_C):\n    hist = Counter()\n    for season in data.seasons_for_competition(comp):\n        ms = data.matches_by_competition(comp, season)\n        per = Counter()\n        for m in ms: per[m.home_key]+=1; per[m.away_key]+=1\n        for t, n in per.items(): hist[n]+=1\n    small = {n: c for n, c in sorted(hist.items()) if n < 8}\n    print(comp, 'games-per-team histogram (small counts):', small, 'total teams-seasons:', sum(hist.values()))\n\"" action.permission=bash action.action=allow action.pattern=*
