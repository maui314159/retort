{"type":"tool_use","timestamp":1788373772619,"sessionID":"ses_f9c9e1f2effeUE9mG9h5hx4Ni7","part":{"type":"tool","tool":"read","callID":"call_01a0636228e57bb180c27f4a","state":{"status":"completed","input":{"filePath":"/workspace/soccer_mcp/queries.py"},"output":"<path>/workspace/soccer_mcp/queries.py</path>\n<type>file</type>\n<content>\n1: \"\"\"\n2: Context\n3: =======\n4: Brazilian Soccer MCP Server - query layer.\n5: \n6: Part of the ``soccer_mcp`` package.  Pure-Python functions that answer the\n7: five required query categories described in TASK.md:\n8: \n9:     1. Match queries      - find_matches, head_to_head\n10:     2. Team queries       - team_stats, list_teams\n11:     3. Player queries     - search_players, team_players\n12:     4. Competition queries- standings, champion, relegated, list_competitions\n13:     5. Statistical analysis- statistics, biggest_wins, match_stats\n14: \n15: Every public function takes plain Python arguments and returns JSON-serialisable\n16: dicts / lists so they can be exposed directly as MCP tools.  A team name given\n17: by the caller is resolved to a canonical key through the shared\n18: :class:`soccer_mcp.normalize.TeamNormalizer`; team name variations\n19: (\"Palmeiras-SP\", \"Palmeiras\", \"Sao Paulo-SP\" vs \"Sao Paulo\") are therefore\n20: matched consistently across all six datasets (see data_loader.py for the\n21: source-priority merge that prevents double counting).\n22: \n23: All match-based aggregates operate on the source-priority-selected ``matches``\n24: collection (one clean record per real-world match) unless noted otherwise.\n25: \"\"\"\n26: \n27: from __future__ import annotations\n28: \n29: from collections import defaultdict\n30: from typing import Optional\n31: \n32: from .data_loader import (\n33:     COMP_BRASILEIRAO_A,\n34:     COMP_BRASILEIRAO_B,\n35:     COMP_COPA_BRASIL,\n36:     COMP_LIBERTADORES,\n37:     SoccerData,\n38:     get_data,\n39:     resolve_competition,\n40: )\n41: \n42: __all__ = [\n43:     \"find_matches\",\n44:     \"head_to_head\",\n45:     \"team_stats\",\n46:     \"list_teams\",\n47:     \"search_players\",\n48:     \"team_players\",\n49:     \"standings\",\n50:     \"champion\",\n51:     \"relegated\",\n52:     \"list_competitions\",\n53:     \"statistics\",\n54:     \"biggest_wins\",\n55:     \"match_stats\",\n56:     \"resolve_team\",\n57: ]\n58: \n59: _LEAGUE_COMPETITIONS = {COMP_BRASILEIRAO_A, COMP_BRASILEIRAO_B}\n60: \n61: \n62: # ---------------------------------------------------------------------------\n63: # Helpers\n64: # ---------------------------------------------------------------------------\n65: def _data() -> SoccerData:\n66:     return get_data()\n67: \n68: \n69: def resolve_team(name: str) -> Optional[str]:\n70:     \"\"\"Resolve a user-supplied team/club name to a canonical key.\"\"\"\n71:     if not name:\n72:         return None\n73:     return _data().normalizer.canonical(name)\n74: \n75: \n76: def _display(key: str) -> str:\n77:     return _data().team_display.get(key) or _data().normalizer.display(key) or key\n78: \n79: \n80: def _maybe_date_in_range(date: Optional[str], date_from: Optional[str], date_to: Optional[str]) -> bool:\n81:     if date is None:\n82:         # Unknown dates only pass when no range was specified.\n83:         return date_from is None and date_to is None\n84:     if date_from and date < date_from:\n85:         return False\n86:     if date_to and date > date_to:\n87:         return False\n88:     return True\n89: \n90: \n91: def _competition_filter(competition: Optional[str]) -> Optional[str]:\n92:     return resolve_competition(competition)\n93: \n94: \n95: def _match_to_dict(m) -> dict:\n96:     out = {\n97:         \"date\": m.date,\n98:         \"season\": m.season,\n99:         \"competition\": m.competition,\n100:         \"round\": m.round_or_stage,\n101:         \"home_team\": m.home_display,\n102:         \"away_team\": m.away_display,\n103:         \"home_goals\": m.home_goals,\n104:         \"away_goals\": m.away_goals,\n105:         \"score\": (\n106:             f\"{m.home_goals}-{m.away_goals}\"\n107:             if m.home_goals is not None and m.away_goals is not None\n108:             else None\n109:         ),\n110:         \"source\": m.source,\n111:     }\n112:     return out\n113: \n114: \n115: def _sort_matches(matches: list, limit: Optional[int]) -> list:\n116:     ordered = sorted(matches, key=lambda m: (m.date or \"\", m.competition))\n117:     if limit is not None:\n118:         ordered = ordered[:limit]\n119:     return ordered\n120: \n121: \n122: # ---------------------------------------------------------------------------\n123: # 1. Match queries\n124: # ---------------------------------------------------------------------------\n125: def find_matches(\n126:     team: Optional[str] = None,\n127:     opponent: Optional[str] = None,\n128:     competition: Optional[str] = None,\n129:     season: Optional[str] = None,\n130:     date_from: Optional[str] = None,\n131:     date_to: Optional[str] = None,\n132:     stage: Optional[str] = None,\n133:     venue: Optional[str] = None,\n134:     limit: int = 50,\n135: ) -> list[dict]:\n136:     \"\"\"Find matches matching the given criteria.\n137: \n138:     ``venue`` may be \"home\", \"away\" or \"either\" (default) for ``team``.\n139:     Dates are ISO ``YYYY-MM-DD``; ``date_from``/``date_to`` are inclusive.\n140:     \"\"\"\n141:     data = _data()\n142:     comp = _competition_filter(competition)\n143:     team_key = resolve_team(team) if team else None\n144:     opp_key = resolve_team(opponent) if opponent else None\n145:     if venue:\n146:         venue = venue.lower()\n147:         if venue not in {\"home\", \"away\", \"either\", \"any\"}:\n148:             venue = \"either\"\n149:     venue = venue or \"either\"\n150:     if venue == \"any\":\n151:         venue = \"either\"\n152: \n153:     results = []\n154:     for m in data.matches:\n155:         if comp and m.competition != comp:\n156:             continue\n157:         if season and m.season != str(season):\n158:             continue\n159:         if not _maybe_date_in_range(m.date, date_from, date_to):\n160:             continue\n161:         if stage:\n162:             rs = (m.round_or_stage or \"\").lower()\n163:             if stage.lower() not in rs:\n164:                 continue\n165:         if team_key:\n166:             if venue == \"home\":\n167:                 if m.home_team != team_key:\n168:                     continue\n169:                 if opp_key and m.away_team != opp_key:\n170:                     continue\n171:             elif venue == \"away\":\n172:                 if m.away_team != team_key:\n173:                     continue\n174:                 if opp_key and m.home_team != opp_key:\n175:                     continue\n176:             else:  # either\n177:                 if m.home_team == team_key:\n178:                     if opp_key and m.away_team != opp_key:\n179:                         continue\n180:                 elif m.away_team == team_key:\n181:                     if opp_key and m.home_team != opp_key:\n182:                         continue\n183:                 else:\n184:                     continue\n185:         elif opp_key:\n186:             if m.home_team != opp_key and m.away_team != opp_key:\n187:                 continue\n188:         results.append(m)\n189: \n190:     ordered = _sort_matches(results, limit)\n191:     return [_match_to_dict(m) for m in ordered]\n192: \n193: \n194: def head_to_head(\n195:     team_a: str,\n196:     team_b: str,\n197:     competition: Optional[str] = None,\n198:     limit: int = 100,\n199: ) -> dict:\n200:     \"\"\"Return the head-to-head record between two teams.\"\"\"\n201:     data = _data()\n202:     a_key = resolve_team(team_a)\n203:     b_key = resolve_team(team_b)\n204:     comp = _competition_filter(competition)\n205: \n206:     matches = []\n207:     a_wins = b_wins = draws = a_goals = b_goals = 0\n208:     for m in data.matches:\n209:         if comp and m.competition != comp:\n210:             continue\n211:         if {m.home_team, m.away_team} != {a_key, b_key}:\n212:             continue\n213:         if m.home_goals is None or m.away_goals is None:\n214:             continue\n215:         matches.append(m)\n216:         # Determine each team's goals.\n217:         if m.home_team == a_key:\n218:             ag, bg = m.home_goals, m.away_goals\n219:         else:\n220:             ag, bg = m.away_goals, m.home_goals\n221:         a_goals += ag\n222:         b_goals += bg\n223:         if ag > bg:\n224:             a_wins += 1\n225:         elif bg > ag:\n226:             b_wins += 1\n227:         else:\n228:             draws += 1\n229: \n230:     ordered = _sort_matches(matches, limit)\n231:     return {\n232:         \"team_a\": _display(a_key),\n233:         \"team_b\": _display(b_key),\n234:         \"matches_played\": len(matches),\n235:         \"team_a_wins\": a_wins,\n236:         \"team_b_wins\": b_wins,\n237:         \"draws\": draws,\n238:         \"team_a_goals\": a_goals,\n239:         \"team_b_goals\": b_goals,\n240:         \"matches\": [_match_to_dict(m) for m in ordered],\n241:     }\n242: \n243: \n244: # ---------------------------------------------------------------------------\n245: # 2. Team queries\n246: # ---------------------------------------------------------------------------\n247: def _empty_record() -> dict:\n248:     return {\"played\": 0, \"wins\": 0, \"draws\": 0, \"losses\": 0,\n249:             \"goals_for\": 0, \"goals_against\": 0}\n250: \n251: \n252: def team_stats(\n253:     team: str,\n254:     season: Optional[str] = None,\n255:     competition: Optional[str] = None,\n256:     venue: Optional[str] = None,\n257: ) -> dict:\n258:     \"\"\"Return win/draw/loss and goal records for a team, optionally split by venue.\"\"\"\n259:     data = _data()\n260:     key = resolve_team(team)\n261:     comp = _competition_filter(competition)\n262:     if season:\n263:         season = str(season)\n264:     if venue:\n265:         venue = venue.lower()\n266:         if venue not in {\"home\", \"away\", \"overall\", \"either\", \"any\"}:\n267:             venue = None\n268: \n269:     overall = _empty_record()\n270:     home = _empty_record()\n271:     away = _empty_record()\n272:     by_competition: dict[str, dict] = defaultdict(_empty_record)\n273:     competitions_played: set = set()\n274: \n275:     for m in data.matches:\n276:         if comp and m.competition != comp:\n277:             continue\n278:         if season and m.season != season:\n279:             continue\n280:         if m.home_goals is None or m.away_goals is None:\n281:             continue\n282:         is_home = m.home_team == key\n283:         is_away = m.away_team == key\n284:         if not is_home and not is_away:\n285:             continue\n286:         competitions_played.add(m.competition)\n287:         gf = m.home_goals if is_home else m.away_goals\n288:         ga = m.away_goals if is_home else m.home_goals\n289:         win = gf > ga\n290:         draw = gf == ga\n291:         # venue bucket\n292:         if is_home:\n293:             bucket = home\n294:         else:\n295:             bucket = away\n296:         # venue filter (restrict which venue counts toward `overall`)\n297:         if venue in {\"home\", \"away\"} and venue != (\"home\" if is_home else \"away\"):\n298:             continue\n299:         for rec in (overall, bucket, by_competition[m.competition]):\n300:             rec[\"played\"] += 1\n301:             rec[\"goals_for\"] += gf\n302:             rec[\"goals_against\"] += ga\n303:             if win:\n304:                 rec[\"wins\"] += 1\n305:             elif draw:\n306:                 rec[\"draws\"] += 1\n307:             else:\n308:                 rec[\"losses\"] += 1\n309: \n310:     def _rate(rec):\n311:         return round(rec[\"wins\"] / rec[\"played\"], 4) if rec[\"played\"] else None\n312: \n313:     return {\n314:         \"team\": _display(key),\n315:         \"season\": season,\n316:         \"competition\": comp,\n317:         \"overall\": {**overall, \"win_rate\": _rate(overall)},\n318:         \"home\": {**home, \"win_rate\": _rate(home)},\n319:         \"away\": {**away, \"win_rate\": _rate(away)},\n320:         \"by_competition\": {\n321:             c: {**rec, \"win_rate\": _rate(rec)} for c, rec in by_competition.items()\n322:         },\n323:         \"competitions_played\": sorted(competitions_played),\n324:     }\n325: \n326: \n327: def list_teams(\n328:     competition: Optional[str] = None,\n329:     season: Optional[str] = None,\n330: ) -> list[str]:\n331:     \"\"\"List canonical display names of teams, optionally filtered.\"\"\"\n332:     data = _data()\n333:     comp = _competition_filter(competition)\n334:     if season:\n335:         season = str(season)\n336:     seen: set[str] = set()\n337:     out: list[str] = []\n338:     for m in data.matches:\n339:         if comp and m.competition != comp:\n340:             continue\n341:         if season and m.season != season:\n342:             continue\n343:         for key in (m.home_team, m.away_team):\n344:             if key and key not in seen:\n345:                 seen.add(key)\n346:                 out.append(_display(key))\n347:     out.sort(key=lambda s: s.lower())\n348:     return out\n349: \n350: \n351: # ---------------------------------------------------------------------------\n352: # 3. Player queries\n353: # ---------------------------------------------------------------------------\n354: def _player_to_dict(p, detail: bool = False) -> dict:\n355:     out = {\n356:         \"id\": p.id,\n357:         \"name\": p.name,\n358:         \"age\": p.age,\n359:         \"nationality\": p.nationality,\n360:         \"overall\": p.overall,\n361:         \"potential\": p.potential,\n362:         \"club\": p.club,\n363:         \"position\": p.position,\n364:         \"jersey_number\": p.jersey_number,\n365:         \"height\": p.height,\n366:         \"weight\": p.weight,\n367:     }\n368:     if detail:\n369:         out.update({\n370:             \"preferred_foot\": p.preferred_foot,\n371:             \"value\": p.value,\n372:             \"wage\": p.wage,\n373:             \"attributes\": {\n374:                 \"crossing\": p.crossing,\n375:                 \"finishing\": p.finishing,\n376:                 \"dribbling\": p.dribbling,\n377:                 \"shortpassing\": p.shortpassing,\n378:                 \"longshots\": p.longshots,\n379:                 \"defending\": p.defending,\n380:                 \"pace\": p.pace,\n381:                 \"shooting\": p.shooting,\n382:                 \"passing\": p.passing,\n383:                 \"physical\": p.physical,\n384:             },\n385:         })\n386:     return out\n387: \n388: \n389: def search_players(\n390:     name: Optional[str] = None,\n391:     nationality: Optional[str] = None,\n392:     club: Optional[str] = None,\n393:     position: Optional[str] = None,\n394:     min_overall: int = 0,\n395:     max_overall: Optional[int] = None,\n396:     limit: int = 25,\n397:     sort_by_overall: bool = True,\n398: ) -> list[dict]:\n399:     \"\"\"Search FIFA players by name substring / nationality / club / position.\"\"\"\n400:     data = _data()\n401:     name_q = (name or \"\").lower()\n402:     nat_q = (nationality or \"\").lower()\n403:     pos_q = (position or \"\").lower()\n404:     club_q = (club or \"\").lower()\n405:     club_key = resolve_team(club) if club else None\n406: \n407:     matches = []\n408:     for p in data.players:\n409:         if name_q and (not p.name or name_q not in p.name.lower()):\n410:             continue\n411:         if nat_q and (not p.nationality or nat_q not in p.nationality.lower()):\n412:             continue\n413:         if pos_q and (not p.position or pos_q not in p.position.upper()):\n414:             # position codes like ST, LW, CDM - allow substring on upper\n415:             if pos_q not in (p.position or \"\").upper():\n416:                 continue\n417:         if club_q:\n418:             # Match either FIFA club text OR canonical club key (cross-file).\n419:             if not (\n420:                 (p.club and club_q in p.club.lower())\n421:                 or (p.club_canonical and club_key and p.club_canonical == club_key)\n422:             ):\n423:                 continue\n424:         if p.overall is None:\n425:             continue\n426:         if min_overall and p.overall < min_overall:\n427:             continue\n428:         if max_overall is not None and p.overall > max_overall:\n429:             continue\n430:         matches.append(p)\n431: \n432:     if sort_by_overall:\n433:         matches.sort(key=lambda p: (-(p.overall or 0), p.name or \"\"))\n434:     else:\n435:         matches.sort(key=lambda p: (p.name or \"\"))\n436:     matches = matches[: max(0, limit)]\n437:     return [_player_to_dict(p, detail=False) for p in matches]\n438: \n439: \n440: def team_players(team: str, position: Optional[str] = None, limit: int = 50) -> list[dict]:\n441:     \"\"\"Return FIFA players whose club matches a soccer team (cross-file query).\"\"\"\n442:     return search_players(club=team, position=position, limit=limit)\n443: \n444: \n445: # ---------------------------------------------------------------------------\n446: # 4. Competition queries\n447: # ---------------------------------------------------------------------------\n448: def _compute_standings(data: SoccerData, competition: str, season: str) -> list[dict]:\n449:     \"\"\"Compute a league table from matches for one (competition, season).\"\"\"\n450:     rows: dict[str, dict] = {}\n451:     for m in data.matches:\n452:         if m.competition != competition or m.season != season:\n453:             continue\n454:         if m.home_goals is None or m.away_goals is None:\n455:             continue\n456:         for key in (m.home_team, m.away_team):\n457:             rows.setdefault(key, {\n458:                 \"team\": \"\", \"played\": 0, \"wins\": 0, \"draws\": 0, \"losses\": 0,\n459:                 \"goals_for\": 0, \"goals_against\": 0,\n460:             })\n461:         h, a = m.home_team, m.away_team\n462:         hg, ag = m.home_goals, m.away_goals\n463:         rows[h][\"played\"] += 1\n464:         rows[a][\"played\"] += 1\n465:         rows[h][\"goals_for\"] += hg\n466:         rows[h][\"goals_against\"] += ag\n467:         rows[a][\"goals_for\"] += ag\n468:         rows[a][\"goals_against\"] += hg\n469:         if hg > ag:\n470:             rows[h][\"wins\"] += 1\n471:             rows[a][\"losses\"] += 1\n472:         elif ag > hg:\n473:             rows[a][\"wins\"] += 1\n474:             rows[h][\"losses\"] += 1\n475:         else:\n476:             rows[h][\"draws\"] += 1\n477:             rows[a][\"draws\"] += 1\n478: \n479:     table = []\n480:     for key, r in rows.items():\n481:         pts = 3 * r[\"wins\"] + r[\"draws\"]\n482:         gd = r[\"goals_for\"] - r[\"goals_against\"]\n483:         table.append({\n484:             \"team\": _display(key),\n485:             \"played\": r[\"played\"],\n486:             \"wins\": r[\"wins\"],\n487:             \"draws\": r[\"draws\"],\n488:             \"losses\": r[\"losses\"],\n489:             \"goals_for\": r[\"goals_for\"],\n490:             \"goals_against\": r[\"goals_against\"],\n491:             \"goal_diff\": gd,\n492:             \"points\": pts,\n493:         })\n494:     table.sort(key=lambda t: (-t[\"points\"], -t[\"wins\"], -t[\"goal_diff\"], -t[\"goals_for\"], t[\"team\"]))\n495:     for i, row in enumerate(table, 1):\n496:         row[\"rank\"] = i\n497:     return table\n498: \n499: \n500: def standings(competition: str, season: str, top: Optional[int] = None) -> list[dict]:\n501:     \"\"\"Return a calculated league standings table.\n502: \n503:     Only supported for league-style competitions (Brasileirao Serie A/B/C);\n504:     cup competitions raise a ``ValueError`` because knockout formats do not\n505:     produce a meaningful league table from these datasets.\n506:     \"\"\"\n507:     data = _data()\n508:     comp = resolve_competition(competition)\n509:     if comp is None:\n510:         raise ValueError(f\"Unknown competition: {competition!r}\")\n511:     if comp in {COMP_COPA_BRASIL, COMP_LIBERTADORES}:\n512:         raise ValueError(\n513:             f\"Standings are only available for league competitions \"\n514:             f\"(Brasileirao Serie A/B/C), not for {comp}.\"\n515:         )\n516:     season = str(season)\n517:     available = data.seasons_for(comp)\n518:     if available and season not in available:\n519:         raise ValueError(\n520:             f\"Season {season} not found for {comp}. Available seasons: \"\n521:             f\"{', '.join(available)}\"\n522:         )\n523:     table = _compute_standings(data, comp, season)\n524:     if top is not None:\n525:         table = table[:top]\n526:     return table\n527: \n528: \n529: def champion(competition: str, season: str) -> dict:\n530:     \"\"\"Return the champion (table-topper) for a league competition + season.\"\"\"\n531:     table = standings(competition, season)\n532:     if not table:\n533:         raise ValueError(f\"No standings for {competition} {season}\")\n534:     top = table[0]\n535:     return {\n536:         \"competition\": resolve_competition(competition),\n537:         \"season\": str(season),\n538:         \"champion\": top[\"team\"],\n539:         \"points\": top[\"points\"],\n540:         \"record\": {\n541:             \"wins\": top[\"wins\"], \"draws\": top[\"draws\"], \"losses\": top[\"losses\"],\n542:             \"goals_for\": top[\"goals_for\"], \"goals_against\": top[\"goals_against\"],\n543:         },\n544:     }\n545: \n546: \n547: def relegated(competition: str, season: str, n: int = 4) -> list[dict]:\n548:     \"\"\"Return the bottom ``n`` teams of a league standings table.\"\"\"\n549:     table = standings(competition, season)\n550:     if not table:\n551:         return []\n552:     n = max(0, min(n, len(table)))\n553:     return list(reversed(table[-n:]))\n554: \n555: \n556: def list_competitions() -> list[dict]:\n557:     \"\"\"Summarise every competition available in the dataset.\"\"\"\n558:     data = _data()\n559:     out = []\n560:     for comp in data.competitions():\n561:         seasons = data.seasons_for(comp)\n562:         match_count = sum(1 for m in data.matches if m.competition == comp)\n563:         teams: set[str] = set()\n564:         for m in data.matches:\n565:             if m.competition == comp:\n566:                 teams.add(m.home_team)\n567:                 teams.add(m.away_team)\n568:         out.append({\n569:             \"competition\": comp,\n570:             \"seasons\": seasons,\n571:             \"match_count\": match_count,\n572:             \"team_count\": len(teams),\n573:         })\n574:     return out\n575: \n576: \n577: # ---------------------------------------------------------------------------\n578: # 5. Statistical analysis\n579: # ---------------------------------------------------------------------------\n580: def statistics(\n581:     competition: Optional[str] = None,\n582:     season: Optional[str] = None,\n583: ) -> dict:\n584:     \"\"\"Return aggregate goal / result statistics for a (competition, season).\"\"\"\n585:     data = _data()\n586:     comp = _competition_filter(competition)\n587:     if season:\n588:         season = str(season)\n589: \n590:     matches = []\n591:     for m in data.matches:\n592:         if comp and m.competition != comp:\n593:             continue\n594:         if season and m.season != season:\n595:             continue\n596:         if m.home_goals is None or m.away_goals is None:\n597:             continue\n598:         matches.append(m)\n599: \n600:     total = len(matches)\n601:     if total == 0:\n602:         return {\n603:             \"competition\": comp, \"season\": season, \"matches\": 0,\n604:             \"total_goals\": 0, \"avg_goals\": None, \"home_wins\": 0, \"away_wins\": 0,\n605:             \"draws\": 0, \"home_win_rate\": None, \"avg_home_goals\": None,\n606:             \"avg_away_goals\": None,\n607:         }\n608:     total_goals = sum(m.home_goals + m.away_goals for m in matches)\n609:     home_wins = sum(1 for m in matches if m.home_goals > m.away_goals)\n610:     away_wins = sum(1 for m in matches if m.away_goals > m.home_goals)\n611:     draws = sum(1 for m in matches if m.home_goals == m.away_goals)\n612:     home_goals = sum(m.home_goals for m in matches)\n613:     away_goals = sum(m.away_goals for m in matches)\n614:     return {\n615:         \"competition\": comp,\n616:         \"season\": season,\n617:         \"matches\": total,\n618:         \"total_goals\": total_goals,\n619:         \"avg_goals\": round(total_goals / total, 3),\n620:         \"home_wins\": home_wins,\n621:         \"away_wins\": away_wins,\n622:         \"draws\": draws,\n623:         \"home_win_rate\": round(home_wins / total, 4),\n624:         \"away_win_rate\": round(away_wins / total, 4),\n625:         \"draw_rate\": round(draws / total, 4),\n626:         \"avg_home_goals\": round(home_goals / total, 3),\n627:         \"avg_away_goals\": round(away_goals / total, 3),\n628:     }\n629: \n630: \n631: def biggest_wins(\n632:     competition: Optional[str] = None,\n633:     season: Optional[str] = None,\n634:     limit: int = 10,\n635: ) -> list[dict]:\n636:     \"\"\"Return the largest victory margins in the dataset.\"\"\"\n637:     data = _data()\n638:     comp = _competition_filter(competition)\n639:     if season:\n640:         season = str(season)\n641: \n642:     rows = []\n643:     for m in data.matches:\n644:         if comp and m.competition != comp:\n645:             continue\n646:         if season and m.season != season:\n647:             continue\n648:         if m.home_goals is None or m.away_goals is None:\n649:             continue\n650:         margin = m.home_goals - m.away_goals\n651:         rows.append((abs(margin), margin, m))\n652:     rows.sort(key=lambda t: (-t[0], t[2].date or \"\", t[2].competition))\n653:     rows = rows[: max(0, limit)]\n654:     out = []\n655:     for _abs, signed, m in rows:\n656:         out.append({\n657:             \"date\": m.date,\n658:             \"season\": m.season,\n659:             \"competition\": m.competition,\n660:             \"home_team\": m.home_display,\n661:             \"away_team\": m.away_display,\n662:             \"home_goals\": m.home_goals,\n663:             \"away_goals\": m.away_goals,\n664:             \"score\": f\"{m.home_goals}-{m.away_goals}\",\n665:             \"margin\": abs(signed),\n666:             \"winner\": m.home_display if signed > 0 else m.away_display,\n667:         })\n668:     return out\n669: \n670: \n671: def match_stats(\n672:     team: Optional[str] = None,\n673:     opponent: Optional[str] = None,\n674:     competition: Optional[str] = None,\n675:     season: Optional[str] = None,\n676:     limit: int = 25,\n677: ) -> list[dict]:\n678:     \"\"\"Return detailed per-match statistics (corners/shots/attacks) from the\n679:     BR-Football-Dataset for matches matching the criteria.\"\"\"\n680:     data = _data()\n681:     comp = _competition_filter(competition)\n682:     team_key = resolve_team(team) if team else None\n683:     opp_key = resolve_team(opponent) if opponent else None\n684:     if season:\n685:         season = str(season)\n686: \n687:     results = []\n688:     for m in data.stats_matches:\n689:         if comp and m.competition != comp:\n690:             continue\n691:         if season and m.season != season:\n692:             continue\n693:         if team_key and m.home_team != team_key and m.away_team != team_key:\n694:             continue\n695:         if opp_key and m.home_team != opp_key and m.away_team != opp_key:\n696:             continue\n697:         results.append(m)\n698:     results = _sort_matches(results, limit)\n699:     out = []\n700:     for m in results:\n701:         out.append({\n702:             \"date\": m.date,\n703:             \"season\": m.season,\n704:             \"competition\": m.competition,\n705:             \"home_team\": m.home_display,\n706:             \"away_team\": m.away_display,\n707:             \"home_goals\": m.home_goals,\n708:             \"away_goals\": m.away_goals,\n709:             \"home_corners\": m.home_corners,\n710:             \"away_corners\": m.away_corners,\n711:             \"total_corners\": (\n712:                 (m.home_corners or 0) + (m.away_corners or 0)\n713:                 if m.home_corners is not None or m.away_corners is not None\n714:                 else None\n715:             ),\n716:             \"home_shots\": m.home_shots,\n717:             \"away_shots\": m.away_shots,\n718:             \"home_attacks\": m.home_attacks,\n719:             \"away_attacks\": m.away_attacks,\n720:             \"ht_result\": m.ht_result,\n721:             \"at_result\": m.at_result,\n722:             \"source\": m.source,\n723:         })\n724:     return out\n\n(End of file - total 724 lines)\n</content>","metadata":{"preview":"\"\"\"\nContext\n=======\nBrazilian Soccer MCP Server - query layer.\n\nPart of the ``soccer_mcp`` package.  Pure-Python functions that answer the\nfive required query categories described in TASK.md:\n\n    1. Match queries      - find_matches, head_to_head\n    2. Team queries       - team_stats, list_teams\n    3. Player queries     - search_players, team_players\n    4. Competition queries- standings, champion, relegated, list_competitions\n    5. Statistical analysis- statistics, biggest_wins, match_stats\n\nEvery public function takes plain Python arguments and returns JSON-serialisable\ndicts / lists so they can be exposed directly as MCP tools.  A team name given\nby the caller is resolved to a canonical key through the shared\n:class:`soccer_mcp.normalize.TeamNormalizer`; team name variations\n(\"Palmeiras-SP\", \"Palmeiras\", \"Sao Paulo-SP\" vs \"Sao Paulo\") are therefore\nmatched consistently across all six datasets (see data_loader.py for the","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/soccer_mcp/queries.py","text":"\"\"\"\nContext\n=======\nBrazilian Soccer MCP Server - query layer.\n\nPart of the ``soccer_mcp`` package.  Pure-Python functions that answer the\nfive required query categories described in TASK.md:\n\n    1. Match queries      - find_matches, head_to_head\n    2. Team queries       - team_stats, list_teams\n    3. Player queries     - search_players, team_players\n    4. Competition queries- standings, champion, relegated, list_competitions\n    5. Statistical analysis- statistics, biggest_wins, match_stats\n\nEvery public function takes plain Python arguments and returns JSON-serialisable\ndicts / lists so they can be exposed directly as MCP tools.  A team name given\nby the caller is resolved to a canonical key through the shared\n:class:`soccer_mcp.normalize.TeamNormalizer`; team name variations\n(\"Palmeiras-SP\", \"Palmeiras\", \"Sao Paulo-SP\" vs \"Sao Paulo\") are therefore\nmatched consistently across all six datasets (see data_loader.py for the\nsource-priority merge that prevents double counting).\n\nAll match-based aggregates operate on the source-priority-selected ``matches``\ncollection (one clean record per real-world match) unless noted otherwise.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections import defaultdict\nfrom typing import Optional\n\nfrom .data_loader import (\n    COMP_BRASILEIRAO_A,\n    COMP_BRASILEIRAO_B,\n    COMP_COPA_BRASIL,\n    COMP_LIBERTADORES,\n    SoccerData,\n    get_data,\n    resolve_competition,\n)\n\n__all__ = [\n    \"find_matches\",\n    \"head_to_head\",\n    \"team_stats\",\n    \"list_teams\",\n    \"search_players\",\n    \"team_players\",\n    \"standings\",\n    \"champion\",\n    \"relegated\",\n    \"list_competitions\",\n    \"statistics\",\n    \"biggest_wins\",\n    \"match_stats\",\n    \"resolve_team\",\n]\n\n_LEAGUE_COMPETITIONS = {COMP_BRASILEIRAO_A, COMP_BRASILEIRAO_B}\n\n\n# ---------------------------------------------------------------------------\n# Helpers\n# ---------------------------------------------------------------------------\ndef _data() -> SoccerData:\n    return get_data()\n\n\ndef resolve_team(name: str) -> Optional[str]:\n    \"\"\"Resolve a user-supplied team/club name to a canonical key.\"\"\"\n    if not name:\n        return None\n    return _data().normalizer.canonical(name)\n\n\ndef _display(key: str) -> str:\n    return _data().team_display.get(key) or _data().normalizer.display(key) or key\n\n\ndef _maybe_date_in_range(date: Optional[str], date_from: Optional[str], date_to: Optional[str]) -> bool:\n    if date is None:\n        # Unknown dates only pass when no range was specified.\n        return date_from is None and date_to is None\n    if date_from and date < date_from:\n        return False\n    if date_to and date > date_to:\n        return False\n    return True\n\n\ndef _competition_filter(competition: Optional[str]) -> Optional[str]:\n    return resolve_competition(competition)\n\n\ndef _match_to_dict(m) -> dict:\n    out = {\n        \"date\": m.date,\n        \"season\": m.season,\n        \"competition\": m.competition,\n        \"round\": m.round_or_stage,\n        \"home_team\": m.home_display,\n        \"away_team\": m.away_display,\n        \"home_goals\": m.home_goals,\n        \"away_goals\": m.away_goals,\n        \"score\": (\n            f\"{m.home_goals}-{m.away_goals}\"\n            if m.home_goals is not None and m.away_goals is not None\n            else None\n        ),\n        \"source\": m.source,\n    }\n    return out\n\n\ndef _sort_matches(matches: list, limit: Optional[int]) -> list:\n    ordered = sorted(matches, key=lambda m: (m.date or \"\", m.competition))\n    if limit is not None:\n        ordered = ordered[:limit]\n    return ordered\n\n\n# ---------------------------------------------------------------------------\n# 1. Match queries\n# ---------------------------------------------------------------------------\ndef find_matches(\n    team: Optional[str] = None,\n    opponent: Optional[str] = None,\n    competition: Optional[str] = None,\n    season: Optional[str] = None,\n    date_from: Optional[str] = None,\n    date_to: Optional[str] = None,\n    stage: Optional[str] = None,\n    venue: Optional[str] = None,\n    limit: int = 50,\n) -> list[dict]:\n    \"\"\"Find matches matching the given criteria.\n\n    ``venue`` may be \"home\", \"away\" or \"either\" (default) for ``team``.\n    Dates are ISO ``YYYY-MM-DD``; ``date_from``/``date_to`` are inclusive.\n    \"\"\"\n    data = _data()\n    comp = _competition_filter(competition)\n    team_key = resolve_team(team) if team else None\n    opp_key = resolve_team(opponent) if opponent else None\n    if venue:\n        venue = venue.lower()\n        if venue not in {\"home\", \"away\", \"either\", \"any\"}:\n            venue = \"either\"\n    venue = venue or \"either\"\n    if venue == \"any\":\n        venue = \"either\"\n\n    results = []\n    for m in data.matches:\n        if comp and m.competition != comp:\n            continue\n        if season and m.season != str(season):\n            continue\n        if not _maybe_date_in_range(m.date, date_from, date_to):\n            continue\n        if stage:\n            rs = (m.round_or_stage or \"\").lower()\n            if stage.lower() not in rs:\n                continue\n        if team_key:\n            if venue == \"home\":\n                if m.home_team != team_key:\n                    continue\n                if opp_key and m.away_team != opp_key:\n                    continue\n            elif venue == \"away\":\n                if m.away_team != team_key:\n                    continue\n                if opp_key and m.home_team != opp_key:\n                    continue\n            else:  # either\n                if m.home_team == team_key:\n                    if opp_key and m.away_team != opp_key:\n                        continue\n                elif m.away_team == team_key:\n                    if opp_key and m.home_team != opp_key:\n                        continue\n                else:\n                    continue\n        elif opp_key:\n            if m.home_team != opp_key and m.away_team != opp_key:\n                continue\n        results.append(m)\n\n    ordered = _sort_matches(results, limit)\n    return [_match_to_dict(m) for m in ordered]\n\n\ndef head_to_head(\n    team_a: str,\n    team_b: str,\n    competition: Optional[str] = None,\n    limit: int = 100,\n) -> dict:\n    \"\"\"Return the head-to-head record between two teams.\"\"\"\n    data = _data()\n    a_key = resolve_team(team_a)\n    b_key = resolve_team(team_b)\n    comp = _competition_filter(competition)\n\n    matches = []\n    a_wins = b_wins = draws = a_goals = b_goals = 0\n    for m in data.matches:\n        if comp and m.competition != comp:\n            continue\n        if {m.home_team, m.away_team} != {a_key, b_key}:\n            continue\n        if m.home_goals is None or m.away_goals is None:\n            continue\n        matches.append(m)\n        # Determine each team's goals.\n        if m.home_team == a_key:\n            ag, bg = m.home_goals, m.away_goals\n        else:\n            ag, bg = m.away_goals, m.home_goals\n        a_goals += ag\n        b_goals += bg\n        if ag > bg:\n            a_wins += 1\n        elif bg > ag:\n            b_wins += 1\n        else:\n            draws += 1\n\n    ordered = _sort_matches(matches, limit)\n    return {\n        \"team_a\": _display(a_key),\n        \"team_b\": _display(b_key),\n        \"matches_played\": len(matches),\n        \"team_a_wins\": a_wins,\n        \"team_b_wins\": b_wins,\n        \"draws\": draws,\n        \"team_a_goals\": a_goals,\n        \"team_b_goals\": b_goals,\n        \"matches\": [_match_to_dict(m) for m in ordered],\n    }\n\n\n# ---------------------------------------------------------------------------\n# 2. Team queries\n# ---------------------------------------------------------------------------\ndef _empty_record() -> dict:\n    return {\"played\": 0, \"wins\": 0, \"draws\": 0, \"losses\": 0,\n            \"goals_for\": 0, \"goals_against\": 0}\n\n\ndef team_stats(\n    team: str,\n    season: Optional[str] = None,\n    competition: Optional[str] = None,\n    venue: Optional[str] = None,\n) -> dict:\n    \"\"\"Return win/draw/loss and goal records for a team, optionally split by venue.\"\"\"\n    data = _data()\n    key = resolve_team(team)\n    comp = _competition_filter(competition)\n    if season:\n        season = str(season)\n    if venue:\n        venue = venue.lower()\n        if venue not in {\"home\", \"away\", \"overall\", \"either\", \"any\"}:\n            venue = None\n\n    overall = _empty_record()\n    home = _empty_record()\n    away = _empty_record()\n    by_competition: dict[str, dict] = defaultdict(_empty_record)\n    competitions_played: set = set()\n\n    for m in data.matches:\n        if comp and m.competition != comp:\n            continue\n        if season and m.season != season:\n            continue\n        if m.home_goals is None or m.away_goals is None:\n            continue\n        is_home = m.home_team == key\n        is_away = m.away_team == key\n        if not is_home and not is_away:\n            continue\n        competitions_played.add(m.competition)\n        gf = m.home_goals if is_home else m.away_goals\n        ga = m.away_goals if is_home else m.home_goals\n        win = gf > ga\n        draw = gf == ga\n        # venue bucket\n        if is_home:\n            bucket = home\n        else:\n            bucket = away\n        # venue filter (restrict which venue counts toward `overall`)\n        if venue in {\"home\", \"away\"} and venue != (\"home\" if is_home else \"away\"):\n            continue\n        for rec in (overall, bucket, by_competition[m.competition]):\n            rec[\"played\"] += 1\n            rec[\"goals_for\"] += gf\n            rec[\"goals_against\"] += ga\n            if win:\n                rec[\"wins\"] += 1\n            elif draw:\n                rec[\"draws\"] += 1\n            else:\n                rec[\"losses\"] += 1\n\n    def _rate(rec):\n        return round(rec[\"wins\"] / rec[\"played\"], 4) if rec[\"played\"] else None\n\n    return {\n        \"team\": _display(key),\n        \"season\": season,\n        \"competition\": comp,\n        \"overall\": {**overall, \"win_rate\": _rate(overall)},\n        \"home\": {**home, \"win_rate\": _rate(home)},\n        \"away\": {**away, \"win_rate\": _rate(away)},\n        \"by_competition\": {\n            c: {**rec, \"win_rate\": _rate(rec)} for c, rec in by_competition.items()\n        },\n        \"competitions_played\": sorted(competitions_played),\n    }\n\n\ndef list_teams(\n    competition: Optional[str] = None,\n    season: Optional[str] = None,\n) -> list[str]:\n    \"\"\"List canonical display names of teams, optionally filtered.\"\"\"\n    data = _data()\n    comp = _competition_filter(competition)\n    if season:\n        season = str(season)\n    seen: set[str] = set()\n    out: list[str] = []\n    for m in data.matches:\n        if comp and m.competition != comp:\n            continue\n        if season and m.season != season:\n            continue\n        for key in (m.home_team, m.away_team):\n            if key and key not in seen:\n                seen.add(key)\n                out.append(_display(key))\n    out.sort(key=lambda s: s.lower())\n    return out\n\n\n# ---------------------------------------------------------------------------\n# 3. Player queries\n# ---------------------------------------------------------------------------\ndef _player_to_dict(p, detail: bool = False) -> dict:\n    out = {\n        \"id\": p.id,\n        \"name\": p.name,\n        \"age\": p.age,\n        \"nationality\": p.nationality,\n        \"overall\": p.overall,\n        \"potential\": p.potential,\n        \"club\": p.club,\n        \"position\": p.position,\n        \"jersey_number\": p.jersey_number,\n        \"height\": p.height,\n        \"weight\": p.weight,\n    }\n    if detail:\n        out.update({\n            \"preferred_foot\": p.preferred_foot,\n            \"value\": p.value,\n            \"wage\": p.wage,\n            \"attributes\": {\n                \"crossing\": p.crossing,\n                \"finishing\": p.finishing,\n                \"dribbling\": p.dribbling,\n                \"shortpassing\": p.shortpassing,\n                \"longshots\": p.longshots,\n                \"defending\": p.defending,\n                \"pace\": p.pace,\n                \"shooting\": p.shooting,\n                \"passing\": p.passing,\n                \"physical\": p.physical,\n            },\n        })\n    return out\n\n\ndef search_players(\n    name: Optional[str] = None,\n    nationality: Optional[str] = None,\n    club: Optional[str] = None,\n    position: Optional[str] = None,\n    min_overall: int = 0,\n    max_overall: Optional[int] = None,\n    limit: int = 25,\n    sort_by_overall: bool = True,\n) -> list[dict]:\n    \"\"\"Search FIFA players by name substring / nationality / club / position.\"\"\"\n    data = _data()\n    name_q = (name or \"\").lower()\n    nat_q = (nationality or \"\").lower()\n    pos_q = (position or \"\").lower()\n    club_q = (club or \"\").lower()\n    club_key = resolve_team(club) if club else None\n\n    matches = []\n    for p in data.players:\n        if name_q and (not p.name or name_q not in p.name.lower()):\n            continue\n        if nat_q and (not p.nationality or nat_q not in p.nationality.lower()):\n            continue\n        if pos_q and (not p.position or pos_q not in p.position.upper()):\n            # position codes like ST, LW, CDM - allow substring on upper\n            if pos_q not in (p.position or \"\").upper():\n                continue\n        if club_q:\n            # Match either FIFA club text OR canonical club key (cross-file).\n            if not (\n                (p.club and club_q in p.club.lower())\n                or (p.club_canonical and club_key and p.club_canonical == club_key)\n            ):\n                continue\n        if p.overall is None:\n            continue\n        if min_overall and p.overall < min_overall:\n            continue\n        if max_overall is not None and p.overall > max_overall:\n            continue\n        matches.append(p)\n\n    if sort_by_overall:\n        matches.sort(key=lambda p: (-(p.overall or 0), p.name or \"\"))\n    else:\n        matches.sort(key=lambda p: (p.name or \"\"))\n    matches = matches[: max(0, limit)]\n    return [_player_to_dict(p, detail=False) for p in matches]\n\n\ndef team_players(team: str, position: Optional[str] = None, limit: int = 50) -> list[dict]:\n    \"\"\"Return FIFA players whose club matches a soccer team (cross-file query).\"\"\"\n    return search_players(club=team, position=position, limit=limit)\n\n\n# ---------------------------------------------------------------------------\n# 4. Competition queries\n# ---------------------------------------------------------------------------\ndef _compute_standings(data: SoccerData, competition: str, season: str) -> list[dict]:\n    \"\"\"Compute a league table from matches for one (competition, season).\"\"\"\n    rows: dict[str, dict] = {}\n    for m in data.matches:\n        if m.competition != competition or m.season != season:\n            continue\n        if m.home_goals is None or m.away_goals is None:\n            continue\n        for key in (m.home_team, m.away_team):\n            rows.setdefault(key, {\n                \"team\": \"\", \"played\": 0, \"wins\": 0, \"draws\": 0, \"losses\": 0,\n                \"goals_for\": 0, \"goals_against\": 0,\n            })\n        h, a = m.home_team, m.away_team\n        hg, ag = m.home_goals, m.away_goals\n        rows[h][\"played\"] += 1\n        rows[a][\"played\"] += 1\n        rows[h][\"goals_for\"] += hg\n        rows[h][\"goals_against\"] += ag\n        rows[a][\"goals_for\"] += ag\n        rows[a][\"goals_against\"] += hg\n        if hg > ag:\n            rows[h][\"wins\"] += 1\n            rows[a][\"losses\"] += 1\n        elif ag > hg:\n            rows[a][\"wins\"] += 1\n            rows[h][\"losses\"] += 1\n        else:\n            rows[h][\"draws\"] += 1\n            rows[a][\"draws\"] += 1\n\n    table = []\n    for key, r in rows.items():\n        pts = 3 * r[\"wins\"] + r[\"draws\"]\n        gd = r[\"goals_for\"] - r[\"goals_against\"]\n        table.append({\n            \"team\": _display(key),\n            \"played\": r[\"played\"],\n            \"wins\": r[\"wins\"],\n            \"draws\": r[\"draws\"],\n            \"losses\": r[\"losses\"],\n            \"goals_for\": r[\"goals_for\"],\n            \"goals_against\": r[\"goals_against\"],\n            \"goal_diff\": gd,\n            \"points\": pts,\n        })\n    table.sort(key=lambda t: (-t[\"points\"], -t[\"wins\"], -t[\"goal_diff\"], -t[\"goals_for\"], t[\"team\"]))\n    for i, row in enumerate(table, 1):\n        row[\"rank\"] = i\n    return table\n\n\ndef standings(competition: str, season: str, top: Optional[int] = None) -> list[dict]:\n    \"\"\"Return a calculated league standings table.\n\n    Only supported for league-style competitions (Brasileirao Serie A/B/C);\n    cup competitions raise a ``ValueError`` because knockout formats do not\n    produce a meaningful league table from these datasets.\n    \"\"\"\n    data = _data()\n    comp = resolve_competition(competition)\n    if comp is None:\n        raise ValueError(f\"Unknown competition: {competition!r}\")\n    if comp in {COMP_COPA_BRASIL, COMP_LIBERTADORES}:\n        raise ValueError(\n            f\"Standings are only available for league competitions \"\n            f\"(Brasileirao Serie A/B/C), not for {comp}.\"\n        )\n    season = str(season)\n    available = data.seasons_for(comp)\n    if available and season not in available:\n        raise ValueError(\n            f\"Season {season} not found for {comp}. Available seasons: \"\n            f\"{', '.join(available)}\"\n        )\n    table = _compute_standings(data, comp, season)\n    if top is not None:\n        table = table[:top]\n    return table\n\n\ndef champion(competition: str, season: str) -> dict:\n    \"\"\"Return the champion (table-topper) for a league competition + season.\"\"\"\n    table = standings(competition, season)\n    if not table:\n        raise ValueError(f\"No standings for {competition} {season}\")\n    top = table[0]\n    return {\n        \"competition\": resolve_competition(competition),\n        \"season\": str(season),\n        \"champion\": top[\"team\"],\n        \"points\": top[\"points\"],\n        \"record\": {\n            \"wins\": top[\"wins\"], \"draws\": top[\"draws\"], \"losses\": top[\"losses\"],\n            \"goals_for\": top[\"goals_for\"], \"goals_against\": top[\"goals_against\"],\n        },\n    }\n\n\ndef relegated(competition: str, season: str, n: int = 4) -> list[dict]:\n    \"\"\"Return the bottom ``n`` teams of a league standings table.\"\"\"\n    table = standings(competition, season)\n    if not table:\n        return []\n    n = max(0, min(n, len(table)))\n    return list(reversed(table[-n:]))\n\n\ndef list_competitions() -> list[dict]:\n    \"\"\"Summarise every competition available in the dataset.\"\"\"\n    data = _data()\n    out = []\n    for comp in data.competitions():\n        seasons = data.seasons_for(comp)\n        match_count = sum(1 for m in data.matches if m.competition == comp)\n        teams: set[str] = set()\n        for m in data.matches:\n            if m.competition == comp:\n                teams.add(m.home_team)\n                teams.add(m.away_team)\n        out.append({\n            \"competition\": comp,\n            \"seasons\": seasons,\n            \"match_count\": match_count,\n            \"team_count\": len(teams),\n        })\n    return out\n\n\n# ---------------------------------------------------------------------------\n# 5. Statistical analysis\n# ---------------------------------------------------------------------------\ndef statistics(\n    competition: Optional[str] = None,\n    season: Optional[str] = None,\n) -> dict:\n    \"\"\"Return aggregate goal / result statistics for a (competition, season).\"\"\"\n    data = _data()\n    comp = _competition_filter(competition)\n    if season:\n        season = str(season)\n\n    matches = []\n    for m in data.matches:\n        if comp and m.competition != comp:\n            continue\n        if season and m.season != season:\n            continue\n        if m.home_goals is None or m.away_goals is None:\n            continue\n        matches.append(m)\n\n    total = len(matches)\n    if total == 0:\n        return {\n            \"competition\": comp, \"season\": season, \"matches\": 0,\n            \"total_goals\": 0, \"avg_goals\": None, \"home_wins\": 0, \"away_wins\": 0,\n            \"draws\": 0, \"home_win_rate\": None, \"avg_home_goals\": None,\n            \"avg_away_goals\": None,\n        }\n    total_goals = sum(m.home_goals + m.away_goals for m in matches)\n    home_wins = sum(1 for m in matches if m.home_goals > m.away_goals)\n    away_wins = sum(1 for m in matches if m.away_goals > m.home_goals)\n    draws = sum(1 for m in matches if m.home_goals == m.away_goals)\n    home_goals = sum(m.home_goals for m in matches)\n    away_goals = sum(m.away_goals for m in matches)\n    return {\n        \"competition\": comp,\n        \"season\": season,\n        \"matches\": total,\n        \"total_goals\": total_goals,\n        \"avg_goals\": round(total_goals / total, 3),\n        \"home_wins\": home_wins,\n        \"away_wins\": away_wins,\n        \"draws\": draws,\n        \"home_win_rate\": round(home_wins / total, 4),\n        \"away_win_rate\": round(away_wins / total, 4),\n        \"draw_rate\": round(draws / total, 4),\n        \"avg_home_goals\": round(home_goals / total, 3),\n        \"avg_away_goals\": round(away_goals / total, 3),\n    }\n\n\ndef biggest_wins(\n    competition: Optional[str] = None,\n    season: Optional[str] = None,\n    limit: int = 10,\n) -> list[dict]:\n    \"\"\"Return the largest victory margins in the dataset.\"\"\"\n    data = _data()\n    comp = _competition_filter(competition)\n    if season:\n        season = str(season)\n\n    rows = []\n    for m in data.matches:\n        if comp and m.competition != comp:\n            continue\n        if season and m.season != season:\n            continue\n        if m.home_goals is None or m.away_goals is None:\n            continue\n        margin = m.home_goals - m.away_goals\n        rows.append((abs(margin), margin, m))\n    rows.sort(key=lambda t: (-t[0], t[2].date or \"\", t[2].competition))\n    rows = rows[: max(0, limit)]\n    out = []\n    for _abs, signed, m in rows:\n        out.append({\n            \"date\": m.date,\n            \"season\": m.season,\n            \"competition\": m.competition,\n            \"home_team\": m.home_display,\n            \"away_team\": m.away_display,\n            \"home_goals\": m.home_goals,\n            \"away_goals\": m.away_goals,\n            \"score\": f\"{m.home_goals}-{m.away_goals}\",\n            \"margin\": abs(signed),\n            \"winner\": m.home_display if signed > 0 else m.away_display,\n        })\n    return out\n\n\ndef match_stats(\n    team: Optional[str] = None,\n    opponent: Optional[str] = None,\n    competition: Optional[str] = None,\n    season: Optional[str] = None,\n    limit: int = 25,\n) -> list[dict]:\n    \"\"\"Return detailed per-match statistics (corners/shots/attacks) from the\n    BR-Football-Dataset for matches matching the criteria.\"\"\"\n    data = _data()\n    comp = _competition_filter(competition)\n    team_key = resolve_team(team) if team else None\n    opp_key = resolve_team(opponent) if opponent else None\n    if season:\n        season = str(season)\n\n    results = []\n    for m in data.stats_matches:\n        if comp and m.competition != comp:\n            continue\n        if season and m.season != season:\n            continue\n        if team_key and m.home_team != team_key and m.away_team != team_key:\n            continue\n        if opp_key and m.home_team != opp_key and m.away_team != opp_key:\n            continue\n        results.append(m)\n    results = _sort_matches(results, limit)\n    out = []\n    for m in results:\n        out.append({\n            \"date\": m.date,\n            \"season\": m.season,\n            \"competition\": m.competition,\n            \"home_team\": m.home_display,\n            \"away_team\": m.away_display,\n            \"home_goals\": m.home_goals,\n            \"away_goals\": m.away_goals,\n            \"home_corners\": m.home_corners,\n            \"away_corners\": m.away_corners,\n            \"total_corners\": (\n                (m.home_corners or 0) + (m.away_corners or 0)\n                if m.home_corners is not None or m.away_corners is not None\n                else None\n            ),\n            \"home_shots\": m.home_shots,\n            \"away_shots\": m.away_shots,\n            \"home_attacks\": m.home_attacks,\n            \"away_attacks\": m.away_attacks,\n            \"ht_result\": m.ht_result,\n            \"at_result\": m.at_result,\n            \"source\": m.source,\n        })\n    return out","lineStart":1,"lineEnd":724,"totalLines":724,"truncated":false}},"title":"soccer_mcp/queries.py","time":{"start":1788373772583,"end":1788373772610}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_0636228f0001rCMfrGgUfUXHGj","sessionID":"ses_f9c9e1f2effeUE9mG9h5hx4Ni7","messageID":"msg_06362271e001Fi1ZsKqWSBTs1V"}}
{"type":"step_finish","timestamp":1788373772709,"sessionID":"ses_f9c9e1f2effeUE9mG9h5hx4Ni7","part":{"id":"prt_06362299f001N15ZAsjecZnr3X","reason":"tool-calls","snapshot":"65c1d8804d5300be85feee883b0e9b247bb532d5","messageID":"msg_06362271e001Fi1ZsKqWSBTs1V","sessionID":"ses_f9c9e1f2effeUE9mG9h5hx4Ni7","type":"step-finish","tokens":{"total":20491,"input":3001,"output":18,"reasoning":0,"cache":{"write":0,"read":17472}},"cost":0.0063292044}}
{"type":"step_start","timestamp":1788373774782,"sessionID":"ses_f9c9e1f2effeUE9mG9h5hx4Ni7","part":{"id":"prt_0636231b5001L0Mo54bHXz6SxY","messageID":"msg_0636229f4001lITVhyePQuC67Y","sessionID":"ses_f9c9e1f2effeUE9mG9h5hx4Ni7","snapshot":"91cae1a0436be0015990d2356363a5b40fd40ffa","type":"step-start"}}
{"type":"tool_use","timestamp":1788373774862,"sessionID":"ses_f9c9e1f2effeUE9mG9h5hx4Ni7","part":{"type":"tool","tool":"read","callID":"call_01a0636231ac78b3a4a2dce9","state":{"status":"completed","input":{"filePath":"/workspace/soccer_mcp/data_loader.py"},"output":"<path>/workspace/soccer_mcp/data_loader.py</path>\n<type>file</type>\n<content>\n1: \"\"\"\n2: Context\n3: =======\n4: Brazilian Soccer MCP Server - data loader.\n5: \n6: Part of the ``soccer_mcp`` package.  Loads the six Kaggle CSV datasets from\n7: ``data/kaggle/`` into an in-memory :class:`SoccerData` object that the query\n8: layer (:mod:`soccer_mcp.queries`) and the MCP server (:mod:`soccer_mcp.server`)\n9: operate on.\n10: \n11: Datasets loaded\n12: ---------------\n13: 1. ``Brasileirao_Matches.csv``      - Brasileirao Serie A (2012-2022)\n14: 2. ``novo_campeonato_brasileiro.csv`` - Brasileirao Serie A historical (2003-2019)\n15: 3. ``BR-Football-Dataset.csv``      - Serie A/B/C + Copa do Brasil (2014-2023, rich stats)\n16: 4. ``Brazilian_Cup_Matches.csv``    - Copa do Brasil (2012-2021)\n17: 5. ``Libertadores_Matches.csv``     - Copa Libertadores (2013-2022)\n18: 6. ``fifa_data.csv``                - FIFA player database (~18k players)\n19: \n20: Source-priority merge\n21: ---------------------\n22: The two Brasileirao files and the BR-Football-Dataset overlap for many seasons.\n23: To avoid double counting in standings / head-to-head / team statistics the\n24: loader tags every match with a per-competition *source rank* and, for each\n25: (competition, season), keeps only the rows from the single best (lowest-rank)\n26: source.  Lower rank == higher priority:\n27: \n28:     Brasileirao Serie A : Brasileirao_Matches (0) > BR-Football-Dataset (1) > historical (2)\n29:     Brasileirao Serie B : BR-Football-Dataset (0)\n30:     Brasileirao Serie C : BR-Football-Dataset (0)\n31:     Copa do Brasil       : Brazilian_Cup_Matches (0) > BR-Football-Dataset (1)\n32:     Copa Libertadores    : Libertadores_Matches (0)\n33: \n34: This yields one clean record per real-world match for league-style\n35: calculations while still letting the BR-Football-Dataset supply the only data\n36: for Serie B/C, the 2023 Serie A season and the 2022-2023 Copa do Brasil, plus\n37: detailed corner/shot/attack statistics via the separate ``stats_matches``\n38: collection (queried by ``match_stats``).\n39: \n40: Team names are canonicalised with :class:`soccer_mcp.normalize.TeamNormalizer`\n41: so that \"Sao Paulo-SP\", \"Sao Paulo\" and \"Sao Paulo\" all resolve to one entity.\n42: Dates are normalised to ISO.  Goals are normalised to int.\n43: \n44: The loader is lazy and cached: the first call to :func:`get_data` parses the\n45: CSVs once and returns a process-wide singleton.\n46: \"\"\"\n47: \n48: from __future__ import annotations\n49: \n50: import csv\n51: import os\n52: from collections import defaultdict\n53: from dataclasses import dataclass, field\n54: from functools import lru_cache\n55: from typing import Optional\n56: \n57: from .normalize import TeamNormalizer, parse_date, to_int_goal\n58: \n59: # ---------------------------------------------------------------------------\n60: # Canonical competition names and the user-facing aliases that map to them.\n61: # ---------------------------------------------------------------------------\n62: COMP_BRASILEIRAO_A = \"Brasileirao Serie A\"\n63: COMP_BRASILEIRAO_B = \"Brasileirao Serie B\"\n64: COMP_BRASILEIRAO_C = \"Brasileirao Serie C\"\n65: COMP_COPA_BRASIL = \"Copa do Brasil\"\n66: COMP_LIBERTADORES = \"Copa Libertadores\"\n67: \n68: ALL_COMPETITIONS = (\n69:     COMP_BRASILEIRAO_A,\n70:     COMP_BRASILEIRAO_B,\n71:     COMP_BRASILEIRAO_C,\n72:     COMP_COPA_BRASIL,\n73:     COMP_LIBERTADORES,\n74: )\n75: \n76: # Aliases (lowercased, alphanumeric) accepted in query parameters.\n77: COMPETITION_ALIASES: dict[str, str] = {\n78:     \"brasileiraoa\": COMP_BRASILEIRAO_A,\n79:     \"brasileirao\": COMP_BRASILEIRAO_A,\n80:     \"seriea\": COMP_BRASILEIRAO_A,\n81:     \"seriesa\": COMP_BRASILEIRAO_A,\n82:     \"serieb\": COMP_BRASILEIRAO_B,\n83:     \"seriesb\": COMP_BRASILEIRAO_B,\n84:     \"seriec\": COMP_BRASILEIRAO_C,\n85:     \"seriesc\": COMP_BRASILEIRAO_C,\n86:     \"copadobrasil\": COMP_COPA_BRASIL,\n87:     \"copa\": COMP_COPA_BRASIL,\n88:     \"copabrasil\": COMP_COPA_BRASIL,\n89:     \"braziliancup\": COMP_COPA_BRASIL,\n90:     \"libertadores\": COMP_LIBERTADORES,\n91:     \"copalibertadores\": COMP_LIBERTADORES,\n92:     \"liberta\": COMP_LIBERTADORES,\n93: }\n94: \n95: # Tournament name as written in BR-Football-Dataset.csv -> canonical competition.\n96: BR_FD_TOURNAMENT_MAP = {\n97:     \"Serie A\": COMP_BRASILEIRAO_A,\n98:     \"Serie B\": COMP_BRASILEIRAO_B,\n99:     \"Serie C\": COMP_BRASILEIRAO_C,\n100:     \"Copa do Brasil\": COMP_COPA_BRASIL,\n101: }\n102: \n103: # Per-competition source priority (lower == higher priority).\n104: SOURCE_RANK = {\n105:     COMP_BRASILEIRAO_A: {\"brasileirao_matches\": 0, \"br_football\": 1, \"historical\": 2},\n106:     COMP_BRASILEIRAO_B: {\"br_football\": 0},\n107:     COMP_BRASILEIRAO_C: {\"br_football\": 0},\n108:     COMP_COPA_BRASIL: {\"brazilian_cup\": 0, \"br_football\": 1},\n109:     COMP_LIBERTADORES: {\"libertadores\": 0},\n110: }\n111: \n112: DEFAULT_DATA_DIR = os.path.join(\n113:     os.path.dirname(os.path.dirname(os.path.abspath(__file__))), \"data\", \"kaggle\"\n114: )\n115: \n116: \n117: # ---------------------------------------------------------------------------\n118: # Data model\n119: # ---------------------------------------------------------------------------\n120: @dataclass\n121: class Match:\n122:     \"\"\"A single football match, source-normalised.\"\"\"\n123: \n124:     date: Optional[str]  # ISO YYYY-MM-DD\n125:     season: Optional[str]  # \"YYYY\" string\n126:     competition: str\n127:     round_or_stage: Optional[str]\n128:     home_team: str  # canonical key\n129:     away_team: str  # canonical key\n130:     home_goals: Optional[int]\n131:     away_goals: Optional[int]\n132:     source: str\n133: \n134:     # Fields populated only from BR-Football-Dataset (None otherwise).\n135:     home_corners: Optional[int] = None\n136:     away_corners: Optional[int] = None\n137:     home_shots: Optional[int] = None\n138:     away_shots: Optional[int] = None\n139:     home_attacks: Optional[int] = None\n140:     away_attacks: Optional[int] = None\n141:     ht_result: Optional[str] = None  # home half-time outcome label (WON/LOST/DRAW)\n142:     at_result: Optional[str] = None  # away half-time outcome label\n143:     arena: Optional[str] = None  # from historical file\n144: \n145:     source_rank: int = 0\n146:     home_display: str = \"\"\n147:     away_display: str = \"\"\n148: \n149: \n150: @dataclass\n151: class Player:\n152:     \"\"\"A FIFA player record (subset of relevant columns).\"\"\"\n153: \n154:     id: Optional[str]\n155:     name: Optional[str]\n156:     age: Optional[int]\n157:     nationality: Optional[str]\n158:     overall: Optional[int]\n159:     potential: Optional[int]\n160:     club: Optional[str]\n161:     club_canonical: Optional[str]\n162:     position: Optional[str]\n163:     jersey_number: Optional[str]\n164:     height: Optional[str]\n165:     weight: Optional[str]\n166:     preferred_foot: Optional[str]\n167:     value: Optional[str]\n168:     wage: Optional[str]\n169:     # Selected skill attributes used for \"attributes\" responses.\n170:     crossing: Optional[int] = None\n171:     finishing: Optional[int] = None\n172:     dribbling: Optional[int] = None\n173:     shortpassing: Optional[int] = None\n174:     longshots: Optional[int] = None\n175:     defending: Optional[int] = None\n176:     gkdiving: Optional[int] = None\n177:     pace: Optional[int] = None\n178:     shooting: Optional[int] = None\n179:     passing: Optional[int] = None\n180:     dribbling2: Optional[int] = None  # \"Dribbling.1\"\n181:     defending2: Optional[int] = None  # \"Defending.1\"\n182:     physical: Optional[int] = None\n183: \n184: \n185: @dataclass\n186: class SoccerData:\n187:     \"\"\"In-memory representation of the whole dataset.\"\"\"\n188: \n189:     normalizer: TeamNormalizer\n190:     matches: list[Match] = field(default_factory=list)\n191:     raw_matches: list[Match] = field(default_factory=list)\n192:     stats_matches: list[Match] = field(default_factory=list)\n193:     players: list[Player] = field(default_factory=list)\n194:     # canonical_key -> display name\n195:     team_display: dict[str, str] = field(default_factory=dict)\n196:     # (competition, season) -> set(source ranks present) for diagnostics\n197:     season_sources: dict[tuple[str, str], set] = field(default_factory=dict)\n198: \n199:     # ---- lookup helpers -------------------------------------------------\n200:     def seasons_for(self, competition: str) -> list[str]:\n201:         out = set()\n202:         for m in self.matches:\n203:             if m.competition == competition and m.season:\n204:                 out.add(m.season)\n205:         return sorted(out)\n206: \n207:     def competitions(self) -> list[str]:\n208:         seen = set()\n209:         ordered = []\n210:         for c in ALL_COMPETITIONS:\n211:             for m in self.matches:\n212:                 if m.competition == c and c not in seen:\n213:                     seen.add(c)\n214:                     ordered.append(c)\n215:                     break\n216:         return ordered\n217: \n218: \n219: # ---------------------------------------------------------------------------\n220: # Helpers\n221: # ---------------------------------------------------------------------------\n222: def _safe_season(value) -> Optional[str]:\n223:     \"\"\"Normalise a season value to a 4-digit year string, or None.\"\"\"\n224:     if value is None:\n225:         return None\n226:     text = str(value).strip()\n227:     if not text or text.lower() in {\"na\", \"nan\", \"none\"}:\n228:         return None\n229:     if text.isdigit() and 1900 <= int(text) <= 2100:\n230:         return text\n231:     # Fallback: try to extract a 4-digit year.\n232:     import re\n233: \n234:     m = re.search(r\"\\d{4}\", text)\n235:     return m.group(0) if m else None\n236: \n237: \n238: def _to_int(value) -> Optional[int]:\n239:     if value is None:\n240:         return None\n241:     try:\n242:         return int(float(str(value).strip()))\n243:     except (TypeError, ValueError):\n244:         return None\n245: \n246: \n247: def resolve_competition(name: Optional[str]) -> Optional[str]:\n248:     \"\"\"Resolve a user-supplied competition name to a canonical one.\"\"\"\n249:     if not name:\n250:         return None\n251:     if name in ALL_COMPETITIONS:\n252:         return name\n253:     import re\n254: \n255:     from .normalize import strip_accents\n256: \n257:     key = re.sub(r\"[^a-z0-9]\", \"\", strip_accents(name.lower()))\n258:     return COMPETITION_ALIASES.get(key)\n259: \n260: \n261: # ---------------------------------------------------------------------------\n262: # CSV loading\n263: # ---------------------------------------------------------------------------\n264: def _read_rows(path: str) -> list[dict]:\n265:     with open(path, encoding=\"utf-8-sig\", newline=\"\") as fh:\n266:         return list(csv.DictReader(fh))\n267: \n268: \n269: def _observe_teams(normalizer: TeamNormalizer, rows: list[dict], cols: list[str]) -> None:\n270:     for row in rows:\n271:         for col in cols:\n272:             if col in row:\n273:                 normalizer.observe(row[col] or \"\")\n274: \n275: \n276: def _load_player_rows(path: str) -> list[dict]:\n277:     with open(path, encoding=\"utf-8-sig\", newline=\"\") as fh:\n278:         reader = csv.reader(fh)\n279:         try:\n280:             header = next(reader)\n281:         except StopIteration:\n282:             return []\n283:         header = [h.strip().lstrip(\"\\ufeff\") for h in header]\n284:         # De-duplicate headers like \"Dribbling\", \"Dribbling.1\"\n285:         seen: dict[str, int] = {}\n286:         clean_header: list[str] = []\n287:         for h in header:\n288:             if h in seen:\n289:                 seen[h] += 1\n290:                 clean_header.append(f\"{h}.{seen[h]}\")\n291:             else:\n292:                 seen[h] = 0\n293:                 clean_header.append(h)\n294:         out: list[dict] = []\n295:         for raw in reader:\n296:             if not raw:\n297:                 continue\n298:             row = dict(zip(clean_header, raw))\n299:             out.append(row)\n300:         return out\n301: \n302: \n303: def load_data(data_dir: str = DEFAULT_DATA_DIR) -> SoccerData:\n304:     \"\"\"Load every dataset from ``data_dir`` into a :class:`SoccerData` object.\"\"\"\n305:     p = lambda *parts: os.path.join(data_dir, *parts)\n306: \n307:     bras_path = p(\"Brasileirao_Matches.csv\")\n308:     hist_path = p(\"novo_campeonato_brasileiro.csv\")\n309:     brfd_path = p(\"BR-Football-Dataset.csv\")\n310:     cup_path = p(\"Brazilian_Cup_Matches.csv\")\n311:     lib_path = p(\"Libertadores_Matches.csv\")\n312:     fifa_path = p(\"fifa_data.csv\")\n313: \n314:     bras_rows = _read_rows(bras_path)\n315:     hist_rows = _read_rows(hist_path)\n316:     brfd_rows = _read_rows(brfd_path)\n317:     cup_rows = _read_rows(cup_path)\n318:     lib_rows = _read_rows(lib_path)\n319:     fifa_rows = _load_player_rows(fifa_path)\n320: \n321:     # ---- Phase 1: observe every team/club name so prominence can resolve.\n322:     normalizer = TeamNormalizer()\n323:     for rows, cols in (\n324:         (bras_rows, [\"home_team\", \"away_team\"]),\n325:         (cup_rows, [\"home_team\", \"away_team\"]),\n326:         (lib_rows, [\"home_team\", \"away_team\"]),\n327:         (brfd_rows, [\"home\", \"away\"]),\n328:         (hist_rows, [\"Equipe_mandante\", \"Equipe_visitante\"]),\n329:     ):\n330:         _observe_teams(normalizer, rows, cols)\n331:     for row in fifa_rows:\n332:         club = (row.get(\"Club\") or \"\").strip()\n333:         if club:\n334:             normalizer.observe(club)\n335:     normalizer.finalize()\n336: \n337:     data = SoccerData(normalizer=normalizer)\n338: \n339:     def mk_match(\n340:         *,\n341:         date,\n342:         season,\n343:         competition,\n344:         round_or_stage,\n345:         home_team,\n346:         away_team,\n347:         home_goals,\n348:         away_goals,\n349:         source,\n350:         source_rank,\n351:         arena=None,\n352:         home_corners=None,\n353:         away_corners=None,\n354:         home_shots=None,\n355:         away_shots=None,\n356:         home_attacks=None,\n357:         away_attacks=None,\n358:         ht_result=None,\n359:         at_result=None,\n360:     ) -> Match:\n361:         home_key = normalizer.canonical(home_team)\n362:         away_key = normalizer.canonical(away_team)\n363:         return Match(\n364:             date=parse_date(date),\n365:             season=_safe_season(season),\n366:             competition=competition,\n367:             round_or_stage=(str(round_or_stage).strip() if round_or_stage not in (None, \"\") else None),\n368:             home_team=home_key,\n369:             away_team=away_key,\n370:             home_goals=to_int_goal(home_goals),\n371:             away_goals=to_int_goal(away_goals),\n372:             source=source,\n373:             source_rank=source_rank,\n374:             home_display=normalizer.display(home_key),\n375:             away_display=normalizer.display(away_key),\n376:             arena=arena,\n377:             home_corners=_to_int(home_corners),\n378:             away_corners=_to_int(away_corners),\n379:             home_shots=_to_int(home_shots),\n380:             away_shots=_to_int(away_shots),\n381:             home_attacks=_to_int(home_attacks),\n382:             away_attacks=_to_int(away_attacks),\n383:             ht_result=ht_result,\n384:             at_result=at_result,\n385:         )\n386: \n387:     add = data.raw_matches.append\n388: \n389:     # Brasileirao_Matches.csv  (priority 0 for Serie A)\n390:     sr = SOURCE_RANK[COMP_BRASILEIRAO_A][\"brasileirao_matches\"]\n391:     for r in bras_rows:\n392:         add(mk_match(\n393:             date=r.get(\"datetime\"), season=r.get(\"season\"),\n394:             competition=COMP_BRASILEIRAO_A, round_or_stage=r.get(\"round\"),\n395:             home_team=r.get(\"home_team\"), away_team=r.get(\"away_team\"),\n396:             home_goals=r.get(\"home_goal\"), away_goals=r.get(\"away_goal\"),\n397:             source=\"Brasileirao_Matches.csv\", source_rank=sr,\n398:         ))\n399: \n400:     # historical Brasileirao (priority 2 for Serie A)\n401:     sr = SOURCE_RANK[COMP_BRASILEIRAO_A][\"historical\"]\n402:     for r in hist_rows:\n403:         add(mk_match(\n404:             date=r.get(\"Data\"), season=r.get(\"Ano\"),\n405:             competition=COMP_BRASILEIRAO_A, round_or_stage=r.get(\"Rodada\"),\n406:             home_team=r.get(\"Equipe_mandante\"), away_team=r.get(\"Equipe_visitante\"),\n407:             home_goals=r.get(\"Gols_mandante\"), away_goals=r.get(\"Gols_visitante\"),\n408:             source=\"novo_campeonato_brasileiro.csv\", source_rank=sr,\n409:             arena=r.get(\"Arena\"),\n410:         ))\n411: \n412:     # BR-Football-Dataset.csv  (priority 1 for Serie A/Copa, 0 for Serie B/C)\n413:     for r in brfd_rows:\n414:         tournament = r.get(\"tournament\", \"\").strip()\n415:         competition = BR_FD_TOURNAMENT_MAP.get(tournament)\n416:         if competition is None:\n417:             continue\n418:         date = r.get(\"date\")\n419:         season = (parse_date(date) or \"\")[:4] or None\n420:         sr = SOURCE_RANK[competition][\"br_football\"]\n421:         m = mk_match(\n422:             date=date, season=season, competition=competition,\n423:             round_or_stage=None,\n424:             home_team=r.get(\"home\"), away_team=r.get(\"away\"),\n425:             home_goals=r.get(\"home_goal\"), away_goals=r.get(\"away_goal\"),\n426:             source=\"BR-Football-Dataset.csv\", source_rank=sr,\n427:             home_corners=r.get(\"home_corner\"), away_corners=r.get(\"away_corner\"),\n428:             home_shots=r.get(\"home_shots\"), away_shots=r.get(\"away_shots\"),\n429:             home_attacks=r.get(\"home_attack\"), away_attacks=r.get(\"away_attack\"),\n430:             ht_result=r.get(\"ht_result\"), at_result=r.get(\"at_result\"),\n431:         )\n432:         add(m)\n433:         # BR-Football-Dataset carries detailed stats -> also expose directly.\n434:         data.stats_matches.append(m)\n435: \n436:     # Brazilian_Cup_Matches.csv  (priority 0 for Copa do Brasil)\n437:     sr = SOURCE_RANK[COMP_COPA_BRASIL][\"brazilian_cup\"]\n438:     for r in cup_rows:\n439:         add(mk_match(\n440:             date=r.get(\"datetime\"), season=r.get(\"season\"),\n441:             competition=COMP_COPA_BRASIL, round_or_stage=r.get(\"round\"),\n442:             home_team=r.get(\"home_team\"), away_team=r.get(\"away_team\"),\n443:             home_goals=r.get(\"home_goal\"), away_goals=r.get(\"away_goal\"),\n444:             source=\"Brazilian_Cup_Matches.csv\", source_rank=sr,\n445:         ))\n446: \n447:     # Libertadores_Matches.csv  (priority 0 for Libertadores)\n448:     sr = SOURCE_RANK[COMP_LIBERTADORES][\"libertadores\"]\n449:     for r in lib_rows:\n450:         add(mk_match(\n451:             date=r.get(\"datetime\"), season=r.get(\"season\"),\n452:             competition=COMP_LIBERTADORES, round_or_stage=r.get(\"stage\"),\n453:             home_team=r.get(\"home_team\"), away_team=r.get(\"away_team\"),\n454:             home_goals=r.get(\"home_goal\"), away_goals=r.get(\"away_goal\"),\n455:             source=\"Libertadores_Matches.csv\", source_rank=sr,\n456:         ))\n457: \n458:     # ---- Source-priority selection: per (competition, season) keep best rank.\n459:     best_rank: dict[tuple[str, str], int] = {}\n460:     for m in data.raw_matches:\n461:         if m.season is None or m.home_goals is None or m.away_goals is None:\n462:             continue\n463:         key = (m.competition, m.season)\n464:         if key not in best_rank or m.source_rank < best_rank[key]:\n465:             best_rank[key] = m.source_rank\n466:             data.season_sources.setdefault(key, set()).add(m.source)\n467:     for m in data.raw_matches:\n468:         if m.season is None or m.home_goals is None or m.away_goals is None:\n469:             continue\n470:         if m.source_rank == best_rank.get((m.competition, m.season)):\n471:             data.matches.append(m)\n472: \n473:     # ---- Players\n474:     _load_players(data, fifa_rows)\n475: \n476:     # ---- Team display index\n477:     for m in data.raw_matches:\n478:         data.team_display.setdefault(m.home_team, m.home_display)\n479:         data.team_display.setdefault(m.away_team, m.away_display)\n480: \n481:     return data\n482: \n483: \n484: def _load_players(data: SoccerData, rows: list[dict]) -> None:\n485:     for r in rows:\n486:         club = (r.get(\"Club\") or \"\").strip() or None\n487:         club_canonical = data.normalizer.canonical(club) if club else None\n488:         player = Player(\n489:             id=r.get(\"ID\"),\n490:             name=(r.get(\"Name\") or \"\").strip() or None,\n491:             age=_to_int(r.get(\"Age\")),\n492:             nationality=(r.get(\"Nationality\") or \"\").strip() or None,\n493:             overall=_to_int(r.get(\"Overall\")),\n494:             potential=_to_int(r.get(\"Potential\")),\n495:             club=club,\n496:             club_canonical=club_canonical,\n497:             position=(r.get(\"Position\") or \"\").strip() or None,\n498:             jersey_number=r.get(\"Jersey Number\"),\n499:             height=(r.get(\"Height\") or \"\").strip() or None,\n500:             weight=(r.get(\"Weight\") or \"\").strip() or None,\n501:             preferred_foot=(r.get(\"Preferred Foot\") or \"\").strip() or None,\n502:             value=(r.get(\"Value\") or \"\").strip() or None,\n503:             wage=(r.get(\"Wage\") or \"\").strip() or None,\n504:             crossing=_to_int(r.get(\"Crossing\")),\n505:             finishing=_to_int(r.get(\"Finishing\")),\n506:             dribbling=_to_int(r.get(\"Dribbling\")),\n507:             shortpassing=_to_int(r.get(\"ShortPassing\")),\n508:             longshots=_to_int(r.get(\"LongShots\")),\n509:             defending=_to_int(r.get(\"Defending\")),\n510:             gkdiving=_to_int(r.get(\"GKDiving\")),\n511:             pace=_to_int(r.get(\"Pace\", r.get(\"Acceleration\"))),\n512:             shooting=_to_int(r.get(\"Shooting\")),\n513:             passing=_to_int(r.get(\"Passing\")),\n514:             dribbling2=_to_int(r.get(\"Dribbling.1\")),\n515:             defending2=_to_int(r.get(\"Defending.1\")),\n516:             physical=_to_int(r.get(\"Physical\")),\n517:         )\n518:         data.players.append(player)\n519: \n520: \n521: @lru_cache(maxsize=1)\n522: def get_data(data_dir: str = DEFAULT_DATA_DIR) -> SoccerData:\n523:     \"\"\"Return the process-wide cached :class:`SoccerData` singleton.\"\"\"\n524:     return load_data(data_dir)\n525: \n526: \n527: def reset_cache() -> None:\n528:     \"\"\"Clear the cached :class:`SoccerData` (used by tests).\"\"\"\n529:     get_data.cache_clear()\n\n(End of file - total 529 lines)\n</content>","metadata":{"preview":"\"\"\"\nContext\n=======\nBrazilian Soccer MCP Server - data loader.\n\nPart of the ``soccer_mcp`` package.  Loads the six Kaggle CSV datasets from\n``data/kaggle/`` into an in-memory :class:`SoccerData` object that the query\nlayer (:mod:`soccer_mcp.queries`) and the MCP server (:mod:`soccer_mcp.server`)\noperate on.\n\nDatasets loaded\n---------------\n1. ``Brasileirao_Matches.csv``      - Brasileirao Serie A (2012-2022)\n2. ``novo_campeonato_brasileiro.csv`` - Brasileirao Serie A historical (2003-2019)\n3. ``BR-Football-Dataset.csv``      - Serie A/B/C + Copa do Brasil (2014-2023, rich stats)\n4. ``Brazilian_Cup_Matches.csv``    - Copa do Brasil (2012-2021)\n5. ``Libertadores_Matches.csv``     - Copa Libertadores (2013-2022)\n6. ``fifa_data.csv``                - FIFA player database (~18k players)\n\nSource-priority merge","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/soccer_mcp/data_loader.py","text":"\"\"\"\nContext\n=======\nBrazilian Soccer MCP Server - data loader.\n\nPart of the ``soccer_mcp`` package.  Loads the six Kaggle CSV datasets from\n``data/kaggle/`` into an in-memory :class:`SoccerData` object that the query\nlayer (:mod:`soccer_mcp.queries`) and the MCP server (:mod:`soccer_mcp.server`)\noperate on.\n\nDatasets loaded\n---------------\n1. ``Brasileirao_Matches.csv``      - Brasileirao Serie A (2012-2022)\n2. ``novo_campeonato_brasileiro.csv`` - Brasileirao Serie A historical (2003-2019)\n3. ``BR-Football-Dataset.csv``      - Serie A/B/C + Copa do Brasil (2014-2023, rich stats)\n4. ``Brazilian_Cup_Matches.csv``    - Copa do Brasil (2012-2021)\n5. ``Libertadores_Matches.csv``     - Copa Libertadores (2013-2022)\n6. ``fifa_data.csv``                - FIFA player database (~18k players)\n\nSource-priority merge\n---------------------\nThe two Brasileirao files and the BR-Football-Dataset overlap for many seasons.\nTo avoid double counting in standings / head-to-head / team statistics the\nloader tags every match with a per-competition *source rank* and, for each\n(competition, season), keeps only the rows from the single best (lowest-rank)\nsource.  Lower rank == higher priority:\n\n    Brasileirao Serie A : Brasileirao_Matches (0) > BR-Football-Dataset (1) > historical (2)\n    Brasileirao Serie B : BR-Football-Dataset (0)\n    Brasileirao Serie C : BR-Football-Dataset (0)\n    Copa do Brasil       : Brazilian_Cup_Matches (0) > BR-Football-Dataset (1)\n    Copa Libertadores    : Libertadores_Matches (0)\n\nThis yields one clean record per real-world match for league-style\ncalculations while still letting the BR-Football-Dataset supply the only data\nfor Serie B/C, the 2023 Serie A season and the 2022-2023 Copa do Brasil, plus\ndetailed corner/shot/attack statistics via the separate ``stats_matches``\ncollection (queried by ``match_stats``).\n\nTeam names are canonicalised with :class:`soccer_mcp.normalize.TeamNormalizer`\nso that \"Sao Paulo-SP\", \"Sao Paulo\" and \"Sao Paulo\" all resolve to one entity.\nDates are normalised to ISO.  Goals are normalised to int.\n\nThe loader is lazy and cached: the first call to :func:`get_data` parses the\nCSVs once and returns a process-wide singleton.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport os\nfrom collections import defaultdict\nfrom dataclasses import dataclass, field\nfrom functools import lru_cache\nfrom typing import Optional\n\nfrom .normalize import TeamNormalizer, parse_date, to_int_goal\n\n# ---------------------------------------------------------------------------\n# Canonical competition names and the user-facing aliases that map to them.\n# ---------------------------------------------------------------------------\nCOMP_BRASILEIRAO_A = \"Brasileirao Serie A\"\nCOMP_BRASILEIRAO_B = \"Brasileirao Serie B\"\nCOMP_BRASILEIRAO_C = \"Brasileirao Serie C\"\nCOMP_COPA_BRASIL = \"Copa do Brasil\"\nCOMP_LIBERTADORES = \"Copa Libertadores\"\n\nALL_COMPETITIONS = (\n    COMP_BRASILEIRAO_A,\n    COMP_BRASILEIRAO_B,\n    COMP_BRASILEIRAO_C,\n    COMP_COPA_BRASIL,\n    COMP_LIBERTADORES,\n)\n\n# Aliases (lowercased, alphanumeric) accepted in query parameters.\nCOMPETITION_ALIASES: dict[str, str] = {\n    \"brasileiraoa\": COMP_BRASILEIRAO_A,\n    \"brasileirao\": COMP_BRASILEIRAO_A,\n    \"seriea\": COMP_BRASILEIRAO_A,\n    \"seriesa\": COMP_BRASILEIRAO_A,\n    \"serieb\": COMP_BRASILEIRAO_B,\n    \"seriesb\": COMP_BRASILEIRAO_B,\n    \"seriec\": COMP_BRASILEIRAO_C,\n    \"seriesc\": COMP_BRASILEIRAO_C,\n    \"copadobrasil\": COMP_COPA_BRASIL,\n    \"copa\": COMP_COPA_BRASIL,\n    \"copabrasil\": COMP_COPA_BRASIL,\n    \"braziliancup\": COMP_COPA_BRASIL,\n    \"libertadores\": COMP_LIBERTADORES,\n    \"copalibertadores\": COMP_LIBERTADORES,\n    \"liberta\": COMP_LIBERTADORES,\n}\n\n# Tournament name as written in BR-Football-Dataset.csv -> canonical competition.\nBR_FD_TOURNAMENT_MAP = {\n    \"Serie A\": COMP_BRASILEIRAO_A,\n    \"Serie B\": COMP_BRASILEIRAO_B,\n    \"Serie C\": COMP_BRASILEIRAO_C,\n    \"Copa do Brasil\": COMP_COPA_BRASIL,\n}\n\n# Per-competition source priority (lower == higher priority).\nSOURCE_RANK = {\n    COMP_BRASILEIRAO_A: {\"brasileirao_matches\": 0, \"br_football\": 1, \"historical\": 2},\n    COMP_BRASILEIRAO_B: {\"br_football\": 0},\n    COMP_BRASILEIRAO_C: {\"br_football\": 0},\n    COMP_COPA_BRASIL: {\"brazilian_cup\": 0, \"br_football\": 1},\n    COMP_LIBERTADORES: {\"libertadores\": 0},\n}\n\nDEFAULT_DATA_DIR = os.path.join(\n    os.path.dirname(os.path.dirname(os.path.abspath(__file__))), \"data\", \"kaggle\"\n)\n\n\n# ---------------------------------------------------------------------------\n# Data model\n# ---------------------------------------------------------------------------\n@dataclass\nclass Match:\n    \"\"\"A single football match, source-normalised.\"\"\"\n\n    date: Optional[str]  # ISO YYYY-MM-DD\n    season: Optional[str]  # \"YYYY\" string\n    competition: str\n    round_or_stage: Optional[str]\n    home_team: str  # canonical key\n    away_team: str  # canonical key\n    home_goals: Optional[int]\n    away_goals: Optional[int]\n    source: str\n\n    # Fields populated only from BR-Football-Dataset (None otherwise).\n    home_corners: Optional[int] = None\n    away_corners: Optional[int] = None\n    home_shots: Optional[int] = None\n    away_shots: Optional[int] = None\n    home_attacks: Optional[int] = None\n    away_attacks: Optional[int] = None\n    ht_result: Optional[str] = None  # home half-time outcome label (WON/LOST/DRAW)\n    at_result: Optional[str] = None  # away half-time outcome label\n    arena: Optional[str] = None  # from historical file\n\n    source_rank: int = 0\n    home_display: str = \"\"\n    away_display: str = \"\"\n\n\n@dataclass\nclass Player:\n    \"\"\"A FIFA player record (subset of relevant columns).\"\"\"\n\n    id: Optional[str]\n    name: Optional[str]\n    age: Optional[int]\n    nationality: Optional[str]\n    overall: Optional[int]\n    potential: Optional[int]\n    club: Optional[str]\n    club_canonical: Optional[str]\n    position: Optional[str]\n    jersey_number: Optional[str]\n    height: Optional[str]\n    weight: Optional[str]\n    preferred_foot: Optional[str]\n    value: Optional[str]\n    wage: Optional[str]\n    # Selected skill attributes used for \"attributes\" responses.\n    crossing: Optional[int] = None\n    finishing: Optional[int] = None\n    dribbling: Optional[int] = None\n    shortpassing: Optional[int] = None\n    longshots: Optional[int] = None\n    defending: Optional[int] = None\n    gkdiving: Optional[int] = None\n    pace: Optional[int] = None\n    shooting: Optional[int] = None\n    passing: Optional[int] = None\n    dribbling2: Optional[int] = None  # \"Dribbling.1\"\n    defending2: Optional[int] = None  # \"Defending.1\"\n    physical: Optional[int] = None\n\n\n@dataclass\nclass SoccerData:\n    \"\"\"In-memory representation of the whole dataset.\"\"\"\n\n    normalizer: TeamNormalizer\n    matches: list[Match] = field(default_factory=list)\n    raw_matches: list[Match] = field(default_factory=list)\n    stats_matches: list[Match] = field(default_factory=list)\n    players: list[Player] = field(default_factory=list)\n    # canonical_key -> display name\n    team_display: dict[str, str] = field(default_factory=dict)\n    # (competition, season) -> set(source ranks present) for diagnostics\n    season_sources: dict[tuple[str, str], set] = field(default_factory=dict)\n\n    # ---- lookup helpers -------------------------------------------------\n    def seasons_for(self, competition: str) -> list[str]:\n        out = set()\n        for m in self.matches:\n            if m.competition == competition and m.season:\n                out.add(m.season)\n        return sorted(out)\n\n    def competitions(self) -> list[str]:\n        seen = set()\n        ordered = []\n        for c in ALL_COMPETITIONS:\n            for m in self.matches:\n                if m.competition == c and c not in seen:\n                    seen.add(c)\n                    ordered.append(c)\n                    break\n        return ordered\n\n\n# ---------------------------------------------------------------------------\n# Helpers\n# ---------------------------------------------------------------------------\ndef _safe_season(value) -> Optional[str]:\n    \"\"\"Normalise a season value to a 4-digit year string, or None.\"\"\"\n    if value is None:\n        return None\n    text = str(value).strip()\n    if not text or text.lower() in {\"na\", \"nan\", \"none\"}:\n        return None\n    if text.isdigit() and 1900 <= int(text) <= 2100:\n        return text\n    # Fallback: try to extract a 4-digit year.\n    import re\n\n    m = re.search(r\"\\d{4}\", text)\n    return m.group(0) if m else None\n\n\ndef _to_int(value) -> Optional[int]:\n    if value is None:\n        return None\n    try:\n        return int(float(str(value).strip()))\n    except (TypeError, ValueError):\n        return None\n\n\ndef resolve_competition(name: Optional[str]) -> Optional[str]:\n    \"\"\"Resolve a user-supplied competition name to a canonical one.\"\"\"\n    if not name:\n        return None\n    if name in ALL_COMPETITIONS:\n        return name\n    import re\n\n    from .normalize import strip_accents\n\n    key = re.sub(r\"[^a-z0-9]\", \"\", strip_accents(name.lower()))\n    return COMPETITION_ALIASES.get(key)\n\n\n# ---------------------------------------------------------------------------\n# CSV loading\n# ---------------------------------------------------------------------------\ndef _read_rows(path: str) -> list[dict]:\n    with open(path, encoding=\"utf-8-sig\", newline=\"\") as fh:\n        return list(csv.DictReader(fh))\n\n\ndef _observe_teams(normalizer: TeamNormalizer, rows: list[dict], cols: list[str]) -> None:\n    for row in rows:\n        for col in cols:\n            if col in row:\n                normalizer.observe(row[col] or \"\")\n\n\ndef _load_player_rows(path: str) -> list[dict]:\n    with open(path, encoding=\"utf-8-sig\", newline=\"\") as fh:\n        reader = csv.reader(fh)\n        try:\n            header = next(reader)\n        except StopIteration:\n            return []\n        header = [h.strip().lstrip(\"\\ufeff\") for h in header]\n        # De-duplicate headers like \"Dribbling\", \"Dribbling.1\"\n        seen: dict[str, int] = {}\n        clean_header: list[str] = []\n        for h in header:\n            if h in seen:\n                seen[h] += 1\n                clean_header.append(f\"{h}.{seen[h]}\")\n            else:\n                seen[h] = 0\n                clean_header.append(h)\n        out: list[dict] = []\n        for raw in reader:\n            if not raw:\n                continue\n            row = dict(zip(clean_header, raw))\n            out.append(row)\n        return out\n\n\ndef load_data(data_dir: str = DEFAULT_DATA_DIR) -> SoccerData:\n    \"\"\"Load every dataset from ``data_dir`` into a :class:`SoccerData` object.\"\"\"\n    p = lambda *parts: os.path.join(data_dir, *parts)\n\n    bras_path = p(\"Brasileirao_Matches.csv\")\n    hist_path = p(\"novo_campeonato_brasileiro.csv\")\n    brfd_path = p(\"BR-Football-Dataset.csv\")\n    cup_path = p(\"Brazilian_Cup_Matches.csv\")\n    lib_path = p(\"Libertadores_Matches.csv\")\n    fifa_path = p(\"fifa_data.csv\")\n\n    bras_rows = _read_rows(bras_path)\n    hist_rows = _read_rows(hist_path)\n    brfd_rows = _read_rows(brfd_path)\n    cup_rows = _read_rows(cup_path)\n    lib_rows = _read_rows(lib_path)\n    fifa_rows = _load_player_rows(fifa_path)\n\n    # ---- Phase 1: observe every team/club name so prominence can resolve.\n    normalizer = TeamNormalizer()\n    for rows, cols in (\n        (bras_rows, [\"home_team\", \"away_team\"]),\n        (cup_rows, [\"home_team\", \"away_team\"]),\n        (lib_rows, [\"home_team\", \"away_team\"]),\n        (brfd_rows, [\"home\", \"away\"]),\n        (hist_rows, [\"Equipe_mandante\", \"Equipe_visitante\"]),\n    ):\n        _observe_teams(normalizer, rows, cols)\n    for row in fifa_rows:\n        club = (row.get(\"Club\") or \"\").strip()\n        if club:\n            normalizer.observe(club)\n    normalizer.finalize()\n\n    data = SoccerData(normalizer=normalizer)\n\n    def mk_match(\n        *,\n        date,\n        season,\n        competition,\n        round_or_stage,\n        home_team,\n        away_team,\n        home_goals,\n        away_goals,\n        source,\n        source_rank,\n        arena=None,\n        home_corners=None,\n        away_corners=None,\n        home_shots=None,\n        away_shots=None,\n        home_attacks=None,\n        away_attacks=None,\n        ht_result=None,\n        at_result=None,\n    ) -> Match:\n        home_key = normalizer.canonical(home_team)\n        away_key = normalizer.canonical(away_team)\n        return Match(\n            date=parse_date(date),\n            season=_safe_season(season),\n            competition=competition,\n            round_or_stage=(str(round_or_stage).strip() if round_or_stage not in (None, \"\") else None),\n            home_team=home_key,\n            away_team=away_key,\n            home_goals=to_int_goal(home_goals),\n            away_goals=to_int_goal(away_goals),\n            source=source,\n            source_rank=source_rank,\n            home_display=normalizer.display(home_key),\n            away_display=normalizer.display(away_key),\n            arena=arena,\n            home_corners=_to_int(home_corners),\n            away_corners=_to_int(away_corners),\n            home_shots=_to_int(home_shots),\n            away_shots=_to_int(away_shots),\n            home_attacks=_to_int(home_attacks),\n            away_attacks=_to_int(away_attacks),\n            ht_result=ht_result,\n            at_result=at_result,\n        )\n\n    add = data.raw_matches.append\n\n    # Brasileirao_Matches.csv  (priority 0 for Serie A)\n    sr = SOURCE_RANK[COMP_BRASILEIRAO_A][\"brasileirao_matches\"]\n    for r in bras_rows:\n        add(mk_match(\n            date=r.get(\"datetime\"), season=r.get(\"season\"),\n            competition=COMP_BRASILEIRAO_A, round_or_stage=r.get(\"round\"),\n            home_team=r.get(\"home_team\"), away_team=r.get(\"away_team\"),\n            home_goals=r.get(\"home_goal\"), away_goals=r.get(\"away_goal\"),\n            source=\"Brasileirao_Matches.csv\", source_rank=sr,\n        ))\n\n    # historical Brasileirao (priority 2 for Serie A)\n    sr = SOURCE_RANK[COMP_BRASILEIRAO_A][\"historical\"]\n    for r in hist_rows:\n        add(mk_match(\n            date=r.get(\"Data\"), season=r.get(\"Ano\"),\n            competition=COMP_BRASILEIRAO_A, round_or_stage=r.get(\"Rodada\"),\n            home_team=r.get(\"Equipe_mandante\"), away_team=r.get(\"Equipe_visitante\"),\n            home_goals=r.get(\"Gols_mandante\"), away_goals=r.get(\"Gols_visitante\"),\n            source=\"novo_campeonato_brasileiro.csv\", source_rank=sr,\n            arena=r.get(\"Arena\"),\n        ))\n\n    # BR-Football-Dataset.csv  (priority 1 for Serie A/Copa, 0 for Serie B/C)\n    for r in brfd_rows:\n        tournament = r.get(\"tournament\", \"\").strip()\n        competition = BR_FD_TOURNAMENT_MAP.get(tournament)\n        if competition is None:\n            continue\n        date = r.get(\"date\")\n        season = (parse_date(date) or \"\")[:4] or None\n        sr = SOURCE_RANK[competition][\"br_football\"]\n        m = mk_match(\n            date=date, season=season, competition=competition,\n            round_or_stage=None,\n            home_team=r.get(\"home\"), away_team=r.get(\"away\"),\n            home_goals=r.get(\"home_goal\"), away_goals=r.get(\"away_goal\"),\n            source=\"BR-Football-Dataset.csv\", source_rank=sr,\n            home_corners=r.get(\"home_corner\"), away_corners=r.get(\"away_corner\"),\n            home_shots=r.get(\"home_shots\"), away_shots=r.get(\"away_shots\"),\n            home_attacks=r.get(\"home_attack\"), away_attacks=r.get(\"away_attack\"),\n            ht_result=r.get(\"ht_result\"), at_result=r.get(\"at_result\"),\n        )\n        add(m)\n        # BR-Football-Dataset carries detailed stats -> also expose directly.\n        data.stats_matches.append(m)\n\n    # Brazilian_Cup_Matches.csv  (priority 0 for Copa do Brasil)\n    sr = SOURCE_RANK[COMP_COPA_BRASIL][\"brazilian_cup\"]\n    for r in cup_rows:\n        add(mk_match(\n            date=r.get(\"datetime\"), season=r.get(\"season\"),\n            competition=COMP_COPA_BRASIL, round_or_stage=r.get(\"round\"),\n            home_team=r.get(\"home_team\"), away_team=r.get(\"away_team\"),\n            home_goals=r.get(\"home_goal\"), away_goals=r.get(\"away_goal\"),\n            source=\"Brazilian_Cup_Matches.csv\", source_rank=sr,\n        ))\n\n    # Libertadores_Matches.csv  (priority 0 for Libertadores)\n    sr = SOURCE_RANK[COMP_LIBERTADORES][\"libertadores\"]\n    for r in lib_rows:\n        add(mk_match(\n            date=r.get(\"datetime\"), season=r.get(\"season\"),\n            competition=COMP_LIBERTADORES, round_or_stage=r.get(\"stage\"),\n            home_team=r.get(\"home_team\"), away_team=r.get(\"away_team\"),\n            home_goals=r.get(\"home_goal\"), away_goals=r.get(\"away_goal\"),\n            source=\"Libertadores_Matches.csv\", source_rank=sr,\n        ))\n\n    # ---- Source-priority selection: per (competition, season) keep best rank.\n    best_rank: dict[tuple[str, str], int] = {}\n    for m in data.raw_matches:\n        if m.season is None or m.home_goals is None or m.away_goals is None:\n            continue\n        key = (m.competition, m.season)\n        if key not in best_rank or m.source_rank < best_rank[key]:\n            best_rank[key] = m.source_rank\n            data.season_sources.setdefault(key, set()).add(m.source)\n    for m in data.raw_matches:\n        if m.season is None or m.home_goals is None or m.away_goals is None:\n            continue\n        if m.source_rank == best_rank.get((m.competition, m.season)):\n            data.matches.append(m)\n\n    # ---- Players\n    _load_players(data, fifa_rows)\n\n    # ---- Team display index\n    for m in data.raw_matches:\n        data.team_display.setdefault(m.home_team, m.home_display)\n        data.team_display.setdefault(m.away_team, m.away_display)\n\n    return data\n\n\ndef _load_players(data: SoccerData, rows: list[dict]) -> None:\n    for r in rows:\n        club = (r.get(\"Club\") or \"\").strip() or None\n        club_canonical = data.normalizer.canonical(club) if club else None\n        player = Player(\n            id=r.get(\"ID\"),\n            name=(r.get(\"Name\") or \"\").strip() or None,\n            age=_to_int(r.get(\"Age\")),\n            nationality=(r.get(\"Nationality\") or \"\").strip() or None,\n            overall=_to_int(r.get(\"Overall\")),\n            potential=_to_int(r.get(\"Potential\")),\n            club=club,\n            club_canonical=club_canonical,\n            position=(r.get(\"Position\") or \"\").strip() or None,\n            jersey_number=r.get(\"Jersey Number\"),\n            height=(r.get(\"Height\") or \"\").strip() or None,\n            weight=(r.get(\"Weight\") or \"\").strip() or None,\n            preferred_foot=(r.get(\"Preferred Foot\") or \"\").strip() or None,\n            value=(r.get(\"Value\") or \"\").strip() or None,\n            wage=(r.get(\"Wage\") or \"\").strip() or None,\n            crossing=_to_int(r.get(\"Crossing\")),\n            finishing=_to_int(r.get(\"Finishing\")),\n            dribbling=_to_int(r.get(\"Dribbling\")),\n            shortpassing=_to_int(r.get(\"ShortPassing\")),\n            longshots=_to_int(r.get(\"LongShots\")),\n            defending=_to_int(r.get(\"Defending\")),\n            gkdiving=_to_int(r.get(\"GKDiving\")),\n            pace=_to_int(r.get(\"Pace\", r.get(\"Acceleration\"))),\n            shooting=_to_int(r.get(\"Shooting\")),\n            passing=_to_int(r.get(\"Passing\")),\n            dribbling2=_to_int(r.get(\"Dribbling.1\")),\n            defending2=_to_int(r.get(\"Defending.1\")),\n            physical=_to_int(r.get(\"Physical\")),\n        )\n        data.players.append(player)\n\n\n@lru_cache(maxsize=1)\ndef get_data(data_dir: str = DEFAULT_DATA_DIR) -> SoccerData:\n    \"\"\"Return the process-wide cached :class:`SoccerData` singleton.\"\"\"\n    return load_data(data_dir)\n\n\ndef reset_cache() -> None:\n    \"\"\"Clear the cached :class:`SoccerData` (used by tests).\"\"\"\n    get_data.cache_clear()","lineStart":1,"lineEnd":529,"totalLines":529,"truncated":false}},"title":"soccer_mcp/data_loader.py","time":{"start":1788373774827,"end":1788373774852}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_0636231b8001q1wQ0JFFp66zJI","sessionID":"ses_f9c9e1f2effeUE9mG9h5hx4Ni7","messageID":"msg_0636229f4001lITVhyePQuC67Y"}}
