timestamp=2026-08-01T01:58:37.325Z level=INFO run=ff7bdf63 message=evaluated permission=bash pattern="python3 -c \"\nimport pandas as pd\nfrom brazilian_soccer_mcp.data_loader import load_matches, _SOURCE_PRIORITY\nm = load_matches(dedupe=False)\nm = m.copy()\nm['_prio'] = m['source'].map(_SOURCE_PRIORITY).fillna(9)\nm = m.sort_values(['_prio','date'], kind='stable')\nm['_day'] = m['date'].dt.date\nm = m.drop_duplicates(subset=['_day','home_key','away_key','home_goals','away_goals'], keep='first').drop(columns=['_day'])\nm = m.drop_duplicates(subset=['competition','season','home_key','away_key','home_goals','away_goals'], keep='first')\nsub = m[(m.home_key=='criciuma sc') & (m.away_key=='sao paulo sp') & (m.season==2014)]\nprint(sub[['date','home_goals','away_goals','source','_prio']].to_string())\nseen = {}\nfor key, day in zip(zip(m['home_key'], m['away_key']), m['date']):\n    if key == ('criciuma sc','sao paulo sp'):\n        print('visit', key, day, 'prev:', seen.get(key))\n    prev = seen.get(key)\n    if prev is not None and abs((day - prev).days) <= 3:\n        if key == ('criciuma sc','sao paulo sp'): print('  DROP')\n    else:\n        seen[key] = day\n\"" action.permission=bash action.action=allow action.pattern=*
