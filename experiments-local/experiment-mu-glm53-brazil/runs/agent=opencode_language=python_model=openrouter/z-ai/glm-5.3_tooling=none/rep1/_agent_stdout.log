n# Alisson\np, t = store.player_search(name=\"Alisson\", limit=5)\nprint(\"Alisson:\", [(x.name, x.club, x.overall, x.position) for x in p])\n\n# Gabriel Barbosa (not in data)\np, t = store.player_search(name=\"Gabriel Barbosa\", limit=5)\nprint(\"Gabriel Barbosa:\", t)\n\n# last Flamengo vs Corinthians match\nmatches, total = store.find_matches(team=\"Flamengo\", opponent=\"Corinthians\", limit=1)\nprint(\"\\nLast Fla x Corinthians:\", matches[0].label() if matches else None)\n\n# 2023 derbies count\nd = store.derbies(season=2023)\nprint(\"2023 derbies:\", {k: len(v) for k, v in d.items()})\nEOF","timeout":120000},"output":"Corinthians 2022 home: {'team': 'Corinthians', 'matches': 29, 'wins': 18, 'draws': 7, 'losses': 4, 'goals_for': 41, 'goals_against': 15, 'goal_diff': 26, 'points': 61, 'win_rate': 62.1}\nCorinthians 2022 overall: {'matches': 58, 'wins': 24, 'draws': 20, 'losses': 14, 'goals_for': 66, 'goals_against': 51}\n\nCopa 2012 finals: [(datetime.date(2012, 7, 11), 'Coritiba', 1, 1, 'Palmeiras', '6'), (datetime.date(2012, 7, 5), 'Palmeiras', 2, 0, 'Coritiba', '6')]\nLib 2019 finals: [(datetime.date(2019, 11, 23), 'Flamengo', 2, 1, 'River Plate')]\n\nBiggest wins:\n   2021-06-08 São Paulo 9 - 1 4 de Julho-EC | Copa do Brasil\n   2017-09-21 River Plate 8 - 0 Jorge Wilstermann | Copa Libertadores\n   2020-03-11 River Plate 8 - 0 Binacional | Copa Libertadores\n   2017-09-09 Joinville 8 - 1 Mogi Mirim | Brasileirão Série C\n   2020-11-28 Brusque 1 - 8 Volta Redonda | Brasileirão Série C\n\nSérie A goals: {'matches': 8404, 'total_goals': 21574, 'avg_goals_per_match': 2.57, 'avg_home_goals': 1.54, 'avg_away_goals': 1.03, 'home_win_rate': 49.7, 'away_win_rate': 23.8, 'draw_rate': 26.5}\n\nBest away records: [('Palmeiras', 1.33), ('Flamengo', 1.31), ('Cruzeiro', 1.27), ('Vila Nova', 1.27), ('São Paulo', 1.26)]\n\nFla-Flu: 18 14 12 matches: 44\nBrazilians in FIFA data: 827\nAlisson: [('Alisson', 'Liverpool', 85, 'GK')]\nGabriel Barbosa: 0\n\nLast Fla x Corinthians: