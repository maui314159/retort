timestamp=2026-08-31T19:36:42.123Z level=INFO run=532d90f3 message=evaluated permission=bash pattern="venv/bin/python -c \"\nfrom bsoccer.queries import KnowledgeBase\nimport time\nkb = KnowledgeBase()\n\n# standings\ns = kb.standings('Brasileirão', 2019)\nprint('2019 top3:', [(e['position'], e['team'], e['points']) for e in s['standings'][:3]], '| source:', s['source_file'], '| used:', s['matches_used'])\nprint('relegated:', [(e['position'], e['team']) for e in s['standings'][-4:]])\ns = kb.standings('brasileirao', 2012)\nprint('2012 champ:', s['standings'][0]['team'], s['standings'][0]['points'], '| source:', s['source_file'])\n\n# cup finals\nr = kb.search_matches(competition='Copa do Brasil', stage='final')\nprint('cup finals:', r['count'], [(m['season'], m['home_team'], m['away_team']) for m in r['matches'][:4]])\nr = kb.search_matches(competition='Libertadores', stage='final')\nprint('lib finals:', r['count'], [(m['season'], m['home_team'], m['away_team']) for m in r['matches'][:3]])\n\n# team stats dedupe check\nr = kb.team_statistics('Corinthians', season=2022)\nprint('Corinthians 2022:', r['overall'])\nr = kb.team_statistics('Palmeiras-SP', season=2023)\nprint('Palmeiras 2023:', r['overall'], r['by_competition'].keys())\n\n# perf\nt0=time.time(); kb.search_matches(team='Flamengo', opponent='Corinthians'); print(f'simple lookup {time.time()-t0:.3f}s')\nt0=time.time(); kb.standings('brasileirao', 2012); print(f'standings {time.time()-t0:.3f}s')\nt0=time.time(); kb.competition_statistics('brasileirão'); print(f'agg {time.time()-t0:.3f}s')\nr = kb.competition_statistics('brasileirão', 2023)\nprint('avg goals 2023:', r['average_goals_per_match'], 'matches:', r['match_count'])\n\"" action.permission=bash action.action=allow action.pattern=*
