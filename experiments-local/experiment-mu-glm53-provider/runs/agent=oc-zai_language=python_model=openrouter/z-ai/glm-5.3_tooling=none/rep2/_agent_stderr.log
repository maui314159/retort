timestamp=2026-09-01T14:53:10.571Z level=INFO run=bd57de6d message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport time\nt0 = time.time()\nfrom brazilian_soccer.data import load_dataset, SERIE_A\nds = load_dataset()\nprint(f\"load time: {time.time()-t0:.2f}s\")\nprint(\"matches:\", len(ds.matches), \"deduped:\", len(ds.deduped_matches), \"players:\", len(ds.players))\nprint(\"known teams:\", len(ds.known_teams), \"brazilian clubs:\", len(ds.brazilian_clubs))\n\ntable, meta = ds.league_table(SERIE_A, 2019)\nprint(\"2019 Serie A:\", meta)\nfor r in table[:3]: print(\"  \", ds.team_display(r.team), r.points, f\"{r.wins}W {r.draws}D {r.losses}L\")\nprint(\"bottom 2019:\", [(ds.team_display(r.team), r.points) for r in table[-4:]])\n\nsrc, pol = ds.canonical_source(SERIE_A, 2021)\nprint(\"2021 Serie A source:\", src, \"polluted:\", pol)\nsrc, pol = ds.canonical_source(SERIE_A, 2023)\nprint(\"2023 Serie A source:\", src, \"polluted:\", pol)\nsrc, pol = ds.canonical_source(SERIE_A, 2005)\nprint(\"2005 Serie A source:\", src, \"polluted:\", pol)\nsrc, pol = ds.canonical_source(SERIE_A, 2022)\nprint(\"2022 Serie A source:\", src, \"polluted:\", pol)\ntable, meta = ds.league_table(SERIE_A, 2022)\nprint(\"2022 top:\", ds.team_display(table[0].team), table[0].points, meta)\ntable, meta = ds.league_table(SERIE_A, 2023)\nprint(\"2023 top:\", ds.team_display(table[0].team), table[0].points, meta)\n# display names sanity\nfor k in ['flamengo','sao paulo','gremio','atletico mg','atletico pr','america mg','botafogo rj','vitoria ba','sport','cuiaba']:\n    print(k, '->', ds.team_display(k))\nEOF" action.permission=bash action.action=allow action.pattern=*
