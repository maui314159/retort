timestamp=2026-08-31T19:38:20.245Z level=INFO run=615f6cc2 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv\n# Unique tournaments in BR-Football\nwith open('data/kaggle/BR-Football-Dataset.csv', encoding='utf-8') as f:\n    r = csv.DictReader(f)\n    tourns = {}\n    n = 0\n    for row in r:\n        tourns[row['tournament']] = tourns.get(row['tournament'], 0) + 1\n        n += 1\nprint(\"BR-Football rows:\", n)\nfor t, c in sorted(tourns.items(), key=lambda x: -x[1]): print(f\"  {t!r}: {c}\")\nEOF" action.permission=bash action.action=allow action.pattern=*
timestamp=2026-08-31T19:38:23.924Z level=INFO run=615f6cc2 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, re\n# Date format survey across files\ndef survey(path, col, enc='utf-8'):\n    pats = {}\n    with open(path, encoding=enc) as f:\n        for row in csv.DictReader(f):\n            v = (row.get(col) or '').strip()\n            if not v: continue\n            p = re.sub(r'\\d', '#', v)\n            pats[p] = pats.get(p, 0) + 1\n    return sorted(pats.items(), key=lambda x: -x[1])[:8]\n\nprint(\"Brasileirao:\", survey('data/kaggle/Brasileirao_Matches.csv', 'datetime'))\nprint(\"Cup:\", survey('data/kaggle/Brazilian_Cup_Matches.csv', 'datetime'))\nprint(\"Lib:\", survey('data/kaggle/Libertadores_Matches.csv', 'datetime'))\nprint(\"BR-Foot:\", survey('data/kaggle/BR-Football-Dataset.csv', 'date'))\nprint(\"Novo:\", survey('data/kaggle/novo_campeonato_brasileiro.csv', 'Data'))\nEOF" action.permission=bash action.action=allow action.pattern=*
