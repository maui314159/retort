timestamp=2026-08-31T18:39:54.200Z level=INFO run=9abcf33e message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv, re\n\ndef load(path):\n    with open(path, encoding='utf-8') as f:\n        return list(csv.DictReader(f))\n\nrows = load('data/kaggle/BR-Football-Dataset.csv')\nteams = set()\nfor r in rows:\n    teams.add(r['home']); teams.add(r['away'])\nprint(\"BR-Football teams:\", len(teams))\nsuffix_pattern = re.compile(r'^(\\D+)[\\s-]+((?:RJ|SP|MG|PR|RS|SC|PE|BA|CE|GO|MT|MS|PA|PB|RN|AL|SE|PI|MA|TO|RO|RR|AC|AP|AM|DF|ES))$')\nspaced = sorted(t for t in teams if suffix_pattern.match(t))\nprint(\"teams with state suffix (space or dash):\", spaced[:40])\nbig = ['Palmeiras','Flamengo','Corinthians','Sao Paulo','Gremio','Vasco','Cruzeiro','Atletico Mineiro','Atletico-MG','Internacional','Fluminense','Botafogo','Santos','Bahia','Sport','Fortaleza','Athletico-PR','Ceara','Goias','Vitoria','Chapecoense','Avai','Cuiaba','Bragantino','Athletico']\nprint(\"\\nbig club variants found:\", sorted(t for t in teams if any(b.lower() in t.lower() for b in big)))\n\nlib = load('data/kaggle/Libertadores_Matches.csv')\nlibteams = set()\nfor r in lib:\n    libteams.add(r['home_team']); libteams.add(r['away_team'])\nprint(\"\\nLibertadores suffix variants:\")\npat = re.compile(r'-([A-Z]{3})$')\nprint(\" -3letter:\", sorted(t for t in libteams if pat.search(t))[:30])\npat2 = re.compile(r'\\(([A-Z]{2,3})\\)$')\nprint(\" (XX):\", sorted(t for t in libteams if pat2.search(t))[:30])\nprint(\"\\nAll Libertadores teams:\", sorted(libteams))\nEOF" action.permission=bash action.action=allow action.pattern=*
