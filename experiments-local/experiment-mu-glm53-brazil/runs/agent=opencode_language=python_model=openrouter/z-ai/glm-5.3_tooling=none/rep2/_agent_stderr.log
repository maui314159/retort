timestamp=2026-08-31T19:22:31.550Z level=INFO run=ec94ecf4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport anyio, asyncio\nfrom contextlib import suppress\nfrom mcp import ClientSession\nfrom mcp.shared.memory import create_client_server_memory_streams\nfrom brazilian_soccer_mcp import server as srv\nfrom brazilian_soccer_mcp.service import SoccerDataService\n\nservice = SoccerDataService(\"data/kaggle\")\nsrv.get_service = lambda: service\n\nasync def main():\n    lowlevel = srv.mcp._lowlevel_server\n    async with create_client_server_memory_streams() as (client_streams, server_streams):\n        server_task = asyncio.create_task(\n            lowlevel.run(server_streams[0], server_streams[1],\n                         lowlevel.create_initialization_options(), raise_exceptions=True)\n        )\n        try:\n            async with ClientSession(*client_streams) as session:\n                await session.initialize()\n                res = await session.call_tool(\"resolve_team\", {\"name\": \"Palmeiras\"})\n                print(\"is_error:\", res.is_error)\n                for c in res.content[:2]:\n                    print(\"content item:\", type(c).__name__, getattr(c, \"text\", \"\")[:200])\n                print(\"structured:\", res.structured_content)\n        finally:\n            server_task.cancel()\n            with suppress(asyncio.CancelledError):\n                await server_task\n\nanyio.run(main)\nEOF" action.permission=bash action.action=allow action.pattern=*
