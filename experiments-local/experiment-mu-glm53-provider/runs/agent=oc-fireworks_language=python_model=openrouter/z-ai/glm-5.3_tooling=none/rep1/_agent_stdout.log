andidate[\"stats\"] = existing.get(\"stats\")\n+                    _backfill(candidate, existing)\n                     kept[duplicate_of] = candidate\n                 else:\n-                    for field_name in (\"round\", \"stage\", \"venue\", \"stats\"):\n-                        if existing.get(field_name) is None:\n-                            existing[field_name] = candidate.get(field_name)\n+                    _backfill(existing, candidate)\n         kept_rows.extend(kept)\n     return kept_rows\n \n \n+def _backfill(target: dict, donor: dict) -> None:\n+    \"\"\"Copy round/stage/venue/stats into target where target is missing.\"\"\"\n+    for field_name in (\"round\", \"stage\", \"venue\", \"stats\"):\n+        if target.get(field_name) is None:\n+            target[field_name] = donor.get(field_name)\n+\n+\n+def _best_league_row(group: list[dict]) -> dict:\n+    \"\"\"Highest-priority row with a final score; round/venue back-filled.\"\"\"\n+    best = None\n+    for candidate in group:  # already sorted by source priority\n+        if (candidate[\"home_goals\"], candidate[\"away_goals\"]) != (None, None):\n+            best = candidate\n+            break\n+    if best is None:\n+        best = group[0]\n+    else:\n+        best = dict(best)\n+        for other in group:\n+            if other is best or other == group[0] and other is not best:\n+                continue\n+            _backfill(best, other)\n+    return best\n+\n+\n+def _drop_mislabeled_league_rows(rows: list[dict]) -> list[dict]:\n+    \"\"\"\n+    BR-Football occasionally tags Série B fixtures as \"Serie A\" (e.g. the\n+    relegated Botafogo/Coritiba/Goiás/Vasco appear 10-12 times in its 2021\n+    \"Serie A\" while also playing full Série B seasons).  When a season of a\n+    league is covered by a primary source (Brasileirao_Matches /\n+    novo_campeonato_brasileiro), BR-Football league rows featuring clubs the\n+    primary source never fields in that season are dropped as mislabels.\n+    \"\"\"\n+    primary_participants: dict[tuple[str, int], set[str]] = defaultdict(set)\n+    for row in rows:\n+        if row[\"source\"] in (\"Brasileirao_Matches.csv\",\n+                             \"novo_campeonato_brasileiro.csv\"):\n+            key = (row[\"competition\"], row[\"season\"])\n+            primary_participants[key].add(row[\"home_key\"])\n+            primary_participants[key].add(row[\"away_key\"])\n+\n+    kept: list[dict] = []\n+    for row in rows:\n+        if (row[\"source\"] == \"BR-Football-Dataset.csv\"\n+                and row[\"competition\"] in _LEAGUE_COMPETITIONS):\n+            key = (row[\"competition\"], row[\"season\"])\n+            participants = primary_participants.get(key)\n+            if participants is not None and (\n+                    row[\"home_key\"] not in participants\n+                    or row[\"away_key\"] not in participants):\n+                continue  # mislabeled fixture: club not in that league season\n+        kept.append(row)\n+    return kept\n+\n+\n # --------------------------------------------------------------------------\n # Registry\n # --------------------------------------------------------------------------\n \n","filediff":{"file":"/Users/maui/.retort/work/retort-local-7ooj92cj/retort-7a36b7336902/brazilian_soccer_mcp/loader.py","patch":"Index: /Users/maui/.retort/work/retort-local-7ooj92cj/retort-7a36b7336902/brazilian_soccer_mcp/loader.py\n===================================================================\n--- /Users/maui/.retort/work/retort-local-7ooj92cj/retort-7a36b7336902/brazilian_soccer_mcp/loader.py\n+++ /Users/maui/.retort/work/retort-local-7ooj92cj/retort-7a36b7336902/brazilian_soccer_mcp/loader.py\n@@ -378,12 +378,17 @@\n def _dedup(rows: list[dict]) -> list[dict]:\n     \"\"\"\n     Merge duplicate fixtures.\n \n-    Leagues: exactly one row survives per (competition, season, home, away)\n-    orientation - the highest-priority source that has a final score.\n-    Cups: rows merge only on score-match + <=2 day date distance, because\n-    the same pairing can legitimately repeat in later rounds.\n+    Leagues (double round-robin): exactly one row survives per (competition,\n+    season, home, away) orientation - the highest-priority source that has a\n+    final score, with round/venue gaps back-filled from dropped siblings.\n+    Score disagreements between sources (e.g. BR-Football vs Brasileirão)\n+    are resolved in favour of the primary source.\n+\n+    Cups: rows merge only on score-match (or one side unplayed) AND dates\n+    within two days, because the same pairing can legitimately repeat in\n+    later rounds.\n     \"\"\"\n     groups: dict[tuple, list[dict]] = defaultdict(list)\n     for row in rows:\n         groups[(row[\"competition\"], row[\"season\"],\n@@ -392,13 +397,16 @@\n     kept_rows: list[dict] = []\n     for group in groups.values():\n         group.sort(key=_sort_key)\n         league = group[0][\"competition\"] in _LEAGUE_COMPETITIONS\n+        if league:\n+            kept_rows.append(_best_league_row(group))\n+            continue\n         kept: list[dict] = []\n         for candidate in group:\n             duplicate_of = None\n             for index, existing in enumerate(kept):\n-                if _same_fixture(existing, candidate, league):\n+                if _same_fixture(existing, candidate, league=False):\n                     duplicate_of = index\n                     break\n             if duplicate_of is None:\n                 kept.append(candidate)\n@@ -407,22 +415,72 @@\n                 # Prefer a played row over an unplayed one.\n                 if (existing[\"home_goals\"], existing[\"away_goals\"]) == (None, None) and \\\n                         (candidate[\"home_goals\"], candidate[\"away_goals\"]) != (None, None):\n                     candidate = dict(candidate)\n-                    for field_name in (\"round\", \"stage\", \"venue\"):\n-                        if candidate.get(field_name) is None:\n-                            candidate[field_name] = existing.get(field_name)\n-                    if candidate.get(\"stats\") is None:\n-                        candidate[\"stats\"] = existing.get(\"stats\")\n+                    _backfill(candidate, existing)\n                     kept[duplicate_of] = candidate\n                 else:\n-                    for field_name in (\"round\", \"stage\", \"venue\", \"stats\"):\n-                        if existing.get(field_name) is None:\n-                            existing[field_name] = candidate.get(field_name)\n+                    _backfill(existing, candidate)\n         kept_rows.extend(kept)\n     return kept_rows\n \n \n+def _backfill(target: dict, donor: dict) -> None:\n+    \"\"\"Copy round/stage/venue/stats into target where target is missing.\"\"\"\n+    for field_name in (\"round\", \"stage\", \"venue\", \"stats\"):\n+        if target.get(field_name) is None:\n+            target[field_name] = donor.get(field_name)\n+\n+\n+def _best_league_row(group: list[dict]) -> dict:\n+    \"\"\"Highest-priority row with a final score; round/venue back-filled.\"\"\"\n+    best = None\n+    for candidate in group:  # already sorted by source priority\n+        if (candidate[\"home_goals\"], candidate[\"away_goals\"]) != (None, None):\n+            best = candidate\n+            break\n+    if best is None:\n+        best = group[0]\n+    else:\n+        best = dict(best)\n+        for other in group:\n+            if other is best or other == group[0] and other is not best:\n+                continue\n+            _backfill(best, other)\n+    return best\n+\n+\n+def _drop_mislabeled_league_rows(rows: list[dict]) -> list[dict]:\n+    \"\"\"\n+    BR-Football occasionally tags Série B fixtures as \"Serie A\" (e.g. the\n+    relegated Botafogo/Coritiba/Goiás/Vasco appear 10-12 times in its 2021\n+    \"Serie A\" while also playing full Série B seasons).  When a season of a\n+    league is covered by a primary source (Brasileirao_Matches /\n+    novo_campeonato_brasileiro), BR-Football league rows featuring clubs the\n+    primary source never fields in that season are dropped as mislabels.\n+    \"\"\"\n+    primary_participants: dict[tuple[str, int], set[str]] = defaultdict(set)\n+    for row in rows:\n+        if row[\"source\"] in (\"Brasileirao_Matches.csv\",\n+                             \"novo_campeonato_brasileiro.csv\"):\n+            key = (row[\"competition\"], row[\"season\"])\n+            primary_participants[key].add(row[\"home_key\"])\n+            primary_participants[key].add(row[\"away_key\"])\n+\n+    kept: list[dict] = []\n+    for row in rows:\n+        if (row[\"source\"] == \"BR-Football-Dataset.csv\"\n+                and row[\"competition\"] in _LEAGUE_COMPETITIONS):\n+            key = (row[\"competition\"], row[\"season\"])\n+            participants = primary_participants.get(key)\n+            if participants is not None and (\n+                    row[\"home_key\"] not in participants\n+                    or row[\"away_key\"] not in participants):\n+                continue  # mislabeled fixture: club not in that league season\n+        kept.append(row)\n+    return kept\n+\n+\n # --------------------------------------------------------------------------\n # Registry\n # --------------------------------------------------------------------------\n \n","additions":71,"deletions":13},"truncated":false},"title":"brazilian_soccer_mcp/loader.py","time":{"start":1788242222260,"end":1788242222263}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Wait — the columns are misaligned in my print (W column shows points-ish 63/57 because I stored [P, PTSfromwins?, ...] — my array is [P,W,D,L,GF,GA,GD,PTS] but I incremented t[h][1] by 3 on wins (wrong index usage: I did `t[h][1]+=3` which should be `t[h][1]+=1` for wins... in this debug script W column = 3×wins). Regardless — PTS: Grêmio 68, Palmeiras 67 (37 games), Atlético/Flamengo 66, Botafogo 64.\n\nSo the brf 2023 raw data itself yields Grêmio 68 > Palmeiras 67. Real 2023: Palmeiras 82? That's FAR off — meaning brf 2023 \"Serie A\" is NOT the real full 2023 season!! 68 pts for a champion is implausibly low... unless this is actually Série B 2023 mislabeled?? No — the teams are Série A 2023 teams (Coritiba, América-MG relegated 2023 ✓, Santos relegated 2023 ✓ — bottom 3-4 = América 24, Coritiba 30, Santos 43, Vasco 42?? Real 2023 relegated: Coritiba, América, Santos + Vasco (Vasco survived via... no — 2023 relegated four: Coritiba (30?), América (24?), Santos (43!) and Vasco (42)?? Santos relegated with 43 pts in 2023 — YES that's real! And Vasco 42 survived — Vasco beat... hmm 2023: Z4 was Coritiba, América, Santos, Goiás?? No — Goiás 39... \n\nReal 2023 Série A final table (checking my memory): 1. Palmeiras 82? — but data says Palmeiras 67 with 37 games. Points totals in data look like roughly 3/4 of a season... 377 matches ≈ 99% of 380. Yet champion has 68 pts. In a full 38-round season the champion typically has 75-85. 68 pts + Grêmio W column = 63/3 = 21 wins?? (63/3=21W, 5D, 12L → 68 pts ✓). Palmeiras 57/3=19W 10D 8L=67 ✓ with 37 games. So data says Grêmio 2023: 21W 5D 12L. Real Grêmio 2023: 21W 9D 8L = 72? close-ish but draws/losses differ.\n\nConclusion: **brf's 2023 \"Serie A\" is a distorted/corrupted season** (some matches wrong or duplicated with wrong scores). It's the only source for 2023 — garbage in, garbage out. Our tool honestly reports what the data says. For tests: assert 2023 standings returns 20 rows and works, and note the data-quality caveat; DON'T assert Palmeiras-champion. Actually — wait. Let me double check whether brf 2023 has duplicate fixtures with different scores (e.g., same pairing 3+ times). Per-team games: all 37-38 — so no dupes. But could individual match RESULTS be wrong? E.g. draws recorded as wins? The sum: total PTS = 68+67+66+66+64+61+56+55+54+54+52+51+48+47+44+43+42+39+30+24 = let me not sum. Real 2023 total goals/match ~2.5. This data: GF sums... whatever.\n\nHmm, actually — hold on. Let me reconsider: maybe brf 2023 rows are fine but represent... Let me spot-check a famous 2023 result: Palmeiras vs Flamengo? Or check rounds: brf has no round column. Spot-check \"Coritiba 2023\": Coritiba won only 6 games (24/... W=24/3=8? the W column for Coritiba = 24 → 8W). Real Coritiba 2023: 5W? Coritiba was awful ✓ plausible. Santos 2023: 11W 43 pts relegated ✓ REAL (Santos relegated with 43). América-MG 2023: 8W 24 pts ✓ REAL (América 2023: 4W? they had 15 pts? hmm — América 2023 was historically bad: 24 pts? They finished with 24? I recall 4 wins... eh). Botafogo 2023: 64 pts — real Botafogo 2023: led most of season, collapsed, finished 5th with 64? Botafogo 2023 real: 64 pts?? I recall Botafogo finished 5th with 64? Hmm — actually I recall 5th place Botafogo 64?? Plausible! Atlético-MG 2023 real: 66? no... Atlético 2023 finished 3rd?? hmm — real 2023: 1 Palmeiras, 2 Grêmio, 3 Atlético-MG?, 4 Flamengo?... \n\nWAIT. Real 2023 champion Palmeiras had 82 pts. Data says 67. But everything ELSE looks right-ish (Santos 43 relegated ✓, Coritiba/América bottom ✓). A champion with 67 vs real 82 — that's 15 pts missing = 5 wins flipped. Hmm — OR: my memory of \"82\" is wrong! Let me verify differently: 2023 Palmeiras — 12th title, Endrick farewell... points: 82? 80? Actually I now recall 2023 Palmeiras: W24 D10 L4 → 82. Data: 19W 10D 8L (37 games). Hmm 24W→19W = 5 wins missing... AND 1 game missing (37). \n\nHmm hold on — is it possible brf 2023 is missing matches for SOME teams but has EXTRA phantom matches for others? All teams 37-38 games. Total 377 (380-3). If Palmeiras truly won 24 and data shows 19W — 5 matches recorded as losses/draws instead of wins?? That's systematic corruption... OR maybe brf 2023 rows contain SOME 2022 results mixed in (2022 Palmeiras: champion with 81 — no...). \n\nAlternatively — is the data actually 2023 **Série B**?? 2023 Série B champion: Botafogo?? no — 2023 Série B: champion Guarani? no... 2023 Série B champion was... Guarani no. It was **Botafogo-SP?** no. 2023 Série B champion: **Guarani**? I don't recall. The team list has Grêmio/Palmeiras/Flamengo — definitely Serie A teams. OK.\n\nLet me try yet another check: count brf 2023 matches per month; a real season runs Apr-Dec. And cross-check a known result: 2023 Flamengo vs Palmeiras... I can't reliably. \n\nDECISION: This is source data quality, not my pipeline. The right engineering response: report what the data says (standings from data), and expose a per-source view so a skeptic can verify. My standings tool already cites matches_counted. For TESTS, assert the computed values from the data (e.g., 2023 rows == 20, champion is what data says) — and use 2019/2018/2020 (multi-source, bras-primary) for the headline \"who won\" assertions where I've verified reality alignment: 2019 Flamengo 90 ✓ (matches spec!), 2018 Palmeiras 80 (data said 86? earlier scratch said 2018 champ Palmeiras 86 pts — hmm real 2018 Palmeiras: 80 pts (23W 11D 4L). Data says 86?? Let me check — earlier full-scratch printed \"2018 champ: [('palmeiras|SP', [40, 25, 11, 4, 58, 38, 0, 86])]\" — 40 matches! Now with fixes, 2018 = 380 matches so Palmeiras should be 38 games. Let me re-verify 2018 and 2020 tables now with the current fixed loader before writing tests. Also 2021 needs the mislabel fix.\n\nPlan:\n1. Fix league dedup (one per orientation, ignore score conflicts).\n2. Add participation filter: brf league rows for a season dropped when primary (bras/novo) covers that season AND the club isn't a primary participant that season. Only applies to serie_a (bras/novo are primary). Implementation point: in _dedup? Better in _raw_rows post-processing or as a pre-step in load_dataset: build participant sets for serie_a seasons from bras+novo rows; then drop brf rows (competition in LEAGUES & source brf... actually only serie_a has primary) where season in primary-covered seasons AND (home_key or away_key not in participants). Note: must run AFTER key resolution (pass 2) — do it right before _dedup.\n   Edge: 2022 — bras covers 2022, participants include all 20 (incl NA rows) ✓ brf played rows kept. 2021: bras covers; botafogo NOT in bras 2021 → brf 2021 phantom rows dropped ✓. 2014-2019: brf rows for legit participants kept (score conflicts resolved by orientation rule favoring bras ✓).\n   What about serie_b/serie_c? Only brf → no primary → untouched ✓. Copa do Brasil: brf rows 2022-2023 (cup file ends 2021) — cup competition is not a league; phantom risk? Copa do Brasil 2022-2023 from brf — participants unknowable; leave as-is (already deduped by date/score).\n3. Re-verify 2014-2022 == 380 (2022=380? bras NA 81 + brf played merges → 380 ✓ expected), 2021 == 380, 2023 == 377 (data truth), 2009 == 379 or 380 (data truth).\n\nLet me implement both fixes now.","format":"unknown","index":0}]}},"id":"prt_05b8a9d38001CHM33HRr6KlO7G","sessionID":"ses_fa4988af5ffe6mID1MhYqXoot3","messageID":"msg_05b8a11dc001iwM0MCTw02q2TB"}}
