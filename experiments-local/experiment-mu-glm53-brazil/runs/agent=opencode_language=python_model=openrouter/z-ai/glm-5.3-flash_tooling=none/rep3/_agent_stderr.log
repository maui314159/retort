timestamp=2026-09-01T02:48:31.311Z level=INFO run=2973fea4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv\nfrom collections import Counter, defaultdict\n\ndef rows(p):\n    with open(p, newline='', encoding='utf-8-sig') as f:\n        return list(csv.DictReader(f))\n\nbrf = rows('data/kaggle/BR-Football-Dataset.csv')\nyears = defaultdict(lambda: [None, None])\nfor r in brf:\n    y = r['date'][:4]\n    lo, hi = years[r['tournament']]\n    years[r['tournament']] = [min(lo, y) if lo else y, max(hi, y) if hi else y]\nprint(\"BR-Football year ranges:\", dict(years))\nbad_goals = sum(1 for r in brf if not r['home_goal'].strip() or not r['away_goal'].strip())\nprint(\"empty goals:\", bad_goals, \"of\", len(brf))\n# duplicate (tournament, date, home, away)?\nk = Counter((r['tournament'], r['date'], r['home'], r['away']) for r in brf)\nprint(\"dup keys in BR-Football:\", sum(1 for c in k.values() if c > 1))\n\nnovo = rows('data/kaggle/novo_campeonato_brasileiro.csv')\nprint(\"novo dup (Ano, mand, visit):\", sum(1 for c in Counter((r['Ano'], r['Equipe_mandante'], r['Equipe_visitante']) for r in novo).values() if c > 1))\nprint(\"novo obs values:\", Counter(r.get('OBS','') for r in novo).most_common(3))\n\ncup = rows('data/kaggle/Brazilian_Cup_Matches.csv')\nprint(\"cup dup (season,date,home,away):\", sum(1 for c in Counter((r['season'], r['datetime'][:10], r['home_team'], r['away_team']) for r in cup).values() if c > 1))\n\nbr = rows('data/kaggle/Brasileirao_Matches.csv')\nprint(\"br dup (season,round,home,away):\", sum(1 for c in Counter((r['season'], r['round'], r['home_team'], r['away_team']) for r in br).values() if c > 1))\nprint(\"br empty goals:\", sum(1 for r in br if not r['home_goal'].strip() or not r['away_goal'].strip()))\nEOF" action.permission=bash action.action=allow action.pattern=*
