timestamp=2026-09-01T09:55:09.779Z level=INFO run=f27b5900 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv\n\ndef rows(p):\n    with open(p, encoding='utf-8') as f:\n        return list(csv.DictReader(f))\n\n# Team name variants across files for the same club\nb = rows('data/kaggle/Brasileirao_Matches.csv')\nc = rows('data/kaggle/Brazilian_Cup_Matches.csv')\nl = rows('data/kaggle/Libertadores_Matches.csv')\nbf = rows('data/kaggle/BR-Football-Dataset.csv')\nh = rows('data/kaggle/novo_campeonato_brasileiro.csv')\n\nprint(\"BRASILEIRAO team samples:\", sorted({r['home_team'] for r in b})[:8])\nprint(\"BRASILEIRAO seasons:\", sorted({r['season'] for r in b}))\nprint()\nprint(\"COPA team samples:\", sorted({r['home_team'] for r in c})[:8])\nprint(\"COPA rounds:\", sorted({r['round'] for r in c}, key=str)[:20])\nprint()\nprint(\"LIB stages:\", sorted({r['stage'] for r in l}, key=str))\nprint(\"LIB team samples:\", sorted({r['home_team'] for r in l})[:10])\nprint()\nprint(\"BRF tournaments:\", sorted({r['tournament'] for r in bf}))\nprint(\"BRF team samples:\", sorted({r['home'] for r in bf})[:10])\nprint()\nprint(\"HIST teams:\", sorted({r['Equipe_mandante'] for r in h})[:15])\nprint(\"HIST seasons:\", sorted({r['Ano'] for r in h}))\nprint()\n# goal value oddities\nfor name, rs, cols in [(\"bras\", b, ('home_goal','away_goal')), (\"copa\", c, ('home_goal','away_goal')), (\"lib\", l, ('home_goal','away_goal')), (\"hist\", h, ('Gols_mandante','Gols_visitante'))]:\n    bad = [r[cc] for r in rs for cc in cols if not r[cc].strip().isdigit()]\n    print(name, \"non-int goals:\", sorted(set(bad))[:10], \"count:\", len(bad))\n# date formats\nprint(\"bras dates:\", [r['datetime'] for r in b[:3]])\nprint(\"copa dates:\", [r['datetime'] for r in c[:3]])\nprint(\"lib dates:\", [r['datetime'] for r in l[:3]])\nprint(\"brf dates:\", [r['date'] for r in bf[:3]], \"times:\", [r['time'] for r in bf[:3]])\nprint(\"hist dates:\", [r['Data'] for r in h[:3]])\nEOF" action.permission=bash action.action=allow action.pattern=*
