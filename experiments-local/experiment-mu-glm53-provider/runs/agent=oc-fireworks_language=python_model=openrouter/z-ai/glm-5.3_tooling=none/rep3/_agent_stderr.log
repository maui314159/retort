timestamp=2026-09-01T10:21:38.949Z level=INFO run=f27b5900 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nfrom brsoccer.data import load_default\nfrom brsoccer import queries as q\n\nsd = load_default()\n\n# 2. relegation 2019 displays\nrows = q.relegation(sd, 'serie_a', 2019)\nprint(\"2019 relegated displays:\", [r.display for r in rows])\n# 5. displays\nfor k in (\"gremio\", \"sao paulo\", \"avai\", \"chapecoense\", \"csa\", \"cruzeiro\"):\n    print(f\"display {k!r} -> {sd.team_display(k)!r}\")\n# 3. standings 2016 played set\nt2016 = q.standings(sd, 'serie_a', 2016)\nprint(\"2016 played set:\", {r.played for r in t2016})\nt2015 = q.standings(sd, 'serie_a', 2015)\nprint(\"2015 played set:\", {r.played for r in t2015}, \"n:\", len(t2015))\n# 4. libertadores finals\nfins = [m for m in sd.matches_for_competition('libertadores') if m.stage == 'final']\nprint(\"LIB finals by season:\", sorted((m.season, str(m.date)) for m in fins))\n# 6. unplayed libertadores\nun = [m for m in sd.matches_for_competition('libertadores') if not m.played]\nprint(\"LIB unplayed:\", len(un), [(str(m.date), m.home, m.away) for m in un])\n# 7. Gabriel Barbosa full search\ngb = q.search_players(sd, name=\"Gabriel Barbosa\", limit=None)\nprint(\"Gabriel Barbosa matches:\", len(gb), [p.name for p in gb[:15]])\n# 9. club overview actual\ngroups = q.club_overview(sd)\nprint(\"club_overview groups:\", len(groups), [(g['display'], g['count'], round(g['avg_overall'],1)) for g in groups])\n# 1. derbies 2019 names\nd19 = q.derbies(sd, season=2019)\nprint(\"derbies 2019:\", [n for n, _ in d19])\ndall = q.derbies(sd)\nprint(\"derbies all names:\", [n for n, _ in dall])\nbavi = next(m for n, m in dall if n == \"Ba-Vi\")\nprint(\"Ba-Vi total:\", len(bavi), \"seasons:\", sorted({m.season for m in bavi}))\nEOF" action.permission=bash action.action=allow action.pattern=*
