timestamp=2026-09-01T13:30:56.299Z level=INFO run=d0d26016 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, re, unicodedata\nfrom datetime import datetime\n\nUF = {'AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'}\ndef base(name):\n    n = unicodedata.normalize('NFKD', name).encode('ascii','ignore').decode().lower()\n    n = re.sub(r'\\(.*?\\)', ' ', n)\n    n = re.sub(r\"[^\\w\\s]\", ' ', n)\n    toks = [t for t in n.split() if t]\n    if toks and toks[-1].upper() in UF: toks = toks[:-1]\n    b = ''.join(toks)\n    aliases = {'vascodagama':'vasco','atleticomineiro':'atleticomg','atleticoparanaense':'atleticopr','athletico':'atletico',\n               'sportclubdorecife':'sportpe','sportrecife':'sportpe','cearascar':'ceara','cearasc':'ceara',\n               'americafc':'americamg','americafcnatal':'americarn','internacional':'inter'}\n    # can't alias with state embedded; just see raw bases\n    return b\n\ndef parse_date(s):\n    s = s.strip()\n    for fmt in (\"%Y-%m-%d %H:%M:%S\", \"%Y-%m-%d\", \"%d/%m/%Y\"):\n        try: return datetime.strptime(s, fmt).date()\n        except ValueError: pass\n    return None\n\ndef load(path, cols):\n    out = []\n    with open(path, encoding='utf-8') as f:\n        for r in csv.DictReader(f):\n            out.append(r)\n    return out\n\nnovo = [r for r in load('data/kaggle/novo_campeonato_brasileiro.csv', None) if r['Ano']=='2015']\nbm = [r for r in load('data/kaggle/Brasileirao_Matches.csv', None) if r['season']=='2015']\n\nnovo_keys = {}\nfor r in novo:\n    k = (parse_date(r['Data']), base(r['Equipe_mandante']), base(r['Equipe_visitante']))\n    novo_keys[k] = (r['Gols_mandante'], r['Gols_visitante'])\nbm_keys = {}\nfor r in bm:\n    k = (parse_date(r['datetime']), base(r['home_team']), base(r['away_team']))\n    bm_keys[k] = (r['home_goal'], r['away_goal'])\n\n# how many dates+score-only match (ignoring team name)?\nnd = {}\nfor k,v in novo_keys.items():\n    nd[(k[0], k[1], k[2])] = v\ncommon_dates = set(k[0] for k in novo_keys) & set(k[0] for k in bm_keys)\nprint(\"novo 2015:\", len(novo_keys), \"bm 2015:\", len(bm_keys), \"common dates:\", len(common_dates))\n\n# date + home/away base containment match\nimport collections\nmatched = 0\nfor k in bm_keys:\n    # find novo key same date where base names match loosely\n    for nk in novo_keys:\n        if nk[0]==k[0]:\n            if (k[1] in nk[1] or nk[1] in k[1]) and (k[2] in nk[2] or nk[2] in k[2]):\n                matched += 1\n                break\nprint(\"loose matched:\", matched)\n\n# Show team name sets difference\nnn = set((base(r['Equipe_mandante']), base(r['Equipe_visitante'])) for r in novo)\nbn = set((base(r['home_team']), base(r['away_team'])) for r in bm)\nnteams = set(x for p in nn for x in p)\nbteams = set(x for p in bn for x in p)\nprint(\"novo-only team bases:\", sorted(nteams - bteams))\nprint(\"bm-only team bases:\", sorted(bteams - nteams))\nEOF" action.permission=bash action.action=allow action.pattern=*
