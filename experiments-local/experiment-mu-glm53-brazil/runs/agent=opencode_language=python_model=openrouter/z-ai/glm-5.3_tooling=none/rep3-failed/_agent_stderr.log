timestamp=2026-08-31T18:58:28.840Z level=INFO run=9abcf33e message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nfrom brazilian_soccer_mcp.queries import get_engine\ne = get_engine(\"data/kaggle\")\n\n# search matches fla-flu\nres = e.search_matches(team=\"Flamengo\", opponent=\"Fluminense\", competition=\"Brasileirão\")\nprint(\"Fla-Flu Brasileirão:\", res.total, \"matches; first:\", res.matches[0].date, res.matches[0].home_display, res.matches[0].home_goals, \"-\", res.matches[0].away_goals, res.matches[0].away_display, \"|\", res.matches[0].competition)\nassert all(m.competition.startswith(\"Brasileirão\") for m in res.matches)\n\n# libertadores final 2019\nres = e.search_matches(competition=\"Libertadores\", season=2019, stage=\"final\")\nprint(\"Lib 2019 final:\", [(m.date, m.home_display, m.home_goals, m.away_goals, m.away_display) for m in res.matches])\n\n# cup finals\nres = e.search_matches(competition=\"Copa do Brasil\", stage=\"final\")\nprint(\"Cup finals:\", res.total, [(m.season, m.home_display, m.home_goals, m.away_goals, m.away_display) for m in res.matches[:5]])\n\n# palmeiras 2023\nres = e.search_matches(team=\"Palmeiras\", season=2023)\nprint(\"Palmeiras 2023:\", res.total, \"matches, comps:\", {m.competition for m in res.matches})\n\n# h2h\nh = e.head_to_head(\"Flamengo\", \"Fluminense\")\nprint(\"H2H all comps:\", h.total, \"matches:\", h.team_a_wins, \"-\", h.draws, \"-\", h.team_b_wins)\nh = e.head_to_head(\"Flamengo\", \"Fluminense\", competition=\"Brasileirão\")\nprint(\"H2H Brasileirão:\", h.total, \"matches:\", h.team_a_wins, \"-\", h.draws, \"-\", h.team_b_wins)\n\n# team stats\nts = e.team_stats(\"Palmeiras\", season=2022, competition=\"Série A\")\nprint(\"Palmeiras 2022:\", ts.matches, ts.wins, ts.draws, ts.losses, ts.goals_for, ts.goals_against)\nts = e.team_stats(\"Corinthians\", season=2022, competition=\"Série A\", venue=\"home\")\nprint(\"Corinthians home 2022:\", ts.matches, ts.wins, ts.draws, ts.losses, ts.goals_for, ts.goals_against)\n\n# players\nbrs = e.search_players(nationality=\"Brazilian\", limit=5)\nprint(\"Top Brazilians:\", [(p.name, p.overall, p.club_display, p.position) for p in brs])\nfluminense = e.search_players(club=\"Fluminense\")\nprint(\"Fluminense players:\", len(fluminense))\nfwd = e.search_players(club=\"Santos\", position=\"forward\")\nprint(\"Santos forwards:\", [(p.name, p.position, p.overall) for p in fwd])\ntry:\n    e.search_players(name=\"Gabriel Barbosa\")\nexcept Exception as ex:\n    print(\"Gabriel Barbosa:\", type(ex).__name__, ex)\n\n# stats\ns = e.statistics(competition=\"Série A\", season=2019)\nprint(f\"2019 Serie A: {s.matches} matches, avg {s.avg_goals:.2f} goals, home win {s.home_win_rate:.1%}, draw {s.draw_rate:.1%}, away {s.away_win_rate:.1%}\")\nprint(\"biggest home win:\", s.biggest_home_win.date, s.biggest_home_win.home_display, s.biggest_home_win.home_goals, \"-\", s.biggest_home_win.away_goals, s.biggest_home_win.away_display)\n\nbw = e.biggest_wins(competition=\"Brasileirão\")\nprint(\"Biggest wins:\", [(m.date, m.home_display, f\"{m.home_goals}-{m.away_goals}\", m.away_display, m.competition) for m in bw[:5]])\n\n# derbies\nd = e.derbies(derby=\"Fla-Flu\")\nprint(\"Fla-Flu derby:\", d[0].total, \"matches\", d[0].team_a_wins, d[0].draws, d[0].team_b_wins)\nall_d = e.derbies()\nprint(\"Derbies found:\", [(x.derby.name, x.total) for x in all_d])\n\n# find team\nti = e.find_team(\"Timão\")\nprint(\"find Timão:\", ti.key, ti.display, ti.match_count, \"matches, players:\", ti.player_count, \"comps:\", list(ti.competitions)[:3])\nEOF" action.permission=bash action.action=allow action.pattern=*
