timestamp=2026-09-01T09:59:25.574Z level=INFO run=f27b5900 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv, re, unicodedata\nfrom collections import defaultdict, Counter\n\ndef rows(p):\n    with open(p, encoding='utf-8-sig') as f:\n        return list(csv.DictReader(f))\n\ndef deacc(s):\n    return ''.join(c for c in unicodedata.normalize('NFD', s) if not unicodedata.combining(c))\n\nbra = rows('data/kaggle/Brasileirao_Matches.csv')\ncupa = rows('data/kaggle/Brazilian_Cup_Matches.csv')\nlib = rows('data/kaggle/Libertadores_Matches.csv')\nbf = rows('data/kaggle/BR-Football-Dataset.csv')\nhist = rows('data/kaggle/novo_campeonato_brasileiro.csv')\n\n# All distinct raw team strings\nraw = Counter()\nfor r in bra: raw[r['home_team']]+=1; raw[r['away_team']]+=1\nfor r in cupa: raw[r['home_team']]+=1; raw[r['away_team']]+=1\nfor r in lib: raw[r['home_team']]+=1; raw[r['away_team']]+=1\nfor r in bf: raw[r['home']]+=1; raw[r['away']]+=1\nfor r in hist: raw[r['Equipe_mandante']]+=1; raw[r['Equipe_visitante']]+=1\nprint(\"total distinct raw team strings:\", len(raw))\n\n# base = accent-stripped lowercase, UF-suffix stripped\nUF = {'AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'}\ndef base_of(name):\n    s = deacc(name).lower().replace('.', ' ')\n    s = re.sub(r'\\s+', ' ', s).strip()\n    m = re.search(r'^(.*?)[\\s]*[-–]\\s*([a-z]{2})$', s)\n    if m and m.group(2).upper() in UF:\n        return m.group(1).strip(), m.group(2).upper()\n    return s, None\n\nbase2uf = defaultdict(set)\nuf_examples = defaultdict(dict)\nfor name in raw:\n    b, uf = base_of(name)\n    if uf:\n        base2uf[b].add(uf)\n        uf_examples[b].setdefault(uf, name)\n# bases with multiple UFs -> ambiguous\namb = {b: ufs for b, ufs in base2uf.items() if len(ufs) > 1}\nprint(\"\\nambiguous bases (multiple UFs):\")\nfor b, ufs in sorted(amb.items()):\n    print(f\"  '{b}': {sorted(ufs)} e.g. {[uf_examples[b][u] for u in sorted(ufs)][:4]}\")\n\n# how often do bases appear WITHOUT any uf suffix (bare)?\nbare = defaultdict(int)\nfor name, n in raw.items():\n    b, uf = base_of(name)\n    if uf is None:\n        bare[b] += n\nprint(\"\\ntop bare (no-UF) names:\", sorted(bare.items(), key=lambda x:-x[1])[:20])\nEOF" action.permission=bash action.action=allow action.pattern=*
