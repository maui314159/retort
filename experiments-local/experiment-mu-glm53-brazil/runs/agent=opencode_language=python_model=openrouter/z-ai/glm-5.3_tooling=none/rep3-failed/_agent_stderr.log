timestamp=2026-08-31T18:37:05.252Z level=INFO run=9abcf33e message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv\nfrom collections import Counter\n\n# Brasileirao matches\nwith open('data/kaggle/Brasileirao_Matches.csv', encoding='utf-8') as f:\n    rows = list(csv.DictReader(f))\nprint(\"Brasileirao:\", len(rows), \"matches, seasons:\", sorted(set(r['season'] for r in rows)))\nprint(\" sample teams:\", sorted(set(r['home_team'] for r in rows))[:10])\n\n# Copa do Brasil\nwith open('data/kaggle/Brazilian_Cup_Matches.csv', encoding='utf-8') as f:\n    rows2 = list(csv.DictReader(f))\nprint(\"\\nCopa do Brasil:\", len(rows2), \"matches, seasons:\", sorted(set(r['season'] for r in rows2)))\nprint(\" rounds:\", sorted(set(r['round'] for r in rows2), key=lambda x: str(x))[:20])\n\n# Libertadores\nwith open('data/kaggle/Libertadores_Matches.csv', encoding='utf-8') as f:\n    rows3 = list(csv.DictReader(f))\nprint(\"\\nLibertadores:\", len(rows3), \"matches, seasons:\", sorted(set(r['season'] for r in rows3)))\nprint(\" stages:\", sorted(set(r['stage'] for r in rows3)))\n\n# BR-Football\nwith open('data/kaggle/BR-Football-Dataset.csv', encoding='utf-8') as f:\n    rows4 = list(csv.DictReader(f))\nprint(\"\\nBR-Football:\", len(rows4), \"matches, tournaments:\", Counter(r['tournament'] for r in rows4))\nprint(\" dates sample:\", [r['date'] for r in rows4[:3]])\n\n# novo campeonato\nwith open('data/kaggle/novo_campeonato_brasileiro.csv', encoding='utf-8') as f:\n    rows5 = list(csv.DictReader(f))\nprint(\"\\nNovo:\", len(rows5), \"matches, years:\", sorted(set(r['Ano'] for r in rows5)))\nprint(\" sample:\", rows5[0])\nEOF" action.permission=bash action.action=allow action.pattern=*
