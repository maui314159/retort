(6,\"standings\",{\"competition\":\"Serie A\",\"season\":2023})[\"table\"][0][\"team\"], \"(incomplete data)\")\nprint(\"6 \", call(7,\"head_to_head\",{\"team_a\":\"Palmeiras\",\"team_b\":\"Santos\"})[\"summary\"][\"matches\"])\nprint(\"7 \", call(8,\"find_players\",{\"name\":\"Neymar\"})[\"players\"][0][\"overall\"])\nprint(\"8 \", call(9,\"top_players\",{\"nationality\":\"Brazil\",\"limit\":2})[\"players\"][0][\"name\"])\nprint(\"9 \", call(10,\"players_at_club\",{\"club\":\"Grêmio\"})[\"count\"])\nprint(\"10\", call(11,\"last_match\",{\"team\":\"Flamengo\",\"opponent\":\"Corinthians\"})[\"last_match\"][\"score\"])\nprint(\"11\", call(12,\"derby_matches\",{\"season\":2023})[\"derbies\"][0][\"derby\"])\nprint(\"12\", call(13,\"season_averages\",{\"competition\":\"brasileirão\"})[\"average_goals_per_match\"])\nprint(\"13\", call(14,\"biggest_wins\",{\"limit\":1})[\"matches\"][0])\nprint(\"14\", call(15,\"bracket\",{\"competition\":\"libertadores\",\"season\":2018})[\"rounds\"][0][\"round\"])\nprint(\"15\", call(16,\"resolve_team\",{\"name\":\"Athletico\"})[\"matches\"][0][\"club\"])\nprint(\"16\", call(17,\"match_statistics\",{\"team\":\"Flamengo\",\"season\":2023,\"limit\":1})[\"matches\"][0][\"statistics\"][\"corners\"])\nprint(\"17\", call(18,\"competition_info\",{})[\"competitions\"][\"Copa do Brasil\"][\"format\"])\nprint(\"18\", call(19,\"list_teams\",{\"competition\":\"serie a\",\"season\":2019})[\"team_count\"])\ntry:\n    call(20,\"standings\",{\"competition\":\"Copa do Brasil\",\"season\":2019})\nexcept AssertionError as e:\n    print(\"19 error path ok:\", \"bracket\" in str(e))\nprint(\"20\", call(21,\"team_profile\",{\"team\":\"Vasco\"})[\"competitions\"][\"Copa Libertadores\"][\"seasons\"][:3])\nproc.terminate(); proc.wait()\nprint(\"SMOKE OK\")\nEOF","timeout":180000},"output":"1  44\n2  43\n3  None\n4  {'matches': 15, 'wins': 10, 'draws': 4, 'losses': 1, 'goals_for': 21, 'goals_against': 7, 'win_rate': 66.7}\n5  Grêmio (incomplete data)\n6  41\n7  92