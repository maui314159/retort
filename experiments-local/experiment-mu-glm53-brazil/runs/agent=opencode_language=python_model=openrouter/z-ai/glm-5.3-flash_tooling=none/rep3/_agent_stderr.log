timestamp=2026-09-01T02:55:05.676Z level=INFO run=2973fea4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv, sys\nsys.path.insert(0, '.')\nfrom brazilian_soccer.normalize import TeamRegistry\n\ndef rows(p):\n    with open(p, newline='', encoding='utf-8-sig') as f:\n        return list(csv.DictReader(f))\n\nraws = set()\nfor r in rows('data/kaggle/Brasileirao_Matches.csv'):\n    raws.add(r['home_team']); raws.add(r['away_team'])\nfor r in rows('data/kaggle/Brazilian_Cup_Matches.csv'):\n    raws.add(r['home_team']); raws.add(r['away_team'])\nfor r in rows('data/kaggle/Libertadores_Matches.csv'):\n    raws.add(r['home_team']); raws.add(r['away_team'])\nfor r in rows('data/kaggle/novo_campeonato_brasileiro.csv'):\n    raws.add(r['Equipe_mandante']); raws.add(r['Equipe_visitante'])\nfor r in rows('data/kaggle/BR-Football-Dataset.csv'):\n    raws.add(r['home']); raws.add(r['away'])\n\nreg = TeamRegistry()\nfor raw in sorted(raws):\n    reg.register(raw)\nreg.finalize()\n\n# check big clubs resolve to single keys\nbig = [\"Palmeiras-SP\", \"Palmeiras\", \"Palmeiras - SP\", \"Sao Paulo-SP\", \"São Paulo\", \"Sao Paulo\",\n       \"Flamengo-RJ\", \"Flamengo - RJ\", \"Flamengo\", \"Athletico Paranaense\", \"Athletico-PR\", \"Atletico - PR\",\n       \"Atletico Mineiro\", \"Atlético - MG\", \"Atlético-MG\", \"Atletico-MG\", \"Atletico Goianiense\", \"Atlético-GO\",\n       \"Botafogo-RJ\", \"Botafogo - RJ\", \"Botafogo\", \"Botafogo - PB\", \"Botafogo SP\",\n       \"America - MG\", \"América-MG\", \"América - RN\", \"América-RN\", \"America MG\",\n       \"Santos\", \"Santos-SP\", \"Santos - AP\", \"Vasco\", \"Vasco da Gama-RJ\", \"Vasco Da Gama RJ\",\n       \"Internacional\", \"Internacional - SC\", \"Internacional-RS\", \"Vitoria\", \"Vitória - BA\", \"Vitoria ES\",\n       \"Gremio\", \"Grêmio - RS\", \"Gremio RS\", \"Corinthians-SP\", \"Corinthians\", \"Ceara\", \"Ceará - CE\",\n       \"Sport\", \"Sport-PE\", \"Sport Recife\", \"Fortaleza EC\", \"Fortaleza-CE\", \"Nacional (URU)\", \"Nacional-URU\", \"Nacional - AM\",\n       \"Guaraní (PAR)\", \"Guaraní-PAR\", \"Guarani-SP\", \"Guarani - CE\", \"Barcelona-EQU\", \"River Plate\", \"River Plate-URU\",\n       \"Red Bull Bragantino - SP\", \"Bragantino - PA\", \"Bragantino\", \"Red Bull Brasil\", \"A.b.c. - RN\", \"ABC\", \"Abc - RN\",\n       \"Juventude\", \"Juventude - MA\", \"Juventude-RS\", \"Operario - PR\", \"Operário - MS\", \"Operario Ferroviario Esporte C - PR\",\n       \"Sao Jose - POA\", \"São José - RS\", \"Sao Jose RS\", \"Ser Caxias - RS\", \"Caxias - RS\", \"Cuiaba\", \"Cuiaba MT\", \"Cuiabá - MT\",\n       \"Avaí - SC\", \"Avai-SC\", \"Avai\", \"Criciuma - SC\", \"Criciúma\", \"Chapecoense\", \"Chapecoense - SC\",\n       \"America FC Natal\", \"América de Natal - RN\", \"América de Cali\", \"Santa Cruz\", \"Santa Cruz - RN\", \"Santa Cruz-PE\",\n       \"Bragantino SP\", \"Bahia-BA\", \"EC Bahia\", \"Bahia\", \"CRB\", \"C.r.b. - AL\", \"CSA\", \"Csa-AL\", \"CS Alagoano\"]\ngroups = {}\nfor raw in big:\n    k = reg.key_for(raw)\n    groups.setdefault(k, []).append(raw)\nfor k in sorted(groups):\n    print(f\"{reg.display(k)!r:28} <- {groups[k]}\")\nEOF" action.permission=bash action.action=allow action.pattern=*
