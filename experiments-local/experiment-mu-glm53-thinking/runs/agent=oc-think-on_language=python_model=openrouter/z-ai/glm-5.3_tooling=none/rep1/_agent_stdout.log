 False) -> list[Match]:\n+def _load_br_football(self) -> list[Match]:\n     rows = _read_csv(self.data_dir / \"BR-Football-Dataset.csv\")\n     matches = []\n     for row in rows:\n         raw_home, raw_away = row[\"home\"], row[\"away\"]\n","additions":1,"deletions":1},"truncated":false},"title":"brazilian_soccer/data.py","time":{"start":1788277025163,"end":1788277025165}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05d9de89a001wKa6Z7BBYhCRLu","sessionID":"ses_fa26ff80dffeDQKLW66czjBP2c","messageID":"msg_05d9de36f001A1QWpq3QtWXC9o"}}
