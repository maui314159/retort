<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Brazilian Soccer MCP Server - BDD test project
    ===============================================
    Uses xUnit with Given/When/Then (GWT) structured tests, as the spec
    (Testing Approach) requests BDD scenarios. Tests load the real datasets
    and assert behaviour end-to-end through the SoccerDataStore and the MCP
    tool classes (no mocks).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <GitRepositoryConfigurationScope>local</GitRepositoryConfigurationScope>
    <EnableSourceLink>false</EnableSourceLink>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <DeterministicSourcePaths>false</DeterministicSourcePaths>
    <RootNamespace>BrazilianSoccerMcp.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrazilianSoccerMcp.csproj" />
  </ItemGroup>

</Project>
