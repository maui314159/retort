timestamp=2026-09-01T15:29:15.652Z level=INFO run=5e16c2b4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv, re, unicodedata, collections\ndef clean(n):\n    n = re.sub(r\"\\(.*?\\)\", \" \", n)\n    n = \"\".join(c for c in unicodedata.normalize(\"NFD\", n) if unicodedata.category(c)!=\"Mn\").lower()\n    return re.sub(r\"[-–]\\s*[A-Za-z]{2}$\", \"\", n).strip()\ngroups = collections.defaultdict(set)\nfiles = [(\"Brasileirao_Matches.csv\",\"home_team\"),(\"Brazilian_Cup_Matches.csv\",\"home_team\"),\n         (\"Libertadores_Matches.csv\",\"home_team\"),(\"BR-Football-Dataset.csv\",\"home\"),\n         (\"novo_campeonato_brasileiro.csv\",\"Equipe_mandante\")]\nfor f,col in files:\n    for row in csv.DictReader(open(\"data/kaggle/\"+f, encoding=\"utf-8-sig\")):\n        groups[clean(row[col])].add(row[col])\nfor base, names in sorted(groups.items()):\n    if len(names)>1 and len(base.split())<=2:\n        print(repr(base), sorted(names)[:6])\nEOF" action.permission=bash action.action=allow action.pattern=*
