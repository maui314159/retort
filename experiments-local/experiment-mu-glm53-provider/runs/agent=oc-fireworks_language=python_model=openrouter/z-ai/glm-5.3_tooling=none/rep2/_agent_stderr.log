timestamp=2026-09-01T05:59:47.231Z level=INFO run=f180ecb5 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv\nfrom brazilian_soccer.normalize import parse_name, fold, TeamRegistry\nbase='data/kaggle/'\nnames = set()\nfor r in csv.DictReader(open(base+'BR-Football-Dataset.csv', encoding='utf-8-sig')):\n    names.add(r['home']); names.add(r['away'])\nfor n in sorted(names):\n    p = parse_name(n)\n    if p.base != fold(n):\n        print(f'raw={n!r} -> base={p.base!r} state={p.state} pretty={p.pretty!r}')\nprint('---')\n# direct tests\nfor n in ('EC Bahia', 'Atletico Goianiense', 'Fortaleza FC', 'Atletico Mineiro', 'Sao Paulo', 'Bragantino'):\n    p = parse_name(n)\n    print(f'{n!r} -> base={p.base!r} state={p.state!r}')\nEOF" action.permission=bash action.action=allow action.pattern=*
