timestamp=2026-09-01T05:36:57.151Z level=INFO run=f180ecb5 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, collections\ndef peek(path, n=3):\n    with open(path, encoding='utf-8-sig') as f:\n        r = csv.reader(f)\n        header = next(r)\n        rows = [row for _, row in zip(range(n), r)]\n    print(path.split('/')[-1], header)\n    for row in rows: print('   ', row)\n\nbase='data/kaggle/'\npeek(base+'Brasileirao_Matches.csv')\npeek(base+'Brazilian_Cup_Matches.csv')\npeek(base+'Libertadores_Matches.csv')\npeek(base+'BR-Football-Dataset.csv')\npeek(base+'novo_campeonato_brasileiro.csv')\npeek(base+'fifa_data.csv')\n\n# seasons ranges\ndef seasons(path, col):\n    with open(path, encoding='utf-8-sig') as f:\n        r = csv.DictReader(f)\n        s = collections.Counter(row[col] for row in r)\n    return sorted(s.items())[:3], sorted(s.items())[-3:]\nprint('Brasileirao seasons:', seasons(base+'Brasileirao_Matches.csv','season'))\nprint('Cup seasons:', seasons(base+'Brazilian_Cup_Matches.csv','season'))\nprint('Lib seasons:', seasons(base+'Libertadores_Matches.csv','season'))\nprint('BR-Foot tournaments:', collections.Counter(\n    row['tournament'] for row in csv.DictReader(open(base+'BR-Football-Dataset.csv', encoding='utf-8-sig'))))\nEOF" action.permission=bash action.action=allow action.pattern=*
