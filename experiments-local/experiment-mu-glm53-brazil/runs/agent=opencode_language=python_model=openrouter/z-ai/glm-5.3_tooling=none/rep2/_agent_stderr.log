timestamp=2026-08-31T19:21:49.474Z level=INFO run=ec94ecf4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport anyio\nfrom mcp import ClientSession\nfrom mcp.shared.memory import create_client_server_memory_streams\nfrom brazilian_soccer_mcp import server as srv\n\nasync def main():\n    lowlevel = srv.mcp._lowlevel_server\n    async with create_client_server_memory_streams() as (client_streams, server_streams):\n        async with ClientSession(*client_streams) as session:\n            async with lowlevel.run(server_streams[0], server_streams[1],\n                                    lowlevel.create_initialization_options()):\n                await session.initialize()\n                tools = await session.list_tools()\n                print(\"tools:\", [t.name for t in tools.tools])\n                res = await session.call_tool(\"resolve_team\", {\"name\": \"Palmeiras\"})\n                print(\"structured:\", res.structuredContent)\n                res2 = await session.call_tool(\"standings\", {\"competition\": \"Brasileirão Série A\", \"season\": 2019})\n                champ = res2.structuredContent.get(\"champion\")\n                print(\"champion:\", champ)\n\nanyio.run(main)\nEOF" action.permission=bash action.action=allow action.pattern=*
