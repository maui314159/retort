timestamp=2026-08-31T19:00:07.844Z level=INFO run=ec94ecf4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv\nfrom collections import Counter\n\n# Check unique team names in each file\nfor path, cols in [\n    (\"data/kaggle/Brasileirao_Matches.csv\", [\"home_team\",\"away_team\"]),\n    (\"data/kaggle/Brazilian_Cup_Matches.csv\", [\"home_team\",\"away_team\"]),\n    (\"data/kaggle/Libertadores_Matches.csv\", [\"home_team\",\"away_team\"]),\n    (\"data/kaggle/BR-Football-Dataset.csv\", [\"home\",\"away\"]),\n    (\"data/kaggle/novo_campeonato_brasileiro.csv\", [\"Equipe_mandante\",\"Equipe_visitante\"]),\n]:\n    teams = Counter()\n    seasons = set()\n    with open(path, encoding=\"utf-8\") as f:\n        for row in csv.DictReader(f):\n            for c in cols:\n                teams[row[c]] += 1\n            s = row.get(\"season\") or row.get(\"Ano\") or row.get(\"date\",\"\")[:4]\n            seasons.add(str(s))\n    print(f\"== {path}: {len(teams)} unique teams, seasons: {sorted(seasons)[:5]}...{sorted(seasons)[-3:] if len(seasons)>5 else ''}\")\n    print(\"   sample:\", list(sorted(teams))[:8])\nEOF" action.permission=bash action.action=allow action.pattern=*
