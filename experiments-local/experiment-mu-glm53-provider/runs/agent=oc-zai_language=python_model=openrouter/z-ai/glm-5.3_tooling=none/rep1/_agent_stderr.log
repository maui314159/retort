timestamp=2026-09-01T04:25:29.174Z level=INFO run=1a470e0e message=evaluated permission=bash pattern="./venv/bin/python << 'EOF'\nimport csv, collections, unicodedata, re\n\ndef base_state(name):\n    name = re.sub(r'\\(.*?\\)', ' ', name)\n    m = re.search(r'\\s*-\\s*([A-Z]{2})\\s*$', name.strip())\n    state = None\n    if m:\n        state = m.group(1); name = name[:m.start()]\n    nk = unicodedata.normalize('NFKD', name)\n    b = ''.join(c for c in nk if not unicodedata.combining(c)).strip().lower()\n    return b, state\n\npairs = collections.Counter()\ndef scan(path, cols):\n    with open(path, encoding='utf-8') as f:\n        for row in csv.DictReader(f):\n            for c in cols:\n                if c in row and row[c]:\n                    b, s = base_state(row[c])\n                    pairs[(b, s)] += 1\n\nscan('data/kaggle/Brasileirao_Matches.csv', ['home_team'])\nscan('data/kaggle/Brazilian_Cup_Matches.csv', ['home_team'])\nscan('data/kaggle/Libertadores_Matches.csv', ['home_team'])\nscan('data/kaggle/BR-Football-Dataset.csv', ['home'])\nscan('data/kaggle/novo_campeonato_brasileiro.csv', ['Equipe_mandante'])\n\n# find base names with multiple states\nbybase = collections.defaultdict(set)\nfor (b, s), n in pairs.items():\n    if s: bybase[b].add(s)\ncoll = {b: sorted(s) for b, s in bybase.items() if len(s) > 1}\nprint('Base-name collisions:', coll)\nprint()\n# bases WITHOUT state (need checking)\nnostate = {b: n for (b,s),n in pairs.items() if s is None and n > 5}\nprint('No-state names (top):', dict(sorted(nostate.items(), key=lambda kv:-kv[1])[:25]))\nEOF" action.permission=bash action.action=allow action.pattern=*
