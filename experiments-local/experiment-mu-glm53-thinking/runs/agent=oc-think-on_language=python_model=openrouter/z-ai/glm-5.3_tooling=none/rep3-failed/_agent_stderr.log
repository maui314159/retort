timestamp=2026-09-01T17:16:12.297Z level=INFO run=a6cf503f message=evaluated permission=bash pattern="venv/bin/python -c \"\nfrom brazilian_soccer import load_soccer_data\nfrom brazilian_soccer.loader import BRASILEIRAO_A\nfrom collections import Counter, defaultdict\nd = load_soccer_data()\nprint('total matches:', len(d.matches))\nprint(Counter(m.competition for m in d.matches))\nprint()\n\n# Standings check vs known champions\ndef standing(season):\n    pts = defaultdict(int); t = defaultdict(lambda: [0,0,0,0,0])\n    for m in d.matches:\n        if m.competition == BRASILEIRAO_A and m.season == season and m.has_result:\n            h, a, hg, ag = m.home, m.away, m.home_goals, m.away_goals\n            t[h][3]+=hg; t[h][4]+=ag; t[a][3]+=ag; t[a][4]+=hg\n            if hg>ag: t[h][0]+=1; t[a][2]+=1; pts[h]+=3\n            elif hg<ag: t[a][0]+=1; t[h][2]+=1; pts[a]+=3\n            else: t[h][1]+=1; t[a][1]+=1; pts[h]+=1; pts[a]+=1\n    return sorted(pts.items(), key=lambda kv: -kv[1])\n\nknown = {2012:'Fluminense',2013:'Cruzeiro',2014:'Cruzeiro',2015:'Corinthians',2016:'Palmeiras',2017:'Corinthians',2018:'Palmeiras',2019:'Flamengo',2020:'Flamengo',2021:'Atlético-MG',2022:'Palmeiras',2023:'Palmeiras'}\nn = Counter(m.season for m in d.matches if m.competition == BRASILEIRAO_A)\nfor season in sorted(known):\n    table = standing(season)\n    top_id, top_pts = table[0]\n    print(f'{season}: matches={n[season]:5d}  top={d.display_team(top_id):20s} {top_pts:3d} pts  (expected {known[season]})')\n\"" action.permission=bash action.action=allow action.pattern=*
