 — approximate: use season+home and exclude BRFB by requiring round? just count from the brfile list only:\nbr = load('data/kaggle/Brasileirao_Matches.csv','home_team','away_team','home_goal','away_goal','datetime',iso,scol='season',comp='Serie A')\ncor = [m for m in br if m[5]==2022 and m[1]=='corinthians' and m[3] is not None]\nw = sum(1 for m in cor if m[3]>m[4]); drw = sum(1 for m in cor if m[3]==m[4]); l = sum(1 for m in cor if m[3]<m[4])\ngf = sum(m[3] for m in cor); ga = sum(m[4] for m in cor)\nprint(f\"Corinthians home 2022 (scored): {len(cor)} matches, {w}W {drw}D {l}L, GF {gf} GA {ga}\")\n# Palmeiras 2023 all comps match count\npal23 = set()\nfor m in matches:\n    if m[5]==2023 and 'palmeiras' in (m[1],m[2]) and m[3] is not None:\n        pal23.add((m[6], m[1], m[2], m[3], m[4]))\nprint(\"Palmeiras 2023 distinct fixtures:\", len(pal23))\nfrom collections import Counter\nprint(Counter(k[0] for k in pal23))\nEOF" action.permission=bash action.action=allow action.pattern=*
