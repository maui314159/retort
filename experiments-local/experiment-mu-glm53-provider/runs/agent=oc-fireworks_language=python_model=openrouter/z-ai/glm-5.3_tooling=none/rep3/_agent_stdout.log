ccents(n) or \"Barbosa\" in n for n in names)\n+\n def test_neymar_exact(self, sd):\n     # When I search for \"Neymar\"\n     players = q.search_players(sd, name=\"Neymar\")\n     # Then exactly one player matches: Neymar Jr, 92, LW, PSG\n","additions":5,"deletions":1},"truncated":false},"title":"tests/test_bdd_player_queries.py","time":{"start":1788258229544,"end":1788258229546}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05c7f0e9e001MH1jKVWbtiq9YP","sessionID":"ses_fa39bca00ffeV1iObla3wLMRAJ","messageID":"msg_05c7f0655001N7MUNa8RPG0Grm"}}
