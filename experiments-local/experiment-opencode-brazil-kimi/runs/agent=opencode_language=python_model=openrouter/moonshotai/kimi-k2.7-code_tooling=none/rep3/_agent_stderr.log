timestamp=2026-06-25T03:26:18.420Z level=INFO run=9c04db1c message=evaluated permission=bash pattern="python3 - <<'PY'\nimport csv, os, re\nbase = '/private/var/folders/t6/p1v727892_qc9xqqdzq2rpym0000gn/T/retort-local-tjpsd7_l/retort-8ea0ffcc10d3/data/kaggle'\n\ndef canon(n):\n    n=n.strip()\n    n=re.sub(r'\\s*-\\s*[A-Z]{2}$','',n)\n    n=re.sub(r'\\s*\\([^)]*\\)','',n).strip()\n    return re.sub(r'[^A-Za-z0-9]+','',n).lower()\n\nfor fn in ['Brasileirao_Matches.csv','Brazilian_Cup_Matches.csv','Libertadores_Matches.csv','BR-Football-Dataset.csv','novo_campeonato_brasileiro.csv']:\n    c=0\n    with open(os.path.join(base,fn),encoding='utf-8') as f:\n        for r in csv.DictReader(f):\n            home=r.get('home_team') or r.get('home') or r.get('Equipe_mandante'); away=r.get('away_team') or r.get('away') or r.get('Equipe_visitante')\n            if {canon(home),canon(away)} == {'flamengo','fluminense'}:\n                c+=1\n    print(fn, c)\nPY" action.permission=bash action.action=allow action.pattern=*
