# retort sandbox image — python cells.
#
# PINNING: build once, push to ECR, and record the pushed image DIGEST
# (sha256:...) in the experiment's SandboxRunner(image_digests={...}) — the
# digest is a tuning parameter that lands in every run's provenance. Never run
# two arms of one experiment on different digests. Rebuild = new digest = new
# provenance value.
#
# Build:  docker build -f sandbox/Dockerfile.python \
#           --build-arg OPENCODE_VERSION=1.18.20 -t retort-sandbox:python .
#
# opencode >= 1.18.20 is REQUIRED: 1.18.15 hangs at init on any per-model
# `options` key (the OpenRouter provider pin uses one). Verified 2026-08-31.
ARG OPENCODE_VERSION=1.18.20

FROM python:3.12-slim

ARG OPENCODE_VERSION

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        awscli ca-certificates curl git tar unzip \
    && rm -rf /var/lib/apt/lists/*

# Scoring toolchain (future in-container scoring; harmless size now).
RUN pip install --no-cache-dir pytest coverage

# opencode at a pinned version (npm dist ships the binary via optional deps).
RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm \
    && npm install -g "opencode-ai@${OPENCODE_VERSION}" \
    && rm -rf /var/lib/apt/lists/* \
    && opencode --version

# Non-root: agents get no reason to touch the system.
RUN useradd --create-home --shell /bin/bash retort \
    && mkdir -p /workspace && chown retort:retort /workspace
COPY sandbox/entrypoint.sh /entrypoint.sh
COPY sandbox/score_gate.py /score_gate.py
RUN chmod +x /entrypoint.sh
USER retort
ENV HOME=/home/retort

ENTRYPOINT ["/entrypoint.sh"]
