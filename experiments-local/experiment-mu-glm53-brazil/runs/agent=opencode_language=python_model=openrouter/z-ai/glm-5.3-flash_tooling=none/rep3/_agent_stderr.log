timestamp=2026-09-01T03:17:44.073Z level=INFO run=2973fea4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport sys\nsys.path.insert(0, '.')\nfrom brazilian_soccer.loader import load_all\nfrom collections import Counter\n\nreg, matches, players = load_all()\nsa2019 = [m for m in matches if m.competition == \"Brasileirão Serie A\" and m.season == 2019]\n\nfla_pairs = {}\nfor m in sa2019:\n    if 'fluminense' in (m.home_key, m.away_key):\n        other = m.away_key if m.home_key == 'fluminense' else m.home_key\n        fla_pairs.setdefault(other, []).append((m.source, m.date, m.home_raw, m.home_goal, m.away_goal, m.away_raw))\n\nn = 0\nfor other, lst in fla_pairs.items():\n    if len(lst) > 1:\n        n += 1\n        if n <= 8:\n            print(reg.display(other), \"->\", [(s, str(d), h, hg, ag, a) for s, d, h, hg, ag, a in lst])\nprint(\"opponents with BOTH sources kept:\", n, \"of\", len(fla_pairs))\nEOF" action.permission=bash action.action=allow action.pattern=*
