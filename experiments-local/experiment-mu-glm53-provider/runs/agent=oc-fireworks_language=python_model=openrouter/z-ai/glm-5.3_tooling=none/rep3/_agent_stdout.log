.name):\n+        return True\n+    # Fallback for \"full name\" queries whose exact form is absent:\n+    # match on any distinctive query word (\"Gabriel Barbosa\" -> Gabriel).\n+    words = [w for w in name_norm.split() if len(w) > 3]\n+    if not words:\n+        return False\n+    player_name = _preprocess(player.name)\n+    return any(w in player_name for w in words) and len(words) > 1\n+\n results: list[Player] = []\n for player in sd.players:\n-    if name_norm and name_norm not in _preprocess(player.name):\n+    if name_norm and not _name_ok(player):\n         continue\n     if nat_norm and nat_norm != _preprocess(player.nationality):\n         continue\n     if pos_norm and pos_norm not in _preprocess(player.position):\n","additions":12,"deletions":1},"truncated":false},"title":"brsoccer/queries.py","time":{"start":1788257731097,"end":1788257731099}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05c777256001H4OEClQDXrop8G","sessionID":"ses_fa39bca00ffeV1iObla3wLMRAJ","messageID":"msg_05c776c50001QtfIj2DFWRbM12"}}
