a-RJ'\n   'vasco-rj'                               <- 'Vasco'\n## vitoria (ba):\n   'vitoria da conquista-ba'                <- 'Vitoria da Conquista'\n   'vitoria da conquista-ba'                <- 'Vitória da Conquista - BA'\n   'vitoria-ba'                             <- 'EC Vitoria'\n   'vitoria-ba'                             <- 'Vitoria'\n   'vitoria-ba'                             <- 'Vitoria EC'\n   'vitoria-ba'                             <- 'Vitoria-BA'\n   'vitoria-ba'                             <- 'Vitória'\n   'vitoria-ba'                             <- 'Vitória - BA'\n## vitoria (es):\n   'vitoria f. c.-es'                       <- 'Vitoria F. C. - ES'\n   'vitoria-es'                             <- 'Vitoria ES'\n","exit":0,"truncated":false},"title":"source venv/bin/activate && python - <<'EOF'\nimport csv\nfrom collections import defaultdict\nfrom datetime import timedelta\nfrom brasil_mcp.normalize import TeamRegistry\nfrom brasil_mcp.store import SoccerStore\n\nstore = SoccerStore(\"data/kaggle\")\n\ndef raw_names():\n    import csv\n    specs = [\n        ('data/kaggle/Brasileirao_Matches.csv', 'home_team'), ('data/kaggle/Brasileirao_Matches.csv', 'away_team'),\n        ('data/kaggle/Brazilian_Cup_Matches.csv', 'home_team'), ('data/kaggle/Brazilian_Cup_Matches.csv', 'away_team'),\n        ('data/kaggle/Libertadores_Matches.csv', 'home_team'), ('data/kaggle/Libertadores_Matches.csv', 'away_team'),\n        ('data/kaggle/BR-Football-Dataset.csv', 'home'), ('data/kaggle/BR-Football-Dataset.csv', 'away'),\n        ('data/kaggle/novo_campeonato_brasileiro.csv', 'Equipe_mandante'), ('data/kaggle/novo_campeonato_brasileiro.csv', 'Equipe_visitante'),\n    ]\n    for path, col in specs:\n        with open(path, encoding='utf-8') as f:\n            for row in csv.DictReader(f):\n                yield row[col]\n\nreg = store.registry\n# For every raw name, resolve. Then find distinct raw names for the same FIXTURE across files.\n# Group fixtures by (competition, date, source) home/away canonicals\nfixtures = defaultdict(list)  # (comp, date) -> list of (source, home_cid, away_cid)\nfor m in store.matches:\n    if m.date and m.season:\n        fixtures[(m.competition, m.date)].append((m.source, m.home, m.away))\n\n# unmerged: same comp+date(+1), same canonical pair but different sources -> merged fine.\n# To find NAME mismatches: same comp+date, sources differ, and pairing NOT identical but\n# shares exactly one team -> suspicious. Simpler: re-parse raw names per fixture via source files.\n# Direct approach: for each canonical in store, print all raws; find raws whose base differs within same canonical family... \n# Instead: check every raw name's canonical, and find raw pairs (r1, r2) where canonical(r1) != canonical(r2)\n# but r1 is a prefix-ish/substring of r2 after removing state words.\nseen = {}\nfor raw in raw_names():\n    seen[raw] = reg.resolve(raw)\n\nby_base_token = defaultdict(set)\nfor raw, cid in seen.items():\n    by_base_token[cid].add(raw)\n\n# find canonicals sharing first token & same uf suffix but different cid\nsus = defaultdict(set)\nfor raw, cid in seen.items():\n    first = cid.split('-')[0].split()[0]\n    suffix = cid.rsplit('-', 1)[1] if '-' in cid else ''\n    sus[(first, suffix)].add((cid, raw))\nfor (first, suffix), entries in sorted(sus.items()):\n    cids = {c for c, r in entries}\n    if len(cids) > 1 and first in ('vasco','bahia','nautico','sport','america','santos','nacional','juventude','atletico','gremio','vitoria','botafogo','guarani','figueirense','inter','criciuma','parana','ceara','fortaleza','goias','coritiba','ponte','portuguesa','chapecoense','avai','cuiaba','flamengo','fluminense','palmeiras','corinthians','cruzeiro','sao'):\n        print(f\"## {first} ({suffix}):\")\n        for c, r in sorted(entries):\n            print(f\"   {c!r:40s} <- {r!r}\")\nEOF","time":{"start":1788227944476,"end":1788227944503}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.