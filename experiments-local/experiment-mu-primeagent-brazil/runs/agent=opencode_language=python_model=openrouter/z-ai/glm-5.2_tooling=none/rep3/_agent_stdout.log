{"type":"tool_use","timestamp":1788373775833,"sessionID":"ses_f9c9e1f2effeUE9mG9h5hx4Ni7","part":{"type":"tool","tool":"read","callID":"call_01a06362357379c3988a7584","state":{"status":"completed","input":{"filePath":"/workspace/soccer_mcp/normalize.py"},"output":"<path>/workspace/soccer_mcp/normalize.py</path>\n<type>file</type>\n<content>\n1: \"\"\"\n2: Context\n3: =======\n4: Brazilian Soccer MCP Server - normalization utilities.\n5: \n6: Part of the ``soccer_mcp`` package.  These helpers convert the heterogeneous\n7: raw values found in the six Kaggle CSV sources (Brasileirao_Matches.csv,\n8: Brazilian_Cup_Matches.csv, Libertadores_Matches.csv, BR-Football-Dataset.csv,\n9: novo_campeonato_brasileiro.csv and fifa_data.csv) into a single canonical form\n10: so that matches coming from different files can be joined consistently.\n11: \n12: Design notes\n13: ------------\n14: * Team names:\n15:     - Parenthetical country codes are stripped and kept as the region:\n16:       \"Nacional (URU)\" -> base \"nacional\", region \"URU\".\n17:     - Trailing state/region suffixes are stripped and kept as the region:\n18:       \"Palmeiras-SP\", \"America - MG\", \"Barcelona-EQU\" -> bases \"palmeiras\",\n19:       \"america\", \"barcelona\" with regions \"SP\", \"MG\", \"EQU\".\n20:     - Accents are folded (NFKD) so \"Sao Paulo\" and \"Sao Paulo\" match.\n21:     - An alias table maps FIFA full names (\"Atletico Mineiro\") and spelling\n22:       variants (\"Athletico\" -> \"Atletico\") to a canonical (base, region).\n23:     - Stateless names (e.g. \"Sao Paulo\" with no suffix in the BR-Football\n24:       dataset, or \"Botafogo\" in the historical file) are resolved to the most\n25:       common NON-EMPTY region observed for that base across all sources, so the\n26:       famous clubs (Flamengo-RJ) win over minor ones (Flamengo-PI).\n27:     - The canonical key is ``base + region.lower()`` (e.g. \"flamengorj\").\n28: * Dates: ISO datetime (\"2012-05-19 18:30:00\"), ISO date (\"2023-09-24\") and\n29:   Brazilian format (\"29/03/2003\") are all normalized to ISO 8601 date strings\n30:   (\"YYYY-MM-DD\").  Unparseable values become None.\n31: * Goals: stored as strings (\"3\"), floats (\"3.0\") or numeric - all normalized\n32:   to int.  Missing/invalid values become None.\n33: \n34: The module exposes a :class:`TeamNormalizer` that must first observe every team\n35: name (``observe``) and then be queried (``canonical`` / ``display``), plus the\n36: standalone helpers :func:`parse_date`, :func:`to_int_goal` and\n37: :func:`strip_accents`.\n38: \"\"\"\n39: \n40: from __future__ import annotations\n41: \n42: import re\n43: import unicodedata\n44: from collections import Counter, defaultdict\n45: from datetime import datetime\n46: from typing import Optional, Tuple\n47: \n48: __all__ = [\n49:     \"strip_accents\",\n50:     \"parse_date\",\n51:     \"to_int_goal\",\n52:     \"TeamNormalizer\",\n53: ]\n54: \n55: \n56: def strip_accents(value: str) -> str:\n57:     \"\"\"Fold accented characters to their ASCII base (NFKD, drop combining marks).\"\"\"\n58:     return \"\".join(\n59:         ch for ch in unicodedata.normalize(\"NFKD\", value) if not unicodedata.combining(ch)\n60:     )\n61: \n62: \n63: # Aliases that map a full FIFA club name (or a spelling variant) -- after the\n64: # state/region suffix has been removed -- to a canonical (base, region) tuple.\n65: # The region is only injected when no explicit region was detected on the name,\n66: # i.e. plain \"Atletico Mineiro\" -> (\"atletico\", \"MG\").\n67: ALIASES: dict[str, Tuple[str, str]] = {\n68:     \"atleticomineiro\": (\"atletico\", \"MG\"),\n69:     \"atleticoparanaense\": (\"atletico\", \"PR\"),\n70:     \"athleticoparanaense\": (\"atletico\", \"PR\"),\n71:     \"atleticogoianiense\": (\"atletico\", \"GO\"),\n72:     \"sportrecife\": (\"sport\", \"PE\"),\n73:     \"sportclubdorecife\": (\"sport\", \"PE\"),\n74:     \"cearasportingclub\": (\"ceara\", \"CE\"),\n75:     \"vascodagamarj\": (\"vascodagama\", \"RJ\"),\n76:     \"vascodagama\": (\"vascodagama\", \"RJ\"),\n77:     \"sccorinthianspaulista\": (\"corinthians\", \"SP\"),\n78:     \"sportclubcorinthianspaulista\": (\"corinthians\", \"SP\"),\n79: }\n80: \n81: # Spelling normalisation applied to the base key before alias lookup and before\n82: # region counting.  \"Athletico-PR\" (post-2019 rename) is treated as the same\n83: # base as \"Atletico-PR\".\n84: BASE_FIXES: dict[str, str] = {\"athletico\": \"atletico\"}\n85: \n86: # Curated display names with correct Portuguese accents / capitalisation for\n87: # the most prominent clubs.  Keys are canonical keys (base + region.lower()).\n88: # Anything not listed falls back to the most common raw variant observed.\n89: DISPLAY_OVERRIDES: dict[str, str] = {\n90:     \"flamengorj\": \"Flamengo\",\n91:     \"palmeirassp\": \"Palmeiras\",\n92:     \"corinthianssp\": \"Corinthians\",\n93:     \"saopaulosp\": \"Sao Paulo\",\n94:     \"santossp\": \"Santos\",\n95:     \"gremiors\": \"Gremio\",\n96:     \"internacionalrs\": \"Internacional\",\n97:     \"cruzeiromg\": \"Cruzeiro\",\n98:     \"atleticomg\": \"Atletico-MG\",\n99:     \"atleticopr\": \"Athletico-PR\",\n100:     \"fluminenserj\": \"Fluminense\",\n101:     \"botafogorj\": \"Botafogo\",\n102:     \"vascodagamarj\": \"Vasco da Gama\",\n103:     \"coritibapr\": \"Coritiba\",\n104:     \"sportpe\": \"Sport\",\n105:     \"cearace\": \"Ceara\",\n106:     \"fortalezace\": \"Fortaleza\",\n107:     \"bahiaba\": \"Bahia\",\n108:     \"vitoriaba\": \"Vitoria\",\n109:     \"goiasgo\": \"Goias\",\n110:     \"avaisc\": \"Avai\",\n111:     \"cuiabamt\": \"Cuiaba\",\n112:     \"juventuders\": \"Juventude\",\n113:     \"chapecoensesc\": \"Chapecoense\",\n114:     \"figueirense\": \"Figueirense\",\n115:     \"criciumasc\": \"Criciuma\",\n116:     \"paranapr\": \"Parana\",\n117:     \"bragantinio\": \"Bragantino\",\n118:     \"redbullbragantinosp\": \"Red Bull Bragantino\",\n119:     \"americamg\": \"America-MG\",\n120:     \"americarn\": \"America-RN\",\n121:     \"atleticogo\": \"Atletico-GO\",\n122:     \"joinvillesc\": \"Joinville\",\n123:     \"londrinapr\": \"Londrina\",\n124:     \"paysandupa\": \"Paysandu\",\n125:     \"remopa\": \"Remo\",\n126:     \"csaal\": \"CSA\",\n127:     \"crbal\": \"CRB\",\n128:     \"nauticope\": \"Nautico\",\n129:     \"saobentosp\": \"Sao Bento\",\n130:     \"santoandresp\": \"Santo Andre\",\n131:     \"portuguesasp\": \"Portuguesa\",\n132:     \"guaranisp\": \"Guarani\",\n133:     \"pontepretasp\": \"Ponte Preta\",\n134:     \"ituanosp\": \"Ituano\",\n135:     \"mirassolsp\": \"Mirassol\",\n136:     \"novorizontinosp\": \"Novorizontino\",\n137:     \"santacruzpe\": \"Santa Cruz\",\n138:     \"abc\": \"ABC\",\n139:     \"vitoria\": \"Vitoria\",\n140:     \"operariopr\": \"Operario-PR\",\n141:     \"athletico\": \"Athletico-PR\",\n142: }\n143: \n144: _PAREN_RE = re.compile(r\"\\(\\s*([A-Za-z]{2,3})\\s*\\)\\s*$\")\n145: _SUFFIX_RE = re.compile(r\"[\\s\\-]+([A-Za-z]{2,3})$\")\n146: _NON_ALNUM_RE = re.compile(r\"[^a-z0-9]\")\n147: \n148: _DATE_FORMATS = (\"%Y-%m-%d %H:%M:%S\", \"%Y-%m-%d\", \"%d/%m/%Y\", \"%d/%m/%y\")\n149: \n150: \n151: def parse_date(value: Optional[str]) -> Optional[str]:\n152:     \"\"\"Parse a date/datetime string into an ISO ``YYYY-MM-DD`` string.\n153: \n154:     Handles ISO datetime, ISO date and Brazilian ``DD/MM/YYYY`` formats.\n155:     Returns ``None`` when the value is empty or cannot be parsed.\n156:     \"\"\"\n157:     if not value:\n158:         return None\n159:     text = str(value).strip()\n160:     if not text:\n161:         return None\n162:     for fmt in _DATE_FORMATS:\n163:         try:\n164:             return datetime.strptime(text, fmt).date().isoformat()\n165:         except ValueError:\n166:             continue\n167:     return None\n168: \n169: \n170: def to_int_goal(value) -> Optional[int]:\n171:     \"\"\"Coerce a goal value (str/int/float) to int, returning None if invalid.\"\"\"\n172:     if value is None:\n173:         return None\n174:     try:\n175:         return int(float(str(value).strip()))\n176:     except (TypeError, ValueError):\n177:         return None\n178: \n179: \n180: class TeamNormalizer:\n181:     \"\"\"Stateful normaliser for team/club names.\n182: \n183:     Two phases:\n184:       1. ``observe(name)`` is called for every team name across every source,\n185:          accumulating region counts (non-empty regions only) and the raw\n186:          display variants seen for each canonical key.\n187:       2. ``canonical(name)`` / ``display(key)`` resolve names and render\n188:          pretty display names.\n189:     \"\"\"\n190: \n191:     def __init__(self) -> None:\n192:         # base -> Counter(region -> count) for NON-EMPTY regions only.\n193:         self.region_counts: dict[str, Counter] = defaultdict(Counter)\n194:         # canonical_key -> Counter(raw_display_name -> count)\n195:         self.display_names: dict[str, Counter] = defaultdict(Counter)\n196:         self._finalized = False\n197: \n198:     # ------------------------------------------------------------------ parse\n199:     @staticmethod\n200:     def parse(name: str) -> Tuple[str, str]:\n201:         \"\"\"Split a raw team name into ``(base_key, region)``.\n202: \n203:         ``region`` is the empty string when none is detected.  Aliases that\n204:         inject a region (e.g. \"Atletico Mineiro\" -> MG) are applied only when\n205:         no explicit region was found on the name.\n206:         \"\"\"\n207:         if not name:\n208:             return \"\", \"\"\n209:         text = name.strip()\n210:         region = \"\"\n211:         m = _PAREN_RE.search(text)\n212:         if m:\n213:             region = m.group(1).upper()\n214:             text = text[: m.start()].strip()\n215:         m = _SUFFIX_RE.search(text)\n216:         if m and m.group(1).isupper():\n217:             region = region or m.group(1).upper()\n218:             text = text[: m.start()].strip()\n219:         base = _NON_ALNUM_RE.sub(\"\", strip_accents(text.lower()))\n220:         base = BASE_FIXES.get(base, base)\n221:         if not region and base in ALIASES:\n222:             base, region = ALIASES[base]\n223:         return base, region\n224: \n225:     # --------------------------------------------------------------- observe\n226:     def observe(self, name: str) -> str:\n227:         \"\"\"Record a team name occurrence and return its canonical key.\n228: \n229:         Must be called for every team name before :meth:`canonical` can resolve\n230:         stateless names via prominence.\n231:         \"\"\"\n232:         base, region = self.parse(name or \"\")\n233:         if not base:\n234:             return \"\"\n235:         if region:\n236:             self.region_counts[base][region] += 1\n237:         canonical_key = base + region.lower()\n238:         self.display_names[canonical_key][name.strip()] += 1\n239:         return canonical_key\n240: \n241:     def finalize(self) -> None:\n242:         \"\"\"Lock in prominence tables so subsequent ``canonical`` calls resolve\n243:         stateless names deterministically.\"\"\"\n244:         self._finalized = True\n245: \n246:     # -------------------------------------------------------------- resolve\n247:     def canonical(self, name: str) -> str:\n248:         \"\"\"Return the canonical key for ``name``.\n249: \n250:         Stateless names resolve to the most common non-empty region observed\n251:         for that base.  Unknown bases (e.g. foreign FIFA clubs not in the match\n252:         data) are returned as ``base`` with no region.\n253:         \"\"\"\n254:         base, region = self.parse(name or \"\")\n255:         if not base:\n256:             return \"\"\n257:         if not region:\n258:             regions = self.region_counts.get(base)\n259:             if regions:\n260:                 region = regions.most_common(1)[0][0]\n261:         return base + region.lower()\n262: \n263:     def display(self, canonical_key: str) -> str:\n264:         \"\"\"Render a canonical key as a human-friendly display name.\"\"\"\n265:         if not canonical_key:\n266:             return \"\"\n267:         if canonical_key in DISPLAY_OVERRIDES:\n268:             return DISPLAY_OVERRIDES[canonical_key]\n269:         variants = self.display_names.get(canonical_key)\n270:         if variants:\n271:             # Most common raw variant; ties broken alphabetically for stability.\n272:             return variants.most_common(1)[0][0]\n273:         return canonical_key\n\n(End of file - total 273 lines)\n</content>","metadata":{"preview":"\"\"\"\nContext\n=======\nBrazilian Soccer MCP Server - normalization utilities.\n\nPart of the ``soccer_mcp`` package.  These helpers convert the heterogeneous\nraw values found in the six Kaggle CSV sources (Brasileirao_Matches.csv,\nBrazilian_Cup_Matches.csv, Libertadores_Matches.csv, BR-Football-Dataset.csv,\nnovo_campeonato_brasileiro.csv and fifa_data.csv) into a single canonical form\nso that matches coming from different files can be joined consistently.\n\nDesign notes\n------------\n* Team names:\n    - Parenthetical country codes are stripped and kept as the region:\n      \"Nacional (URU)\" -> base \"nacional\", region \"URU\".\n    - Trailing state/region suffixes are stripped and kept as the region:\n      \"Palmeiras-SP\", \"America - MG\", \"Barcelona-EQU\" -> bases \"palmeiras\",\n      \"america\", \"barcelona\" with regions \"SP\", \"MG\", \"EQU\".\n    - Accents are folded (NFKD) so \"Sao Paulo\" and \"Sao Paulo\" match.","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/soccer_mcp/normalize.py","text":"\"\"\"\nContext\n=======\nBrazilian Soccer MCP Server - normalization utilities.\n\nPart of the ``soccer_mcp`` package.  These helpers convert the heterogeneous\nraw values found in the six Kaggle CSV sources (Brasileirao_Matches.csv,\nBrazilian_Cup_Matches.csv, Libertadores_Matches.csv, BR-Football-Dataset.csv,\nnovo_campeonato_brasileiro.csv and fifa_data.csv) into a single canonical form\nso that matches coming from different files can be joined consistently.\n\nDesign notes\n------------\n* Team names:\n    - Parenthetical country codes are stripped and kept as the region:\n      \"Nacional (URU)\" -> base \"nacional\", region \"URU\".\n    - Trailing state/region suffixes are stripped and kept as the region:\n      \"Palmeiras-SP\", \"America - MG\", \"Barcelona-EQU\" -> bases \"palmeiras\",\n      \"america\", \"barcelona\" with regions \"SP\", \"MG\", \"EQU\".\n    - Accents are folded (NFKD) so \"Sao Paulo\" and \"Sao Paulo\" match.\n    - An alias table maps FIFA full names (\"Atletico Mineiro\") and spelling\n      variants (\"Athletico\" -> \"Atletico\") to a canonical (base, region).\n    - Stateless names (e.g. \"Sao Paulo\" with no suffix in the BR-Football\n      dataset, or \"Botafogo\" in the historical file) are resolved to the most\n      common NON-EMPTY region observed for that base across all sources, so the\n      famous clubs (Flamengo-RJ) win over minor ones (Flamengo-PI).\n    - The canonical key is ``base + region.lower()`` (e.g. \"flamengorj\").\n* Dates: ISO datetime (\"2012-05-19 18:30:00\"), ISO date (\"2023-09-24\") and\n  Brazilian format (\"29/03/2003\") are all normalized to ISO 8601 date strings\n  (\"YYYY-MM-DD\").  Unparseable values become None.\n* Goals: stored as strings (\"3\"), floats (\"3.0\") or numeric - all normalized\n  to int.  Missing/invalid values become None.\n\nThe module exposes a :class:`TeamNormalizer` that must first observe every team\nname (``observe``) and then be queried (``canonical`` / ``display``), plus the\nstandalone helpers :func:`parse_date`, :func:`to_int_goal` and\n:func:`strip_accents`.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nimport unicodedata\nfrom collections import Counter, defaultdict\nfrom datetime import datetime\nfrom typing import Optional, Tuple\n\n__all__ = [\n    \"strip_accents\",\n    \"parse_date\",\n    \"to_int_goal\",\n    \"TeamNormalizer\",\n]\n\n\ndef strip_accents(value: str) -> str:\n    \"\"\"Fold accented characters to their ASCII base (NFKD, drop combining marks).\"\"\"\n    return \"\".join(\n        ch for ch in unicodedata.normalize(\"NFKD\", value) if not unicodedata.combining(ch)\n    )\n\n\n# Aliases that map a full FIFA club name (or a spelling variant) -- after the\n# state/region suffix has been removed -- to a canonical (base, region) tuple.\n# The region is only injected when no explicit region was detected on the name,\n# i.e. plain \"Atletico Mineiro\" -> (\"atletico\", \"MG\").\nALIASES: dict[str, Tuple[str, str]] = {\n    \"atleticomineiro\": (\"atletico\", \"MG\"),\n    \"atleticoparanaense\": (\"atletico\", \"PR\"),\n    \"athleticoparanaense\": (\"atletico\", \"PR\"),\n    \"atleticogoianiense\": (\"atletico\", \"GO\"),\n    \"sportrecife\": (\"sport\", \"PE\"),\n    \"sportclubdorecife\": (\"sport\", \"PE\"),\n    \"cearasportingclub\": (\"ceara\", \"CE\"),\n    \"vascodagamarj\": (\"vascodagama\", \"RJ\"),\n    \"vascodagama\": (\"vascodagama\", \"RJ\"),\n    \"sccorinthianspaulista\": (\"corinthians\", \"SP\"),\n    \"sportclubcorinthianspaulista\": (\"corinthians\", \"SP\"),\n}\n\n# Spelling normalisation applied to the base key before alias lookup and before\n# region counting.  \"Athletico-PR\" (post-2019 rename) is treated as the same\n# base as \"Atletico-PR\".\nBASE_FIXES: dict[str, str] = {\"athletico\": \"atletico\"}\n\n# Curated display names with correct Portuguese accents / capitalisation for\n# the most prominent clubs.  Keys are canonical keys (base + region.lower()).\n# Anything not listed falls back to the most common raw variant observed.\nDISPLAY_OVERRIDES: dict[str, str] = {\n    \"flamengorj\": \"Flamengo\",\n    \"palmeirassp\": \"Palmeiras\",\n    \"corinthianssp\": \"Corinthians\",\n    \"saopaulosp\": \"Sao Paulo\",\n    \"santossp\": \"Santos\",\n    \"gremiors\": \"Gremio\",\n    \"internacionalrs\": \"Internacional\",\n    \"cruzeiromg\": \"Cruzeiro\",\n    \"atleticomg\": \"Atletico-MG\",\n    \"atleticopr\": \"Athletico-PR\",\n    \"fluminenserj\": \"Fluminense\",\n    \"botafogorj\": \"Botafogo\",\n    \"vascodagamarj\": \"Vasco da Gama\",\n    \"coritibapr\": \"Coritiba\",\n    \"sportpe\": \"Sport\",\n    \"cearace\": \"Ceara\",\n    \"fortalezace\": \"Fortaleza\",\n    \"bahiaba\": \"Bahia\",\n    \"vitoriaba\": \"Vitoria\",\n    \"goiasgo\": \"Goias\",\n    \"avaisc\": \"Avai\",\n    \"cuiabamt\": \"Cuiaba\",\n    \"juventuders\": \"Juventude\",\n    \"chapecoensesc\": \"Chapecoense\",\n    \"figueirense\": \"Figueirense\",\n    \"criciumasc\": \"Criciuma\",\n    \"paranapr\": \"Parana\",\n    \"bragantinio\": \"Bragantino\",\n    \"redbullbragantinosp\": \"Red Bull Bragantino\",\n    \"americamg\": \"America-MG\",\n    \"americarn\": \"America-RN\",\n    \"atleticogo\": \"Atletico-GO\",\n    \"joinvillesc\": \"Joinville\",\n    \"londrinapr\": \"Londrina\",\n    \"paysandupa\": \"Paysandu\",\n    \"remopa\": \"Remo\",\n    \"csaal\": \"CSA\",\n    \"crbal\": \"CRB\",\n    \"nauticope\": \"Nautico\",\n    \"saobentosp\": \"Sao Bento\",\n    \"santoandresp\": \"Santo Andre\",\n    \"portuguesasp\": \"Portuguesa\",\n    \"guaranisp\": \"Guarani\",\n    \"pontepretasp\": \"Ponte Preta\",\n    \"ituanosp\": \"Ituano\",\n    \"mirassolsp\": \"Mirassol\",\n    \"novorizontinosp\": \"Novorizontino\",\n    \"santacruzpe\": \"Santa Cruz\",\n    \"abc\": \"ABC\",\n    \"vitoria\": \"Vitoria\",\n    \"operariopr\": \"Operario-PR\",\n    \"athletico\": \"Athletico-PR\",\n}\n\n_PAREN_RE = re.compile(r\"\\(\\s*([A-Za-z]{2,3})\\s*\\)\\s*$\")\n_SUFFIX_RE = re.compile(r\"[\\s\\-]+([A-Za-z]{2,3})$\")\n_NON_ALNUM_RE = re.compile(r\"[^a-z0-9]\")\n\n_DATE_FORMATS = (\"%Y-%m-%d %H:%M:%S\", \"%Y-%m-%d\", \"%d/%m/%Y\", \"%d/%m/%y\")\n\n\ndef parse_date(value: Optional[str]) -> Optional[str]:\n    \"\"\"Parse a date/datetime string into an ISO ``YYYY-MM-DD`` string.\n\n    Handles ISO datetime, ISO date and Brazilian ``DD/MM/YYYY`` formats.\n    Returns ``None`` when the value is empty or cannot be parsed.\n    \"\"\"\n    if not value:\n        return None\n    text = str(value).strip()\n    if not text:\n        return None\n    for fmt in _DATE_FORMATS:\n        try:\n            return datetime.strptime(text, fmt).date().isoformat()\n        except ValueError:\n            continue\n    return None\n\n\ndef to_int_goal(value) -> Optional[int]:\n    \"\"\"Coerce a goal value (str/int/float) to int, returning None if invalid.\"\"\"\n    if value is None:\n        return None\n    try:\n        return int(float(str(value).strip()))\n    except (TypeError, ValueError):\n        return None\n\n\nclass TeamNormalizer:\n    \"\"\"Stateful normaliser for team/club names.\n\n    Two phases:\n      1. ``observe(name)`` is called for every team name across every source,\n         accumulating region counts (non-empty regions only) and the raw\n         display variants seen for each canonical key.\n      2. ``canonical(name)`` / ``display(key)`` resolve names and render\n         pretty display names.\n    \"\"\"\n\n    def __init__(self) -> None:\n        # base -> Counter(region -> count) for NON-EMPTY regions only.\n        self.region_counts: dict[str, Counter] = defaultdict(Counter)\n        # canonical_key -> Counter(raw_display_name -> count)\n        self.display_names: dict[str, Counter] = defaultdict(Counter)\n        self._finalized = False\n\n    # ------------------------------------------------------------------ parse\n    @staticmethod\n    def parse(name: str) -> Tuple[str, str]:\n        \"\"\"Split a raw team name into ``(base_key, region)``.\n\n        ``region`` is the empty string when none is detected.  Aliases that\n        inject a region (e.g. \"Atletico Mineiro\" -> MG) are applied only when\n        no explicit region was found on the name.\n        \"\"\"\n        if not name:\n            return \"\", \"\"\n        text = name.strip()\n        region = \"\"\n        m = _PAREN_RE.search(text)\n        if m:\n            region = m.group(1).upper()\n            text = text[: m.start()].strip()\n        m = _SUFFIX_RE.search(text)\n        if m and m.group(1).isupper():\n            region = region or m.group(1).upper()\n            text = text[: m.start()].strip()\n        base = _NON_ALNUM_RE.sub(\"\", strip_accents(text.lower()))\n        base = BASE_FIXES.get(base, base)\n        if not region and base in ALIASES:\n            base, region = ALIASES[base]\n        return base, region\n\n    # --------------------------------------------------------------- observe\n    def observe(self, name: str) -> str:\n        \"\"\"Record a team name occurrence and return its canonical key.\n\n        Must be called for every team name before :meth:`canonical` can resolve\n        stateless names via prominence.\n        \"\"\"\n        base, region = self.parse(name or \"\")\n        if not base:\n            return \"\"\n        if region:\n            self.region_counts[base][region] += 1\n        canonical_key = base + region.lower()\n        self.display_names[canonical_key][name.strip()] += 1\n        return canonical_key\n\n    def finalize(self) -> None:\n        \"\"\"Lock in prominence tables so subsequent ``canonical`` calls resolve\n        stateless names deterministically.\"\"\"\n        self._finalized = True\n\n    # -------------------------------------------------------------- resolve\n    def canonical(self, name: str) -> str:\n        \"\"\"Return the canonical key for ``name``.\n\n        Stateless names resolve to the most common non-empty region observed\n        for that base.  Unknown bases (e.g. foreign FIFA clubs not in the match\n        data) are returned as ``base`` with no region.\n        \"\"\"\n        base, region = self.parse(name or \"\")\n        if not base:\n            return \"\"\n        if not region:\n            regions = self.region_counts.get(base)\n            if regions:\n                region = regions.most_common(1)[0][0]\n        return base + region.lower()\n\n    def display(self, canonical_key: str) -> str:\n        \"\"\"Render a canonical key as a human-friendly display name.\"\"\"\n        if not canonical_key:\n            return \"\"\n        if canonical_key in DISPLAY_OVERRIDES:\n            return DISPLAY_OVERRIDES[canonical_key]\n        variants = self.display_names.get(canonical_key)\n        if variants:\n            # Most common raw variant; ties broken alphabetically for stability.\n            return variants.most_common(1)[0][0]\n        return canonical_key","lineStart":1,"lineEnd":273,"totalLines":273,"truncated":false}},"title":"soccer_mcp/normalize.py","time":{"start":1788373775808,"end":1788373775827}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now let me check the normalize.py and run the tests / build.","format":"unknown","index":0}]}},"id":"prt_06362357c001KDbtyhg9CWJ64m","sessionID":"ses_f9c9e1f2effeUE9mG9h5hx4Ni7","messageID":"msg_0636232c0001o5yWF0rSPVwBnN"}}
