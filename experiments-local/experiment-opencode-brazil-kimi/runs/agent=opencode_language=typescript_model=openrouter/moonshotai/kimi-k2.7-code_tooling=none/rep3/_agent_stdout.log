iras\", \"Sport Club Corinthians Paulista\".\n */\nexport function normalizeTeamName(name: string): string {\n  if (!name) return \"\";\n  let normalized = name.trim();\n\n  // Remove state suffixes like -SP, -RJ, -MG, -PR, -RS, etc.\n  normalized = normalized.replace(/-\\s*[A-Z]{2}$/, \"\");\n\n  // Remove parenthetical suffixes like (URU), (EQU), (antigo ...)\n  normalized = normalized.replace(/\\s*\\([^)]*\\)/g, \"\");\n\n  // Common full-name mappings\n  const lower = normalized.toLowerCase();\n  const mappings: Record<string, string> = {\n    \"sport club corinthians paulista\": \"Corinthians\",\n    \"sao paulo fc\": \"Sao Paulo\",\n    \"são paulo fc\": \"Sao Paulo\",","truncated":true,"loaded":[],"display":{"type":"file","path":"/private/var/folders/t6/p1v727892_qc9xqqdzq2rpym0000gn/T/retort-local-1etphcnd/retort-e45dcae40659/src/normalize.ts","text":"/**\n * Normalize a team name by stripping common suffixes, accents, and lowercasing.\n * Supports variations like \"Palmeiras-SP\", \"Palmeiras\", \"Sport Club Corinthians Paulista\".\n */\nexport function normalizeTeamName(name: string): string {\n  if (!name) return \"\";\n  let normalized = name.trim();\n\n  // Remove state suffixes like -SP, -RJ, -MG, -PR, -RS, etc.\n  normalized = normalized.replace(/-\\s*[A-Z]{2}$/, \"\");\n\n  // Remove parenthetical suffixes like (URU), (EQU), (antigo ...)\n  normalized = normalized.replace(/\\s*\\([^)]*\\)/g, \"\");\n\n  // Common full-name mappings\n  const lower = normalized.toLowerCase();\n  const mappings: Record<string, string> = {\n    \"sport club corinthians paulista\": \"Corinthians\",\n    \"sao paulo fc\": \"Sao Paulo\",\n    \"são paulo fc\": \"Sao Paulo\",\n    \"sao paulo\": \"Sao Paulo\",\n    \"são paulo\": \"Sao Paulo\",\n    \"sociedade esportiva palmeiras\": \"Palmeiras\",\n    \"clube de regatas do flamengo\": \"Flamengo\",\n    \"flamengo\": \"Flamengo\",\n    \"fluminense football club\": \"Fluminense\",\n    \"clube atlético mineiro\": \"Atletic