timestamp=2026-09-01T04:51:23.143Z level=INFO run=1a470e0e message=evaluated permission=bash pattern="./venv/bin/python << 'EOF'\nimport csv, collections\nrows = []\nwith open('data/kaggle/BR-Football-Dataset.csv', encoding='utf-8') as f:\n    for row in csv.DictReader(f):\n        if row['tournament'] == 'Serie A' and row['date'].startswith('2021'):\n            rows.append(row)\nprint(\"BRFB 2021 Serie A rows:\", len(rows))\nkeys = collections.Counter((r['home'], r['away'], r['home_goal'], r['away_goal'], r['date']) for r in rows)\ndups = {k: v for k, v in keys.items() if v > 1}\nprint(\"exact internal duplicates:\", len(dups), \"| extra rows:\", sum(v-1 for v in dups.values()))\n# fixture-level (ignore date)\nfk = collections.Counter((r['home'], r['away'], r['home_goal'], r['away_goal']) for r in rows)\nfdups = {k: v for k, v in fk.items() if v > 1}\nprint(\"fixture-level dups (ignoring date):\", len(fdups))\nfor k, v in list(fdups.items())[:5]: print(\"   \", k, v)\n# distinct dates for same fixture?\nsample = [r for r in rows if (r['home'], r['away'], r['home_goal'], r['away_goal']) in list(fdups)[:2]]\nfor r in sample[:8]: print(\"   row:\", r['home'], r['away'], r['home_goal'], r['away_goal'], r['date'])\nEOF" action.permission=bash action.action=allow action.pattern=*
