{"type":"tool_use","timestamp":1788228065602,"sessionID":"ses_fa54e4cfeffeF35792XylHPXI3","part":{"type":"tool","tool":"read","callID":"call_ea5a2a53dd5c4652b8f2a25b","state":{"status":"completed","input":{"filePath":"/Users/maui/.retort/work/retort-local-75154ofp/retort-242ce4667ad2/brazilian_soccer_mcp/data_loader.py"},"output":"<path>/Users/maui/.retort/work/retort-local-75154ofp/retort-242ce4667ad2/brazilian_soccer_mcp/data_loader.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Load and unify the six Brazilian soccer CSV datasets.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import csv\n6: import os\n7: from collections import Counter\n8: from dataclasses import dataclass, field, asdict\n9: from pathlib import Path\n10: \n11: from .normalize import (\n12:     identity_key,\n13:     parse_date,\n14:     parse_int,\n15:     parse_money,\n16:     parse_season,\n17:     normalize_team,\n18: )\n19: \n20: DEFAULT_DATA_DIR = Path(__file__).resolve().parent.parent / \"data\" / \"kaggle\"\n21: \n22: # Canonical competition labels and which raw tournament labels map onto them.\n23: COMPETITION_ALIASES = {\n24:     \"brasileirao\": \"Brasileirão\",\n25:     \"brasileirao serie a\": \"Brasileirão\",\n26:     \"serie a\": \"Brasileirão\",\n27:     \"serie b\": \"Serie B\",\n28:     \"serie c\": \"Serie C\",\n29:     \"copa do brasil\": \"Copa do Brasil\",\n30:     \"libertadores\": \"Libertadores\",\n31:     \"copa libertadores\": \"Libertadores\",\n32: }\n33: \n34: # Raw label -> canonical, applied to CSV tournament/competition columns.\n35: _TOURNAMENT_MAP = {\n36:     \"serie a\": \"Brasileirão\",\n37:     \"serie b\": \"Serie B\",\n38:     \"serie c\": \"Serie C\",\n39:     \"copa do brasil\": \"Copa do Brasil\",\n40: }\n41: \n42: \n43: @dataclass\n44: class Match:\n45:     date: str | None\n46:     season: int | None\n47:     competition: str\n48:     round: str | None\n49:     stage: str | None\n50:     home_team: str\n51:     away_team: str\n52:     home_goals: int | None\n53:     away_goals: int | None\n54:     home_state: str | None = None\n55:     away_state: str | None = None\n56:     arena: str | None = None\n57:     source: str = \"\"\n58: \n59:     @property\n60:     def home_goals_int(self) -> int:\n61:         return self.home_goals or 0\n62: \n63:     @property\n64:     def away_goals_int(self) -> int:\n65:         return self.away_goals or 0\n66: \n67:     def to_dict(self) -> dict:\n68:         return asdict(self)\n69: \n70: \n71: @dataclass\n72: class Player:\n73:     id: int\n74:     name: str\n75:     age: int | None\n76:     nationality: str\n77:     overall: int\n78:     potential: int\n79:     club: str\n80:     position: str\n81:     jersey_number: int | None\n82:     preferred_foot: str | None\n83:     height: str | None\n84:     weight: str | None\n85:     value: str | None\n86:     value_eur: float | None\n87:     wage: str | None\n88:     wage_eur: float | None\n89:     skills: dict = field(default_factory=dict)\n90: \n91:     def to_dict(self) -> dict:\n92:         return asdict(self)\n93: \n94: \n95: def resolve_data_dir(data_dir: str | Path | None = None) -> Path:\n96:     \"\"\"Find the data directory (env var > argument > repo default).\"\"\"\n97:     candidate = Path(\n98:         data_dir or os.environ.get(\"BRAZILIAN_SOCCER_DATA_DIR\", DEFAULT_DATA_DIR)\n99:     )\n100:     if not candidate.is_dir():\n101:         raise FileNotFoundError(\n102:             f\"Data directory not found: {candidate}. Set BRAZILIAN_SOCCER_DATA_DIR.\"\n103:         )\n104:     return candidate\n105: \n106: \n107: def _read_csv(path: Path) -> list[dict]:\n108:     with open(path, newline=\"\", encoding=\"utf-8\") as handle:\n109:         return list(csv.DictReader(handle))\n110: \n111: \n112: class Dataset:\n113:     \"\"\"In-memory, normalized view of all six source files.\"\"\"\n114: \n115:     def __init__(self, data_dir: str | Path | None = None) -> None:\n116:         self.data_dir = resolve_data_dir(data_dir)\n117:         self.matches: list[Match] = []\n118:         self.players: list[Player] = []\n119:         self._team_index: dict[str, list[int]] = {}\n120:         self._team_index: dict[str, list[int]] = {}\n121:         self._identity_to_display: dict[str, str] = {}\n122:         self._load_matches()\n123:         self._load_players()\n124:         self._canonicalize_teams()\n125:         self._deduplicate()\n126:         self._build_indexes()\n127: \n128:     # ------------------------------------------------------------------\n129:     # Loading\n130:     # ------------------------------------------------------------------\n131: \n132:     def _load_matches(self) -> None:\n133:         for source in self._SOURCES:\n134:             {\n135:                 \"novo_campeonato_brasileiro.csv\": self._load_historical,\n136:                 \"Brasileirao_Matches.csv\": self._load_brasileirao,\n137:                 \"Brazilian_Cup_Matches.csv\": self._load_cup,\n138:                 \"Libertadores_Matches.csv\": self._load_libertadores,\n139:                 \"BR-Football-Dataset.csv\": self._load_br_football,\n140:             }[source]()\n141:         self.matches.sort(\n142:             key=lambda m: (m.date or \"9999\", m.competition, m.round or \"\")\n143:         )\n144: \n145:     def _load_brasileirao(self) -> None:\n146:         path = self.data_dir / \"Brasileirao_Matches.csv\"\n147:         for row in _read_csv(path):\n148:             self.matches.append(\n149:                 Match(\n150:                     date=str(parse_date(row[\"datetime\"]) or \"\") or None,\n151:                     season=parse_season(row[\"season\"]),\n152:                     competition=\"Brasileirão\",\n153:                     round=row.get(\"round\") or None,\n154:                     stage=None,\n155:                     home_team=normalize_team(row[\"home_team\"]),\n156:                     away_team=normalize_team(row[\"away_team\"]),\n157:                     home_goals=parse_int(row[\"home_goal\"]),\n158:                     away_goals=parse_int(row[\"away_goal\"]),\n159:                     home_state=row.get(\"home_team_state\") or None,\n160:                     away_state=row.get(\"away_team_state\") or None,\n161:                     source=path.name,\n162:                 )\n163:             )\n164: \n165:     def _load_historical(self) -> None:\n166:         path = self.data_dir / \"novo_campeonato_brasileiro.csv\"\n167:         for row in _read_csv(path):\n168:             self.matches.append(\n169:                 Match(\n170:                     date=str(parse_date(row[\"Data\"]) or \"\") or None,\n171:                     season=parse_season(row[\"Ano\"]),\n172:                     competition=\"Brasileirão\",\n173:                     round=row.get(\"Rodada\") or None,\n174:                     stage=None,\n175:                     home_team=normalize_team(row[\"Equipe_mandante\"]),\n176:                     away_team=normalize_team(row[\"Equipe_visitante\"]),\n177:                     home_goals=parse_int(row[\"Gols_mandante\"]),\n178:                     away_goals=parse_int(row[\"Gols_visitante\"]),\n179:                     home_state=row.get(\"Mandante_UF\") or None,\n180:                     away_state=row.get(\"Visitante_UF\") or None,\n181:                     arena=row.get(\"Arena\") or None,\n182:                     source=path.name,\n183:                 )\n184:             )\n185: \n186:     def _load_cup(self) -> None:\n187:         path = self.data_dir / \"Brazilian_Cup_Matches.csv\"\n188:         for row in _read_csv(path):\n189:             self.matches.append(\n190:                 Match(\n191:                     date=str(parse_date(row[\"datetime\"]) or \"\") or None,\n192:                     season=parse_season(row[\"season\"]),\n193:                     competition=\"Copa do Brasil\",\n194:                     round=row.get(\"round\") or None,\n195:                     stage=None,\n196:                     home_team=normalize_team(row[\"home_team\"]),\n197:                     away_team=normalize_team(row[\"away_team\"]),\n198:                     home_goals=parse_int(row[\"home_goal\"]),\n199:                     away_goals=parse_int(row[\"away_goal\"]),\n200:                     source=path.name,\n201:                 )\n202:             )\n203: \n204:     def _load_libertadores(self) -> None:\n205:         path = self.data_dir / \"Libertadores_Matches.csv\"\n206:         for row in _read_csv(path):\n207:             self.matches.append(\n208:                 Match(\n209:                     date=str(parse_date(row[\"datetime\"]) or \"\") or None,\n210:                     season=parse_season(row[\"season\"]),\n211:                     competition=\"Libertadores\",\n212:                     round=None,\n213:                     stage=row.get(\"stage\") or None,\n214:                     home_team=normalize_team(row[\"home_team\"]),\n215:                     away_team=normalize_team(row[\"away_team\"]),\n216:                     home_goals=parse_int(row[\"home_goal\"]),\n217:                     away_goals=parse_int(row[\"away_goal\"]),\n218:                     source=path.name,\n219:                 )\n220:             )\n221: \n222:     def _load_br_football(self) -> None:\n223:         path = self.data_dir / \"BR-Football-Dataset.csv\"\n224:         for row in _read_csv(path):\n225:             competition = _TOURNAMENT_MAP.get(\n226:                 row[\"tournament\"].strip().lower(), row[\"tournament\"].strip()\n227:             )\n228:             self.matches.append(\n229:                 Match(\n230:                     date=str(parse_date(row[\"date\"]) or \"\") or None,\n231:                     season=parse_season((row.get(\"date\") or \"\")[:4]),\n232:                     competition=competition,\n233:                     round=None,\n234:                     stage=None,\n235:                     home_team=normalize_team(row[\"home\"]),\n236:                     away_team=normalize_team(row[\"away\"]),\n237:                     home_goals=parse_int(row[\"home_goal\"]),\n238:                     away_goals=parse_int(row[\"away_goal\"]),\n239:                     source=path.name,\n240:                 )\n241:             )\n242: \n243:     def _canonicalize_teams(self) -> None:\n244:         \"\"\"Pick one display name per team identity and rewrite all matches.\n245: \n246:         Raw spellings like \"Fortaleza\", \"Fortaleza EC\", and \"Fortaleza FC\"\n247:         share an identity; the most frequent display form wins.\n248:         \"\"\"\n249:         display_counts: Counter = Counter()\n250:         for match in self.matches:\n251:             display_counts[match.home_team] += 1\n252:             display_counts[match.away_team] += 1\n253:         identity_counts: dict[str, dict[str, int]] = {}\n254:         for display, count in display_counts.items():\n255:             identity = identity_key(display)\n256:             per_identity = identity_counts.setdefault(identity, Counter())\n257:             per_identity[display] += count\n258:         self._identity_to_display = {\n259:             identity: max(forms, key=lambda d: (forms[d], -len(d)))\n260:             for identity, forms in identity_counts.items()\n261:         }\n262:         for match in self.matches:\n263:             match.home_team = self._display_for(match.home_team)\n264:             match.away_team = self._display_for(match.away_team)\n265: \n266:     def _display_for(self, name: str) -> str:\n267:         return self._identity_to_display.get(identity_key(name), name)\n268: \n269:     def _deduplicate(self) -> None:\n270:         \"\"\"Drop matches repeated across sources (same comp/season/date/pair).\"\"\"\n271:         seen: set[tuple] = set()\n272:         kept: list[Match] = []\n273:         for match in self.matches:\n274:             if match.date:\n275:                 key = (\n276:                     match.competition,\n277:                     match.season,\n278:                     match.date,\n279:                     identity_key(match.home_team),\n280:                     identity_key(match.away_team),\n281:                 )\n282:                 if key in seen:\n283:                     continue\n284:                 seen.add(key)\n285:             kept.append(match)\n286:         self.matches = kept\n287: \n288:     def _load_players(self) -> None:\n289:         path = self.data_dir / \"fifa_data.csv\"\n290:         skill_columns = (\n291:             \"Crossing\", \"Finishing\", \"HeadingAccuracy\", \"ShortPassing\",\n292:             \"Dribbling\", \"BallControl\", \"Acceleration\", \"SprintSpeed\",\n293:             \"ShotPower\", \"LongShots\", \"Stamina\", \"Strength\", \"Vision\",\n294:             \"Penalties\", \"Marking\", \"StandingTackle\", \"SlidingTackle\",\n295:             \"GKDiving\", \"GKHandling\", \"GKKicking\", \"GKPositioning\",\n296:             \"GKReflexes\",\n297:         )\n298:         for row in _read_csv(path):\n299:             skills = {}\n300:             for col in skill_columns:\n301:                 value = parse_int(row.get(col))\n302:                 if value is not None:\n303:                     skills[col] = value\n304:             self.players.append(\n305:                 Player(\n306:                     id=parse_int(row.get(\"ID\")) or 0,\n307:                     name=row.get(\"Name\", \"\").strip(),\n308:                     age=parse_int(row.get(\"Age\")),\n309:                     nationality=row.get(\"Nationality\", \"\").strip(),\n310:                     overall=parse_int(row.get(\"Overall\")) or 0,\n311:                     potential=parse_int(row.get(\"Potential\")) or 0,\n312:                     club=row.get(\"Club\", \"\").strip(),\n313:                     position=row.get(\"Position\", \"\").strip(),\n314:                     jersey_number=parse_int(row.get(\"Jersey Number\")),\n315:                     preferred_foot=row.get(\"Preferred Foot\") or None,\n316:                     height=row.get(\"Height\") or None,\n317:                     weight=row.get(\"Weight\") or None,\n318:                     value=row.get(\"Value\") or None,\n319:                     value_eur=parse_money(row.get(\"Value\")),\n320:                     wage=row.get(\"Wage\") or None,\n321:                     wage_eur=parse_money(row.get(\"Wage\")),\n322:                     skills=skills,\n323:                 )\n324:             )\n325: \n326:     def _build_indexes(self) -> None:\n327:         self._team_index = {}\n328:         for idx, match in enumerate(self.matches):\n329:             for team in (match.home_team, match.away_team):\n330:                 self._team_index.setdefault(team, []).append(idx)\n331: \n332:     # ------------------------------------------------------------------\n333:     # Lookups\n334:     # ------------------------------------------------------------------\n335: \n336:     def resolve_team(self, name: str) -> str:\n337:         \"\"\"Canonical display name for a (possibly fuzzy) team name.\n338: \n339:         Handles aliases, state suffixes, accents, and generic club-type\n340:         suffixes (\"Fortaleza FC\" -> \"Fortaleza\").\n341:         \"\"\"\n342:         display = self._display_for(normalize_team(name))\n343:         return display or normalize_team(name)\n344: \n345:     def matches_for_team(self, team: str) -> list[Match]:\n346:         canonical = self.resolve_team(team)\n347:         indices = self._team_index.get(canonical, [])\n348:         return [self.matches[i] for i in indices]\n349: \n350:     def competitions(self) -> dict[str, dict]:\n351:         \"\"\"Competition label -> match count and season range.\"\"\"\n352:         stats: dict[str, dict] = {}\n353:         for match in self.matches:\n354:             entry = stats.setdefault(\n355:                 match.competition,\n356:                 {\"matches\": 0, \"seasons\": set()},\n357:             )\n358:             entry[\"matches\"] += 1\n359:             if match.season:\n360:                 entry[\"seasons\"].add(match.season)\n361:         for entry in stats.values():\n362:             entry[\"seasons\"] = sorted(entry[\"seasons\"])\n363:         return stats\n364: \n365:     def teams(self) -> dict[str, int]:\n366:         \"\"\"Canonical team name -> match count.\"\"\"\n367:         return {\n368:             team: len(indices)\n369:             for team, indices in sorted(\n370:                 self._team_index.items(), key=lambda kv: -len(kv[1])\n371:             )\n372:         }\n\n(End of file - total 372 lines)\n</content>","metadata":{"preview":"\"\"\"Load and unify the six Brazilian soccer CSV datasets.\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport os\nfrom collections import Counter\nfrom dataclasses import dataclass, field, asdict\nfrom pathlib import Path\n\nfrom .normalize import (\n    identity_key,\n    parse_date,\n    parse_int,\n    parse_money,\n    parse_season,\n    normalize_team,\n)\n\nDEFAULT_DATA_DIR = Path(__file__).resolve().parent.parent / \"data\" / \"kaggle\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/maui/.retort/work/retort-local-75154ofp/retort-242ce4667ad2/brazilian_soccer_mcp/data_loader.py","text":"\"\"\"Load and unify the six Brazilian soccer CSV datasets.\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport os\nfrom collections import Counter\nfrom dataclasses import dataclass, field, asdict\nfrom pathlib import Path\n\nfrom .normalize import (\n    identity_key,\n    parse_date,\n    parse_int,\n    parse_money,\n    parse_season,\n    normalize_team,\n)\n\nDEFAULT_DATA_DIR = Path(__file__).resolve().parent.parent / \"data\" / \"kaggle\"\n\n# Canonical competition labels and which raw tournament labels map onto them.\nCOMPETITION_ALIASES = {\n    \"brasileirao\": \"Brasileirão\",\n    \"brasileirao serie a\": \"Brasileirão\",\n    \"serie a\": \"Brasileirão\",\n    \"serie b\": \"Serie B\",\n    \"serie c\": \"Serie C\",\n    \"copa do brasil\": \"Copa do Brasil\",\n    \"libertadores\": \"Libertadores\",\n    \"copa libertadores\": \"Libertadores\",\n}\n\n# Raw label -> canonical, applied to CSV tournament/competition columns.\n_TOURNAMENT_MAP = {\n    \"serie a\": \"Brasileirão\",\n    \"serie b\": \"Serie B\",\n    \"serie c\": \"Serie C\",\n    \"copa do brasil\": \"Copa do Brasil\",\n}\n\n\n@dataclass\nclass Match:\n    date: str | None\n    season: int | None\n    competition: str\n    round: str | None\n    stage: str | None\n    home_team: str\n    away_team: str\n    home_goals: int | None\n    away_goals: int | None\n    home_state: str | None = None\n    away_state: str | None = None\n    arena: str | None = None\n    source: str = \"\"\n\n    @property\n    def home_goals_int(self) -> int:\n        return self.home_goals or 0\n\n    @property\n    def away_goals_int(self) -> int:\n        return self.away_goals or 0\n\n    def to_dict(self) -> dict:\n        return asdict(self)\n\n\n@dataclass\nclass Player:\n    id: int\n    name: str\n    age: int | None\n    nationality: str\n    overall: int\n    potential: int\n    club: str\n    position: str\n    jersey_number: int | None\n    preferred_foot: str | None\n    height: str | None\n    weight: str | None\n    value: str | None\n    value_eur: float | None\n    wage: str | None\n    wage_eur: float | None\n    skills: dict = field(default_factory=dict)\n\n    def to_dict(self) -> dict:\n        return asdict(self)\n\n\ndef resolve_data_dir(data_dir: str | Path | None = None) -> Path:\n    \"\"\"Find the data directory (env var > argument > repo default).\"\"\"\n    candidate = Path(\n        data_dir or os.environ.get(\"BRAZILIAN_SOCCER_DATA_DIR\", DEFAULT_DATA_DIR)\n    )\n    if not candidate.is_dir():\n        raise FileNotFoundError(\n            f\"Data directory not found: {candidate}. Set BRAZILIAN_SOCCER_DATA_DIR.\"\n        )\n    return candidate\n\n\ndef _read_csv(path: Path) -> list[dict]:\n    with open(path, newline=\"\", encoding=\"utf-8\") as handle:\n        return list(csv.DictReader(handle))\n\n\nclass Dataset:\n    \"\"\"In-memory, normalized view of all six source files.\"\"\"\n\n    def __init__(self, data_dir: str | Path | None = None) -> None:\n        self.data_dir = resolve_data_dir(data_dir)\n        self.matches: list[Match] = []\n        self.players: list[Player] = []\n        self._team_index: dict[str, list[int]] = {}\n        self._team_index: dict[str, list[int]] = {}\n        self._identity_to_display: dict[str, str] = {}\n        self._load_matches()\n        self._load_players()\n        self._canonicalize_teams()\n        self._deduplicate()\n        self._build_indexes()\n\n    # ------------------------------------------------------------------\n    # Loading\n    # ------------------------------------------------------------------\n\n    def _load_matches(self) -> None:\n        for source in self._SOURCES:\n            {\n                \"novo_campeonato_brasileiro.csv\": self._load_historical,\n                \"Brasileirao_Matches.csv\": self._load_brasileirao,\n                \"Brazilian_Cup_Matches.csv\": self._load_cup,\n                \"Libertadores_Matches.csv\": self._load_libertadores,\n                \"BR-Football-Dataset.csv\": self._load_br_football,\n            }[source]()\n        self.matches.sort(\n            key=lambda m: (m.date or \"9999\", m.competition, m.round or \"\")\n        )\n\n    def _load_brasileirao(self) -> None:\n        path = self.data_dir / \"Brasileirao_Matches.csv\"\n        for row in _read_csv(path):\n            self.matches.append(\n                Match(\n                    date=str(parse_date(row[\"datetime\"]) or \"\") or None,\n                    season=parse_season(row[\"season\"]),\n                    competition=\"Brasileirão\",\n                    round=row.get(\"round\") or None,\n                    stage=None,\n                    home_team=normalize_team(row[\"home_team\"]),\n                    away_team=normalize_team(row[\"away_team\"]),\n                    home_goals=parse_int(row[\"home_goal\"]),\n                    away_goals=parse_int(row[\"away_goal\"]),\n                    home_state=row.get(\"home_team_state\") or None,\n                    away_state=row.get(\"away_team_state\") or None,\n                    source=path.name,\n                )\n            )\n\n    def _load_historical(self) -> None:\n        path = self.data_dir / \"novo_campeonato_brasileiro.csv\"\n        for row in _read_csv(path):\n            self.matches.append(\n                Match(\n                    date=str(parse_date(row[\"Data\"]) or \"\") or None,\n                    season=parse_season(row[\"Ano\"]),\n                    competition=\"Brasileirão\",\n                    round=row.get(\"Rodada\") or None,\n                    stage=None,\n                    home_team=normalize_team(row[\"Equipe_mandante\"]),\n                    away_team=normalize_team(row[\"Equipe_visitante\"]),\n                    home_goals=parse_int(row[\"Gols_mandante\"]),\n                    away_goals=parse_int(row[\"Gols_visitante\"]),\n                    home_state=row.get(\"Mandante_UF\") or None,\n                    away_state=row.get(\"Visitante_UF\") or None,\n                    arena=row.get(\"Arena\") or None,\n                    source=path.name,\n                )\n            )\n\n    def _load_cup(self) -> None:\n        path = self.data_dir / \"Brazilian_Cup_Matches.csv\"\n        for row in _read_csv(path):\n            self.matches.append(\n                Match(\n                    date=str(parse_date(row[\"datetime\"]) or \"\") or None,\n                    season=parse_season(row[\"season\"]),\n                    competition=\"Copa do Brasil\",\n                    round=row.get(\"round\") or None,\n                    stage=None,\n                    home_team=normalize_team(row[\"home_team\"]),\n                    away_team=normalize_team(row[\"away_team\"]),\n                    home_goals=parse_int(row[\"home_goal\"]),\n                    away_goals=parse_int(row[\"away_goal\"]),\n                    source=path.name,\n                )\n            )\n\n    def _load_libertadores(self) -> None:\n        path = self.data_dir / \"Libertadores_Matches.csv\"\n        for row in _read_csv(path):\n            self.matches.append(\n                Match(\n                    date=str(parse_date(row[\"datetime\"]) or \"\") or None,\n                    season=parse_season(row[\"season\"]),\n                    competition=\"Libertadores\",\n                    round=None,\n                    stage=row.get(\"stage\") or None,\n                    home_team=normalize_team(row[\"home_team\"]),\n                    away_team=normalize_team(row[\"away_team\"]),\n                    home_goals=parse_int(row[\"home_goal\"]),\n                    away_goals=parse_int(row[\"away_goal\"]),\n                    source=path.name,\n                )\n            )\n\n    def _load_br_football(self) -> None:\n        path = self.data_dir / \"BR-Football-Dataset.csv\"\n        for row in _read_csv(path):\n            competition = _TOURNAMENT_MAP.get(\n                row[\"tournament\"].strip().lower(), row[\"tournament\"].strip()\n            )\n            self.matches.append(\n                Match(\n                    date=str(parse_date(row[\"date\"]) or \"\") or None,\n                    season=parse_season((row.get(\"date\") or \"\")[:4]),\n                    competition=competition,\n                    round=None,\n                    stage=None,\n                    home_team=normalize_team(row[\"home\"]),\n                    away_team=normalize_team(row[\"away\"]),\n                    home_goals=parse_int(row[\"home_goal\"]),\n                    away_goals=parse_int(row[\"away_goal\"]),\n                    source=path.name,\n                )\n            )\n\n    def _canonicalize_teams(self) -> None:\n        \"\"\"Pick one display name per team identity and rewrite all matches.\n\n        Raw spellings like \"Fortaleza\", \"Fortaleza EC\", and \"Fortaleza FC\"\n        share an identity; the most frequent display form wins.\n        \"\"\"\n        display_counts: Counter = Counter()\n        for match in self.matches:\n            display_counts[match.home_team] += 1\n            display_counts[match.away_team] += 1\n        identity_counts: dict[str, dict[str, int]] = {}\n        for display, count in display_counts.items():\n            identity = identity_key(display)\n            per_identity = identity_counts.setdefault(identity, Counter())\n            per_identity[display] += count\n        self._identity_to_display = {\n            identity: max(forms, key=lambda d: (forms[d], -len(d)))\n            for identity, forms in identity_counts.items()\n        }\n        for match in self.matches:\n            match.home_team = self._display_for(match.home_team)\n            match.away_team = self._display_for(match.away_team)\n\n    def _display_for(self, name: str) -> str:\n        return self._identity_to_display.get(identity_key(name), name)\n\n    def _deduplicate(self) -> None:\n        \"\"\"Drop matches repeated across sources (same comp/season/date/pair).\"\"\"\n        seen: set[tuple] = set()\n        kept: list[Match] = []\n        for match in self.matches:\n            if match.date:\n                key = (\n                    match.competition,\n                    match.season,\n                    match.date,\n                    identity_key(match.home_team),\n                    identity_key(match.away_team),\n                )\n                if key in seen:\n                    continue\n                seen.add(key)\n            kept.append(match)\n        self.matches = kept\n\n    def _load_players(self) -> None:\n        path = self.data_dir / \"fifa_data.csv\"\n        skill_columns = (\n            \"Crossing\", \"Finishing\", \"HeadingAccuracy\", \"ShortPassing\",\n            \"Dribbling\", \"BallControl\", \"Acceleration\", \"SprintSpeed\",\n            \"ShotPower\", \"LongShots\", \"Stamina\", \"Strength\", \"Vision\",\n            \"Penalties\", \"Marking\", \"StandingTackle\", \"SlidingTackle\",\n            \"GKDiving\", \"GKHandling\", \"GKKicking\", \"GKPositioning\",\n            \"GKReflexes\",\n        )\n        for row in _read_csv(path):\n            skills = {}\n            for col in skill_columns:\n                value = parse_int(row.get(col))\n                if value is not None:\n                    skills[col] = value\n            self.players.append(\n                Player(\n                    id=parse_int(row.get(\"ID\")) or 0,\n                    name=row.get(\"Name\", \"\").strip(),\n                    age=parse_int(row.get(\"Age\")),\n                    nationality=row.get(\"Nationality\", \"\").strip(),\n                    overall=parse_int(row.get(\"Overall\")) or 0,\n                    potential=parse_int(row.get(\"Potential\")) or 0,\n                    club=row.get(\"Club\", \"\").strip(),\n                    position=row.get(\"Position\", \"\").strip(),\n                    jersey_number=parse_int(row.get(\"Jersey Number\")),\n                    preferred_foot=row.get(\"Preferred Foot\") or None,\n                    height=row.get(\"Height\") or None,\n                    weight=row.get(\"Weight\") or None,\n                    value=row.get(\"Value\") or None,\n                    value_eur=parse_money(row.get(\"Value\")),\n                    wage=row.get(\"Wage\") or None,\n                    wage_eur=parse_money(row.get(\"Wage\")),\n                    skills=skills,\n                )\n            )\n\n    def _build_indexes(self) -> None:\n        self._team_index = {}\n        for idx, match in enumerate(self.matches):\n            for team in (match.home_team, match.away_team):\n                self._team_index.setdefault(team, []).append(idx)\n\n    # ------------------------------------------------------------------\n    # Lookups\n    # ------------------------------------------------------------------\n\n    def resolve_team(self, name: str) -> str:\n        \"\"\"Canonical display name for a (possibly fuzzy) team name.\n\n        Handles aliases, state suffixes, accents, and generic club-type\n        suffixes (\"Fortaleza FC\" -> \"Fortaleza\").\n        \"\"\"\n        display = self._display_for(normalize_team(name))\n        return display or normalize_team(name)\n\n    def matches_for_team(self, team: str) -> list[Match]:\n        canonical = self.resolve_team(team)\n        indices = self._team_index.get(canonical, [])\n        return [self.matches[i] for i in indices]\n\n    def competitions(self) -> dict[str, dict]:\n        \"\"\"Competition label -> match count and season range.\"\"\"\n        stats: dict[str, dict] = {}\n        for match in self.matches:\n            entry = stats.setdefault(\n                match.competition,\n                {\"matches\": 0, \"seasons\": set()},\n            )\n            entry[\"matches\"] += 1\n            if match.season:\n                entry[\"seasons\"].add(match.season)\n        for entry in stats.values():\n            entry[\"seasons\"] = sorted(entry[\"seasons\"])\n        return stats\n\n    def teams(self) -> dict[str, int]:\n        \"\"\"Canonical team name -> match count.\"\"\"\n        return {\n            team: len(indices)\n            for team, indices in sorted(\n                self._team_index.items(), key=lambda kv: -len(kv[1])\n            )\n        }","lineStart":1,"lineEnd":372,"totalLines":372,"truncated":false}},"title":"brazilian_soccer_mcp/data_loader.py","time":{"start":1788228065597,"end":1788228065600}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05ab2d93b001a0RTfUVK0S2da0","sessionID":"ses