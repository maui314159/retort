EOF"},"output":"botafogo|RJ 10 {'Botafogo RJ': 10}\ncoritiba| 11 {'Coritiba': 11}\ngoias| 11 {'Goias': 11}\nvasco da gama|RJ 12 {'Vasco Da Gama RJ': 12}\ncuiaba|MT 38 {'Cuiaba-MT': 38}\njuventude|RS 38 {'Juventude-RS': 38}\nbahia|BA 38 {'Bahia-BA': 38}\nsantos|SP 38 {'Santos-SP': 38}\nsao paulo|SP 38 {'Sao Paulo-SP': 38}\nfluminense|RJ 38 {'Fluminense-RJ': 38}\natletico|MG 38 {'Atletico-MG': 38}\nfortaleza|CE 38 {'Fortaleza-CE': 38}\nflamengo|RJ 38 {'Flamengo-RJ': 38}\npalmeiras|SP 38 {'Palmeiras-SP': 38}\nceara|CE 38 {'Ceara-CE': 38}\ngremio|RS 38 {'Gremio-RS': 38}\nchapecoense|SC 38 {'Chapecoense-SC': 38}\nred bull bragantino|SP 38 {'Red Bull Bragantino-SP': 38}\ncorinthians|SP 38 {'Corinthians-SP': 38}\natletico|GO 38 {'Atletico-GO': 38}\natletico|PR 38 {'Atletico-PR': 38}\ninternacional|RS 38 {'Internacional-RS': 38}\nsport|PE 38 {'Sport-PE': 38}\njuventude| 38 {'EC Juventude': 38}\nchapecoense| 38 {'Chapecoense': 38}\ncuiaba| 38 {'Cuiaba': 38}\nsao paulo| 49 {'Sao Paulo': 49}\natletico goianiense| 49 {'Atletico Goianiense': 49}\nbragantino| 49 {'Bragantino': 49}\ninternacional| 49 {'Internacional': 49}\ncorinthians| 49 {'Corinthians': 49}\nfluminense| 49 {'Fluminense': 49}\nfortaleza| 49 {'Fortaleza FC': 49}\nbahia| 49 {'EC Bahia': 49}\natletico mineiro| 49 {'Atletico Mineiro': 49}\npalmeiras| 49 {'Palmeiras': 49}\nceara| 49 {'Ceara': 49}\nsantos| 49 {'Santos': 49}\nsport recife| 49 {'Sport Recife': 49}\nathletico paranaense| 49 {'Athletico Paranaense': 49}\nflamengo| 50 {'Flamengo': 50}\ngremio| 50 {'Gremio': 50}\namerica|MG 76 {'America-MG': 38, 'America MG': 38}\n","metadata":{"output":"botafogo|RJ 10 {'Botafogo RJ': 10}\ncoritiba| 11 {'Coritiba': 11}\ngoias| 11 {'Goias': 11}\nvasco da gama|RJ 12 {'Vasco Da Gama RJ': 12}\ncuiaba|MT 38 {'Cuiaba-MT': 38}\njuventude|RS 38 {'Juventude-RS': 38}\nbahia|BA 38 {'Bahia-BA': 38}\nsantos|SP 38 {'Santos-SP': 38}\nsao paulo|SP 38 {'Sao Paulo-SP': 38}\nfluminense|RJ 38 {'Fluminense-RJ': 38}\natletico|MG 38 {'Atletico-MG':