76:                 seasons.add(match.season)\n677:             teams.add(match.home)\n678:             teams.add(match.away)\n679:         nationalities = len({p.nationality for p in self.players})\n680:         brazilian_clubs = sorted({p.club_key for p in self.players})\n681:         return {\n682:             \"datasets\": {\n683:                 \"Brasileirao_Matches.csv\": \"Brasileirão Série A matches (2012-2023)\",\n684:                 \"Brazilian_Cup_Matches.csv\": \"Copa do Brasil matches (2012-2023)\",\n685:                 \"Libertadores_Matches.csv\": \"Copa Libertadores matches with Brazilian clubs (2010-2023)\",\n686:                 \"BR-Football-Dataset.csv\": \"Série A/B/C + Copa do Brasil extended stats\",\n687:                 \"novo_campeonato_brasileiro.csv\": \"Brasileirão Série A 2003-2019\",\n688:                 \"fifa_data.csv\": \"FIFA 19 player database (2018 season)\",\n689:             },\n690:             \"matches_loaded\": len(self.matches),\n691:             \"matches_by_competition\": dict(sorted(by_competition.items(), key=lambda kv: -kv[1])),\n692:             \"seasons_covered\": [min(seasons), max(seasons)] if seasons else [],\n693:             \"unique_teams\": len(teams),\n694:             \"players_loaded\": len(self.players),\n695:             \"player_nationalities\": nationalities,\n696:             \"player_clubs\": len(brazilian_clubs),\n697:         }\n698: \n699:     # ------------------------------------------------------------------\n700:     # Internals\n701:     # ------------------------------------------------------------------\n702: \n703:     def _index_cup_rounds(self) -> None:\n704:         \"\"\"Detect, per season, which Copa do Brasil round number is the final.\n705: \n706:         The dataset uses numeric round indices whose total count varies by\n707:         season, and some seasons are missing the final rounds entirely. The\n708:         final is the highest round with at most two matches (one two-legged\n709:         tie); higher-volume last rounds mean the dataset simply ends earlier\n710:         and no final can be identified.\n711:         \"\"\"\n712:         rounds: dict[int, int] = defaultdict(int)\n713:         counts: dict[tuple[int, str], int] = defaultdict(int)\n714:         for match in self.matches:\n715:             if match.competition == \"Copa do Brasil\" and match.round:\n716:                 try:\n717:                     round_num = int(match.round)\n718:                 except ValueError:\n719:                     continue\n720:                 season = match.season\n721:                 if season is None:\n722:                     continue\n723:                 rounds[season] = max(rounds.get(season, 0), round_num)\n724:                 counts[(season, match.round.strip())] += 1\n725:         self._max_cup_round = {}\n726:         for season, top in rounds.items():\n727:             if counts.get((season, str(top)), 0) <= 2:\n728:                 self._max_cup_round[season] = str(top)\n\n(End of file - total 728 lines)\n</content>","metadata":{"preview":"        }\n\n    def list_teams(self, competition: str | None = None) -> dict:\n        labels = self.resolve_competitions(competition)\n        if competition and not labels:\n            return {\"error\": f\"Competition '{competition}' not recognized.\",\n                    \"known\": sorted(_COMPETITION_GROUPS)}\n        teams = defaultdict(lambda: {\"matches\": 0, \"competitions\": set()})\n        for match in self.matches:\n            if labels and match.competition not in labels:\n                continue\n            for side in (match.home, match.away):\n                teams[side][\"matches\"] += 1\n                teams[side][\"competitions\"].add(match.competition)\n        entries = [\n            {\n                \"team\": self.team_display.get(team, team),\n                \"matches\": info[\"matches\"],\n                \"competitions\": sorted(info[\"competitions\"]),\n            }","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/maui/.retort/work/retort-local-bgij0ztn/retort-88bc3733b0e3/bsoccer/queries.py","text":"        }\n\n    def list_teams(self, competition: str | None = None) -> dict:\n        labels = self.resolve_competitions(competition)\n        if competition and not labels:\n            return {\"error\": f\"Competition '{competition}' not recognized.\",\n                    \"known\": sorted(_COMPETITION_GROUPS)}\n        teams = defaultdict(lambda: {\"matches\": 0, \"competitions\": set()})\n        for match in self.matches:\n            if labels and match.competition not in labels:\n                continue\n            for side in (match.home, match.away):\n                teams[side][\"matches\"] += 1\n                teams[side][\"competitions\"].add(match.competition)\n        entries = [\n            {\n                \"team\": self.team_display.get(team, team),\n                \"matches\": info[\"matches\"],\n                \"competitions\": sorted(info[\"competitions\"]),\n            }\n            for team, info in teams.items()\n        ]\n        entries.sort(key=lambda e: -e[\"matches\"])\n        return {\"count\": len(entries), \"teams\": entries}\n\n    def summary(self) -> dict:\n        by_competition: dict[str, int] = defaultdict(int)\n        seasons: set[int] = set()\n        teams: set[str] = set()\n        for match in self.matches:\n            by_competition[match.competition] += 1\n            if match.season:\n                seasons.add(match.season)\n            teams.add(match.home)\n            teams.add(match.away)\n        nationalities = len({p.nationality for p in self.players})\n        brazilian_clubs = sorted({p.club_key for p in self.players})\n        return {\n            \"datasets\": {\n                \"Brasileirao_Matches.csv\": \"Brasileirão Série A matches (2012-2023)\",\n                \"Brazilian_Cup_Matches.csv\": \"Copa do Brasil matches (2012-2023)\",\n                \"Libertadores_Matches.csv\": \"Copa Libertadores matches with Brazilian clubs (2010-2023)\",\n                \"BR-Football-Dataset.csv\": \"Série A/B/C + Copa do Brasil extended stats\",\n                \"novo_campeonato_brasileiro.csv\": \"Brasileirão Série A 2003-2019\",\n                \"fifa_data.csv\": \"FIFA 19 player database (2018 season)\",\n            },\n            \"matches_loaded\": len(self.matches),\n            \"matches_by_competition\": dict(sorted(by_competition.items(), key=lambda kv: -kv[1])),\n            \"seasons_covered\": [min(seasons), max(seasons)] if seasons else [],\n            \"unique_teams\": len(teams),\n            \"players_loaded\": len(self.players),\n            \"player_nationalities\": nationalities,\n            \"player_clubs\": len(brazilian_clubs),\n        }\n\n    # ------------------------------------------------------------------\n    # Internals\n    # ------------------------------------------------------------------\n\n    def _index_cup_rounds(self) -> None:\n        \"\"\"Detect, per season, which Copa do Brasil round number is the final.\n\n        The dataset uses numeric round indices whose total count varies by\n        season, and some seasons are missing the final rounds entirely. The\n        final is the highest round with at most two matches (one two-legged\n        tie); higher-volume last rounds mean the dataset simply ends earlier\n        and no final can be identified.\n        \"\"\"\n        rounds: dict[int, int] = defaultdict(int)\n        counts: dict[tuple[int, str], int] = defaultdict(int)\n        for match in self.matches:\n            if match.competition == \"Copa do Brasil\" and match.round:\n                try:\n                    round_num = int(match.round)\n                except ValueError:\n                    continue\n                season = match.season\n                if season is None:\n                    continue\n                rounds[season] = max(rounds.get(season, 0), round_num)\n                counts[(season, match.round.strip())] += 1\n        self._max_cup_round = {}\n        for season, top in rounds.items():\n            if counts.get((season, str(top)), 0) <= 2:\n                self._max_cup_round[season] = str(top)","lineStart":644,"lineEnd":728,"totalLines":728,"truncated":false}},"title":"bsoccer/queries.py","time":{"start":1788205672933,"end":1788205672940}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now update list_teams and summary (lines ~656, 677, 718) to use matches_unique. Let me view those.","format":"unknown","index":0}]}},"id":"prt_0595d29d3001bjGYUlq312toCB","sessionID":"ses_fa6bfda21ffejsIdYbHxpf8aCL","messageID":"msg_0595d1ab6001UV5BH5fTDV6P0J"}}
