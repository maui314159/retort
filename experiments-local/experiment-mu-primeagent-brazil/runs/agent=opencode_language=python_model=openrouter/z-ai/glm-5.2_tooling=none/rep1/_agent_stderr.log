timestamp=2026-09-02T17:28:27.759Z level=INFO run=c4f449b2 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport csv\ndef seasons(fn, col):\n    s=set()\n    with open('data/kaggle/'+fn, encoding='utf-8') as f:\n        for row in csv.DictReader(f):\n            try: s.add(int(row[col]))\n            except: pass\n    return s\nprint(\"Brasileirao_Matches seasons:\", sorted(seasons('Brasileirao_Matches.csv','season')))\nprint(\"Brazilian_Cup seasons:\", sorted(seasons('Brazilian_Cup_Matches.csv','season')))\nprint(\"Libertadores seasons:\", sorted(seasons('Libertadores_Matches.csv','season')))\nprint(\"novo seasons:\", sorted(seasons('novo_campeonato_brasileiro.csv','Ano')))\n# BR-Football dates\nimport collections\nyrs=collections.Counter()\nwith open('data/kaggle/BR-Football-Dataset.csv', encoding='utf-8') as f:\n    for row in csv.DictReader(f):\n        y=row['date'][:4]\n        if y: yrs[y]+=1\nprint(\"BR-Football years:\", sorted(yrs.items()))\nPY" action.permission=bash action.action=allow action.pattern=*
