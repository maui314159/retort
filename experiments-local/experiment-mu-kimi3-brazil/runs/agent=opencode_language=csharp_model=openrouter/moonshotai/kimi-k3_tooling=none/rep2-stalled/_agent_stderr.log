timestamp=2026-08-02T13:26:32.448Z level=INFO run=44407034 message=evaluated permission=bash pattern="python3 -c \"\nimport csv, re, unicodedata\ndef norm(s):\n    s = re.sub(r'\\s*\\([^)]*\\)', '', s).strip()\n    s = ''.join(c for c in unicodedata.normalize('NFD', s) if unicodedata.category(c) != 'Mn')\n    return s.lower()\nrows = list(csv.DictReader(open('/Users/maui/.retort/work/retort-local-syu3u3ut/retort-02000dd611c2/data/kaggle/Brasileirao_Matches.csv', encoding='utf-8')))\nna = sum(1 for r in rows if r['home_goal'] in ('NA','') or r['away_goal'] in ('NA',''))\nprint('NA-goal rows:', na, 'of', len(rows))\nplayed = [r for r in rows if r['home_goal'] not in ('NA','') and r['away_goal'] not in ('NA','')]\nh = [r for r in played if r['season']=='2022' and norm(r['home_team']).startswith('corinthians')]\nw = sum(1 for r in h if int(r['home_goal'])>int(r['away_goal']))\nd = sum(1 for r in h if r['home_goal']==r['away_goal'])\nl = len(h)-w-d\ngf = sum(int(r['home_goal']) for r in h); ga = sum(int(r['away_goal']) for r in h)\nprint('Corinthians home 2022:', len(h), 'W', w, 'D', d, 'L', l, 'GF', gf, 'GA', ga)\nff = [r for r in played if {norm(r['home_team']), norm(r['away_team'])} == {'flamengo-rj','fluminense-rj'}]\nprint('Fla-Flu played:', len(ff))\nfrom collections import defaultdict\npts = defaultdict(lambda: [0,0,0,0,0,0])  # pts, w, d, l, gf, ga\nfor r in played:\n    if r['season']!='2019': continue\n    ht, at = r['home_team'], r['away_team']; hg, ag = int(r['home_goal']), int(r['away_goal'])\n    if hg>ag: pts[ht][0]+=3; pts[ht][1]+=1; pts[at][3]+=1\n    elif hg<ag: pts[at][0]+=3; pts[at][1]+=1; pts[ht][3]+=1\n    else: pts[ht][0]+=1; pts[at][0]+=1; pts[ht][2]+=1; pts[at][2]+=1\n    pts[ht][4]+=hg; pts[ht][5]+=ag; pts[at][4]+=ag; pts[at][5]+=hg\ntable = sorted(pts.items(), key=lambda kv:(-kv[1][0],-kv[1][1],-(kv[1][4]-kv[1][5])))\nfor t,v in table[:3]: print('2019:', t, v)\nfor t,v in table[-4:]: print('2019 bottom:', t, v)\nprint('teams:', len(table))\n\"" action.permission=bash action.action=allow action.pattern=*
