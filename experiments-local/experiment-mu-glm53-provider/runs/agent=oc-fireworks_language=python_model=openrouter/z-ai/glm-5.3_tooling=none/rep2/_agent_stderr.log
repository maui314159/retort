timestamp=2026-09-01T05:59:27.078Z level=INFO run=f180ecb5 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nfrom collections import Counter\nfrom brazilian_soccer import SoccerData\ndata = SoccerData()\n# brf-created serie A matches (source BR-Foot) per season, sample teams\nbrf_new = [m for m in data.matches if m.competition=='brasileirao' and m.source=='BR-Football-Dataset.csv']\nprint('brf-created serie A matches:', len(brf_new))\nper = Counter(m.season for m in brf_new)\nprint('by season:', dict(sorted(per.items())))\nfor m in brf_new[:10]:\n    print(' ', m.season, m.date, m.home.display, m.home_goals, '-', m.away_goals, m.away.display)\n# check a specific 2017 case: does the br-file counterpart exist?\ncands = [m for m in brf_new if m.season==2017][:6]\nfor m in cands:\n    twins = [x for x in data.matches if x.competition=='brasileirao' and x.season==2017\n             and {x.home.key,x.away.key}=={m.home.key,m.away.key} and x is not m]\n    print('pair', m.home.key, m.away.key, 'twins:', [(t.date, t.source) for t in twins])\nEOF" action.permission=bash action.action=allow action.pattern=*
