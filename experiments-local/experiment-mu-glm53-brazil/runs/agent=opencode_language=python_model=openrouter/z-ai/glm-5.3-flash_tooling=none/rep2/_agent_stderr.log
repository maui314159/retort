timestamp=2026-08-31T19:57:17.392Z level=INFO run=615f6cc2 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv\nfrom brazilian_soccer_mcp.normalize import canonical_team, key_team, TEAM_ALIASES\n\n# Collect distinct canonical names per file; flag ones that fell through the alias table\nfrom collections import defaultdict\nby_file = defaultdict(set)\nfor path, cols in [\n    ('data/kaggle/BR-Football-Dataset.csv', ('home','away')),\n    ('data/kaggle/Brazilian_Cup_Matches.csv', ('home_team','away_team')),\n    ('data/kaggle/Libertadores_Matches.csv', ('home_team','away_team')),\n    ('data/kaggle/novo_campeonato_brasileiro.csv', ('Equipe_mandante','Equipe_visitante')),\n]:\n    with open(path, encoding='utf-8-sig') as f:\n        for row in csv.DictReader(f):\n            for col in cols:\n                raw = (row.get(col) or '').strip()\n                if raw:\n                    canon = canonical_team(raw)\n                    by_file[path.split('/')[-1]].add(canon)\n\n# Names NOT produced by an alias => potential unmapped variants\nalias_values = set(TEAM_ALIASES.values())\nall_canon = set()\nfor s in by_file.values(): all_canon |= s\nunmapped = sorted(n for n in all_canon if n not in alias_values)\nprint(f\"{len(unmapped)} names not from alias table:\")\nfor n in unmapped: print(\"  \", n)\nEOF" action.permission=bash action.action=allow action.pattern=*
