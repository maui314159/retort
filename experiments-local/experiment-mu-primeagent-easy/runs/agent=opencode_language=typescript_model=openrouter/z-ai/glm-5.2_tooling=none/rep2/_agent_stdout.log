});\n43: \n44:   it(\"lists all books and supports the author filter (case-insensitive)\", async () => {\n45:     await request(app)\n46:       .post(\"/books\")\n47:       .send({ title: \"Animal Farm\", author: \"George Orwell\", year: 1945 });\n48:     await request(app)\n49:       .post(\"/books\")\n50:       .send({ title: \"Dune\", author: \"Frank Herbert\", year: 1965 });\n51: \n52:     const all = await request(app).get(\"/books\");\n53:     expect(all.status).toBe(200);\n54:     expect(all.body).toHaveLength(2);\n55: \n56:     const filtered = await request(app).get(\"/books?author=george\");\n57:     expect(filtered.status).toBe(200);\n58:     expect(filtered.body).toHaveLength(1);\n59:     expect(filtered.body[0].title).toBe(\"Animal Farm\");\n60:   });\n61: \n62:   it(\"updates an existing book with PUT\", async () => {\n63:     const created = await request(app)\n64:       .post(\"/books\")\n65:       .send({ title: \"Dune\", author: \"Frank Herbert\", year: 1965 });\n66: \n67:     const updated = await request(app)\n68:       .put(`/books/${created.body.id}`)\n69:       .send({ title: \"Dune (Revised)\", author: \"Frank Herbert\", year: 1965, isbn: \"111\" });\n70: \n71:     expect(updated.status).toBe(200);\n72:     expect(updated.body.id).toBe(created.body.id);\n73:     expect(updated.body.title).toBe(\"Dune (Revised)\");\n74:     expect(updated.body.isbn).toBe(\"111\");\n75:   });\n76: \n77:   it(\"returns 404 when updating a non-existent book\", async () => {\n78:     const res = await request(app)\n79:       .put(\"/books/99999\")\n80:       .send({ title: \"x\", author: \"y\" });\n81:     expect(res.status).toBe(404);\n82:   });\n83: \n84:   it(\"deletes a book and confirms it is gone\", async () => {\n85:     const created = await request(app)\n86:       .post(\"/books\")\n87:       .send({ title: \"T\", author: \"A\" });\n88: \n89:     const del = await request(app).delete(`/books/${created.body.id}`);\n90:     expect(del.status).toBe(204);\n91: \n92:     const after = await request(app).get(`/books/${created.body.id}`);\n93:     expect(after.status).toBe(404);\n94:   });\n95: \n96:   it(\"returns 404 when deleting a non-existent book\", async () => {\n97:     const res = await request(app).delete(\"/books/99999\");\n98:     expect(res.status).toBe(404);\n99:   });\n100: \n101:   it(\"returns 404 for an unknown book id on GET\", async () => {\n102:     const res = await request(app).get(\"/books/99999\");\n103:     expect(res.status).toBe(404);\n104:     expect(res.body.error).toMatch(/not found/i);\n105:   });\n106: \n107:   it(\"rejects malformed JSON with a 400\", async () => {\n108:     const res = await request(app)\n109:       .post(\"/books\")\n110:       .set(\"Content-Type\", \"application/json\")\n111:       .send(\"{ not valid json\");\n112:     expect(res.status).toBe(400);\n113:   });\n114: });\n\n(End of file - total 114 lines)\n</content>","metadata":{"preview":"import { describe, it, expect, beforeEach, afterEach } from \"vitest\";\nimport request from \"supertest\";\nimport type { Express } from \"express\";\nimport { createApp } from \"../src/app.js\";\nimport { BookStore } from \"../src/db.js\";\n\ndescribe(\"Books API (integration)\", () => {\n  let store: BookStore;\n  let app: Express;\n\n  beforeEach(() => {\n    store = new BookStore(\":memory:\");\n    app = createApp({ store }) as unknown as Express;\n  });\n\n  afterEach(() => {\n    store.close();\n  });\n\n  it(\"creates a book and retrieves it by id\", async () => {","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/tests/books.test.ts","text":"import { describe, it, expect, beforeEach, afterEach } from \"vitest\";\nimport request from \"supertest\";\nimport type { Express } from \"express\";\nimport { createApp } from \"../src/app.js\";\nimport { BookStore } from \"../src/db.js\";\n\ndescribe(\"Books API (integration)\", () => {\n  let store: BookStore;\n  let app: Express;\n\n  beforeEach(() => {\n    store = new BookStore(\":memory:\");\n    app = createApp({ store }) as unknown as Express;\n  });\n\n  afterEach(() => {\n    store.close();\n  });\n\n  it(\"creates a book and retrieves it by id\", async () => {\n    const createRes = await request(app)\n      .post(\"/books\")\n      .send({ title: \"1984\", author: \"George Orwell\", year: 1949, isbn: \"978-0451524935\" });\n\n    expect(createRes.status).toBe(201);\n    expect(createRes.body.id).toBeDefined();\n    expect(createRes.body.title).toBe(\"1984\");\n    expect(createRes.body.author).toBe(\"George Orwell\");\n    expect(createRes.body.year).toBe(1949);\n    expect(createRes.body.isbn).toBe(\"978-0451524935\");\n\n    const getRes = await request(app).get(`/books/${createRes.body.id}`);\n    expect(getRes.status).toBe(200);\n    expect(getRes.body).toEqual(createRes.body);\n  });\n\n  it(\"rejects creation when title/author are missing\", async () => {\n    const res = await request(app).post(\"/books\").send({ year: 2000 });\n    expect(res.status).toBe(400);\n    expect(res.body.error).toMatch(/title/i);\n    expect(res.body.error).toMatch(/author/i);\n  });\n\n  it(\"lists all books and supports the author filter (case-insensitive)\", async () => {\n    await request(app)\n      .post(\"/books\")\n      .send({ title: \"Animal Farm\", author: \"George Orwell\", year: 1945 });\n    await request(app)\n      .post(\"/books\")\n      .send({ title: \"Dune\", author: \"Frank Herbert\", year: 1965 });\n\n    const all = await request(app).get(\"/books\");\n    expect(all.status).toBe(200);\n    expect(all.body).toHaveLength(2);\n\n    const filtered = await request(app).get(\"/books?author=george\");\n    expect(filtered.status).toBe(200);\n    expect(filtered.body).toHaveLength(1);\n    expect(filtered.body[0].title).toBe(\"Animal Farm\");\n  });\n\n  it(\"updates an existing book with PUT\", async () => {\n    const created = await request(app)\n      .post(\"/books\")\n      .send({ title: \"Dune\", author: \"Frank Herbert\", year: 1965 });\n\n    const updated = await request(app)\n      .put(`/books/${created.body.id}`)\n      .send({ title: \"Dune (Revised)\", author: \"Frank Herbert\", year: 1965, isbn: \"111\" });\n\n    expect(updated.status).toBe(200);\n    expect(updated.body.id).toBe(created.body.id);\n    expect(updated.body.title).toBe(\"Dune (Revised)\");\n    expect(updated.body.isbn).toBe(\"111\");\n  });\n\n  it(\"returns 404 when updating a non-existent book\", async () => {\n    const res = await request(app)\n      .put(\"/books/99999\")\n      .send({ title: \"x\", author: \"y\" });\n    expect(res.status).toBe(404);\n  });\n\n  it(\"deletes a book and confirms it is gone\", async () => {\n    const created = await request(app)\n      .post(\"/books\")\n      .send({ title: \"T\", author: \"A\" });\n\n    const del = await request(app).delete(`/books/${created.body.id}`);\n    expect(del.status).toBe(204);\n\n    const after = await request(app).get(`/books/${created.body.id}`);\n    expect(after.status).toBe(404);\n  });\n\n  it(\"returns 404 when deleting a non-existent book\", async () => {\n    const res = await request(app).delete(\"/books/99999\");\n    expect(res.status).toBe(404);\n  });\n\n  it(\"returns 404 for an unknown book id on GET\", async () => {\n    const res = await request(app).get(\"/books/99999\");\n    expect(res.status).toBe(404);\n    expect(res.body.error).toMatch(/not found/i);\n  });\n\n  it(\"rejects malformed JSON with a 400\", async () => {\n    const res = await request(app)\n      .post(\"/books\")\n      .set(\"Content-Type\", \"application/json\")\n      .send(\"{ not valid json\");\n    expect(res.status).toBe(400);\n  });\n});","lineStart":1,"lineEnd":114,"totalLines":114,"truncated":false}},"title":"tests/books.test.ts","time":{"start":1788391297209,"end":1788391297227}},"id":"prt_0646d9077001Ehq8NUzyqNLdl5","sessionID":"ses_f9b92ae3fffeRZej9FS7ZTNZkO","messageID":"msg_0646d87ab001MFkxAqYxP6i5Ul"}}
