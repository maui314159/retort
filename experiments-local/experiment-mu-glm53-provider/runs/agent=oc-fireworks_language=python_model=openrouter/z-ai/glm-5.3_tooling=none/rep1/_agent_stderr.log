ta/kaggle/novo_campeonato_brasileiro.csv'):\n    rows.append(('novo','serie_a',pd_(r['Data']),key(r['Equipe_mandante'],r['Mandante_UF']),key(r['Equipe_visitante'],r['Visitante_UF']),g(r['Gols_mandante']),g(r['Gols_visitante']),r['Ano']))\nfor r in load('data/kaggle/BR-Football-Dataset.csv'):\n    t={'Serie A':'serie_a','Serie B':'serie_b','Serie C':'serie_c','Copa do Brasil':'copa_do_brasil'}[r['tournament']]\n    rows.append(('brf',t,pd_(r['date']),key(r['home']),key(r['away']),g(r['home_goal']),g(r['away_goal']),r['date'][:4]))\nfor r in load('data/kaggle/Brazilian_Cup_Matches.csv'):\n    rows.append(('cup','copa_do_brasil',pd_(r['datetime']),key(r['home_team']),key(r['away_team']),g(r['home_goal']),g(r['away_goal']),r['season']))\nfor r in load('data/kaggle/Libertadores_Matches.csv'):\n    rows.append(('lib','libertadores',pd_(r['datetime']),key(r['home_team']),key(r['away_team']),g(r['home_goal']),g(r['away_goal']),r['season'] if r['season']!='NA' else None))\n\ngrp=collections.defaultdict(list)\nfor src,comp,d,hk,ak,hg,ag,se in rows:\n    grp[(comp,se,hk,ak)].append((src,d,hg,ag))\ndeltas=collections.Counter(); same_date_diff_score=0\nmulti=0\nfor k,v in grp.items():\n    if len(v)>1: multi+=1\n    for i in range(len(v)):\n        for j in range(i+1,len(v)):\n            a,b=v[i],v[j]\n            if a[1] and b[1]:\n                delta=abs((a[1]-b[1]).days)\n                deltas[delta]+=1\n                if delta==0 and (a[2],a[3])!=(b[2],b[3]): same_date_diff_score+=1\nprint(\"groups:\",len(grp),\"multi-entry groups:\",multi)\nprint(\"delta distribution (top):\", deltas.most_common(15))\nprint(\"same-date different-score:\", same_date_diff_score)\n# how many groups have same score but delta>2?\nfar=0\nfor k,v in grp.items():\n    for i in range(len(v)):\n        for j in range(i+1,len(v)):\n            a,b=v[i],v[j]\n            if a[1] and b[1] and (a[2],a[3])==(b[2],b[3]) and abs((a[1]-b[1]).days)>2: far+=1\nprint(\"same-score pairs with delta>2:\", far)\nEOF" action.permission=bash action.action=allow action.pattern=*
