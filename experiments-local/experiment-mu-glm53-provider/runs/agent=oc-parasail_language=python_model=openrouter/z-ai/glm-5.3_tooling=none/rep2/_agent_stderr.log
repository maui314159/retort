timestamp=2026-09-01T05:12:08.037Z level=INFO run=7ae6fc3c message=evaluated permission=bash pattern="python - <<'EOF'\nimport csv, collections\np='data/kaggle/'\nwith open(p+'Brasileirao_Matches.csv', encoding='utf-8') as f:\n    rows=list(csv.DictReader(f))\nprint(\"Brasileirao per season:\", dict(sorted(collections.Counter(r['season'] for r in rows).items())))\n# 2019 champion check\npts=collections.defaultdict(lambda: [0]*6)\nfor r in rows:\n    if r['season']!='2019': continue\n    hg,ag=int(r['home_goal']),int(r['away_goal'])\n    for t,gf,ga in ((r['home_team'],hg,ag),(r['away_team'],ag,hg)):\n        rec=pts[t]; rec[3]+=gf; rec[4]+=ga\n        if gf>ga: rec[0]+=1; rec[5]+=3\n        elif gf==ga: rec[1]+=1; rec[5]+=1\n        else: rec[2]+=1\nfor t,(w,d,l,gf,ga,s) in sorted(pts.items(), key=lambda kv:-kv[1][5])[:4]:\n    print(f\"  {t}: {s} pts ({w}W {d}D {l}L, {gf}:{ga})\")\nprint(\"n teams 2019:\", len(pts))\n# Cup finals by season: round 8\nwith open(p+'Brazilian_Cup_Matches.csv', encoding='utf-8') as f:\n    cup=list(csv.DictReader(f))\nfin = collections.Counter(r['season'] for r in cup if r['round']=='8')\nprint(\"Cup round-8 per season:\", dict(sorted(fin.items())))\nEOF" action.permission=bash action.action=allow action.pattern=*
