timestamp=2026-09-01T04:49:19.650Z level=INFO run=1a470e0e message=evaluated permission=bash pattern="./venv/bin/python << 'EOF'\nfrom brazilian_soccer_mcp.loaders import load_all\nfrom brazilian_soccer_mcp.service import SoccerService\nfrom brazilian_soccer_mcp import formatting as fmt\n\nsvc = SoccerService(load_all('data/kaggle'))\n\nprint(\"=== Corinthians home 2022 Brasileirão only ===\")\nr = svc.team_record(\"Corinthians\", season=2022, competition=\"brasileirao\", venue=\"home\")\nprint(fmt.format_team_stats(r))\n\nprint(\"\\n=== Libertadores finals 2019 ===\")\nprint(svc.champion(\"Libertadores\", 2019))\nprint(\"\\n=== Libertadores 2018 (penalty case) ===\")\nprint(svc.champion(\"Libertadores\", 2018))\n\nprint(\"\\n=== Copa do Brasil finals 2023 (BRFB, no round info) ===\")\nf = svc.finals(\"Copa do Brasil\", 2023)\nprint(\"count:\", len(f))\nfor m in f[:5]: print(\" \", fmt.format_match_line(m))\n\nprint(\"\\n=== Copa do Brasil 2019 (round data) ===\")\nf = svc.finals(\"Copa do Brasil\", 2019)\nprint(\"count:\", len(f))\nfor m in f: print(\" \", fmt.format_match_line(m))\n\nprint(\"\\n=== biggest wins overall ===\")\nfor m in svc.biggest_wins(limit=5):\n    print(f\"  {m.date_str()}: {m.home_display} {m.score_str()} {m.away_display} ({m.competition})\")\n\nprint(\"\\n=== stats Brasileirão all-time ===\")\nprint(fmt.format_competition_stats(svc.competition_stats(\"brasileirao\")))\n\nprint(\"\\n=== best away records ===\")\nfor r in svc.best_records(venue=\"away\", min_matches=50, limit=5):\n    print(f\"  {r.display}: {r.win_rate*100:.1f}% ({r.wins}W {r.draws}D {r.losses}L of {r.matches})\")\nEOF" action.permission=bash action.action=allow action.pattern=*
