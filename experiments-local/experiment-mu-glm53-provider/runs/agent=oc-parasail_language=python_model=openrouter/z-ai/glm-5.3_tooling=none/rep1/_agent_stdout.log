e big-club names:\", dict(fc))\n\n# fifa gabriel barbosa\nrows = quick('data/kaggle/fifa_data.csv')\ngab = [r['Name'] for r in rows if 'gabriel' in r['Name'].lower()]\nprint(\"FIFA Gabriels:\", gab[:20])\nEOF","workdir":"/Users/maui/.retort/work/retort-local-x26yewvv/retort-d725b25539e0"},"output":"Libertadores bare big-club names: {'Fluminense': 20, 'Flamengo': 66, 'Internacional': 38, 'Santos': 37, 'Athletico': 29}\nBrasileirao suspicious rows: 82\n   {'datetime': '2016-12-11 17:00:00', 'home_team': 'Chapecoense-SC', 'home_team_state': 'SC', 'away_team': 'Atletico-MG', 'away_team_state': 'MG', 'home_goal': 'NA', 'away_goal': 'NA', 'season': '2016', 'round': '38'}\n   {'datetime': '2022-10-20 20:00:00', 'home_team': 'Sao Paulo-SP', 'home_team_state': 'SP', 'away_team': 'Coritiba-PR', 'away_team_state': 'PR', 'home_goal': 'NA', 'away_goal': 'NA', 'season': '2022', 'round': '29'}\n   {'datetime': '2022-10-08 19:00:00', 'home_team': 'Cuiaba-MT', 'home_team_state': 'MT', 'away_team': 'Flamengo-RJ', 'away_team_state': 'RJ', 'home_goal': 'NA', 'away_goal': 'NA', 'season': '2022', 'round': '31'}\n   {'datetime': '2022-10-08 21:00:00', 'home_team': 'Corinthians-SP', 'home_team_state': 'SP', 'away_team': 'Atletico-PR', 'away_team_state': 'PR', 'home_goal': 'NA', 'away_goal': 'NA', 'season': '2022', 'round': '31'}\n   {'datetime': '2022-10-09 11:00:00', 'home_team': 'Internacional-RS', 'home_team_state': 'RS', 'away_team': 'Goias-GO', 'away_team_state': 'GO', 'home_goal': 'NA', 'away_goal': 'NA', 'season': '2022', 'round': '31'}\nskip seasons: Counter({'2022': 81, '2016': 1})\nCup suspicious rows: 16 Counter({'2021': 16})\nBR-Football bare big-club names: {'sao paulo': 426, 'flamengo': 436, 'gremio': 423, 'corinthians': 428, 'palmeiras': 420, 'fluminense': 422, 'internacional': 407, 'santos': 433, 'bragantino': 358, 'juventude': 39}\nFIFA Gabriels: ['Gabriel Jesus', 'Gabriel Paulista', 'Gabriel', 'Gabriel Boschilia', 'Gabriel Silva', 'R. Pierre-Gabriel', 'Gabriel Xavier', 'G