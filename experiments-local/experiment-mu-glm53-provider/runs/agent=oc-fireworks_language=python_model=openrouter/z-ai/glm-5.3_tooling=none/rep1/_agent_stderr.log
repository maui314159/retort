timestamp=2026-09-01T05:22:26.187Z level=INFO run=2c158548 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, collections\ndef load(fn):\n    with open(fn, encoding='utf-8') as f: return list(csv.DictReader(f))\n\nbrf = load('data/kaggle/BR-Football-Dataset.csv')\nprint(\"BR-Football seasons per tournament:\")\nfor t in sorted(set(r['tournament'] for r in brf)):\n    ss = sorted(set(r['season'] if 'season' in r else r['date'][:4] for r in brf if r['tournament']==t))\n    print(\" \", t, \"years:\", min(r['date'][:4] for r in brf if r['tournament']==t), \"-\", max(r['date'][:4] for r in brf if r['tournament']==t), \"n=\", sum(1 for r in brf if r['tournament']==t))\nprint(\"brf empty dates:\", sum(1 for r in brf if not r['date'].strip()))\nprint(\"brf empty goals:\", sum(1 for r in brf if not r['home_goal'].strip() or not r['away_goal'].strip()))\n\nbras = load('data/kaggle/Brasileirao_Matches.csv')\nprint(\"\\nbras seasons:\", sorted(set(r['season'] for r in bras)))\nprint(\"bras rows:\", len(bras))\n\ncup = load('data/kaggle/Brazilian_Cup_Matches.csv')\nprint(\"\\ncup seasons:\", sorted(set(r['season'] for r in cup)))\nper = collections.Counter((r['season'], r['round']) for r in cup)\nfor s in ['2012','2013','2014','2022','2023']:\n    print(\" cup\", s, {k[1]:v for k,v in per.items() if k[0]==s})\n\nlib = load('data/kaggle/Libertadores_Matches.csv')\nprint(\"\\nlib seasons:\", sorted(set(r['season'] for r in lib)))\nprint(\"lib empty goals:\", sum(1 for r in lib if not (r['home_goal'] or '').strip()))\nfin = [r for r in lib if r['stage']=='final']\nprint(\"lib finals:\", [(r['season'], r['home_team'], r['home_goal'], r['away_goal'], r['away_team']) for r in fin])\n\nnovo = load('data/kaggle/novo_campeonato_brasileiro.csv')\nprint(\"\\nnovo seasons:\", min(r['Ano'] for r in novo), \"-\", max(r['Ano'] for r in novo), \"rows:\", len(novo))\nprint(\"novo OBS nonempty:\", sum(1 for r in novo if r['OBS'].strip()))\nprint(\"novo empty goals:\", sum(1 for r in novo if not (r['Gols_mandante'] or '').strip()))\nEOF" action.permission=bash action.action=allow action.pattern=*
timestamp=2026-09-01T05:22:32.143Z level=INFO run=2c158548 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, collections, unicodedata\ndef deacc(s): return ''.join(c for c in unicodedata.normalize('NFKD', s) if not unicodedata.combining(c)).lower()\nwith open('data/kaggle/fifa_data.csv', encoding='utf-8') as f:\n    rows = list(csv.DictReader(f))\nprint(\"players:\", len(rows))\nclubs = collections.Counter(r['Club'] for r in rows)\nprint(\"empty clubs:\", clubs.get('', 0))\nprint(\"columns:\", list(rows[0].keys())[:20])\n# Brazilian clubs in FIFA: match against known Brazilian club cores\ncores = {'flamengo','palmeiras','corinthians','sao paulo','santos','gremio','cruzeiro','vasco','vasco da gama','botafogo','fluminense','internacional','atletico mineiro','atletico-mg','bahia','athletico paranaense','atletico paranaense','sport recife','vitoria','ceara','fortaleza','goias','parana','coritiba','avai','ponte preta','chapecoense','criciuma','figueirense','juventude','nautico','portuguesa','guarani'}\nhits = {k:v for k,v in clubs.items() if k and deacc(k) in cores}\nprint(\"FIFA Brazilian clubs:\", hits)\npos = collections.Counter(r['Position'] for r in rows)\nprint(\"positions:\", dict(pos))\nprint(\"Overall range:\", min(int(r['Overall']) for r in rows), max(int(r['Overall']) for r in rows))\n# names for Brazilian top\nbr = sorted((r for r in rows if r['Nationality']=='Brazil'), key=lambda r: -int(r['Overall']))[:5]\nprint(\"top Brazilians:\", [(r['Name'], r['Overall'], r['Club'], r['Position']) for r in br])\nprint(\"sample name with spaces:\", [r['Name'] for r in rows if ' ' in r['Name']][:5])\nEOF" action.permission=bash action.action=allow action.pattern=*
