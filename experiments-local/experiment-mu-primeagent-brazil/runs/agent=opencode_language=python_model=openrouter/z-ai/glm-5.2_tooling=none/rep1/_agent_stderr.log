timestamp=2026-09-02T17:40:33.927Z level=INFO run=c4f449b2 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport csv, collections\nfiles={\n 'Brasileirao_Matches.csv':('home_team',None),\n 'Brazilian_Cup_Matches.csv':('home_team',None),\n 'Libertadores_Matches.csv':('home_team',None),\n 'BR-Football-Dataset.csv':('home','tournament'),\n 'novo_campeonato_brasileiro.csv':('Equipe_mandante',None),\n}\nnames=collections.defaultdict(set)\nfor fn,(col,tcol) in files.items():\n    with open('data/kaggle/'+fn, encoding='utf-8') as f:\n        for row in csv.DictReader(f):\n            v=row.get(col)\n            if v: names[v].add(fn)\n# Show all names containing key fragments for ambiguous clubs\nimport re\nkeys=['Atl','Athl','Améric','America','Vasco','Sport','Bahia','Vitória','Vitor','Botafogo','Coritiba','Santos','Palmeiras','Flamengo','Corinthians','São P','Sao P','Cruzeiro','Grêmio','Gremio','Internacional','Fortaleza','Ceará','Ceara','Chapec','Avaí','Avai','Figueir','Goiás','Goias','Ponte','Guarani','Bragant','Cuiabá','Cuiaba','Náutico','Nautico','Santa Cruz','CRB','CSA','Paraná','Parana','Juventude','Portug','Bangu']\nfor k in keys:\n    matches=sorted({n for n in names if k.lower() in n.lower()})\n    if matches:\n        print(f\"== {k} ==\")\n        for m in matches: print(f\"   {m!r}  <- {','.join(sorted(names[m]))}\")\nPY" action.permission=bash action.action=allow action.pattern=*
