unter())\n+            source_pairs[frozenset((match.home_key, match.away_key))] += 1\n     primary = {}\n     for key, source_counts in counts.items():\n-        best = max(source_counts.values())\n-        for source in SOURCE_PRIORITY:\n-            if source_counts.get(source, 0) >= best * PRIMARY_SOURCE_TOLERANCE:\n-                primary[key] = source\n-                break\n+        competition = key[0]\n+        if competition in LEAGUE_COMPETITIONS:\n+            valid = [\n+                source\n+                for source, pairs in pair_counts[key].items()\n+                if all(count <= 2 for count in pairs.values())\n+            ]\n+            pool = valid or list(source_counts)\n+            priority_rank = {s: -i for i, s in enumerate(SOURCE_PRIORITY)}\n+            primary[key] = max(\n+                pool, key=lambda s: (source_counts[s], priority_rank.get(s, -99))\n+            )\n         else:\n-            primary[key] = source_counts.most_common(1)[0][0]\n+            best = max(source_counts.values())\n+            for source in SOURCE_PRIORITY:\n+                if source_counts.get(source, 0) >= best * PRIMARY_SOURCE_TOLERANCE:\n+                    primary[key] = source\n+                    break\n+            else:\n+                primary[key] = source_counts.most_common(1)[0][0]\n     return primary\n \n \n def load_data(data_dir: str | os.PathLike) -> LoadedData:\n","filediff":{"file":"/Users/maui/.retort/work/retort-local-bgij0ztn/retort-d0fbbb4f4ea5/brazilian_soccer_mcp/loader.py","patch":"Index: /Users/maui/.retort/work/retort-local-bgij0ztn/retort-d0fbbb4f4ea5/brazilian_soccer_mcp/loader.py\n===================================================================\n--- /Users/maui/.retort/work/retort-local-bgij0ztn/retort-d0fbbb4f4ea5/brazilian_soccer_mcp/loader.py\n+++ /Users/maui/.retort/work/retort-local-bgij0ztn/retort-d0fbbb4f4ea5/brazilian_soccer_mcp/loader.py\n@@ -296,29 +296,55 @@\n         self.primary_sources = primary_sources\n         self.data_dir = data_dir\n \n \n+LEAGUE_COMPETITIONS = frozenset({BRASILEIRAO_A, BRASILEIRAO_B, BRASILEIRAO_C})\n+\n+\n def _compute_primary_sources(matches: list[Match]) -> dict[tuple[str, Optional[int]], str]:\n     \"\"\"Pick the authoritative source per (competition, season).\n \n-    The source with the most played matches wins; a higher-priority source is\n-    kept when it covers at least PRIMARY_SOURCE_TOLERANCE of that maximum.\n-    This prevents the same fixture appearing twice in standings and searches\n-    when two files overlap.\n+    Several files overlap (e.g. two files both contain the 2012-2019\n+    Brasileirão), so without a rule the same fixture would appear twice in\n+    standings and searches.  For league competitions a source is only\n+    considered structurally valid when no pair of teams meets more than\n+    twice in the season; this rejects sources where Copa do Brasil fixtures\n+    were mislabelled as league matches.  Among valid sources the one with\n+    the most played matches wins (priority breaks ties).  For cups the\n+    highest-priority source covering at least 90% of the best coverage wins.\n     \"\"\"\n     counts: dict[tuple[str, Optional[int]], Counter] = defaultdict(Counter)\n+    pair_counts: dict[tuple[str, Optional[int]], dict[str, Counter]] = defaultdict(dict)\n     for match in matches:\n-        if match.played:\n-            counts[(match.competition, match.season)][match.source] += 1\n+        if not match.played:\n+            continue\n+        key = (match.competition, match.season)\n+        counts[key][match.source] += 1\n+        if match.competition in LEAGUE_COMPETITIONS:\n+            source_pairs = pair_counts[key].setdefault(match.source, Counter())\n+            source_pairs[frozenset((match.home_key, match.away_key))] += 1\n     primary = {}\n     for key, source_counts in counts.items():\n-        best = max(source_counts.values())\n-        for source in SOURCE_PRIORITY:\n-            if source_counts.get(source, 0) >= best * PRIMARY_SOURCE_TOLERANCE:\n-                primary[key] = source\n-                break\n+        competition = key[0]\n+        if competition in LEAGUE_COMPETITIONS:\n+            valid = [\n+                source\n+                for source, pairs in pair_counts[key].items()\n+                if all(count <= 2 for count in pairs.values())\n+            ]\n+            pool = valid or list(source_counts)\n+            priority_rank = {s: -i for i, s in enumerate(SOURCE_PRIORITY)}\n+            primary[key] = max(\n+                pool, key=lambda s: (source_counts[s], priority_rank.get(s, -99))\n+            )\n         else:\n-            primary[key] = source_counts.most_common(1)[0][0]\n+            best = max(source_counts.values())\n+            for source in SOURCE_PRIORITY:\n+                if source_counts.get(source, 0) >= best * PRIMARY_SOURCE_TOLERANCE:\n+                    primary[key] = source\n+                    break\n+            else:\n+                primary[key] = source_counts.most_common(1)[0][0]\n     return primary\n \n \n def load_data(data_dir: str | os.PathLike) -> LoadedData:\n","additions":38,"deletions":12},"truncated":false},"title":"brazilian_soccer_mcp/loader.py","time":{"start":1788202973257,"end":1788202973259}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"The pair corruption is limited to:\n- Série A 2021 (BRF) — 72 pairs>2 — but BM is clean and will be primary with rule v2 ✓\n- Série B 2021 (BRF) — 22 pairs>2 (only source)\n- Série C various seasons — small counts (1-13 pairs>2) — Série C is knockout-ish anyway (partial data)\n\nSo implementing:\n1. **Rule v2 primary selection** (league structural validity) — fixes Série A 2021.\n2. **Pair trimming for league competitions** — fixes Série B 2021 standings; Série C trimming with venue-balance heuristic is fine (documented).\n\nSérie C note: real Série C format includes a group phase (teams meet twice within group) + knockout (two legs) — so pairs CAN legitimately meet 3-4 times in Série C! E.g. 2022 Série C: 13 pairs>2 might be LEGITIMATE knockout two-legged ties after group stage! Trimming would DROP REAL MATCHES.\n\nHmm! Série C: group stage (20 teams, 2 groups of 10, double round-robin within group = 90 matches/group = 180 total) + knockout (8 teams? → 2 legs each round). 213 matches in 2022 = 180 group + 33 knockout?? knockout 2022: QF+SF+F = 3 rounds × 2 legs × 2 matches?? QF: 4 ties × 2 legs = 8, SF: 2×2=4, F: 2 → 14. 180+14=194... data has 213. Ugh.\n\nPragmatic call: apply pair-trimming ONLY to Série A and Série B (strict double round-robin formats since 2006; and our data 2003-2005 A had 24/22 teams but still double round-robin). Série C (and cups) exempt — knockout formats allow repeat pairings. For Série B 2021, trimming helps; for Série A it's a no-op given clean primary sources.\n\nNow let me also reconsider: should trimming apply inside `_iter_matches` (affecting search/stats/h2h defaults) or only standings? For Série B 2021 h2h/search, trimmed view = \"league-consistent view\" ✓ I'll apply it in `_iter_matches` for LEAGUE_TRIMMED competitions {A, B} when NOT all_sources. This keeps a consistent worldview: default = clean league view; all_sources=True = raw.\n\nImplementation in `_iter_matches` — the trim needs per-(competition, season) computation; cache it:\n\n```python\nself._league_trim_cache: dict[tuple[str,int], frozenset[int]] = {}  # key -> set of match ids to EXCLUDE\n```\n\nMatch doesn't have a unique id for BRF rows... I'll use object identity via `id(match)`? Since matches are stored in a list, index-based: build per (comp, season) the list of primary-source matches, compute trimmed keep-set, store indices. Let me implement with a precomputed set of indices into self._matches:\n\n```python\ndef _league_trimmed_indices(self, competition, season) -> set[int]:  # indices to DROP\n    key = (competition, season)\n    if key in self._league_trim_cache: return cache\n    idxs = [(i, m) for i, m in enumerate(self._matches) if m.competition==competition and m.season==season and self._is_primary(m)]\n    pairs = defaultdict(list)\n    for i, m in idxs: pairs[frozenset((m.home_key, m.away_key))].append((i, m))\n    drop = set()\n    for pair, items in pairs.items():\n        if len(items) <= 2: continue\n        items.sort(key=lambda im: (im[1].date or date.min,))\n        # venue-balanced keep: earliest leg for each home side\n        a, b = tuple(pair)\n        keep = []\n        seen_home = set()\n        for i, m in items:\n            if m.home_key not in seen_home and len(keep) < 2:\n                keep.append(i); seen_home.add(m.home_key)\n        if len(keep) < 2:  # both legs same side?? keep first two\n            keep = [i for i, _ in items[:2]]\n        drop.update(i for i, _ in items) - set... \n```\n\nHmm wait, `frozenset` iteration order is nondeterministic — `tuple(pair)` gives arbitrary a,b but only used for ordering home sides — the venue-balance logic doesn't actually need a/b labels: iterate sorted matches, keep first where side X home and first where side Y home — the `seen_home` approach handles it: keep first match, record its home team; then keep the first subsequent match whose home team differs. \n\nFor Internacional-Bragantino (Jan 31 Inter home, Oct 22 Inter home, Dec 10 Bragantino home): keep Jan 31 (Inter home) + Dec 10 (Bragantino home)?? But the real league legs were Oct 22 + ... hmm the actual 2021 Série A Bragantino-Inter games: Inter 1-1 Bragantino? No wait — this pair is in \"Série B 2021\" context? No — Internacional-Bragantino was in the Série A 2021 example. Anyway with BM primary for Série A 2021, BRF's mess is excluded entirely (all_sources=False → non-primary skipped BEFORE trimming). Trimming only matters for BRF-primary league seasons: Série B 2021 + maybe Série B 2022 (22 teams? no pairs>2 — the 22nd \"team\" is contamination but pairs≤2... hmm 380 matches 22 teams pairs≤2 → some pairs meet once — partial-ish data, no trim needed) ✓.\n\nSo trimming = only Série B 2021 in practice. \n\nWait — but hold on: if BRF Série A 2021 is non-primary, then \"search Internacional 2021\" gets BM's 380-match view ✓. But the mislabeled CdB 2020/2021 matches (Internacional 2-1 Bragantino Jan 2021 = CdB 2020 semifinal) are ALSO correctly present under \"Copa do Brasil 2020/2021\" labels? BRF CdB labels: CdB 2020 (Jan-Feb 2021 dates have season=date-year=2021 in my loader!!). Hmm!! My loader sets season from date[:4] — the CdB 2020 semifinal played 2021-01-31 would be season \"2021\" under BRF's CdB label... but is it labeled CdB in BRF? The cross-label check showed 0 fixtures with multiple labels in BRF 2021 — meaning the Jan 31 Inter-Bragantino match appears ONLY as \"Serie A\" in BRF, not as CdB. So those CdB matches are ONLY in the mislabeled \"Serie A\" rows. With BRF-non-primary for Série A 2021, they vanish from all default views (accessible via all_sources=True Série A 2021 search only). Acceptable — CdB 2020/2021 coverage comes from Brazilian_Cup_Matches.csv anyway (2020: 120 matches ✓, 2021: 108 ✓).\n\nOK — implement now. Also the CdB season-from-date issue: BRF CdB 2020 rows dated Jan/Feb 2021 → season 2021? For CUPS, tie season to date-year is what the source implies... Brazilian_Cup_Matches has explicit season column ✓ primary for CdB 2012-2021 anyway. BRF CdB primary only for 2022-2023. Fine.\n\nOne more check for rule v2: BM 2020 Série A: 380 rows, played 380? 2020 season completed (Feb 2021 finish due to COVID!). BM 2020 \"round 38\" dated Feb 2021 ✓ all played. So primary A 2020 = BM ✓.\n\nNow — implement changes in loader._compute_primary_sources and queries._iter_matches.","format":"unknown","index":0}]}},"id":"prt_05933f842001ShOf5Joz6xbY4o","sessionID":"ses_fa6e4b534ffex1G5nGEhqeGwzS","messageID":"msg_059335c75001Q4PpxmgwXHPg8m"}}
