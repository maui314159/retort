timestamp=2026-06-25T02:11:26.333Z level=INFO run=ed0cdab1 message=evaluated permission=bash pattern="node -e \"\nimport { loadDataset } from './dist/loader.js';\nimport { resolve } from 'path';\nconst store = await loadDataset(resolve('data', 'kaggle'));\nconst matches = store.matches.filter(m => m.season === 2019 && (m.homeTeam === 'Atletico Mineiro' || m.awayTeam === 'Atletico Mineiro'));\nconsole.log('Total Atletico Mineiro 2019 matches:', matches.length);\nconst homeMatches = matches.filter(m => m.homeTeam === 'Atletico Mineiro');\nconst awayMatches = matches.filter(m => m.awayTeam === 'Atletico Mineiro');\nconsole.log('Home:', homeMatches.length, 'Away:', awayMatches.length);\n// Check for duplicates\nconst counts = {};\nmatches.forEach(m => { const k = m.date + '|' + m.homeTeam + '|' + m.awayTeam; counts[k] = (counts[k] || 0) + 1; });\nconst dups = Object.entries(counts).filter(([k,v]) => v > 1);\nconsole.log('Duplicate fixtures:', dups.length);\nconsole.log('Sample duplicates:', dups.slice(0, 5));\n\"" action.permission=bash action.action=allow action.pattern=*
