timestamp=2026-08-31T19:01:11.891Z level=INFO run=9abcf33e message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nfrom brazilian_soccer_mcp.queries import get_engine\nfrom collections import Counter, defaultdict\ne = get_engine(\"data/kaggle\")\n\n# 2021 Serie A BRF pairs > 2\nbrf21 = [m for m in e.matches if m.source==\"BR-Football-Dataset.csv\" and m.season==2021 and m.competition==\"Brasileirão Série A\"]\npairs = defaultdict(list)\nfor m in brf21:\n    pairs[frozenset((m.home_key, m.away_key))].append(m)\nextra = {p: ms for p, ms in pairs.items() if len(ms) > 2}\nprint(\"Serie A 2021 BRF pairs>2:\", len(extra))\nfor p, ms in list(extra.items())[:6]:\n    print(\" \", sorted(p))\n    for m in sorted(ms, key=lambda x: x.date):\n        print(\"    \", m.date, m.home_display, m.home_goals, \"-\", m.away_goals, m.away_display)\n\n# check if same fixtures exist under other competition labels in BRF 2021\nby_sig = defaultdict(list)\nfor m in e.matches:\n    if m.source==\"BR-Football-Dataset.csv\" and m.season==2021:\n        by_sig[(m.date, m.home_key, m.away_key)].append(m.competition)\ncross = {k: v for k, v in by_sig.items() if len(set(v)) > 1}\nprint(\"\\nfixtures with multiple competition labels in BRF 2021:\", len(cross))\nfor k, v in list(cross.items())[:8]:\n    print(\"   \", k, v)\n\n# how inflated are Serie B/C across seasons?\nfor comp in (\"Brasileirão Série B\", \"Brasileirão Série C\"):\n    for season in range(2014, 2024):\n        ms = [m for m in e.matches if m.competition==comp and m.season==season and m.played]\n        if not ms: continue\n        teams = {m.home_key for m in ms} | {m.away_key for m in ms}\n        expected = len(teams)*(len(teams)-1)\n        flag = \" <-- INFLATED\" if len(ms) > expected * 1.05 else \"\"\n        print(f\"{comp} {season}: {len(ms)} played, {len(teams)} teams, expected {expected}{flag}\")\nEOF" action.permission=bash action.action=allow action.pattern=*
