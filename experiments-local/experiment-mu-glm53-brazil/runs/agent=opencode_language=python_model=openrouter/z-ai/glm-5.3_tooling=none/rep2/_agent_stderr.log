timestamp=2026-08-31T19:18:36.748Z level=INFO run=ec94ecf4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport time\nt0 = time.time()\nfrom brazilian_soccer_mcp.service import SoccerDataService\nsvc = SoccerDataService(\"data/kaggle\")\nprint(f\"load: {time.time()-t0:.2f}s, matches: {len(svc.matches)}, resolved: {len(svc._resolved_matches)}, players: {len(svc.players)}\")\n\n# 1. Standings 2019\nst = svc.standings(\"Brasileirão Série A\", 2019)\nprint(\"champion:\", st[\"champion\"], \"relegated:\", st[\"relegated\"], \"matches:\", st[\"matches_considered\"])\ntop = st[\"table\"][0]\nprint(\"top row:\", top[\"display\"], top[\"points\"], top[\"wins\"], top[\"draws\"], top[\"losses\"])\n\n# 2. Head to head Fla-Flu\nh = svc.head_to_head(\"Flamengo\", \"Fluminense\")\nprint(\"Fla-Flu:\", h[\"summary\"], \"total:\", h[\"total_matches\"])\n\n# 3. resolve variations\nfor q in [\"Palmeiras\", \"palmeiras-sp\", \"Sport Club Corinthians Paulista\", \"Atletico\", \"Atletico-MG\", \"Athletico\", \"Grêmio\", \"Gremio\"]:\n    r = svc.resolve_team(q)\n    print(f\"resolve {q!r}: {r.get('key')} ({r.get('matched_by')}) alts={len(r.get('alternatives', []))}\")\n\n# 4. search matches Palmeiras 2023\ns = svc.search_matches(team=\"Palmeiras\", season=2023)\nprint(\"Palmeiras 2023:\", s[\"total\"], \"first:\", s.get(\"first_match\"))\n\n# 5. cup finals\nf = svc.search_matches(competition=\"Copa do Brasil\", stage=\"final\")\nprint(\"cup finals:\", f[\"total\"], [m[\"season\"] for m in f[\"matches\"]])\n\n# 6. players\ntp = svc.top_players(nationality=\"Brazil\")\nprint(\"top BR:\", [(p[\"name\"], p[\"overall\"]) for p in tp[\"players\"][:3]])\npl = svc.search_players(club=\"Flamengo\", nationality=\"Brazil\")\nprint(\"flamengo BR players:\", pl[\"total\"])\npbc = svc.players_by_club()\nprint(\"BR clubs with BR players:\", len(pbc[\"clubs\"]), pbc[\"clubs\"][:2])\n\n# 7. stats\nls = svc.league_statistics(competition=\"Brasileirão\")\nprint(\"brasileirao stats:\", ls.get(\"avg_goals_per_match\"), ls.get(\"home_win_rate\"), \"matches:\", ls.get(\"matches\"))\nbw = svc.biggest_wins()\nprint(\"biggest win:\", bw[\"wins\"][0][\"date\"], bw[\"wins\"][0][\"home\"], bw[\"wins\"][0][\"score\"], bw[\"wins\"][0][\"away\"])\nbr = svc.best_records(competition=\"Brasileirão Série A\", venue=\"home\")\nprint(\"best home:\", [(r[\"display\"], r[\"win_rate\"]) for r in br[\"records\"][:3]])\n\n# 8. derbies\nd = svc.derbies()\nprint(\"derbies found:\", [(x[\"derby\"], x[\"total_matches\"]) for x in d[\"derbies\"]])\n\n# 9. team stats corinthians 2022 home\nts = svc.team_stats(\"Corinthians\", season=2022, competition=\"Brasileirão Série A\", venue=\"home\")\nprint(\"corinthians home 2022:\", ts[\"overall\"])\n\n# 10. team competitions\ntc = svc.team_competitions(\"Palmeiras\")\nprint(\"palmeiras comps:\", [(c[\"competition\"], c[\"matches\"]) for c in tc[\"competitions\"]])\nEOF" action.permission=bash action.action=allow action.pattern=*
