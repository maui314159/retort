timestamp=2026-08-31T19:33:14.212Z level=INFO run=532d90f3 message=evaluated permission=bash pattern="venv/bin/python -c \"\nfrom bsoccer.queries import KnowledgeBase\nimport time\nt0=time.time()\nkb = KnowledgeBase()\nprint(f'KB built in {time.time()-t0:.2f}s')\n\n# 1. Fla-Flu\nr = kb.search_matches(team='Flamengo', opponent='Fluminense')\nprint('Fla-Flu:', r['count'], 'of', r['total_matches'], '| h2h:', r['head_to_head'])\n\n# 2. Palmeiras 2023\nr = kb.search_matches(team='Palmeiras', season=2023)\nprint('Palmeiras 2023:', r['count'], 'of', r['total_matches'])\n\n# 3. Copa do Brasil finals\nr = kb.search_matches(competition='Copa do Brasil', stage='final')\nprint('Copa finals:', r['count'], 'of', r['total_matches'])\nprint(r['matches'][:4])\n\n# 4. Corinthians 2022 home\nr = kb.team_statistics('Corinthians', season=2022)\nprint('Corinthians 2022 overall:', r['overall'], 'home:', r['home'])\n\n# 5. standings 2019\ns = kb.standings('Brasileirão', 2019)\nprint('2019 champ:', s['standings'][0], '| source:', s['source_file'])\nprint('relegated:', [(e['position'], e['team']) for e in s['standings'][-4:]])\n\n# 6. players\nr = kb.search_players(nationality='Brazil', sort_by='overall', limit=3)\nprint('top brazilians:', [p['name'] for p in r['players']])\nr = kb.search_players(club='Flamengo', limit=5)\nprint('flamengo fifa:', r['count'], [p['name'] for p in r['players']])\nr = kb.player_profile('Gabriel Barbosa')\nprint('gabigol:', r.get('player',{}).get('name'), r.get('player',{}).get('club'), r.get('player',{}).get('overall'))\n\n# 7. biggest wins\nr = kb.biggest_wins(limit=5)\nprint('biggest:', [(m['home_team'], m['home_goal'], m['away_goal'], m['away_team']) for m in r['wins'][:3]])\n\n# 8. cross-file\nr = kb.team_overview('Santos')\nprint('santos overview comps:', r['matches_by_competition'], '| fifa:', r['fifa_players'] and r['fifa_players']['player_count'])\n\n# perf\nt0=time.time(); kb.search_matches(team='Flamengo', opponent='Corinthians'); print(f'simple lookup