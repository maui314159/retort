timestamp=2026-08-31T18:21:05.225Z level=INFO run=dde7c20f message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport csv, sys\nsys.path.insert(0, '.')\nfrom soccer_mcp.loaders import parse_date\n\ndef load(fn):\n    with open('data/kaggle/'+fn, encoding='utf-8-sig') as f:\n        return list(csv.DictReader(f))\n\nbra = load('Brasileirao_Matches.csv')\nnovo = load('novo_campeonato_brasileiro.csv')\nbrf = load('BR-Football-Dataset.csv')\n\n# Brasileirao: (season, home_base, away_base) -> date\nimport re\ndef base_bra(r): return r['home_team'].split('-')[0].strip().lower()\ndef away_bra(r): return r['away_team'].split('-')[0].strip().lower()\nbra_by = {}\nfor r in bra:\n    bra_by[(r['season'], base_bra(r), away_bra(r))] = r['datetime'][:10]\n\n# novo vs bra date agreement\nagree = dis = 0\nfor r in novo:\n    k = (r['Ano'], r['Equipe_mandante'].split('-')[0].strip().lower(), r['Equipe_visitante'].split('-')[0].strip().lower())\n    if k in bra_by:\n        if bra_by[k] == r['Data'].split('/')[::-1] and False: pass\n        d,m,y = r['Data'].split('/')\n        iso = f\"{y}-{m}-{d}\"\n        if bra_by[k] == iso: agree += 1\n        else: dis += 1\nprint('novo vs bra date:', agree, 'agree /', dis, 'disagree')\n\n# brf vs bra date agreement (Serie A only)\nagree = dis = 0\nmism = []\nfor r in brf:\n    if r['tournament'] != 'Serie A': continue\n    k = (r['date'][:4], r['home'].lower(), r['away'].lower())\n    if k in bra_by:\n        if bra_by[k] == r['date']: agree += 1\n        else: dis += 1; mism.append((k, bra_by[k], r['date']))\nprint('brf vs bra date:', agree, 'agree /', dis, 'disagree')\nfor m in mism[:10]: print(m)\n\n# Brazilian Cup vs BR-Football Copa do Brasil: date overlap & season\ncup = load('Brazilian_Cup_Matches.csv')\ncup_by = {}\nfor r in cup:\n    cup_by[(r['home_team'], r['away_team'], r['datetime'][:10])] = r['season']\nboth = miss = 0\nfor r in brf:\n    if r['tournament'] != 'Copa do Brasil': continue\n    # crude name join is hard; count by date only\nprint('cup seasons for 2021-01..2021-04 dates:', sorted(set(r['season'] for r in cup if r['datetime'][:7] in ('2021-01','2021-02','2021-03','2021-04'))))\nprint('brf copa rows in 2021-01..04:', sum(1 for r in brf if r['tournament']=='Copa do Brasil' and r['date'][:7] in ('2021-01','2021-02','2021-03','2021-04')))\nEOF" action.permission=bash action.action=allow action.pattern=*
