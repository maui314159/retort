timestamp=2026-09-01T06:09:52.066Z level=INFO run=f180ecb5 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, re, unicodedata\ndef fold(s):\n    s = unicodedata.normalize('NFKD', s)\n    s = ''.join(ch for ch in s if not unicodedata.combining(ch))\n    return re.sub(r'[^a-z0-9]', '', s.lower()).replace('athletico','atletico')\nnames = set()\nfor r in csv.DictReader(open('data/kaggle/BR-Football-Dataset.csv', encoding='utf-8-sig')):\n    names.add(r['home']); names.add(r['away'])\nwant = ('nautico','confianca','remo','macae','mogi','portuguesa','altos','acreano','campinense','moto','pouso','brasil de pelotas','novorizontino','guaratingueta','amazonas')\nfor n in sorted(names):\n    if any(w in fold(n) for w in want): print(repr(n))\nprint('--- cup counterparts:')\ncup = set()\nfor r in csv.DictReader(open('data/kaggle/Brazilian_Cup_Matches.csv', encoding='utf-8-sig')):\n    cup.add(r['home_team']); cup.add(r['away_team'])\nfor n in sorted(cup):\n    if any(w in fold(n) for w in ('nautico','confianca','remo','macae','mogi','portuguesa','altos','acreano','campinense','moto','pouso','pelotas','novorizontino')):\n        print(repr(n))\nEOF" action.permission=bash action.action=allow action.pattern=*
