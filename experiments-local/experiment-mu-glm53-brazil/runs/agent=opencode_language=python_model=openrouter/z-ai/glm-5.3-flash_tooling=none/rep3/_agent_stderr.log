timestamp=2026-09-01T03:18:43.751Z level=INFO run=2973fea4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport sys\nsys.path.insert(0, '.')\nfrom brazilian_soccer.normalize import TeamRegistry, parse_team_name, canonical_key, resolve_alias, BR_STATES, DEFAULT_STATE\nfrom brazilian_soccer import loader\nfrom collections import defaultdict\n\nreg = TeamRegistry()\nrows = loader.load_match_rows(reg)\nreg.finalize()\n\n# audit: bases with >=2 BR states\nstates_by_base = defaultdict(set)\nfor (bk, code) in reg._variants:\n    if code in BR_STATES:\n        states_by_base[bk].add(code)\n\nprint(\"=== ambiguous bases (>=2 states), with bare variant? and default? ===\")\nfor bk, states in sorted(states_by_base.items()):\n    if len(states) >= 2:\n        has_bare = (bk, None) in reg._variants\n        has_default = bk in DEFAULT_STATE\n        flag = \"OK\" if (not has_bare or has_default) else \"MISSING-DEFAULT\"\n        if flag != \"OK\":\n            disp = [reg._display.get(f\"{bk}|{s}\") for s in sorted(states)]\n            print(f\"{flag:16} {bk:28} states={sorted(states)} bare_raws={reg._variants.get((bk, None), [])}\")\nEOF" action.permission=bash action.action=allow action.pattern=*
