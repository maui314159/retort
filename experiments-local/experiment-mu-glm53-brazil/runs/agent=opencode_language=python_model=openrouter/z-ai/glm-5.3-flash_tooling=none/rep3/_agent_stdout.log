retort-local-0bivsr25/retort-e0c09c17c08e/brazilian_soccer/analytics.py\n@@ -119,9 +119,9 @@\n         else:\n             winner, loser, wf, lf = m.away_key, m.home_key, m.away_goal, m.home_goal\n         out.append({\"margin\": margin, \"winner\": winner, \"loser\": loser,\n                     \"winner_goals\": wf, \"loser_goals\": lf, \"match\": m})\n-    out.sort(key=lambda x: (-x[\"margin\"], x[\"match\"].date or __import__(\"datetime\").date.min))\n+    out.sort(key=lambda x: (-x[\"margin\"], x[\"match\"].date or date.min))\n     return out[:top]\n \n \n def aggregate_stats(matches: list[Match]) -> dict:\n","additions":1,"deletions":1},"truncated":false},"title":"brazilian_soccer/analytics.py","time":{"start":1788233027357,"end":1788233027359}},"id":"prt_05afe8f13001nb6Y1Vvx69hJF3","sessionID":"ses_fa52b88b3ffeUF09L5H3uZ1cg4","messageID":"msg_05afe75cb001p983JdwxmRlswy"}}
