timestamp=2026-09-01T06:15:07.332Z level=INFO run=f180ecb5 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nfrom brazilian_soccer import SoccerData, SoccerService\ndata = SoccerData(); svc = SoccerService(data)\nprint(svc.league_standings(season=2020)[-6:])\nprint('===')\ns2023 = svc.league_standings(season=2023)\nprint(s2023[:200]); print('top GF line:', [l for l in s2023.splitlines() if l.startswith('1.')])\ngf = {}\nfor m in data.matches:\n    if m.competition=='brasileirao' and m.season==2023 and m.played:\n        gf[m.home.key] = gf.get(m.home.key,0)+m.home_goals\n        gf[m.away.key] = gf.get(m.away.key,0)+m.away_goals\ntop = sorted(gf.items(), key=lambda kv: -kv[1])[:3]\nprint('top GF 2023:', [(data.registry.display(k), v) for k, v in top])\nprint('===')\nprint(svc.search_matches(team=\"Flamengo\", opponent=\"Corinthians\", limit=1)[:150])\nprint('===')\nr = svc.search_players(name=\"Gabriel Barbosa\")\nprint(r[:200])\nprint('===')\nprint(svc.search_players(name=\"Gabigol\")[:200])\nprint('===')\nms = [m for m in data.matches if m.stats and m.competition=='brasileirao' and m.season==2019]\nprint('serie A 2019 matches with stats:', len(ms))\nbw = svc.biggest_wins(competition=\"Brasileirão\", limit=3)\nprint(bw)\nprint('===')\nprint(svc.league_standings(season=2023)[:400])\nEOF" action.permission=bash action.action=allow action.pattern=*
