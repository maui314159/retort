timestamp=2026-08-31T19:29:13.051Z level=INFO run=ec94ecf4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nfrom brazilian_soccer_mcp.service import SoccerDataService\nsvc = SoccerDataService(\"data/kaggle\")\nreg = svc.registry\nprint(\"'vasco da gama' in displays:\", \"vasco da gama\" in reg._displays)\nprint(\"'vasco da gama' in key_counts:\", \"vasco da gama\" in reg._key_counts, reg._key_counts.get(\"vasco da gama\"))\nprint(\"'vasco' in key_counts:\", reg._key_counts.get(\"vasco\"))\nprint(\"displays for vasco da gama:\", reg._displays.get(\"vasco da gama\"))\nprint(\"displays for vasco:\", reg._displays.get(\"vasco\"))\n# what keys do matches use?\nfrom collections import Counter\nc = Counter()\nfor m in svc.matches:\n    for k in (m.home_key, m.away_key):\n        if \"vasco\" in k: c[k]+=1\nprint(\"match keys:\", dict(c))\nprint(\"resolve Vasco:\", reg.resolve(\"Vasco\").key)\nprint(\"canonical Vasco:\", reg.canonical(\"Vasco\"))\nprint(\"canonical 'Vasco da Gama-RJ':\", reg.canonical(\"Vasco da Gama-RJ\"))\nEOF" action.permission=bash action.action=allow action.pattern=*
