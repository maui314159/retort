timestamp=2026-08-31T18:47:15.250Z level=INFO run=9abcf33e message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv, re, unicodedata\nfrom collections import Counter\n\ndef sa(s): return ''.join(c for c in unicodedata.normalize('NFD', s) if unicodedata.category(c)!='Mn')\ndef canon(n):\n    n = sa(n).lower().strip()\n    n = re.sub(r'\\s*\\(antigo[^)]*\\)', '', n)\n    m = re.search(r'^(.*?)[\\s\\-]+(sp|rj|mg|pr|rs|sc|pe|ba|ce|go|mt|ms|pa|pb|rn|al|se|pi|ma|to|ro|rr|ac|ap|am|df|es)$', n)\n    if m and m.group(1).strip(): return (m.group(1).strip(), m.group(2))\n    return (n, None)\n\ndef load(path):\n    with open(path, encoding='utf-8') as f:\n        return list(csv.DictReader(f))\n\nbrf = load('data/kaggle/BR-Football-Dataset.csv')\na22 = [r for r in brf if r['tournament']=='Serie A' and r['date'][:4]=='2022']\nprint(\"BRF 2022 Serie A matches:\", len(a22))\nbm = load('data/kaggle/Brasileirao_Matches.csv')\nb22 = [r for r in bm if r['season']=='2022' and r['home_goal'] not in ('NA','')]\nprint(\"BM 2022 played:\", len(b22))\n\n# Palmeiras 2022 from BRF\ndef rec(rows, base, season_key, date_prefix=None):\n    w=d=l=gf=ga=n=0\n    for r in rows:\n        h,_ = canon(r['home']); a,_ = canon(r['away'])\n        hg,ag = int(float(r['home_goal'])), int(float(r['away_goal']))\n        if base in (h,a):\n            n+=1\n            if h==base: sc,oc=gf_,ga_=hg,ag\n            else: sc,oc=ag,hg\n            gf+=sc; ga+=oc\n            if sc>oc: w+=1\n            elif sc==oc: d+=1\n            else: l+=1\n    return n,w,d,l,gf,ga\nprint(\"Palmeiras 2022 BRF:\", rec(a22, 'palmeiras', None))\nch22=[r for r in a22 if canon(r['home'])[0]=='corinthians']\nprint(\"Corinthians home 2022 BRF:\", rec(ch22, 'corinthians', None))\n\n# 2022 standings BRF top2 + bottom4\ndef table(rows):\n    t={}\n    for r in rows:\n        h,_=canon(r['home']); a,_=canon(r['away'])\n        hg,ag=int(float(r['home_goal'])),int(float(r['away_goal']))\n        for x in (h,a): t.setdefault(x,{'p':0,'w':0,'d':0,'l':0,'gf':0,'ga':0})\n        if hg>ag: t[h]['p']+=3;t[h]['w']+=1;t[a]['l']+=1\n        elif hg<ag: t[a]['p']+=3;t[a]['w']+=1;t[h]['l']+=1\n        else: t[h]['p']+=1;t[a]['p']+=1;t[h]['d']+=1;t[a]['d']+=1\n        t[h]['gf']+=hg;t[h]['ga']+=ag;t[a]['gf']+=ag;t[a]['ga']+=hg\n    return sorted(t.items(), key=lambda kv:(-kv[1]['p'],-kv[1]['w'],-(kv[1]['gf']-kv[1]['ga'])))\nst22 = table(a22)\nprint(\"2022 BRF top2:\", [(t,e['p']) for t,e in st22[:2]], \" bottom4:\", [(t,e['p']) for t,e in st22[-4:]], \" teams:\", len(st22))\n\n# Full-dataset Fla-Flu with stateful keys (BM primary 2012-2022, novo 2003-2011, BRF 2023, all comps)\nnv = load('data/kaggle/novo_campeonato_brasileiro.csv')\nlib = load('data/kaggle/Libertadores_Matches.csv')\ncup = load('data/kaggle/Brazilian_Cup_Matches.csv')\nallm = []\nfor r in bm:\n    if r['season']>='2012': allm.append((r['datetime'][:10], canon(r['home_team'])[0]+'/'+canon(r['home_team'])[1], canon(r['away_team'])[0]+'/'+canon(r['away_team'])[1], r['home_goal'], r['away_goal'], 'brasileirao', r['season']))\nfor r in nv:\n    if r['Ano']<'2012': allm.append((r['Data'][6:]+'-'+r['Data'][3:5]+'-'+r['Data'][:2], canon(r['Equipe_mandante'])[0], canon(r['Equipe_visitante'])[0], r['Gols_mandante'], r['Gols_visitante'], 'brasileirao', r['Ano']))\nfor r in a22pass := [r for r in brf if r['tournament']=='Serie A' and r['date'][:4]=='2023']:\n    pass\nfor r in [r for r in brf if r['tournament']=='Serie A' and r['date'][:4]=='2023']:\n    allm.append((r['date'], canon(r['home'])[0], canon(r['away'])[0], str(int(float(r['home_goal']))), str(int(float(r['away_goal']))), 'brasileirao', '2023'))\ndef is_ff(h,a): return (h=='flamengo/rj' and a=='fluminense/rj') or (h=='fluminense/rj' and a=='flamengo/rj') or (h=='flamengo' and a=='fluminense') or (h=='fluminense' and a=='flamengo')\nff=[m for m in allm if is_ff(m[1],m[2]) and m[3] not in ('NA','','-')]\nfw=fld=d=0\nfor m in ff:\n    h,a,hg,ag=m[1],m[2],int(m[3]),int(m[4])\n    if hg>ag: fw += 1 if 'flamengo' in h else 0; fld += 1 if 'flamengo' in a else 0\n    elif hg<ag: fld += 1 if 'flamengo' in h else 0; fw += 1 if 'flamengo' in a else 0\n    else: d+=1\nprint(\"\\nFla-Flu Brasileirao 2003-2023:\", len(ff), \"matches | Flamengo:\", fw, \"Fluminense:\", fld, \"Draws:\", d)\nEOF" action.permission=bash action.action=allow action.pattern=*
