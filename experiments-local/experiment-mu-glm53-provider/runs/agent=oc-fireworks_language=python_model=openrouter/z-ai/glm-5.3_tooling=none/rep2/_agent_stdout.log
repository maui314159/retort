ic subtraction above is error-prone; recompute\n        # cleanly instead.\n        table = defaultdict(TeamRecord)\n        played_count = 0\n        for match in self.data.matches:\n            if match.competition != comp_id or match.season != season_int:\n                continue\n            if not match.played:\n                continue\n            played_count += 1\n            if venue_key == \"all\":\n                home_res = \"W\" if match.home_goals > match.away_goals else \"D\" if match.home_goals == match.away_goals else \"L\"\n                away_res = \"W\" if home_res == \"L\" else \"D\" if home_res == \"D\" else \"L\"\n                table[match.home.key].add(home_res, match.home_goals, match.away_goals)\n                table[match.away.key].add(away_res, match.away_goals, match.home_goals)\n            elif venue_key == \"home\":\n                home_res = \"W\" if match.home_goals > match.away_goals else \"D\" if match.home_goals == match.away_goals else \"L\"\n                table[match.home.key].add(home_res, match.home_goals, match.away_goals)\n            else:\n                away_res = \"W\" if match.away_goals > match.home_goals else \"D\" if match.away_goals == match.home_goals else \"L\"\n                table[match.away.key].add(away_res, match.away_goals, match.home_goals)"},"output":"Edit applied successfully.","metadata":{"diagnostics":{},"diff":"Index: /Users/maui/.retort/work/retort-local-x26yewvv/retort-d2915a49bf69/brazilian_soccer/service.py\n===================================================================\n--- /Users/maui/.retort/work/retort-local-x26yewvv/retort-d2915a49bf69/brazilian_soccer/service.py\n+++ /Users/maui/.retort/work/retort-local-x26yewvv/retort-d2915a49bf69/brazilian_soccer/service.py\n@@ -437,62 +437,21 @@\n     if match.competition != comp_id or match.season != season_int:\n         continue\n     if not match.played:\n         continue\n-    if venue_key == \"home\" and match.home.key == match.awa