rie_a/season:\", dict(sorted(s.items())))\ns=collections.Counter(m['season'] for m in matches if m['comp']=='copa_do_brasil')\nprint(\"copa/season:\", dict(sorted(s.items())))\n# for a over-count season, show duplicate examples\nfor sn in (2014, 2015):\n    seen=collections.Counter()\n    for m in matches:\n        if m['comp']=='serie_a' and m['season']==sn:\n            seen[(m['hk'],m['ak'])]+=1\n    dups=[k for k,v in seen.items() if v>1]\n    print(sn, \"orientations with >1 match:\", len(dups))\n    for k in dups[:5]:\n        print(\"   \", k, [(x['src'],str(x['d']),x['hg'],x['ag']) for x in cand[('serie_a',sn)+k]])\nEOF" action.permission=bash action.action=allow action.pattern=*
