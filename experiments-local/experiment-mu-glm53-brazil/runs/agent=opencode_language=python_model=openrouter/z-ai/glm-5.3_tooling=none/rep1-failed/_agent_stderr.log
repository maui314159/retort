timestamp=2026-08-31T18:14:46.887Z level=INFO run=dde7c20f message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport csv\ndef load(fn):\n    with open('data/kaggle/'+fn, encoding='utf-8') as f:\n        return list(csv.DictReader(f))\nfor fn, cols in [('BR-Football-Dataset.csv', ['home_goal','away_goal']),\n                 ('Brasileirao_Matches.csv', ['home_goal','away_goal']),\n                 ('Libertadores_Matches.csv', ['home_goal','away_goal']),\n                 ('Brazilian_Cup_Matches.csv', ['home_goal','away_goal']),\n                 ('novo_campeonato_brasileiro.csv', ['Gols_mandante','Gols_visitante'])]:\n    rows = load(fn)\n    bad = set()\n    for r in rows:\n        for c in cols:\n            v = r[c].strip()\n            try: float(v)\n            except ValueError: bad.add(v)\n    print(fn, 'non-float goal values:', sorted(bad)[:10])\nEOF" action.permission=bash action.action=allow action.pattern=*
