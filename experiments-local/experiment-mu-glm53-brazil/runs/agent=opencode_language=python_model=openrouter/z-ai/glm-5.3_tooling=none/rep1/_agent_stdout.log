, r\"-\\1\", display)\n+        self._displays[cid] = display\n \n+def _base_is_ambiguous(self, cid: str) -> bool:\n+    base = cid.rsplit(\"-\", 1)[0] if \"-\" in cid else cid\n+    ufs = self._base_ufs.get(base)\n+    if not ufs:\n+        return False\n+    return len({u for u in ufs if u}) > 1\n+\n def display(self, cid: str) -> str:\n     \"\"\"Human-friendly display name for a canonical id.\"\"\"\n     return self._displays.get(cid, cid.replace(\"-\", \" \").title())\n \n","additions":17,"deletions":9},"truncated":false},"title":"src/brasil_mcp/normalize.py","time":{"start":1788228134000,"end":1788228134002}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05ab3e467001p6pGfzbFCzaRDY","sessionID":"ses_fa566b1a7ffetmaN0ZgRQlI0ol","messageID":"msg_05ab3c2750012WFd6Q6CwDPyDK"}}
