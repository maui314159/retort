:('xv de piracicaba','SP'),\n('gremio novorizontino',None):('novorizontino','SP'),('gremio novorizontino','SP'):('novorizontino','SP'),\n('desportiva ferroviaria','ES'):('desportiva','ES'),('real noroeste capixaba','ES'):('real noroeste','ES'),\n}\nALIAS[('athletico paranaense','PR')]=('atletico','PR')\ndef parse(name, state=None):\n    s = re.sub(r'\\(.*?\\)',' ', deacc(name.strip())).replace(\"'\",'').replace('’','')\n    toks=[t for t in re.split(r'[\\s\\-]+',s) if t]\n    st=state\n    if toks and toks[-1].upper() in STATES and len(toks)>1: st=toks[-1].upper(); toks=toks[:-1]\n    elif toks and toks[-1].upper() in COUN and len(toks)>1: st=toks[-1].upper(); toks=toks[:-1]\n    toks=[t.replace('.','') for t in toks]\n    pre=' '.join(toks)\n    a=ALIAS.get((pre,st))\n    if a: pre,st=a; toks=pre.split()\n    else:\n        FORM={'ec','sc','fc','ce','ge','ca','ad','se','aa','club','clube','futebol','ltda','esporte'}\n        if pre not in ('sport boys','sport recife'):\n            while len(toks)>1 and toks[0] in FORM: toks=toks[1:]\n            while len(toks)>1 and toks[-1] in FORM: toks=toks[:-1]\n            while len(toks)>1 and len(toks[-1])==1: toks=toks[:-1]\n        core=' '.join(toks)\n        a=ALIAS.get((core,st))\n        if a: core,st=a\n        core=CORE_ALIAS.get(core,core); pre=core\n    return pre, st\ndef load(fn):\n    with open(fn, encoding='utf-8') as f: return list(csv.DictReader(f))\ndef pd_(s):\n    s=s.strip()\n    for f in ('%Y-%m-%d %H:%M:%S','%Y-%m-%d','%d/%m/%Y'):\n        try: return dt.datetime.strptime(s,f).date()\n        except ValueError: pass\n    return None\ndef g(s):\n    try: return int(float(s))\n    except (ValueError,TypeError): return None\nraw=[]\ndef novo_uf(team, uf):\n    uf={'BH':'BA'}.get(uf,uf)\n    if deacc(team)=='vitoria' and uf=='ES': uf='BA'\n    return uf or None\nfor r in load('data/kaggle/Brasileirao_Matches.csv'):\n    raw.append(('bras','serie_a',int(r['season']),pd_(r['datetime']),r['home_team'],r['away_team'],r['home_team_state'],r['away_team_state'],g(r['home_goal']),g(r['away_goal']),str(r['round']),None,None))\nfor r in load('data/kaggle/novo_campeonato_brasileiro.csv'):\n    raw.append(('novo','serie_a',int(r['Ano']),pd_(r['Data']),r['Equipe_mandante'],r['Equipe_visitante'],novo_uf(r['Equipe_mandante'],r['Mandante_UF']),novo_uf(r['Equipe_visitante'],r['Visitante_UF']),g(r['Gols_mandante']),g(r['Gols_visitante']),str(r['Rodada']),None,r['Arena']))\nfor r in load('data/kaggle/Brazilian_Cup_Matches.csv'):\n    raw.append(('cup','copa_do_brasil',int(r['season']),pd_(r['datetime']),r['home_team'],r['away_team'],None,None,g(r['home_goal']),g(r['away_goal']),str(r['round']),None,None))\nfor r in load('data/kaggle/Libertadores_Matches.csv'):\n    se=int(r['season']) if r['season']!='NA' else None\n    raw.append(('lib','libertadores',se,pd_(r['datetime']),r['home_team'],r['away_team'],None,None,g(r['home_goal']),g(r['away_goal']),None,r['stage'],None))\nfor r in load('data/kaggle/BR-Football-Dataset.csv'):\n    t={'Serie A':'serie_a','Serie B':'serie_b','Serie C':'serie_c','Copa do Brasil':'copa_do_brasil'}[r['tournament']]\n    raw.append(('brf',t,int(r['date'][:4]),pd_(r['date']),r['home'],r['away'],None,None,g(r['home_goal']),g(r['away_goal']),None,None,None))\ncore_states=collections.defaultdict(collections.Counter)\nfor src,comp,se,d,h,a,hst,ast,hg,ag,rnd,stage,venue in raw:\n    for name,st in ((h,hst),(a,ast)):\n        c,s=parse(name,st)\n        if s: core_states[c][s]+=1\ndef resolve(name, st):\n    c,s=parse(name,st)\n    if not s and c in core_states:\n        s=core_states[c].most_common(1)[0][0]\n    return f\"{c}|{s or ''}\"\ncand=collections.defaultdict(list)\nfor src,comp,se,d,h,a,hst,ast,hg,ag,rnd,stage,venue in raw:\n    cand[(comp,se,resolve(h,hst),resolve(a,ast))].append(dict(src=src,comp=comp,season=se,d=d,h=h,a=a,hg=hg,ag=ag,rnd=rnd,stage=stage,venue=venue))\nLEAGUE={'serie_a','serie_b','serie_c'}\nPRIO={'bras':0,'cup':1,'lib':1,'novo':2,'brf':3}\nmatches=[]\nfor k,v in cand.items():\n    comp=k[0]\n    v.sort(key=lambda x:(PRIO[x['src']], (x['d'] is None), x['d'] or dt.date.min))\n    if comp in LEAGUE:\n        best=None\n        for m in v:\n            if m['hg'] is not None: best=m; break\n        if best is None: best=v[0]\n        matches.append(best)\n    else:\n        kept=[]\n        for m in v:\n            dup=False\n            for i,kp in enumerate(kept):\n                same_score=(kp['hg'],kp['ag'])==(m['hg'],m['ag']) or (m['hg'],m['ag'])==(None,None) or (kp['hg'],kp['ag'])==(None,None)\n                close=(kp['d'] is None or m['d'] is None or abs((kp['d']-m['d']).days)<=2)\n                if same_score and close:\n                    if (m['hg'],m['ag'])!=(None,None) and (kp['hg'],kp['ag'])==(None,None): kept[i]=m\n                    dup=True; break\n            if not dup: kept.append(m)\n        matches.extend(kept)\nprint(\"total:\", len(matches), collections.Counter(m['comp'] for m in matches))\ns=collections.Counter(m['season'] for m in matches if m['comp']=='serie_a')\nprint(\"serie_a/season:\", dict(sorted(s.items())))\nbad=sum(1 for comp in LEAGUE for v in collections.Counter((m['comp'],m['season'],m['hk'],m['ak']) for m in matches if m['comp'] in LEAGUE).values() if v>1)\nprint(\"league orientations >1:\", bad)\ndef table(comp,season):\n    t=collections.defaultdict(lambda: [0]*8)\n    for m in matches:\n        if m['comp']==comp and m['season']==season and m['hg'] is not None:\n            hk,ak,hg,ag=m['hk'],m['ak'],m['hg'],m['ag']\n            t[hk][0]+=1; t[ak][0]+=1\n            t[hk][4]+=hg; t[ak][4]+=hg; t[hk][5]+=ag; t[ak][5]+=ag\n            if hg>ag: t[hk][1]+=1; t[ak][3]+=1; t[hk][7]+=3\n            elif hg<ag: t[ak][1]+=1; t[hk][3]+=1; t[ak][7]+=3\n            else: t[hk][2]+=1; t[ak][2]+=1; t[hk][7]+=1; t[ak][7]+=1\n    return sorted(t.items(), key=lambda kv:(-kv[1][7],-kv[1][1],-(kv[1][4]-kv[1][5]),-kv[1][4]))\nprint(\"2019 top3:\", table('serie_a',2019)[:3])\nprint(\"2018 champ:\", table('serie_a',2018)[:1])\nprint(\"2023 top2:\", table('serie_a',2023)[:2])\nprint(\"2020 bottom4:\", [k for k,v in table('serie_a',2020)[-4:]])\nprint(\"2014 top:\", table('serie_a',2014)[:1])\nc=w=d=l=gf=ga=0\nfor m in matches:\n    if m['comp']=='serie_a' and m['season']==2022 and m['hk']=='corinthians|SP' and m['hg'] is not None:\n        c+=1; gf+=m['hg']; ga+=m['ag']\n        w+= m['hg']>m['ag']; l+= m['hg']<m['ag']; d+= m['hg']==m['ag']\nprint(\"Corinthians home 2022:\", c,\"W\",w,\"D\",d,\"L\",l,\"GF\",gf,\"GA\",ga)\nfw=fl=dr=n=0\nfor m in matches:\n    if {m['hk'],m['ak']}=={'flamengo|RJ','fluminense|RJ'} and m['hg'] is not None:\n        n+=1\n        hg,ag=(m['hg'],m['ag']) if m['hk']=='flamengo|RJ' else (m['ag'],m['hg'])\n        fw+= hg>ag; fl+= hg<ag; dr+= hg==ag\nprint(\"Fla-Flu h2h:\", n, \"Fla\", fw, \"Flu\", fl, \"draw\", dr)\npl=[m for m in matches if m['comp']=='serie_a' and m['hg'] is not None]\nhw=sum(m['hg']>m['ag'] for m in pl); aw=sum(m['hg']<m['ag'] for m in pl); drw=sum(m['hg']==m['ag'] for m in pl)\nprint(\"serie_a played:\",len(pl),\"avg:\",round(sum(m['hg']+m['ag'] for m in pl)/len(pl),3),\"hw%:\",round(100*hw/len(pl),1),\"d%:\",round(100*drw/len(pl),1),\"aw%:\",round(100*aw/len(pl),1))\nbw=sorted([m for m in matches if m['hg'] is not None], key=lambda m:(-abs(m['hg']-m['ag']),-(m['hg']+m['ag'])))[:5]\nprint(\"biggest:\", [(str(m['d']),m['h'],m['hg'],m['ag'],m['a'],m['comp'],m['season']) for m in bw])\ncupm=[m for m in matches if m['comp']=='copa_do_brasil' and m['rnd'] and str(m['rnd']).isdigit()]\nfor sn in sorted(set(m['season'] for m in cupm if m['season'])):\n    rc=collections.Counter(int(m['rnd']) for m in cupm if m['season']==sn)\n    mx=max(rc)\n    if rc[mx]<=2:\n        fin=[(m['h'],m['hg'],m['ag'],m['a']) for m in cupm if m['season']==sn and int(m['rnd'])==mx]\n        print(\"cup final\", sn, \"round\", mx, fin)\n    else:\n        print(\"cup final\", sn, \"none (top round has\", rc[mx], \"matches)\")\nlibfin=[(m['season'],m['h'],m['hg'],m['ag'],m['a']) for m in matches if m['comp']=='libertadores' and m['stage']=='final']\nprint(\"lib finals:\", libfin)\nwith open('data/kaggle/fifa_data.csv', encoding='utf-8-sig') as f:\n    pros=list(csv.DictReader(f))\nprint(\"Gabriel Barbosa:\", [(r['Name'],r['Age'],r['Overall'],r['Club'],r['Position']) for r in pros if 'barbosa' in deacc(r['Name'])][:5])\nprint(\"Palmeiras 2023 matches:\", sum(1 for m in matches if m['season']==2023 and 'palmeiras|SP' in (m['hk'],m['ak'])))\naway=collections.defaultdict(lambda:[0.0,0])\nfor m in pl:\n    if m['hg']<m['ag']: away[m['ak']][0]+=3; away[m['ak']][1]+=1\n    elif m['hg']==m['ag']: away[m['ak']][0]+=1; away[m['ak']][1]+=1\n    else: away[m['ak']][1]+=1\nprint(\"best away ppg>=100:\", sorted(((k,round(v[0]/v[1],3),v[1]) for k,v in away.items() if v[1]>=100), key=lambda x:-x[1])[:4])\nhome=collections.defaultdict(lambda:[0.0,0])\nfor m in pl:\n    if m['hg']>m['ag']: home[m['hk']][0]+=3; home[m['hk']][1]+=1\n    elif m['hg']==m['ag']: home[m['hk']][0]+=1; home[m['hk']][1]+=1\n    else: home[m['hk']][1]+=1\nprint(\"best home ppg>=100:\", sorted(((k,round(v[0]/v[1],3),v[1]) for k,v in home.items() if v[1]>=100), key=lambda x:-x[1])[:4])\nprint(\"2023 top GF:\", [(k,v[4],v[7]) for k,v in sorted(table('serie_a',2023), key=lambda kv:-kv[1][4])[:3]])\n# derbies 2023 sample: Fla-Flu in 2023\ndd=[(m['d'],m['h'],m['hg'],m['ag'],m['a'],m['comp']) for m in matches if m['season']==2023 and {m['hk'],m['ak']}=={'flamengo|RJ','fluminense|RJ'}]\nprint(\"Fla-Flu 2023:\", dd)\n# Flamengo vs Corinthians last match\nfc=[m for m in matches if {m['hk'],m['ak']}=={'flamengo|RJ','corinthians|SP'} and m['hg'] is not None]\nlast=max(fc, key=lambda m:m['d'])\nprint(\"Fla x Cor last:\", last['d'], last['h'], last['hg'], last['ag'], last['a'], last['comp'], last['season'])\n# Brazil players in FIFA at Brazilian clubs\nbrclubkeys={'gremio|RS','cruzeiro|MG','santos|SP','fluminense|RJ','internacional|RS','botafogo|RJ','bahia|BA','parana|PR','atletico|MG','atletico|PR','vitoria|BA','chapecoense|SC'}\ncnt=collections.Counter()\nfor r in pros:\n    if r['Nationality']=='Brazil' and r['Club']:\n        c,s=parse(r['Club'])\n        k=f\"{c}|{s or (core_states[c].most_common(1)[0][0] if c in core_states else '')}\"\n        if k in brclubkeys: cnt[r['Club']]+=1\nprint(\"Brazilian players at BR clubs:\", dict(cnt))\nEOF" action.permission=bash action.action=allow action.pattern=*
