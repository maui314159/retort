s = self._select(competition=comp if comp != \"all competitions\" else None, season=year)\n        finals = [m for m in matches if \"final\" in _fold(m.round_label or \"\") or m.stage == \"final\"]\n        finals = [m for m in finals if \"semi\" not in _fold(m.round_label or \"\")]\n        if not finals:\n            return f\"No finals found for those criteria.\"\n\n        # Group by season + pairing to aggregate two-legged finals.\n        groups: dict[tuple, list[Match]] = {}\n        for m in finals:\n            groups.setdefault((m.season, m.home, m.away), []).append(m)\n            groups.setdefault((m.season, m.away, m.home), []).append(m)\n        merged: dict[tuple, list[Match]] = {}\n        for key, ms in groups.items():\n            if key not in merged and ms:\n                dedup = {id(m): m for m in ms}\n                merged[key] = sorted(dedup.values(), key=lambda m: m.date or date.min)\n\n        lines = [f\"Finals in {comp}\" + (f\" {year}\" if year else \"\") + \":\"]\n        for (season_key, home, away), ms in sorted(\n            merged.items(), key=lambda kv: (kv[0][0] or 0, kv[1][0].competition)\n        ):\n            legs = \" and \".join(self._match_line(m) for m in ms)\n            summary = self._aggregate_summary(ms, home)\n            season_txt = str(season_key) if season_key is not None else \"unknown season\"\n            lines.append(f\"- {season_txt}: {legs}\")\n            if summary:\n                lines.append(f\"  {summary}\")\n        return \"\\n\".join(lines)"},"output":"Edit applied successfully.","metadata":{"diagnostics":{},"diff":"Index: /Users/maui/.retort/work/retort-local-e6k_mc30/retort-d69f3f5e81d5/soccer_mcp/service.py\n===================================================================\n--- /Users/maui/.retort/work/retort-local-e6k_mc30/retort-d69f3f5e81d5/soccer_mcp/service.py\n+++ /Users/maui/.retort/work/retort-local-e6k_mc30/retort-d69f3f5e81d5/soccer_mcp/service.py\n@@ -587,35 +587,35 @@\n        