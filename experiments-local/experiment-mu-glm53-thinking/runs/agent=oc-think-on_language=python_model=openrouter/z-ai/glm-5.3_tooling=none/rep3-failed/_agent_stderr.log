timestamp=2026-09-01T17:03:59.423Z level=INFO run=a6cf503f message=evaluated permission=bash pattern="venv/bin/python -c \"\nimport csv\nfrom collections import defaultdict\n\ndef norm(t):\n    import unicodedata, re\n    t = unicodedata.normalize('NFKD', t).encode('ascii','ignore').decode()\n    t = re.sub(r'\\(.*?\\)', ' ', t)          # remove parens\n    t = re.sub(r'\\b(antigo)\\b', ' ', t)\n    t = t.replace('-', ' ')\n    t = re.sub(r'\\s+', ' ', t).strip().lower()\n    # strip trailing state UF\n    toks = t.split()\n    UFS = {'sp','rj','mg','rs','pr','sc','ba','pe','ce','go','mt','ms','df','pa','am','rn','pb','se','al','ma','pi','to','ro','rr','ap','es','ac'}\n    while len(toks) > 1 and toks[-1] in UFS: toks = toks[:-1]\n    return ' '.join(toks)\n\npts = defaultdict(int); table = defaultdict(lambda: [0,0,0,0,0,0])  # w d l gf ga\nfor src in ['data/kaggle/Brasileirao_Matches.csv']:\n    with open(src, encoding='utf-8-sig') as f:\n        for row in csv.DictReader(f):\n            if row['season'] != '2019': continue\n            h, a = norm(row['home_team']), norm(row['away_team'])\n            hg, ag = int(row['home_goal']), int(row['away_goal'])\n            table[h][3] += hg; table[h][4] += ag\n            table[a][3] += ag; table[a][4] += hg\n            if hg > ag: table[h][0]+=1; table[a][2]+=1; pts[h]+=3\n            elif hg < ag: table[a][0]+=1; table[h][2]+=1; pts[a]+=3\n            else: table[h][1]+=1; table[a][1]+=1; pts[h]+=1; pts[a]+=1\nstanding = sorted(pts.items(), key=lambda kv: -kv[1])\nfor team, p in standing[:5]:\n    w,d,l,gf,ga = table[team]\n    print(f'{p:3d} pts  {team:25s} {w}W {d}D {l}L {gf}:{ga}')\nprint('last 4 (relegated):')\nfor team, p in standing[-4:]:\n    w,d,l,gf,ga = table[team]\n    print(f'{p:3d} pts  {team:25s} {w}W {d}D {l}L {gf}:{ga}')\n\"" action.permission=bash action.action=allow action.pattern=*
