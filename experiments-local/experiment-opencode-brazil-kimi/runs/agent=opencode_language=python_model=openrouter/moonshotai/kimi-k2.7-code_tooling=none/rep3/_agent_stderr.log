timestamp=2026-06-25T03:28:24.122Z level=INFO run=9c04db1c message=evaluated permission=bash pattern="python3 - <<'PY'\nimport csv, os, re, collections\nbase = '/private/var/folders/t6/p1v727892_qc9xqqdzq2rpym0000gn/T/retort-local-tjpsd7_l/retort-8ea0ffcc10d3/data/kaggle'\n\ndef canon(n):\n    n=n.strip(); n=re.sub(r'\\s*-\\s*[A-Z]{2}$','',n); n=re.sub(r'\\s*\\([^)]*\\)','',n).strip()\n    return re.sub(r'[^A-Za-z0-9]+','',n).lower()\ndef score(v):\n    try: return int(float(v))\n    except: return None\n\ndef parse_season(r, file):\n    if file=='BR-Football-Dataset.csv':\n        # date year\n        d=r.get('date','')[:4]\n        try: return int(d)\n        except: return None\n    if file=='novo_campeonato_brasileiro.csv':\n        return int(r['Ano']) if r['Ano'] else None\n    return int(float(r['season'])) if r.get('season') and r['season'] not in ('','NA') else None\n\nfor file in ['Brasileirao_Matches.csv','Brazilian_Cup_Matches.csv','Libertadores_Matches.csv','BR-Football-Dataset.csv','novo_campeonato_brasileiro.csv']:\n    cnt=0\n    with open(os.path.join(base,file),encoding='utf-8') as f:\n        for r in csv.DictReader(f):\n            home=r.get('home_team') or r.get('home') or r.get('Equipe_mandante')\n            away=r.get('away_team') or r.get('away') or r.get('Equipe_visitante')\n            if parse_season(r,file)==2023 and (canon(home)=='palmeiras' or canon(away)=='palmeiras'):\n                cnt+=1\n    print(file, cnt)\nPY" action.permission=bash action.action=allow action.pattern=*
