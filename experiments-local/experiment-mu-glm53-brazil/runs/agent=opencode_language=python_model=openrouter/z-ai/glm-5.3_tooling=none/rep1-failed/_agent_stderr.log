timestamp=2026-08-31T18:14:56.828Z level=INFO run=dde7c20f message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport csv\ndef load(fn):\n    with open('data/kaggle/'+fn, encoding='utf-8') as f:\n        return list(csv.DictReader(f))\nfor fn, cols in [('Brasileirao_Matches.csv', ['home_goal','away_goal']),\n                 ('Libertadores_Matches.csv', ['home_goal','away_goal']),\n                 ('Brazilian_Cup_Matches.csv', ['home_goal','away_goal'])]:\n    rows = load(fn)\n    bad = [r for r in rows if any(r[c].strip() in ('NA','-','') for c in cols)]\n    print(fn, len(bad), 'rows w/ missing goals')\n    for r in bad[:5]: print('   ', r)\n# Also check Brasileirao date validity\nrows = load('Brasileirao_Matches.csv')\nbadd = [r for r in rows if r['datetime'].strip() in ('NA','')]\nprint('Brasileirao bad dates:', len(badd))\nEOF" action.permission=bash action.action=allow action.pattern=*
