timestamp=2026-09-01T17:13:23.934Z level=INFO run=a6cf503f message=evaluated permission=bash pattern="venv/bin/python -c \"\nfrom brazilian_soccer import load_soccer_data\nfrom brazilian_soccer.loader import BRASILEIRAO_A\nd = load_soccer_data()\n\n# Compare the same fixture (2019 Série A) across sources\nfrom collections import defaultdict\nby_fixture = defaultdict(list)\nfor m in d.matches:\n    if m.competition == BRASILEIRAO_A and m.season == 2019:\n        by_fixture[(m.date, m.home, m.away)].append((m.source, m.home_goals, m.away_goals))\n\ndups = {k: v for k, v in by_fixture.items() if len(v) > 1}\nprint('fixtures appearing >1 time in 2019:', len(dups))\nfor k, v in list(dups.items())[:5]: print(' ', k, v)\nmissing_in = {'novo_campeonato_brasileiro.csv': 0, 'Brasileirao_Matches.csv': 0, 'BR-Football-Dataset.csv': 0}\nsrc_count = defaultdict(set)\nfor (dt, h, a), v in by_fixture.items():\n    for source, hg, ag in v: src_count[(dt,h,a)].add(source)\nall3 = sum(1 for s in src_count.values() if len(s)==3)\nonly2 = sum(1 for s in src_count.values() if len(s)==2)\nprint('fixtures in all 3 sources:', all3, '| in exactly 2:', only2, '| total fixtures:', len(by_fixture))\n# Where do 2-source fixtures differ?\nfrom collections import Counter\npair_count = Counter()\nfor (dt,h,a), v in by_fixture.items():\n    if len(v) > 1:\n        key = tuple(sorted(set(s for s,_,_ in v)))\n        pair_count[key] += 1\nfor k, n in pair_count.most_common(): print(n, k)\n# score mismatches for same fixture\nmismatch = 0\nfor (dt,h,a), v in by_fixture.items():\n    if len(v) > 1 and len({(hg,ag) for _,hg,ag in v}) > 1:\n        mismatch += 1\nprint('same-fixture score mismatches:', mismatch)\n\"" action.permission=bash action.action=allow action.pattern=*
