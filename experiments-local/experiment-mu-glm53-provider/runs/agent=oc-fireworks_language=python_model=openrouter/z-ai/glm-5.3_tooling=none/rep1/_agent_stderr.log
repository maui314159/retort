timestamp=2026-09-01T05:25:59.104Z level=INFO run=2c158548 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, unicodedata, datetime as dt\ndef deacc(s): return ''.join(c for c in unicodedata.normalize('NFKD', s) if not unicodedata.combining(c)).lower()\nSTATES={'AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'}\nALIAS={('atletico mineiro','MG'):('atletico','MG'),('athletico paranaense','PR'):('atletico','PR'),('atletico paranaense','PR'):('atletico','PR'),('vasco da gama',None):('vasco','RJ'),('vasco da gama','RJ'):('vasco','RJ'),('sport recife',None):('sport','PE')}\nimport re\ndef key(name, state=None):\n    s = deacc(name.strip())\n    s = re.sub(r'\\(.*?\\)',' ',s)\n    s = s.replace('’',\"'\").replace(\"'\",'')\n    toks=[t for t in re.split(r'[\\s\\-]+',s) if t]\n    st = state\n    if toks and toks[-1].upper() in STATES and len(toks)>1:\n        st=toks[-1].upper(); toks=toks[:-1]\n    toks=[t.replace('.','') for t in toks]\n    FORM={'ec','sc','fc','ce','ge','ca','ad','se','aa','club','clube','futebol','ltda','esporte'}\n    while len(toks)>1 and toks[0] in FORM: toks=toks[1:]\n    while len(toks)>1 and toks[-1] in FORM: toks=toks[:-1]\n    while len(toks)>1 and len(toks[-1])==1: toks=toks[:-1]\n    core=' '.join(toks)\n    a=ALIAS.get((core,st))\n    if a: core,st=a\n    return f\"{core}|{st or ''}\"\n\ndef load(fn):\n    with open(fn, encoding='utf-8') as f: return list(csv.DictReader(f))\n\ndef pd_(s):\n    s=s.strip()\n    for f in ('%Y-%m-%d %H:%M:%S','%Y-%m-%d','%d/%m/%Y'):\n        try: return dt.datetime.strptime(s,f).date()\n        except ValueError: pass\n    return None\n\nm={}\ndef add(src, comp, row, date_s, h,a,hg,ag, season, hst=None, ast=None):\n    d=pd_(date_s)\n    k=(comp,int(season),d,key(h,hst),key(a,ast))\n    if k not in m: m[k]=(src,h,a,hg,ag)\n    else:\n        old=m[k]\n        if (old[3],old[4])!=(hg,ag): print(\"SCORE MISMATCH\",k,old,src,(hg,ag))\n\nfor r in load('data/kaggle/Brasileirao_Matches.csv'):\n    add('bras','serie_a',r,r['datetime'],r['home_team'],r['away_team'],int(r['home_goal']),int(r['away_goal']),r['season'])\nfor r in load('data/kaggle/novo_campeonato_brasileiro.csv'):\n    add('novo','serie_a',r,r['Data'],r['Equipe_mandante'],r['Equipe_visitante'],int(r['Gols_mandante']),int(r['Gols_visitante']),r['Ano'],r['Mandante_UF'],r['Visitante_UF'])\nfor r in load('data/kaggle/BR-Football-Dataset.csv'):\n    if r['tournament']=='Serie A':\n        add('brf','serie_a',r,r['date'],r['home'],r['away'],int(float(r['home_goal'])),int(float(r['away_goal'])),r['date'][:4])\n\nimport collections\nc=collections.Counter((s,se) for (co,se,d,hk,ak) in m for s in [m[(co,se,d,hk,ak)][0]])\nper=collections.defaultdict(collections.Counter)\nfor k,v in m.items(): per[k[1]][v[0]]+=1\nprint(\"total serie_a dedup:\", len(m))\nfor se in sorted(per): print(se, dict(per[se]))\nEOF" action.permission=bash action.action=allow action.pattern=*
