sv', encoding='utf-8-sig')):\n        if r['tournament'] != 'Serie A': continue\n        season = r['date'][:4]\n        out[(fold(r['home']), fold(r['away']), season)] = (r['home_goal'], r['away_goal'])\n    return out\nbf = load_brf()\ncommon2 = set(bf) & set(br)\ndiff2 = [k for k in common2 if bf[k] != br[k][:2]]\nprint('BRF-vs-BR overlap:', len(common2), 'disagreements:', len(diff2), diff2[:5])\n\n# team name variants across files\nteams_br = collections.Counter(re.sub(r'-[A-Z]{2}$','',r['home_team']) for r in csv.DictReader(open(base+'Brasileirao_Matches.csv', encoding='utf-8-sig')))\nteams_brf = collections.Counter()\nfor r in rows_brf_src if False else []: pass\nteams_brf = collections.Counter(r['home'] for r in csv.DictReader(open(base+'BR-Football-Dataset.csv', encoding='utf-8-sig')) if r['tournament']=='Serie A')\nteams_nv = collections.Counter(r['Equipe_mandante'] for r in csv.DictReader(open(base+'novo_campeonato_brasileiro.csv', encoding='utf-8-sig')))\nprint('\\nSerie A variants (br | brf | novo):')\nkeys = {}\nfor name, cnt in teams_br.items(): keys.setdefault(fold(name), {})[0] = (name, cnt)\nfor name, cnt in teams_brf.items(): keys.setdefault(fold(name), {})[1] = (name, cnt)\nfor name, cnt in teams_nv.items(): keys.setdefault(fold(name), {})[2] = (name, cnt)\nfor k, d in sorted(keys.items()):\n    if 0 in d and (1 in d or 2 in d):\n        print(' ', {s: d.get(s) for s in (0,1,2) if s in d})\nEOF" action.permission=bash action.action=allow action.pattern=*
