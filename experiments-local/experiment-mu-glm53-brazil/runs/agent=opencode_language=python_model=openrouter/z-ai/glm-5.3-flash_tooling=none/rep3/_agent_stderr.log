timestamp=2026-09-01T03:14:59.300Z level=INFO run=2973fea4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport sys, csv\nsys.path.insert(0, '.')\nfrom brazilian_soccer.loader import load_all, read_csv, DATA_DIR\nfrom collections import Counter\n\nreg, matches, players = load_all()\n\n# 1. find clubs with wrong match counts in Serie A 2019 (should be 38 per team)\nsa2019 = [m for m in matches if m.competition == \"Brasileirão Serie A\" and m.season == 2019]\ncnt = Counter()\nfor m in sa2019:\n    cnt[m.home_key] += 1\n    cnt[m.away_key] += 1\nbad = {k: v for k, v in cnt.items() if v != 38}\nprint(\"Serie A 2019 matches:\", len(sa2019), \"| teams with wrong count:\", bad)\n\n# 2. Libertadores row with season 0\nlib0 = [m for m in matches if m.competition == \"Copa Libertadores\" and m.season == 0]\nprint(\"lib season-0 rows:\", [(m.home_raw, m.away_raw, m.date) for m in lib0])\nwith open(DATA_DIR / \"Libertadores_Matches.csv\", newline='', encoding='utf-8-sig') as f:\n    for r in csv.DictReader(f):\n        if not r['season'].strip():\n            print(\"raw row:\", dict(r))\nEOF" action.permission=bash action.action=allow action.pattern=*
