timestamp=2026-08-31T18:07:42.307Z level=INFO run=dde7c20f message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport csv, unicodedata\n\ndef strip_acc(s):\n    return ''.join(c for c in unicodedata.normalize('NFKD', s) if not unicodedata.combining(c))\n\ndef load(fn):\n    with open('data/kaggle/'+fn, encoding='utf-8') as f:\n        return list(csv.DictReader(f))\n\n# All distinct normalized team names from match files\nnames = set()\nfor r in load('Brasileirao_Matches.csv'):\n    names.add(r['home_team']); names.add(r['away_team'])\nfor r in load('Brazilian_Cup_Matches.csv'):\n    names.add(r['home_team']); names.add(r['away_team'])\nfor r in load('Libertadores_Matches.csv'):\n    names.add(r['home_team']); names.add(r['away_team'])\nfor r in load('novo_campeonato_brasileiro.csv'):\n    names.add(r['Equipe_mandante']); names.add(r['Equipe_visitante'])\nfor r in load('BR-Football-Dataset.csv'):\n    names.add(r['home']); names.add(r['away'])\n\n# focus on likely big-club variants\nbig = ['palmeiras','sao paulo','corinthians','santos','flamengo','fluminense','botafogo','vasco','gremio','internacional','cruzeiro','atletico','america','sport','ceara','bahia','vitoria','fortaleza','chapecoense','coritiba','avai','parana','goias','nautico','juventude','criciuma','figueirense','ponte','bragantino','cuiaba','athletico','barueri','guarani','brasiliense','ipatinga','joinville','santa cruz','csa']\nfor n in sorted(names):\n    ln = strip_acc(n).lower()\n    if any(b in ln for b in big):\n        print(repr(n))\nEOF" action.permission=bash action.action=allow action.pattern=*
