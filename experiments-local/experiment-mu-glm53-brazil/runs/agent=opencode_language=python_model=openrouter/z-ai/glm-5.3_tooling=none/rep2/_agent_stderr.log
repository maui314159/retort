timestamp=2026-08-31T19:05:47.784Z level=INFO run=ec94ecf4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv, unicodedata, re\nfrom collections import Counter, defaultdict\n\nUFS = {\"AC\",\"AL\",\"AP\",\"AM\",\"BA\",\"CE\",\"DF\",\"ES\",\"GO\",\"MA\",\"MT\",\"MS\",\"MG\",\"PA\",\"PB\",\"PR\",\"PE\",\"PI\",\"RJ\",\"RN\",\"RS\",\"RO\",\"RR\",\"SC\",\"SP\",\"SE\",\"TO\"}\nNOISE = {\"fc\",\"ec\",\"ac\",\"sc\",\"clube\",\"club\",\"do\",\"da\",\"de\",\"dos\",\"das\",\"e\",\"esporte\"}\n\ndef base_norm(t):\n    t = unicodedata.normalize(\"NFKD\", t).encode(\"ascii\",\"ignore\").decode().lower()\n    t = re.sub(r\"\\(.*?\\)\", \" \", t)\n    return re.sub(r\"[^a-z0-9]+\", \" \", t).strip()\n\ndef parse(t):\n    toks = base_norm(t).split()\n    uf = None\n    if len(toks) > 1 and toks[-1].upper() in UFS:\n        uf = toks[-1].upper(); toks = toks[:-1]\n    toks = [x for x in toks if x not in NOISE]\n    return \" \".join(toks), uf\n\ndef canon(name, uf=None):\n    bare, u = parse(name)\n    u = u or uf\n    if bare in (\"atletico mineiro\",): return \"atletico-mg\"\n    if bare in (\"atletico paranaense\",\"athletico paranaense\"): return \"atletico-pr\"\n    if bare == \"atletico goianiense\": return \"atletico-go\"\n    if bare in (\"sport recife\",\"sport club recife\"): return \"sport\"\n    if bare == \"cs alagoano\": return \"csa\"\n    if bare == \"america mineiro\": return \"america-mg\"\n    if u: return f\"{bare}-{u.lower()}\"\n    return bare\n\ndef load(path, **kw):\n    with open(path, encoding=\"utf-8\") as f:\n        return list(csv.DictReader(f))\n\nbra = load(\"data/kaggle/Brasileirao_Matches.csv\")\nnovo = load(\"data/kaggle/novo_campeonato_brasileiro.csv\")\nbrf = [r for r in load(\"data/kaggle/BR-Football-Dataset.csv\")]\n\n# overlap bra vs novo by (season, round, home, away)\ndef bra_k(r): return (r[\"season\"], int(r[\"round\"]), canon(r[\"home_team\"]), canon(r[\"away_team\"]))\ndef novo_k(r): return (r[\"Ano\"], int(r[\"Rodada\"]), canon(r[\"Equipe_mandante\"], r[\"Mandante_UF\"]), canon(r[\"Equipe_visitante\"], r[\"Visitante_UF\"]))\nkb = {bra_k(r) for r in bra}; kn = {novo_k(r) for r in novo}\nprint(\"bra keys:\", len(kb), \"novo keys:\", len(kn), \"overlap:\", len(kb & kn))\nby_season = Counter(s for s,_,_,_ in (kb & kn))\nprint(\"overlap by season:\", dict(sorted(by_season.items())))\n\n# overlap brf Serie A vs bra by (season, date, home, away)\ndef brf_k(r): return (r[\"date\"][:4], r[\"date\"], canon(r[\"home\"]), canon(r[\"away\"]))\nkbf = {(s,d,h,a) for s,d,h,a in (brf_k(r) for r in brf if r[\"tournament\"]==\"Serie A\")}\nkbra_d = {(r[\"datetime\"][:4], r[\"datetime\"][:10], canon(r[\"home_team\"]), canon(r[\"away_team\"])) for r in bra}\nprint(\"brf SerieA keys:\", len(kbf), \"bra date keys:\", len(kbra_d), \"date overlap:\", len(kbf & kbra_d))\n\n# same pair ignoring date within season: does brf 2019 pair-set equal bra 2019?\nb19 = {(canon(r[\"home_team\"]), canon(r[\"away_team\"])) for r in bra if r[\"season\"]==\"2019\"}\nf19 = {(canon(r[\"home\"]), canon(r[\"away\"])) for r in brf if r[\"tournament\"]==\"Serie A\" and r[\"date\"].startswith(\"2019\")}\nprint(\"2019 pair sets equal:\", b19 == f19, len(b19), len(f19))\nEOF" action.permission=bash action.action=allow action.pattern=*
