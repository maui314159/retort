{
  "name": "brazilian-soccer-mcp-server",
  "version": "1.0.0",
  "description": "MCP server providing a knowledge graph interface for Brazilian soccer data",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
