timestamp=2026-09-01T03:51:14.366Z level=INFO run=2973fea4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport sys\nsys.path.insert(0, '.')\nfrom brazilian_soccer.loader import load_all\nfrom collections import Counter\nreg, matches, players = load_all()\nprint(\"total matches:\", len(matches))\nfor y in (2019, 2020, 2021, 2022, 2023):\n    ms = [m for m in matches if m.competition == \"Brasileirão Serie A\" and m.season == y]\n    per = Counter()\n    for m in ms:\n        per[m.home_key] += 1; per[m.away_key] += 1\n    bad = {k: v for k, v in per.items() if v != 38}\n    print(f\"Serie A {y}: {len(ms)}\", \"| wrong:\", bad if bad else \"-\")\nfinals = [m for m in matches if m.competition == \"Copa do Brasil\" and m.stage == \"final\"]\nprint(\"Cup finals:\", len(finals), \"by season:\", dict(sorted(Counter(m.season for m in finals).items())))\n# sanity: 2021 champion should be Atletico-MG, 2020 Flamengo\nfrom brazilian_soccer.analytics import standings_table\nfor y in (2020, 2021, 2022):\n    ms = [m for m in matches if m.competition == \"Brasileirão Serie A\" and m.season == y]\n    print(y, \"champion:\", reg.display(standings_table(ms)[0][\"team\"]))\nEOF" action.permission=bash action.action=allow action.pattern=*
