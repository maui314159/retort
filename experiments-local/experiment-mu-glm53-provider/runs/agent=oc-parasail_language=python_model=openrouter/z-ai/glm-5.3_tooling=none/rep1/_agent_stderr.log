timestamp=2026-09-01T04:56:52.214Z level=INFO run=22cd9675 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport subprocess, json, sys, select\n\nproc = subprocess.Popen(\n    [\"./venv/bin/python\", \"server.py\"],\n    stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,\n    text=True, bufsize=1,\n)\n\ndef send(msg):\n    proc.stdin.write(json.dumps(msg) + \"\\n\")\n    proc.stdin.flush()\n\ndef read(timeout=10.0):\n    ready, _, _ = select.select([proc.stdout], [], [], timeout)\n    if not ready:\n        raise TimeoutError(\"no response from server\")\n    line = proc.stdout.readline()\n    return json.loads(line)\n\n# initialize\nsend({\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-03-26\",\"capabilities\":{},\"clientInfo\":{\"name\":\"test\",\"version\":\"0\"}}})\nr = read()\nassert r[\"result\"][\"protocolVersion\"] == \"2025-03-26\", r\nassert r[\"result\"][\"serverInfo\"][\"name\"] == \"brazilian-soccer-mcp\"\nprint(\"initialize OK:\", r[\"result\"][\"serverInfo\"])\n\n# initialized notification (no response expected)\nsend({\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"})\n\n# ping\nsend({\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"ping\"})\nr = read()\nassert r[\"result\"] == {}, r\nprint(\"ping OK\")\n\n# tools/list\nsend({\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/list\"})\nr = read()\nnames = [t[\"name\"] for t in r[\"result\"][\"tools\"]]\nprint(f\"tools/list OK: {len(names)} tools:\", names)\n\n# tools/call\nsend({\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"tools/call\",\"params\":{\"name\":\"head_to_head\",\"arguments\":{\"team_a\":\"Flamengo\",\"team_b\":\"Fluminense\"}}})\nr = read()\nres = json.loads(r[\"result\"][\"content\"][0][\"text\"])\nprint(\"tools/call OK: Fla-Flu\", res[\"matches_played\"], \"matches\")\nassert res[\"matches_played\"] == 44\n\n# unknown tool -> isError\nsend({\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"tools/call\",\"params\":{\"name\":\"nope\",\"arguments\":{}}})\nr = read()\nassert r[\"id\"] == 5 and \"error\" in r, r\nprint(\"unknown tool error OK:\", r[\"error\"][\"code\"])\n\n# tool-level QueryError -> isError result\nsend({\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"tools/call\",\"params\":{\"name\":\"team_stats\",\"arguments\":{\"team\":\"America\"}}})\nr = read()\nassert r[\"result\"].get(\"isError\") is True, r\nprint(\"isError OK:\", r[\"result\"][\"content\"][0][\"text\"][:80])\n\n# resources\nsend({\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"resources/list\"})\nr = read()\nuris = [x[\"uri\"] for x in r[\"result\"][\"resources\"]]\nprint(\"resources/list OK:\", uris)\nsend({\"jsonrpc\":\"2.0\",\"id\":8,\"method\":\"resources/read\",\"params\":{\"uri\":\"soccer://competitions\"}})\nr = read()\nbody = json.loads(r[\"result\"][\"contents\"][0][\"text\"])\nprint(\"resources/read OK:\", len(body[\"competitions\"]), \"competitions\")\n\n# malformed line\nproc.stdin.write(\"this is not json\\n\"); proc.stdin.flush()\nr = read()\nassert r[\"error\"][\"code\"] == -32700, r\nprint(\"parse error OK\")\n\n# method not found\nsend({\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"resources/subscribe\"})\nr = read()\nassert r[\"error\"][\"code\"] == -32601, r\nprint(\"method not found OK\")\n\nproc.stdin.close()\nproc.wait(timeout=10)\nprint(\"server exited with\", proc.returncode)\nEOF" action.permission=bash action.action=allow action.pattern=*
