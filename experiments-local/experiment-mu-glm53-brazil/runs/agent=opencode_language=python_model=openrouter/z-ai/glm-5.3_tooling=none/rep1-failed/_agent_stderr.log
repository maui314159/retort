timestamp=2026-08-31T18:26:08.620Z level=INFO run=dde7c20f message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, sys\nsys.path.insert(0, '.')\nfrom soccer_mcp.normalize import canonical_key, collapse\n\nwith open('data/kaggle/BR-Football-Dataset.csv', encoding='utf-8-sig') as f:\n    rows = list(csv.DictReader(f))\nbrf_teams = sorted(set([r['home'] for r in rows] + [r['away'] for r in rows]))\n\n# For each BR-Football team, show canonical key; flag ones whose base starts with a\n# prefix word (ec, fc, ca, sc, gd, aa, se, ac) suggesting an unmerged prefix form.\nPREFIXES = ('ec ','fc ','ca ','sc ','gd ','aa ','se ','ac ','clube ')\nfor t in brf_teams:\n    base, region = canonical_key(t)\n    stripped = base\n    for p in PREFIXES:\n        if base.startswith(p):\n            stripped = base[len(p):]\n            break\n    print(f'{t:28} -> ({base!r}, {region!r})' + ('   <== prefix-form' if stripped != base else ''))\nEOF" action.permission=bash action.action=allow action.pattern=*
