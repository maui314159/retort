timestamp=2026-09-01T17:14:36.652Z level=INFO run=a6cf503f message=evaluated permission=bash pattern="venv/bin/python -c \"\nimport csv\nfrom brazilian_soccer.normalize import team_key\nfrom brazilian_soccer import load_soccer_data\nd = load_soccer_data()\n# BR-Football names that produce keys NOT seen in the other files' key set\nother_keys = set()\nimport csv as _csv\nfor fn, cols in [('Brasileirao_Matches.csv', ['home_team','away_team']), ('Brazilian_Cup_Matches.csv', ['home_team','away_team']), ('Libertadores_Matches.csv', ['home_team','away_team'])]:\n    for r in _csv.DictReader(open('data/kaggle/'+fn, encoding='utf-8-sig')):\n        for c in cols: other_keys.add(team_key(r[c]))\nnovo_keys = set()\nfor r in _csv.DictReader(open('data/kaggle/novo_campeonato_brasileiro.csv', encoding='utf-8-sig')):\n    novo_keys.add(team_key(r['Equipe_mandante'], r['Mandante_UF'])); novo_keys.add(team_key(r['Equipe_visitante'], r['Visitante_UF']))\nknown = other_keys | novo_keys\nbrf = {}\nfor r in csv.DictReader(open('data/kaggle/BR-Football-Dataset.csv', encoding='utf-8-sig')):\n    for c in ('home','away'):\n        raw = r[c]\n        if raw not in brf:\n            k = team_key(raw)\n            if k not in known: brf[raw] = k\nprint('BR-Football names whose key is unknown elsewhere:', len(brf))\nfor raw, k in sorted(brf.items()): print(f'  {raw!r:40s} -> {k}')\n\"" action.permission=bash action.action=allow action.pattern=*
