timestamp=2026-09-01T06:09:15.899Z level=INFO run=f180ecb5 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\n# BR-Foot team bases with zero presence in the other (suffixed) files, having >=10 matches\nimport csv, re, unicodedata\nfrom collections import Counter\ndef fold(s):\n    s = unicodedata.normalize('NFKD', s)\n    s = ''.join(ch for ch in s if not unicodedata.combining(ch))\n    return re.sub(r'[^a-z0-9]', '', s.lower()).replace('athletico','atletico')\ndef base_of(n):\n    n = re.sub(r'\\s*\\(antigo[^)]*\\)', '', n)\n    for pat in (r'\\s*-\\s*([A-Z]{2})$', r'-([A-Z]{2})$', r'\\s+([A-Z]{2})$'):\n        m = re.search(pat, n)\n        if m and m.start() > 0: n = n[:m.start()]; break\n    toks = n.split()\n    while toks and toks[-1].lower() in ('fc','ec','sc','ac'): toks.pop()\n    while toks and toks[0].lower() in ('fc','ec','sc','ac'): toks.pop(0)\n    return fold(' '.join(toks) or n)\nother = set()\nfor f, cols in (('Brasileirao_Matches.csv', ('home_team','away_team')), ('Brazilian_Cup_Matches.csv', ('home_team','away_team')), ('Libertadores_Matches.csv', ('home_team','away_team'))):\n    for r in csv.DictReader(open('data/kaggle/'+f, encoding='utf-8-sig')):\n        for c in cols: other.add(base_of(r[c]))\nfor r in csv.DictReader(open('data/kaggle/novo_campeonato_brasileiro.csv', encoding='utf-8-sig')):\n    other.add(base_of(r['Equipe_mandante'])); other.add(base_of(r['Equipe_visitante']))\nbrf = Counter()\nfor r in csv.DictReader(open('data/kaggle/BR-Football-Dataset.csv', encoding='utf-8-sig')):\n    brf[base_of(r['home'])] += 1; brf[base_of(r['away'])] += 1\norphans = [(b, c) for b, c in brf.most_common() if b not in other and c >= 20]\nprint('brf bases (>=20 apps) absent from other sources:')\nfor b, c in orphans: print('  ', b, c)\nEOF" action.permission=bash action.action=allow action.pattern=*
