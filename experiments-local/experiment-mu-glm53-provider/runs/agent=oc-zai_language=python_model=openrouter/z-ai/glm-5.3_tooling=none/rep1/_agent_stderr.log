timestamp=2026-09-01T04:24:41.762Z level=INFO run=1a470e0e message=evaluated permission=bash pattern="./venv/bin/python << 'EOF'\nimport csv, collections\n\n# Check seasons per file\ndef seasons(path, col):\n    s = collections.Counter()\n    with open(path, encoding='utf-8') as f:\n        for row in csv.DictReader(f): s[row[col]] += 1\n    return dict(sorted(s.items()))\n\nprint('Cup seasons:', seasons('data/kaggle/Brazilian_Cup_Matches.csv', 'season'))\nprint('Lib seasons:', seasons('data/kaggle/Libertadores_Matches.csv', 'season'))\nprint('BRFB Copa do Brasil years:')\nyrs = collections.Counter()\nwith open('data/kaggle/BR-Football-Dataset.csv', encoding='utf-8') as f:\n    for row in csv.DictReader(f):\n        if row['tournament'] == 'Copa do Brasil': yrs[row['date'][:4]] += 1\nprint(dict(sorted(yrs.items())))\nEOF" action.permission=bash action.action=allow action.pattern=*
timestamp=2026-09-01T04:24:49.165Z level=INFO run=1a470e0e message=evaluated permission=bash pattern="./venv/bin/python << 'EOF'\nimport csv, collections, unicodedata, re\n\ndef norm(name):\n    # strip parens, state suffix, accents\n    name = re.sub(r'\\(.*?\\)', '', name)\n    name = re.sub(r'\\s*-\\s*[A-Z]{2}$', '', name.strip())\n    name = re.sub(r'-[A-Z]{2}$', '', name)\n    nk = unicodedata.normalize('NFKD', name)\n    return ''.join(c for c in nk if not unicodedata.combining(c)).strip().lower()\n\n# 2019 Brasileirao standings from Brasileirao_Matches\npts = collections.defaultdict(lambda: [0,0,0,0,0,0])  # W D L GF GA Pts\nfor path, hc, ac, hg, ag in [('data/kaggle/Brasileirao_Matches.csv','home_team','away_team','home_goal','away_goal')]:\n    with open(path, encoding='utf-8') as f:\n        for row in csv.DictReader(f):\n            if row['season'] != '2019': continue\n            h, a = norm(row[hc]), norm(row[ac])\n            hg_, ag_ = int(row[hg]), int(row[ag])\n            for t, gf, ga in [(h,hg_,ag_),(a,ag_,hg_)]:\n                s = pts[t]\n                s[3]+=gf; s[4]+=ga\n                if gf>ga: s[0]+=1; s[5]+=3\n                elif gf==ga: s[1]+=1; s[5]+=1\n                else: s[2]+=1\ntop = sorted(pts.items(), key=lambda kv: -kv[1][5])[:5]\nfor t, s in top: print(f'{t}: {s[5]} pts ({s[0]}W {s[1]}D {s[2]}L) GF{s[3]} GA{s[4]}')\nEOF" action.permission=bash action.action=allow action.pattern=*
