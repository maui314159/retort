timestamp=2026-09-01T04:40:58.584Z level=INFO run=1a470e0e message=evaluated permission=bash pattern="./venv/bin/python << 'EOF'\nimport time\nt0 = time.time()\nfrom brazilian_soccer_mcp.loaders import load_all\ndata = load_all('data/kaggle')\nprint(f\"load time: {time.time()-t0:.2f}s\")\nprint(\"matches:\", len(data.matches), \"| players:\", len(data.players))\nprint(\"skipped:\", data.skipped_rows, \"| dupes removed:\", data.duplicates_removed)\nprint(\"source rows:\", data.source_row_counts)\n\n# sanity: key ids\nfrom brazilian_soccer_mcp.normalizer import TeamRegistry\nreg = data.registry\nfor q in [\"Flamengo\", \"Flamengo-RJ\", \"Palmeiras-SP\", \"Atletico Mineiro\", \"Atlético-PR\",\n          \"Athletico\", \"Corinthians\", \"Botafogo RJ\", \"Sport Club do Recife\", \"Vasco da Gama\",\n          \"Ceará Sporting Club\", \"São Paulo\", \"Goiás\", \"América - MG\", \"Botafogo SP\"]:\n    try:\n        r = reg.resolve(q)\n        print(f\"  {q!r:28} -> {r.team_id:22} ({r.display})\" + (f\" alts={r.alternatives[:3]}\" if r.alternatives else \"\"))\n    except Exception as e:\n        print(f\"  {q!r:28} -> ERROR {e}\")\n\n# 2019 standings check\nfrom collections import defaultdict\nfrom brazilian_soccer_mcp.models import BRASILEIRAO_A\nrec = {}\nfor m in data.matches:\n    if m.competition == BRASILEIRAO_A and m.season == 2019 and m.played():\n        for tid, disp, gf, ga in [(m.home_id, m.home_display, m.home_goals, m.away_goals),\n                                   (m.away_id, m.away_display, m.away_goals, m.home_goals)]:\n            r = rec.setdefault(tid, [disp,0,0,0,0,0,0,0])\n            r[2]+=gf; r[3]+=ga; r[1]+=1\n            if gf>ga: r[4]+=1; r[7]+=3\n            elif gf==ga: r[5]+=1; r[7]+=1\n            else: r[6]+=1\ntop = sorted(rec.items(), key=lambda kv: (-kv[1][7], -(kv[1][4]-kv[1][6]), -kv[1][2]))[:5]\nfor tid, r in top:\n    print(f\"  {r[0]:20} {r[7]}pts {r[4]}W {r[5]}D {r[6]}L GF{r[2]} GA{r[3]} ({r[1]} matches)\")\nprint(\"teams in 2019 Serie A:\", len(rec))\nEOF" action.permission=bash action.action=allow action.pattern=*
