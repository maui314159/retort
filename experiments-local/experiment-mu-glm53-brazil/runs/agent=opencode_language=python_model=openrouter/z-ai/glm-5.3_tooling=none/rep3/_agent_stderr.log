timestamp=2026-09-01T13:52:29.968Z level=INFO run=d0d26016 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nfrom brazilian_soccer_mcp.dataset import load_matches\nfrom brazilian_soccer_mcp.normalize import normalize_team\nfrom collections import defaultdict\nraw, _ = load_matches()\nnames = defaultdict(lambda: defaultdict(set))\nfor m in raw:\n    for raw_name, team in ((m.home_name, m.home_team), (m.away_name, m.away_team)):\n        names[team.base][m.source].add((raw_name, team.state))\nfor base in ['saojose','saojosepoa','brasil','brasildepelotas','river','riverplate','operario','operariofc',\n             'novoperario','oeste','noroeste','realnoroeste','caxias','sercaxias','inter','interporto','uniao',\n             'crb','crbclubedereginas','abc','abcrn','guarani','guarany','asa','icasa','remo','clubedoremo',\n             'avai','avaifc','goias','goiasec','coritiba','coritibafc','ponte','pontepreta','figueirense','criciuma']:\n    if base in names:\n        print(f\"{base}: \" + \"; \".join(f\"{s}: {sorted(v)[:3]}\" for s, v in sorted(names[base].items())))\nEOF" action.permission=bash action.action=allow action.pattern=*
