{"type":"tool_use","timestamp":1788256243972,"sessionID":"ses_fa3ba9cb2ffeFGH9rzdcVMfYFE","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-969f8031620e6a3c","state":{"status":"completed","input":{"content":"\"\"\"BDD steps for performance.feature.\"\"\"\n\nfrom __future__ import annotations\n\nimport time\n\nfrom pytest_bdd import parsers, scenarios, then, when\n\nfrom conftest import _parse_args\n\nscenarios(\"features/performance.feature\")\n\n\n@when(parsers.parse('I time a call to \"{tool}\" with arguments \"{raw_args}\"'))\ndef timed_call(server, ctx, tool, raw_args):\n    start = time.perf_counter()\n    import asyncio\n\n    result = asyncio.run(server.call_tool(tool, _parse_args(raw_args)))\n    ctx[\"elapsed\"] = time.perf_counter() - start\n    ctx[\"tool_result\"] = result.content[0].text if result.content else \"\"\n    assert ctx[\"tool_result\"], \"tool produced no output\"\n\n\n@then(parsers.parse(\"the call should take less than {seconds:d} seconds\"))\ndef under_seconds(ctx, seconds):\n    assert ctx[\"elapsed\"] < seconds, f\"took {ctx['elapsed']:.2f}s (limit {seconds}s)\"\n\n\n@then(\"the dataset should contain more than 15000 matches\")\ndef dataset_size(dataset):\n    assert len(dataset.matches) > 15000\n","filePath":"/Users/maui/.retort/work/retort-local-7ooj92cj/retort-9b01b8399d96/tests/test_performance.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Users/maui/.retort/work/retort-local-7ooj92cj/retort-9b01b8399d96/tests/test_performance.py","exists":false,"truncated":false},"title":"tests/test_performance.py","time":{"start":1788256243967,"end":1788256243970}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05c60cddf001v0lqWD0XIoOZWF","sessionID":"ses_fa3ba9cb2ffeFGH9rzdcVMfYFE","messageID":"msg_05c60bf8d001GYdj0HzfcJ4Mtu"}}
