rk/retort-local-7ooj92cj/retort-7a36b7336902/brazilian_soccer_mcp/normalizer.py\n+++ /Users/maui/.retort/work/retort-local-7ooj92cj/retort-7a36b7336902/brazilian_soccer_mcp/normalizer.py\n@@ -473,8 +473,10 @@\n if not cleaned:\n     return None\n if cleaned in {\"all\", \"any\", \"*\", \"every competition\", \"all competitions\", \"everything\"}:\n     return \"all\"\n+if cleaned in COMPETITIONS:  # the canonical id itself (serie_a, ...)\n+    return cleaned\n hit = _ALIASES_TO_ID.get(cleaned)\n if hit:\n     return hit\n # Longer aliases may appear inside a phrase (\"who won the 2019\n","additions":2,"deletions":0},"truncated":false},"title":"brazilian_soccer_mcp/normalizer.py","time":{"start":1788243357761,"end":1788243357763}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"\"Unknown competition: 'serie_a'\"?! `normalize_competition('serie_a')` — squash('serie_a') → 'serie_a' — the alias table has 'serie-a' (with hyphen) but NOT 'serie_a' (underscore)! The competition ID itself isn't in the alias list! Previously standings worked because... wait, earlier it worked! Because the SUBSTRING fallback: 'serie a' (4 chars, with space) in 'serie_a'? NO — 'serie a' has a space, 'serie_a' has underscore → substring fails. Hmm — but earlier runs DID work with competition='serie_a'... How? OH — earlier the fallback loop included single-letter alias 'a': `'a' in 'serie_a'` → TRUE → serie_a! That accidental match made ids work. Now I excluded short aliases from substring → 'serie_a' no longer resolves. The FIX: add the canonical ids themselves (with underscores) to the alias table, plus 'serie-a' already there. Add: 'serie_a','serie_b','serie_c','copa_do_brasil','libertadores' as exact aliases (they're the ids). Better: in normalize_competition, first check `cleaned in COMPETITIONS` (the id itself) → return it. Also add hyphen variants already present. Let me add id lookup.","format":"unknown","index":0}]}},"id":"prt_05b9c2a59001I08mEBnKeUwUlT",