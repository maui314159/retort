timestamp=2026-08-31T20:22:25.965Z level=INFO run=615f6cc2 message=evaluated permission=bash pattern="cat > /tmp/mcp_stdio_test.py <<'EOF'\nimport json, subprocess, sys, time\n\nproc = subprocess.Popen(\n    [sys.executable, \"-m\", \"brazilian_soccer_mcp\"],\n    stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,\n    text=True,\n)\n\ndef send(msg):\n    proc.stdin.write(json.dumps(msg) + \"\\n\")\n    proc.stdin.flush()\n\ndef recv():\n    line = proc.stdout.readline()\n    return json.loads(line) if line else None\n\nsend({\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"initialize\", \"params\": {\n    \"protocolVersion\": \"2025-06-18\",\n    \"capabilities\": {},\n    \"clientInfo\": {\"name\": \"e2e-test\", \"version\": \"1.0\"},\n}})\ninit = recv()\nprint(\"initialize ok:\", init[\"result\"][\"serverInfo\"][\"name\"], \"| tools capability:\", \"tools\" in init[\"result\"][\"capabilities\"])\n\nsend({\"jsonrpc\": \"2.0\", \"method\": \"notifications/initialized\"})\nsend({\"jsonrpc\": \"2.0\", \"id\": 2, \"method\": \"tools/list\"})\ntools = recv()\nnames = [t[\"name\"] for t in tools[\"result\"][\"tools\"]]\nprint(\"tools/list:\", len(names), \"tools\")\n\nsend({\"jsonrpc\": \"2.0\", \"id\": 3, \"method\": \"tools/call\", \"params\": {\n    \"name\": \"head_to_head\", \"arguments\": {\"team_a\": \"Flamengo\", \"team_b\": \"Vasco da Gama\"}}})\nh2h = recv()\nbody = json.loads(h2h[\"result\"][\"content\"][0][\"text\"])\nprint(\"head_to_head:\", body[\"summary\"][:100])\n\nsend({\"jsonrpc\": \"2.0\", \"id\": 4, \"method\": \"tools/call\", \"params\": {\n    \"name\": \"league_standings\", \"arguments\": {\"competition\": \"Brasileirão Série A\", \"season\": 2019}}})\ntable = recv()\nstandings = json.loads(table[\"result\"][\"content\"][0][\"text\"])\nprint(\"2019 champion:\", standings[\"standings\"][0][\"team\"], standings[\"standings\"][0][\"points\"], \"pts\")\n\nsend({\"jsonrpc\": \"2.0\", \"id\": 5, \"method\": \"tools/call\", \"params\": {\n    \"name\": \"search_players\", \"arguments\": {\"name\": \"Neymar\", \"limit\": 1}}})\nply = recv()\nprint(\"player:\", json.loads(ply[\"result\"][\"content\"][0][\"text\"])[\"players\"][0][\"name\"])\n\nproc.terminate()\nproc.wait(timeout=10)\nprint(\"E2E: PASS\")\nEOF" action.permission=bash action.action=allow action.pattern=*
