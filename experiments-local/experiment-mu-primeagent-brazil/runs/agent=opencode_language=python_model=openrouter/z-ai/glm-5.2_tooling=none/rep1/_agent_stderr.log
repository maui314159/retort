timestamp=2026-09-02T17:53:06.031Z level=INFO run=c4f449b2 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport asyncio, json, time\nfrom brazilian_soccer_mcp.server import get_server\ns=get_server()\nasync def call(name, args):\n    res=await s.call_tool(name, args)\n    return json.loads(res.content[0].text)\nasync def main():\n    t0=time.time()\n    calls={\n      \"find_matches\": {\"team\":\"Flamengo\",\"opponent\":\"Fluminense\",\"limit\":3},\n      \"head_to_head\": {\"team_a\":\"Palmeiras\",\"team_b\":\"Santos\",\"season\":2019},\n      \"team_stats\": {\"team\":\"Corinthians\",\"season\":2022,\"venue\":\"home\"},\n      \"compare_teams\": {\"team_a\":\"Palmeiras\",\"team_b\":\"Santos\",\"season\":2019},\n      \"competitions_for_team\": {\"team\":\"Flamengo\"},\n      \"search_players\": {\"nationality\":\"Brazil\",\"min_overall\":88,\"limit\":5},\n      \"top_brazilian_players\": {\"limit\":5},\n      \"players_for_club\": {\"club\":\"Santos\"},\n      \"top_clubs_by_nationality\": {\"nationality\":\"Brazil\",\"limit\":5},\n      \"standings\": {\"competition\":\"Brasileirão Serie A\",\"season\":2019},\n      \"champions\": {\"competition\":\"Brasileirão Serie A\"},\n      \"relegated_teams\": {\"competition\":\"Brasileirão Serie A\",\"season\":2019,\"n\":4},\n      \"average_goals\": {\"competition\":\"Brasileirão Serie A\",\"season\":2019},\n      \"biggest_wins\": {\"limit\":3},\n      \"home_away_balance\": {\"competition\":\"Brasileirão Serie A\",\"season\":2019},\n      \"derbies\": {\"season\":2019},\n    }\n    ok=0\n    for name,args in calls.items():\n        try:\n            r=await call(name,args)\n            ok+=1\n            if isinstance(r,list): summary=f\"list[{len(r)}]\"\n            elif isinstance(r,dict): summary=f\"dict keys={list(r)[:3]}\"\n            else: summary=type(r).__name__\n            print(f\"  OK {name:24} -> {summary}\")\n        except Exception as e:\n            print(f\"  FAIL {name}: {e!r}\")\n    print(f\"{ok}/{len(calls)} tools ok in {time.time()-t0:.2f}s\")\nasyncio.run(main())\nPY" action.permission=bash action.action=allow action.pattern=*
