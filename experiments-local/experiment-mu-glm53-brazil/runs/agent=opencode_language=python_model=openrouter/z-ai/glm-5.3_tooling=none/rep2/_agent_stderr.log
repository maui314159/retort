timestamp=2026-08-31T19:01:08.626Z level=INFO run=ec94ecf4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv\nfrom collections import Counter\n\n# Tournaments in BR-Football-Dataset\nwith open(\"data/kaggle/BR-Football-Dataset.csv\", encoding=\"utf-8\") as f:\n    rows = list(csv.DictReader(f))\nprint(\"BR-Football tournaments:\", Counter(r[\"tournament\"] for r in rows))\nprint(\"goals empty:\", sum(1 for r in rows if not r[\"home_goal\"] or not r[\"away_goal\"]))\nprint(\"date sample:\", rows[0][\"date\"], \"| time:\", rows[0][\"time\"])\n\n# Libertadores NA season + goals types\nwith open(\"data/kaggle/Libertadores_Matches.csv\", encoding=\"utf-8\") as f:\n    lib = list(csv.DictReader(f))\nna = [r for r in lib if r[\"season\"]==\"NA\"]\nprint(\"Libertadores NA season rows:\", len(na), na[:2])\nprint(\"lib stages:\", Counter(r[\"stage\"] for r in lib))\n\n# overlap between Brasileirao_Matches and novo for 2019\nwith open(\"data/kaggle/Brasileirao_Matches.csv\", encoding=\"utf-8\") as f:\n    bra = list(csv.DictReader(f))\nwith open(\"data/kaggle/novo_campeonato_brasileiro.csv\", encoding=\"utf-8\") as f:\n    novo = list(csv.DictReader(f))\nprint(\"brasileirao seasons:\", Counter(r[\"season\"] for r in bra))\nprint(\"novo rows:\", len(novo))\nprint(\"novo Vencedor values:\", Counter(r[\"Vencedor\"] for r in novo))\nEOF" action.permission=bash action.action=allow action.pattern=*
