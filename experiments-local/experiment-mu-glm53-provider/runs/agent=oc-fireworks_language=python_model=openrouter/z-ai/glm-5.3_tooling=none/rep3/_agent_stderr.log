timestamp=2026-09-01T09:57:52.451Z level=INFO run=f27b5900 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport csv\nfrom collections import Counter\n\ndef rows(p):\n    with open(p, encoding='utf-8-sig') as f:\n        return list(csv.DictReader(f))\n\nbf = rows('data/kaggle/BR-Football-Dataset.csv')\nprint(\"BRF seasons per tournament:\")\nc = Counter((r['tournament'], r['date'][:4]) for r in bf)\ntour = {}\nfor (t, y), n in c.items():\n    tour.setdefault(t, []).append((y, n))\nfor t, ys in tour.items():\n    print(\" \", t, sorted(ys))\nprint(\"BRF date range:\", min(r['date'] for r in bf), max(r['date'] for r in bf))\n\ncupa = rows('data/kaggle/Brazilian_Cup_Matches.csv')\nprint(\"\\nCOPA seasons:\", sorted(Counter(r['season'] for r in cupa).items()))\nprint(\"COPA round counts:\", Counter(r['round'] for r in cupa))\n\nlib = rows('data/kaggle/Libertadores_Matches.csv')\nprint(\"\\nLIB seasons:\", sorted(Counter(r['season'] for r in lib).items()))\nprint(\"LIB final-stage matches per season:\", Counter(r['season'] for r in lib if r['stage']=='final'))\n\nbra = rows('data/kaggle/Brasileirao_Matches.csv')\nprint(\"\\nBRAS per season:\", sorted(Counter(r['season'] for r in bra).items()))\n\nhist = rows('data/kaggle/novo_campeonato_brasileiro.csv')\nprint(\"HIST per season:\", sorted(Counter(r['Ano'] for r in hist).items()))\nprint(\"HIST Vencedor values:\", Counter(r['Vencedor'] for r in hist))\nprint(\"HIST 2019 home teams:\", sorted({r['Equipe_mandante'] for r in hist if r['Ano']=='2019'}))\nprint(\"BRAS 2019 home teams:\", sorted({r['home_team'] for r in bra if r['season']=='2019'}))\nEOF" action.permission=bash action.action=allow action.pattern=*
