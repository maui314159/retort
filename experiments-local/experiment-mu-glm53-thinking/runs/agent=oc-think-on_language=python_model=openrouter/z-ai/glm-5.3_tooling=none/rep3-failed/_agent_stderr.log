timestamp=2026-09-01T17:10:06.060Z level=INFO run=a6cf503f message=evaluated permission=bash pattern="venv/bin/python -c \"\nimport csv\nbest = []\nfiles = [\n  ('Brasileirao_Matches.csv','home_team','away_team'),\n  ('Brazilian_Cup_Matches.csv','home_team','away_team'),\n  ('Libertadores_Matches.csv','home_team','away_team')]\nfor fn, hc, ac in files:\n    for r in csv.DictReader(open('data/kaggle/'+fn, encoding='utf-8-sig')):\n        try: hg, ag = int(r['home_goal']), int(r['away_goal'])\n        except (ValueError, TypeError): continue\n        if abs(hg-ag) >= 6: best.append((abs(hg-ag), fn, r['season'], r.get('datetime','')[:10], r[hc], hg, ag, r[ac]))\nbest.sort(reverse=True)\nfor b in best[:8]: print(b)\nprint()\n# Flamengo home matches 2022 (Brasileirao file) count\nn = 0\nfor r in csv.DictReader(open('data/kaggle/Brasileirao_Matches.csv', encoding='utf-8-sig')):\n    if r['season']=='2022' and 'Flamengo' in r['home_team']: n += 1\nprint('Flamengo home 2022:', n)\n# Flamengo vs Fluminense all-time in file\nimport unicodedata\ndef n3(t):\n    t = unicodedata.normalize('NFKD', t).encode('ascii','ignore').decode().lower()\n    return t\nc = 0\nfor r in csv.DictReader(open('data/kaggle/Brasileirao_Matches.csv', encoding='utf-8-sig')):\n    if {n3(r['home_team']).split('-')[0], n3(r['away_team']).split('-')[0]} == {'flamengo','fluminense'}: c += 1\nprint('FlaFlu in Brasileirao file:', c)\n\"" action.permission=bash action.action=allow action.pattern=*
