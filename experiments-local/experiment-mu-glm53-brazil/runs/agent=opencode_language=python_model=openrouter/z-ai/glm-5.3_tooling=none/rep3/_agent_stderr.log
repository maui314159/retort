timestamp=2026-09-01T13:30:28.495Z level=INFO run=d0d26016 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv\nfrom datetime import datetime\n\ndef parse_date(s):\n    s = s.strip()\n    for fmt in (\"%Y-%m-%d %H:%M:%S\", \"%Y-%m-%d\", \"%d/%m/%Y\", \"%d/%m/%Y %H:%M\"):\n        try: return datetime.strptime(s, fmt).date()\n        except ValueError: pass\n    return None\n\n# Load novo 2015\nnovo = []\nwith open('data/kaggle/novo_campeonato_brasileiro.csv', encoding='utf-8') as f:\n    for r in csv.DictReader(f):\n        if r['Ano'] == '2015':\n            novo.append((parse_date(r['Data']), r['Equipe_mandante'].lower(), r['Equipe_visitante'].lower(), r['Gols_mandante'], r['Gols_visitante']))\n\n# Load Brasileirao_Matches 2015\nbm = []\nwith open('data/kaggle/Brasileirao_Matches.csv', encoding='utf-8') as f:\n    for r in csv.DictReader(f):\n        if r['season'] == '2015':\n            bm.append((parse_date(r['datetime']), r['home_team'].lower().replace('-sp','').replace('-rj','').replace('-mg','').replace('-pr','').replace('-go','').replace(-0*'').replace('-sc','').replace('-ce','').replace('-ba','').replace('-rs','').replace('-pe','').replace('-al','').replace('-df','').replace('-mt','').replace(-0*'').replace('-ms','').replace(-0*'') if False else r['home_team'].lower(), r['away_team'].lower(), r['home_goal'], r['away_goal']))\n\nprint(\"novo 2015:\", len(novo), \" bm 2015:\", len(bm))\n# check a specific fixture: flamengo home vs vasco?\nnf = [m for m in novo if 'flamengo' in m[1] and 'vasco' in m[2]]\nbf = [m for m in bm if 'flamengo' in m[1] and 'vasco' in m[2]]\nprint(\"novo flamengo-vasco home:\", nf)\nprint(\"bm flamengo-vasco home:\", bf)\n\n# overlap count by (date, home, away) raw\ndef strip_state(name):\n    import re\n    n = re.sub(r'[-‐ ](AC|AL|AP|AM|BA|CE|DF|ES|GO|MA|MT|MS|MG|PA|PB|PR|PE|PI|RJ|RN|RS|RO|RR|SC|SP|SE|TO)$', '', name.strip().lower())\n    import unicodedata\n    n = unicodedata.normalize('NFKD', n).encode('ascii','ignore').decode()\n    return n\nns = set((m[0], strip_state(m[1]), strip_state(m[2])) for m in novo)\nbs = set((m[0], strip_state(m[1]), strip_state(m[2])) for m in bm)\ninter = ns & bs\nprint(\"novo keys:\", len(ns), \"bm keys:\", len(bs), \"intersection:\", len(inter))\nonly_n = list(ns - bs)[:5]\nprint(\"novo-only sample:\", only_n)\nEOF" action.permission=bash action.action=allow action.pattern=*
