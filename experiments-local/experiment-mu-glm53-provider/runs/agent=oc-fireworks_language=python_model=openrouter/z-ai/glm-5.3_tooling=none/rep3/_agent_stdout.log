date'] for r in bf[:3]], \"times:\", [r['time'] for r in bf[:3]])\nprint(\"hist dates:\", [r['Data'] for r in h[:3]])\nEOF"},"output":"BRASILEIRAO team samples: ['America-MG', 'Atletico-GO', 'Atletico-MG', 'Atletico-PR', 'Avai-SC', 'Bahia-BA', 'Botafogo-RJ', 'Ceara-CE']\nBRASILEIRAO seasons: ['2012', '2013', '2014', '2015', '2016', '2017', '2018', '2019', '2020', '2021', '2022']\n\nCOPA team samples: ['4 de Julho - PI', '7 de Setembro - MS', 'A.b.c. - RN', 'A.s.a. - AL', 'ABC - RN', 'Abc - RN', 'Afogados - PE', 'Aguia - PA']\nCOPA rounds: ['1', '2', '3', '4', '5', '6', '7', '8']\n\nLIB stages: ['final', 'group stage', 'quarterfinals', 'round of 16', 'semifinals']\nLIB team samples: ['Alianza Lima', 'Always Ready', 'América de Cali', 'América-MG', 'Argentinos Juniors', 'Arsenal Sarandí', 'Athletico', 'Atlas', 'Atlético Nacional', 'Atlético Tucumán']\n\nBRF tournaments: ['Copa do Brasil', 'Serie A', 'Serie B', 'Serie C']\nBRF team samples: ['4 de Julho EC', 'ABC', 'AD Confianca', 'AD Frei Paulistano', 'AE Altos', 'ASA', 'ASA AL', 'Afogados da Ingazeira FC', 'Aguia Negra-MS', 'Aguia de Maraba']\n\nHIST teams: ['América-MG', 'América-RN', 'Athletico-PR', 'Atlético-GO', 'Atlético-MG', 'Avaí', 'Bahia', 'Barueri', 'Botafogo-RJ', 'Brasiliense', 'CSA', 'Ceará', 'Chapecoense', 'Corinthians', 'Coritiba']\nHIST seasons: ['2003', '2004', '2005', '2006', '2007', '2008', '2009', '2010', '2011', '2012', '2013', '2014', '2015', '2016', '2017', '2018', '2019']\n\nbras non-int goals: ['NA'] count: 164\ncopa non-int goals: ['NA'] count: 32\nlib non-int goals: ['-'] count: 4\nhist non-int goals: [] count: 0\nbras dates: ['2012-05-19 18:30:00', '2012-05-19 18:30:00', '2012-05-19 21:00:00']\ncopa dates: ['2012-03-07 16:00:00', '2012-03-14 20:30:00', '2012-03-07 19:30:00']\nlib dates: ['2013-02-12 20:15:00', '2013-02-13 22:00:00', '2013-02-19 23:45:00']\nbrf dates: ['2023-09-24', '2023-09-17', '2023-08-17'] times: ['20:00:00', '20:00:00', '01:30:00']\nhist dates: ['29/03/2003', '29/03/2003