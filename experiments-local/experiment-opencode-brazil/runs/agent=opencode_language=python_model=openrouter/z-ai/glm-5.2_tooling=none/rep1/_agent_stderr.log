timestamp=2026-06-22T00:16:41.438Z level=INFO run=ac7dc745 message=evaluated permission=bash pattern="python3 << 'EOF'\nimport pandas as pd\nfrom brazilian_soccer_mcp import load_all\nfrom brazilian_soccer_mcp.normalizers import canonical_team_id, _clean\nb=load_all('data/kaggle')\nraw=b.matches[(b.matches.competition=='Brasileirao')&(b.matches.season==2019)]\n# all (source, home_name, home_id)\nseen={}\nfor src in ['brasileirao','hist','brfootball']:\n    s=raw[raw.source==src]\n    teams=set(s.home_name)|set(s.home_id)\n    print(f'--- {src}: {len(s)} matches, {s.home_id.nunique()} home teams ---')\n# find canonical id mismatches: group by display-ish\nfrom collections import defaultdict\npairs=defaultdict(set)\nfor _,r in raw.iterrows():\n    pairs[r['home_id']].add((r['source'], r['home_name']))\n# teams where the SAME canonical id has multiple display names or sources differ\n# Instead: find raw team strings that map to different ids\nrawteams=set()\nimport pandas as pd\nfor f in ['Brasileirao_Matches.csv','BR-Football-Dataset.csv','novo_campeonato_brasileiro.csv']:\n    df=pd.read_csv('data/kaggle/'+f)\n    col='home_team' if 'home_team' in df else ('home' if 'home' in df else 'Equipe_mandante')\n    for t in df[col].dropna().unique():\n        rawteams.add(t)\n# show those mapping to ids with 'al','ce','pe','ba','rj','sp','mg','pr','go','rs','sc','to','mt','ms','pi','rn','pb','se','ma','am','ap','ac','rr','ro','df','es','pa' suffix as separate token (likely unstripped)\nimport re\nbad={}\nfor t in sorted(rawteams):\n    cid=canonical_team_id(t)\n    toks=cid.split()\n    if len(toks)>=2 and toks[-1] in {'al','ce','pe','ba','rj','sp','mg','pr','go','rs','sc','to','mt','ms','pi','rn','pb','se','ma','am','ap','ac','rr','ro','df','es','pa'}:\n        bad.setdefault(cid,[]).append(t)\nfor cid,ts in sorted(bad.items()):\n    print(cid, '->', ts[:4])\nEOF" action.permission=bash action.action=allow action.pattern=*
