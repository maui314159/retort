\n    for m in ms[:4]:\n        print('   ', m.date, m.source, m.home.display, m.home_goals, '-', m.away_goals, m.away.display)\nEOF"},"output":"vasco-ish key: vascodagamarj {'away': 19, 'home': 19} display: Vasco\nvasco-ish key: vascorj {'away': 19, 'home': 19} display: Vasco\nduplicate display bases in 2019: {'vasco': ['vascodagamarj', 'vascorj']}\nvasco keys in table: [('vascodagamarj', 38, 49), ('vascorj', 38, 49)]\nsample matches for vascorj :\n    2019-04-28 novo_campeonato_brasileiro.csv Atletico-PR 4 - 1 Vasco\n    2019-05-01 novo_campeonato_brasileiro.csv Vasco 1 - 2 Atletico-MG\n    2019-05-04 novo_campeonato_brasileiro.csv Vasco 1 - 1 Corinthians\n    2019-05-12 novo_campeonato_brasileiro.csv Santos 3 - 0 Vasco\n","metadata":{"output":"vasco-ish key: vascodagamarj {'away': 19, 'home': 19} display: Vasco\nvasco-ish key: vascorj {'away': 19, 'home': 19} display: Vasco\nduplicate display bases in 2019: {'vasco': ['vascodagamarj', 'vascorj']}\nvasco keys in table: [('vascodagamarj', 38, 49), ('vascorj', 38, 49)]\nsample matches for vascorj :\n    2019-04-28 novo_campeonato_brasileiro.csv Atletico-PR 4 - 1 Vasco\n    2019-05-01 novo_campeonato_brasileiro.csv Vasco 1 - 2 Atletico-MG\n    2019-05-04 novo_campeonato_brasileiro.csv Vasco 1 - 1 Corinthians\n    2019-05-12 novo_campeonato_brasileiro.csv Santos 3 - 0 Vasco\n","exit":0,"truncated":false},"title":"venv/bin/python - <<'EOF'\nfrom collections import Counter, defaultdict\nfrom brazilian_soccer import SoccerData\nfrom brazilian_soccer.normalize import fold\ndata = SoccerData()\n\n# Serie A 2019: which two keys represent Vasco?\nt2019 = defaultdict(lambda: defaultdict(int))\nfor m in data.matches:\n    if m.competition=='brasileirao' and m.season==2019:\n        t2019[m.home.key]['home'] += 1\n        t2019[m.away.key]['away'] += 1\nfor k, d in sorted(t2019.items()):\n    if 'vasco' in k:\n        print('vasco-ish key:', k, dict(d), 'display:', data.registry.display(k))\n# any key with weird counts (e.g. 19