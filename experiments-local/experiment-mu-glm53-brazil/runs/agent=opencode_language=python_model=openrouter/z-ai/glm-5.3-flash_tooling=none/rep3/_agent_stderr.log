timestamp=2026-09-01T03:09:00.380Z level=INFO run=2973fea4 message=evaluated permission=bash pattern="./venv/bin/python - <<'EOF'\nimport sys, time\nsys.path.insert(0, '.')\nt0 = time.time()\nfrom brazilian_soccer.loader import load_all\nfrom brazilian_soccer.models import LEAGUE_COMPETITIONS\nfrom collections import Counter, defaultdict\n\nreg, matches, players = load_all()\nprint(f\"loaded in {time.time()-t0:.2f}s: {len(matches)} matches, {len(players)} players\")\n\ncomp = Counter(m.competition for m in matches)\nprint(comp)\n\n# seasons per competition\nseasons = defaultdict(set)\nfor m in matches:\n    seasons[m.competition].add(m.season)\nfor c, ss in sorted(seasons.items()):\n    print(c, min(ss), \"-\", max(ss), f\"({len(ss)} seasons)\")\n\n# check dedupe: Serie A 2019 should have 380 matches\nsa2019 = [m for m in matches if m.competition == \"Brasileirão Serie A\" and m.season == 2019]\nprint(\"Serie A 2019 matches after dedupe:\", len(sa2019))\n\n# check Fla-Flu\nfla = reg.key_for(\"Flamengo-RJ\"); flu = reg.key_for(\"Fluminense\")\nff = [m for m in matches if {m.home_key, m.away_key} == {fla, flu}]\nprint(\"Fla-Flu matches:\", len(ff))\nprint(\"displays:\", reg.display(fla), reg.display(flu), \"|\", reg.display(reg.key_for(\"Sao Paulo\")), reg.display(reg.key_for(\"Athletico Paranaense\")))\n\n# finals\nfinals = [m for m in matches if m.competition == \"Copa do Brasil\" and m.stage == \"final\"]\nprint(\"Cup finals:\", len(finals), \"| Libertadores finals:\", sum(1 for m in matches if m.competition == \"Copa Libertadores\" and m.stage == \"final\"))\n\n# players link check\nneymar = [p for p in players if p.name == \"Neymar Jr\"]\nprint(\"Neymar:\", [(p.nationality, p.overall, p.club_raw, p.club_key, p.club_display) for p in neymar])\nbr_players = [p for p in players if p.is_brazilian()]\nprint(\"Brazilian players:\", len(br_players))\natm = reg.key_for(\"Atlético Mineiro\")\natm_players = [p for p in players if p.club_key == atm]\nprint(\"players at Atletico-MG (FIFA 'Atlético Mineiro'):\", len(atm_players), [p.name for p in sorted(atm_players, key=lambda p: -p.overall)[:3]])\nEOF" action.permission=bash action.action=allow action.pattern=*
