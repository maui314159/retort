timestamp=2026-09-01T04:26:37.812Z level=INFO run=1a470e0e message=evaluated permission=bash pattern="./venv/bin/python << 'EOF'\nimport csv, collections, unicodedata, re\n\ndef unaccent(s):\n    return ''.join(c for c in unicodedata.normalize('NFKD', s) if not unicodedata.combining(c))\n\n# FIFA Brazilian clubs (clubs that look Brazilian)\nwith open('data/kaggle/fifa_data.csv', encoding='utf-8') as f:\n    clubs = collections.Counter(row['Club'] for row in csv.DictReader(f))\nbrazilian = ['Flamengo','Palmeiras','São Paulo','Santos','Grêmio','Corinthians','Athletico','Atlético','Mineiro','Paranaense','Bahia','Vasco','Botafogo','Cruzeiro','Fluminense','Internacional','Goiás','Sport','Chapecoense','Ceará','Fortaleza','América','Avaí','Criciúma','Paysandu','Goiás','Coritiba','Vitória','Bahia','Athletic']\nhits = {c: n for c, n in clubs.items() if any(b.lower() in unaccent(c).lower() for b in brazilian)}\nprint('FIFA BR clubs:', hits)\nEOF" action.permission=bash action.action=allow action.pattern=*
timestamp=2026-09-01T04:26:41.992Z level=INFO run=1a470e0e message=evaluated permission=bash pattern="./venv/bin/python << 'EOF'\nimport csv, collections, re\n# bare ambiguous names occurrences (no state) in each match file\namb = {'atletico','athletico','america','botafogo','internacional','flamengo','santos','guarani','bragantino','operario','santa cruz','nautico','juventude','vitoria','vasco'}\nfor path, col in [('data/kaggle/Brasileirao_Matches.csv','home_team'),('data/kaggle/Brazilian_Cup_Matches.csv','home_team'),('data/kaggle/Libertadores_Matches.csv','home_team'),('data/kaggle/BR-Football-Dataset.csv','home'),('data/kaggle/novo_campeonato_brasileiro.csv','Equipe_mandante')]:\n    cnt = collections.Counter()\n    with open(path, encoding='utf-8') as f:\n        for row in csv.DictReader(f):\n            name = re.sub(r'\\(.*?\\)', ' ', row[col])\n            m = re.search(r'(?:\\s*[-–]\\s*|\\s+)([A-Z]{2})$', name.strip())\n            if not m:\n                base = name.strip().lower()\n                if base in amb: cnt[base] += 1\n    print(path.split('/')[-1], dict(cnt))\nEOF" action.permission=bash action.action=allow action.pattern=*
