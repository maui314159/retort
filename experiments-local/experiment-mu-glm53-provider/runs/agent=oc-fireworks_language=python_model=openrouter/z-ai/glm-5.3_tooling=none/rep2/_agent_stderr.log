timestamp=2026-09-01T05:39:00.438Z level=INFO run=f180ecb5 message=evaluated permission=bash pattern="venv/bin/python - <<'EOF'\nimport csv, re, unicodedata, collections\nbase='data/kaggle/'\ndef fold(s):\n    s = unicodedata.normalize('NFKD', s)\n    s = ''.join(ch for ch in s if not unicodedata.combining(ch))\n    return re.sub(r'[^a-z0-9]', '', s.lower())\n\nnames = collections.Counter()\nfor r in csv.DictReader(open(base+'Brasileirao_Matches.csv', encoding='utf-8-sig')):\n    names[r['home_team']] += 1; names[r['away_team']] += 1\ncup = collections.Counter()\nfor r in csv.DictReader(open(base+'Brazilian_Cup_Matches.csv', encoding='utf-8-sig')):\n    cup[r['home_team']] += 1; cup[r['away_team']] += 1\nnovo = collections.Counter()\nfor r in csv.DictReader(open(base+'novo_campeonato_brasileiro.csv', encoding='utf-8-sig')):\n    novo[r['Equipe_mandante']] += 1; novo[r['Equipe_visitante']] += 1\nbrf = collections.Counter()\nfor r in csv.DictReader(open(base+'BR-Football-Dataset.csv', encoding='utf-8-sig')):\n    brf[r['home']] += 1; brf[r['away']] += 1\n\n# strip suffixes, find collisions after stripping\ndef strip_suffix(n):\n    n = re.sub(r'\\s*\\([^)]*\\)', '', n)  # parenthetical\n    n = re.sub(r'\\s*-\\s*[A-Z]{2}$', '', n)  # \" - RJ\" or \"-RJ\"\n    return n.strip()\nbases = collections.defaultdict(set)\nfor src, ctr in [('br', names), ('cup', cup), ('novo', novo), ('brf', brf)]:\n    for n in ctr:\n        bases[fold(strip_suffix(n))].add((n, src))\ncoll = {b: v for b, v in bases.items() if len(v) > 1}\nprint('collisions after stripping suffixes:')\nfor b, v in sorted(coll.items()): print(' ', b, '->', sorted(v))\n\n# how many distinct names total\nprint('distinct names: br=%d cup=%d novo=%d brf=%d' % (len(names), len(cup), len(novo), len(brf)))\n\n# novo: atletico-pr naming over years\nat = collections.Counter()\nfor r in csv.DictReader(open(base+'novo_campeonato_brasileiro.csv', encoding='utf-8-sig')):\n    for c in ('Equipe_mandante','Equipe_visitante'):\n        if 'tl' in r[c]: at[(r['Ano'], r[c])] += 1\nprint('novo atletico variants by year:', sorted({(y, n) for (y, n) in at}))\n\n# FIFA brazilian clubs\nclubs = collections.Counter()\nnat_br = collections.Counter()\nfor r in csv.DictReader(open(base+'fifa_data.csv', encoding='utf-8-sig')):\n    if r['Nationality'] == 'Brazil':\n        clubs[r['Club']] += 1\nprint('FIFA clubs with Brazilians (top 40):', clubs.most_common(40))\nEOF" action.permission=bash action.action=allow action.pattern=*
