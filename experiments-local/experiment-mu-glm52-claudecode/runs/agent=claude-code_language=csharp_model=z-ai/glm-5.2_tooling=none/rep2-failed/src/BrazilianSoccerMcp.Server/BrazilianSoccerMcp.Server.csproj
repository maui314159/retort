<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BrazilianSoccerMcp.Server</RootNamespace>
    <AssemblyName>BrazilianSoccerMcp.Server</AssemblyName>
    <!-- Data lives at the repo root under data/kaggle; copy it next to the
         server binary so the stdio server finds CSVs regardless of CWD. -->
    <DataRoot>$(MSBuildThisFileDirectory)..\..\data\kaggle</DataRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrazilianSoccerMcp.Core\BrazilianSoccerMcp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(DataRoot)\*.csv" CopyToOutputDirectory="PreserveNewest" Link="data\kaggle\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
